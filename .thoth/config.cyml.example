# thoth runtime config — TWO LAYERS (0.43.3, ADR-0019).
#
#   ~/.thoth/config.cyml     the GLOBAL base — settings that follow you between projects
#   <project>/.thoth/config.cyml   the LOCAL layer — overrides the global PER KEY
#
# Every key resolves as: local, else global, else the built-in default. Both are optional and either
# alone works. So you can set your gateway, model and persona once in `~/.thoth/config.cyml`, and let a
# repo add only what is specific to it — a different model, a project t-ron policy — without restating
# everything. The local file is found by walking UP from the current dir, so `<repo>/.thoth/config.cyml`
# applies from ANY subdirectory of the repo. Copy this file to either location to start.
#
# `/state` shows both paths and which one is which.
#
# ⚠ KEY NAMES ARE CHECKED (0.43.5). An unrecognised key is IGNORED — it always was — but thoth now says
# so, on stderr at startup, in the greeting, in `/state` and on `/reload`:
#     thoth: ignoring unrecognised config key(s): hoosh.max-iter
# because a typo used to be indistinguishable from not writing the line at all. (`max-iter` is not a
# key; `max_iters` is. That one cost an afternoon.) Keys you choose yourself — [alias] names, the
# [shell.deny]/[shell.allow] labels — are never flagged.
#
# ⚠ THE LISTS THAT CONTROL WHAT THE MODEL MAY DO DO NOT SIMPLY MERGE — the rule is STRICTEST WINS:
#     [shell].deny            UNIONS across both layers. A project may ADD denies and can never drop
#                             the ones you set globally.
#     [shell].allow           the local file REPLACES the global's list when it declares one (and
#     [project].read_roots    inherits it when it does not). These GRANT authority, and a repo you
#                             cloned must not be able to widen your global grants by appending to them.
# An explicitly empty local list (`allow = []`) means empty; an ABSENT one inherits the global's.
#
# Memory layers the same way: `~/.thoth/memory/` is read, then the project's `.thoth/memory/`, and both
# are injected. `/remember` writes to the PROJECT store when there is one.
#
# ⚠ The legacy `./thoth.cyml` is still read, and is now the LOCAL layer (so it overrides the global per
# key like any local file). A legacy load is ANNOUNCED — in the greeting, in `/state`, and by `/reload`.
#
# This is NOT the build manifest (that is cyrius.cyml). It is thoth's own
# runtime config, read once at startup. It is a CYML file: TOML above an
# optional `---`, markdown below (the body, if any, is ignored).
#
# The [hoosh] table wires the hoosh seam (M3). Declaring a `url` is what flips
# the seam from absent -> remote-client: thoth POSTs OpenAI-compatible chat
# completions to that gateway over HTTP (via sandhi) and routes turns through
# it. No [hoosh].url, no remote claim — the seam degrades honestly. hoosh owns
# inference + provider routing + the mid-session model switch; thoth only drives
# it. Run a gateway with `hoosh serve 8088` (see the hoosh repo).

[hoosh]
# Gateway base URL. thoth appends the well-known /v1/chat/completions path.
url   = "http://127.0.0.1:8088"

# Optional bearer token, if the gateway's [[auth]] requires one. Omit for an
# unauthenticated local gateway. Keep real tokens out of version control —
# `.thoth/config.cyml` is gitignored; this .example is the committed template.
# token = "your-secret-token"

# Optional default model. Omit to let hoosh route by its own provider config.
# /model <id> overrides this per session (the mid-session switch); hoosh routes
# each request by the model name, so switching providers is just a new id.
model = "claude-haiku-4-5-20251001"

# Stream the completion as it is generated (Server-Sent Events). Default: true —
# thoth prints each delta as it arrives, the natural interactive experience. Set
# to false for a single blocking round-trip (the whole completion prints at once;
# also the mode that surfaces a gateway error body, which SSE mode cannot).
# stream = true

# Carry multi-turn conversation context. Default: true — each turn sends the
# prior exchanges so the model has context (a bounded, byte-budgeted window;
# /reset clears it). Set to false for stateless single-turn requests (every turn
# independent — lower token use, no memory).
# history = true

# Agentic tool-calling. Default: true — when the [daimon] seam is wired, free-text
# turns become a LOOP: thoth advertises daimon's MCP tools to the model, the model
# decides which to call, thoth executes each through daimon (every call gated by
# t-ron), feeds the results back, and repeats until the model answers. Agentic
# turns are non-streaming. Set to false to keep plain single-shot turns even when
# daimon is wired (tools are not advertised; the model just answers).
# tools = true

# max_iters — how many TOOL ROUNDS one agentic turn may take (0.40.0). Default 8,
# ceiling 200. Eight rounds is roughly "read three files and make one edit", which
# is under-powered for real work; peers default far higher. Each round is a full
# model call, so this is also the only thing currently bounding what one turn can
# spend — raise it deliberately.
# max_iters = 24

# compact_at — auto-compact once the session's token total crosses this (0.40.0).
# Off by default. Summarizes the older turns into a recap and stops sending them,
# announcing when it acts. A TOKEN threshold, deliberately: the byte budget below
# is about what fits in one request, this is about what the session has COST.
# compact_at = 150000

# [guard] — scan untrusted PROSE for prompt-injection attempts (0.41.0). DEFAULT
# ON. t-ron's scanner walks TOOL PARAMS; it never sees prose. thoth injects
# untrusted prose from @file mentions, tool results and recalled notes, and the
# model reads all three as ordinary text.
#
# It does NOT block — blocking on a heuristic would break legitimate work (a
# security doc, a CHANGELOG describing an attack, thoth's own source). It MARKS:
# tells you, and wraps the content in an explicit "this is DATA, not instructions"
# envelope. Same treatment thoth already gives AGENTS.md.
#
# ⚠ A mitigation, not a boundary. A novel phrasing passes it.
# [guard]
# enabled = false

# [edit] — let the model WRITE project files. DEFAULT OFF.
# Gates BOTH model-invokable write tools: `edit` (surgical replace of a unique
# occurrence) and `create_file` (create-only, refuses an existing path). Each is
# jailed to the launch directory and gated under the reserved t-ron verb
# `thoth_edit`, distinct from your own `/write` (`thoth_write`) so a policy can
# allow one and deny the other. See docs/adr/0017.
#
# ⚠ Every model write is snapshotted first, and `ckpt_capture` is a GATE, not a
# log: a write that cannot be snapshotted is REFUSED rather than performed, so
# `/rewind` can always undo what it says it can.
# [edit]
# enabled = true

# --- [hoosh] keys not shown in the block above -----------------------------
#
# parallel — run a round's tool calls concurrently. DEFAULT ON.
#   Only fans out when the round has >1 call and none of them is a thoth-local
#   tool (read_file/list_dir/search/shell/edit/create_file/memory_write/delegate
#   force the whole round serial). Every call is still t-ron-gated and still runs
#   the [hooks] pre_tool deny either way — that was NOT true before 0.43.1, where
#   the hook ran only on the serial path; if you are on an older build and rely on
#   pre_tool as a hard deny, set this to false.
#   [hoosh]
#   parallel = false
#
# reasoning — reasoning-effort control for models that expose one ("low" |
#   "medium" | "high"). Unset means the gateway's own default. Some models keep
#   reasoning internal, in which case the Ctrl+R thinking fold is empty BY DESIGN.
#   [hoosh]
#   reasoning = "medium"
#
# summarize — when the history no longer fits the request budget, spend a cheap
#   silent side-call to recap the turns being dropped instead of losing them.
#   Off by default. Pairs with [hoosh].compact_at (a TOKEN threshold) and the
#   manual /compact.
#   [hoosh]
#   summarize = true

# [subagent] — let the model DELEGATE a sub-task to a scoped child agent (0.43.0).
# DEFAULT OFF. See docs/adr/0018-subagent-delegation-scoped-child-context.md.
#
# `delegate(task)` runs a child with the SAME tools and the SAME policy, but its
# OWN empty context, for a bounded number of rounds, returning one short answer.
# The point is cost: locating a symbol in a tree the model does not know is the
# most expensive thing a coding agent does, and today every file it reads on the
# way stays in your conversation forever. A delegated search spends its rounds
# and returns one path.
#
# ⚠ OFF BY DEFAULT FOR SPEND, NOT FOR AUTHORITY. A child grants the model nothing
# new — it can only call tools it was already offered, through the same t-ron
# gate, the same jail, the same hooks and the same audit chain. What it does is
# MULTIPLY token cost, and thoth has no budget enforcement yet.
#
# ⚠ The child CANNOT see your conversation. That is the feature (your window pays
# nothing for what it reads) and the limitation (a task needing context must say
# so in its own words). It also cannot delegate further — depth is capped at 1.
#
# ⚠ Gated by the reserved verb `thoth_delegate`, so a [tron].policy can refuse
# delegation outright. It CANNOT express "subagents, but no shell": the child
# authorizes as the same agent id, and shares its rate-limit bucket and risk score.
# [subagent]
# enabled = true
# max_iters = 8       # rounds ONE child may spend (default 8)

# [toolpin] — pin every MCP tool DEFINITION on first sight (0.42.0). DEFAULT ON.
# Defends CVE-2025-54136: approving a tool does not survive later server-side
# changes. A server can advertise a benign description, be approved, then swap it
# for one carrying instructions — and thoth hands descriptions to the model as
# authoritative guidance about what a tool does, so a swap is a prompt injection
# with approval already granted.
#
# Trust on first use, fail closed on change. First sight pins a SHA-256 over
# name/description/inputSchema, silently (there is nothing to compare against yet).
# Unchanged stays quiet. CHANGED is WITHHELD from the advertisement — not merely
# warned about, because a warning you scroll past leaves the swapped description in
# the model's context, which is the whole payload. `/tools trust` re-baselines after
# a legitimate server upgrade.
#
# ⚠ Scanning cannot substitute for this: the replacement text can be entirely
# innocuous. Only identity works.
# ⚠ SESSION-SCOPED. Pins die with the process, so this catches a swap DURING a
# session (or across /reprobe), not one between two runs. Said plainly so nobody
# reads more into it. A registry over 128 tools advertises the rest unpinned, and
# says so.
# [toolpin]
# enabled = false

# [verify] — run the project's own check after the model writes, and hand the
# model the result (0.41.0). Off unless set; there is no default, because thoth
# cannot guess what "correct" means for a project.
#
# The output is folded into the write's tool result, so the model sees the failure
# in the same round and can fix it without spending another. Over-cap output keeps
# the TAIL — a compiler names its error at the end.
#
# ⚠ The command is YOURS, never the model's; it cannot propose or alter it. But it
# IS command execution, unsandboxed, same footing as /run.
# [verify]
# command = "cyrius test"       # double-quoted; see the [hooks] quoting note below
# timeout_ms = 120000

# [hooks] — run your own commands at agent events (0.41.0). All unset by default.
#
#   session_start   once, before the first turn
#   pre_tool        before EVERY tool — a NON-ZERO EXIT BLOCKS THE CALL
#   post_tool       after a tool ran (cannot block)
#   session_end     once, at exit
#
# Event facts arrive in the ENVIRONMENT — THOTH_EVENT, THOTH_TOOL, THOTH_ARGS —
# never spliced into your command, because a tool name is text the MODEL chose.
#
# A pre_tool hook is a deterministic, code-enforced deny a prompt cannot argue
# with. It can only ever DENY: it runs alongside the t-ron gate, so the strictest
# verdict wins and a hook can never widen authority.
#
# ⚠ A hook runs unsandboxed as you, same footing as /run.
# ⚠ QUOTING. Use a DOUBLE-quoted TOML string and escape any inner double quotes
# (\"). A single-quoted TOML literal string works ONLY if it contains no double
# quote — the config parser truncates a literal string at the first one, which for
# a pre_tool hook means an unrunnable command, and an unrunnable command exits
# non-zero, and a non-zero exit is how pre_tool DENIES. The failure mode is
# therefore "every tool call is silently blocked", so it is worth getting right.
# Verified working:
# [hooks]
# pre_tool = "test \"$THOTH_TOOL\" != shell || test -z \"$RELEASE_BRANCH\""
# post_tool = "test \"$THOTH_TOOL\" = edit && cyrius fmt --check src/*.cyr || true"
# timeout_ms = 15000

# [redact] — scan tool results for secret-shaped values before they enter the
# conversation (0.40.0). DEFAULT ON, unlike the other opt-in features here, because
# it removes risk rather than adding capability, and a protection that is off by
# default protects nobody. Catches vendor API-key prefixes, emails and SSNs, and
# ANNOUNCES every redaction so "[REDACTED]" is never confused with "the tool found
# nothing". Scanning is agnosai's [lib.guard] profile; thoth owns only the gate.
#
# ⚠ It is pattern matching, so it is a MITIGATION, not a boundary — the same framing
# [shell.deny] gets. It will not catch a secret that looks like an ordinary word.
# Turn it off if it interferes with legitimate work:
# [redact]
# enabled = false

# The [pricing.<model>] tables price token usage so /state and the TUI status bar
# can show a running session cost ($d.cc). Opt-in and honest: with no [pricing] for
# the active model, the cost field is OMITTED (never a faked $0) and /state says so.
# hoosh reports the token counts (usage); thoth only multiplies them by the rate you
# declare here. Cost is priced AT ACCUMULATE — each turn uses the model active at that
# moment — so a mid-session /model switch is costed correctly.
#
# Rates are integer micro-USD per 1000 tokens, i.e. (USD per 1M tokens) x 1000:
#   $3.00 / 1M  -> 3000      $15.00 / 1M -> 15000
#   $0.25 / 1M  -> 250       $1.25  / 1M -> 1250
# The section name must match the model id thoth REQUESTS, exactly (session /model,
# else [hoosh].model, else the literal "default" when you let hoosh route). So price a
# default-routed session with [pricing.default], or set [hoosh].model and price that id.
# input = prompt-token rate, output = completion-token rate. BOTH must be set for a
# model to be priced — a section with only one side is treated as unpriced (and /state
# says so), never billed at $0 on the missing side. A deliberately-free side is `= 0`.

# [pricing.claude-haiku-4-5-20251001]
# input  = 800     # $0.80 per 1M input tokens
# output = 4000    # $4.00 per 1M output tokens

# [pricing.claude-sonnet-4-6]
# input  = 3000    # $3.00 per 1M input tokens
# output = 15000   # $15.00 per 1M output tokens

# The [daimon] table wires the daimon seam (M4). Declaring a `url` flips the
# seam from absent -> remote-client: /tools lists daimon's MCP host registry
# (GET /v1/mcp/tools) and /call invokes a tool (POST /v1/mcp/call). daimon
# owns orchestration + MCP tool execution + the host registry; the protocol
# is bote (the vendored bote-core bundle); thoth only drives. Run a host with
# `daimon serve 8090` (see the daimon repo).

# [daimon]
# url = "http://127.0.0.1:8090"

# The [tron] table wires the t-ron seam (M4): MCP per-tool authorization,
# consumed IN-PROCESS via the vendored t-ron dist bundle. `policy` names a
# t-ron policy TOML; when it loads, every gated action (/run, /write, /call)
# becomes a t-ron ToolCall — deny is final, flag falls back to the interactive
# confirm, allow proceeds. Without a policy the seam is absent and the
# built-in fail-closed confirm prompt stands in (deny by default). t-ron
# denies unknown agents and unknown tools by default — fail closed end to end.
#
# Policy file shape (see the t-ron repo for the full surface):
#   [agent."thoth"]
#   allow = ["bote_echo*", "thoth_run", "thoth_write"]
#   deny  = ["danger_*"]
#   [agent."thoth".rate_limit]
#   calls_per_minute = 60
#
# The built-ins authorize under reserved names: thoth_run (/run) and
# thoth_write (/write); MCP tools authorize under their real tool name.

# [tron]

# ⚠ THESE FOUR PATHS ARE THOTH'S OWN STATE, and since 0.43.2 the model's jail refuses them BY NAME.
# `[tron].policy`, `[log].file`, `[history].file` and `[session].file` are whatever you name them, and
# the project-relative values suggested below sit inside the directory the model can read (and, with
# `[edit].enabled`, write). `_project_sensitive` therefore reads these four keys and refuses any path
# whose final component matches one — relative or absolute, at any depth. Before that it matched only
# the literals `.thoth` and `thoth.cyml`, so `.thoth_session` (the whole conversation store, in
# plaintext) and `tron-policy.toml` (the allow/deny list constraining the model) were both fair game.
# If you rename one of these files, the refusal follows the name automatically.
# policy = "tron-policy.toml"
# agent = "thoth"

# The [log] table wires structured driver-event logging via the vendored sakshi
# logger. thoth logs its OWN driver events — turns routed to hoosh, authorization
# decisions, mid-session model switches — as `event=… key=value` lines with a
# timestamp + level envelope. This is thoth's operational log, distinct from
# t-ron's cryptographic audit chain (the /audit command). Off unless `file` or
# `level` is set, so an unconfigured session stays quiet.
#
#   file  — append structured events to this path; omit to use stderr.
#   level — minimum severity: off | fatal | error | warn | info | debug | trace
#           (default info). "off" disables logging even if a file is named.

# [log]
# file = "thoth-driver.log"
# level = "info"

# The [history] table enables PERSISTENT input-history recall (0.11.2). In the rich
# TUI, Up/Down recall previously-submitted composer lines; by default that history is
# session-local (in-memory only). Set `file` to persist it across sessions: thoth loads
# it at startup and rewrites it (most-recent first, bounded to the recall ring) after
# each submitted line.
#
# This is the user's TYPED INPUT — it MAY contain secrets you typed. A FRESH file is
# created mode 0600 (owner-only) on POSIX targets (best-effort: a PRE-EXISTING file keeps
# its current perms — thoth does not re-tighten it — and on AGNOS the frozen-ABI open
# drops the create mode). The path is opened following symlinks. So: keep it in a
# directory only YOU can write, and don't point it at a pre-existing world-readable file.
# Off by default; an unwritable path is announced and recall stays in-memory
# (degrade-closed). DISTINCT from [hoosh].history, which toggles the model's multi-turn
# CONVERSATION memory. Delete the file to clear your history.
#
#   file — path to the persistent input-history file (fresh file created 0600). Omit for
#          in-memory-only recall (the default). Used VERBATIM — there is no shell `~`
#          expansion, so give a relative path (resolved from where thoth is launched)
#          or a full absolute path, not "~/...".

# [history]
# file = ".thoth_history"             # project-local; or an absolute "/home/you/.thoth_history"

# The [session] table (0.24.2) persists the CONVERSATION HISTORY (the multi-turn messages —
# your prompts AND the model's replies) to a file, so a restart RESUMES where you left off.
# DISTINCT from [history].file (composer keystrokes) and from the mneme memory seam (durable
# facts). Interactive-only (one-shot never persists). Off by default.
#
# SECURITY — this writes the whole conversation in PLAINTEXT, so it is MORE sensitive than the
# input history. A FRESH file is created mode 0600 (owner-only) on POSIX (best-effort, same
# residuals as [history].file: a PRE-EXISTING looser file is NOT re-tightened, AGNOS's
# frozen-ABI open drops the create mode, and the path is opened following symlinks). Keep it in
# a directory only YOU can write; an unwritable path is announced and the session stays
# in-memory (degrade-closed). /reset clears it; delete the file to wipe the saved conversation.
#
#   file — path to the persistent conversation file. Omit for no resume (the default). Used
#          VERBATIM (no `~` expansion) — a relative path (from where thoth is launched) or a
#          full absolute path.

# [session]
# file = ".thoth_session"             # project-local; or an absolute "/home/you/.thoth_session"

# The [ui] table holds interactive turn-completion niceties (0.24.3). Both are opt-in (default off) and
# INTERACTIVE-ONLY — one-shot (`thoth 'task'`) output stays clean. Enable them for a nicer REPL/TUI.
#   bell    — ring the terminal BEL when a model turn finishes, so you can tab away and get pinged.
#   elapsed — print a faint "(N.Ns)" line after each reply, showing how long the turn took.
#   tier    — the presentation tier to start in: auto (default) | rich (T2 TUI) | simple (line).
#             NEW at 0.43.2: this key used to be unparsed, and unknown keys are dropped silently, so a
#             `tier = "simple"` line here did nothing and said nothing. `--tier=` on argv still WINS,
#             so scripts are unaffected; an unknown value is announced on stderr, not ignored.
# [ui]
# bell = true
# elapsed = true
# tier = "rich"

# The [alias] table defines slash macros (0.11.4). Each `name = "expansion"` lets you type
# /<name> as a shortcut: when /<name> is NOT a built-in command, thoth expands it to the
# expansion text (with any trailing args appended) and re-runs the result. The expansion can
# be another slash command OR free-text task. Examples:
#
#   /ship              ->  /run git status
#   /explain foo.cyr   ->  explain this code thoroughly: foo.cyr   (the trailing arg is appended)
#   /fix src/x.cyr     ->  /read src/x.cyr
#
# Notes / guarantees:
#   - Built-ins always win — an alias named like a real command (read, run, …) never fires.
#   - An alias to /run, /write, or /call still passes through the SAME t-ron authorization
#     gate (the expansion is re-dispatched normally — aliases can't bypass security).
#   - Recursion is bounded: an alias-to-alias chain is capped (a cycle is refused, not hung).
#   - Values are taken VERBATIM (no shell/escape processing). Duplicate keys: the first wins.
#   - The table is capped at 64 aliases; an alias name is at most 255 chars.
#   - Off by default — with no [alias] table the unknown-command behavior is unchanged.

# [alias]
# ship    = "/run git status"
# explain = "explain this code thoroughly:"
# fix     = "/read"

# The [memory] table wires the memory seam (0.12.0; ADR-0012). Memory is mneme's
# domain (the AGNOS knowledge base — semantic search / RAG). Until mneme's Cyrius
# port ships, thoth stands in a DUMB project-local fallback: it reads a
# .thoth/memory/ flat-file store and injects it into each turn as a system
# message (the same way it injects the avatara persona). It does NOT search,
# rank, embed, or link — that is mneme's engine, never thoth's.
#
# OFF BY DEFAULT. A checked-in .thoth/memory becomes a system message the model
# reads as context — a prompt-injection surface (the same trust question as
# CLAUDE.md) — so auto-injection requires an explicit opt-in. Enable it only for
# projects whose .thoth/memory you trust.
#
# Layout (project-local, cwd-relative):
#   .thoth/memory/MEMORY.md   an index (read first, in full) — one bullet per fact
#   .thoth/memory/*.md        fact notes (frontmatter + body), read verbatim to a
#                             ~4 KB budget, whole-or-skip (never mid-fact truncation)
# Notes match mneme's vault frontmatter, so they are later ingestible by mneme.
# A project-root AGENTS.md (if present) is read too (model-facing project notes).
# Write with /remember <fact> (a bullet), or the model's memory_write tool during
# an agentic turn — both verbatim, t-ron-gated (thoth_remember), never curated.
# /state and /seams show the honest effect (off / local-degraded / mneme-full).

# [memory]
# enabled = true

# The [persona] table sets the STARTUP archetype (0.22.0). thoth wears an avatara persona (the backing
# model is steered by the archetype's soul + spirit prose); `name` picks which one, resolved through
# avatara's registry. Absent -> "Thoth" (the default Librarian archetype — byte-identical to prior
# behavior). An unknown name falls back to the default (the active persona is always surfaced honestly in
# the banner / status bar / /state, never faked). Switch mid-session with `/persona <name>` (the twin of
# `/model`'s mid-session switch); names are case-sensitive avatara archetypes (e.g. Thoth, Athena, Odin).
# The THOTH backronym ("Thinks, Handles, Orchestrates, Transforms, Heals") names the TOOL and is fixed;
# only the active persona changes.

# [persona]
# name = "Thoth"

# The [project] table controls the agent's READ reach (0.23.x). thoth advertises jailed `read_file` /
# `list_dir` tools whenever the agentic loop runs ([hoosh].tools = true) so the model can SEE the codebase
# you launched it in. By default those reads are confined to the launch directory (absolute paths, `~`, and
# any `..` component are refused — a prompt-injection can't make the model read ~/.ssh/id_rsa). You (never
# the model) can WIDEN that jail to additional ABSOLUTE roots — to review another repo, or to read the
# `vidya` Cyrius knowledge base and return to this project. Two ways to grant:
#   * persistently, here — read_roots is a list of absolute roots granted at every startup;
#   * per-session — `/allow <abs-path>` (and `/allow vidya` for the configured knowledge base below).
# `/allow` with no argument lists the active grants; /state shows a "reads" row. A root must be absolute and
# more than just "/". Reads under a granted root still refuse any `..` (no traversal). See ADR-0015.

# [project]
# vidya = "/home/you/Repos/vidya"                 # the Cyrius knowledge base; grant it with `/allow vidya`
# read_roots = ["/home/you/Repos/otherrepo"]      # absolute roots readable from every startup

# The [shell] table arms the model-invokable `shell` tool (0.16.0; ADR-0014). When enabled AND the
# [daimon] seam is wired (agentic turns only), thoth advertises a `shell` tool to the backing model:
# the model can propose a shell command, thoth runs it under a timeout, captures the combined
# stdout+stderr, and feeds the result back. This is DISTINCT from /run (the human's own shell escape,
# gated as thoth_run) — the model's shell is gated under the SEPARATE reserved name `thoth_shell`, so a
# [tron].policy can allow your /run while independently denying / flagging / rate-limiting the model.
#
# OFF BY DEFAULT, and for good reason: enabling it lets an UNTRUSTED model run commands on your
# machine. A checked-in `.thoth/config.cyml` with [shell].enabled = true is a trust decision equivalent to
# running that project's code — enable it only for projects and models you trust, ideally alongside a
# t-ron policy. For the tool to actually RUN a command you also need an [agent."thoth"] allow rule for
# `thoth_shell` in your t-ron policy (with no policy, the fail-closed confirm prompt gates each call;
# in one-shot/-p mode that prompt auto-DENIES). POSIX only — on AGNOS/Windows there is no capturing
# /bin/sh, so the tool is announced-but-not-advertised (never silently faked). /state shows the state.
#
#   enabled    — true to advertise the shell tool (default false).
#   timeout_ms — per-command wall-clock timeout; a command that exceeds it is SIGKILLed and its
#                partial output kept (default 30000 = 30s; clamped to 600000).
#   max_output — max bytes of captured output surfaced to the model; more is truncated with a marker
#                (default 65536 = 64 KiB; clamped to 1048576). Binary NUL bytes are scrubbed to spaces.
#
# [shell] deny / allow are optional glob guardrails, checked LOCALLY and BEFORE t-ron (so a deny-list
# holds even with no policy). The canonical form is a TOML array of glob strings under [shell]:
# `deny = ["glob", ...]` / `allow = ["glob", ...]` (see below). glob_match supports only `*` (any run)
# and `?` (one char) and matches the WHOLE command, so use leading/trailing `*` for substring intent.
# A deny match hard-blocks (deny wins over allow); a NON-EMPTY allow-list is default-deny (a command
# must match one). These are a COARSE convenience speed-bump against obvious footguns, NOT a sandbox —
# a shell can cd / chain / base64-decode around a string glob. Real containment is: default-off, your
# trust decision to enable, the t-ron policy, and running thoth itself under OS-level confinement.
# Residual limit (documented, not faked): the capture temp file lives in world-writable /tmp
# (best-effort O_EXCL create, no O_NOFOLLOW). A command that exceeds the timeout is killed by PROCESS
# GROUP (0.20.1: kill(-pgid, SIGKILL)), so a backgrounded child dies with the shell.
#
# Back-compat: the legacy `[shell.deny]`/`[shell.allow]` SECTION form (each line `label = "glob"`, the
# label arbitrary, the VALUE the pattern) is still accepted, but ONLY when the matching array key is
# absent. It predates bayan's TOML array-value getter (added 1.1.0); prefer the array form.

# [shell]
# enabled    = true
# timeout_ms = 30000
# max_output = 65536
# deny       = ["*rm -rf*", "* | sh", "*curl*|*sh"]
# allow      = ["git *", "cyrius *", "ls*"]
#
# Legacy section form (used only when the array key above is absent):
# [shell.deny]
# d1 = "*rm -rf*"
# [shell.allow]
# a1 = "git *"
