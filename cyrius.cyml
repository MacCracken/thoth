[package]
name = "thoth"
version = "${file:VERSION}"
description = "thoth — sovereign agentic coding TUI; a model-switching scribe driving the AGNOS stack"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/thoth"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/thoth"

[deps]
# Stdlib modules are opt-in. Every module includes what it calls and each vendored bundle names what
# it needs in its `Requires` block, so this list is what thoth's own source reaches, kept by hand.
# A reachable call into a module nothing brought in refuses the build; an unreachable one is only a
# warning, so read the warnings after changing this list. Order decides nothing; it reads bottom-up,
# the substrate first, then the data, crypto and dynamic-link layers, then the transport.
stdlib = [
    # substrate + text; slice for the vendored libro→agnosys subscript syntax
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string", "vec", "slice", "args", "process", "assert", "bench",
    # utilities sandhi/sigil build on; regex carries glob_match (t-ron's policy globs)
    "fnptr", "freelist", "hashmap", "chrono", "regex",
    # `_uc_decode_utf8`: the agnosai output guard decodes UTF-8 so a redaction never splits a character
    "unicode",
    # sigil's `agnosys_uname` calls `sys_uname` (dead-path in thoth, an undefined-fn warning otherwise)
    "sys",
    # data formats (json/toml/cyml/base64/bigint/u128/csv) and the thoth.cyml config surface (the cyml
    # header split + toml pairs)
    "bayan",
    # structured logging the vendored libro audit chain emits through
    "patra",
    # concurrency + crypto: sigil's serial hash path installs a per-thread TLS scratch bank and its
    # batch verify spawns workers
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sigil",
    # the dynamic-link floor TLS needs
    "mmap", "dynlib", "fdlopen",
    # sandhi's epoll server
    "async",
    # transport: net/http/tls/ws + sakshi spans, then sandhi
    "net", "http", "tls", "ws", "sakshi", "sandhi",
]
