[package]
name = "thoth"
version = "${file:VERSION}"
description = "thoth — sovereign agentic coding TUI; a model-switching scribe driving the AGNOS stack"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/thoth"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/thoth"

[deps]
# Stdlib modules are opt-in and Cyrius resolves no transitive deps: every module thoth, its vendored
# bundles or the sandhi transport calls into is listed here by hand. Under-declaring is not a link
# error — non-strict mode patches a missing call site with placeholder bytes that loop back into
# init — so every module sandhi.cyr references must be listed.
# Order matters: most modules don't `include` their cross-deps, so the resolver falls back to this
# array's order. A module comes after everything it builds on: the substrate first, then the data,
# crypto and dynamic-link layers, then the transport that consumes them.
stdlib = [
    # substrate + text; slice for the vendored libro→agnosys subscript syntax
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string", "vec", "slice", "args", "process", "assert", "bench",
    # utilities sandhi/sigil build on; regex carries glob_match (t-ron's policy globs), math carries
    # f64_le/f64_ge for avatara's archetype (its other f64 ops are builtins)
    "fnptr", "freelist", "hashmap", "chrono", "regex", "math",
    # `_uc_decode_utf8`: the agnosai output guard decodes UTF-8 so a redaction never splits a character
    "unicode",
    # sigil's `agnosys_uname` calls `sys_uname` (dead-path in thoth, an undefined-fn warning otherwise)
    "sys",
    # data formats (json/toml/cyml/base64/bigint/u128/csv) and the thoth.cyml config surface (the cyml
    # header split + toml pairs) — before sigil (u256) and the transport (json/base64)
    "bayan",
    # structured logging the vendored libro audit chain emits through
    "patra",
    # concurrency + crypto, ALL before sigil: its serial hash path installs a per-thread TLS scratch
    # bank and its batch verify spawns workers — without atomic/thread/thread_local first, the SHA-256
    # in libro's chain_append traps SIGILL
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sigil",
    # the dynamic-link floor TLS needs — mmap before dynlib (which uses mmap's PROT_NONE without
    # including it), all three before tls + sandhi
    "mmap", "dynlib", "fdlopen",
    # sandhi's epoll server
    "async",
    # transport: net/http/tls/ws + sakshi spans, then sandhi
    "net", "http", "tls", "ws", "sakshi", "sandhi",
]
