[package]
name = "thoth"
version = "${file:VERSION}"
description = "thoth — sovereign agentic coding TUI; a model-switching scribe driving the AGNOS stack"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/thoth"
language = "cyrius"
cyrius = "6.4.78"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "build/thoth"

[deps]
# Libs are OPT-IN and Cyrius does NOT resolve transitive deps — so the hoosh
# seam's transport (sandhi) drags its whole transitive stdlib set in here by
# hand. Under-declaring is not a link error: cyrius non-strict mode patches the
# missing call sites with placeholder bytes that loop back into init (the
# 2026-04-24 sandhi HTTPS-loop saga), so every module sandhi.cyr references
# must be listed. Grouped: driver core · config (thoth.cyml) · hoosh transport.
# Order matters: most stdlib modules don't self-`include` their cross-deps, so
# the resolver falls back to this array order. Low-level floor first, then the
# crypto + dynamic-link layers, then the high-level transport that consumes
# them (tls/ws/sandhi). dynlib uses mmap's PROT_NONE without including it, so
# mmap MUST precede dynlib — and dynlib/fdlopen/mmap MUST precede tls + sandhi.
# bayan (the 6.1.25 data-domain carve: json/toml/cyml/base64/bigint/u128/csv)
# MUST precede sigil (u256) and the transport (json/base64); it also carries
# the thoth.cyml config surface (cyml header split + toml pairs).
stdlib = [
    # driver core (M2) — base substrate + text; slice for the vendored
    # libro→agnosys subscript syntax (M4)
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string", "vec", "slice", "args", "process", "assert", "bench",
    # general utilities sandhi/sigil build on; regex carries glob_match for
    # the vendored t-ron policy globs (M4); math carries f64_le/f64_ge for the
    # vendored avatara archetype f64 ops (M5 — the other f64 ops are builtins)
    "fnptr", "freelist", "hashmap", "chrono", "regex", "math",
    # data formats (json/toml/cyml/base64/bigint) — before sigil + transport
    "bayan",
    # structured logging the vendored libro audit chain emits through (M4)
    "patra",
    # concurrency + crypto floor, ALL before sigil: sigil 3.7.8's serial hash
    # path self-installs a per-thread TLS scratch bank and its batch verify
    # spawns workers — without atomic/thread/thread_local first, the SHA-256
    # in the vendored libro's chain_append traps SIGILL (t-ron 2.1.5 note).
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sigil",
    # dynamic-link floor TLS needs (mmap before dynlib — PROT_NONE)
    "mmap", "dynlib", "fdlopen",
    # async (sandhi's epoll server)
    "async",
    # transport: net/http/tls/ws + sakshi spans, then sandhi
    "net", "http", "tls", "ws", "sakshi", "sandhi",
]
