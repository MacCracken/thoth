# thoth test suite — the DRIVER (0.30.7). One compiled binary: the driver includes the src modules directly
# (NOT src/main.cyr or src/repl.cyr, which carry top-level execution / pure I/O), then the topical test-case
# files under tests/cases/ (helpers.cyr first, then core/render/tui/agent/gui.cyr), then main() calls every
# test_* below. To add a test: put its body in the right tests/cases/*.cyr and wire the call into main() here.
# The cases stay in ONE binary because hoosh/gate reach into the TUI (surface->hoosh->gate->tui), so a per-file
# split can't drop those modules; splitting the SOURCE keeps files readable without fighting that coupling.
# Stdlib + process deps auto-resolve from cyrius.cyml. Run via `cyrius test`.
include "src/vendor/bote-core.cyr"
include "src/vendor/libro.cyr"
include "src/vendor/t-ron.cyr"
include "src/vendor/avatara.cyr"
include "src/vendor/vyakarana.cyr"
include "src/vendor/darshana.cyr"
include "src/vendor/sankoch.cyr"    # git-object inflate (0.13.0); before sit-read
include "src/vendor/sit-read.cyr"   # sit read-only VCS API (branch/status/diff)
include "src/util.cyr"
include "src/version.cyr"
include "src/ui.cyr"
include "src/feed.cyr"
include "src/ftree.cyr"
include "src/inhist.cyr"
include "src/fsearch.cyr"
include "src/mention.cyr"
include "src/project.cyr"  # model-invokable read_file/list_dir project tools (0.23.0/0.23.1); before config (config_load grants configured roots)
include "src/config.cyr"
include "src/log.cyr"
include "src/gate.cyr"
include "src/git.cyr"      # git producer (0.13.0); before seams (SEAM_GIT reads git_present)
include "src/seams.cyr"
include "src/session.cyr"
include "src/roundlog.cyr"
include "src/exec.cyr"
include "src/hoosh.cyr"
include "src/mpick.cyr"    # model-picker palette state/filter/nav (0.24.0)
include "src/memory.cyr"
include "src/shell.cyr"    # model-invokable `shell` agentic tool (0.16.0, ADR-0014)
include "src/daimon.cyr"
include "src/agent.cyr"
include "src/diff.cyr"
include "src/mdhl.cyr"     # markdown fenced-code highlighter (0.15.1); after diff (calls _hl_span)
include "src/surface.cyr"  # status view-model (0.28.0, Stage B); after its producers (session/hoosh/git/ui), before commands+tui
# T3 GUI draw pipeline (0.29.0, Phase 1) — headless-testable; NOT in main.cyr yet (wired with the present
# shell in a later cut, after the code-buffer lift). kashi (font) before graster; graster before gstatus.
include "src/vendor/kashi.cyr"
include "src/gui/gdraw.cyr"
include "src/gui/graster.cyr"
include "src/gui/gstatus.cyr"
include "src/gui/ginput.cyr"
include "src/gui/gtree.cyr"
include "src/gui/gfeed.cyr"
include "src/commands.cyr"
include "src/repl.cyr"
include "src/oneshot.cyr"
include "src/tui.cyr"

# --- test cases: split into topical files under tests/cases/ (0.30.7). helpers.cyr FIRST so any
#     group can use any helper; the rest define the test_* fns main() calls below. ONE binary.
include "tests/cases/helpers.cyr"
include "tests/cases/core.cyr"
include "tests/cases/render.cyr"
include "tests/cases/tui.cyr"
include "tests/cases/agent.cyr"
include "tests/cases/gui.cyr"

fn main() {
    alloc_init();
    test_classify();
    test_tokens();
    test_cstr();
    test_seams();
    test_capability_ladder();
    test_session();
    test_ctx_meter();
    test_hoosh_health();
    test_persona();
    test_persona_switch();
    test_role();
    test_config();
    test_hoosh();
    test_provider_catalog();
    test_stream_config();
    test_usage();
    test_cost();
    test_alias();
    test_dry();
    test_memory();
    test_shell();
    test_oneshot();
    test_json_envelope();
    test_oneshot_out();
    test_completion();
    test_history();
    test_history_request();
    test_inhist();
    test_inhist_persist();
    test_logging();
    test_agent();
    test_config_m4();
    test_daimon();
    test_tron();
    test_audit();
    test_roundlog();
    test_parallel();
    test_bounds_hardening();
    test_ui();
    test_diff();
    test_git_diff();
    test_highlight();
    test_tui();
    test_feed();
    test_feed_ring();
    test_softwrap();
    test_glyph_width();
    test_feed_markers();
    test_capture();
    test_mdhl_tag_map();
    test_mdhl_fence();
    test_mdhl_render();
    test_mdhl_stream();
    test_mdhl_livecard();
    test_fsearch();
    test_mention();
    test_tab_complete();
    test_mdhl_inline();
    test_spinner();
    test_stream_throttle();
    test_ftree();
    test_theme();
    test_git();
    test_project();
    test_mpick();
    test_save();
    test_session_persist();
    test_ui_niceties();
    test_reload();
    test_model_switch();
    test_surface();
    test_gui();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
