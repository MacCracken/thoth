# thoth test suite — unit tests for the driver's pure logic.
#
# Includes the driver modules directly (NOT src/main.cyr or src/repl.cyr, which
# carry top-level execution / pure I/O). Stdlib + process deps auto-resolve
# from cyrius.cyml. Run via `cyrius test`.
include "src/vendor/bote-core.cyr"
include "src/vendor/libro.cyr"
include "src/vendor/t-ron.cyr"
include "src/util.cyr"
include "src/config.cyr"
include "src/gate.cyr"
include "src/seams.cyr"
include "src/session.cyr"
include "src/exec.cyr"
include "src/hoosh.cyr"
include "src/daimon.cyr"
include "src/commands.cyr"

fn test_classify() {
    test_group("classify_input");
    assert_eq(classify_input(""), CMD_EMPTY, "empty -> CMD_EMPTY");
    assert_eq(classify_input("/help"), CMD_HELP, "/help");
    assert_eq(classify_input("/?"), CMD_HELP, "/? alias");
    assert_eq(classify_input("/quit"), CMD_QUIT, "/quit");
    assert_eq(classify_input("/exit"), CMD_QUIT, "/exit alias");
    assert_eq(classify_input("/seams"), CMD_SEAMS, "/seams");
    assert_eq(classify_input("/state"), CMD_STATE, "/state");
    assert_eq(classify_input("/model"), CMD_MODEL, "/model bare");
    assert_eq(classify_input("/model gpt-5"), CMD_MODEL, "/model with arg");
    assert_eq(classify_input("/read foo.txt"), CMD_READ, "/read with arg");
    assert_eq(classify_input("/write a b"), CMD_WRITE, "/write");
    assert_eq(classify_input("/run echo hi"), CMD_RUN, "/run");
    assert_eq(classify_input("/tools"), CMD_TOOLS, "/tools");
    assert_eq(classify_input("/call echo {}"), CMD_CALL, "/call with args");
    assert_eq(classify_input("/bogus"), CMD_UNKNOWN_SLASH, "unknown slash");
    assert_eq(classify_input("/"), CMD_UNKNOWN_SLASH, "lone slash");
    assert_eq(classify_input("write me a function"), CMD_TASK, "free text -> task");
    assert_eq(classify_input("hello"), CMD_TASK, "plain word -> task");
    return 0;
}

fn test_tokens() {
    test_group("token_is + arg_after");
    assert_eq(token_is("/help", "/help"), 1, "exact token");
    assert_eq(token_is("/model gpt", "/model"), 1, "token + space");
    assert_eq(token_is("/models", "/model"), 0, "prefix is not a token");
    assert_eq(token_is("/modelx", "/model"), 0, "no word boundary");
    assert_eq(arg_after("/help"), 0, "no arg -> 0");
    assert(streq(arg_after("/read foo.txt"), "foo.txt"), "arg extracted");
    assert(streq(arg_after("/model   gpt-5"), "gpt-5"), "skips extra spaces");
    assert(streq(arg_after("/write a.txt hi there"), "a.txt hi there"), "rest after first token");
    return 0;
}

fn test_cstr() {
    test_group("cstr_starts_with");
    assert_eq(cstr_starts_with("hello", "he"), 1, "prefix");
    assert_eq(cstr_starts_with("hello", "hello"), 1, "equal");
    assert_eq(cstr_starts_with("he", "hello"), 0, "shorter than prefix");
    assert_eq(cstr_starts_with("abc", "x"), 0, "mismatch");
    assert_eq(cstr_starts_with("", ""), 1, "empty prefix of empty");
    return 0;
}

fn test_seams() {
    test_group("seam registry");
    assert_eq(SEAM_COUNT, 5, "five seams");
    assert(streq(seam_name(SEAM_HOOSH), "hoosh"), "hoosh name");
    assert(streq(seam_name(SEAM_DAIMON), "daimon"), "daimon name");
    assert(streq(seam_name(SEAM_BOTE), "bote"), "bote name");
    assert(streq(seam_name(SEAM_TRON), "t-ron"), "t-ron name");
    assert(streq(seam_name(SEAM_AVATARA), "avatara"), "avatara name");
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_status(SEAM_DAIMON), SEAM_ABSENT, "daimon absent when unconfigured");
    assert_eq(seam_status(SEAM_TRON), SEAM_ABSENT, "t-ron absent without a policy");
    assert_eq(seam_status(SEAM_BOTE), SEAM_NATIVE, "bote native (vendored core, M4)");
    assert_eq(seam_status(SEAM_AVATARA), SEAM_ABSENT, "avatara absent until M5");
    assert_eq(seam_any_wired(), 1, "bote wired by construction");
    assert(streq(seam_status_label(SEAM_ABSENT), "absent"), "absent label");
    assert(streq(seam_status_label(SEAM_REMOTE), "remote-client"), "remote label");
    assert(streq(seam_status_label(SEAM_NATIVE), "native"), "native label");
    return 0;
}

fn test_session() {
    test_group("session state");
    session_reset();
    assert_eq(session_turns(), 0, "turns start 0");
    assert_eq(session_model(), 0, "model starts none");
    session_bump_turn();
    session_bump_turn();
    assert_eq(session_turns(), 2, "two turns counted");
    session_set_model("gpt-5");
    assert(streq(session_model(), "gpt-5"), "model set");
    session_reset();
    assert_eq(session_turns(), 0, "reset clears turns");
    assert_eq(session_model(), 0, "reset clears model");
    return 0;
}

# Config defaults when no thoth.cyml is loaded (the test process loads none).
fn test_config() {
    test_group("hoosh config (unconfigured)");
    assert_eq(config_hoosh_configured(), 0, "not configured by default");
    assert(streq(config_hoosh_url(), "http://127.0.0.1:8088"), "localhost default url");
    assert_eq(config_hoosh_token(), 0, "no token by default");
    assert_eq(config_hoosh_model(), 0, "no model by default");
    # unconfigured -> hoosh seam stays absent (honest degradation)
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    return 0;
}

# The hoosh client's pure pieces: escape, int-append, request building, and
# response/error extraction (no network).
fn test_hoosh() {
    test_group("hoosh request building");
    var eb[64];
    var n = _json_escape_into(&eb, 0, "a\"b");      # a " b
    store8(&eb + n, 0);
    assert(streq(&eb, "a\\\"b"), "escape double-quote");
    var n2 = _json_escape_into(&eb, 0, "x\ny");     # x <LF> y
    store8(&eb + n2, 0);
    assert(streq(&eb, "x\\ny"), "escape newline");
    var n3 = _json_escape_into(&eb, 0, "c\\d");     # c \ d
    store8(&eb + n3, 0);
    assert(streq(&eb, "c\\\\d"), "escape backslash");

    var ib[32];
    var inn = _append_int(&ib, 0, 4096);
    store8(&ib + inn, 0);
    assert(streq(&ib, "4096"), "append_int 4096");
    var iz = _append_int(&ib, 0, 0);
    store8(&ib + iz, 0);
    assert(streq(&ib, "0"), "append_int 0");

    var rb[256];
    hoosh_build_request(&rb, "m", "hi");
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "chat-completions request shape");

    test_group("hoosh response extraction");
    var body = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hello world\"}}]}";
    var s = hoosh_extract_content(body, strlen(body));
    assert(s != 0, "content present");
    assert(str_eq_cstr(s, "hello world"), "content matches");

    var empty = "{\"choices\":[]}";
    assert_eq(hoosh_extract_content(empty, strlen(empty)), 0, "empty choices -> 0");
    var nojson = "not json";
    assert_eq(hoosh_extract_content(nojson, strlen(nojson)), 0, "unparseable -> 0");

    var ebody = "{\"error\":{\"message\":\"no provider for model\"}}";
    var em = hoosh_extract_error(ebody, strlen(ebody));
    assert(em != 0, "error present");
    assert(str_eq_cstr(em, "no provider for model"), "error message matches");
    assert_eq(hoosh_extract_error(body, strlen(body)), 0, "no error field -> 0");
    return 0;
}

# M4 config defaults when no thoth.cyml is loaded.
fn test_config_m4() {
    test_group("daimon/tron config (unconfigured)");
    assert_eq(config_daimon_configured(), 0, "daimon not configured by default");
    assert_eq(config_daimon_url(), 0, "no daimon url by default");
    assert_eq(config_tron_policy(), 0, "no t-ron policy by default");
    assert(streq(config_tron_agent(), "thoth"), "default agent id");
    assert_eq(gate_active(), 0, "gate inactive without a policy");
    return 0;
}

# The daimon client's pure pieces: call-body building and tool-result
# extraction against canned bodies (no network).
fn test_daimon() {
    test_group("daimon call building");
    var cb[256];
    daimon_build_call(&cb, "echo", "{\"x\":1}");
    assert(streq(&cb, "{\"name\":\"echo\",\"arguments\":{\"x\":1}}"), "call body with args");
    daimon_build_call(&cb, "scan", 0);
    assert(streq(&cb, "{\"name\":\"scan\",\"arguments\":{}}"), "call body, no args -> {}");
    daimon_build_call(&cb, "we\"ird", 0);
    assert(streq(&cb, "{\"name\":\"we\\\"ird\",\"arguments\":{}}"), "tool name is escaped");

    test_group("daimon result extraction");
    var ok = "{\"content\":[{\"type\":\"text\",\"text\":\"tool says hi\"}],\"isError\":false}";
    var s = daimon_extract_text(ok, strlen(ok));
    assert(s != 0, "text present");
    assert(str_eq_cstr(s, "tool says hi"), "text matches");
    assert_eq(daimon_extract_is_error(ok, strlen(ok)), 0, "isError false -> 0");
    var bad = "{\"content\":[{\"type\":\"text\",\"text\":\"boom\"}],\"isError\":true}";
    assert_eq(daimon_extract_is_error(bad, strlen(bad)), 1, "isError true -> 1");
    var none = "{\"ok\":true}";
    assert_eq(daimon_extract_text(none, strlen(none)), 0, "no content -> 0");
    assert_eq(daimon_extract_is_error(none, strlen(none)), 0 - 1, "no isError -> -1");
    var nojson = "nope";
    assert_eq(daimon_extract_text(nojson, strlen(nojson)), 0, "unparseable -> 0");
    return 0;
}

# The vendored t-ron engine end-to-end in-process: policy allow/deny globs,
# deny-by-default for unknown agents, and the audit path (libro chain_append —
# the sigil/thread_local ordering canary).
fn test_tron() {
    test_group("t-ron verdicts (vendored engine)");
    var t = tron_new(tron_config_default());
    var pol = "[agent.\"thoth\"]\nallow = [\"echo_*\", \"thoth_run\"]\ndeny = [\"danger_*\"]\n";
    assert_eq(tron_load_policy(t, pol), TRON_ERR_NONE, "policy parses");

    var c1 = tool_call_new("thoth", "echo_hello", "{}", 1000);
    assert_eq(verdict_kind(tron_check(t, c1)), VK_ALLOW, "allow-listed tool -> allow");
    var c2 = tool_call_new("thoth", "danger_rm", "{}", 2000);
    assert_eq(verdict_kind(tron_check(t, c2)), VK_DENY, "deny-listed tool -> deny");
    var c3 = tool_call_new("thoth", "unlisted_tool", "{}", 3000);
    assert_eq(verdict_kind(tron_check(t, c3)), VK_DENY, "unlisted tool -> deny (fail closed)");
    var c4 = tool_call_new("mallory", "echo_hello", "{}", 4000);
    assert_eq(verdict_kind(tron_check(t, c4)), VK_DENY, "unknown agent -> deny (fail closed)");
    var c5 = tool_call_new("thoth", "thoth_run", "{\"cmd\":\"echo hi\"}", 5000);
    assert_eq(verdict_kind(tron_check(t, c5)), VK_ALLOW, "thoth_run allowed by policy");
    return 0;
}

# Mid-session model switch stores a COPY (the arg aliases a reused line buffer).
fn test_model_switch() {
    test_group("mid-session model switch");
    session_reset();
    assert_eq(session_model(), 0, "no model after reset");
    var scratch[16];
    store8(&scratch + 0, 103); store8(&scratch + 1, 112); store8(&scratch + 2, 116);
    store8(&scratch + 3, 0);                                   # "gpt"
    session_set_model_copy(&scratch);
    store8(&scratch + 0, 88);                                  # clobber to "Xpt"
    assert(streq(session_model(), "gpt"), "model is a stable copy, not an alias");
    session_reset();
    return 0;
}

fn main() {
    alloc_init();
    test_classify();
    test_tokens();
    test_cstr();
    test_seams();
    test_session();
    test_config();
    test_hoosh();
    test_config_m4();
    test_daimon();
    test_tron();
    test_model_switch();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
