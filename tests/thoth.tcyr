fn test_classify() {
    test_group("classify_input");
    assert_eq(classify_input(""), CMD_EMPTY, "empty -> CMD_EMPTY");
    assert_eq(classify_input("/help"), CMD_HELP, "/help");
    assert_eq(classify_input("/?"), CMD_HELP, "/? alias");
    assert_eq(classify_input("/quit"), CMD_QUIT, "/quit");
    assert_eq(classify_input("/exit"), CMD_QUIT, "/exit alias");
    assert_eq(classify_input("/seams"), CMD_SEAMS, "/seams");
    assert_eq(classify_input("/state"), CMD_STATE, "/state");
    assert_eq(classify_input("/model"), CMD_MODEL, "/model bare");
    assert_eq(classify_input("/model gpt-5"), CMD_MODEL, "/model with arg");
    assert_eq(classify_input("/read foo.txt"), CMD_READ, "/read with arg");
    assert_eq(classify_input("/write a b"), CMD_WRITE, "/write");
    assert_eq(classify_input("/run echo hi"), CMD_RUN, "/run");
    assert_eq(classify_input("/tools"), CMD_TOOLS, "/tools");
    assert_eq(classify_input("/call echo {}"), CMD_CALL, "/call with args");
    assert_eq(classify_input("/audit"), CMD_AUDIT, "/audit");
    assert_eq(classify_input("/reset"), CMD_RESET, "/reset");
    assert_eq(classify_input("/clear"), CMD_CLEAR, "/clear");
    assert_eq(classify_input("/bogus"), CMD_UNKNOWN_SLASH, "unknown slash");
    assert_eq(classify_input("/"), CMD_UNKNOWN_SLASH, "lone slash");
    assert_eq(classify_input("write me a function"), CMD_TASK, "free text -> task");
    assert_eq(classify_input("hello"), CMD_TASK, "plain word -> task");
    return 0;
}

fn test_tokens() {
    test_group("token_is + arg_after");
    assert_eq(token_is("/help", "/help"), 1, "exact token");
    assert_eq(token_is("/model gpt", "/model"), 1, "token + space");
    assert_eq(token_is("/models", "/model"), 0, "prefix is not a token");
    assert_eq(token_is("/modelx", "/model"), 0, "no word boundary");
    assert_eq(arg_after("/help"), 0, "no arg -> 0");
    assert(streq(arg_after("/read foo.txt"), "foo.txt"), "arg extracted");
    assert(streq(arg_after("/model   gpt-5"), "gpt-5"), "skips extra spaces");
    assert(streq(arg_after("/write a.txt hi there"), "a.txt hi there"), "rest after first token");
    return 0;
}

fn test_cstr() {
    test_group("cstr_starts_with");
    assert_eq(cstr_starts_with("hello", "he"), 1, "prefix");
    assert_eq(cstr_starts_with("hello", "hello"), 1, "equal");
    assert_eq(cstr_starts_with("he", "hello"), 0, "shorter than prefix");
    assert_eq(cstr_starts_with("abc", "x"), 0, "mismatch");
    assert_eq(cstr_starts_with("", ""), 1, "empty prefix of empty");
    return 0;
}

fn test_seams() {
    test_group("seam registry");
    assert_eq(SEAM_COUNT, 5, "five seams");
    assert(streq(seam_name(SEAM_HOOSH), "hoosh"), "hoosh name");
    assert(streq(seam_name(SEAM_DAIMON), "daimon"), "daimon name");
    assert(streq(seam_name(SEAM_BOTE), "bote"), "bote name");
    assert(streq(seam_name(SEAM_TRON), "t-ron"), "t-ron name");
    assert(streq(seam_name(SEAM_AVATARA), "avatara"), "avatara name");
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_status(SEAM_DAIMON), SEAM_ABSENT, "daimon absent when unconfigured");
    assert_eq(seam_status(SEAM_TRON), SEAM_ABSENT, "t-ron absent without a policy");
    assert_eq(seam_status(SEAM_BOTE), SEAM_NATIVE, "bote native (vendored core, M4)");
    assert_eq(seam_status(SEAM_AVATARA), SEAM_NATIVE, "avatara native (vendored archetype, M5)");
    assert_eq(seam_any_wired(), 1, "bote wired by construction");
    assert(streq(seam_status_label(SEAM_ABSENT), "absent"), "absent label");
    assert(streq(seam_status_label(SEAM_REMOTE), "remote-client"), "remote label");
    assert(streq(seam_status_label(SEAM_NATIVE), "native"), "native label");
    return 0;
}

fn test_capability_ladder() {
    test_group("capability ladder (full/degraded/absent)");
    # effect labels
    assert(streq(cap_state_label(CAP_FULL), "full"), "full label");
    assert(streq(cap_state_label(CAP_DEGRADED), "degraded"), "degraded label");
    assert(streq(cap_state_label(CAP_ABSENT), "absent"), "absent label");
    # always-native vendored seams are FULL regardless of config
    assert_eq(seam_cap_state(SEAM_BOTE), CAP_FULL, "bote full (vendored)");
    assert_eq(seam_cap_state(SEAM_AVATARA), CAP_FULL, "avatara full (vendored)");
    # unconfigured: hoosh/daimon have no fallback -> ABSENT (never faked)
    assert_eq(seam_cap_state(SEAM_HOOSH), CAP_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_cap_state(SEAM_DAIMON), CAP_ABSENT, "daimon absent when unconfigured");
    # the honesty case: absent t-ron is DEGRADED (confirm gate), never ABSENT,
    # never silently allowing — security degrades CLOSED.
    assert_eq(seam_cap_state(SEAM_TRON), CAP_DEGRADED, "t-ron degrades closed, not absent");
    # full + fallback prose carry the honest semantics
    assert(streq(seam_cap_full(SEAM_TRON), "per-tool authorization on /run, /write, /call; deny is final"), "t-ron full prose");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_HOOSH), "absent:"), 1, "hoosh fallback is absent");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_DAIMON), "absent:"), 1, "daimon fallback is absent");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_TRON), "degraded:"), 1, "t-ron fallback is degraded");
    return 0;
}

fn test_session() {
    test_group("session state");
    session_reset();
    assert_eq(session_turns(), 0, "turns start 0");
    assert_eq(session_model(), 0, "model starts none");
    session_bump_turn();
    session_bump_turn();
    assert_eq(session_turns(), 2, "two turns counted");
    session_set_model("gpt-5");
    assert(streq(session_model(), "gpt-5"), "model set");
    session_reset();
    assert_eq(session_turns(), 0, "reset clears turns");
    assert_eq(session_model(), 0, "reset clears model");
    return 0;
}

# The avatara persona overlay (M5): identity SOURCED from the vendored archetype
# bundle (egyptian_thoth via the prof_* accessors), not a hardcoded stub. soul +
# spirit are the prose that feeds the hoosh system prompt.
fn test_persona() {
    test_group("avatara persona (M5)");
    assert(streq(persona_name(), "Thoth"), "name from avatara archetype");
    assert(streq(persona_role(), "the Librarian"), "role is thoth's overlay framing");
    assert(persona_soul() != 0, "soul present from avatara");
    assert_eq(cstr_starts_with(persona_soul(), "You are Thoth"), 1, "soul is the Thoth archetype voice");
    assert(persona_spirit() != 0, "spirit present from avatara");
    assert_eq(cstr_starts_with(persona_spirit(), "Your nature is precision"), 1, "spirit is precision");
    assert(persona_desc() != 0, "desc present from avatara");
    # the hoosh system prompt (M5 step 2): soul + spirit + thoth's operating clause
    var sysp = persona_system_prompt();
    assert(sysp != 0, "system prompt built");
    assert_eq(cstr_starts_with(sysp, "You are Thoth"), 1, "system prompt opens with the archetype soul");
    assert(strlen(sysp) > strlen(persona_soul()), "system prompt appends spirit + operating clause");
    return 0;
}

# Config defaults when no thoth.cyml is loaded (the test process loads none).
fn test_config() {
    test_group("hoosh config (unconfigured)");
    assert_eq(config_hoosh_configured(), 0, "not configured by default");
    assert(streq(config_hoosh_url(), "http://127.0.0.1:8088"), "localhost default url");
    assert_eq(config_hoosh_token(), 0, "no token by default");
    assert_eq(config_hoosh_model(), 0, "no model by default");
    assert_eq(config_hoosh_parallel(), 1, "parallel tool calls on by default");
    # unconfigured -> hoosh seam stays absent (honest degradation)
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    return 0;
}

# The hoosh client's pure pieces: escape, int-append, request building, and
# response/error extraction (no network).
fn test_hoosh() {
    test_group("hoosh request building");
    var eb[64];
    var n = _json_escape_into(&eb, 0, "a\"b");      # a " b
    store8(&eb + n, 0);
    assert(streq(&eb, "a\\\"b"), "escape double-quote");
    var n2 = _json_escape_into(&eb, 0, "x\ny");     # x <LF> y
    store8(&eb + n2, 0);
    assert(streq(&eb, "x\\ny"), "escape newline");
    var n3 = _json_escape_into(&eb, 0, "c\\d");     # c \ d
    store8(&eb + n3, 0);
    assert(streq(&eb, "c\\\\d"), "escape backslash");

    var ib[32];
    var inn = _append_int(&ib, 0, 4096);
    store8(&ib + inn, 0);
    assert(streq(&ib, "4096"), "append_int 4096");
    var iz = _append_int(&ib, 0, 0);
    store8(&ib + iz, 0);
    assert(streq(&ib, "0"), "append_int 0");

    var rb[256];
    hoosh_build_request(&rb, "m", 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "request shape, no system (0)");
    hoosh_build_request(&rb, "m", "", "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "empty system omitted");
    hoosh_build_request(&rb, "m", "be precise", "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"be precise\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "system message prepended");
    hoosh_build_request(&rb, "m", 0, "hi", 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":true}"), "stream=1 sets stream:true");

    test_group("hoosh response extraction");
    var body = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hello world\"}}]}";
    var s = hoosh_extract_content(body, strlen(body));
    assert(s != 0, "content present");
    assert(str_eq_cstr(s, "hello world"), "content matches");

    var empty = "{\"choices\":[]}";
    assert_eq(hoosh_extract_content(empty, strlen(empty)), 0, "empty choices -> 0");
    var nojson = "not json";
    assert_eq(hoosh_extract_content(nojson, strlen(nojson)), 0, "unparseable -> 0");

    var ebody = "{\"error\":{\"message\":\"no provider for model\"}}";
    var em = hoosh_extract_error(ebody, strlen(ebody));
    assert(em != 0, "error present");
    assert(str_eq_cstr(em, "no provider for model"), "error message matches");
    assert_eq(hoosh_extract_error(body, strlen(body)), 0, "no error field -> 0");

    test_group("hoosh model catalog extraction");
    var mbody = "{\"object\":\"list\",\"data\":[{\"id\":\"claude-sonnet-4-6\"},{\"id\":\"gpt-4o\"}]}";
    var data = hoosh_extract_models(mbody, strlen(mbody));
    assert(data != 0, "model list present");
    assert_eq(bayan_json_v_arr_len(data), 2, "two models in data array");
    var m0 = bayan_json_v_obj_get(bayan_json_v_arr_get(data, 0), "id");
    assert(str_eq_cstr(bayan_json_v_str(m0), "claude-sonnet-4-6"), "first model id matches");
    var mempty = "{\"object\":\"list\",\"data\":[]}";
    assert_eq(bayan_json_v_arr_len(hoosh_extract_models(mempty, strlen(mempty))), 0, "empty catalog -> 0-length array");
    assert_eq(hoosh_extract_models(body, strlen(body)), 0, "no data field -> 0");
    assert_eq(hoosh_extract_models(nojson, strlen(nojson)), 0, "unparseable -> 0");

    test_group("hoosh SSE delta extraction");
    var d1 = "{\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}";
    var ds = hoosh_extract_delta(d1, strlen(d1));
    assert(ds != 0, "delta content present");
    assert(str_eq_cstr(ds, "Hel"), "delta content matches");
    var drole = "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}";
    assert_eq(hoosh_extract_delta(drole, strlen(drole)), 0, "role-only delta -> 0");
    var dfin = "{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}";
    assert_eq(hoosh_extract_delta(dfin, strlen(dfin)), 0, "finish frame -> 0");
    var dnojson = "[DONE]";
    assert_eq(hoosh_extract_delta(dnojson, strlen(dnojson)), 0, "[DONE] sentinel -> 0");
    return 0;
}

# /models <provider> (0.7.1): hoosh's concrete per-provider catalog shares the
# /v1/models {object:list, data:[{id, owned_by}]} shape; the drill-down reuses
# hoosh_extract_models and filters owned_by with the case-insensitive _ci_eq.
fn test_provider_catalog() {
    test_group("provider model catalog (/models <provider>)");
    var cat = "{\"object\":\"list\",\"data\":[{\"id\":\"claude-sonnet-4\",\"object\":\"model\",\"owned_by\":\"anthropic\"},{\"id\":\"claude-opus-4\",\"object\":\"model\",\"owned_by\":\"anthropic\"},{\"id\":\"gpt-4o\",\"object\":\"model\",\"owned_by\":\"openai\"}]}";
    var d = hoosh_extract_models(cat, strlen(cat));
    assert(d != 0, "catalog data array present");
    assert_eq(bayan_json_v_arr_len(d), 3, "three catalog entries");
    var e0 = bayan_json_v_arr_get(d, 0);
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(e0, "owned_by")), "anthropic"), "entry owned_by parsed");
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(e0, "id")), "claude-sonnet-4"), "entry id parsed");
    # case-insensitive provider match (user may type 'Anthropic'; hoosh emits 'anthropic')
    assert_eq(_ci_eq("anthropic", "anthropic"), 1, "exact provider matches");
    assert_eq(_ci_eq("Anthropic", "anthropic"), 1, "provider match ignores case");
    assert_eq(_ci_eq("openai", "anthropic"), 0, "different providers do not match");
    assert_eq(_ci_eq("anthropic", "anthropi"), 0, "prefix is not a full match");
    # filter the catalog by provider (mirrors hoosh_list_provider_models)
    var matches = 0;
    var i = 0;
    while (i < bayan_json_v_arr_len(d)) {
        var m = bayan_json_v_arr_get(d, i);
        var ob = bayan_json_v_str(bayan_json_v_obj_get(m, "owned_by"));
        if (_ci_eq(str_cstr(ob), "anthropic") == 1) { matches = matches + 1; }
        i = i + 1;
    }
    assert_eq(matches, 2, "two anthropic models filtered from the catalog");
    return 0;
}

# [hoosh].stream config toggle: default on; the _cfg_bool reader maps the TOML
# literal true/false (parsed as text) and falls back on absent/garbage.
fn test_stream_config() {
    test_group("hoosh stream config");
    assert_eq(config_hoosh_stream(), 1, "streaming on by default (no config loaded)");
    assert_eq(_cfg_bool(0, "x", 1), 1, "null pairs -> default 1");
    assert_eq(_cfg_bool(0, "x", 0), 0, "null pairs -> default 0");
    var toml = "[hoosh]\nstream = false\non = true\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    var secs = bayan_toml_get_sections(sections, "hoosh");
    var pairs = bayan_toml_section_pairs(vec_get(secs, 0));
    assert_eq(_cfg_bool(pairs, "stream", 1), 0, "explicit false read as 0");
    assert_eq(_cfg_bool(pairs, "on", 0), 1, "explicit true read as 1");
    assert_eq(_cfg_bool(pairs, "missing", 1), 1, "absent key -> default");
    return 0;
}

# Multi-turn conversation history (0.5.1): append/accessors, stable copy,
# pop/clear, and the drop-oldest cap.
fn test_history() {
    test_group("multi-turn history");
    session_reset();
    assert_eq(session_history_len(), 0, "history empty after reset");
    assert_eq(config_hoosh_history(), 1, "history on by default");

    session_history_append("user", "hello", 5);
    session_history_append("assistant", "hi there", 8);
    assert_eq(session_history_len(), 2, "two messages recorded");
    assert(streq(session_history_role(0), "user"), "msg 0 role user");
    assert(streq(session_history_content(0), "hello"), "msg 0 content");
    assert(streq(session_history_role(1), "assistant"), "msg 1 role assistant");
    assert(streq(session_history_content(1), "hi there"), "msg 1 content");

    # content is a STABLE COPY, not an alias of the caller's buffer.
    var buf[8];
    store8(&buf + 0, 104); store8(&buf + 1, 105); store8(&buf + 2, 0);   # "hi"
    session_history_append("user", &buf, 2);
    store8(&buf + 0, 88);                                                # clobber -> "Xi"
    assert(streq(session_history_content(2), "hi"), "content copied, not aliased");

    session_history_pop_last();
    assert_eq(session_history_len(), 2, "pop_last drops the newest turn");
    session_history_clear();
    assert_eq(session_history_len(), 0, "clear empties history");

    var i = 0;
    while (i < SESS_HIST_MAX + 5) { session_history_append("user", "x", 1); i = i + 1; }
    assert_eq(session_history_len(), SESS_HIST_MAX, "capped at SESS_HIST_MAX (oldest dropped)");
    session_reset();
    return 0;
}

# The multi-turn request builder + the byte-budget that bounds it.
fn test_history_request() {
    test_group("multi-turn request building");
    session_reset();
    assert_eq(_hoosh_history_start(262144), 0, "empty history -> start 0");
    session_history_append("user", "a", 1);
    session_history_append("assistant", "b", 1);
    session_history_append("user", "c", 1);
    assert_eq(_hoosh_history_start(262144), 0, "ample budget includes all");
    assert_eq(_hoosh_history_start(8), 2, "tiny budget keeps only the newest");

    var rb[512];
    hoosh_build_messages(&rb, "m", 0, 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"a\"},{\"role\":\"assistant\",\"content\":\"b\"},{\"role\":\"user\",\"content\":\"c\"}],\"max_tokens\":4096,\"stream\":false}"), "multi-turn shape, no system");
    hoosh_build_messages(&rb, "m", "sys", 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"a\"},{\"role\":\"assistant\",\"content\":\"b\"},{\"role\":\"user\",\"content\":\"c\"}],\"max_tokens\":4096,\"stream\":true}"), "multi-turn shape, system + stream");
    session_reset();
    return 0;
}

# Structured driver-event logging (0.5.2): the pure message builder + level
# parse + config defaults. The sakshi emit path is I/O and not unit-tested here.
fn test_logging() {
    test_group("structured logging");
    # off by default (no config, no init)
    assert_eq(config_log_file(), 0, "no log file by default");
    assert_eq(config_log_level(), 0, "no log level by default");
    assert_eq(log_active(), 0, "logging off without init");

    # level parse
    assert_eq(_log_parse_level("off"), 0 - 1, "off -> disabled");
    assert_eq(_log_parse_level("fatal"), SK_FATAL, "fatal");
    assert_eq(_log_parse_level("error"), SK_ERROR, "error");
    assert_eq(_log_parse_level("warn"), SK_WARN, "warn");
    assert_eq(_log_parse_level("info"), SK_INFO, "info");
    assert_eq(_log_parse_level("debug"), SK_DEBUG, "debug");
    assert_eq(_log_parse_level("trace"), SK_TRACE, "trace");
    assert_eq(_log_parse_level(0), SK_INFO, "unset -> default info");
    assert_eq(_log_parse_level("bogus"), SK_INFO, "unknown -> default info");

    # structured message builder
    log_begin("hoosh_turn");
    log_kv_str("model", "gpt-5");
    log_kv_int("status", 200);
    assert(streq(log_message(), "event=hoosh_turn model=gpt-5 status=200"), "structured message shape");
    log_begin("authz");
    log_kv_str("tool", 0);
    assert(streq(log_message(), "event=authz tool=-"), "null value renders as -");
    log_begin("x");
    log_kv_int("d", 0 - 5);
    assert(streq(log_message(), "event=x d=-5"), "negative int field");
    return 0;
}

# Agentic tool-calling loop (0.6.0): the pure pieces — tool advertisement,
# tool_calls parsing, raw extraction, and request shaping. The loop itself is I/O.
fn test_agent() {
    test_group("agentic tool-calling");
    assert_eq(agent_enabled(), 0, "agentic off when daimon absent (no config)");

    # tool advertisement: daimon {name,description} -> OpenAI function tools
    var ta = "[{\"name\":\"echo\",\"description\":\"echo back\"},{\"name\":\"clk\",\"description\":\"time\"}]";
    var tav = bayan_json_v_parse_str(ta, strlen(ta));
    var tb[1024];
    agent_format_tools(&tb, tav);
    assert(streq(&tb, "[{\"type\":\"function\",\"function\":{\"name\":\"echo\",\"description\":\"echo back\",\"parameters\":{\"type\":\"object\"}}},{\"type\":\"function\",\"function\":{\"name\":\"clk\",\"description\":\"time\",\"parameters\":{\"type\":\"object\"}}}]"), "tools formatted as OpenAI functions");
    assert_eq(agent_format_tools(&tb, 0), 0, "no tools value -> 0 length");

    # daimon 1.2.7: per-tool inputSchema passes through verbatim as `parameters`;
    # a tool without one falls back to the permissive object schema.
    var ts = "[{\"name\":\"rd\",\"description\":\"read\",\"inputSchema\":{\"type\":\"string\"}},{\"name\":\"clk\",\"description\":\"time\"}]";
    var tsv = bayan_json_v_parse_str(ts, strlen(ts));
    agent_format_tools(&tb, tsv);
    assert(streq(&tb, "[{\"type\":\"function\",\"function\":{\"name\":\"rd\",\"description\":\"read\",\"parameters\":{\"type\":\"string\"}}},{\"type\":\"function\",\"function\":{\"name\":\"clk\",\"description\":\"time\",\"parameters\":{\"type\":\"object\"}}}]"), "inputSchema passed through; absent -> object fallback");

    # tool_calls parsing from an OpenAI-shaped response
    var resp = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"echo\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}]}";
    var tcs = agent_tool_calls(resp, strlen(resp));
    assert(tcs != 0, "tool_calls present");
    assert_eq(agent_tc_count(tcs), 1, "one tool call");
    assert(streq(agent_tc_id(tcs, 0), "call_1"), "tool_call id");
    assert(streq(agent_tc_name(tcs, 0), "echo"), "tool_call name");
    assert(streq(agent_tc_args(tcs, 0), "{}"), "tool_call arguments");

    var plain = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hi\"}}]}";
    assert_eq(agent_tc_count(agent_tool_calls(plain, strlen(plain))), 0, "no tool_calls -> count 0");

    # raw tool_calls substring (echoed back verbatim as the assistant message)
    var raw = _agent_raw_tool_calls(resp, strlen(resp));
    assert(raw != 0, "raw tool_calls extracted");
    assert_eq(cstr_starts_with(raw, "[{\"id\":\"call_1\""), 1, "raw is the array text");

    # request shaping: history + tools
    session_reset();
    session_history_append("user", "hi", 2);
    var rb[512];
    agent_build_request(&rb, "m", 0, 0, 0, 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "agent request: history, no tools");
    var toolsb = "[{\"type\":\"function\"}]";
    agent_build_request(&rb, "m", 0, toolsb, strlen(toolsb), 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"tools\":[{\"type\":\"function\"}],\"max_tokens\":4096,\"stream\":true}"), "agent request: with tools, streaming");
    session_reset();

    # streamed tool_call assembly: deltas arrive fragmented (id+name first, then
    # arguments in pieces), reconstructed into the same array text the block path
    # produces. Mirrors OpenAI streaming tool_calls.
    _ag_reset();
    var d1 = "{\"index\":0,\"id\":\"call_9\",\"type\":\"function\",\"function\":{\"name\":\"echo\",\"arguments\":\"{\\\"t\\\":\"}}";
    _agent_accum_delta(bayan_json_v_parse_str(d1, strlen(d1)));
    var d2 = "{\"index\":0,\"function\":{\"arguments\":\"42}\"}}";
    _agent_accum_delta(bayan_json_v_parse_str(d2, strlen(d2)));
    var ab[1024];
    _ag_build_array(&ab);
    assert(streq(&ab, "[{\"id\":\"call_9\",\"type\":\"function\",\"function\":{\"name\":\"echo\",\"arguments\":\"{\\\"t\\\":42}\"}}]"), "streamed deltas reassemble into the tool_calls array");
    # and the reassembled array parses back through the same accessors
    var av = bayan_json_v_parse_str(&ab, strlen(&ab));
    assert_eq(agent_tc_count(av), 1, "reassembled: one call");
    assert(streq(agent_tc_name(av, 0), "echo"), "reassembled: name");
    assert(streq(agent_tc_args(av, 0), "{\"t\":42}"), "reassembled: args decoded");
    return 0;
}

# M4 config defaults when no thoth.cyml is loaded.
fn test_config_m4() {
    test_group("daimon/tron config (unconfigured)");
    assert_eq(config_daimon_configured(), 0, "daimon not configured by default");
    assert_eq(config_daimon_url(), 0, "no daimon url by default");
    assert_eq(config_tron_policy(), 0, "no t-ron policy by default");
    assert(streq(config_tron_agent(), "thoth"), "default agent id");
    assert_eq(gate_active(), 0, "gate inactive without a policy");
    return 0;
}

# The daimon client's pure pieces: call-body building and tool-result
# extraction against canned bodies (no network).
fn test_daimon() {
    test_group("daimon call building");
    var cb[256];
    daimon_build_call(&cb, "echo", "{\"x\":1}");
    assert(streq(&cb, "{\"name\":\"echo\",\"arguments\":{\"x\":1}}"), "call body with args");
    daimon_build_call(&cb, "scan", 0);
    assert(streq(&cb, "{\"name\":\"scan\",\"arguments\":{}}"), "call body, no args -> {}");
    daimon_build_call(&cb, "we\"ird", 0);
    assert(streq(&cb, "{\"name\":\"we\\\"ird\",\"arguments\":{}}"), "tool name is escaped");

    test_group("daimon result extraction");
    var ok = "{\"content\":[{\"type\":\"text\",\"text\":\"tool says hi\"}],\"isError\":false}";
    var s = daimon_extract_text(ok, strlen(ok));
    assert(s != 0, "text present");
    assert(str_eq_cstr(s, "tool says hi"), "text matches");
    assert_eq(daimon_extract_is_error(ok, strlen(ok)), 0, "isError false -> 0");
    var bad = "{\"content\":[{\"type\":\"text\",\"text\":\"boom\"}],\"isError\":true}";
    assert_eq(daimon_extract_is_error(bad, strlen(bad)), 1, "isError true -> 1");
    var none = "{\"ok\":true}";
    assert_eq(daimon_extract_text(none, strlen(none)), 0, "no content -> 0");
    assert_eq(daimon_extract_is_error(none, strlen(none)), 0 - 1, "no isError -> -1");
    var nojson = "nope";
    assert_eq(daimon_extract_text(nojson, strlen(nojson)), 0, "unparseable -> 0");
    return 0;
}

# The vendored t-ron engine end-to-end in-process: policy allow/deny globs,
# deny-by-default for unknown agents, and the audit path (libro chain_append —
# the sigil/thread_local ordering canary).
fn test_tron() {
    test_group("t-ron verdicts (vendored engine)");
    var t = tron_new(tron_config_default());
    var pol = "[agent.\"thoth\"]\nallow = [\"echo_*\", \"thoth_run\"]\ndeny = [\"danger_*\"]\n";
    assert_eq(tron_load_policy(t, pol), TRON_ERR_NONE, "policy parses");

    var c1 = tool_call_new("thoth", "echo_hello", "{}", 1000);
    assert_eq(verdict_kind(tron_check(t, c1)), VK_ALLOW, "allow-listed tool -> allow");
    var c2 = tool_call_new("thoth", "danger_rm", "{}", 2000);
    assert_eq(verdict_kind(tron_check(t, c2)), VK_DENY, "deny-listed tool -> deny");
    var c3 = tool_call_new("thoth", "unlisted_tool", "{}", 3000);
    assert_eq(verdict_kind(tron_check(t, c3)), VK_DENY, "unlisted tool -> deny (fail closed)");
    var c4 = tool_call_new("mallory", "echo_hello", "{}", 4000);
    assert_eq(verdict_kind(tron_check(t, c4)), VK_DENY, "unknown agent -> deny (fail closed)");
    var c5 = tool_call_new("thoth", "thoth_run", "{\"cmd\":\"echo hi\"}", 5000);
    assert_eq(verdict_kind(tron_check(t, c5)), VK_ALLOW, "thoth_run allowed by policy");
    return 0;
}

# The audit chain: every tron_check logs to t-ron's AuditLogger (operational
# ring + libro cryptographic chain). thoth's /audit surfaces it; this drives
# the real vendored engine and asserts the counts, integrity, and the pure
# kind-label glue thoth authors over it.
fn test_audit() {
    test_group("t-ron audit chain (vendored engine)");
    # pure glue first — independent of any engine state.
    assert(streq(audit_kind_str(VK_ALLOW), "allow"), "VK_ALLOW -> allow");
    assert(streq(audit_kind_str(VK_DENY), "deny"), "VK_DENY -> deny");
    assert(streq(audit_kind_str(VK_FLAG), "flag"), "VK_FLAG -> flag");
    assert(streq(audit_kind_str(99), "?"), "unknown kind -> ?");

    var t = tron_new(tron_config_default());
    var pol = "[agent.\"thoth\"]\nallow = [\"echo_*\"]\ndeny = [\"danger_*\"]\n";
    assert_eq(tron_load_policy(t, pol), TRON_ERR_NONE, "policy parses");
    var a = tron_audit(t);
    assert_eq(query_total_events(a), 0, "empty chain before any check");

    tron_check(t, tool_call_new("thoth", "echo_hi", "{}", 1000));    # allow
    tron_check(t, tool_call_new("thoth", "danger_rm", "{}", 2000));  # deny
    tron_check(t, tool_call_new("thoth", "unlisted", "{}", 3000));   # deny (fail closed)

    assert_eq(query_total_events(a), 3, "three gated actions logged");
    assert_eq(query_total_denials(a), 2, "two denials counted");
    assert_eq(audit_chain_len(a), 3, "libro chain has three entries");
    assert_eq(audit_verify_chain(a), 0, "chain integrity intact (no tamper)");
    # newest-first: the most recent event is the unlisted deny.
    var recent = audit_recent(a, 10);
    assert_eq(vec_len(recent), 3, "recent returns all three");
    assert_eq(security_event_kind(vec_get(recent, 0)), VK_DENY, "newest is a deny");
    assert(streq(security_event_tool_name(vec_get(recent, 0)), "unlisted"), "newest tool is 'unlisted'");
    return 0;
}

# Mid-session model switch stores a COPY (the arg aliases a reused line buffer).
fn test_model_switch() {
    test_group("mid-session model switch");
    session_reset();
    assert_eq(session_model(), 0, "no model after reset");
    var scratch[16];
    store8(&scratch + 0, 103); store8(&scratch + 1, 112); store8(&scratch + 2, 116);
    store8(&scratch + 3, 0);                                   # "gpt"
    session_set_model_copy(&scratch);
    store8(&scratch + 0, 88);                                  # clobber to "Xpt"
    assert(streq(session_model(), "gpt"), "model is a stable copy, not an alias");
    session_reset();
    return 0;
}

# Agentic tool-round trace (roundlog): the session-local ring /audit surfaces.
# Pure data-structure ops — no I/O — so the recording + ring eviction is testable.
fn test_roundlog() {
    test_group("agentic tool rounds (roundlog)");
    roundlog_reset();
    assert_eq(roundlog_total(), 0, "empty total");
    assert_eq(roundlog_count(), 0, "empty count");

    # one round (turn 5, round 1) with three calls: allow+ok, deny, noname
    roundlog_open(5, 1);
    roundlog_add_call("read_file", RL_ALLOWED, 1);
    roundlog_add_call("write_file", RL_DENIED, 0);
    roundlog_add_call(0, RL_NONAME, 0);
    assert_eq(roundlog_total(), 1, "one round opened");
    assert_eq(roundlog_count(), 1, "one round retained");
    assert_eq(roundlog_round_turn(0), 5, "round turn = 5");
    assert_eq(roundlog_round_no(0), 1, "round no = 1");
    assert_eq(roundlog_round_ncalls(0), 3, "three calls recorded");
    assert(streq(roundlog_call_name(0, 0), "read_file"), "call0 name copied");
    assert_eq(roundlog_call_kind(0, 0), RL_ALLOWED, "call0 allowed");
    assert_eq(roundlog_call_ok(0, 0), 1, "call0 ok");
    assert(streq(roundlog_call_name(0, 1), "write_file"), "call1 name copied");
    assert_eq(roundlog_call_kind(0, 1), RL_DENIED, "call1 denied");
    assert_eq(roundlog_call_kind(0, 2), RL_NONAME, "call2 noname");
    assert(streq(roundlog_call_name(0, 2), ""), "call2 empty name (null in)");

    # verdict labels
    assert(streq(roundlog_kind_str(RL_ALLOWED), "allow"), "kind str allow");
    assert(streq(roundlog_kind_str(RL_DENIED), "deny"), "kind str deny");
    assert(streq(roundlog_kind_str(RL_NONAME), "noname"), "kind str noname");

    # a round caps at RL_MAX_CALLS calls; extra calls are dropped (announced via report)
    roundlog_reset();
    roundlog_open(1, 1);
    var c = 0;
    while (c < (RL_MAX_CALLS + 3)) { roundlog_add_call("t", RL_ALLOWED, 1); c = c + 1; }
    assert_eq(roundlog_round_ncalls(0), RL_MAX_CALLS, "round caps at RL_MAX_CALLS calls");

    # ring eviction: open CAP+2 rounds (round_no = global index); oldest two drop off
    roundlog_reset();
    var g = 1;
    while (g <= (ROUNDLOG_CAP + 2)) {
        roundlog_open(1, g);
        roundlog_add_call("x", RL_ALLOWED, 1);
        g = g + 1;
    }
    assert_eq(roundlog_total(), ROUNDLOG_CAP + 2, "total counts every round opened");
    assert_eq(roundlog_count(), ROUNDLOG_CAP, "ring retains only CAP rounds");
    assert_eq(roundlog_round_no(0), 3, "oldest retained is global round 3 (1,2 evicted)");
    assert_eq(roundlog_round_no(roundlog_count() - 1), ROUNDLOG_CAP + 2, "newest retained is last opened");
    roundlog_reset();
    return 0;
}

# The parallel executor's pure piece: the bounded snapshot copy that lifts each
# call's name/args/id out of the (soon-overwritten) parser value into a stable
# per-slot buffer before fan-out. The phasing + threads themselves are I/O and
# exercised live against daimon; this guards the copy's bounds + NUL-termination.
fn test_parallel() {
    test_group("parallel tool-call snapshot copy");
    var b[16];
    var n = _par_cstr_copy(&b, 16, "read_file");
    assert_eq(n, 9, "copies full length");
    assert(streq(&b, "read_file"), "exact copy NUL-terminated");
    # truncation: cap 4 keeps 3 bytes + NUL
    var t = _par_cstr_copy(&b, 4, "abcdef");
    assert_eq(t, 3, "truncates to cap-1 bytes");
    assert(streq(&b, "abc"), "truncated copy NUL-terminated");
    # null src -> empty string, length 0
    var z = _par_cstr_copy(&b, 16, 0);
    assert_eq(z, 0, "null src copies nothing");
    assert(streq(&b, ""), "null src yields empty string");
    return 0;
}

# Bounded request-assembly helpers: the defensive primitives every model/MCP-fed
# builder now writes through, so an oversized untrusted string truncates in-buffer
# instead of overflowing a fixed destination. Each check plants a canary one byte
# past the cap and asserts it survives.
fn test_bounds_hardening() {
    test_group("bounded request assembly (untrusted-input clamp)");
    # _append_cstr_cap stops at cap-1 (reserving the last byte for the caller's NUL);
    # the byte at index cap is never touched.
    var ab[64];
    store8(&ab + 16, 123);                                     # canary at the cap
    var n = _append_cstr_cap(&ab, 0, 16, "0123456789abcdefghij");   # 20 chars into cap 16
    assert_eq(n, 15, "append_cstr_cap stops at cap-1");
    assert_eq(load8(&ab + 16), 123, "append_cstr_cap leaves the byte at cap untouched");

    # _json_escape_into_cap stops before a worst-case 6-byte escape can reach the
    # cap, truncating on a character boundary (never a split escape).
    var eb[64];
    store8(&eb + 20, 77);                                      # canary
    var nl = "\n\n\n\n\n\n\n\n\n\n\n\n";                        # 12 LF bytes, each -> "\n" (2 bytes)
    var m = _json_escape_into_cap(&eb, 0, 20, nl);
    assert(m <= 19, "json_escape_into_cap stays within cap-1");
    assert_eq(load8(&eb + 20), 77, "json_escape_into_cap leaves the byte at cap untouched");
    assert_eq(m - (m / 2) * 2, 0, "escape truncates on a character boundary (whole escapes only)");

    # end-to-end: an oversized model `arguments` string cannot overflow the fixed
    # 32 KB daimon request buffer — daimon_build_call clamps to DAIMON_REQ_CAP and a
    # canary one byte past the buffer survives.
    var big = alloc(DAIMON_REQ_CAP + 16);
    store8(big + DAIMON_REQ_CAP, 200);                         # canary just past the cap
    var hug = alloc(DAIMON_REQ_CAP + 1024);
    var k = 0;
    while (k < (DAIMON_REQ_CAP + 1023)) { store8(hug + k, 97); k = k + 1; }   # 'a' * (cap+1023)
    store8(hug + (DAIMON_REQ_CAP + 1023), 0);
    var bo = daimon_build_call(big, "x", hug);
    assert(bo <= (DAIMON_REQ_CAP - 1), "daimon_build_call clamps oversized args to cap-1");
    assert_eq(load8(big + DAIMON_REQ_CAP), 200, "oversized args do not overflow _daimon_req (canary intact)");
    return 0;
}

# Presentation surface (M7 / ADR-0009): the T0 floor must emit NO escapes (so
# piped/CI output is byte-identical), and T1 must produce the design's exact amber.
fn test_ui() {
    test_group("presentation surface (M7 ui.cyr)");
    # substrate helpers
    assert_eq(_ui_contains("xterm-256color", "256color"), 1, "_ui_contains finds substring");
    assert_eq(_ui_contains("xterm", "256color"), 0, "_ui_contains misses absent substring");
    var db[8];
    var dn = _ui_dec(&db, 0, 230); store8(&db + dn, 0);
    assert(streq(&db, "230"), "_ui_dec writes decimal");

    # T0 floor: every role + reset resolves to the empty string
    ui_force(PT_PLAIN, CD_NONE);
    assert_eq(ui_tier(), PT_PLAIN, "forced T0 plain");
    assert_eq(streq(ui_sgr(ROLE_ACCENT), ""), 1, "T0 accent role -> empty (no escapes)");
    assert_eq(streq(ui_sgr(ROLE_GREEN), ""), 1, "T0 green role -> empty");
    assert_eq(streq(ui_reset(), ""), 1, "T0 reset -> empty");

    # T1 truecolor: exact #e6ab5c amber + well-formed SGR envelope
    ui_force(PT_ANSI, CD_TRUE);
    var acc = ui_sgr(ROLE_ACCENT);
    assert_eq(load8(acc), 27, "T1 SGR starts with ESC");
    assert_eq(load8(acc + 1), 91, "T1 SGR second byte is '['");
    assert_eq(_ui_contains(acc, "38;2;230;171;92"), 1, "T1 accent is the #e6ab5c truecolor SGR");
    var rexp[8];
    store8(&rexp, 27); store8(&rexp + 1, 91); store8(&rexp + 2, 48); store8(&rexp + 3, 109); store8(&rexp + 4, 0);
    assert_eq(streq(ui_reset(), &rexp), 1, "T1 reset is ESC[0m");

    # 256-color fallback maps the accent to its cube index
    ui_force(PT_ANSI, CD_256);
    assert_eq(_ui_contains(ui_sgr(ROLE_ACCENT), "38;5;179"), 1, "256-color accent -> index 179");

    # restore detection (the suite runs piped -> resolves back to T0)
    ui_detect_tier();
    return 0;
}

# Diff producer (0.8.3): the pure LCS line-diff core. diff_stats returns
# adds*1000000 + dels (or -1 if a side exceeds the line cap). Identity is
# NEWLINE-AWARE (a terminated line differs from an unterminated one) so the card
# can never under-report the bytes written.
fn test_diff() {
    test_group("diff producer (0.8.3)");
    var a = "a\nb\nc\n";
    assert_eq(diff_stats(a, strlen(a), a, strlen(a)), 0, "identical -> 0 adds 0 dels");
    var e = "";
    var x = "x\n";
    assert_eq(diff_stats(e, 0, x, strlen(x)), 1000000, "empty old -> one add");
    assert_eq(diff_stats(x, strlen(x), e, 0), 1, "empty new -> one del");
    var c2 = "a\nB\nc\n";
    assert_eq(diff_stats(a, strlen(a), c2, strlen(c2)), 1000001, "one line changed -> 1 add 1 del");
    var ins1 = "a\nc\n";
    assert_eq(diff_stats(ins1, strlen(ins1), a, strlen(a)), 1000000, "insert middle (b) -> 1 add");
    # newline-aware: an unterminated final line vs a terminated one is a REAL change
    var nl1 = "hello";
    var nl2 = "hello\n";
    assert_eq(diff_stats(nl1, strlen(nl1), nl2, strlen(nl2)), 1000001, "newline-only change is visible (1 add 1 del)");
    var r1 = "one\ntwo\n";
    var r2 = "uno\ndos\n";
    assert_eq(diff_stats(r1, strlen(r1), r2, strlen(r2)), 2000002, "full replace -> 2 add 2 del");
    return 0;
}

# Syntax highlighting (0.8.4): the vyakarana integration — language detection,
# tokenization, and the token-kind -> color-role mapping for /read.
fn test_highlight() {
    test_group("syntax highlighting (vyakarana, 0.8.4)");
    var lang = detect_language("foo.cyr");
    assert(lang != 0, "detect_language finds a grammar for .cyr");
    var s = tokenize_stream_new(lang);
    assert(s != 0, "stream opens for the detected language");
    var src = "var x = 1;";
    tokenize_stream_feed(s, src, strlen(src));
    var tb = tokenbuf_new();
    tokenize_stream_drain(s, tb);
    tokenize_stream_finish(s, tb);
    var count = tokenbuf_count(tb);
    assert(count > 0, "produced tokens");
    var i = 0;
    var found_kw = 0;
    while (i < count) {
        if (tokenbuf_kind(tb, i) == TK_KEYWORD) { found_kw = 1; }
        i = i + 1;
    }
    assert_eq(found_kw, 1, "'var' tokenized as a keyword");
    tokenize_stream_free(s);
    # the kind -> role map
    assert_eq(_tok_role(TK_KEYWORD), ROLE_ACCENT, "keyword -> accent");
    assert_eq(_tok_role(TK_STRING), ROLE_GREEN, "string -> green");
    assert(_tok_role(TK_IDENT) < 0, "ident -> uncolored (-1)");
    return 0;
}

# T2 rich-TUI (0.9.0): the PURE pieces — the composer line-editor state machine and
# the layout geometry. The raw-mode I/O loop is verified on a live tty, not here.
fn test_tui() {
    test_group("T2 composer + layout (tui.cyr)");
    led_reset();
    led_feed(KEY_CHAR, 104); led_feed(KEY_CHAR, 105);            # h i
    assert_eq(led_len(), 2, "two chars typed");
    assert(streq(led_buf(), "hi"), "buffer is 'hi'");
    led_feed(KEY_LEFT, 0);
    led_feed(KEY_CHAR, 88);                                      # X before 'i'
    assert(streq(led_buf(), "hXi"), "insert at cursor");
    assert_eq(led_cur(), 2, "cursor sits after the inserted char");
    led_feed(KEY_BACKSPACE, 0);
    assert(streq(led_buf(), "hi"), "backspace removes the inserted char");
    led_feed(KEY_END, 0); led_feed(KEY_CHAR, 33);                # End, '!'
    assert(streq(led_buf(), "hi!"), "End + append");
    assert_eq(led_feed(KEY_ENTER, 0), ACT_SUBMIT, "Enter submits");
    led_feed(KEY_KILL, 0);
    assert_eq(led_len(), 0, "Ctrl-U clears the line");
    assert_eq(led_feed(KEY_EOF, 0), ACT_EOF, "real stdin EOF -> exit");
    led_feed(KEY_CHAR, 122);                                    # 'z' (non-empty line)
    assert_eq(led_feed(KEY_CTRLC, 0), ACT_EOF, "Ctrl-C exits even with text in the line");
    # geometry
    assert_eq(tui_status_row(), 1, "status bar at row 1");
    assert_eq(tui_composer_row(24), 23, "composer just above the hint row");
    assert_eq(tui_hint_row(24), 24, "keybinding hint at the last row");
    assert_eq(tui_feed_top(1), 2, "feed starts below a shown status bar");
    assert_eq(tui_feed_top(0), 1, "feed reclaims row 1 when status hidden");
    assert_eq(tui_feed_bot(24), 22, "feed bottom sits above the composer + hint");
    # slash-command palette matchers
    assert_eq(_buf_has_space("/seams x", 8), 1, "space detected -> command token complete");
    assert_eq(_buf_has_space("/se", 3), 0, "no space -> still typing the token");
    assert_eq(tui_palette_count("/s"), 2, "'/s' matches /seams + /state");
    assert_eq(tui_palette_count("/se"), 1, "'/se' matches /seams only");
    assert_eq(tui_palette_count("/m"), 2, "'/m' matches /model + /models");
    assert_eq(tui_palette_count("/c"), 2, "'/c' matches /call + /clear");
    assert_eq(tui_palette_count("/zz"), 0, "no command matches '/zz'");
    led_reset();
    led_feed(KEY_CHAR, 47); led_feed(KEY_CHAR, 115);            # "/s"
    assert_eq(tui_palette_active(), 1, "palette active while typing '/s'");
    led_feed(KEY_CHAR, 32);                                     # "/s "
    assert_eq(tui_palette_active(), 0, "palette closes once a space is typed");
    led_reset();
    led_feed(KEY_CHAR, 104);                                    # "h"
    assert_eq(tui_palette_active(), 0, "palette inactive for non-slash input");
    return 0;
}

# Feed escape-aware clip (0.9.1): paint a stored line into a width-W column
# without severing a CSI / UTF-8 glyph, suppressing ESC[K, never overrunning
# dst_cap, and counting color escapes as zero width. Pure — the load-bearing
# primitive for the self-managed feed (and the 0.9.3 left-column pane).
fn test_feed() {
    test_group("feed escape-aware clip (feed.cyr)");
    feed_init();
    var dst[512];
    var w = feed_clip(&dst, 512, "hello", 5, 3);
    store8(&dst + w, 0);
    assert(streq(&dst, "hel"), "clip 'hello' to 3 cols -> 'hel'");
    assert_eq(w, 3, "wrote 3 bytes for 3 ASCII cols");
    var w0 = feed_clip(&dst, 512, "hi", 2, 80);
    store8(&dst + w0, 0);
    assert(streq(&dst, "hi"), "short line copied whole under a wide column");
    # visible width counts glyphs, never the escapes
    assert_eq(feed_visible_cols("\x1b[33mAB\x1b[0m", 11), 2, "visible cols counts glyphs not escapes");
    assert_eq(feed_visible_cols("plain", 5), 5, "visible cols of plain text");
    # a clipped color span keeps its opening escape + the glyph + a closing reset
    var w1 = feed_clip(&dst, 512, "\x1b[33mAB\x1b[0m", 11, 1);
    assert_eq(w1, 10, "color clip: open escape (5) + 'A' (1) + reset (4)");
    assert_eq(load8(&dst), 27, "clipped row begins with ESC (color preserved)");
    assert_eq(load8(&dst + 5), 65, "the single visible glyph is 'A'");
    assert_eq(load8(&dst + 6), 27, "trailing reset escape follows the glyph");
    # dst_cap is a hard ceiling even with a huge max_cols (no heap overrun)
    var w2 = feed_clip(&dst, 4, "hello", 5, 100);
    assert_eq(w2, 4, "dst_cap=4 clamps output to 4 bytes");
    # ESC[K is dropped (it would erase to the physical eol, scribbling a neighbour)
    var w3 = feed_clip(&dst, 512, "A\x1b[KB", 5, 80);
    store8(&dst + w3, 0);
    assert(streq(&dst, "AB"), "ESC[K dropped from the painted row");
    assert_eq(w3, 2, "ESC[K contributes zero bytes");
    # only a real CSI ESC[...K is suppressed; a 2-byte ESC-K (which untrusted model
    # output could contain) is preserved verbatim, not dropped
    var w3b = feed_clip(&dst, 512, "A\x1bKB", 4, 80);
    assert_eq(w3b, 4, "2-byte ESC-K preserved (only CSI ESC[...K is suppressed)");
    # a color escape after the clip point is copied WHOLE, never severed mid-CSI
    var w4 = feed_clip(&dst, 512, "X\x1b[31mY", 7, 1);
    assert_eq(load8(&dst), 88, "first visible glyph 'X'");
    assert_eq(w4, 6, "'X' + the whole ESC[31m (zero-width), 'Y' clipped");
    # a UTF-8 glyph is one column and is copied as a unit (never half a codepoint)
    var w5 = feed_clip(&dst, 512, "\xc3\xa9z", 3, 1);   # 'e-acute' (2 bytes) + 'z'
    assert_eq(w5, 2, "one UTF-8 glyph = one col, copied whole; 'z' clipped");
    assert_eq(load8(&dst), 195, "UTF-8 lead byte copied");
    assert_eq(load8(&dst + 1), 169, "UTF-8 continuation copied (glyph not severed)");
    return 0;
}

# Feed ring (0.9.1): feed_write accumulates a logical line across calls, seals a
# slot per newline (the '\n' itself not stored), seals a bare newline as a blank
# row, flushes an un-newlined tail, and evicts the oldest line in O(1) when the
# ring fills. Row 0 = the oldest LIVE line.
fn test_feed_ring() {
    test_group("feed ring buffer (feed.cyr)");
    feed_init();
    assert_eq(feed_count(), 0, "empty ring");
    feed_write("a", 1);
    feed_write("b", 1);
    assert_eq(feed_count(), 0, "no newline yet -> nothing sealed");
    feed_write("\n", 1);
    assert_eq(feed_count(), 1, "newline seals one slot");
    assert_eq(feed_line_len(0), 2, "sealed slot holds 2 bytes");
    var p = feed_line_ptr(0);
    assert_eq(load8(p), 97, "first byte 'a'");
    assert_eq(load8(p + 1), 98, "second byte 'b' (multi-call line reconstructed)");
    assert_eq(feed_vis(0), 2, "cached visible cols = 2");
    feed_write("\n", 1);
    assert_eq(feed_count(), 2, "bare newline yields a blank row");
    assert_eq(feed_line_len(1), 0, "blank row has zero length");
    feed_write("tail", 4);
    feed_flush_pending();
    assert_eq(feed_count(), 3, "flush seals the un-newlined tail");
    assert_eq(feed_line_len(2), 4, "tail row holds 4 bytes");
    # eviction: write FEED_ROWS+3 distinct lines; count caps, the oldest 3 drop.
    feed_init();
    var ch[2];
    store8(&ch + 1, 10);                       # trailing newline (constant)
    var i = 0;
    while (i < (FEED_ROWS + 3)) {
        store8(&ch, 65 + (i % 26));            # 'A'..'Z' cycling
        feed_write(&ch, 2);
        i = i + 1;
    }
    assert_eq(feed_count(), FEED_ROWS, "ring caps at FEED_ROWS lines");
    # the 4th line written (index 3) is the oldest survivor: 'A' + (3%26) = 'D'.
    assert_eq(load8(feed_line_ptr(0)), 68, "oldest surviving line is the 4th written (O(1) head-advance eviction)");
    # feed_clear empties the ring (the /clear command + per-session reset)
    feed_scroll_set(5);
    feed_clear();
    assert_eq(feed_count(), 0, "feed_clear empties the ring");
    assert_eq(feed_scroll(), 0, "feed_clear resets the scroll offset");
    return 0;
}

# Output capture (0.9.1): with OUT_RING armed, emit/emit_n/oprintln/ofmt_int route
# into the feed ring (not fd 1); a logical line assembled across mixed calls lands
# as ONE row, and ofmt_int captures the same digits fmt_int would print. NOTE:
# always restore OUT_FD1 before asserting — an assert under OUT_RING would be
# captured into the ring instead of printed.
fn test_capture() {
    test_group("output capture sink (util.cyr / feed.cyr)");
    feed_init();
    assert_eq(out_mode(), OUT_FD1, "default mode is OUT_FD1 (the floor)");
    out_mode_set(OUT_RING);
    emit("a"); emit_n("bc", 2); oprintln("d");     # one logical line across 3 calls
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 1, "emit + emit_n + oprintln reconstruct one captured line");
    assert_eq(feed_line_len(0), 4, "captured line is 'abcd' (4 bytes)");
    var p = feed_line_ptr(0);
    assert_eq(load8(p), 97, "byte 0 'a' (emit)");
    assert_eq(load8(p + 1), 98, "byte 1 'b' (emit_n)");
    assert_eq(load8(p + 3), 100, "byte 3 'd' (oprintln, before its newline seal)");
    # ofmt_int captures the same bytes fmt_int prints (incl. zero + negatives)
    feed_init();
    out_mode_set(OUT_RING);
    ofmt_int(0); oprintln("");                      # "0" then a newline seals the row
    ofmt_int(0 - 42);                               # "-42" left pending
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 2, "two captured rows");
    assert_eq(feed_line_len(0), 1, "ofmt_int(0) captured as '0'");
    assert_eq(load8(feed_line_ptr(0)), 48, "the digit '0'");
    assert_eq(feed_line_len(1), 3, "ofmt_int(-42) captured as '-42'");
    assert_eq(load8(feed_line_ptr(1)), 45, "leading '-' preserved");
    return 0;
}

# Working spinner (0.9.2): the frame cycle is PURE (the animated indicator + its
# hint-row paint are I/O, live-verified). spin_glyph cycles mod SPIN_FRAMES;
# spin_advance steps the frame.
fn test_spinner() {
    test_group("working spinner (tui.cyr)");
    assert(streq(spin_glyph(0), spin_glyph(SPIN_FRAMES)), "spinner glyph cycles mod the frame count");
    assert_eq(streq(spin_glyph(0), spin_glyph(1)), 0, "adjacent spinner frames differ");
    assert(streq(spin_glyph(0), "\xe2\xa0\x8b"), "frame 0 is the braille glyph ⠋");
    var f0 = spin_frame();
    spin_advance(); spin_advance();
    assert_eq(spin_frame() - f0, 2, "spin_advance steps the frame");
    return 0;
}

# File-tree pane (0.9.3): the layout geometry (tree/feed split) and the flattened-tree
# model (append, splice children on expand, collapse a subtree, ancestor-walk path
# reconstruction) are PURE; the directory listing + paint are I/O (live-verified).
fn test_ftree() {
    test_group("file-tree model + geometry (ftree.cyr)");
    # geometry: hidden tree -> full-width feed (the 0.9.1/0.9.2 case)
    assert_eq(tui_tree_w(80, 0), 0, "tree width 0 when hidden");
    assert_eq(tui_feed_left(80, 0), 1, "feed starts at col 1 when hidden");
    assert_eq(tui_feed_width(80, 0), 80, "feed full width when hidden");
    # geometry: shown -> tree + separator + feed
    assert_eq(tui_tree_w(120, 1), 28, "tree width caps at 28 (120/3=40 -> 28)");
    assert_eq(tui_tree_w(30, 1), 10, "tree width = cols/3 below the cap");
    assert_eq(tui_feed_left(120, 1), 30, "feed starts past tree(28)+separator -> col 30");
    assert_eq(tui_feed_width(120, 1), 91, "feed width = 120 - 30 + 1");
    # model: two root entries
    ftree_init();
    ftree_reset();
    _ftree_set_cwd("/repo");
    _ftree_append("src", 1, 0);
    _ftree_append("VERSION", 0, 0);
    assert_eq(ftree_count(), 2, "two root entries");
    assert_eq(ftree_isdir(0), 1, "src is a dir");
    var pb[256];
    ftree_path(1, &pb, 256);
    assert(streq(&pb, "/repo/VERSION"), "root file path = cwd/name");
    # expand src: splice two children in at depth 1
    _ftree_insert_at(1, "main.cyr", 0, 1);
    _ftree_insert_at(2, "tui.cyr", 0, 1);
    ftree_set_exp(0, 1);
    assert_eq(ftree_count(), 4, "two children spliced in -> 4 nodes");
    assert_eq(ftree_depth(2), 1, "child at depth 1");
    ftree_path(2, &pb, 256);
    assert(streq(&pb, "/repo/src/tui.cyr"), "nested path walks ancestors");
    # selection clamps
    ftree_set_sel(0); ftree_move(10);
    assert_eq(ftree_sel(), 3, "move clamps to the last node");
    ftree_move(0 - 100);
    assert_eq(ftree_sel(), 0, "move clamps to the first node");
    # collapse src removes its subtree
    assert_eq(ftree_collapse_at(0), 2, "collapse removes the 2 children");
    assert_eq(ftree_count(), 2, "back to 2 nodes");
    assert_eq(ftree_exp(0), 0, "src marked collapsed");
    assert(streq(ftree_name(1), "VERSION"), "VERSION shifted back to index 1");
    # I/O smoke: list the repo's src/ — exercises the Str plumbing + dirs-first on a
    # real directory (src/ has the vendor/ subdir + many .cyr files). Run from the
    # project root by `cyrius test`.
    ftree_init();
    ftree_reset();
    _ftree_list_into("src", 0, 0);
    assert(ftree_count() > 5, "listed src/ — the dir_list/is_dir/Str plumbing works");
    assert_eq(ftree_isdir(0), 1, "dirs-first: a directory (vendor/) sorts before the files");
    return 0;
}

