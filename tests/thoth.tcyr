fn test_classify() {
    test_group("classify_input");
    assert_eq(classify_input(""), CMD_EMPTY, "empty -> CMD_EMPTY");
    assert_eq(classify_input("/help"), CMD_HELP, "/help");
    assert_eq(classify_input("/?"), CMD_HELP, "/? alias");
    assert_eq(classify_input("/quit"), CMD_QUIT, "/quit");
    assert_eq(classify_input("/exit"), CMD_QUIT, "/exit alias");
    assert_eq(classify_input("/seams"), CMD_SEAMS, "/seams");
    assert_eq(classify_input("/state"), CMD_STATE, "/state");
    assert_eq(classify_input("/model"), CMD_MODEL, "/model bare");
    assert_eq(classify_input("/model gpt-5"), CMD_MODEL, "/model with arg");
    assert_eq(classify_input("/read foo.txt"), CMD_READ, "/read with arg");
    assert_eq(classify_input("/write a b"), CMD_WRITE, "/write");
    assert_eq(classify_input("/run echo hi"), CMD_RUN, "/run");
    assert_eq(classify_input("/tools"), CMD_TOOLS, "/tools");
    assert_eq(classify_input("/call echo {}"), CMD_CALL, "/call with args");
    assert_eq(classify_input("/audit"), CMD_AUDIT, "/audit");
    assert_eq(classify_input("/reset"), CMD_RESET, "/reset");
    assert_eq(classify_input("/clear"), CMD_CLEAR, "/clear");
    assert_eq(classify_input("/copy"), CMD_COPY, "/copy classifies to CMD_COPY");
    assert_eq(classify_input("/reprobe"), CMD_REPROBE, "/reprobe");
    assert_eq(classify_input("/ping"), CMD_REPROBE, "/ping aliases reprobe");
    assert_eq(classify_input("/history"), CMD_HISTORY, "/history");
    assert_eq(classify_input("/theme light"), CMD_THEME, "/theme with arg");
    assert_eq(classify_input("/bogus"), CMD_UNKNOWN_SLASH, "unknown slash");
    assert_eq(classify_input("/"), CMD_UNKNOWN_SLASH, "lone slash");
    assert_eq(classify_input("write me a function"), CMD_TASK, "free text -> task");
    assert_eq(classify_input("hello"), CMD_TASK, "plain word -> task");
    return 0;
}

fn test_tokens() {
    test_group("token_is + arg_after");
    assert_eq(token_is("/help", "/help"), 1, "exact token");
    assert_eq(token_is("/model gpt", "/model"), 1, "token + space");
    assert_eq(token_is("/models", "/model"), 0, "prefix is not a token");
    assert_eq(token_is("/modelx", "/model"), 0, "no word boundary");
    assert_eq(arg_after("/help"), 0, "no arg -> 0");
    assert(streq(arg_after("/read foo.txt"), "foo.txt"), "arg extracted");
    assert(streq(arg_after("/model   gpt-5"), "gpt-5"), "skips extra spaces");
    assert(streq(arg_after("/write a.txt hi there"), "a.txt hi there"), "rest after first token");
    return 0;
}

fn test_cstr() {
    test_group("cstr_starts_with");
    assert_eq(cstr_starts_with("hello", "he"), 1, "prefix");
    assert_eq(cstr_starts_with("hello", "hello"), 1, "equal");
    assert_eq(cstr_starts_with("he", "hello"), 0, "shorter than prefix");
    assert_eq(cstr_starts_with("abc", "x"), 0, "mismatch");
    assert_eq(cstr_starts_with("", ""), 1, "empty prefix of empty");
    return 0;
}

fn test_seams() {
    test_group("seam registry");
    assert_eq(SEAM_COUNT, 7, "seven seams (git added 0.13.0)");
    assert(streq(seam_name(SEAM_HOOSH), "hoosh"), "hoosh name");
    assert(streq(seam_name(SEAM_DAIMON), "daimon"), "daimon name");
    assert(streq(seam_name(SEAM_BOTE), "bote"), "bote name");
    assert(streq(seam_name(SEAM_TRON), "t-ron"), "t-ron name");
    assert(streq(seam_name(SEAM_AVATARA), "avatara"), "avatara name");
    assert(streq(seam_name(SEAM_MEMORY), "mneme"), "mneme name (memory domain owner)");
    assert(streq(seam_name(SEAM_GIT), "sit"), "sit name (git/VCS domain owner)");
    assert_eq(seam_status(SEAM_MEMORY), SEAM_ABSENT, "memory absent (mneme not yet Cyrius-ported)");
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_status(SEAM_DAIMON), SEAM_ABSENT, "daimon absent when unconfigured");
    assert_eq(seam_status(SEAM_TRON), SEAM_ABSENT, "t-ron absent without a policy");
    assert_eq(seam_status(SEAM_BOTE), SEAM_NATIVE, "bote native (vendored core, M4)");
    assert_eq(seam_status(SEAM_AVATARA), SEAM_NATIVE, "avatara native (vendored archetype, M5)");
    assert_eq(seam_any_wired(), 1, "bote wired by construction");
    assert(streq(seam_status_label(SEAM_ABSENT), "absent"), "absent label");
    assert(streq(seam_status_label(SEAM_REMOTE), "remote-client"), "remote label");
    assert(streq(seam_status_label(SEAM_NATIVE), "native"), "native label");
    return 0;
}

fn test_capability_ladder() {
    test_group("capability ladder (full/degraded/absent)");
    # effect labels
    assert(streq(cap_state_label(CAP_FULL), "full"), "full label");
    assert(streq(cap_state_label(CAP_DEGRADED), "degraded"), "degraded label");
    assert(streq(cap_state_label(CAP_ABSENT), "absent"), "absent label");
    # always-native vendored seams are FULL regardless of config
    assert_eq(seam_cap_state(SEAM_BOTE), CAP_FULL, "bote full (vendored)");
    assert_eq(seam_cap_state(SEAM_AVATARA), CAP_FULL, "avatara full (vendored)");
    # unconfigured: hoosh/daimon have no fallback -> ABSENT (never faked)
    assert_eq(seam_cap_state(SEAM_HOOSH), CAP_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_cap_state(SEAM_DAIMON), CAP_ABSENT, "daimon absent when unconfigured");
    # the honesty case: absent t-ron is DEGRADED (confirm gate), never ABSENT,
    # never silently allowing — security degrades CLOSED.
    assert_eq(seam_cap_state(SEAM_TRON), CAP_DEGRADED, "t-ron degrades closed, not absent");
    # full + fallback prose carry the honest semantics
    assert(streq(seam_cap_full(SEAM_TRON), "per-tool authorization on /run, /write, /call; deny is final"), "t-ron full prose");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_HOOSH), "absent:"), 1, "hoosh fallback is absent");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_DAIMON), "absent:"), 1, "daimon fallback is absent");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_TRON), "degraded:"), 1, "t-ron fallback is degraded");
    # memory (0.12.0): OFF by default -> ABSENT (byte-identical floor); when
    # [memory].enabled, the local .thoth/memory reader stands in -> DEGRADED
    # (never faked). mneme's semantic engine would be FULL (not reachable today).
    assert_eq(seam_cap_state(SEAM_MEMORY), CAP_ABSENT, "memory absent when disabled (default)");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_MEMORY), "absent:"), 1, "memory-off fallback is absent");
    _cfg_memory_enabled = 1;
    assert_eq(seam_cap_state(SEAM_MEMORY), CAP_DEGRADED, "memory degraded when enabled (local reader)");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_MEMORY), "degraded:"), 1, "memory-on fallback is degraded");
    _cfg_memory_enabled = 0;
    return 0;
}

fn test_session() {
    test_group("session state");
    session_reset();
    assert_eq(session_turns(), 0, "turns start 0");
    assert_eq(session_model(), 0, "model starts none");
    session_bump_turn();
    session_bump_turn();
    assert_eq(session_turns(), 2, "two turns counted");
    session_set_model("gpt-5");
    assert(streq(session_model(), "gpt-5"), "model set");
    session_reset();
    assert_eq(session_turns(), 0, "reset clears turns");
    assert_eq(session_model(), 0, "reset clears model");
    return 0;
}

# context-budget meter (0.19.0): surface framed history bytes vs the ~32 KiB evict boundary that
# _hoosh_history_start uses, so context pressure is visible before it silently drops old turns.
fn test_ctx_meter() {
    test_group("context-budget meter (hoosh.cyr, 0.19.0)");
    assert_eq(hoosh_ctx_budget(), 32768, "budget is HOOSH_REQ_CAP/8 = 32 KiB");
    session_history_clear();
    assert_eq(hoosh_ctx_bytes(), 0, "empty history is 0 bytes");
    assert_eq(hoosh_ctx_evicted(), 0, "empty history evicts nothing");
    session_history_append("user", "hello", 5);
    assert_eq(hoosh_ctx_bytes(), 21, "one 'hello' = 5 content + 16 framing");
    assert_eq(hoosh_ctx_evicted(), 0, "small history evicts nothing");
    session_history_append("assistant", "world!", 6);
    assert_eq(hoosh_ctx_bytes(), 43, "two messages = 21 + (6+16)");
    # eviction: two ~20 KiB messages exceed the 32 KiB budget -> the oldest is dropped from the request
    session_history_clear();
    var big = alloc(20001);
    var i = 0;
    while (i < 20000) { store8(big + i, 120); i = i + 1; }   # 'x' * 20000
    store8(big + 20000, 0);
    session_history_append("user", big, 20000);
    assert_eq(hoosh_ctx_bytes(), 20016, "one 20K message = 20016 framed bytes");
    assert_eq(hoosh_ctx_evicted(), 0, "one 20K message fits under budget (nothing evicted)");
    session_history_append("assistant", big, 20000);
    assert_eq(hoosh_ctx_bytes(), 40032, "two 20K messages = 40032 framed bytes (> 32K budget)");
    assert_eq(hoosh_ctx_evicted(), 1, "the oldest of two over-budget turns is evicted");
    session_history_clear();
    return 0;
}

# live spine-health (0.19.3): the cached hoosh reachability driven by traffic outcomes — a turn's transport
# result (rc<0 = connection failure = DOWN; rc>=0 = the gateway answered = UP), the mark helpers, and the
# tri-state. (hoosh_health_probe needs a live gateway, so it is not unit-tested here.)
fn test_hoosh_health() {
    test_group("live spine-health (hoosh.cyr, 0.19.3)");
    hoosh_health_mark_up();
    assert_eq(hoosh_health(), HOOSH_HEALTH_UP, "mark_up -> UP");
    hoosh_health_note(0 - 1);
    assert_eq(hoosh_health(), HOOSH_HEALTH_DOWN, "a transport failure (rc<0) -> DOWN");
    hoosh_health_note(0);
    assert_eq(hoosh_health(), HOOSH_HEALTH_UP, "an answered turn (rc 0) -> UP");
    hoosh_health_note(500);
    assert_eq(hoosh_health(), HOOSH_HEALTH_UP, "a non-2xx (rc>0, gateway answered) is still UP");
    hoosh_health_mark_down();
    assert_eq(hoosh_health(), HOOSH_HEALTH_DOWN, "mark_down -> DOWN");
    return 0;
}

# The avatara persona overlay (M5): identity SOURCED from the vendored archetype
# bundle (egyptian_thoth via the prof_* accessors), not a hardcoded stub. soul +
# spirit are the prose that feeds the hoosh system prompt.
fn test_persona() {
    test_group("avatara persona (M5)");
    assert(streq(persona_name(), "Thoth"), "name from avatara archetype");
    assert(streq(persona_role(), "the Librarian"), "role is thoth's overlay framing");
    assert(persona_soul() != 0, "soul present from avatara");
    assert_eq(cstr_starts_with(persona_soul(), "You are Thoth"), 1, "soul is the Thoth archetype voice");
    assert(persona_spirit() != 0, "spirit present from avatara");
    assert_eq(cstr_starts_with(persona_spirit(), "Your nature is precision"), 1, "spirit is precision");
    assert(persona_desc() != 0, "desc present from avatara");
    # the hoosh system prompt (M5 step 2): soul + spirit + thoth's operating clause
    var sysp = persona_system_prompt();
    assert(sysp != 0, "system prompt built");
    assert_eq(cstr_starts_with(sysp, "You are Thoth"), 1, "system prompt opens with the archetype soul");
    assert(strlen(sysp) > strlen(persona_soul()), "system prompt appends spirit + operating clause");
    return 0;
}

# persona SWITCH (0.22.0): mid-session /persona — resolve via avatara find_and_validate, swap + invalidate
# the cached system prompt, role sourced per the identity split. Restores the default at the end so the M5
# test (and any later test) sees pristine Thoth.
fn test_persona_switch() {
    test_group("persona switch (session.cyr, 0.22.0)");
    persona_set(egyptian_thoth());                           # pristine default
    assert(streq(persona_name(), "Thoth") == 1, "default persona is Thoth");
    assert(streq(persona_role(), "the Librarian") == 1, "default role is 'the Librarian'");
    assert(streq(persona_tradition(), "Egyptian") == 1, "default tradition Egyptian");
    # SNAPSHOT the default prompt before switching — it is rebuilt IN PLACE, so a held pointer changes.
    var sys_default = persona_system_prompt();
    var snap = alloc(2048);
    var q = 0;
    while (load8(sys_default + q) != 0) { store8(snap + q, load8(sys_default + q)); q = q + 1; }
    store8(snap + q, 0);
    assert(cstr_starts_with(snap, "You are Thoth") == 1, "captured default prompt is the Thoth voice");

    assert_eq(persona_switch("Athena"), 1, "switch to a valid archetype (Athena) succeeds");
    assert(streq(persona_name(), "Athena") == 1, "active persona is now Athena");
    assert(streq(persona_role(), "the Librarian") == 0, "switched role is NOT 'the Librarian'");
    # 0.24.5 role modality: a switched persona's default role now derives from its DOMINANT trait aspect
    # (avatara's profile_dominant_aspect -> aspect_role), not the profile desc.
    assert(streq(persona_role(), aspect_role(profile_dominant_aspect(persona_profile()))) == 1, "switched role = dominant aspect (avatara-sourced)");
    var sys_athena = persona_system_prompt();
    assert(streq(sys_athena, snap) == 0, "system prompt rebuilt for the new persona (differs from the default)");
    assert(cstr_starts_with(sys_athena, "You are Thoth") == 0, "the rebuilt prompt is no longer the Thoth voice");

    assert_eq(persona_switch("NotARealArchetype_zzz"), 0, "unknown name -> refusal (0)");
    assert(streq(persona_name(), "Athena") == 1, "a failed switch leaves the active persona unchanged");
    assert(streq(persona_tagline(), "Thinks, Handles, Orchestrates, Transforms, Heals") == 1,
        "tagline is the fixed app backronym, constant across switches (identity split)");

    # 0.22.1 /personas card excerpt helper (returns the emitted byte count; discard the emit itself)
    out_mode_set(OUT_NULL);
    var big = alloc(128);
    var k = 0;
    while (k < 100) { store8(big + k, 97); k = k + 1; }     # 100 'a', no spaces
    store8(big + 100, 0);
    assert_eq(_persona_excerpt(big), 90, "excerpt hard-caps a no-space string at 90 bytes");
    assert_eq(_persona_excerpt("short one"), 9, "excerpt emits a short string whole (returns its length)");
    out_mode_set(OUT_FD1);

    # 0.22.2 shadow: shadow of the active persona -> a usable persona (inverted prose from avatara)
    persona_set(egyptian_thoth());
    assert_eq(persona_shadow(0), 1, "shadow of the active persona succeeds");
    assert(cstr_starts_with(persona_name(), "Shadow of ") == 1, "shadow name is 'Shadow of <base>'");
    assert(persona_soul() != 0, "shadow persona has soul prose (usable)");
    assert(streq(persona_role(), "the Librarian") == 0, "shadow role is not the Librarian");

    # 0.22.2 blend: weighted compose (Athena:2 + Odin) -> composite persona, dominant leads the voice
    persona_set(egyptian_thoth());
    var wv = vec_new();
    var ra = find_and_validate("Athena");
    var ro = find_and_validate("Odin");
    vec_push(wv, weighted_new(result_unwrap(ra), 2.0));
    vec_push(wv, weighted_new(result_unwrap(ro), 1.0));
    assert_eq(persona_blend(wv), 1, "weighted blend (Athena:2 + Odin) succeeds");
    assert(persona_soul() != 0, "blend persona has soul prose (from the dominant, usable)");
    assert(cstr_starts_with(persona_name(), "Athena") == 1, "composite name leads with the dominant (Athena)");

    persona_set(egyptian_thoth());                          # restore default for downstream tests
    assert(streq(persona_name(), "Thoth") == 1, "restored to the default Thoth");
    return 0;
}

# Config defaults when no thoth.cyml is loaded (the test process loads none).
fn test_config() {
    test_group("hoosh config (unconfigured)");
    assert_eq(config_hoosh_configured(), 0, "not configured by default");
    assert(streq(config_hoosh_url(), "http://127.0.0.1:8088"), "localhost default url");
    assert_eq(config_hoosh_token(), 0, "no token by default");
    assert_eq(config_hoosh_model(), 0, "no model by default");
    assert_eq(config_hoosh_parallel(), 1, "parallel tool calls on by default");
    # unconfigured -> hoosh seam stays absent (honest degradation)
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    return 0;
}

# The hoosh client's pure pieces: escape, int-append, request building, and
# response/error extraction (no network).
fn test_hoosh() {
    test_group("hoosh request building");
    var eb[64];
    var n = _json_escape_into(&eb, 0, "a\"b");      # a " b
    store8(&eb + n, 0);
    assert(streq(&eb, "a\\\"b"), "escape double-quote");
    var n2 = _json_escape_into(&eb, 0, "x\ny");     # x <LF> y
    store8(&eb + n2, 0);
    assert(streq(&eb, "x\\ny"), "escape newline");
    var n3 = _json_escape_into(&eb, 0, "c\\d");     # c \ d
    store8(&eb + n3, 0);
    assert(streq(&eb, "c\\\\d"), "escape backslash");

    var ib[32];
    var inn = _append_int(&ib, 0, 4096);
    store8(&ib + inn, 0);
    assert(streq(&ib, "4096"), "append_int 4096");
    var iz = _append_int(&ib, 0, 0);
    store8(&ib + iz, 0);
    assert(streq(&ib, "0"), "append_int 0");

    var rb[256];
    hoosh_build_request(&rb, "m", 0, 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "request shape, no system (0)");
    hoosh_build_request(&rb, "m", "", 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "empty system omitted");
    hoosh_build_request(&rb, "m", "be precise", 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"be precise\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "system message prepended");
    hoosh_build_request(&rb, "m", 0, 0, "hi", 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "stream=1 sets stream:true + usage opt");

    test_group("hoosh response extraction");
    var body = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hello world\"}}]}";
    var s = hoosh_extract_content(body, strlen(body));
    assert(s != 0, "content present");
    assert(str_eq_cstr(s, "hello world"), "content matches");

    var empty = "{\"choices\":[]}";
    assert_eq(hoosh_extract_content(empty, strlen(empty)), 0, "empty choices -> 0");
    var nojson = "not json";
    assert_eq(hoosh_extract_content(nojson, strlen(nojson)), 0, "unparseable -> 0");

    var ebody = "{\"error\":{\"message\":\"no provider for model\"}}";
    var em = hoosh_extract_error(ebody, strlen(ebody));
    assert(em != 0, "error present");
    assert(str_eq_cstr(em, "no provider for model"), "error message matches");
    assert_eq(hoosh_extract_error(body, strlen(body)), 0, "no error field -> 0");

    test_group("hoosh model catalog extraction");
    var mbody = "{\"object\":\"list\",\"data\":[{\"id\":\"claude-sonnet-4-6\"},{\"id\":\"gpt-4o\"}]}";
    var data = hoosh_extract_models(mbody, strlen(mbody));
    assert(data != 0, "model list present");
    assert_eq(bayan_json_v_arr_len(data), 2, "two models in data array");
    var m0 = bayan_json_v_obj_get(bayan_json_v_arr_get(data, 0), "id");
    assert(str_eq_cstr(bayan_json_v_str(m0), "claude-sonnet-4-6"), "first model id matches");
    var mempty = "{\"object\":\"list\",\"data\":[]}";
    assert_eq(bayan_json_v_arr_len(hoosh_extract_models(mempty, strlen(mempty))), 0, "empty catalog -> 0-length array");
    assert_eq(hoosh_extract_models(body, strlen(body)), 0, "no data field -> 0");
    assert_eq(hoosh_extract_models(nojson, strlen(nojson)), 0, "unparseable -> 0");

    test_group("hoosh SSE delta extraction");
    var d1 = "{\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}";
    var ds = hoosh_extract_delta(d1, strlen(d1));
    assert(ds != 0, "delta content present");
    assert(str_eq_cstr(ds, "Hel"), "delta content matches");
    var drole = "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}";
    assert_eq(hoosh_extract_delta(drole, strlen(drole)), 0, "role-only delta -> 0");
    var dfin = "{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}";
    assert_eq(hoosh_extract_delta(dfin, strlen(dfin)), 0, "finish frame -> 0");
    var dnojson = "[DONE]";
    assert_eq(hoosh_extract_delta(dnojson, strlen(dnojson)), 0, "[DONE] sentinel -> 0");
    return 0;
}

# /models <provider> (0.7.1): hoosh's concrete per-provider catalog shares the
# /v1/models {object:list, data:[{id, owned_by}]} shape; the drill-down reuses
# hoosh_extract_models and filters owned_by with the case-insensitive _ci_eq.
fn test_provider_catalog() {
    test_group("provider model catalog (/models <provider>)");
    var cat = "{\"object\":\"list\",\"data\":[{\"id\":\"claude-sonnet-4\",\"object\":\"model\",\"owned_by\":\"anthropic\"},{\"id\":\"claude-opus-4\",\"object\":\"model\",\"owned_by\":\"anthropic\"},{\"id\":\"gpt-4o\",\"object\":\"model\",\"owned_by\":\"openai\"}]}";
    var d = hoosh_extract_models(cat, strlen(cat));
    assert(d != 0, "catalog data array present");
    assert_eq(bayan_json_v_arr_len(d), 3, "three catalog entries");
    var e0 = bayan_json_v_arr_get(d, 0);
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(e0, "owned_by")), "anthropic"), "entry owned_by parsed");
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(e0, "id")), "claude-sonnet-4"), "entry id parsed");
    # case-insensitive provider match (user may type 'Anthropic'; hoosh emits 'anthropic')
    assert_eq(_ci_eq("anthropic", "anthropic"), 1, "exact provider matches");
    assert_eq(_ci_eq("Anthropic", "anthropic"), 1, "provider match ignores case");
    assert_eq(_ci_eq("openai", "anthropic"), 0, "different providers do not match");
    assert_eq(_ci_eq("anthropic", "anthropi"), 0, "prefix is not a full match");
    # filter the catalog by provider (mirrors hoosh_list_provider_models)
    var matches = 0;
    var i = 0;
    while (i < bayan_json_v_arr_len(d)) {
        var m = bayan_json_v_arr_get(d, i);
        var ob = bayan_json_v_str(bayan_json_v_obj_get(m, "owned_by"));
        if (_ci_eq(str_cstr(ob), "anthropic") == 1) { matches = matches + 1; }
        i = i + 1;
    }
    assert_eq(matches, 2, "two anthropic models filtered from the catalog");
    return 0;
}

# [hoosh].stream config toggle: default on; the _cfg_bool reader maps the TOML
# literal true/false (parsed as text) and falls back on absent/garbage.
fn test_stream_config() {
    test_group("hoosh stream config");
    assert_eq(config_hoosh_stream(), 1, "streaming on by default (no config loaded)");
    assert_eq(_cfg_bool(0, "x", 1), 1, "null pairs -> default 1");
    assert_eq(_cfg_bool(0, "x", 0), 0, "null pairs -> default 0");
    var toml = "[hoosh]\nstream = false\non = true\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    var secs = bayan_toml_get_sections(sections, "hoosh");
    var pairs = bayan_toml_section_pairs(vec_get(secs, 0));
    assert_eq(_cfg_bool(pairs, "stream", 1), 0, "explicit false read as 0");
    assert_eq(_cfg_bool(pairs, "on", 0), 1, "explicit true read as 1");
    assert_eq(_cfg_bool(pairs, "missing", 1), 1, "absent key -> default");
    return 0;
}

# Token usage accounting (0.10.2): hoosh_extract_usage reads usage.total_tokens
# from a blocking completion body and from a streaming usage frame (choices:[] +
# usage), -1 when absent; the session accumulator sums only real figures and the
# seen-flag drives the honest-omit surface (ADR-0010).
fn test_usage() {
    test_group("token usage (0.10.2)");
    # blocking-completion body carrying usage
    var full = "{\"choices\":[{\"message\":{\"content\":\"hi\"}}],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":5,\"total_tokens\":17}}";
    assert_eq(hoosh_extract_usage(full, strlen(full)), 17, "blocking usage total_tokens parsed");
    # the streaming usage frame: choices empty, usage present (include_usage)
    var uframe = "{\"choices\":[],\"usage\":{\"prompt_tokens\":3,\"completion_tokens\":4,\"total_tokens\":7}}";
    assert_eq(hoosh_extract_usage(uframe, strlen(uframe)), 7, "streaming usage frame total parsed");
    # a normal delta frame has no usage -> -1 (absent, never 0)
    var delta = "{\"choices\":[{\"delta\":{\"content\":\"x\"}}]}";
    assert_eq(hoosh_extract_usage(delta, strlen(delta)), 0 - 1, "delta frame -> -1 (no usage)");
    # usage object without total_tokens -> -1
    var notot = "{\"usage\":{\"prompt_tokens\":1}}";
    assert_eq(hoosh_extract_usage(notot, strlen(notot)), 0 - 1, "usage without total_tokens -> -1");
    var nojson = "not json";
    assert_eq(hoosh_extract_usage(nojson, strlen(nojson)), 0 - 1, "unparseable body -> -1");

    # the session accumulator + seen-flag (the honest-omit gate)
    session_reset();
    assert_eq(session_tokens_seen(), 0, "no usage seen after reset");
    assert_eq(session_tokens(), 0, "zero tokens after reset");
    session_add_tokens(0 - 1);   # an absent (-1) report is ignored, never flips seen
    assert_eq(session_tokens_seen(), 0, "negative report ignored, still unseen");
    session_add_tokens(17);
    assert_eq(session_tokens_seen(), 1, "seen flips on first real report");
    assert_eq(session_tokens(), 17, "first report summed");
    session_add_tokens(7);
    assert_eq(session_tokens(), 24, "second report accumulates");
    session_reset();
    assert_eq(session_tokens(), 0, "reset clears the tally");
    assert_eq(session_tokens_seen(), 0, "reset clears the seen-flag");
    return 0;
}

# Cost accounting (0.10.3): the pure micro-USD pricing math, the $d.cc formatter, the
# [pricing.<model>] table (verbatim section-name match, including dashed ids), and the
# session cost accumulator + honest-omit seen/unpriced flags.
fn test_cost() {
    test_group("cost (0.10.3)");
    # pricing math: rates are micro-USD per 1000 tokens (= USD-per-1M x 1000).
    # 1000 prompt tokens at $3.00/1M (in_rate 3000) = $0.003 = 3000 micro-USD.
    assert_eq(hoosh_cost_micro(1000, 0, 3000, 15000), 3000, "prompt-only cost");
    # 1000 completion tokens at $15.00/1M (out_rate 15000) = $0.015 = 15000 micro-USD.
    assert_eq(hoosh_cost_micro(0, 1000, 3000, 15000), 15000, "completion-only cost");
    # 2000 in at $0.25/1M (250) + 500 out at $1.25/1M (1250) = 500 + 625 = 1125 micro-USD.
    assert_eq(hoosh_cost_micro(2000, 500, 250, 1250), 1125, "mixed cheap-model cost");
    assert_eq(hoosh_cost_micro(0, 0, 3000, 15000), 0, "zero tokens -> zero cost");

    # $d.cc formatter (truncates to whole cents; 1 cent = 10000 micro-USD).
    var cb[24];
    cost_fmt(&cb, 3000);     assert(streq(&cb, "$0.00"), "3000 micro-USD -> $0.00 (sub-cent floors)");
    cost_fmt(&cb, 50000);    assert(streq(&cb, "$0.05"), "50000 micro-USD -> $0.05");
    cost_fmt(&cb, 1234567);  assert(streq(&cb, "$1.23"), "1234567 micro-USD -> $1.23 (floors)");
    cost_fmt(&cb, 12000000); assert(streq(&cb, "$12.00"), "12000000 micro-USD -> $12.00");

    # the [pricing.<model>] table via a parsed TOML (verbatim dashed section name).
    var toml = "[pricing.claude-x]\ninput = 3000\noutput = 15000\n[pricing.cheap]\ninput = 250\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    _price_load(sections);
    assert_eq(config_price_input("claude-x"), 3000, "input rate for dashed model id");
    assert_eq(config_price_output("claude-x"), 15000, "output rate parsed");
    assert_eq(config_price_input("cheap"), 250, "second pricing section parsed");
    assert_eq(config_price_output("cheap"), 0 - 1, "missing output key -> -1");
    assert_eq(config_price_input("unknown"), 0 - 1, "unpriced model -> -1");

    # session cost accumulator + honest-omit flags.
    session_reset();
    assert_eq(session_cost_seen(), 0, "no cost seen after reset");
    assert_eq(session_cost_micro(), 0, "zero cost after reset");
    assert_eq(session_cost_unpriced_count(), 0, "no unpriced after reset");
    session_add_cost(0 - 5);                       # negative ignored
    assert_eq(session_cost_seen(), 0, "negative cost ignored, still unseen");
    session_add_cost(1125);
    assert_eq(session_cost_seen(), 1, "seen flips on first priced response");
    assert_eq(session_cost_micro(), 1125, "first cost summed");
    session_add_cost(15000);
    assert_eq(session_cost_micro(), 16125, "second cost accumulates");
    session_note_unpriced();
    assert_eq(session_cost_unpriced_count(), 1, "unpriced response counted");
    session_reset();
    assert_eq(session_cost_micro(), 0, "reset clears cost");
    assert_eq(session_cost_unpriced_count(), 0, "reset clears unpriced count");

    # end-to-end: _hoosh_account_usage wires the ACTIVE model -> [pricing] -> session
    # cost (the price-at-accumulate path the build sandbox can't exercise live). A body
    # with 1000+1000 tokens at claude-x (in 3000, out 15000) = (3e6 + 15e6)/1000 = 18000.
    _price_load(sections);                  # claude-x: in 3000, out 15000 (idempotent)
    session_reset();
    session_set_model("claude-x");
    var ubody = "{\"choices\":[{\"message\":{\"content\":\"hi\"}}],\"usage\":{\"prompt_tokens\":1000,\"completion_tokens\":1000,\"total_tokens\":2000}}";
    _hoosh_account_usage(bayan_json_v_parse_str(ubody, strlen(ubody)));
    assert_eq(session_tokens(), 2000, "account_usage adds total_tokens");
    assert_eq(session_cost_micro(), 18000, "account_usage prices at the active model's rate");
    assert_eq(session_cost_seen(), 1, "priced response flips cost seen");
    # an unpriced active model: usage still counts tokens, but cost is noted not faked.
    session_reset();
    session_set_model("no-price-model");
    _hoosh_account_usage(bayan_json_v_parse_str(ubody, strlen(ubody)));
    assert_eq(session_tokens(), 2000, "tokens still counted for unpriced model");
    assert_eq(session_cost_seen(), 0, "unpriced model -> cost stays unseen");
    assert_eq(session_cost_unpriced_count(), 1, "unpriced model -> noted once");
    # a HALF-declared [pricing.cheap] (input only, output omitted) must degrade to
    # unpriced+noted — NOT silently bill the missing side at $0 (ADR-0010 honest-omit).
    session_reset();
    session_set_model("cheap");
    _hoosh_account_usage(bayan_json_v_parse_str(ubody, strlen(ubody)));
    assert_eq(session_tokens(), 2000, "tokens counted for half-declared model");
    assert_eq(session_cost_seen(), 0, "half-declared pricing -> cost stays unseen");
    assert_eq(session_cost_unpriced_count(), 1, "half-declared pricing -> noted unpriced");
    session_set_model(0);   # don't leak the test model into later tests
    session_reset();
    return 0;
}

# [alias] macros (0.11.4): the config table load + name extraction + the expand step of
# expand-then-redispatch. The dispatch recursion itself runs through dispatch() (verified
# live); here we pin the PURE pieces — table lookup/dedup, _alias_name_of, alias_expand
# (value verbatim + arg append + bounding), and the floor-identical-when-absent property.
fn test_alias() {
    test_group("[alias] macros (config.cyr / commands.cyr)");

    # _alias_name_of: the bare token after '/', up to a space or nul, cap-bounded.
    var nb[256];
    _alias_name_of("/ship", &nb, 256);     assert(streq(&nb, "ship"), "name of /ship");
    _alias_name_of("/ship arg", &nb, 256); assert(streq(&nb, "ship"), "name stops at the first space");
    _alias_name_of("/", &nb, 256);         assert(streq(&nb, ""), "bare / -> empty name");
    _alias_name_of("/  x", &nb, 256);      assert(streq(&nb, ""), "/<spaces> -> empty name");
    _alias_name_of("/abcdef", &nb, 4);     assert(streq(&nb, "abc"), "name truncates to cap-1, nul-terminated");

    # _alias_load from parsed TOML: a blank value is skipped; a duplicate key keeps the first.
    var toml = "[alias]\nship = \"/run git status\"\nexplain = \"explain this:\"\nblank = \"\"\nship = \"/second\"\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    _alias_load(sections);
    assert_eq(config_alias_count(), 2, "two valid aliases loaded (blank skipped, dup deduped)");
    assert(streq(config_alias_lookup("ship"), "/run git status"), "duplicate key -> first definition wins");
    assert(streq(config_alias_lookup("explain"), "explain this:"), "lookup explain");
    assert_eq(config_alias_lookup("blank"), 0, "blank-value alias not stored");
    assert_eq(config_alias_lookup("nope"), 0, "undeclared alias -> 0");

    # alias_expand: the value verbatim, with any trailing args appended after one space.
    assert(streq(alias_expand("/ship", 0), "/run git status"), "expand /ship");
    assert(streq(alias_expand("/explain foo bar", 0), "explain this: foo bar"), "expand appends trailing args");
    assert_eq(alias_expand("/nope", 0), 0, "no alias -> 0 (falls through to unknown-command)");

    # per-depth buffers are disjoint: a depth-1 expansion must not clobber a depth-0 one.
    var d0 = alias_expand("/ship", 0);
    var d1 = alias_expand("/explain z", 1);
    assert(d0 != d1, "different depths use different buffer slots");
    assert(streq(d0, "/run git status"), "depth-0 line intact after a depth-1 expansion");

    # bounding: a value longer than ALIAS_LINE_CAP truncates and stays nul-terminated
    # (white-box: install an oversized value directly, past the parsed table).
    var bigval[2100];
    var bi = 0;
    while (bi < 2048) { store8(&bigval + bi, 65); bi = bi + 1; }   # 2048 'A'
    store8(&bigval + 2048, 0);
    store64(_alias_names + config_alias_count() * 8, "big");
    store64(_alias_vals + config_alias_count() * 8, &bigval);
    _alias_n = _alias_n + 1;
    var big = alias_expand("/big", 0);
    assert(big != 0, "oversized-value alias still resolves");
    assert_eq(strlen(big), ALIAS_LINE_CAP - 1, "expansion truncated to ALIAS_LINE_CAP-1");
    assert_eq(load8(big + ALIAS_LINE_CAP - 1), 0, "truncated expansion stays nul-terminated");

    # an alias name >= 256 chars is SKIPPED at load (it could never match a typed token,
    # which the TUI caps at 255) — so it is not a dead, count-inflating entry. Build
    # "[alias]\n<256 'a'> = \"x\"\n" and confirm the table stays empty.
    var lt[400];
    var lp = 0;
    var hdr = "[alias]\n";
    var hi = 0;
    while (load8(hdr + hi) != 0) { store8(&lt + lp, load8(hdr + hi)); lp = lp + 1; hi = hi + 1; }
    var ai = 0;
    while (ai < 256) { store8(&lt + lp, 97); lp = lp + 1; ai = ai + 1; }   # a 256-char name
    var tl = " = \"x\"\n";
    var ti = 0;
    while (load8(tl + ti) != 0) { store8(&lt + lp, load8(tl + ti)); lp = lp + 1; ti = ti + 1; }
    var oversec = bayan_toml_parse(str_new(&lt, lp));
    _alias_load(oversec);
    assert_eq(config_alias_count(), 0, "256-char alias name skipped at load (no dead unmatchable entry)");

    # floor: with no aliases loaded, expansion is always 0 -> the unknown-command path is
    # byte-identical to a build without alias support.
    _alias_n = 0;
    assert_eq(alias_expand("/ship", 0), 0, "no aliases -> no expansion (byte-identical floor)");
    return 0;
}

# The model-invokable `shell` tool (0.16.0, ADR-0014): config surface + clamps, the LOCAL glob
# filter (deny-wins, allow-list default-deny), shell_run_tool's PRE-GATE returns (parse/blank/deny —
# the paths that never reach the confirm gate, so the test can't hang on stdin), the real timed
# capture (exit code / merged stderr / timeout+partial / over-cap), and the advertise-off floor.
fn test_shell() {
    test_group("shell tool (config.cyr / exec.cyr / shell.cyr, 0.16.0)");

    # --- config scalars + clamps (white-box the raw fields; the getters clamp) ---
    _cfg_shell_enabled = 1;
    assert(config_shell_enabled() == 1, "shell enabled reads through");
    _cfg_shell_timeout_ms = 0 - 1;
    assert_eq(config_shell_timeout_ms(), SHELL_TIMEOUT_DEFAULT_MS, "absent timeout -> default");
    _cfg_shell_timeout_ms = 5000;
    assert_eq(config_shell_timeout_ms(), 5000, "configured timeout passes through");
    _cfg_shell_timeout_ms = SHELL_TIMEOUT_MAX_MS + 1;
    assert_eq(config_shell_timeout_ms(), SHELL_TIMEOUT_MAX_MS, "over-max timeout clamped");
    _cfg_shell_output_cap = 0 - 1;
    assert_eq(config_shell_output_cap(), SHELL_OUT_DEFAULT, "absent cap -> default");
    _cfg_shell_output_cap = 4096;
    assert_eq(config_shell_output_cap(), 4096, "configured cap passes through");

    # --- legacy [shell.deny]/[shell.allow] SECTIONS of `label = pattern` pairs (value is the glob) ---
    var toml = "[shell.deny]\nd1 = \"*rm -rf*\"\nd2 = \"* | sh\"\nblank = \"\"\n[shell.allow]\na1 = \"git *\"\na2 = \"ls*\"\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    _shell_globs_load(0, sections);                # no [shell] table -> section (back-compat) path
    assert_eq(config_shell_deny_count(), 2, "two deny globs (blank value skipped)");
    assert_eq(config_shell_allow_count(), 2, "two allow globs");
    assert(streq(config_shell_deny_at(0), "*rm -rf*"), "deny[0] is the VALUE, not the label");
    assert(streq(config_shell_allow_at(0), "git *"), "allow[0] pattern");
    assert_eq(config_shell_deny_at(9), 0, "deny_at out of range -> 0");

    # --- glob verdict: 0 pass / 1 deny-match / 2 allow-list-miss; deny wins; empty allow allows ---
    assert_eq(_shell_glob_verdict("rm -rf /tmp/x"), 1, "deny glob matches -> 1");
    assert_eq(_shell_glob_verdict("git status"), 0, "allow match, no deny -> pass");
    assert_eq(_shell_glob_verdict("cat /etc/passwd"), 2, "non-empty allow-list, no match -> 2");
    assert_eq(_shell_glob_verdict("ls -la"), 0, "allow ls* matches -> pass");
    store64(_shell_deny + _shell_deny_n * 8, "git *");   # white-box: add an overlapping deny
    _shell_deny_n = _shell_deny_n + 1;
    assert_eq(_shell_glob_verdict("git status"), 1, "deny wins over allow on overlap");
    _shell_deny_n = _shell_deny_n - 1;                   # restore
    _shell_allow_n = 0;
    assert_eq(_shell_glob_verdict("cat /etc/passwd"), 0, "empty allow-list -> allow-through");

    # --- shell_run_tool PRE-GATE returns (never reach the confirm gate, so no stdin hang) ---
    assert(streq(shell_run_tool("{}"), "(shell: missing required 'command' argument)"), "missing command arg");
    assert(streq(shell_run_tool("{\"command\":\"\"}"), "(shell: 'command' is empty)"), "empty command");
    assert(streq(shell_run_tool("{\"command\":\"   \"}"), "(shell: 'command' is empty)"), "whitespace-only command");
    assert(streq(shell_run_tool("not json"), "(shell: arguments are not valid JSON)"), "invalid JSON args");
    var dres = shell_run_tool("{\"command\":\"rm -rf /\"}");   # matches *rm -rf* -> deny before t-ron
    assert(dres != 0, "deny-glob command returns a refusal (before the gate)");
    assert_eq(shell_last_allowed(), 0, "deny-glob -> not allowed (roundlog DENIED)");

    # --- shell_supported() on this POSIX build ---
    assert_eq(shell_supported(), 1, "shell supported on this POSIX target");

    # --- exec_shell_capture: real exec, capture, exit code, merged stderr, timeout, over-cap ---
    var cap = 4096;
    var buf = alloc(cap + 1);
    var st[16];                                # two i64 slots: [0]=exit, [1]=timed-out
    var n1 = exec_shell_capture("printf hello", buf, cap, 5000, &st);
    store8(buf + n1, 0);
    assert(streq(buf, "hello"), "capture: printf hello");
    assert_eq(load64(&st), 0, "printf exits 0");
    assert_eq(load64(&st + 8), 0, "not timed out");
    exec_shell_capture("exit 3", buf, cap, 5000, &st);
    assert_eq(load64(&st), 3, "exit 3 reported");
    var n3 = exec_shell_capture("echo oops 1>&2", buf, cap, 5000, &st);
    store8(buf + n3, 0);
    assert(streq(buf, "oops\n"), "stderr is captured (merged into the same stream)");
    exec_shell_capture("sleep 5", buf, cap, 300, &st);
    assert_eq(load64(&st + 8), 1, "sleep beyond timeout -> timed-out flag set");
    assert_eq(load64(&st), 0 - 2, "timeout exit sentinel -2");
    var n5 = exec_shell_capture("printf pre; sleep 5", buf, cap, 400, &st);
    store8(buf + n5, 0);
    assert(streq(buf, "pre"), "partial output preserved before the SIGKILL");
    assert_eq(load64(&st + 8), 1, "still timed out (partial case)");
    # 0.20.1 process-group kill: a BACKGROUNDED grandchild dies with the shell. The grandchild would touch a
    # marker after 1s; the parent times out at 300ms, and the group SIGKILL (kill(-pgid)) should reach the
    # grandchild before it writes. Wait past 1s, then confirm the marker is ABSENT (it would exist if the
    # old single-child kill had let the grandchild survive). Also proves the group-kill + reap never hangs.
    exec_shell_capture("rm -f /tmp/thoth_gc_20_1", buf, cap, 5000, &st);
    exec_shell_capture("(sleep 1; : > /tmp/thoth_gc_20_1) & sleep 5", buf, cap, 300, &st);
    assert_eq(load64(&st + 8), 1, "a backgrounding parent still times out (no hang)");
    var ngc = exec_shell_capture("sleep 1; test -e /tmp/thoth_gc_20_1 && echo LIVE || echo DEAD", buf, cap, 5000, &st);
    store8(buf + ngc, 0);
    assert(streq(buf, "DEAD\n"), "the backgrounded grandchild was killed with the shell (process-group kill)");
    exec_shell_capture("rm -f /tmp/thoth_gc_20_1", buf, cap, 5000, &st);
    var n6 = exec_shell_capture("head -c 9000 /dev/zero", buf, cap, 5000, &st);
    assert(n6 <= cap, "capture never exceeds buflen (over-cap truncation, no overrun)");
    # exact-fit: reading a K-byte output with buflen = K+1 returns exactly K (not K+1) — the signal
    # shell_run_tool uses so an output of exactly max_output bytes is NOT mislabeled "truncated".
    var n7 = exec_shell_capture("head -c 100 /dev/zero", buf, 101, 5000, &st);
    assert_eq(n7, 100, "K-byte output read with buflen K+1 returns K (exact-fit is not overflow)");
    var n8 = exec_shell_capture("head -c 150 /dev/zero", buf, 101, 5000, &st);
    assert_eq(n8, 101, "over-buflen output fills buflen (K+1) -> the >cap overflow signal");

    # --- 0.20.3: canonical array form `[shell] deny = [...] / allow = [...]` (bayan 1.1.0) ---
    var atoml = "[shell]\ndeny = [\"*rm -rf*\", \"* | sh\", \"\"]\nallow = [\"git *\", \"ls*\"]\n";
    var asec = bayan_toml_parse(str_new(atoml, strlen(atoml)));
    _shell_globs_load(_cfg_section_pairs(asec, "shell"), asec);
    assert_eq(config_shell_deny_count(), 2, "array deny: two globs (blank element skipped)");
    assert_eq(config_shell_allow_count(), 2, "array allow: two globs");
    assert(streq(config_shell_deny_at(1), "* | sh"), "array deny[1] pattern quote-stripped");
    assert(streq(config_shell_allow_at(0), "git *"), "array allow[0] pattern quote-stripped");

    # array form WINS when present: a [shell] deny array + a legacy [shell.deny] section -> array only
    var btoml = "[shell]\ndeny = [\"only-array*\"]\n[shell.deny]\nlegacy = \"legacy*\"\n";
    var bsec = bayan_toml_parse(str_new(btoml, strlen(btoml)));
    _shell_globs_load(_cfg_section_pairs(bsec, "shell"), bsec);
    assert_eq(config_shell_deny_count(), 1, "array form wins over legacy section when both present");
    assert(streq(config_shell_deny_at(0), "only-array*"), "the array pattern, not the legacy section");

    # explicit empty array `deny = []` means zero deny patterns -> does NOT fall back to a section
    var etoml = "[shell]\ndeny = []\n[shell.deny]\nlegacy = \"legacy*\"\n";
    var esec = bayan_toml_parse(str_new(etoml, strlen(etoml)));
    _shell_globs_load(_cfg_section_pairs(esec, "shell"), esec);
    assert_eq(config_shell_deny_count(), 0, "explicit empty deny array -> 0, no section fallback");

    # key ABSENT from [shell] -> legacy section fallback still loads (back-compat)
    var ftoml = "[shell]\nenabled = true\n[shell.allow]\na1 = \"git *\"\n";
    var fsec = bayan_toml_parse(str_new(ftoml, strlen(ftoml)));
    _shell_globs_load(_cfg_section_pairs(fsec, "shell"), fsec);
    assert_eq(config_shell_allow_count(), 1, "absent array key -> legacy [shell.allow] section still loads");
    assert(streq(config_shell_allow_at(0), "git *"), "section-form allow pattern via fallback");

    # bare scalar string (brackets forgotten) is accepted leniently as ONE glob (never a silent zero)
    var gtoml = "[shell]\ndeny = \"*rm -rf*\"\n";
    var gsec = bayan_toml_parse(str_new(gtoml, strlen(gtoml)));
    _shell_globs_load(_cfg_section_pairs(gsec, "shell"), gsec);
    assert_eq(config_shell_deny_count(), 1, "bare scalar deny string -> one glob (lenient, not zero)");
    assert(streq(config_shell_deny_at(0), "*rm -rf*"), "scalar deny pattern quote-stripped");

    # --- advertise floor: disabled -> agent_tools_add_shell returns tl unchanged, writes nothing ---
    # tb is a heap buffer (>= the ~550-byte tool JSON); add_shell caps at AGENT_TOOLS_CAP, not tb's size.
    var tb = alloc(2048);
    _cfg_shell_enabled = 0;
    store8(tb, 0);
    assert_eq(agent_tools_add_shell(tb, 0), 0, "disabled -> add_shell returns tl unchanged (0)");
    assert_eq(load8(tb), 0, "disabled -> add_shell wrote no bytes (floor)");
    _cfg_shell_enabled = 1;
    var tl_on = agent_tools_add_shell(tb, 0);
    assert(tl_on > 0, "enabled -> add_shell appends the tool");
    assert_eq(load8(tb), 91, "advertised tools array starts with '['");

    # restore defaults so later tests / a fresh config see clean state
    _cfg_shell_enabled = 0;
    _cfg_shell_timeout_ms = 0 - 1;
    _cfg_shell_output_cap = 0 - 1;
    _shell_deny_n = 0;
    _shell_allow_n = 0;
    return 0;
}

# /dry request-body preview (0.11.5): hoosh_build_dry composes the EXACT request body
# thoth would send for a task WITHOUT mutating session history (so /dry is side-effect-free).
# The bodies are deterministic, so we pin them with exact string equality; the no-mutation
# invariant is the load-bearing guarantee.
fn test_dry() {
    test_group("/dry request preview (hoosh.cyr / commands.cyr)");
    session_set_model(0);
    session_reset();
    var dst[4096];

    # /dry classifies + the model accessor mirrors hoosh_send's precedence.
    assert_eq(classify_input("/dry write a fn"), CMD_DRY, "/dry classifies to CMD_DRY");
    assert(streq(hoosh_model_cur(), "default"), "no model set -> 'default' (hoosh routes)");
    session_set_model("claude-x");
    assert(streq(hoosh_model_cur(), "claude-x"), "session model wins");
    session_set_model(0);

    # bare body: empty history, no system, blocking -> a single user message.
    var l1 = hoosh_build_dry(&dst, "m", 0, 0, "hi", 0);
    store8(&dst + l1, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: bare user turn");

    # with a system (persona) message prepended.
    var l2 = hoosh_build_dry(&dst, "m", "SYS", 0, "hi", 0);
    store8(&dst + l2, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"SYS\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: system + user");

    # streaming adds stream + stream_options (matching the real request shape).
    var l3 = hoosh_build_dry(&dst, "m", 0, 0, "hi", 1);
    store8(&dst + l3, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "dry body: streaming flags");

    # with conversation history: the tail is serialized, then the PENDING user turn,
    # and history is NOT mutated by the preview.
    session_history_append("user", "Q", 1);
    session_history_append("assistant", "A", 1);
    var before = session_history_len();
    var l4 = hoosh_build_dry(&dst, "m", 0, 0, "now", 0);
    store8(&dst + l4, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"Q\"},{\"role\":\"assistant\",\"content\":\"A\"},{\"role\":\"user\",\"content\":\"now\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: history tail + pending user");
    assert_eq(session_history_len(), before, "hoosh_build_dry does NOT mutate history (side-effect-free)");

    # the prompt is JSON-escaped like the real builders (a quote can't break the body).
    session_reset();                       # clear the history appended above
    var l5 = hoosh_build_dry(&dst, "m", 0, 0, "a\"b", 0);
    store8(&dst + l5, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"a\\\"b\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: prompt is JSON-escaped");

    session_set_model(0);
    session_reset();
    return 0;
}

# Project-memory injection (0.12.0, ADR-0012). The mem system message rides the
# same builders as the persona — a second {role:system} block AFTER the persona,
# BEFORE the user turn/history. mem == 0 (disabled/absent) -> byte-identical floor.
fn test_memory() {
    test_group("project memory injection (0.12.0)");
    assert_eq(classify_input("/remember a durable fact"), CMD_REMEMBER, "/remember classifies to CMD_REMEMBER");
    session_reset();
    var dst[4096];

    # persona + memory + user, in order (both system messages present).
    var l1 = hoosh_build_dry(&dst, "m", "SYS", "MEM", "hi", 0);
    store8(&dst + l1, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"SYS\"},{\"role\":\"system\",\"content\":\"MEM\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "memory: persona + memory + user, in order");

    # mem == 0 -> NO memory message (byte-identical floor).
    var l2 = hoosh_build_dry(&dst, "m", "SYS", 0, "hi", 0);
    store8(&dst + l2, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"SYS\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "memory off: byte-identical (no memory message)");

    # single-turn builder threads mem the same way (persona 0, memory present).
    var l3 = hoosh_build_request(&dst, "m", 0, "MEM", "hi", 0);
    store8(&dst + l3, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"MEM\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "single-turn: memory system message");

    # reader is OFF by default -> content-blind gate returns 0, no I/O, no faked line.
    assert_eq(config_memory_enabled(), 0, "memory off by default");
    assert_eq(memory_context(), 0, "memory_context() 0 when disabled");
    assert_eq(memory_system_prompt(), 0, "memory_system_prompt() 0 when disabled");
    assert_eq(memory_fact_count(), 0, "memory_fact_count() 0 when disabled");

    # 0.12.2: memory_write agentic tool — advertised only when the seam is active.
    var tb[8192];
    var pre = "[{\"x\":1}]";
    var pl = strlen(pre);
    memcpy(&tb, pre, pl); store8(&tb + pl, 0);
    assert_eq(agent_tools_add_memory(&tb, pl), pl, "memory_write NOT advertised when memory disabled");
    _cfg_memory_enabled = 1;
    memcpy(&tb, pre, pl); store8(&tb + pl, 0);
    var a2 = agent_tools_add_memory(&tb, pl);
    store8(&tb + a2, 0);
    assert(strstr(&tb, "\"x\":1},{\"type\":\"function\"") != 0, "memory_write spliced after comma into non-empty array");
    assert_eq(load8(&tb + a2 - 1), 93, "tools array still closes with ']'");
    var a3 = agent_tools_add_memory(&tb, 0);
    store8(&tb + a3, 0);
    assert_eq(load8(&tb), 91, "empty-registry tools array opens with '['");
    assert(strstr(&tb, "memory_write") != 0, "memory_write advertised (empty registry)");
    _cfg_memory_enabled = 0;
    # memory_write_tool argument validation (no I/O on the error paths).
    assert_eq(cstr_starts_with(memory_write_tool(0), "memory_write:"), 1, "memory_write_tool null args -> error");
    assert_eq(cstr_starts_with(memory_write_tool("{}"), "memory_write:"), 1, "memory_write_tool missing text -> error");

    session_reset();
    return 0;
}

# One-shot / argv front-door (0.11.0): the pure argv classifier + task assembly.
# _oneshot_parse takes a hand-built argv snapshot (cstr-ptr array) so the mode
# selection and positional-joining are testable without the real /proc/self/cmdline.
fn test_oneshot() {
    test_group("one-shot / argv (0.11.0)");
    var av[64];   # 8 cstr pointers x 8 bytes (buffers are BYTES, not entries)
    store64(&av + 0, "thoth");
    assert_eq(_oneshot_parse(&av, 1), ONESHOT_NONE, "no argv task -> NONE (TUI/REPL)");
    store64(&av + 8, "review");
    store64(&av + 16, "this");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "positionals -> RUN");
    assert(streq(_oneshot_task, "review this"), "positionals joined by a space");
    store64(&av + 8, "--version");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_VERSION, "--version -> VERSION");
    store64(&av + 8, "-v");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_VERSION, "-v -> VERSION");
    store64(&av + 8, "--help");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_HELP, "--help -> HELP");
    store64(&av + 8, "-h");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_HELP, "-h -> HELP");
    store64(&av + 8, "-p");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "-p forces RUN (task from stdin)");
    store64(&av + 8, "-p");
    store64(&av + 16, "summarize");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "-p + positional -> RUN");
    assert(streq(_oneshot_task, "summarize"), "the -p flag is not part of the task");
    # --tier (0.11.10): a global modifier — parsed, mapped to a pref, does NOT force a run.
    store64(&av + 8, "--tier=rich");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "--tier alone -> NONE (no run forced)");
    assert_eq(oneshot_tier(), TIER_RICH, "--tier=rich -> TIER_RICH");
    assert_eq(oneshot_tier_bad(), 0, "valid tier -> not bad");
    store64(&av + 8, "--tier"); store64(&av + 16, "simple");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_NONE, "--tier simple (space form) -> NONE");
    assert_eq(oneshot_tier(), TIER_SIMPLE, "--tier simple -> TIER_SIMPLE");
    store64(&av + 8, "--tier"); store64(&av + 16, "auto");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_NONE, "--tier auto -> NONE");
    assert_eq(oneshot_tier(), TIER_AUTO, "--tier auto -> TIER_AUTO");
    store64(&av + 8, "--tier=bogus");
    _oneshot_parse(&av, 2);
    assert_eq(oneshot_tier_bad(), 1, "--tier=bogus -> bad flag");
    assert_eq(oneshot_tier(), TIER_AUTO, "a bad tier value falls back to AUTO");
    # the space form must NOT swallow a following flag: --tier --version still yields VERSION
    store64(&av + 8, "--tier"); store64(&av + 16, "--version");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_VERSION, "--tier --version -> VERSION (flag not eaten)");
    # a real value still leaves a following positional as the task -> RUN
    store64(&av + 8, "--tier"); store64(&av + 16, "rich"); store64(&av + 24, "do"); store64(&av + 32, "x");
    assert_eq(_oneshot_parse(&av, 5), ONESHOT_RUN, "--tier rich + positional -> RUN");
    assert_eq(oneshot_tier(), TIER_RICH, "--tier rich applied alongside a task");
    assert(streq(_oneshot_task, "do x"), "the task excludes '--tier rich'");
    # task buffer: reset + bounded append
    _oneshot_task_reset();
    assert_eq(_oneshot_task_len, 0, "task reset clears the length");
    assert_eq(_oneshot_task_append_cstr("abc"), 3, "append returns bytes written");
    assert(streq(_oneshot_task, "abc"), "append assembles the task");
    return 0;
}

# JSON-envelope output (0.11.6): the --json/-j one-shot flag (a modifier, not a mode) and the
# pure envelope serializer. tokens/cost follow ADR-0010 omit-until-present; the reply escapes
# BY LENGTH (an embedded NUL survives). elapsed_ms is a param so the builder is deterministic.
fn test_json_envelope() {
    test_group("JSON-envelope output (oneshot.cyr / hoosh.cyr)");
    var av[64];
    store64(&av + 0, "thoth");
    # --json / -j set the flag without forcing a run or joining the task.
    store64(&av + 8, "--json");
    store64(&av + 16, "task");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "--json + task -> RUN");
    assert_eq(_oneshot_json, 1, "--json sets the json flag");
    assert(streq(_oneshot_task, "task"), "--json is not part of the task");
    store64(&av + 8, "-j");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "-j + task -> RUN");
    assert_eq(_oneshot_json, 1, "-j sets the json flag");
    # --json alone records the flag but is no run intent -> NONE (falls through to the TUI).
    store64(&av + 8, "--json");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "--json alone -> NONE (no task)");
    # a plain task leaves the flag clear; the n<=1 early return RESETS it (no stale flag).
    store64(&av + 8, "plain");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "plain task -> RUN");
    assert_eq(_oneshot_json, 0, "no --json -> flag stays 0");
    store64(&av + 8, "--json");
    _oneshot_parse(&av, 2);
    assert_eq(_oneshot_json, 1, "flag set before the reset check");
    assert_eq(_oneshot_parse(&av, 1), ONESHOT_NONE, "n<=1 -> NONE");
    assert_eq(_oneshot_json, 0, "the n<=1 early return resets the json flag (no stale)");
    # the --json elif must not break -p (its else branch still runs the positional path).
    store64(&av + 8, "-p");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "-p still forces RUN after the --json elif");
    assert_eq(_oneshot_json, 0, "-p does not set json");

    # the envelope serializer (deterministic — elapsed is a param).
    session_set_model(0);
    session_reset();
    session_bump_turn();              # turns -> 1
    session_set_model("m");
    var jb[2048];
    var e1 = oneshot_json_envelope(&jb, 2048, "hi", 2, 42);
    store8(&jb + e1, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\",\"turns\":1,\"elapsed_ms\":42}"), "envelope: response+model+turns+elapsed (no tokens/cost yet)");
    session_add_tokens(100);
    var e2 = oneshot_json_envelope(&jb, 2048, "hi", 2, 42);
    store8(&jb + e2, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\",\"turns\":1,\"tokens\":100,\"elapsed_ms\":42}"), "envelope: +tokens once seen");
    session_add_cost(18000);          # 18000 micro-USD = $0.018 -> $0.01 (floors)
    var e3 = oneshot_json_envelope(&jb, 2048, "hi", 2, 42);
    store8(&jb + e3, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\",\"turns\":1,\"tokens\":100,\"cost\":\"$0.01\",\"elapsed_ms\":42}"), "envelope: +cost once priced");

    # the reply is escaped BY LENGTH — an embedded NUL becomes \u0000, not a truncation.
    session_reset();
    session_bump_turn();
    session_set_model("m");
    var rbuf[8];
    store8(&rbuf + 0, 97);            # 'a'
    store8(&rbuf + 1, 0);             # NUL
    store8(&rbuf + 2, 98);            # 'b'
    var e4 = oneshot_json_envelope(&jb, 2048, &rbuf, 3, 7);
    store8(&jb + e4, 0);
    assert(streq(&jb, "{\"response\":\"a\\u0000b\",\"model\":\"m\",\"turns\":1,\"elapsed_ms\":7}"), "envelope: embedded NUL escaped by length");
    # a model id with a quote is JSON-escaped (can't break the object).
    session_set_model("m\"x");
    var e5 = oneshot_json_envelope(&jb, 2048, "hi", 2, 0);
    store8(&jb + e5, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\\\"x\",\"turns\":1,\"elapsed_ms\":0}"), "envelope: model id JSON-escaped");
    session_set_model(0);
    session_reset();
    return 0;
}

# -o / --out file tee (0.11.7): the flag parse (consumes the next token as the path, not a
# positional; dangling -o; reset across calls) and the file writer (tees bytes + a trailing
# newline, matching stdout; degrades closed on an unwritable path). The writer is unit-testable
# because file I/O works in the harness (a scratch file under build/), unlike a live TCP turn.
fn test_oneshot_out() {
    test_group("-o / --out file tee (oneshot.cyr)");
    var av[64];
    store64(&av + 0, "thoth");
    # -o consumes the NEXT token as the path; the path is NOT joined into the task.
    store64(&av + 8, "-o");
    store64(&av + 16, "out.txt");
    store64(&av + 24, "task");
    assert_eq(_oneshot_parse(&av, 4), ONESHOT_RUN, "-o <file> <task> -> RUN");
    assert(streq(_oneshot_out_path, "out.txt"), "-o records the output path");
    assert(streq(_oneshot_task, "task"), "the -o path is not part of the task");
    # --out alias + -o is a modifier (path but no task -> NONE, like --json alone).
    store64(&av + 8, "--out");
    store64(&av + 16, "f2");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_NONE, "--out <file> alone -> NONE (no task)");
    assert(streq(_oneshot_out_path, "f2"), "--out still records the path");
    # a dangling -o (no following token) leaves no path and no crash.
    store64(&av + 8, "-o");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "dangling -o -> NONE");
    assert_eq(_oneshot_out_path, 0, "dangling -o leaves no path");
    # reset across calls: a plain task clears the out path.
    store64(&av + 8, "plain");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "plain task -> RUN");
    assert_eq(_oneshot_out_path, 0, "no -o -> out path reset to 0");
    # -o composes with --json and a positional task.
    store64(&av + 8, "-o");
    store64(&av + 16, "o.json");
    store64(&av + 24, "--json");
    store64(&av + 32, "do it");
    assert_eq(_oneshot_parse(&av, 5), ONESHOT_RUN, "-o + --json + task -> RUN");
    assert(streq(_oneshot_out_path, "o.json"), "-o path set with --json present");
    assert_eq(_oneshot_json, 1, "--json flag set alongside -o");

    # the writer: a reply with no trailing newline gets one (matching stdout).
    var path = "build/.thoth_out_test.tmp";
    var rbuf[64];
    assert_eq(_oneshot_write_out(path, "hello", 5), 0, "write_out succeeds");
    var n1 = file_read_all(path, &rbuf, 63);
    assert_eq(n1, 6, "file = 'hello' + a trailing newline");
    store8(&rbuf + n1, 0);
    assert(streq(&rbuf, "hello\n"), "file content is the bytes + a newline");
    # a reply ALREADY ending in a newline is not doubled.
    assert_eq(_oneshot_write_out(path, "bye\n", 4), 0, "write_out (already-newline) succeeds");
    var n2 = file_read_all(path, &rbuf, 63);
    assert_eq(n2, 4, "already-newline reply is not doubled");
    store8(&rbuf + n2, 0);
    assert(streq(&rbuf, "bye\n"), "no extra newline appended");
    # an unwritable path degrades closed (-1), not a crash or a silent success.
    assert_eq(_oneshot_write_out("/no_such_dir_thoth_xyz/f", "x", 1), 0 - 1, "unwritable path -> -1 (degrade closed)");
    return 0;
}

# shell completion (0.11.8): the --completion / --completions parse — the COMPLETION mode and
# the captured shell name (default, reset, position-independent short-circuit). The emitted
# bash/zsh SCRIPTS are validated by a host smoke (`thoth --completion bash | bash -n`, `zsh -n`,
# and a functional COMPREPLY check) — shell tools the in-process unit harness lacks.
fn test_completion() {
    test_group("shell completion parse (oneshot.cyr)");
    var av[64];
    store64(&av + 0, "thoth");
    # --completion <shell> -> COMPLETION mode + the captured shell name.
    store64(&av + 8, "--completion");
    store64(&av + 16, "bash");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_COMPLETION, "--completion <shell> -> COMPLETION");
    assert(streq(_oneshot_compl_shell, "bash"), "--completion captures the shell name");
    store64(&av + 16, "zsh");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_COMPLETION, "--completion zsh -> COMPLETION");
    assert(streq(_oneshot_compl_shell, "zsh"), "shell = zsh");
    # the --completions alias.
    store64(&av + 8, "--completions");
    store64(&av + 16, "bash");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_COMPLETION, "--completions alias -> COMPLETION");
    # no shell given -> COMPLETION, shell stays 0 (the printer defaults to bash).
    store64(&av + 8, "--completion");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_COMPLETION, "--completion (no shell) -> COMPLETION");
    assert_eq(_oneshot_compl_shell, 0, "no shell -> 0 (printer defaults to bash)");
    # position-independent short-circuit (like --version): a task before --completion still wins.
    store64(&av + 8, "task");
    store64(&av + 16, "--completion");
    store64(&av + 24, "zsh");
    assert_eq(_oneshot_parse(&av, 4), ONESHOT_COMPLETION, "--completion after a task still short-circuits");
    assert(streq(_oneshot_compl_shell, "zsh"), "shell captured after a positional");
    # reset across calls: a plain task clears the captured shell.
    store64(&av + 8, "hello");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "plain task -> RUN");
    assert_eq(_oneshot_compl_shell, 0, "no --completion -> shell reset to 0");
    return 0;
}

# Multi-turn conversation history (0.5.1): append/accessors, stable copy,
# pop/clear, and the drop-oldest cap.
fn test_history() {
    test_group("multi-turn history");
    session_reset();
    assert_eq(session_history_len(), 0, "history empty after reset");
    assert_eq(config_hoosh_history(), 1, "history on by default");

    session_history_append("user", "hello", 5);
    session_history_append("assistant", "hi there", 8);
    assert_eq(session_history_len(), 2, "two messages recorded");
    assert(streq(session_history_role(0), "user"), "msg 0 role user");
    assert(streq(session_history_content(0), "hello"), "msg 0 content");
    assert(streq(session_history_role(1), "assistant"), "msg 1 role assistant");
    assert(streq(session_history_content(1), "hi there"), "msg 1 content");

    # content is a STABLE COPY, not an alias of the caller's buffer.
    var buf[8];
    store8(&buf + 0, 104); store8(&buf + 1, 105); store8(&buf + 2, 0);   # "hi"
    session_history_append("user", &buf, 2);
    store8(&buf + 0, 88);                                                # clobber -> "Xi"
    assert(streq(session_history_content(2), "hi"), "content copied, not aliased");

    session_history_pop_last();
    assert_eq(session_history_len(), 2, "pop_last drops the newest turn");
    session_history_clear();
    assert_eq(session_history_len(), 0, "clear empties history");

    var i = 0;
    while (i < SESS_HIST_MAX + 5) { session_history_append("user", "x", 1); i = i + 1; }
    assert_eq(session_history_len(), SESS_HIST_MAX, "capped at SESS_HIST_MAX (oldest dropped)");
    session_reset();
    return 0;
}

# The multi-turn request builder + the byte-budget that bounds it.
fn test_history_request() {
    test_group("multi-turn request building");
    session_reset();
    assert_eq(_hoosh_history_start(262144), 0, "empty history -> start 0");
    session_history_append("user", "a", 1);
    session_history_append("assistant", "b", 1);
    session_history_append("user", "c", 1);
    assert_eq(_hoosh_history_start(262144), 0, "ample budget includes all");
    assert_eq(_hoosh_history_start(8), 2, "tiny budget keeps only the newest");

    var rb[512];
    hoosh_build_messages(&rb, "m", 0, 0, 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"a\"},{\"role\":\"assistant\",\"content\":\"b\"},{\"role\":\"user\",\"content\":\"c\"}],\"max_tokens\":4096,\"stream\":false}"), "multi-turn shape, no system");
    hoosh_build_messages(&rb, "m", "sys", 0, 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"a\"},{\"role\":\"assistant\",\"content\":\"b\"},{\"role\":\"user\",\"content\":\"c\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "multi-turn shape, system + stream + usage opt");
    session_reset();
    return 0;
}

# Composer input-history recall (0.11.1): the in-memory ring + nav cursor
# (src/inhist.cyr) and the TUI load/stash glue (src/tui.cyr _tui_recall_*). DISTINCT
# from the multi-turn CONVERSATION history above — this is the user's own keystrokes,
# navigated with Up/Down in the raw-mode composer (TUI-only; the REPL floor is
# untouched).
fn test_inhist() {
    test_group("input-history recall");
    inhist_init();
    assert_eq(inhist_count(), 0, "empty after init");
    assert_eq(inhist_nav_at_draft(), 1, "cursor starts at the draft");
    assert_eq(inhist_nav_up(), 0 - 1, "Up with no history -> -1 (nothing)");

    # push records lines; ignoredups + skip-empty.
    assert_eq(inhist_push("first", 5), 1, "push 'first' stored");
    assert_eq(inhist_push("second", 6), 1, "push 'second' stored");
    assert_eq(inhist_push("", 0), 0, "empty line skipped");
    assert_eq(inhist_push("second", 6), 0, "consecutive duplicate skipped (ignoredups)");
    assert_eq(inhist_count(), 2, "two distinct lines stored");
    assert(streq(inhist_entry_ptr(0), "first"), "entry 0 = oldest = 'first'");
    assert(streq(inhist_entry_ptr(1), "second"), "entry 1 = newest = 'second'");
    assert_eq(inhist_entry_len(1), 6, "newest length");

    # nav: reset to draft, then Up walks newest->oldest, Down walks back to the draft.
    inhist_nav_reset();
    assert_eq(inhist_nav_at_draft(), 1, "reset -> draft");
    assert_eq(inhist_nav_up(), 1, "Up #1 -> newest (idx 1)");
    assert_eq(inhist_nav_at_draft(), 0, "now navigating");
    assert_eq(inhist_nav_up(), 0, "Up #2 -> older (idx 0)");
    assert_eq(inhist_nav_up(), 0, "Up at the oldest clamps (idx 0)");
    assert_eq(inhist_nav_down(), 1, "Down -> newer (idx 1)");
    assert_eq(inhist_nav_down(), 0 - 1, "Down past the newest -> draft (-1)");
    assert_eq(inhist_nav_at_draft(), 1, "back at the draft");

    # the TUI glue: stash a half-typed draft, load recalled entries, restore the draft.
    led_reset();
    led_feed(KEY_CHAR, 97); led_feed(KEY_CHAR, 98);   # type "ab"
    assert_eq(led_len(), 2, "draft 'ab' in the composer");
    _tui_recall_stash_draft();
    _tui_recall_load(1);                              # load newest 'second'
    assert(streq(led_buf(), "second"), "composer loaded with 'second'");
    assert_eq(led_len(), 6, "composer len = 6 after recall");
    assert_eq(led_cur(), 6, "cursor at end after recall");
    _tui_recall_load(0);                              # load oldest 'first'
    assert(streq(led_buf(), "first"), "composer loaded with 'first'");
    _tui_recall_restore_draft();                     # back to the stashed draft
    assert(streq(led_buf(), "ab"), "draft 'ab' restored");
    assert_eq(led_len(), 2, "draft len restored");

    # ring eviction: fill past INHIST_CAP — the oldest drops, count caps, order holds.
    inhist_init();
    var b[16];
    var i = 0;
    while (i < INHIST_CAP + 3) {
        var o = 1;
        store8(&b, 76);                              # 'L'
        o = _append_int(&b, o, i);                   # distinct lines "L0".."L130"
        store8(&b + o, 0);
        inhist_push(&b, o);
        i = i + 1;
    }
    assert_eq(inhist_count(), INHIST_CAP, "count caps at INHIST_CAP (oldest evicted)");
    assert(streq(inhist_entry_ptr(0), "L3"), "oldest is 'L3' after evicting L0,L1,L2");
    assert(streq(inhist_entry_ptr(INHIST_CAP - 1), "L130"), "newest is 'L130'");
    inhist_init();
    led_reset();
    return 0;
}

# Input-history PERSISTENCE (0.11.2): the opt-in on-disk file. Uses real file I/O under
# build/ (gitignored). Verifies load->ring, save->reload round-trip, ignoredups across
# persistence, and the degrade-closed unwritable-path path. The 0600 create-mode is
# asserted empirically by the shell (stat) after the suite creates the mode-check file.
fn test_inhist_persist() {
    test_group("input-history persistence (0.11.2)");
    var lpath = "build/.thoth_hist_load.tmp";
    var seed = "alpha\nalpha\nbeta\n";          # a consecutive dup -> proves init is non-destructive
    file_write_all(lpath, seed, strlen(seed));
    inhist_init();
    var n = inhist_persist_init(lpath);
    assert_eq(n, 2, "two recalled (the consecutive dup collapses in the ring)");
    assert_eq(inhist_count(), 2, "ring holds two");
    assert(streq(inhist_entry_ptr(0), "alpha"), "oldest = alpha");
    assert(streq(inhist_entry_ptr(1), "beta"), "newest = beta");
    assert_eq(inhist_nav_at_draft(), 1, "cursor at the draft after load");
    assert_eq(inhist_persist_active(), 1, "persistence active (file writable)");
    assert_eq(inhist_persist_broke(), 0, "not broken after a clean init");

    # init is NON-DESTRUCTIVE: the file is untouched (still holds the raw dup, not rewritten).
    var rbuf[64];
    var r1 = file_read_all(lpath, &rbuf, 63);
    store8(&rbuf + r1, 0);
    assert(streq(&rbuf, "alpha\nalpha\nbeta\n"), "init did not rewrite the file");

    # a stored submit rewrites the file FROM the ring (deduped/normalized); a reload sees it.
    inhist_push("gamma", 5);
    inhist_persist_save();
    var r2 = file_read_all(lpath, &rbuf, 63);
    store8(&rbuf + r2, 0);
    assert(streq(&rbuf, "alpha\nbeta\ngamma\n"), "save rewrote the file from the ring");
    inhist_init();
    _inhist_load_file(lpath);
    assert_eq(inhist_count(), 3, "gamma persisted -> three on reload");
    assert(streq(inhist_entry_ptr(2), "gamma"), "newest reloaded = gamma");

    # multi-line + backslash round-trip (0.11.9): embedded newlines (from the multi-line
    # composer) and literal backslashes survive save->reload — escaped on write, decoded on
    # read — instead of shattering the line-oriented file into bogus entries.
    inhist_init();
    var mpath = "build/.thoth_hist_ml.tmp";
    file_write_all(mpath, "", 0);                # start empty (isolate from a prior run's file)
    inhist_persist_init(mpath);                  # bind (empty -> ring empty)
    inhist_push("a\nb", 3);                      # an embedded newline (a multi-line entry)
    inhist_push("c\\d", 3);                      # a literal backslash
    inhist_persist_save();
    inhist_init();
    _inhist_load_file(mpath);
    assert_eq(inhist_count(), 2, "two entries round-trip (no shatter on embedded newline)");
    assert_eq(inhist_entry_len(0), 3, "multi-line entry length intact (a<nl>b)");
    assert(streq(inhist_entry_ptr(0), "a\nb"), "embedded newline preserved");
    assert(streq(inhist_entry_ptr(1), "c\\d"), "literal backslash preserved");

    # _inhist_escape_into (pure): '\' -> '\\', newline -> '\' 'n', plain bytes pass through.
    var ebuf[32];
    var en = _inhist_escape_into(&ebuf, 32, "a\nb", 3);
    store8(&ebuf + en, 0);
    assert_eq(en, 4, "3-byte 'a<nl>b' escapes to 4 bytes");
    assert(streq(&ebuf, "a\\nb"), "newline encodes as backslash-n");
    var en2 = _inhist_escape_into(&ebuf, 32, "c\\d", 3);
    store8(&ebuf + en2, 0);
    assert_eq(en2, 4, "3-byte 'c\\d' escapes to 4 bytes");
    assert(streq(&ebuf, "c\\\\d"), "backslash encodes as double backslash");

    # degrade-closed: an unwritable path -> persistence stays OFF (-1); the caller announces.
    inhist_init();
    var bad = inhist_persist_init("build/.no_such_dir_xyz/hist.tmp");
    assert_eq(bad, 0 - 1, "unwritable path -> -1");
    assert_eq(inhist_persist_active(), 0, "persistence OFF after a write failure");

    # create the 0600 mode-check file (fresh path); the shell asserts the perms post-suite.
    inhist_init();
    inhist_persist_init("build/.thoth_hist_mode.tmp");

    inhist_persist_init(0);          # unbind persistence -> clean slate for later tests
    inhist_init();
    led_reset();
    return 0;
}

# Structured driver-event logging (0.5.2): the pure message builder + level
# parse + config defaults. The sakshi emit path is I/O and not unit-tested here.
fn test_logging() {
    test_group("structured logging");
    # off by default (no config, no init)
    assert_eq(config_log_file(), 0, "no log file by default");
    assert_eq(config_log_level(), 0, "no log level by default");
    assert_eq(log_active(), 0, "logging off without init");

    # level parse
    assert_eq(_log_parse_level("off"), 0 - 1, "off -> disabled");
    assert_eq(_log_parse_level("fatal"), SK_FATAL, "fatal");
    assert_eq(_log_parse_level("error"), SK_ERROR, "error");
    assert_eq(_log_parse_level("warn"), SK_WARN, "warn");
    assert_eq(_log_parse_level("info"), SK_INFO, "info");
    assert_eq(_log_parse_level("debug"), SK_DEBUG, "debug");
    assert_eq(_log_parse_level("trace"), SK_TRACE, "trace");
    assert_eq(_log_parse_level(0), SK_INFO, "unset -> default info");
    assert_eq(_log_parse_level("bogus"), SK_INFO, "unknown -> default info");

    # structured message builder
    log_begin("hoosh_turn");
    log_kv_str("model", "gpt-5");
    log_kv_int("status", 200);
    assert(streq(log_message(), "event=hoosh_turn model=gpt-5 status=200"), "structured message shape");
    log_begin("authz");
    log_kv_str("tool", 0);
    assert(streq(log_message(), "event=authz tool=-"), "null value renders as -");
    log_begin("x");
    log_kv_int("d", 0 - 5);
    assert(streq(log_message(), "event=x d=-5"), "negative int field");
    return 0;
}

# Agentic tool-calling loop (0.6.0): the pure pieces — tool advertisement,
# tool_calls parsing, raw extraction, and request shaping. The loop itself is I/O.
fn test_agent() {
    test_group("agentic tool-calling");
    # 0.23.0 agent_enabled() = the master [hoosh].tools switch ALONE: read_file/list_dir are always-available
    # local tools, so the agentic loop runs whenever tools are on — daimon + shell just ADD more tools.
    # (Was 0.20.0's "tools AND (daimon OR shell)".) Poke the config globals directly, RESTORE at the end.
    assert_eq(shell_supported(), 1, "POSIX test build supports the shell tool");
    _cfg_hoosh_tools = 1; _cfg_daimon_url = 0; _cfg_shell_enabled = 0;
    assert_eq(agent_enabled(), 1, "tools on, no daimon, no shell -> agentic on (read_file/list_dir always available, 0.23.0)");
    _cfg_daimon_url = "http://x";
    assert_eq(agent_enabled(), 1, "daimon wired + tools -> agentic on");
    _cfg_daimon_url = 0; _cfg_shell_enabled = 1;
    assert_eq(agent_enabled(), 1, "shell enabled + tools -> agentic on");
    _cfg_hoosh_tools = 0;
    assert_eq(agent_enabled(), 0, "[hoosh].tools off -> plain turns (the master off switch)");
    _cfg_hoosh_tools = 1; _cfg_daimon_url = 0; _cfg_shell_enabled = 0;   # restore defaults

    # advertise-degrade: with a 0 daimon value (no registry fetched) the tools array is built from the local
    # tools alone; enabling shell yields a VALID array carrying a "shell" tool — the network-free proof that
    # the agentic loop needs no daimon.
    var stb[2048];
    assert_eq(agent_tools_add_shell(&stb, 0), 0, "shell off -> add_shell is a no-op (advertise floor)");
    _cfg_shell_enabled = 1;
    var stl = agent_tools_add_shell(&stb, 0);
    assert(stl > 0, "shell on -> add_shell builds a tools array from the empty (daimon-absent) base");
    var sav = bayan_json_v_parse_str(&stb, stl);
    assert(sav != 0, "the shell-only tools array parses");
    assert_eq(bayan_json_v_arr_len(sav), 1, "exactly one tool advertised standalone");
    var stf = bayan_json_v_obj_get(bayan_json_v_arr_get(sav, 0), "function");
    assert(streq(str_cstr(bayan_json_v_str(bayan_json_v_obj_get(stf, "name"))), "shell"), "the advertised tool is named 'shell'");
    _cfg_shell_enabled = 0;   # restore

    # tool advertisement: daimon {name,description} -> OpenAI function tools
    var ta = "[{\"name\":\"echo\",\"description\":\"echo back\"},{\"name\":\"clk\",\"description\":\"time\"}]";
    var tav = bayan_json_v_parse_str(ta, strlen(ta));
    var tb[1024];
    agent_format_tools(&tb, tav);
    assert(streq(&tb, "[{\"type\":\"function\",\"function\":{\"name\":\"echo\",\"description\":\"echo back\",\"parameters\":{\"type\":\"object\"}}},{\"type\":\"function\",\"function\":{\"name\":\"clk\",\"description\":\"time\",\"parameters\":{\"type\":\"object\"}}}]"), "tools formatted as OpenAI functions");
    assert_eq(agent_format_tools(&tb, 0), 0, "no tools value -> 0 length");

    # daimon 1.2.7: per-tool inputSchema passes through verbatim as `parameters`;
    # a tool without one falls back to the permissive object schema.
    var ts = "[{\"name\":\"rd\",\"description\":\"read\",\"inputSchema\":{\"type\":\"string\"}},{\"name\":\"clk\",\"description\":\"time\"}]";
    var tsv = bayan_json_v_parse_str(ts, strlen(ts));
    agent_format_tools(&tb, tsv);
    assert(streq(&tb, "[{\"type\":\"function\",\"function\":{\"name\":\"rd\",\"description\":\"read\",\"parameters\":{\"type\":\"string\"}}},{\"type\":\"function\",\"function\":{\"name\":\"clk\",\"description\":\"time\",\"parameters\":{\"type\":\"object\"}}}]"), "inputSchema passed through; absent -> object fallback");

    # tool_calls parsing from an OpenAI-shaped response
    var resp = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"tool_calls\":[{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"echo\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}]}";
    var tcs = agent_tool_calls(resp, strlen(resp));
    assert(tcs != 0, "tool_calls present");
    assert_eq(agent_tc_count(tcs), 1, "one tool call");
    assert(streq(agent_tc_id(tcs, 0), "call_1"), "tool_call id");
    assert(streq(agent_tc_name(tcs, 0), "echo"), "tool_call name");
    assert(streq(agent_tc_args(tcs, 0), "{}"), "tool_call arguments");

    var plain = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hi\"}}]}";
    assert_eq(agent_tc_count(agent_tool_calls(plain, strlen(plain))), 0, "no tool_calls -> count 0");

    # raw tool_calls substring (echoed back verbatim as the assistant message)
    var raw = _agent_raw_tool_calls(resp, strlen(resp));
    assert(raw != 0, "raw tool_calls extracted");
    assert_eq(cstr_starts_with(raw, "[{\"id\":\"call_1\""), 1, "raw is the array text");

    # request shaping: history + tools
    session_reset();
    session_history_append("user", "hi", 2);
    var rb[512];
    agent_build_request(&rb, "m", 0, 0, 0, 0, 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "agent request: history, no tools");
    var toolsb = "[{\"type\":\"function\"}]";
    agent_build_request(&rb, "m", 0, 0, toolsb, strlen(toolsb), 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"tools\":[{\"type\":\"function\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "agent request: with tools, streaming + usage opt");
    session_reset();

    # streamed tool_call assembly: deltas arrive fragmented (id+name first, then
    # arguments in pieces), reconstructed into the same array text the block path
    # produces. Mirrors OpenAI streaming tool_calls.
    _ag_reset();
    var d1 = "{\"index\":0,\"id\":\"call_9\",\"type\":\"function\",\"function\":{\"name\":\"echo\",\"arguments\":\"{\\\"t\\\":\"}}";
    _agent_accum_delta(bayan_json_v_parse_str(d1, strlen(d1)));
    var d2 = "{\"index\":0,\"function\":{\"arguments\":\"42}\"}}";
    _agent_accum_delta(bayan_json_v_parse_str(d2, strlen(d2)));
    var ab[1024];
    _ag_build_array(&ab);
    assert(streq(&ab, "[{\"id\":\"call_9\",\"type\":\"function\",\"function\":{\"name\":\"echo\",\"arguments\":\"{\\\"t\\\":42}\"}}]"), "streamed deltas reassemble into the tool_calls array");
    # and the reassembled array parses back through the same accessors
    var av = bayan_json_v_parse_str(&ab, strlen(&ab));
    assert_eq(agent_tc_count(av), 1, "reassembled: one call");
    assert(streq(agent_tc_name(av, 0), "echo"), "reassembled: name");
    assert(streq(agent_tc_args(av, 0), "{\"t\":42}"), "reassembled: args decoded");
    return 0;
}

# M4 config defaults when no thoth.cyml is loaded.
fn test_config_m4() {
    test_group("daimon/tron config (unconfigured)");
    assert_eq(config_daimon_configured(), 0, "daimon not configured by default");
    assert_eq(config_daimon_url(), 0, "no daimon url by default");
    assert_eq(config_tron_policy(), 0, "no t-ron policy by default");
    assert(streq(config_tron_agent(), "thoth"), "default agent id");
    assert_eq(gate_active(), 0, "gate inactive without a policy");
    return 0;
}

# The daimon client's pure pieces: call-body building and tool-result
# extraction against canned bodies (no network).
fn test_daimon() {
    test_group("daimon call building");
    var cb[256];
    daimon_build_call(&cb, "echo", "{\"x\":1}");
    assert(streq(&cb, "{\"name\":\"echo\",\"arguments\":{\"x\":1}}"), "call body with args");
    daimon_build_call(&cb, "scan", 0);
    assert(streq(&cb, "{\"name\":\"scan\",\"arguments\":{}}"), "call body, no args -> {}");
    daimon_build_call(&cb, "we\"ird", 0);
    assert(streq(&cb, "{\"name\":\"we\\\"ird\",\"arguments\":{}}"), "tool name is escaped");

    test_group("daimon result extraction");
    var ok = "{\"content\":[{\"type\":\"text\",\"text\":\"tool says hi\"}],\"isError\":false}";
    var s = daimon_extract_text(ok, strlen(ok));
    assert(s != 0, "text present");
    assert(str_eq_cstr(s, "tool says hi"), "text matches");
    assert_eq(daimon_extract_is_error(ok, strlen(ok)), 0, "isError false -> 0");
    var bad = "{\"content\":[{\"type\":\"text\",\"text\":\"boom\"}],\"isError\":true}";
    assert_eq(daimon_extract_is_error(bad, strlen(bad)), 1, "isError true -> 1");
    var none = "{\"ok\":true}";
    assert_eq(daimon_extract_text(none, strlen(none)), 0, "no content -> 0");
    assert_eq(daimon_extract_is_error(none, strlen(none)), 0 - 1, "no isError -> -1");
    var nojson = "nope";
    assert_eq(daimon_extract_text(nojson, strlen(nojson)), 0, "unparseable -> 0");
    return 0;
}

# The vendored t-ron engine end-to-end in-process: policy allow/deny globs,
# deny-by-default for unknown agents, and the audit path (libro chain_append —
# the sigil/thread_local ordering canary).
fn test_tron() {
    test_group("t-ron verdicts (vendored engine)");
    var t = tron_new(tron_config_default());
    var pol = "[agent.\"thoth\"]\nallow = [\"echo_*\", \"thoth_run\"]\ndeny = [\"danger_*\"]\n";
    assert_eq(tron_load_policy(t, pol), TRON_ERR_NONE, "policy parses");

    var c1 = tool_call_new("thoth", "echo_hello", "{}", 1000);
    assert_eq(verdict_kind(tron_check(t, c1)), VK_ALLOW, "allow-listed tool -> allow");
    var c2 = tool_call_new("thoth", "danger_rm", "{}", 2000);
    assert_eq(verdict_kind(tron_check(t, c2)), VK_DENY, "deny-listed tool -> deny");
    var c3 = tool_call_new("thoth", "unlisted_tool", "{}", 3000);
    assert_eq(verdict_kind(tron_check(t, c3)), VK_DENY, "unlisted tool -> deny (fail closed)");
    var c4 = tool_call_new("mallory", "echo_hello", "{}", 4000);
    assert_eq(verdict_kind(tron_check(t, c4)), VK_DENY, "unknown agent -> deny (fail closed)");
    var c5 = tool_call_new("thoth", "thoth_run", "{\"cmd\":\"echo hi\"}", 5000);
    assert_eq(verdict_kind(tron_check(t, c5)), VK_ALLOW, "thoth_run allowed by policy");
    return 0;
}

# The audit chain: every tron_check logs to t-ron's AuditLogger (operational
# ring + libro cryptographic chain). thoth's /audit surfaces it; this drives
# the real vendored engine and asserts the counts, integrity, and the pure
# kind-label glue thoth authors over it.
fn test_audit() {
    test_group("t-ron audit chain (vendored engine)");
    # pure glue first — independent of any engine state.
    assert(streq(audit_kind_str(VK_ALLOW), "allow"), "VK_ALLOW -> allow");
    assert(streq(audit_kind_str(VK_DENY), "deny"), "VK_DENY -> deny");
    assert(streq(audit_kind_str(VK_FLAG), "flag"), "VK_FLAG -> flag");
    assert(streq(audit_kind_str(99), "?"), "unknown kind -> ?");

    var t = tron_new(tron_config_default());
    var pol = "[agent.\"thoth\"]\nallow = [\"echo_*\"]\ndeny = [\"danger_*\"]\n";
    assert_eq(tron_load_policy(t, pol), TRON_ERR_NONE, "policy parses");
    var a = tron_audit(t);
    assert_eq(query_total_events(a), 0, "empty chain before any check");

    tron_check(t, tool_call_new("thoth", "echo_hi", "{}", 1000));    # allow
    tron_check(t, tool_call_new("thoth", "danger_rm", "{}", 2000));  # deny
    tron_check(t, tool_call_new("thoth", "unlisted", "{}", 3000));   # deny (fail closed)

    assert_eq(query_total_events(a), 3, "three gated actions logged");
    assert_eq(query_total_denials(a), 2, "two denials counted");
    assert_eq(audit_chain_len(a), 3, "libro chain has three entries");
    assert_eq(audit_verify_chain(a), 0, "chain integrity intact (no tamper)");
    # newest-first: the most recent event is the unlisted deny.
    var recent = audit_recent(a, 10);
    assert_eq(vec_len(recent), 3, "recent returns all three");
    assert_eq(security_event_kind(vec_get(recent, 0)), VK_DENY, "newest is a deny");
    assert(streq(security_event_tool_name(vec_get(recent, 0)), "unlisted"), "newest tool is 'unlisted'");
    return 0;
}

# Mid-session model switch stores a COPY (the arg aliases a reused line buffer).
fn test_model_switch() {
    test_group("mid-session model switch");
    session_reset();
    assert_eq(session_model(), 0, "no model after reset");
    var scratch[16];
    store8(&scratch + 0, 103); store8(&scratch + 1, 112); store8(&scratch + 2, 116);
    store8(&scratch + 3, 0);                                   # "gpt"
    session_set_model_copy(&scratch);
    store8(&scratch + 0, 88);                                  # clobber to "Xpt"
    assert(streq(session_model(), "gpt"), "model is a stable copy, not an alias");
    # 0.22.3 terminal window-title builder (pure): the active model appears in the title
    var tb = alloc(256);
    session_set_model_copy("opus-x");
    _term_title_build(tb, 256);
    assert(streq(tb, "thoth - opus-x") == 1, "title reflects the active model (session_model wins)");
    # control bytes (BEL 0x07 / ESC 0x1b / DEL 0x7f) in the model are stripped -> no OSC escape injection
    var mbuf[16];
    store8(&mbuf + 0, 97); store8(&mbuf + 1, 7); store8(&mbuf + 2, 98);   # 'a' BEL 'b'
    store8(&mbuf + 3, 27); store8(&mbuf + 4, 99); store8(&mbuf + 5, 127); store8(&mbuf + 6, 0);  # ESC 'c' DEL
    session_set_model_copy(&mbuf);
    _term_title_build(tb, 256);
    assert(streq(tb, "thoth - abc") == 1, "control bytes stripped from the title (no escape injection)");
    session_reset();
    return 0;
}

# Agentic tool-round trace (roundlog): the session-local ring /audit surfaces.
# Pure data-structure ops — no I/O — so the recording + ring eviction is testable.
fn test_roundlog() {
    test_group("agentic tool rounds (roundlog)");
    roundlog_reset();
    assert_eq(roundlog_total(), 0, "empty total");
    assert_eq(roundlog_count(), 0, "empty count");

    # one round (turn 5, round 1) with three calls: allow+ok, deny, noname
    roundlog_open(5, 1);
    roundlog_add_call("read_file", RL_ALLOWED, 1, 142, 87);   # 0.19.1: + ms, bytes
    roundlog_add_call("write_file", RL_DENIED, 0, 0, 0);
    roundlog_add_call(0, RL_NONAME, 0, 0, 0);
    assert_eq(roundlog_total(), 1, "one round opened");
    assert_eq(roundlog_count(), 1, "one round retained");
    assert_eq(roundlog_round_turn(0), 5, "round turn = 5");
    assert_eq(roundlog_round_no(0), 1, "round no = 1");
    assert_eq(roundlog_round_ncalls(0), 3, "three calls recorded");
    assert(streq(roundlog_call_name(0, 0), "read_file"), "call0 name copied");
    assert_eq(roundlog_call_kind(0, 0), RL_ALLOWED, "call0 allowed");
    assert_eq(roundlog_call_ok(0, 0), 1, "call0 ok");
    assert_eq(roundlog_call_ms(0, 0), 142, "call0 elapsed ms recorded (0.19.1)");
    assert_eq(roundlog_call_bytes(0, 0), 87, "call0 result bytes recorded (0.19.1)");
    assert(streq(roundlog_call_name(0, 1), "write_file"), "call1 name copied");
    assert_eq(roundlog_call_kind(0, 1), RL_DENIED, "call1 denied");
    assert_eq(roundlog_call_kind(0, 2), RL_NONAME, "call2 noname");
    assert(streq(roundlog_call_name(0, 2), ""), "call2 empty name (null in)");

    # verdict labels
    assert(streq(roundlog_kind_str(RL_ALLOWED), "allow"), "kind str allow");
    assert(streq(roundlog_kind_str(RL_DENIED), "deny"), "kind str deny");
    assert(streq(roundlog_kind_str(RL_NONAME), "noname"), "kind str noname");

    # a round caps at RL_MAX_CALLS calls; extra calls are dropped (announced via report)
    roundlog_reset();
    roundlog_open(1, 1);
    var c = 0;
    while (c < (RL_MAX_CALLS + 3)) { roundlog_add_call("t", RL_ALLOWED, 1, 0, 0); c = c + 1; }
    assert_eq(roundlog_round_ncalls(0), RL_MAX_CALLS, "round caps at RL_MAX_CALLS calls");

    # ring eviction: open CAP+2 rounds (round_no = global index); oldest two drop off
    roundlog_reset();
    var g = 1;
    while (g <= (ROUNDLOG_CAP + 2)) {
        roundlog_open(1, g);
        roundlog_add_call("x", RL_ALLOWED, 1, 0, 0);
        g = g + 1;
    }
    assert_eq(roundlog_total(), ROUNDLOG_CAP + 2, "total counts every round opened");
    assert_eq(roundlog_count(), ROUNDLOG_CAP, "ring retains only CAP rounds");
    assert_eq(roundlog_round_no(0), 3, "oldest retained is global round 3 (1,2 evicted)");
    assert_eq(roundlog_round_no(roundlog_count() - 1), ROUNDLOG_CAP + 2, "newest retained is last opened");
    roundlog_reset();
    return 0;
}

# The parallel executor's pure piece: the bounded snapshot copy that lifts each
# call's name/args/id out of the (soon-overwritten) parser value into a stable
# per-slot buffer before fan-out. The phasing + threads themselves are I/O and
# exercised live against daimon; this guards the copy's bounds + NUL-termination.
fn test_parallel() {
    test_group("parallel tool-call snapshot copy");
    var b[16];
    var n = _par_cstr_copy(&b, 16, "read_file");
    assert_eq(n, 9, "copies full length");
    assert(streq(&b, "read_file"), "exact copy NUL-terminated");
    # truncation: cap 4 keeps 3 bytes + NUL
    var t = _par_cstr_copy(&b, 4, "abcdef");
    assert_eq(t, 3, "truncates to cap-1 bytes");
    assert(streq(&b, "abc"), "truncated copy NUL-terminated");
    # null src -> empty string, length 0
    var z = _par_cstr_copy(&b, 16, 0);
    assert_eq(z, 0, "null src copies nothing");
    assert(streq(&b, ""), "null src yields empty string");
    return 0;
}

# Bounded request-assembly helpers: the defensive primitives every model/MCP-fed
# builder now writes through, so an oversized untrusted string truncates in-buffer
# instead of overflowing a fixed destination. Each check plants a canary one byte
# past the cap and asserts it survives.
fn test_bounds_hardening() {
    test_group("bounded request assembly (untrusted-input clamp)");
    # _append_cstr_cap stops at cap-1 (reserving the last byte for the caller's NUL);
    # the byte at index cap is never touched.
    var ab[64];
    store8(&ab + 16, 123);                                     # canary at the cap
    var n = _append_cstr_cap(&ab, 0, 16, "0123456789abcdefghij");   # 20 chars into cap 16
    assert_eq(n, 15, "append_cstr_cap stops at cap-1");
    assert_eq(load8(&ab + 16), 123, "append_cstr_cap leaves the byte at cap untouched");

    # _json_escape_into_cap stops before a worst-case 6-byte escape can reach the
    # cap, truncating on a character boundary (never a split escape).
    var eb[64];
    store8(&eb + 20, 77);                                      # canary
    var nl = "\n\n\n\n\n\n\n\n\n\n\n\n";                        # 12 LF bytes, each -> "\n" (2 bytes)
    var m = _json_escape_into_cap(&eb, 0, 20, nl);
    assert(m <= 19, "json_escape_into_cap stays within cap-1");
    assert_eq(load8(&eb + 20), 77, "json_escape_into_cap leaves the byte at cap untouched");
    assert_eq(m - (m / 2) * 2, 0, "escape truncates on a character boundary (whole escapes only)");

    # end-to-end: an oversized model `arguments` string cannot overflow the fixed
    # 32 KB daimon request buffer — daimon_build_call clamps to DAIMON_REQ_CAP and a
    # canary one byte past the buffer survives.
    var big = alloc(DAIMON_REQ_CAP + 16);
    store8(big + DAIMON_REQ_CAP, 200);                         # canary just past the cap
    var hug = alloc(DAIMON_REQ_CAP + 1024);
    var k = 0;
    while (k < (DAIMON_REQ_CAP + 1023)) { store8(hug + k, 97); k = k + 1; }   # 'a' * (cap+1023)
    store8(hug + (DAIMON_REQ_CAP + 1023), 0);
    var bo = daimon_build_call(big, "x", hug);
    assert(bo <= (DAIMON_REQ_CAP - 1), "daimon_build_call clamps oversized args to cap-1");
    assert_eq(load8(big + DAIMON_REQ_CAP), 200, "oversized args do not overflow _daimon_req (canary intact)");
    return 0;
}

# Presentation surface (M7 / ADR-0009): the T0 floor must emit NO escapes (so
# piped/CI output is byte-identical), and T1 must produce the design's exact amber.
fn test_ui() {
    test_group("presentation surface (M7 ui.cyr)");
    # substrate helpers
    assert_eq(_ui_contains("xterm-256color", "256color"), 1, "_ui_contains finds substring");
    assert_eq(_ui_contains("xterm", "256color"), 0, "_ui_contains misses absent substring");
    var db[8];
    var dn = _ui_dec(&db, 0, 230); store8(&db + dn, 0);
    assert(streq(&db, "230"), "_ui_dec writes decimal");

    # T0 floor: every role + reset resolves to the empty string
    ui_force(PT_PLAIN, CD_NONE);
    assert_eq(ui_tier(), PT_PLAIN, "forced T0 plain");
    assert_eq(streq(ui_sgr(ROLE_ACCENT), ""), 1, "T0 accent role -> empty (no escapes)");
    assert_eq(streq(ui_sgr(ROLE_GREEN), ""), 1, "T0 green role -> empty");
    assert_eq(streq(ui_reset(), ""), 1, "T0 reset -> empty");

    # T1 truecolor: exact #e6ab5c amber + well-formed SGR envelope
    ui_force(PT_ANSI, CD_TRUE);
    var acc = ui_sgr(ROLE_ACCENT);
    assert_eq(load8(acc), 27, "T1 SGR starts with ESC");
    assert_eq(load8(acc + 1), 91, "T1 SGR second byte is '['");
    assert_eq(_ui_contains(acc, "38;2;230;171;92"), 1, "T1 accent is the #e6ab5c truecolor SGR");
    var rexp[8];
    store8(&rexp, 27); store8(&rexp + 1, 91); store8(&rexp + 2, 48); store8(&rexp + 3, 109); store8(&rexp + 4, 0);
    assert_eq(streq(ui_reset(), &rexp), 1, "T1 reset is ESC[0m");

    # 256-color fallback maps the accent to its cube index
    ui_force(PT_ANSI, CD_256);
    assert_eq(_ui_contains(ui_sgr(ROLE_ACCENT), "38;5;179"), 1, "256-color accent -> index 179");

    # --tier preference (0.11.10): the pure name->pref mapping (the tty-dependent detection —
    # auto/rich -> PT_RICH on a real terminal — is verified live, not here, since the suite may
    # run on a tty or piped).
    assert_eq(ui_tier_pref_from_name("auto"), TIER_AUTO, "tier name 'auto' -> TIER_AUTO");
    assert_eq(ui_tier_pref_from_name("rich"), TIER_RICH, "tier name 'rich' -> TIER_RICH");
    assert_eq(ui_tier_pref_from_name("simple"), TIER_SIMPLE, "tier name 'simple' -> TIER_SIMPLE");
    assert_eq(ui_tier_pref_from_name("bogus"), 0 - 1, "unknown tier name -> -1");

    # restore detection (the suite runs piped -> resolves back to T0)
    ui_set_tier_pref(TIER_AUTO);
    ui_detect_tier();
    return 0;
}

# Diff producer (0.8.3): the pure LCS line-diff core. diff_stats returns
# adds*1000000 + dels (or -1 if a side exceeds the line cap). Identity is
# NEWLINE-AWARE (a terminated line differs from an unterminated one) so the card
# can never under-report the bytes written.
fn test_diff() {
    test_group("diff producer (0.8.3)");
    var a = "a\nb\nc\n";
    assert_eq(diff_stats(a, strlen(a), a, strlen(a)), 0, "identical -> 0 adds 0 dels");
    var e = "";
    var x = "x\n";
    assert_eq(diff_stats(e, 0, x, strlen(x)), 1000000, "empty old -> one add");
    assert_eq(diff_stats(x, strlen(x), e, 0), 1, "empty new -> one del");
    var c2 = "a\nB\nc\n";
    assert_eq(diff_stats(a, strlen(a), c2, strlen(c2)), 1000001, "one line changed -> 1 add 1 del");
    var ins1 = "a\nc\n";
    assert_eq(diff_stats(ins1, strlen(ins1), a, strlen(a)), 1000000, "insert middle (b) -> 1 add");
    # newline-aware: an unterminated final line vs a terminated one is a REAL change
    var nl1 = "hello";
    var nl2 = "hello\n";
    assert_eq(diff_stats(nl1, strlen(nl1), nl2, strlen(nl2)), 1000001, "newline-only change is visible (1 add 1 del)");
    var r1 = "one\ntwo\n";
    var r2 = "uno\ndos\n";
    assert_eq(diff_stats(r1, strlen(r1), r2, strlen(r2)), 2000002, "full replace -> 2 add 2 del");
    return 0;
}

# /git per-file diff renderer (0.19.2): diff_render_ann colors sit's annotated line-ops (kind/line/old/new)
# through _diff_emit_line — the same renderer /read + write diffs use. Build a tiny ops vec by hand
# (sit_diff_path's 32-byte {kind, line-tuple, old_no, new_no} shape) and render it into the feed ring.
fn _t_ann(kind, text, tlen, oldn, newn) {
    var t = alloc(16); store64(t, text); store64(t + 8, tlen);              # the {ptr,len} line tuple
    var o = alloc(32); store64(o, kind); store64(o + 8, t); store64(o + 16, oldn); store64(o + 24, newn);
    return o;
}
fn test_git_diff() {
    test_group("/git per-file diff (diff.cyr diff_render_ann, 0.19.2)");
    ui_force(PT_PLAIN, CD_NONE);                                            # plain -> verbatim body (easy strip)
    var ops = vec_new();
    vec_push(ops, _t_ann(0, "ctx", 3, 1, 1));                               # keep (context)
    vec_push(ops, _t_ann(1, "removed", 7, 2, 0));                           # del
    vec_push(ops, _t_ann(2, "added", 5, 0, 2));                             # add
    feed_init();
    out_mode_set(OUT_RING);
    diff_render_ann("f.txt", ops);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 5, "5 rows: path header, +/- count, 3 body lines");
    assert_eq(_t_count_sub(feed_line_ptr(0), feed_line_len(0), "f.txt", 5), 1, "row 0 is the path header");
    assert_eq(_t_count_sub(feed_line_ptr(1), feed_line_len(1), "+1", 2), 1, "count line shows +1 add");
    assert_eq(_t_count_sub(feed_line_ptr(1), feed_line_len(1), "-1", 2), 1, "count line shows -1 del");
    assert_eq(_t_count_sub(feed_line_ptr(2), feed_line_len(2), "ctx", 3), 1, "context line body preserved");
    assert_eq(_t_count_sub(feed_line_ptr(3), feed_line_len(3), "removed", 7), 1, "del line body preserved");
    assert_eq(_t_count_sub(feed_line_ptr(4), feed_line_len(4), "added", 5), 1, "add line body preserved");
    return 0;
}

# Syntax highlighting (0.8.4): the vyakarana integration — language detection,
# tokenization, and the token-kind -> color-role mapping for /read.
fn test_highlight() {
    test_group("syntax highlighting (vyakarana, 0.8.4)");
    var lang = detect_language("foo.cyr");
    assert(lang != 0, "detect_language finds a grammar for .cyr");
    var s = tokenize_stream_new(lang);
    assert(s != 0, "stream opens for the detected language");
    var src = "var x = 1;";
    tokenize_stream_feed(s, src, strlen(src));
    var tb = tokenbuf_new();
    tokenize_stream_drain(s, tb);
    tokenize_stream_finish(s, tb);
    var count = tokenbuf_count(tb);
    assert(count > 0, "produced tokens");
    var i = 0;
    var found_kw = 0;
    while (i < count) {
        if (tokenbuf_kind(tb, i) == TK_KEYWORD) { found_kw = 1; }
        i = i + 1;
    }
    assert_eq(found_kw, 1, "'var' tokenized as a keyword");
    tokenize_stream_free(s);
    # the kind -> role map
    assert_eq(_tok_role(TK_KEYWORD), ROLE_ACCENT, "keyword -> accent");
    assert_eq(_tok_role(TK_STRING), ROLE_GREEN, "string -> green");
    assert(_tok_role(TK_IDENT) < 0, "ident -> uncolored (-1)");
    return 0;
}

# T2 rich-TUI (0.9.0): the PURE pieces — the composer line-editor state machine and
# the layout geometry. The raw-mode I/O loop is verified on a live tty, not here.
fn test_tui() {
    test_group("T2 composer + layout (tui.cyr)");
    led_reset();
    led_feed(KEY_CHAR, 104); led_feed(KEY_CHAR, 105);            # h i
    assert_eq(led_len(), 2, "two chars typed");
    assert(streq(led_buf(), "hi"), "buffer is 'hi'");
    led_feed(KEY_LEFT, 0);
    led_feed(KEY_CHAR, 88);                                      # X before 'i'
    assert(streq(led_buf(), "hXi"), "insert at cursor");
    assert_eq(led_cur(), 2, "cursor sits after the inserted char");
    led_feed(KEY_BACKSPACE, 0);
    assert(streq(led_buf(), "hi"), "backspace removes the inserted char");
    led_feed(KEY_END, 0); led_feed(KEY_CHAR, 33);                # End, '!'
    assert(streq(led_buf(), "hi!"), "End + append");
    assert_eq(led_feed(KEY_ENTER, 0), ACT_SUBMIT, "Enter submits");
    led_feed(KEY_KILL, 0);
    assert_eq(led_len(), 0, "Ctrl-U clears the line");
    assert_eq(led_feed(KEY_EOF, 0), ACT_EOF, "real stdin EOF -> exit");
    led_feed(KEY_CHAR, 122);                                    # 'z' (non-empty line)
    assert_eq(led_feed(KEY_CTRLC, 0), ACT_EOF, "Ctrl-C exits even with text in the line");
    # geometry (0.11.9: faint rules + dynamic multi-line composer; pure (rows,lines,show))
    assert_eq(tui_status_row(), 1, "status bar at row 1");
    assert_eq(tui_hint_row(24), 24, "keybinding hint at the last row");
    assert_eq(tui_sep_top_row(), 2, "top rule under the status bar");
    assert_eq(tui_composer_bot(24), 23, "composer block bottom just above the hint");
    assert_eq(tui_composer_top(24, 1, 1), 23, "1-line composer top == bottom (one row)");
    assert_eq(tui_composer_top(24, 2, 1), 22, "a 2-line composer grows up one row");
    assert_eq(tui_sep_bottom_row(24, 1, 1), 22, "bottom rule above a 1-line composer");
    assert_eq(tui_feed_top(1), 3, "feed starts below the status bar + its rule");
    assert_eq(tui_feed_top(0), 1, "feed reclaims rows 1-2 when status hidden");
    assert_eq(tui_feed_bot(24, 1, 1), 21, "feed bottom above the bottom rule + 1-line composer");
    assert_eq(tui_feed_bot(24, 2, 1), 20, "a 2-line composer pushes the feed bottom up one");
    assert_eq(tui_composer_height(24, 1, 1), 1, "one logical line -> one composer row");
    assert_eq(tui_composer_height(24, 20, 1), 8, "composer height clamps to COMPOSER_MAX_ROWS");
    assert(tui_composer_max(8, 0) > tui_composer_max(8, 1), "hidden status frees more composer rows (below the clamp)");
    # slash-command palette matchers
    assert_eq(_buf_has_space("/seams x", 8), 1, "space detected -> command token complete");
    assert_eq(_buf_has_space("/se", 3), 0, "no space -> still typing the token");
    assert_eq(tui_palette_count("/s"), 2, "'/s' matches /seams + /state");
    assert_eq(tui_palette_count("/se"), 1, "'/se' matches /seams only");
    assert_eq(tui_palette_count("/m"), 2, "'/m' matches /model + /models");
    assert_eq(tui_palette_count("/c"), 3, "'/c' matches /call + /clear + /copy");
    assert_eq(tui_palette_count("/co"), 1, "'/co' matches /copy only");
    assert_eq(tui_palette_count("/copy"), 1, "'/copy' matches /copy");
    assert_eq(tui_palette_count("/t"), 2, "'/t' matches /tools + /theme");
    assert_eq(tui_palette_count("/zz"), 0, "no command matches '/zz'");
    led_reset();
    led_feed(KEY_CHAR, 47); led_feed(KEY_CHAR, 115);            # "/s"
    assert_eq(tui_palette_active(), 1, "palette active while typing '/s'");
    led_feed(KEY_CHAR, 32);                                     # "/s "
    assert_eq(tui_palette_active(), 0, "palette closes once a space is typed");
    led_reset();
    led_feed(KEY_CHAR, 104);                                    # "h"
    assert_eq(tui_palette_active(), 0, "palette inactive for non-slash input");
    # multi-line composer (0.11.9): KEY_NEWLINE inserts '\n'; logical-line + cursor geometry.
    led_reset();
    assert_eq(led_lines(), 1, "empty buffer is one logical line");
    led_feed(KEY_CHAR, 97);                                     # "a"
    led_feed(KEY_NEWLINE, 0);                                   # newline
    led_feed(KEY_CHAR, 98); led_feed(KEY_CHAR, 99);            # "bc" -> "a\nbc"
    assert_eq(led_len(), 4, "a + newline + bc = 4 bytes");
    assert_eq(led_lines(), 2, "one newline -> two logical lines");
    assert_eq(led_cursor_line(), 1, "cursor on the second logical line");
    assert_eq(led_cursor_col(), 2, "cursor at column 2 of 'bc'");
    assert_eq(led_line_len(0), 1, "line 0 'a' has length 1");
    assert_eq(led_line_len(1), 2, "line 1 'bc' has length 2");
    assert_eq(led_line_start(1), 2, "line 1 starts after 'a' + newline");
    # Up/Down move between lines (1) and report the top/bottom edge (0) so recall takes over.
    assert_eq(led_up(), 1, "Up moves to the first line");
    assert_eq(led_cursor_line(), 0, "now on line 0");
    assert_eq(led_cursor_col(), 1, "column clamps to line 0's length (1)");
    assert_eq(led_up(), 0, "Up on the first line is an edge");
    assert_eq(led_down(), 1, "Down moves back down a line");
    assert_eq(led_down(), 0, "Down on the last line is an edge");
    led_feed(KEY_KILL, 0);
    assert_eq(led_lines(), 1, "Ctrl-U clears a multi-line buffer to one line");
    # backspace over a newline joins the two logical lines
    led_reset();
    led_feed(KEY_CHAR, 97); led_feed(KEY_NEWLINE, 0); led_feed(KEY_CHAR, 98);   # "a\nb"
    assert_eq(led_lines(), 2, "'a' newline 'b' is two lines");
    led_feed(KEY_LEFT, 0);                                      # cursor between the newline and 'b'
    led_feed(KEY_BACKSPACE, 0);                                 # remove the newline
    assert_eq(led_lines(), 1, "backspace over the newline joins the lines");
    assert(streq(led_buf(), "ab"), "joined buffer is 'ab'");
    # --- composer SOFT-WRAP (0.25.1): a long logical line wraps across physical rows + grows the composer ---
    _tui_cols = 16;                             # avail = cols(16) - 6 = 10 content cols per physical row
    led_reset();
    var wi = 0; while (wi < 25) { led_feed(KEY_CHAR, 120); wi = wi + 1; }   # 25 'x' on ONE logical line
    assert_eq(led_lines(), 1, "soft-wrap: still one LOGICAL line");
    assert_eq(_comp_avail(), 10, "avail = cols(16) - 6");
    assert_eq(_comp_total_rows(), 3, "25 bytes / 10 + 1 = 3 physical rows (the composer grows, no h-scroll)");
    assert_eq(_comp_cursor_prow(), 2, "cursor at col 25 -> physical row 2");
    assert_eq(_comp_prow_to_offset(1, 3), 13, "phys row 1, vcol 3 -> byte offset 13");
    assert_eq(led_up(), 1, "Up moves up one WRAPPED row (not straight to history)");
    assert_eq(led_cur(), 15, "cursor now at offset 15 (row 1, vcol 5)");
    assert_eq(led_up(), 1, "Up again to the top wrapped row");
    assert_eq(led_cur(), 5, "cursor at offset 5 (row 0, vcol 5)");
    assert_eq(led_up(), 0, "Up on the top physical row is an edge (history recall)");
    assert_eq(led_down(), 1, "Down moves back down a wrapped row");
    assert_eq(led_cur(), 15, "cursor back at offset 15");
    led_reset();                                # a wrapped line + a hard newline: rows sum across logical lines
    var wj = 0; while (wj < 15) { led_feed(KEY_CHAR, 97); wj = wj + 1; }    # 15 'a' -> 2 rows
    led_feed(KEY_NEWLINE, 0);
    led_feed(KEY_CHAR, 98);                                                 # 'b' -> 1 row
    assert_eq(led_lines(), 2, "two logical lines");
    assert_eq(_comp_total_rows(), 3, "15-char line (2 rows) + 'b' (1 row) = 3 physical rows");
    _tui_cols = 80;                             # restore width for later tests
    led_reset();
    # a newline in the buffer closes the slash palette (multi-line is never a /command)
    led_reset();
    led_feed(KEY_CHAR, 47); led_feed(KEY_CHAR, 115);           # "/s"
    assert_eq(tui_palette_active(), 1, "palette active for '/s'");
    led_feed(KEY_NEWLINE, 0);                                  # "/s" + newline
    assert_eq(tui_palette_active(), 0, "a newline closes the palette");
    led_reset();

    # key decode (0.11.9): the pure CSI dispatch. Legacy forms keep their meaning; the kitty
    # CSI-u 'u' final maps Shift+Enter -> newline and the Ctrl-combos back to their keys.
    test_group("key decode: CSI + kitty CSI-u (tui.cyr)");
    assert_eq(_tui_csi_final(65, 0, 0 - 1), KEY_UP, "CSI A -> Up");
    assert_eq(_tui_csi_final(66, 0, 0 - 1), KEY_DOWN, "CSI B -> Down");
    assert_eq(_tui_csi_final(67, 0, 0 - 1), KEY_RIGHT, "CSI C -> Right");
    assert_eq(_tui_csi_final(68, 0, 0 - 1), KEY_LEFT, "CSI D -> Left");
    assert_eq(_tui_csi_final(72, 0, 0 - 1), KEY_HOME, "CSI H -> Home");
    assert_eq(_tui_csi_final(70, 0, 0 - 1), KEY_END, "CSI F -> End");
    assert_eq(_tui_csi_final(65, 1, 2), KEY_SCROLL_UP, "CSI 1;2A (Shift+Up, parsed mod 2) -> feed scroll up");
    assert_eq(_tui_csi_final(66, 1, 2), KEY_SCROLL_DOWN, "CSI 1;2B (Shift+Down, parsed mod 2) -> feed scroll down");
    assert_eq(_tui_csi_final(65, 1, 0 - 1), KEY_UP, "CSI A (no modifier) -> plain Up, not scroll");
    assert_eq(_tui_csi_final(126, 5, 0 - 1), KEY_PGUP, "CSI 5~ -> PageUp");
    assert_eq(_tui_csi_final(126, 6, 2), KEY_PGDN, "CSI 6;2~ (parsed mod 2) -> PageDown (modifier ignored)");
    assert_eq(_tui_csi_final(117, 13, 2), KEY_NEWLINE, "CSI 13;2u (Shift+Enter) -> newline");
    assert_eq(_tui_csi_final(117, 13, 0 - 1), KEY_ENTER, "CSI 13u (bare Enter) -> submit");
    assert_eq(_tui_kitty_u(13, 3), KEY_NEWLINE, "kitty Alt+Enter (13;3) -> newline");
    assert_eq(_tui_kitty_u(120, 5), KEY_CTRLC, "kitty Ctrl-X (120;5) -> exit");
    assert_eq(_tui_kitty_u(99, 5), KEY_CTRLC, "kitty Ctrl-C (99;5) -> exit");
    assert_eq(_tui_kitty_u(117, 5), KEY_KILL, "kitty Ctrl-U (117;5) -> kill line");
    assert_eq(_tui_kitty_u(103, 5), KEY_TOGGLE_STATUS, "kitty Ctrl-G (103;5) -> toggle status");
    assert_eq(_tui_kitty_u(98, 5), KEY_TOGGLE_TREE, "kitty Ctrl-B (98;5) -> toggle tree");
    assert_eq(_tui_kitty_u(116, 5), KEY_TOGGLE_THEME, "kitty Ctrl-T (116;5) -> toggle theme");
    assert_eq(_tui_kitty_u(97, 5), KEY_HOME, "kitty Ctrl-A (97;5) -> Home");
    assert_eq(_tui_kitty_u(101, 5), KEY_END, "kitty Ctrl-E (101;5) -> End");
    assert_eq(_tui_kitty_u(27, 0 - 1), KEY_NONE, "kitty Esc (27) -> ignored");
    # bracketed paste (0.17.0): the begin marker ESC[200~ decodes to KEY_PASTE; the end marker
    # ESC[201~ (and any other ~-final) stays KEY_NONE; the legacy 5~/6~ page keys are untouched.
    assert_eq(_tui_csi_final(126, 200, 0 - 1), KEY_PASTE, "CSI 200~ -> paste begin");
    assert_eq(_tui_csi_final(126, 201, 0 - 1), KEY_NONE, "CSI 201~ (paste end) -> ignored");
    assert_eq(_tui_csi_final(126, 5, 0 - 1), KEY_PGUP, "CSI 5~ still PageUp (paste decode didn't shadow it)");

    # led_paste (0.17.0): the PURE paste filter+insert. Newlines collapse to '\n'; a tab becomes
    # one space; ESC and other control bytes are DROPPED (no escape injection); printable text is
    # inserted at the cursor. Build inputs byte-exactly so control bytes are unambiguous.
    test_group("bracketed paste filter (tui.cyr)");
    var pb[16];
    # 1. plain LF multi-line
    led_reset();
    led_paste("a\nb", 3);
    assert(streq(led_buf(), "a\nb"), "LF paste keeps the newline");
    assert_eq(led_len(), 3, "LF paste is 3 bytes");
    assert_eq(led_lines(), 2, "LF paste is two logical lines (does NOT submit)");
    # 2. CRLF collapses to ONE newline
    led_reset();
    store8(&pb + 0, 97); store8(&pb + 1, 13); store8(&pb + 2, 10); store8(&pb + 3, 98);   # a CR LF b
    led_paste(&pb, 4);
    assert(streq(led_buf(), "a\nb"), "CRLF collapses to one newline");
    assert_eq(led_len(), 3, "CRLF paste is 3 bytes, not 4");
    assert_eq(led_lines(), 2, "CRLF paste is two logical lines");
    # 3. lone CR -> newline
    led_reset();
    store8(&pb + 0, 97); store8(&pb + 1, 13); store8(&pb + 2, 98);                          # a CR b
    led_paste(&pb, 3);
    assert(streq(led_buf(), "a\nb"), "lone CR becomes a newline");
    # 4. CR as the FINAL byte (locks the i+1<len source-boundary guard; nit fold)
    led_reset();
    store8(&pb + 0, 97); store8(&pb + 1, 13);                                                # a CR
    led_paste(&pb, 2);
    assert(streq(led_buf(), "a\n"), "trailing lone CR -> a single newline");
    assert_eq(led_lines(), 2, "trailing CR yields two logical lines");
    # 5. control filtering: ESC + BEL dropped; the bytes AFTER an ESC ('[31m') survive as LITERAL
    #    text (proves a paste can't inject a color/escape sequence into the render)
    led_reset();
    store8(&pb + 0, 97); store8(&pb + 1, 27); store8(&pb + 2, 91); store8(&pb + 3, 51);
    store8(&pb + 4, 49); store8(&pb + 5, 109); store8(&pb + 6, 98); store8(&pb + 7, 7);
    store8(&pb + 8, 99);                                                                     # a ESC [ 3 1 m b BEL c
    led_paste(&pb, 9);
    assert(streq(led_buf(), "a[31mbc"), "ESC + BEL dropped; '[31m' survives as literal text");
    assert_eq(led_len(), 7, "9 pasted bytes - 2 controls = 7 kept");
    # 6. DEL (127) dropped
    led_reset();
    store8(&pb + 0, 97); store8(&pb + 1, 127); store8(&pb + 2, 98);                          # a DEL b
    led_paste(&pb, 3);
    assert(streq(led_buf(), "ab"), "DEL (127) dropped");
    # 7. tab -> a single space (composer stays printable)
    led_reset();
    store8(&pb + 0, 9); store8(&pb + 1, 120);                                                # TAB x
    led_paste(&pb, 2);
    assert(streq(led_buf(), " x"), "tab becomes one space");
    assert_eq(load8(led_buf()), 32, "first byte is a space, not a raw tab");
    # 8. paste inserts AT THE CURSOR (not appended)
    led_reset();
    led_feed(KEY_CHAR, 120); led_feed(KEY_CHAR, 121);                                        # "xy"
    led_feed(KEY_LEFT, 0);                                                                    # cursor between x and y
    led_paste("AB", 2);
    assert(streq(led_buf(), "xABy"), "paste inserts at the cursor");
    # 9. a paste larger than the composer cap stops at COMPOSER_CAP-1 (no OOB; excess dropped)
    led_reset();
    var big = alloc(COMPOSER_CAP + 8);
    var bi = 0;
    while (bi < (COMPOSER_CAP + 8)) { store8(big + bi, 97); bi = bi + 1; }                    # all 'a'
    led_paste(big, COMPOSER_CAP + 8);
    assert_eq(led_len(), COMPOSER_CAP - 1, "over-cap paste stops at COMPOSER_CAP-1 (bounded)");
    led_reset();

    # word-wise editing (0.17.1): decode + the pure editor ops. Decode gets the PARSED ints (the
    # 0.11.9 lesson — feed the decoder what the parser emits, not the wire bytes).
    test_group("word-wise editing (tui.cyr)");
    # decode: Ctrl/Alt-arrow word motion (mod param 1+bitmask: Ctrl=5, Alt=3), Ctrl-W, Ctrl-K
    assert_eq(_tui_csi_final(68, 1, 5), KEY_WORD_LEFT, "CSI 1;5D (Ctrl-Left) -> word left");
    assert_eq(_tui_csi_final(67, 1, 5), KEY_WORD_RIGHT, "CSI 1;5C (Ctrl-Right) -> word right");
    assert_eq(_tui_csi_final(68, 1, 3), KEY_WORD_LEFT, "CSI 1;3D (Alt-Left) -> word left");
    assert_eq(_tui_csi_final(67, 1, 3), KEY_WORD_RIGHT, "CSI 1;3C (Alt-Right) -> word right");
    assert_eq(_tui_csi_final(68, 1, 2), KEY_LEFT, "CSI 1;2D (Shift-Left) stays plain Left (no regression)");
    assert_eq(_tui_csi_final(68, 0, 0 - 1), KEY_LEFT, "CSI D (plain Left) stays plain");
    assert_eq(_tui_csi_final(67, 0, 0 - 1), KEY_RIGHT, "CSI C (plain Right) stays plain");
    assert_eq(_tui_kitty_u(119, 5), KEY_DELWORD, "kitty Ctrl-W (119;5) -> delete word");
    assert_eq(_tui_kitty_u(107, 5), KEY_KILL_EOL, "kitty Ctrl-K (107;5) -> kill to EOL");
    assert_eq(_tui_kitty_u(98, 3), KEY_WORD_LEFT, "kitty Alt-b (98;3) -> word left");
    assert_eq(_tui_kitty_u(102, 3), KEY_WORD_RIGHT, "kitty Alt-f (102;3) -> word right");
    assert_eq(_tui_kitty_u(98, 5), KEY_TOGGLE_TREE, "kitty Ctrl-B (98;5) still toggles tree (Alt-b didn't shadow it)");
    # word motion over "foo bar baz" (11 bytes)
    led_reset();
    led_paste("foo bar baz", 11);                        # cursor at end (11)
    led_feed(KEY_WORD_LEFT, 0);
    assert_eq(led_cur(), 8, "word-left -> start of 'baz'");
    led_feed(KEY_WORD_LEFT, 0);
    assert_eq(led_cur(), 4, "word-left -> start of 'bar'");
    led_feed(KEY_WORD_LEFT, 0);
    assert_eq(led_cur(), 0, "word-left -> start of 'foo'");
    led_feed(KEY_WORD_LEFT, 0);
    assert_eq(led_cur(), 0, "word-left at column 0 is a no-op (no OOB read)");
    led_feed(KEY_WORD_RIGHT, 0);
    assert_eq(led_cur(), 3, "word-right -> end of 'foo'");
    led_feed(KEY_WORD_RIGHT, 0);
    assert_eq(led_cur(), 7, "word-right -> end of 'bar'");
    # punctuation is a word char; word-right skips a multi-space run
    led_reset();
    led_paste("a.b   cd", 8);                            # "a.b" + 3 spaces + "cd"
    led_feed(KEY_HOME, 0);
    led_feed(KEY_WORD_RIGHT, 0);
    assert_eq(led_cur(), 3, "'a.b' is one word (punctuation is a word char)");
    led_feed(KEY_WORD_RIGHT, 0);
    assert_eq(led_cur(), 8, "word-right skips the 3-space run to end of 'cd'");
    # Ctrl-W (delete word before cursor)
    led_reset();
    led_paste("foo bar", 7);
    led_feed(KEY_DELWORD, 0);
    assert(streq(led_buf(), "foo "), "Ctrl-W deletes the trailing word 'bar'");
    assert_eq(led_cur(), 4, "cursor at the word start after Ctrl-W");
    led_feed(KEY_DELWORD, 0);
    assert(streq(led_buf(), ""), "Ctrl-W again clears 'foo '");
    # Ctrl-W across a newline -> deletes the word + the newline, joining (reflow case: led_lines drops)
    led_reset();
    led_paste("foo\nbar", 7);
    assert_eq(led_lines(), 2, "'foo\\nbar' is two logical lines");
    led_feed(KEY_LEFT, 0); led_feed(KEY_LEFT, 0); led_feed(KEY_LEFT, 0);   # cursor to index 4 (start of 'bar')
    assert_eq(led_cur(), 4, "cursor at the start of 'bar'");
    led_feed(KEY_DELWORD, 0);
    assert(streq(led_buf(), "bar"), "Ctrl-W across the newline deletes 'foo' + the newline");
    assert_eq(led_lines(), 1, "Ctrl-W across the newline joins to one line");
    # Ctrl-K (kill to end of line) + the buffer-end no-op
    led_reset();
    led_paste("abcd", 4);
    led_feed(KEY_LEFT, 0); led_feed(KEY_LEFT, 0);        # cursor to index 2
    led_feed(KEY_KILL_EOL, 0);
    assert(streq(led_buf(), "ab"), "Ctrl-K kills from the cursor to end of line");
    led_feed(KEY_KILL_EOL, 0);
    assert(streq(led_buf(), "ab"), "Ctrl-K at the buffer end is a no-op");
    # Ctrl-K at end-of-line deletes the newline (join; reflow case)
    led_reset();
    led_paste("ab\ncd", 5);
    led_feed(KEY_LEFT, 0); led_feed(KEY_LEFT, 0); led_feed(KEY_LEFT, 0);   # cursor to index 2 (on the newline)
    assert_eq(led_cur(), 2, "cursor sits on the newline (end of line 0)");
    led_feed(KEY_KILL_EOL, 0);
    assert(streq(led_buf(), "abcd"), "Ctrl-K at end-of-line deletes the newline (join)");
    assert_eq(led_lines(), 1, "the join collapses to one logical line");
    # empty buffer: every word op is a bounds-safe no-op
    led_reset();
    led_feed(KEY_WORD_LEFT, 0);
    assert_eq(led_cur(), 0, "word-left on an empty buffer -> no-op");
    led_feed(KEY_WORD_RIGHT, 0);
    assert_eq(led_cur(), 0, "word-right on an empty buffer -> no-op");
    led_feed(KEY_DELWORD, 0);
    assert_eq(led_len(), 0, "Ctrl-W on an empty buffer -> no-op");
    led_feed(KEY_KILL_EOL, 0);
    assert_eq(led_len(), 0, "Ctrl-K on an empty buffer -> no-op");
    led_reset();

    # SGR mouse (0.17.2): the pure button-code decode. cb = xterm SGR button (low 2 bits = button,
    # bit 5 = motion, bit 6 = wheel); final = 'M'(77) press / 'm'(109) release / 0 = no terminator.
    test_group("SGR mouse decode (tui.cyr)");
    assert_eq(_tui_mouse_decode(64, 77), KEY_SCROLL_UP, "wheel up (cb 64) -> scroll feed back");
    assert_eq(_tui_mouse_decode(65, 77), KEY_SCROLL_DOWN, "wheel down (cb 65) -> scroll feed forward");
    assert_eq(_tui_mouse_decode(68, 77), KEY_SCROLL_UP, "Shift+wheel-up (cb 64+4) still scrolls (modifier ignored)");
    assert_eq(_tui_mouse_decode(66, 77), KEY_NONE, "horizontal wheel-left (cb 66) is ignored (not vertical scroll)");
    assert_eq(_tui_mouse_decode(67, 77), KEY_NONE, "horizontal wheel-right (cb 67) is ignored");
    assert_eq(_tui_mouse_decode(0, 77), KEY_MOUSE, "left-button PRESS -> click");
    assert_eq(_tui_mouse_decode(0, 109), KEY_NONE, "left-button RELEASE ('m') is ignored (click fires once, on press)");
    assert_eq(_tui_mouse_decode(1, 77), KEY_NONE, "middle-button press is ignored");
    assert_eq(_tui_mouse_decode(2, 77), KEY_NONE, "right-button press is ignored");
    assert_eq(_tui_mouse_decode(32, 77), KEY_NONE, "motion (bit 5) is ignored (we don't track drag)");
    assert_eq(_tui_mouse_decode(0, 0), KEY_NONE, "no terminator (EOF/malformed) -> KEY_NONE");
    return 0;
}

# Feed escape-aware clip (0.9.1): paint a stored line into a width-W column
# without severing a CSI / UTF-8 glyph, suppressing ESC[K, never overrunning
# dst_cap, and counting color escapes as zero width. Pure — the load-bearing
# primitive for the self-managed feed (and the 0.9.3 left-column pane).
fn test_feed() {
    test_group("feed escape-aware clip (feed.cyr)");
    feed_init();
    var dst[512];
    var w = feed_clip(&dst, 512, "hello", 5, 3);
    store8(&dst + w, 0);
    assert(streq(&dst, "hel"), "clip 'hello' to 3 cols -> 'hel'");
    assert_eq(w, 3, "wrote 3 bytes for 3 ASCII cols");
    var w0 = feed_clip(&dst, 512, "hi", 2, 80);
    store8(&dst + w0, 0);
    assert(streq(&dst, "hi"), "short line copied whole under a wide column");
    # visible width counts glyphs, never the escapes
    assert_eq(feed_visible_cols("\x1b[33mAB\x1b[0m", 11), 2, "visible cols counts glyphs not escapes");
    assert_eq(feed_visible_cols("plain", 5), 5, "visible cols of plain text");
    # a clipped color span keeps its opening escape + the glyph + a closing reset
    var w1 = feed_clip(&dst, 512, "\x1b[33mAB\x1b[0m", 11, 1);
    assert_eq(w1, 10, "color clip: open escape (5) + 'A' (1) + reset (4)");
    assert_eq(load8(&dst), 27, "clipped row begins with ESC (color preserved)");
    assert_eq(load8(&dst + 5), 65, "the single visible glyph is 'A'");
    assert_eq(load8(&dst + 6), 27, "trailing reset escape follows the glyph");
    # dst_cap is a hard ceiling even with a huge max_cols (no heap overrun)
    var w2 = feed_clip(&dst, 4, "hello", 5, 100);
    assert_eq(w2, 4, "dst_cap=4 clamps output to 4 bytes");
    # ESC[K is dropped (it would erase to the physical eol, scribbling a neighbour)
    var w3 = feed_clip(&dst, 512, "A\x1b[KB", 5, 80);
    store8(&dst + w3, 0);
    assert(streq(&dst, "AB"), "ESC[K dropped from the painted row");
    assert_eq(w3, 2, "ESC[K contributes zero bytes");
    # only a real CSI ESC[...K is suppressed; a 2-byte ESC-K (which untrusted model
    # output could contain) is preserved verbatim, not dropped
    var w3b = feed_clip(&dst, 512, "A\x1bKB", 4, 80);
    assert_eq(w3b, 4, "2-byte ESC-K preserved (only CSI ESC[...K is suppressed)");
    # a color escape after the clip point is copied WHOLE, never severed mid-CSI
    var w4 = feed_clip(&dst, 512, "X\x1b[31mY", 7, 1);
    assert_eq(load8(&dst), 88, "first visible glyph 'X'");
    assert_eq(w4, 6, "'X' + the whole ESC[31m (zero-width), 'Y' clipped");
    # a UTF-8 glyph is one column and is copied as a unit (never half a codepoint)
    var w5 = feed_clip(&dst, 512, "\xc3\xa9z", 3, 1);   # 'e-acute' (2 bytes) + 'z'
    assert_eq(w5, 2, "one UTF-8 glyph = one col, copied whole; 'z' clipped");
    assert_eq(load8(&dst), 195, "UTF-8 lead byte copied");
    assert_eq(load8(&dst + 1), 169, "UTF-8 continuation copied (glyph not severed)");
    return 0;
}

# Feed ring (0.9.1): feed_write accumulates a logical line across calls, seals a
# slot per newline (the '\n' itself not stored), seals a bare newline as a blank
# row, flushes an un-newlined tail, and evicts the oldest line in O(1) when the
# ring fills. Row 0 = the oldest LIVE line.
fn test_feed_ring() {
    test_group("feed ring buffer (feed.cyr)");
    feed_init();
    assert_eq(feed_count(), 0, "empty ring");
    feed_write("a", 1);
    feed_write("b", 1);
    assert_eq(feed_count(), 0, "no newline yet -> nothing sealed");
    feed_write("\n", 1);
    assert_eq(feed_count(), 1, "newline seals one slot");
    assert_eq(feed_line_len(0), 2, "sealed slot holds 2 bytes");
    var p = feed_line_ptr(0);
    assert_eq(load8(p), 97, "first byte 'a'");
    assert_eq(load8(p + 1), 98, "second byte 'b' (multi-call line reconstructed)");
    assert_eq(feed_vis(0), 2, "cached visible cols = 2");
    feed_write("\n", 1);
    assert_eq(feed_count(), 2, "bare newline yields a blank row");
    assert_eq(feed_line_len(1), 0, "blank row has zero length");
    feed_write("tail", 4);
    feed_flush_pending();
    assert_eq(feed_count(), 3, "flush seals the un-newlined tail");
    assert_eq(feed_line_len(2), 4, "tail row holds 4 bytes");
    # eviction: write FEED_ROWS+3 distinct lines; count caps, the oldest 3 drop.
    feed_init();
    var ch[2];
    store8(&ch + 1, 10);                       # trailing newline (constant)
    var i = 0;
    while (i < (FEED_ROWS + 3)) {
        store8(&ch, 65 + (i % 26));            # 'A'..'Z' cycling
        feed_write(&ch, 2);
        i = i + 1;
    }
    assert_eq(feed_count(), FEED_ROWS, "ring caps at FEED_ROWS lines");
    # the 4th line written (index 3) is the oldest survivor: 'A' + (3%26) = 'D'.
    assert_eq(load8(feed_line_ptr(0)), 68, "oldest surviving line is the 4th written (O(1) head-advance eviction)");
    # feed_clear empties the ring (the /clear command + per-session reset)
    feed_scroll_set(5);
    feed_clear();
    assert_eq(feed_count(), 0, "feed_clear empties the ring");
    assert_eq(feed_scroll(), 0, "feed_clear resets the scroll offset");
    return 0;
}

# Soft-wrap (0.11.3): feed_rows_for (physical rows a logical line occupies at a
# column width), feed_clip_seg (paint a visible-column WINDOW of a line, carrying
# SGR color across the wrap boundary), and _feed_total_phys (the document's
# soft-wrapped physical height — the painter's scroll oracle). All PURE; the painter
# itself (feed_repaint) is TUI-only and verifies on a real tty.
fn test_softwrap() {
    test_group("soft-wrap (feed.cyr): rows_for / clip_seg / total_phys");
    # feed_rows_for: ceil(vis/width), blank = 1 row, width clamped >= 1.
    assert_eq(feed_rows_for(0, 80), 1, "blank line (vis 0) is one row");
    assert_eq(feed_rows_for(5, 80), 1, "narrow line is one row");
    assert_eq(feed_rows_for(80, 80), 1, "exactly-full line is one row");
    assert_eq(feed_rows_for(81, 80), 2, "one col over wraps to two rows");
    assert_eq(feed_rows_for(160, 80), 2, "exactly two rows");
    assert_eq(feed_rows_for(161, 80), 3, "one over two rows -> three");
    assert_eq(feed_rows_for(10, 1), 10, "width 1: one row per glyph");
    assert_eq(feed_rows_for(7, 0), 7, "width < 1 clamps to 1 (no div-by-zero)");

    var dst[512];
    # the window: skip_cols glyphs, then up to max_cols.
    var w = feed_clip_seg(&dst, 512, "abcdef", 6, 0, 3);
    store8(&dst + w, 0);
    assert(streq(&dst, "abc"), "seg [0,3) of 'abcdef' -> 'abc'");
    assert_eq(w, 3, "first segment wrote 3 bytes");
    var w2 = feed_clip_seg(&dst, 512, "abcdef", 6, 3, 3);
    store8(&dst + w2, 0);
    assert(streq(&dst, "def"), "seg [3,6) of 'abcdef' -> 'def'");
    var w3 = feed_clip_seg(&dst, 512, "abcdef", 6, 3, 10);
    store8(&dst + w3, 0);
    assert(streq(&dst, "def"), "last segment: only the remaining glyphs");
    assert_eq(w3, 3, "remaining-glyph segment wrote 3 bytes");
    # a segment whose skip is at/past the line's glyphs paints nothing.
    assert_eq(feed_clip_seg(&dst, 512, "abc", 3, 3, 3), 0, "skip past end -> empty segment");

    # SGR continuity: an amber span split across a wrap. (The harness default tier is
    # PT_PLAIN, so the DEFENSIVE close ui_reset() is the empty string here — exactly as
    # the existing test_feed assumes; the forced-PT_ANSI block below proves the real
    # close. The CARRY re-emission uses the SOURCE's real escape bytes, so it is present
    # at every tier and is the soft-wrap-specific behaviour under test.)
    var ws0 = feed_clip_seg(&dst, 512, "\x1b[33mabcdef\x1b[0m", 15, 0, 3);
    assert_eq(load8(&dst), 27, "seg0 starts with the color escape");
    assert_eq(load8(&dst + 5), 97, "seg0 glyph 'a' after ESC[33m");
    assert_eq(ws0, 8, "seg0 = ESC[33m(5)+abc(3); defensive reset is empty at PT_PLAIN");
    var ws1 = feed_clip_seg(&dst, 512, "\x1b[33mabcdef\x1b[0m", 15, 3, 3);
    assert_eq(load8(&dst), 27, "seg1 RE-EMITS the carried color before its first glyph");
    assert_eq(load8(&dst + 5), 100, "seg1 paints 'd' under the carried color");
    assert_eq(ws1, 8, "seg1 = carried ESC[33m(5)+def(3)");

    # a reset DURING the skip region clears the carry -> the segment is uncolored.
    var wr = feed_clip_seg(&dst, 512, "\x1b[33mab\x1b[0mcdef", 15, 3, 3);
    assert_eq(load8(&dst), 100, "carry cleared by a skipped reset -> seg starts at 'd' uncolored");
    assert_eq(wr, 3, "uncolored segment is just its 3 glyphs");

    # cumulative SGR (bold THEN color) is carried WHOLE across the wrap.
    var wc = feed_clip_seg(&dst, 512, "\x1b[1m\x1b[33mabcd", 13, 2, 2);
    assert_eq(load8(&dst), 27, "cumulative carry begins with ESC");
    assert_eq(load8(&dst + 9), 99, "both carried SGRs (ESC[1m + ESC[33m = 9 bytes) precede 'c'");
    assert_eq(wc, 11, "wc = carry(9) + 'cd'(2); defensive reset empty at PT_PLAIN");

    # forced PT_ANSI: prove the defensive close emits the REAL reset bytes (the
    # production path — the TUI runs at PT_RICH). Restore PT_PLAIN for later tests.
    ui_force(PT_ANSI, CD_TRUE);
    var rl = strlen(ui_reset());
    var wa = feed_clip_seg(&dst, 512, "\x1b[33mabcdef", 11, 0, 3);   # leaves a span open at the clip
    assert(rl > 0, "PT_ANSI: ui_reset() is non-empty");
    assert_eq(wa, 8 + rl, "PT_ANSI: open span closed with ui_reset()");
    assert_eq(load8(&dst + 8), 27, "PT_ANSI: the defensive reset is a real ESC sequence");
    ui_force(PT_PLAIN, CD_NONE);

    # ESC[...K is suppressed in a painted segment (would scribble a neighbour column),
    # both when it lands in the window and when it lands in the skip region. The
    # source "ab\x1b[Kcd" is 7 bytes (a,b,ESC,[,K,c,d).
    var wk = feed_clip_seg(&dst, 512, "ab\x1b[Kcd", 7, 0, 4);
    store8(&dst + wk, 0);
    assert(streq(&dst, "abcd"), "ESC[K dropped within the window");
    var wk2 = feed_clip_seg(&dst, 512, "ab\x1b[Kcd", 7, 2, 2);
    store8(&dst + wk2, 0);
    assert(streq(&dst, "cd"), "ESC[K dropped across the skip boundary too");

    # dst_cap is a hard ceiling even with a huge max_cols.
    assert_eq(feed_clip_seg(&dst, 4, "abcdef", 6, 0, 100), 4, "dst_cap clamps the segment");
    # an empty window (max_cols 0) paints NOTHING — not even the boundary glyph.
    assert_eq(feed_clip_seg(&dst, 512, "abcdef", 6, 2, 0), 0, "empty window (max_cols 0) writes 0 bytes");
    # the carry flushes WHOLE-or-drop: a dst_cap too small for the 5-byte ESC[33m
    # carry drops it ENTIRE (never a severed CSI) and paints the glyphs uncolored.
    var wd = feed_clip_seg(&dst, 3, "\x1b[33mabcdef", 11, 2, 2);
    assert_eq(wd, 2, "carry dropped whole -> just the 2 window glyphs fit");
    assert_eq(load8(&dst), 99, "no partial escape: row starts at the glyph 'c', not ESC");

    # a UTF-8 glyph is one column and is never split by the skip boundary.
    var wu = feed_clip_seg(&dst, 512, "\xc3\xa9z", 3, 0, 1);   # 'e-acute'(2 bytes) + 'z'
    assert_eq(wu, 2, "skip 0: one UTF-8 glyph (2 bytes) = one column");
    assert_eq(load8(&dst), 195, "UTF-8 lead byte painted whole");
    var wu2 = feed_clip_seg(&dst, 512, "\xc3\xa9z", 3, 1, 1);
    store8(&dst + wu2, 0);
    assert(streq(&dst, "z"), "skip 1 skips the whole multibyte glyph, paints 'z'");

    # _feed_total_phys: the soft-wrapped height of the whole document at a width.
    feed_init();
    feed_write("abcdefgh\n", 9);                  # 8 visible cols
    assert_eq(_feed_total_phys(3), 3, "8-col line is 3 rows at width 3");
    assert_eq(_feed_total_phys(80), 1, "8-col line is 1 row at width 80");
    feed_write("\n", 1);                          # a blank row
    assert_eq(_feed_total_phys(3), 4, "blank line adds one physical row");
    feed_write("xyz", 3);                         # an un-newlined pending line (3 cols)
    assert_eq(_feed_total_phys(3), 5, "pending 'xyz' adds 1 row at width 3");
    assert_eq(_feed_total_phys(2), 7, "at width 2: 4 + 1 (blank) + 2 (pending) physical rows");
    return 0;
}

# glyph-width table (0.18.7): East-Asian Wide/Fullwidth + emoji count 2 display columns, combining/ZW
# marks count 0 — so soft-wrap + scrollback math no longer undercount a CJK/emoji line (0.11.3 residual).
# All feed col-counters (feed_visible_cols / feed_clip / feed_clip_seg) share feed_glyph_cols so
# feed_rows_for = ceil(display-cols / width) stays consistent. ASCII is byte-identical (width 1).
fn test_glyph_width() {
    test_group("glyph width table (feed.cyr, 0.18.7)");
    var buf[32];
    store8(&buf, 97);
    assert_eq(feed_glyph_cols(&buf, 0, 1), 1, "ASCII is 1 col");
    store8(&buf, 227); store8(&buf + 1, 129); store8(&buf + 2, 130);          # あ U+3042
    assert_eq(feed_glyph_cols(&buf, 0, 3), 2, "Hiragana あ is 2 cols");
    store8(&buf, 228); store8(&buf + 1, 184); store8(&buf + 2, 128);          # 一 U+4E00
    assert_eq(feed_glyph_cols(&buf, 0, 3), 2, "CJK 一 is 2 cols");
    store8(&buf, 239); store8(&buf + 1, 188); store8(&buf + 2, 161);          # Ａ U+FF21 fullwidth
    assert_eq(feed_glyph_cols(&buf, 0, 3), 2, "fullwidth Ａ is 2 cols");
    store8(&buf, 226); store8(&buf + 1, 156); store8(&buf + 2, 133);          # ✅ U+2705 (dingbat emoji)
    assert_eq(feed_glyph_cols(&buf, 0, 3), 2, "emoji ✅ (U+2705) is 2 cols");
    store8(&buf, 240); store8(&buf + 1, 159); store8(&buf + 2, 152); store8(&buf + 3, 128);   # 😀 U+1F600
    assert_eq(feed_glyph_cols(&buf, 0, 4), 2, "emoji 😀 (plane 1) is 2 cols");
    store8(&buf, 204); store8(&buf + 1, 129);                                 # combining acute U+0301
    assert_eq(feed_glyph_cols(&buf, 0, 2), 0, "combining mark is 0 cols");
    store8(&buf, 239); store8(&buf + 1, 184); store8(&buf + 2, 143);          # variation selector U+FE0F
    assert_eq(feed_glyph_cols(&buf, 0, 3), 0, "variation selector is 0 cols");

    # feed_visible_cols sums widths: "a" + あ + "b" = 1 + 2 + 1 = 4
    var line[16];
    store8(&line, 97);
    store8(&line + 1, 227); store8(&line + 2, 129); store8(&line + 3, 130);
    store8(&line + 4, 98);
    assert_eq(feed_visible_cols(&line, 5), 4, "visible cols counts あ as 2 (a+あ+b = 4)");
    assert_eq(feed_rows_for(feed_visible_cols(&line, 5), 3), 2, "the wide line wraps to 2 rows at width 3 (was 1 pre-0.18.7)");

    # feed_clip (tree column) refuses a straddling wide glyph rather than bleeding into the feed pane:
    # "ああ" (2 cols each) at max_cols 3 keeps one あ; the second would need cols 2-3 (>3) so it's dropped.
    var two[16];
    store8(&two, 227); store8(&two + 1, 129); store8(&two + 2, 130);
    store8(&two + 3, 227); store8(&two + 4, 129); store8(&two + 5, 130);
    var cd[64];
    var cw = feed_clip(&cd, 64, &two, 6, 3);
    assert_eq(feed_visible_cols(&cd, cw), 2, "feed_clip at width 3 keeps one あ (2 cols), refuses the straddler");
    # strict left-to-right: a refused wide LEADER truncates the rest — a later narrow glyph must NOT slip
    # into the freed column ahead of it. "あa" at max_cols 1 -> empty (was: would paint "a" out of order).
    var mix[8];
    store8(&mix, 227); store8(&mix + 1, 129); store8(&mix + 2, 130);
    store8(&mix + 3, 97);
    var md[32];
    var mwn = feed_clip(&md, 32, &mix, 4, 1);
    assert_eq(feed_visible_cols(&md, mwn), 0, "feed_clip: a refused wide leader truncates strictly (no later 'a' swap-in)");

    # feed_clip_seg (feed): "ああa" (2+2+1 = 5 cols) at width 4 -> seg0 = cols[0,4) = ああ, seg1 = cols[4,8) = a
    var wl[16];
    store8(&wl, 227); store8(&wl + 1, 129); store8(&wl + 2, 130);
    store8(&wl + 3, 227); store8(&wl + 4, 129); store8(&wl + 5, 130);
    store8(&wl + 6, 97);
    var s0[64]; var s0n = feed_clip_seg(&s0, 64, &wl, 7, 0, 4);
    assert_eq(feed_visible_cols(&s0, s0n), 4, "segment 0 holds both あ (4 cols)");
    var s1[64]; var s1n = feed_clip_seg(&s1, 64, &wl, 7, 4, 4);
    var s1v[32]; _t_strip_sgr(&s1v, &s1, s1n);
    assert(streq(&s1v, "a"), "segment 1 holds the trailing 'a'");
    return 0;
}

# Output capture (0.9.1): with OUT_RING armed, emit/emit_n/oprintln/ofmt_int route
# into the feed ring (not fd 1); a logical line assembled across mixed calls lands
# as ONE row, and ofmt_int captures the same digits fmt_int would print. NOTE:
# always restore OUT_FD1 before asserting — an assert under OUT_RING would be
# captured into the ring instead of printed.
fn test_capture() {
    test_group("output capture sink (util.cyr / feed.cyr)");
    feed_init();
    assert_eq(out_mode(), OUT_FD1, "default mode is OUT_FD1 (the floor)");
    out_mode_set(OUT_RING);
    emit("a"); emit_n("bc", 2); oprintln("d");     # one logical line across 3 calls
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 1, "emit + emit_n + oprintln reconstruct one captured line");
    assert_eq(feed_line_len(0), 4, "captured line is 'abcd' (4 bytes)");
    var p = feed_line_ptr(0);
    assert_eq(load8(p), 97, "byte 0 'a' (emit)");
    assert_eq(load8(p + 1), 98, "byte 1 'b' (emit_n)");
    assert_eq(load8(p + 3), 100, "byte 3 'd' (oprintln, before its newline seal)");
    # ofmt_int captures the same bytes fmt_int prints (incl. zero + negatives)
    feed_init();
    out_mode_set(OUT_RING);
    ofmt_int(0); oprintln("");                      # "0" then a newline seals the row
    ofmt_int(0 - 42);                               # "-42" left pending
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 2, "two captured rows");
    assert_eq(feed_line_len(0), 1, "ofmt_int(0) captured as '0'");
    assert_eq(load8(feed_line_ptr(0)), 48, "the digit '0'");
    assert_eq(feed_line_len(1), 3, "ofmt_int(-42) captured as '-42'");
    assert_eq(load8(feed_line_ptr(1)), 45, "leading '-' preserved");
    return 0;
}

# --- mdhl (0.15.1) test helpers -------------------------------------------
# _t_has_esc: 1 if src[0..len) contains an ESC (0x1b) byte.
fn _t_has_esc(ptr, len) {
    var i = 0;
    while (i < len) {
        if (load8(ptr + i) == 27) { return 1; }
        i = i + 1;
    }
    return 0;
}
# _t_strip_sgr: copy src[0..len) into dst, dropping whole ESC sequences (reusing the
# feed's escape-length scanner); nul-terminate. Recovers the visible text so a coverage
# check (strip_sgr(output) == input) proves _hl_span never dropped/reordered a byte.
fn _t_strip_sgr(dst, src, len) {
    var i = 0;
    var w = 0;
    while (i < len) {
        if (load8(src + i) == 27) { i = i + _feed_esc_len(src, i, len); }
        else { store8(dst + w, load8(src + i)); w = w + 1; i = i + 1; }
    }
    store8(dst + w, 0);
    return w;
}
# _t_count_sub: number of (possibly overlapping) occurrences of needle[0..m) in hay[0..n).
fn _t_count_sub(hay, n, needle, m) {
    if (m <= 0) { return 0; }
    var i = 0;
    var c = 0;
    while ((i + m) <= n) {
        var k = 0;
        var eq = 1;
        while ((k < m) && (eq == 1)) { if (load8(hay + i + k) != load8(needle + k)) { eq = 0; } k = k + 1; }
        if (eq == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
# re-renderable feed (0.18.0): the ring stores role MARKERS (reverse-mapped at seal); the painter
# EXPANDS them to the current theme's concrete SGR — byte-identical output now, recolorable later.
fn test_feed_markers() {
    test_group("re-renderable feed: role markers (feed.cyr, 0.18.0)");
    ui_force(PT_ANSI, CD_TRUE);
    # reverse-map exactness: a role SGR -> its role; reset -> UI_SGR_RESET; ui_reset_fg (ESC[39m) -> -1
    var g = ui_sgr(ROLE_GREEN);
    assert_eq(ui_role_of_sgr(g, 0, strlen(g)), ROLE_GREEN, "role SGR reverse-maps to its role");
    var rs = ui_reset();
    assert_eq(ui_role_of_sgr(rs, 0, strlen(rs)), UI_SGR_RESET, "reset SGR -> UI_SGR_RESET");
    var rf = ui_reset_fg();
    assert_eq(ui_role_of_sgr(rf, 0, strlen(rf)), 0 - 1, "ui_reset_fg (ESC[39m) is NOT role/reset -> verbatim");
    # packing: a ui_emit line stores a 2-byte MARKER, not the concrete SGR; visible-cols unchanged
    feed_init();
    out_mode_set(OUT_RING);
    ui_emit(ROLE_GREEN, "ok");
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 1, "one line sealed");
    assert_eq(feed_vis(0), 2, "visible cols = 2 (markers are zero-width)");
    var sp = feed_line_ptr(0);
    assert_eq(load8(sp), 27, "slot starts with ESC (a marker)");
    assert_eq(load8(sp + 1), FEED_MARK_ROLE0 + ROLE_GREEN, "green role stored as its 2-byte marker");
    # BYTE-IDENTICAL: painting the marker slot reproduces the concrete SGR output exactly
    var pd[512];
    var pw = feed_clip(&pd, 512, sp, feed_line_len(0), 40);
    store8(&pd + pw, 0);
    var gold[512];
    var go = 0;
    go = _ftree_append_cstr(&gold, go, 512, ui_sgr(ROLE_GREEN));
    go = _ftree_append_cstr(&gold, go, 512, "ok");
    go = _ftree_append_cstr(&gold, go, 512, ui_reset());
    store8(&gold + go, 0);
    assert(streq(&pd, &gold), "painted markers == concrete SGR golden (BYTE-IDENTICAL)");
    # BYTE-IDENTICAL via feed_clip_seg — the REAL paint path (feed_repaint paints only through _seg);
    # skip 0 over a fitting line must equal the same concrete golden.
    var ps[512];
    var psw = feed_clip_seg(&ps, 512, sp, feed_line_len(0), 0, 40);
    store8(&ps + psw, 0);
    assert(streq(&ps, &gold), "feed_clip_seg (the real paint path) markers == concrete golden (BYTE-IDENTICAL)");
    # sanitizer: a raw ESC + marker-range byte in captured content is neutralized (no forged marker)
    feed_init();
    out_mode_set(OUT_RING);
    var raw[8];
    store8(&raw + 0, 27); store8(&raw + 1, FEED_MARK_ROLE0); store8(&raw + 2, 120);   # ESC 0xB0 'x'
    feed_write(&raw, 3);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert(load8(feed_line_ptr(0)) != 27, "sanitizer dropped the raw ESC before a marker-range byte");
    # a non-role escape (ESC[1m bold) passes through verbatim (stored + painted as-is)
    feed_init();
    out_mode_set(OUT_RING);
    var bold[8];
    store8(&bold + 0, 27); store8(&bold + 1, 91); store8(&bold + 2, 49); store8(&bold + 3, 109); store8(&bold + 4, 120);   # ESC [ 1 m x
    feed_write(&bold, 5);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(load8(feed_line_ptr(0)), 27, "non-role ESC[1m stored verbatim (ESC kept)");
    assert_eq(load8(feed_line_ptr(0) + 2), 49, "ESC[1m intact ('1')");
    # soft-wrap: color continues across a segment boundary via the carry (markers)
    feed_init();
    out_mode_set(OUT_RING);
    ui_emit(ROLE_GREEN, "aaaaaa");
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    var seg[512];
    var sw = feed_clip_seg(&seg, 512, feed_line_ptr(0), feed_line_len(0), 3, 3);   # cols [3,6)
    var strip[64];
    _t_strip_sgr(&strip, &seg, sw);
    assert(streq(&strip, "aaa"), "soft-wrap segment 1 has the 3 wrapped glyphs");
    assert_eq(load8(&seg), 27, "segment 1 starts with the carried color (an SGR)");
    assert_eq(_t_has_esc(&seg, sw), 1, "segment 1 carries the color across the wrap");
    # theme-recolor (0.18.1): the SAME stored marker slot repaints with a DIFFERENT theme's SGR — so
    # /theme (and ⌃T) recolor scrollback; the 0.10.0 baked-color limitation is gone. Store once; paint
    # under dark, then light, from the identical slot.
    feed_init();
    out_mode_set(OUT_RING);
    ui_emit(ROLE_GREEN, "hi");
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    var spr = feed_line_ptr(0);
    var lenr = feed_line_len(0);
    ui_set_theme(THEME_DARK);
    var da[256];
    var daw = feed_clip(&da, 256, spr, lenr, 40); store8(&da + daw, 0);
    ui_set_theme(THEME_LIGHT);
    var li[256];
    var liw = feed_clip(&li, 256, spr, lenr, 40); store8(&li + liw, 0);
    ui_set_theme(THEME_DARK);   # restore the default theme for subsequent tests
    assert_eq(streq(&da, &li), 0, "the same slot paints DIFFERENT SGR under dark vs light (scrollback recolors)");
    var sda[64];
    var sli[64];
    _t_strip_sgr(&sda, &da, daw);
    _t_strip_sgr(&sli, &li, liw);
    assert(streq(&sda, "hi"), "dark paint text is 'hi'");
    assert(streq(&sli, "hi"), "light paint text is 'hi' (only the SGR changed, not the text)");
    assert_eq(_t_has_esc(&da, daw), 1, "dark paint is colored");
    assert_eq(_t_has_esc(&li, liw), 1, "light paint is colored");
    ui_force(PT_PLAIN, CD_NONE);   # restore the floor tier for subsequent tests
    return 0;
}

# _t_mdhl_line: populate the mdhl line buffer for the pure fence-scan tests.
fn _t_mdhl_line(s) {
    _mdhl_ensure();
    var n = strlen(s);
    var i = 0;
    while (i < n) { store8(_mdhl_line + i, load8(s + i)); i = i + 1; }
    _mdhl_line_len = n;
    return 0;
}

# mdhl (0.15.1): the fence-tag -> grammar mapping is PURE.
fn test_mdhl_tag_map() {
    test_group("markdown fence tag -> grammar (mdhl.cyr)");
    assert(streq(_mdhl_tag_grammar("bash"), "shell"), "bash -> shell");
    assert(streq(_mdhl_tag_grammar("sh"), "shell"), "sh -> shell");
    assert(streq(_mdhl_tag_grammar("py"), "python"), "py -> python");
    assert(streq(_mdhl_tag_grammar("js"), "javascript"), "js -> javascript");
    assert(streq(_mdhl_tag_grammar("ts"), "typescript"), "ts -> typescript");
    assert(streq(_mdhl_tag_grammar("rs"), "rust"), "rs -> rust");
    assert(streq(_mdhl_tag_grammar("c++"), "cpp"), "c++ -> cpp");
    assert(streq(_mdhl_tag_grammar("yml"), "yaml"), "yml -> yaml");
    assert(streq(_mdhl_tag_grammar("python"), "python"), "canonical name falls through");
    assert(streq(_mdhl_tag_grammar("wibble"), "wibble"), "unknown tag falls through to itself (_hl_span self-heals)");
    assert_eq(_mdhl_tag_grammar("text"), 0, "text -> 0 (deliberate no-highlight)");
    assert_eq(_mdhl_tag_grammar("plain"), 0, "plain -> 0");
    assert_eq(_mdhl_tag_grammar("diff"), 0, "diff -> 0 (never a grammar)");
    return 0;
}

# mdhl (0.15.1): the fence open/close scanners + info-string resolution are PURE over
# the assembled line buffer.
fn test_mdhl_fence() {
    test_group("markdown fence scan + info string (mdhl.cyr)");
    _mdhl_ensure();
    _t_mdhl_line("```python");
    assert_eq(_mdhl_scan_fence_open(), 1, "```python opens");
    assert_eq(_mdhl_fence_ch, 96, "opening fence char is backtick");
    assert_eq(_mdhl_fence_len, 3, "run length 3");
    _t_mdhl_line("~~~c");
    assert_eq(_mdhl_scan_fence_open(), 1, "~~~c opens");
    assert_eq(_mdhl_fence_ch, 126, "opening fence char is tilde");
    _t_mdhl_line("``x");
    assert_eq(_mdhl_scan_fence_open(), 0, "two backticks (run<3) is not a fence");
    _t_mdhl_line("    ```py");
    assert_eq(_mdhl_scan_fence_open(), 0, "4-space indent is indented-code, not a fence");
    _t_mdhl_line("   ```py");
    assert_eq(_mdhl_scan_fence_open(), 1, "3-space indent still opens");
    _t_mdhl_line("```foo`bar");
    assert_eq(_mdhl_scan_fence_open(), 0, "backtick in info string rejects the open (inline-code guard)");
    # info-string resolution
    _t_mdhl_line("```python {.line-numbers}");
    _mdhl_scan_fence_open(); _mdhl_resolve_grammar();
    assert(streq(_mdhl_grammar, "python"), "first info word is the tag; the rest is ignored");
    _t_mdhl_line("```BASH");
    _mdhl_scan_fence_open(); _mdhl_resolve_grammar();
    assert(streq(_mdhl_grammar, "shell"), "tag is ASCII-lowercased before mapping");
    _t_mdhl_line("```");
    _mdhl_scan_fence_open(); _mdhl_resolve_grammar();
    assert_eq(_mdhl_grammar, 0, "blank info -> no grammar (verbatim)");
    # closes (against a backtick/3 opener)
    _mdhl_fence_ch = 96; _mdhl_fence_len = 3;
    _t_mdhl_line("```");
    assert_eq(_mdhl_scan_fence_close(), 1, "``` closes a ``` block");
    _t_mdhl_line("````");
    assert_eq(_mdhl_scan_fence_close(), 1, "a longer run also closes");
    _t_mdhl_line("``");
    assert_eq(_mdhl_scan_fence_close(), 0, "a shorter run is interior");
    _t_mdhl_line("```bogus");
    assert_eq(_mdhl_scan_fence_close(), 0, "a close carries no info string");
    _t_mdhl_line("~~~");
    assert_eq(_mdhl_scan_fence_close(), 0, "a tilde line does not close a backtick block");
    _t_mdhl_line("```  ");
    assert_eq(_mdhl_scan_fence_close(), 1, "trailing spaces still close");
    _t_mdhl_line("```\r");
    assert_eq(_mdhl_scan_fence_close(), 1, "a CRLF closing fence (```\\r) closes (CR is blank)");
    return 0;
}

# mdhl (0.15.1): the end-to-end render, captured via OUT_RING. Proves the FLOOR
# (PT_PLAIN -> byte-identical, zero escapes), that a fenced block is highlighted while
# delimiters stay verbatim, and that stripping SGR recovers the code exactly (coverage).
fn test_mdhl_render() {
    test_group("markdown fenced-code render (mdhl.cyr)");
    var sb[256];
    var src = "```python\nimport os\n```\n";
    # FLOOR: PT_PLAIN -> verbatim, no escapes anywhere
    ui_force(PT_PLAIN, CD_NONE);
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reply(src, strlen(src));
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "PT_PLAIN: 3 lines (opener/code/closer)");
    assert_eq(_t_has_esc(feed_line_ptr(0), feed_line_len(0)), 0, "PT_PLAIN opener: 0 escapes");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 0, "PT_PLAIN code line: 0 escapes (floor)");
    assert_eq(_t_has_esc(feed_line_ptr(2), feed_line_len(2)), 0, "PT_PLAIN closer: 0 escapes");
    _t_strip_sgr(&sb, feed_line_ptr(1), feed_line_len(1));
    assert(streq(&sb, "import os"), "PT_PLAIN code line is verbatim 'import os'");
    # HIGHLIGHT: PT_ANSI -> code colored, delimiters verbatim, coverage holds
    ui_force(PT_ANSI, CD_TRUE);
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reply(src, strlen(src));
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "PT_ANSI: still 3 lines");
    assert_eq(_t_has_esc(feed_line_ptr(0), feed_line_len(0)), 0, "opener ```python stays verbatim");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 1, "code line IS highlighted (has SGR)");
    assert_eq(_t_has_esc(feed_line_ptr(2), feed_line_len(2)), 0, "closer ``` stays verbatim");
    _t_strip_sgr(&sb, feed_line_ptr(1), feed_line_len(1));
    assert(streq(&sb, "import os"), "stripping SGR recovers the code exactly (never drops a byte)");
    # unknown language -> self-heal to verbatim, no escapes, no byte lost
    var srcu = "```wibble\nzz\n```\n";
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reply(srcu, strlen(srcu));
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "unknown lang: 3 lines");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 0, "unknown grammar -> code verbatim (uncolored)");
    _t_strip_sgr(&sb, feed_line_ptr(1), feed_line_len(1));
    assert(streq(&sb, "zz"), "unknown-lang code preserved");
    ui_force(PT_PLAIN, CD_NONE);
    return 0;
}

# mdhl (0.15.1): streaming — a byte-at-a-time feed produces the same result as one-shot
# (chunk boundaries dissolved), and an unterminated fence flushes at finish with no
# phantom closer.
fn test_mdhl_stream() {
    test_group("markdown fenced-code streaming (mdhl.cyr)");
    var sb[256];
    ui_force(PT_ANSI, CD_TRUE);
    var src = "```python\nimport os\n```\n";
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reset();
    var i = 0;
    var ln = strlen(src);
    while (i < ln) { mdhl_feed(src + i, 1); i = i + 1; }   # one byte per chunk
    mdhl_finish();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "byte-split stream: still 3 lines (chunk boundaries dissolved)");
    assert_eq(_t_has_esc(feed_line_ptr(0), feed_line_len(0)), 0, "split: opener verbatim");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 1, "split: code line highlighted");
    _t_strip_sgr(&sb, feed_line_ptr(1), feed_line_len(1));
    assert(streq(&sb, "import os"), "split: code recovered exactly");
    # unterminated fence -> flush at finish, no phantom closer
    var srcu = "```python\nimport os\n";
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reset();
    mdhl_feed(srcu, strlen(srcu));
    mdhl_finish();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 2, "unterminated: opener + highlighted interior, NO phantom closer");
    assert_eq(_t_has_esc(feed_line_ptr(0), feed_line_len(0)), 0, "unterminated: opener verbatim");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 1, "unterminated: interior highlighted at finish");
    ui_force(PT_PLAIN, CD_NONE);
    return 0;
}

# live fenced-code card (0.18.3): stream interior lines LIVE, then DROP + re-emit highlighted at fence
# close (TUI / OUT_RING only). Net final feed state == the highlighted block (live rows are transient).
fn test_mdhl_livecard() {
    test_group("live fenced-code card (mdhl.cyr / feed.cyr, 0.18.3)");
    # feed_drop_last / feed_drop_pending primitives
    feed_init();
    feed_write("a\nb\nc\n", 6);
    assert_eq(feed_count(), 3, "three rows sealed");
    feed_drop_last(2);
    assert_eq(feed_count(), 1, "feed_drop_last(2) -> 1 row");
    feed_drop_last(9);
    assert_eq(feed_count(), 0, "feed_drop_last over-count clamps to 0");
    feed_init();
    feed_write("partial", 7);
    assert(feed_pending_len() > 0, "an un-newlined line is pending");
    feed_drop_pending();
    assert_eq(feed_pending_len(), 0, "feed_drop_pending discards the un-sealed line");

    ui_force(PT_ANSI, CD_TRUE);
    # (1) well-formed block, streamed in chunks that split every token/delimiter: the final feed rows are
    # [opener verbatim, interior HIGHLIGHTED, closer verbatim] with EXACTLY 3 rows (no leftover live rows).
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reset();
    mdhl_feed("```py", 5); mdhl_feed("thon\nim", 7); mdhl_feed("port os\n``", 10); mdhl_feed("`\n", 2);
    mdhl_finish();
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "live upgrade: exactly 3 rows — no leftover live interior row");
    assert_eq(_t_has_esc(feed_line_ptr(0), feed_line_len(0)), 0, "opener verbatim");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 1, "interior upgraded to highlighted");
    assert_eq(_t_has_esc(feed_line_ptr(2), feed_line_len(2)), 0, "closer verbatim");
    var sb1[128];
    _t_strip_sgr(&sb1, feed_line_ptr(1), feed_line_len(1));
    assert(streq(&sb1, "import os"), "interior strips to the code exactly (no doubling)");
    # (2) BLOCKER regression: an unterminated block whose last interior line has NO trailing newline
    # (an interrupt / truncated completion) must NOT double the live partial with the highlighted re-emit.
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reset();
    var un = "```python\nimport os\nx=1";
    mdhl_feed(un, strlen(un));
    mdhl_finish();
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "unterminated: opener + 2 highlighted rows, no leftover");
    var sb2[128];
    _t_strip_sgr(&sb2, feed_line_ptr(2), feed_line_len(2));
    assert(streq(&sb2, "x=1"), "the newline-less last line is NOT doubled (strips to 'x=1')");
    # (3) no-grammar block (```text): interior stays verbatim (uncoloured), correct count, no drop glitch
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reset();
    var tx = "```text\nhello\n```\n";
    mdhl_feed(tx, strlen(tx));
    mdhl_finish();
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 3, "no-grammar: 3 rows");
    assert_eq(_t_has_esc(feed_line_ptr(1), feed_line_len(1)), 0, "no-grammar interior stays verbatim");
    var sb3[128];
    _t_strip_sgr(&sb3, feed_line_ptr(1), feed_line_len(1));
    assert(streq(&sb3, "hello"), "no-grammar interior text preserved");
    ui_force(PT_PLAIN, CD_NONE);
    return 0;
}

# feed search (0.18.4): the PURE matcher (case-insensitive, escape-transparent), the highlighted-line
# render (reverse-video injected, interior-reset re-assert, bounded-carry OFF), and the match-list state
# machine (rescan over the ring + pending, n/N wrap). The render feeds the UNCHANGED feed_clip_seg.
fn test_fsearch() {
    test_group("feed search (fsearch.cyr, 0.18.4)");
    fsearch_init();
    ui_force(PT_ANSI, CD_TRUE);
    # --- matcher: case-insensitive ASCII, no-match, empty query ---
    fsearch_set_query("err", 3);
    assert_eq(fsearch_line_has("an error here", 13), 1, "match mid-line (err in error)");
    assert_eq(fsearch_line_has("ERROR up", 8), 1, "case-insensitive (ERR matches err)");
    assert_eq(fsearch_line_has("all fine", 8), 0, "no match");
    fsearch_set_query("", 0);
    assert_eq(fsearch_line_has("error", 5), 0, "empty query never matches");
    # escape-transparent: "e" + RESET marker + "rror" still contains "error"
    var mline[32];
    var mn = 0;
    store8(&mline + mn, 101); mn = mn + 1;             # 'e'
    store8(&mline + mn, 27);  mn = mn + 1;             # ESC
    store8(&mline + mn, FEED_MARK_RESET); mn = mn + 1; # reset marker (0xBF)
    store8(&mline + mn, 114); mn = mn + 1;             # 'r'
    store8(&mline + mn, 114); mn = mn + 1;             # 'r'
    store8(&mline + mn, 111); mn = mn + 1;             # 'o'
    store8(&mline + mn, 114); mn = mn + 1;             # 'r'
    fsearch_set_query("error", 5);
    assert_eq(fsearch_line_has(&mline, mn), 1, "match spans an interior marker (e<reset>rror)");
    # --- render: injects reverse video; visible text preserved (feeds the unchanged feed_clip_seg) ---
    var rb[128];
    fsearch_set_query("foo", 3);
    var rn = fsearch_render(&rb, 128, "a foo b", 7, 0 - 1);   # cur_off -1 => no current occurrence on this line
    assert_eq(_t_has_esc(&rb, rn), 1, "render injects an escape (reverse video)");
    var sb[64];
    _t_strip_sgr(&sb, &rb, rn);
    assert(streq(&sb, "a foo b"), "render strips back to the source visible text");
    assert_eq(_t_count_sub(&rb, rn, "\x1b[7m", 4), 1, "one reverse-ON around the single match");
    # the CURRENT occurrence (the match starting at offset 2, "foo") uses a DISTINCT sgr (reverse+underline)
    var rc[128];
    var rcn = fsearch_render(&rc, 128, "a foo b", 7, 2);
    assert_eq(_t_count_sub(&rc, rcn, "\x1b[7;4m", 6), 1, "current occurrence (offset 2) uses reverse+underline");
    # --- RESET RE-ASSERT: an interior reset inside the match must not kill reverse ---
    fsearch_set_query("error", 5);
    var hb[128];
    var hn = fsearch_render(&hb, 128, &mline, mn, 0 - 1);
    assert_eq(_t_count_sub(&hb, hn, "\x1b[7m", 4), 2, "reverse re-asserted after the interior reset (two ESC[7m)");
    # --- WRAP-STRADDLE: the render output through feed_clip_seg — reverse RESUMES at a later segment ---
    # line = "aaaa" + "e r <reset> r o r" (match "error" at visible cols 4..8); width 6 -> the interior reset
    # lands in segment 1's SKIP region; the boundary carry must re-flush ESC[7m so "ror" paints reversed.
    var wl[48];
    var wn = 0;
    store8(&wl + wn, 97); wn = wn + 1; store8(&wl + wn, 97); wn = wn + 1;
    store8(&wl + wn, 97); wn = wn + 1; store8(&wl + wn, 97); wn = wn + 1;   # "aaaa"
    store8(&wl + wn, 101); wn = wn + 1;                                     # 'e' (col 4)
    store8(&wl + wn, 114); wn = wn + 1;                                     # 'r' (col 5)
    store8(&wl + wn, 27); wn = wn + 1; store8(&wl + wn, FEED_MARK_RESET); wn = wn + 1;  # reset marker
    store8(&wl + wn, 114); wn = wn + 1;                                     # 'r' (col 6)
    store8(&wl + wn, 111); wn = wn + 1;                                     # 'o' (col 7)
    store8(&wl + wn, 114); wn = wn + 1;                                     # 'r' (col 8)
    var wr[192];
    var wrn = fsearch_render(&wr, 192, &wl, wn, 0 - 1);
    var seg1[128];
    # skip=7: the interior reset AND its re-assert both fall in this segment's SKIP region (cols<7), so the
    # ONLY source of reverse in the painted window is the boundary carry re-flush — proving the re-assert
    # refilled the carry after feed_clip_seg cleared it on the reset (feed.cyr:307). Without the re-assert
    # the carry would be empty and "or" would paint UNreversed.
    var s1 = feed_clip_seg(&seg1, 128, &wr, wrn, 7, 6);                     # segment: visible cols [7,13)
    assert_eq(_t_count_sub(&seg1, s1, "\x1b[7m", 4), 1, "reverse resumes at the wrap boundary (carry re-flush after a skip-region reset)");
    var s1v[64];
    _t_strip_sgr(&s1v, &seg1, s1);
    assert(streq(&s1v, "or"), "segment visible text is 'or' (still reversed across the wrap)");
    # --- BOUNDED CARRY: many single-char matches on a wide line — the reset-collapse OFF keeps the carry
    # tiny, so a non-first segment still reverses correctly (regression for the 64B carry overflow). ---
    fsearch_set_query("e", 1);
    var el[64];
    var en = 0;
    while (en < 40) { store8(&el + en, 101); en = en + 1; }                 # 40 e's
    var er[512];
    var ern = fsearch_render(&er, 512, &el, en, 0 - 1);
    var eseg[128];
    var es = feed_clip_seg(&eseg, 128, &er, ern, 30, 6);                    # far segment: cols [30,36)
    var esv[64];
    _t_strip_sgr(&esv, &eseg, es);
    assert(streq(&esv, "eeeeee"), "far segment paints its 6 e's (carry stayed bounded, no overflow drop)");
    assert_eq(_t_has_esc(&eseg, es), 1, "far segment is still highlighted");
    # --- PT_PLAIN floor: render is byte-identical to src ---
    ui_force(PT_PLAIN, CD_NONE);
    fsearch_set_query("foo", 3);
    var pb[64];
    var pn = fsearch_render(&pb, 64, "a foo b", 7, 0 - 1);
    assert_eq(pn, 7, "PT_PLAIN render is byte-length-identical to src (floor)");
    var pv[64];
    _t_strip_sgr(&pv, &pb, pn);
    assert(streq(&pv, "a foo b"), "PT_PLAIN render == src verbatim (floor)");
    ui_force(PT_ANSI, CD_TRUE);
    # --- rescan + next/prev over the ring (+ pending) ---
    feed_init();
    feed_write("alpha error one\n", 16);
    feed_write("nothing here\n", 13);
    feed_write("beta error two\n", 15);
    fsearch_set_query("error", 5);
    assert_eq(fsearch_rescan(), 2, "rescan finds 2 matching lines");
    assert_eq(fsearch_cur_line(), 2, "seeded to the NEWEST match (line 2)");
    assert_eq(fsearch_line_is_match(0), 1, "line 0 is a match");
    assert_eq(fsearch_line_is_match(1), 0, "line 1 is not a match");
    assert_eq(fsearch_next(), 0, "next wraps newest -> oldest (line 0)");
    assert_eq(fsearch_prev(), 2, "prev wraps back to the newest (line 2)");
    feed_write("gamma error three", 17);              # no newline -> the pending line
    assert_eq(fsearch_rescan(), 3, "rescan includes the pending line");
    assert_eq(fsearch_cur_line(), 3, "newest match is the pending virtual line (index feed_count())");
    fsearch_set_query("", 0);
    assert_eq(fsearch_rescan(), 0, "empty query -> no matches");
    assert_eq(fsearch_cur_line(), 0 - 1, "no current match line when empty");
    # --- OCCURRENCE-granular: two hits on ONE line count as 2, and n/N steps between them (0.18.5) ---
    feed_init();
    feed_write("echo and bote_echo here\n", 24);       # "echo" at offset 0 and inside bote_echo at offset 14
    fsearch_set_query("echo", 4);
    assert_eq(fsearch_rescan(), 2, "two occurrences on one line counted as 2 (not 1 line)");
    assert_eq(fsearch_cur_line(), 0, "both occurrences are on line 0");
    assert_eq(fsearch_cur_off(), 14, "seeded to the NEWEST occurrence (offset 14, inside bote_echo)");
    assert_eq(fsearch_next(), 0, "next stays on line 0 (the other occurrence)");
    assert_eq(fsearch_cur_off(), 0, "current occurrence stepped to offset 0 (the first 'echo')");
    ui_force(PT_PLAIN, CD_NONE);
    return 0;
}

# @file mentions (0.21.0): the PURE expand core. `@path` that resolves to a readable file appends its
# content as a delimited block; a non-resolving @token stays literal (prose untouched, byte-identical
# passthrough — same pointer back); multiple compose; duplicates inject once; trailing punct trimmed;
# email/handle boundaries not mangled. Uses real repo files (VERSION, src/mention.cyr) as fixtures.
fn test_mention() {
    test_group("@file mentions (mention.cyr, 0.21.0)");

    # --- no mention -> byte-identical passthrough (SAME pointer), count 0 ---
    var a = "hello world, nothing here";
    var ra = mention_expand(a);
    assert(ra == a, "no mention -> original pointer unchanged");
    assert_eq(mention_count(), 0, "no mention -> count 0");

    # --- email/handle boundary: @ not preceded by whitespace is NOT a mention ---
    var e = "mail foo@bar.com now";
    var re = mention_expand(e);
    assert(re == e, "foo@bar not a mention (no whitespace boundary) -> passthrough");
    assert_eq(mention_count(), 0, "email -> count 0");

    # --- single mention: prose preserved, a block appended right after it ---
    var s = "see @VERSION please";
    var rs = mention_expand(s);
    assert_eq(mention_count(), 1, "one resolvable mention -> count 1");
    assert(rs != s, "expanded (not the original pointer)");
    assert(cstr_starts_with(rs, "see @VERSION please") == 1, "prose preserved verbatim at the front");
    assert_eq(load8(rs + strlen("see @VERSION please")), 10, "a block (\\n) begins right after the prose");

    # --- mention at start-of-text boundary ---
    var b = "@VERSION";
    var rb = mention_expand(b);
    assert_eq(mention_count(), 1, "@ at start-of-text is a boundary -> count 1");

    # --- multiple mentions compose ---
    var m = "compare @VERSION and @src/mention.cyr";
    mention_expand(m);
    assert_eq(mention_count(), 2, "two distinct resolvable mentions -> count 2");

    # --- duplicate injects once ---
    var d = "@VERSION then @VERSION again";
    mention_expand(d);
    assert_eq(mention_count(), 1, "duplicate path -> injected once");

    # --- non-existent path stays literal (passthrough) ---
    var n = "@nope_zzz_not_a_file here";
    var rn = mention_expand(n);
    assert(rn == n, "unresolvable @token -> literal passthrough (original pointer)");
    assert_eq(mention_count(), 0, "non-existent -> count 0");

    # --- trailing punctuation trimmed to resolve ---
    var t = "read @VERSION.";
    mention_expand(t);
    assert_eq(mention_count(), 1, "trailing '.' trimmed -> VERSION resolves, count 1");

    # --- a directory resolves file_exists but is unreadable -> stays literal ---
    var dir = "look in @src here";
    var rdir = mention_expand(dir);
    assert(rdir == dir, "@src (a directory) -> unreadable, literal passthrough");
    assert_eq(mention_count(), 0, "directory -> count 0");
    return 0;
}

# @file Tab completion (0.21.1): the shared token scan (mention_prefix_at) + the file-tree completer
# (ftree_complete, dir_list-backed) + the composer multi-char insert (led_insert_cstr). Uses real repo
# files (VERSION, src/, src/mention.cyr, cyrius.cyml/.lock) as fixtures, like test_mention.
fn test_tab_complete() {
    test_group("@file Tab completion (mention.cyr/ftree.cyr/tui.cyr, 0.21.1)");

    # --- mention_prefix_at: where a @<prefix> token ends at the cursor ---
    var s1 = "see @VER";
    assert_eq(mention_prefix_at(s1, 8), 5, "prefix starts just after '@' (offset 5)");
    assert_eq(mention_prefix_at(s1, 4), 0 - 1, "cursor before the '@' -> not in a token");
    var s2 = "foo@bar";
    assert_eq(mention_prefix_at(s2, 7), 0 - 1, "email foo@bar -> '@' mid-word, not a mention");
    var s3 = "@VER";
    assert_eq(mention_prefix_at(s3, 4), 1, "'@' at start-of-text -> boundary, prefix offset 1");
    var s4 = "@";
    assert_eq(mention_prefix_at(s4, 1), 1, "'@' then cursor -> empty prefix at offset 1");
    var s5 = "a @b";
    assert_eq(mention_prefix_at(s5, 4), 3, "'@' after a space -> boundary");
    # cursor must be at the END of the token: mid-token -> -1 (else completion would splice into the middle)
    var s6 = "@VERbar";
    assert_eq(mention_prefix_at(s6, 4), 0 - 1, "cursor mid-token (before 'bar') -> not the end, -1");
    assert_eq(mention_prefix_at(s6, 7), 1, "cursor at the end of the whole token -> valid, offset 1");
    var s7 = "@VER foo";
    assert_eq(mention_prefix_at(s7, 4), 1, "cursor at end of '@VER' before a space -> valid (token ends)");

    # --- ftree_complete: unique file, unique dir (+ '/'), subdir, ambiguous LCP, no-match ---
    var out = alloc(256);
    assert_eq(ftree_complete("VER", out, 256), 1, "VER -> unique (VERSION)");
    assert(streq(out, "SION") == 1, "VER completes to the suffix SION");
    assert_eq(ftree_complete("src", out, 256), 1, "src -> unique dir");
    assert(streq(out, "/") == 1, "a unique directory completes with a trailing '/'");
    assert_eq(ftree_complete("src/men", out, 256), 1, "src/men -> unique (src/mention.cyr)");
    assert(streq(out, "tion.cyr") == 1, "src/men completes to tion.cyr (dir listed live, no expand)");
    # ambiguous: use git-TRACKED root files (thoth.cyml is a local/gitignored config, absent in CI)
    assert(ftree_complete("C", out, 256) >= 2, "C -> ambiguous (CHANGELOG.md, CLAUDE.md, ... — tracked)");
    assert_eq(load8(out), 0, "ambiguous, nothing common beyond 'C' -> empty suffix (no over-completion)");
    # the LCP-progress logic tested PURELY (FS-independent): the common-prefix shrink of two candidate names
    var acc = alloc(64);
    var seed = "mention.cyr";
    var q = 0;
    while (load8(seed + q) != 0) { store8(acc + q, load8(seed + q)); q = q + 1; }
    store8(acc + q, 0);
    _ftc_lcp_shrink(acc, "memory.cyr");
    assert(streq(acc, "me") == 1, "_ftc_lcp_shrink: mention.cyr ^ memory.cyr -> me");
    _ftc_lcp_shrink(acc, "xyz");
    assert_eq(load8(acc), 0, "_ftc_lcp_shrink: no common prefix -> empty");
    assert_eq(ftree_complete("zzz_no_such_prefix", out, 256), 0, "no match -> count 0");
    assert_eq(load8(out), 0, "no match -> empty suffix");

    # --- led_insert_cstr: multi-char insert at the cursor via the tested led_feed path ---
    led_reset();
    led_feed(KEY_CHAR, 64); led_feed(KEY_CHAR, 86); led_feed(KEY_CHAR, 69); led_feed(KEY_CHAR, 82);  # "@VER"
    assert_eq(led_insert_cstr("SION"), 4, "inserted 4 bytes");
    assert(streq(led_buf(), "@VERSION") == 1, "completion inserted at the cursor -> @VERSION");
    assert_eq(led_len(), 8, "composer length after insert");
    assert_eq(led_cur(), 8, "cursor advanced to the end of the insert");
    led_reset();
    return 0;
}

# inline markdown (0.18.8): prose lines get headings/bold/inline-code/list markers styled in the feed,
# preserving strip-coverage (strip_sgr(output) == raw line). Route via mdhl_reply under OUT_RING and read
# the sealed row. Colors are role markers (recolor on /theme); bold is a raw ESC[1m.
fn _t_md_row(raw, n) {
    # run one raw line through mdhl_reply into the feed ring; return the sealed row 0's byte length via
    # the globals (caller reads feed_line_ptr(0)/feed_line_len(0)). Assumes a single logical line.
    feed_init();
    out_mode_set(OUT_RING);
    mdhl_reply(raw, n);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    return feed_line_len(0);
}
fn test_mdhl_inline() {
    test_group("inline markdown (mdhl.cyr, 0.18.8)");
    ui_force(PT_ANSI, CD_TRUE);
    var sv[128];
    # heading -> whole line colored, strips to the raw text
    var hl = _t_md_row("## Title\n", 9);
    assert_eq(_t_has_esc(feed_line_ptr(0), hl), 1, "heading row is styled");
    _t_strip_sgr(&sv, feed_line_ptr(0), hl);
    assert(streq(&sv, "## Title"), "heading strips back to '## Title' (strip-coverage)");
    assert_eq(_t_count_sub(feed_line_ptr(0), hl, "\x1b[1m", 4), 0, "heading is color, not bold");
    # bold -> the **b** span carries ESC[1m, strips to the raw text
    var bl = _t_md_row("a **b** c\n", 10);
    assert_eq(_t_count_sub(feed_line_ptr(0), bl, "\x1b[1m", 4), 1, "bold span emits one ESC[1m");
    _t_strip_sgr(&sv, feed_line_ptr(0), bl);
    assert(streq(&sv, "a **b** c"), "bold strips back to 'a **b** c'");
    # inline code -> colored (not bold), strips to the raw text
    var cl = _t_md_row("a `x` b\n", 8);
    assert_eq(_t_has_esc(feed_line_ptr(0), cl), 1, "inline code is styled");
    assert_eq(_t_count_sub(feed_line_ptr(0), cl, "\x1b[1m", 4), 0, "inline code is color, not bold");
    _t_strip_sgr(&sv, feed_line_ptr(0), cl);
    assert(streq(&sv, "a `x` b"), "inline code strips back to 'a `x` b'");
    # code precedence: the ** inside a code span stays literal (no bold)
    var pl = _t_md_row("`**x**`\n", 8);
    assert_eq(_t_count_sub(feed_line_ptr(0), pl, "\x1b[1m", 4), 0, "** inside inline code is not bolded (code precedence)");
    _t_strip_sgr(&sv, feed_line_ptr(0), pl);
    assert(streq(&sv, "`**x**`"), "code-with-stars strips back verbatim");
    # list marker -> the bullet styled; unordered + ordered
    var ll = _t_md_row("- item\n", 7);
    assert_eq(_t_has_esc(feed_line_ptr(0), ll), 1, "list bullet is styled");
    _t_strip_sgr(&sv, feed_line_ptr(0), ll);
    assert(streq(&sv, "- item"), "list line strips back to '- item'");
    var ol = _t_md_row("1. item\n", 8);
    _t_strip_sgr(&sv, feed_line_ptr(0), ol);
    assert(streq(&sv, "1. item"), "ordered list line strips back to '1. item'");
    # unmatched delimiters -> emitted verbatim, no styling added
    var ul = _t_md_row("a ** b\n", 7);
    assert_eq(_t_has_esc(feed_line_ptr(0), ul), 0, "an unmatched ** adds no styling");
    _t_strip_sgr(&sv, feed_line_ptr(0), ul);
    assert(streq(&sv, "a ** b"), "unmatched ** strips back verbatim");
    # FLOOR: at PT_PLAIN the row is byte-identical (no markers)
    ui_force(PT_PLAIN, CD_NONE);
    var fl = _t_md_row("## Title\n", 9);
    assert_eq(_t_has_esc(feed_line_ptr(0), fl), 0, "PT_PLAIN: no styling (floor byte-identical)");
    ui_force(PT_ANSI, CD_TRUE);
    # COMPOSE with search: a match inside a heading highlights + strips to raw; a match inside bold
    # RE-ASSERTS ESC[1m after the match (the 0.18.4 fsearch bold-tracking fold)
    fsearch_init();
    var gl2 = _t_md_row("## Title\n", 9);
    fsearch_set_query("Title", 5);
    fsearch_rescan();
    var hb[256];
    var hn = fsearch_render(&hb, 256, feed_line_ptr(0), gl2, fsearch_cur_off());
    assert_eq(_t_has_esc(&hb, hn), 1, "search match renders in the colored heading");
    _t_strip_sgr(&sv, &hb, hn);
    assert(streq(&sv, "## Title"), "heading + search strips to '## Title'");
    var bl2 = _t_md_row("**hello world**\n", 16);
    fsearch_set_query("hello", 5);
    fsearch_rescan();
    var bb[256];
    var bn = fsearch_render(&bb, 256, feed_line_ptr(0), bl2, fsearch_cur_off());
    assert(_t_count_sub(&bb, bn, "\x1b[1m", 4) >= 2, "bold re-asserted after a search match inside it (original + re-assert)");
    ui_force(PT_PLAIN, CD_NONE);
    return 0;
}

# Working spinner (0.9.2): the frame cycle is PURE (the animated indicator + its
# hint-row paint are I/O, live-verified). spin_glyph cycles mod SPIN_FRAMES;
# spin_advance steps the frame.
fn test_spinner() {
    test_group("working spinner (tui.cyr)");
    assert(streq(spin_glyph(0), spin_glyph(SPIN_FRAMES)), "spinner glyph cycles mod the frame count");
    assert_eq(streq(spin_glyph(0), spin_glyph(1)), 0, "adjacent spinner frames differ");
    assert(streq(spin_glyph(0), "\xe2\xa0\x8b"), "frame 0 is the braille glyph ⠋");
    var f0 = spin_frame();
    spin_advance(); spin_advance();
    assert_eq(spin_frame() - f0, 2, "spin_advance steps the frame");
    return 0;
}

# Streamed-frame paint throttle (0.15.0): feed_stream_tick coalesces per-chunk
# repaints onto a STREAM_FRAME_MS budget so 80–150 tok/s streaming doesn't thrash.
# The PAINT is I/O (live-verified on a tty); the throttle DECISION is the pure
# _stream_should_paint(now, last) — unit-tested here for the frame boundary and
# the fail-open backward-clock step.
fn test_stream_throttle() {
    test_group("streamed-frame paint throttle (tui.cyr)");
    assert_eq(STREAM_FRAME_MS, 33, "frame budget is ~30fps (33ms)");
    assert_eq(_stream_should_paint(1000, 1000), 0, "dt=0 -> coalesce (no paint)");
    assert_eq(_stream_should_paint(1032, 1000), 0, "dt=32 < budget -> coalesce");
    assert_eq(_stream_should_paint(1033, 1000), 1, "dt=33 == budget -> paint");
    assert_eq(_stream_should_paint(5000, 1000), 1, "dt >> budget -> paint");
    assert_eq(_stream_should_paint(999, 1000), 1, "backward clock step -> paint (fail-open, never stall)");
    assert_eq(_stream_should_paint(90000, 0), 1, "first tick of a turn (last=0) -> paint instantly");
    return 0;
}

# File-tree pane (0.9.3): the layout geometry (tree/feed split) and the flattened-tree
# model (append, splice children on expand, collapse a subtree, ancestor-walk path
# reconstruction) are PURE; the directory listing + paint are I/O (live-verified).
fn test_ftree() {
    test_group("file-tree model + geometry (ftree.cyr)");
    # geometry: hidden tree -> full-width feed (the 0.9.1/0.9.2 case)
    assert_eq(tui_tree_w(80, 0), 0, "tree width 0 when hidden");
    assert_eq(tui_feed_left(80, 0), 1, "feed starts at col 1 when hidden");
    assert_eq(tui_feed_width(80, 0), 80, "feed full width when hidden");
    # geometry: shown -> tree + separator + feed
    assert_eq(tui_tree_w(120, 1), 28, "tree width caps at 28 (120/3=40 -> 28)");
    assert_eq(tui_tree_w(30, 1), 10, "tree width = cols/3 below the cap");
    assert_eq(tui_feed_left(120, 1), 30, "feed starts past tree(28)+separator -> col 30");
    assert_eq(tui_feed_width(120, 1), 91, "feed width = 120 - 30 + 1");
    # model: two root entries
    ftree_init();
    ftree_reset();
    _ftree_set_cwd("/repo");
    _ftree_append("src", 1, 0);
    _ftree_append("VERSION", 0, 0);
    assert_eq(ftree_count(), 2, "two root entries");
    assert_eq(ftree_isdir(0), 1, "src is a dir");
    var pb[256];
    ftree_path(1, &pb, 256);
    assert(streq(&pb, "/repo/VERSION"), "root file path = cwd/name");
    # expand src: splice two children in at depth 1
    _ftree_insert_at(1, "main.cyr", 0, 1);
    _ftree_insert_at(2, "tui.cyr", 0, 1);
    ftree_set_exp(0, 1);
    assert_eq(ftree_count(), 4, "two children spliced in -> 4 nodes");
    assert_eq(ftree_depth(2), 1, "child at depth 1");
    ftree_path(2, &pb, 256);
    assert(streq(&pb, "/repo/src/tui.cyr"), "nested path walks ancestors");
    # selection clamps
    ftree_set_sel(0); ftree_move(10);
    assert_eq(ftree_sel(), 3, "move clamps to the last node");
    ftree_move(0 - 100);
    assert_eq(ftree_sel(), 0, "move clamps to the first node");
    # collapse src removes its subtree
    assert_eq(ftree_collapse_at(0), 2, "collapse removes the 2 children");
    assert_eq(ftree_count(), 2, "back to 2 nodes");
    assert_eq(ftree_exp(0), 0, "src marked collapsed");
    assert(streq(ftree_name(1), "VERSION"), "VERSION shifted back to index 1");
    # I/O smoke: list the repo's src/ — exercises the Str plumbing + dirs-first on a
    # real directory (src/ has the vendor/ subdir + many .cyr files). Run from the
    # project root by `cyrius test`.
    ftree_init();
    ftree_reset();
    _ftree_list_into("src", 0, 0);
    assert(ftree_count() > 5, "listed src/ — the dir_list/is_dir/Str plumbing works");
    assert_eq(ftree_isdir(0), 1, "dirs-first: a directory (vendor/) sorts before the files");
    return 0;
}

# Theme axis (0.10.0): a theme sits in front of the role color dispatchers. PURE:
# dark is the pre-0.10.0 values verbatim (byte-identical anchor), light is distinct,
# a /theme switch rebuilds the cached SGR table, and PT_PLAIN stays empty (floor
# byte-identical) under any theme.
fn test_theme() {
    test_group("theme axis (ui.cyr)");
    assert_eq(ui_theme(), THEME_DARK, "default theme is dark");
    assert(streq(ui_theme_name(), "dark"), "default theme name 'dark'");
    assert_eq(ui_theme_from_name("light"), THEME_LIGHT, "'light' -> THEME_LIGHT");
    assert_eq(ui_theme_from_name("dark"), THEME_DARK, "'dark' -> THEME_DARK");
    assert_eq(ui_theme_from_name("rainbow"), 0 - 1, "'rainbow' deferred -> -1 (never faked)");
    ui_set_theme(THEME_DARK);
    assert_eq(_ui_rgb(ROLE_ACCENT), 230 * 65536 + 171 * 256 + 92, "dark accent RGB unchanged (byte-identical anchor)");
    ui_set_theme(THEME_LIGHT);
    assert_eq(_ui_rgb(ROLE_ACCENT), 176 * 65536 + 122 * 256 + 37, "light accent RGB = warm-light");
    assert(streq(ui_theme_name(), "light"), "theme name reflects light");
    assert_eq(_ui_code16(ROLE_ACCENT), _ui_code16_dark(ROLE_ACCENT), "light shares dark 16-color codes");
    # T1: a theme switch rebuilds the cached SGR table
    ui_force(PT_ANSI, CD_TRUE);
    ui_set_theme(THEME_DARK);
    assert_eq(_ui_contains(ui_sgr(ROLE_ACCENT), "38;2;230;171;92"), 1, "dark T1 accent SGR = amber");
    ui_set_theme(THEME_LIGHT);
    assert_eq(_ui_contains(ui_sgr(ROLE_ACCENT), "38;2;176;122;37"), 1, "light T1 accent SGR = warm-light (rebuilt)");
    # PT_PLAIN floor stays byte-identical (empty) under ANY theme
    ui_force(PT_PLAIN, CD_NONE);
    ui_set_theme(THEME_LIGHT);
    assert_eq(streq(ui_sgr(ROLE_ACCENT), ""), 1, "PT_PLAIN accent empty under light (floor unchanged)");
    # restore defaults for later tests
    ui_set_theme(THEME_DARK);
    ui_detect_tier();
    return 0;
}

fn test_git() {
    test_group("git producer (git.cyr / SEAM_GIT, 0.13.0)");
    # seam registration on the capability ladder
    assert_eq(SEAM_COUNT, 7, "SEAM_COUNT includes git (7)");
    assert(streq(seam_name(SEAM_GIT), "sit"), "SEAM_GIT owner is sit");
    assert_eq(seam_status(SEAM_GIT), SEAM_NATIVE, "sit binds native by construction (vendored bundle)");
    assert_eq(_ui_contains(seam_domain(SEAM_GIT), "version control"), 1, "domain names version control");
    # probe is callable; git_present() matches the probe result and is a clean 0/1
    var p = git_probe();
    assert(((p == 0) || (p == 1)), "git_probe returns 0/1");
    assert_eq(git_present(), p, "git_present matches the probe result");
    # capability-effect <-> presence invariant (holds whether or not there's a repo)
    if (git_present() == 1) {
        # cyrius test runs at the thoth repo root -> a real read through sit's .git backend
        assert_eq(seam_cap_state(SEAM_GIT), CAP_FULL, "repo present -> capability FULL");
        # A present repo may be on a NAMED branch or a DETACHED HEAD — CI checkouts are
        # commonly detached (GitHub Actions checks out a bare SHA), so don't assume a branch.
        # Attached -> git_branch() is a real name; detached -> the '?' sentinel (the UI renders
        # "(detached)" off git_detached(), never the sentinel). Assert whichever case holds.
        if (git_detached() == 0) {
            assert_eq(streq(git_branch(), "?"), 0, "attached -> a real branch, not the '?' sentinel");
        } else {
            assert_eq(streq(git_branch(), "?"), 1, "detached -> git_branch() is the '?' sentinel (UI shows (detached))");
        }
        assert(git_dirty() >= 0, "dirty count is a non-negative snapshot");
    } else {
        assert_eq(seam_cap_state(SEAM_GIT), CAP_ABSENT, "no repo at cwd -> capability ABSENT (honest, never faked)");
    }
    # ensure_probed is idempotent — same result, no re-crash
    git_ensure_probed();
    assert_eq(git_present(), p, "ensure_probed keeps the probe result stable");

    # 0.22.4 file-tree git badges: git_status_of over the per-file status cache (white-box: inject entries,
    # then re-probe to restore the real state). kinds 1=modified, 2=new, 3=deleted; 0 = unchanged / no repo.
    if (_git_status_ptr == 0) { _git_status_ptr = alloc(GIT_STATUS_MAX * 8); _git_status_kind = alloc(GIT_STATUS_MAX); _git_status_buf = alloc(GIT_STATUS_BUF); }
    _git_present = 1;
    store64(_git_status_ptr + 0, "src/main.cyr");  store8(_git_status_kind + 0, 1);
    store64(_git_status_ptr + 8, "docs/x.md");      store8(_git_status_kind + 1, 2);
    store64(_git_status_ptr + 16, "gone.txt");      store8(_git_status_kind + 2, 3);
    _git_status_n = 3;
    assert_eq(git_status_of("src/main.cyr"), 1, "modified -> kind 1");
    assert_eq(git_status_of("docs/x.md"), 2, "new -> kind 2");
    assert_eq(git_status_of("gone.txt"), 3, "deleted -> kind 3");
    assert_eq(git_status_of("untouched.cyr"), 0, "unchanged path -> 0");
    _git_present = 0;
    assert_eq(git_status_of("src/main.cyr"), 0, "no repo -> 0 regardless of the cache");
    git_probe();   # restore the real probe state for any later reader
    return 0;
}

# project read/explore tools (0.23.0): the jail (pure) + read_file/list_dir over real repo files. The jail
# is the security boundary — absolute paths, '~', and '..' components are refused; in-project relative paths
# pass. read_file/list_dir hit the filesystem (present-on-disk, not git status), so real files/dirs work.
fn test_project() {
    test_group("project read/explore tools (project.cyr, 0.23.0/0.23.1)");
    # --- jail (pure): accept in-project relative, refuse escapes ---
    assert_eq(_project_jail_ok("src/main.cyr"), 1, "relative in-project path ok");
    assert_eq(_project_jail_ok("."), 1, "'.' (project root) ok");
    assert_eq(_project_jail_ok("./src"), 1, "'./src' ok");
    assert_eq(_project_jail_ok("a.b-c_d.cyr"), 1, "dotted/dashed filename ok (not a '..' component)");
    assert_eq(_project_jail_ok("/etc/passwd"), 0, "absolute path refused");
    assert_eq(_project_jail_ok("~/.ssh/id_rsa"), 0, "home '~' path refused");
    assert_eq(_project_jail_ok(".."), 0, "bare '..' refused");
    assert_eq(_project_jail_ok("../secret"), 0, "'../' escape refused");
    assert_eq(_project_jail_ok("src/../../etc"), 0, "mid-path '..' escape refused");
    assert_eq(_project_jail_ok("src/foo/.."), 0, "trailing '..' refused");

    # --- read_file_tool: real read + jailed refusals + honest errors ---
    var r = read_file_tool("{\"path\":\"VERSION\"}");
    assert(load8(r) != 40, "read VERSION -> file content, not an error string (no leading '(')");
    assert(strlen(r) > 0, "VERSION content is non-empty");
    assert(_ui_contains(read_file_tool("{\"path\":\"/etc/passwd\"}"), "refused") == 1, "absolute path -> refused");
    assert(_ui_contains(read_file_tool("{\"path\":\"../x\"}"), "refused") == 1, "'..' escape -> refused");
    assert(_ui_contains(read_file_tool("{\"path\":\"src\"}"), "directory") == 1, "a directory -> 'use list_dir'");
    assert(_ui_contains(read_file_tool("{\"path\":\"no_such_zzz.txt\"}"), "no such file") == 1, "missing file -> honest error");
    assert(_ui_contains(read_file_tool("{}"), "missing required") == 1, "missing 'path' arg -> error");

    # --- list_dir_tool: real listing + '/'-suffixed subdirs + jailed refusals ---
    assert(_ui_contains(list_dir_tool("{\"path\":\"src\"}"), "main.cyr") == 1, "list src -> contains main.cyr");
    assert(_ui_contains(list_dir_tool("{\"path\":\"src\"}"), "vendor/") == 1, "subdirectories suffixed with '/'");
    assert(_ui_contains(list_dir_tool("{}"), "VERSION") == 1, "default path (root) -> contains VERSION");
    assert(_ui_contains(list_dir_tool("{\"path\":\"/etc\"}"), "refused") == 1, "absolute dir -> refused (before any grant)");
    assert(_ui_contains(list_dir_tool("{\"path\":\"no_such_dir_zzz\"}"), "no such directory") == 1, "missing dir -> error");

    # --- granted read roots (0.23.1): the USER-widened jail ---
    assert_eq(project_grant_root("relative/path"), 0, "grant rejects a relative root");
    assert_eq(project_grant_root("/"), 0, "grant rejects '/' (would defeat the jail)");
    assert_eq(project_grant_root(""), 0, "grant rejects an empty root");
    assert_eq(project_grant_root("~/repo"), 0, "grant rejects a '~' root (not absolute)");
    var before = project_read_roots_count();
    assert_eq(project_grant_root("/opt/demo/repo"), 1, "grant accepts an absolute root");
    assert_eq(project_read_roots_count(), before + 1, "root count grew by one");
    assert_eq(project_grant_root("/opt/demo/repo"), 1, "re-granting the same root is idempotent (1)");
    assert_eq(project_read_roots_count(), before + 1, "dedup: exact duplicate does not grow the count");
    assert_eq(project_grant_root("/opt/demo/repo/"), 1, "trailing-slash form accepted");
    assert_eq(project_read_roots_count(), before + 1, "dedup: trailing-slash normalizes to the same root");

    # --- _project_read_ok: in-project relative OR absolute-under-a-granted-root, never '..' ---
    assert_eq(_project_read_ok("src/main.cyr"), 1, "in-project relative allowed");
    assert_eq(_project_read_ok("/opt/demo/repo/x.txt"), 1, "absolute file under a granted root allowed");
    assert_eq(_project_read_ok("/opt/demo/repo"), 1, "the granted root itself allowed");
    assert_eq(_project_read_ok("/opt/demo/repository/x"), 0, "shared-prefix sibling is NOT under the root ('/'-boundary)");
    assert_eq(_project_read_ok("/opt/demo"), 0, "a parent of the root is not under it");
    assert_eq(_project_read_ok("/opt/demo/other/x"), 0, "absolute path outside every granted root refused");
    assert_eq(_project_read_ok("/opt/demo/repo/../secret"), 0, "'..' under a granted root refused (no traversal)");
    assert_eq(_project_read_ok("~/opt/demo/repo"), 0, "a '~' path is never a granted root");

    # --- end-to-end: a grant flips a previously-refused absolute path (via /etc on the Linux test host) ---
    assert_eq(project_grant_root("/etc"), 1, "grant /etc for the end-to-end check");
    assert(_ui_contains(list_dir_tool("{\"path\":\"/etc\"}"), "/etc:") == 1, "granted absolute dir now lists (not refused)");
    assert(_ui_contains(list_dir_tool("{\"path\":\"/etc\"}"), "refused") == 0, "granted absolute dir is no longer refused");
    assert(_ui_contains(read_file_tool("{\"path\":\"/etc/no_such_zzz\"}"), "no such file") == 1, "granted root: gate passes, missing file -> honest error (not refused)");
    return 0;
}

# _mp_push_str: helper — feed each byte of NUL-terminated `s` through mpick_query_push (mirrors typing).
fn _mp_push_str(s) {
    var i = 0;
    while (load8(s + i) != 0) { mpick_query_push(load8(s + i)); i = i + 1; }
    return 0;
}

fn test_mpick() {
    test_group("model picker (mpick.cyr, 0.24.0)");
    mpick_init();
    # populate directly (mpick_load does network I/O; the pure state is what we unit-test)
    _mp_n = 0; _mp_store_off = 0; _mp_qlen = 0; _mp_cur = 0; _mp_first = 0;
    _mp_add("claude-opus-4-8");
    _mp_add("claude-sonnet-5");
    _mp_add("qwen3-coder:30b");
    _mp_add("claude-haiku-4-5");
    assert_eq(mpick_total(), 4, "loaded 4 model ids");
    # a malformed catalog entry {"id":""} yields a non-null zero-length id; _mp_add must refuse it (else a
    # blank row would switch to an empty model — review 0.24.0). The count must not grow.
    assert_eq(_mp_add(""), 0, "_mp_add refuses an empty id");
    assert_eq(mpick_total(), 4, "an empty id did not add a row");
    mpick_refilter();
    assert_eq(mpick_count(), 4, "empty query matches all");

    # filter "opus" -> 1 match, selected
    _mp_qlen = 0; mpick_refilter(); _mp_push_str("opus");
    assert_eq(mpick_count(), 1, "'opus' filters to one model");
    assert(streq(mpick_selected_id(), "claude-opus-4-8") == 1, "the opus model is selected");

    # case-insensitive substring: "CLAUDE" -> 3 claude models
    _mp_qlen = 0; mpick_refilter(); _mp_push_str("CLAUDE");
    assert_eq(mpick_count(), 3, "'CLAUDE' (uppercase) matches 3 models (case-insensitive)");

    # mid-string substring: "coder" -> the qwen model
    _mp_qlen = 0; mpick_refilter(); _mp_push_str("coder");
    assert_eq(mpick_count(), 1, "'coder' (mid-id substring) matches one");
    assert(streq(mpick_selected_id(), "qwen3-coder:30b") == 1, "the qwen coder is selected");

    # no match -> empty, no selection; backspace restores
    _mp_qlen = 0; mpick_refilter(); _mp_push_str("zzz");
    assert_eq(mpick_count(), 0, "'zzz' matches nothing");
    assert(mpick_selected_id() == 0, "no selection when the view is empty");
    mpick_query_pop(); mpick_query_pop(); mpick_query_pop();
    assert_eq(mpick_count(), 4, "popping the whole query restores all");

    # navigation clamps within [0, count)
    _mp_qlen = 0; mpick_refilter(); _mp_cur = 0;
    mpick_move(0 - 1); assert_eq(mpick_cur(), 0, "move up at the top clamps to 0");
    mpick_move(100); assert_eq(mpick_cur(), 3, "move down past the end clamps to the last");
    mpick_move(0 - 1); assert_eq(mpick_cur(), 2, "move up steps back one");

    # pre-select the active model by id
    mpick_select_id("claude-sonnet-5");
    assert(streq(mpick_selected_id(), "claude-sonnet-5") == 1, "mpick_select_id highlights the named model");
    mpick_select_id("not-a-model");
    assert(streq(mpick_selected_id(), "claude-sonnet-5") == 1, "select_id on an absent id is a no-op");

    # filtering clamps a stale selection back into range
    _mp_cur = 3; _mp_qlen = 0; mpick_refilter(); _mp_push_str("sonnet");
    assert_eq(mpick_count(), 1, "'sonnet' -> one");
    assert_eq(mpick_cur(), 0, "the selection clamps to the shrunken view");
    return 0;
}

fn test_save() {
    test_group("/save transcript export (feed_strip_ansi_into + cmd_save, 0.24.1)");
    # --- feed_strip_ansi_into: drop role/reset markers + CSI, keep text ---
    var src = alloc(64);
    var o = 0;
    store8(src + o, 65); o = o + 1; store8(src + o, 66); o = o + 1;    # "AB"
    store8(src + o, 27); o = o + 1; store8(src + o, 176); o = o + 1;   # role marker  ESC + 0xB0
    store8(src + o, 67); o = o + 1; store8(src + o, 68); o = o + 1;    # "CD"
    store8(src + o, 27); o = o + 1; store8(src + o, 91); o = o + 1;    # CSI intro    ESC + '['
    store8(src + o, 51); o = o + 1; store8(src + o, 49); o = o + 1; store8(src + o, 109); o = o + 1;  # "31m"
    store8(src + o, 69); o = o + 1; store8(src + o, 70); o = o + 1;    # "EF"
    store8(src + o, 27); o = o + 1; store8(src + o, 191); o = o + 1;   # reset marker ESC + 0xBF
    store8(src + o, 71); o = o + 1; store8(src + o, 72); o = o + 1;    # "GH"
    var dst = alloc(64);
    var n = feed_strip_ansi_into(dst, 64, src, o);
    store8(dst + n, 0);
    assert_eq(n, 8, "stripped length is 8 (ABCDEFGH)");
    assert(streq(dst, "ABCDEFGH") == 1, "role markers + CSI stripped; text preserved");
    var s2 = alloc(4); store8(s2, 88); store8(s2 + 1, 27);            # "X" + a trailing lone ESC
    var n2 = feed_strip_ansi_into(dst, 64, s2, 2);
    store8(dst + n2, 0);
    assert(streq(dst, "X") == 1, "trailing lone ESC dropped; X preserved");
    var n3 = feed_strip_ansi_into(dst, 64, "plain", 5);
    store8(dst + n3, 0);
    assert(streq(dst, "plain") == 1, "plain text passes verbatim");

    # --- cmd_save round-trip: populate the ring, save, read the file back ---
    feed_init();
    out_mode_set(OUT_RING);
    oprintln("first line");
    ui_emit(ROLE_ACCENT, "second"); emit(" line"); feed_flush_pending();   # a line carrying a role marker
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 2, "ring holds 2 lines");
    cmd_save("/save /tmp/thoth_save_test.md");
    var rb = alloc(4096);
    var rn = file_read_all("/tmp/thoth_save_test.md", rb, 4095);
    store8(rb + rn, 0);
    assert(rn > 0, "saved file is non-empty");
    assert(_ui_contains(rb, "# thoth transcript") == 1, "file has the markdown header");
    assert(_ui_contains(rb, "first line") == 1, "file contains the first feed line");
    assert(_ui_contains(rb, "second line") == 1, "file contains the second line, ANSI-stripped");
    var has_esc = 0; var k = 0;
    while (k < rn) { if (load8(rb + k) == 27) { has_esc = 1; } k = k + 1; }
    assert_eq(has_esc, 0, "saved file has no escape bytes (markers fully stripped)");

    # --- cmd_save LINE-MODE path (0.27.0): empty feed ring -> save the conversation history ---
    feed_init();                       # clears the ring -> line-mode /save path
    assert_eq(feed_count(), 0, "ring empty for the line-mode /save path");
    session_history_clear();
    session_history_append("user", "hello there", 11);
    session_history_append("assistant", "hi! reply", 9);
    cmd_save("/save /tmp/thoth_save_hist.md");
    var hb = alloc(4096);
    var hn = file_read_all("/tmp/thoth_save_hist.md", hb, 4095);
    store8(hb + hn, 0);
    assert(hn > 0, "history-mode saved file is non-empty");
    assert(_ui_contains(hb, "# thoth transcript") == 1, "history file has the markdown header");
    assert(_ui_contains(hb, "## user") == 1, "history file has a user turn header");
    assert(_ui_contains(hb, "hello there") == 1, "history file has the user content");
    assert(_ui_contains(hb, "## assistant") == 1, "history file has an assistant turn header");
    assert(_ui_contains(hb, "hi! reply") == 1, "history file has the assistant content");
    session_history_clear();
    return 0;
}

fn test_session_persist() {
    test_group("conversation resume ([session].file, session.cyr, 0.24.2)");
    # --- _sess_uint_into (decimal formatter) ---
    var b = alloc(16);
    var e = _sess_uint_into(b, 0, 0); store8(b + e, 0); assert(streq(b, "0") == 1, "uint 0");
    e = _sess_uint_into(b, 0, 12345); store8(b + e, 0); assert(streq(b, "12345") == 1, "uint 12345");
    # --- _sess_role_literal maps to STABLE literals (append stores the ptr uncopied) ---
    assert(streq(_sess_role_literal("assistant", 9), "assistant") == 1, "role literal: assistant");
    assert(streq(_sess_role_literal("user", 4), "user") == 1, "role literal: user");
    assert(streq(_sess_role_literal("weird", 5), "user") == 1, "unknown role -> user");

    # --- save -> clear -> load round-trip, incl. multi-line content (length-prefixed, no escaping) ---
    session_history_clear();
    session_history_append("user", "hello there", 11);
    session_history_append("assistant", "hi! line1\nline2", 15);   # embedded newline
    session_history_append("user", "bye", 3);
    assert_eq(session_history_len(), 3, "3 messages in memory");
    assert_eq(_sess_write_file("/tmp/thoth_sess_test"), 0, "write file ok");
    session_history_clear();
    assert_eq(session_history_len(), 0, "cleared in memory");
    assert_eq(_sess_load_file("/tmp/thoth_sess_test"), 3, "loaded 3 records");
    assert_eq(session_history_len(), 3, "3 messages restored");
    assert(streq(session_history_role(0), "user") == 1, "msg0 role user");
    assert(streq(session_history_content(0), "hello there") == 1, "msg0 content round-trips");
    assert(streq(session_history_role(1), "assistant") == 1, "msg1 role assistant");
    assert(streq(session_history_content(1), "hi! line1\nline2") == 1, "msg1 MULTI-LINE content survives (length-prefixed)");
    assert(streq(session_history_content(2), "bye") == 1, "msg2 content round-trips");

    # --- a foreign / corrupt first line -> load skipped (0), nothing corrupted ---
    var fd = file_open("/tmp/thoth_sess_bad", O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    file_write(fd, "NOT-A-SESSION\nuser\t3\nabc\n", 25);
    file_close(fd);
    session_history_clear();
    assert_eq(_sess_load_file("/tmp/thoth_sess_bad"), 0, "foreign magic -> load skipped");
    assert_eq(session_history_len(), 0, "nothing loaded from a foreign file");
    assert_eq(_sess_load_file("/tmp/thoth_no_such_sess_zzz"), 0, "absent file -> 0 (no crash)");

    # --- sess_persist_init end-to-end: load + activate; a later save rewrites the window ---
    session_history_clear();
    session_history_append("user", "q1", 2);
    session_history_append("assistant", "a1", 2);
    _sess_write_file("/tmp/thoth_sess_init");
    session_history_clear();
    assert_eq(sess_persist_init("/tmp/thoth_sess_init"), 2, "init resumed 2 messages");
    assert_eq(sess_persist_active(), 1, "init activated persistence");
    assert_eq(sess_persist_resumed(), 2, "resumed count = 2");
    session_history_append("user", "q2", 2);
    session_history_append("assistant", "a2", 2);   # would trigger sess_persist_save() live; call it explicitly
    sess_persist_save();
    session_history_clear();
    assert_eq(_sess_load_file("/tmp/thoth_sess_init"), 4, "the save persisted all 4 messages");

    # --- the reported resume count is capped at what survives SESS_HIST_MAX=40 (review-caught fix) ---
    var fd2 = file_open("/tmp/thoth_sess_big", O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    file_write(fd2, "THOTH-SESSION-1\n", 16);
    var rec = 0;
    while (rec < 42) { file_write(fd2, "user\t1\nx\n", 9); rec = rec + 1; }   # 42 one-byte records
    file_close(fd2);
    session_history_clear();
    var big = sess_persist_init("/tmp/thoth_sess_big");
    assert_eq(session_history_len(), 40, "history capped at SESS_HIST_MAX=40");
    assert_eq(big, 40, "reported resumed count capped at 40 (not the 42 parsed)");
    assert_eq(sess_persist_resumed(), 40, "sess_persist_resumed() == 40");

    _sess_path = 0;                # deactivate so later tests' assistant-appends don't write a file
    session_history_clear();       # leave a clean history for subsequent tests
    return 0;
}

fn _t_secs_line(ms, expect) {   # emit _task_emit_secs(ms) to the feed ring; 1 if row 0 contains `expect`
    feed_init();
    out_mode_set(OUT_RING);
    _task_emit_secs(ms);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    return _t_count_sub(feed_line_ptr(0), feed_line_len(0), expect, strlen(expect));
}

fn test_ui_niceties() {
    test_group("turn niceties ([ui] bell/elapsed, 0.24.3)");
    # --- _task_emit_secs: milliseconds -> "N.Ns" (one decimal), clamped at 0 ---
    assert_eq(_t_secs_line(3200, "3.2s"), 1, "3200ms -> 3.2s");
    assert_eq(_t_secs_line(800, "0.8s"), 1, "800ms -> 0.8s");
    assert_eq(_t_secs_line(0, "0.0s"), 1, "0ms -> 0.0s");
    assert_eq(_t_secs_line(0 - 5, "0.0s"), 1, "negative -> 0.0s (clamped)");
    assert_eq(_t_secs_line(65900, "65.9s"), 1, "65900ms -> 65.9s");

    # --- _task_turn_feedback: interactive-only, and only when [ui].elapsed is on ---
    _cfg_ui_bell = 0; _cfg_ui_elapsed = 1;
    one_shot_set(1);                              # one-shot -> suppressed (clean output)
    feed_init(); out_mode_set(OUT_RING); _task_turn_feedback(clock_now_ms()); feed_flush_pending(); out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 0, "one-shot: no turn feedback emitted");
    one_shot_set(0);                             # interactive -> the elapsed line prints
    feed_init(); out_mode_set(OUT_RING); _task_turn_feedback(clock_now_ms()); feed_flush_pending(); out_mode_set(OUT_FD1);
    assert(feed_count() >= 1, "interactive + [ui].elapsed: an elapsed line is emitted");
    assert_eq(_t_count_sub(feed_line_ptr(0), feed_line_len(0), "s)", 2), 1, "the elapsed line is a (…s) form");

    # both off -> nothing, even interactive (byte-identical floor)
    _cfg_ui_bell = 0; _cfg_ui_elapsed = 0;
    feed_init(); out_mode_set(OUT_RING); _task_turn_feedback(clock_now_ms()); feed_flush_pending(); out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 0, "both off: no feedback (floor unchanged)");
    return 0;
}

fn test_reload() {
    test_group("/reload config (agent tool-cache reset, 0.24.4)");
    # agent_tools_cache_reset drops the session-stable tool cache so the next turn re-advertises — the
    # mechanism /reload relies on to pick up a changed [shell].enabled / [hoosh].tools. (cmd_reload itself
    # re-reads thoth.cyml, which is gitignored/absent in CI, so it is live-verified, not unit-tested here.)
    _agent_tools_ready = 1; _agent_tools_len = 42;
    agent_tools_cache_reset();
    assert_eq(_agent_tools_ready, 0, "reset clears the tool-ready flag (re-advertise next turn)");
    assert_eq(_agent_tools_len, 0, "reset clears the cached tool length");
    # config_load re-run must be safe (the reload re-parses in place). It degrades gracefully on an
    # absent/unreadable file (keeps prior state); reaching the next assertion proves it did not crash.
    config_load();
    assert_eq(_agent_tools_ready, 0, "config_load re-run did not spuriously rebuild the tool cache");
    return 0;
}

fn test_role() {
    test_group("role modality (persona aspects + /role, 0.24.5)");
    persona_set(egyptian_thoth());              # pristine default (persona_set resets aspect+override)
    assert(streq(persona_role(), "the Librarian") == 1, "default Thoth role = the Librarian");
    # select an aspect -> the role follows (avatara-sourced, not thoth-authored)
    var mi = aspect_index_by_name("measurer");
    assert(mi >= 0, "measurer aspect exists in avatara");
    persona_role_select_aspect(mi);
    assert(streq(persona_role(), "the Measurer") == 1, "select measurer -> role 'the Measurer'");
    assert_eq(persona_role_is_override(), 0, "an aspect selection is not a custom override");
    assert_eq(persona_aspect(), mi, "active aspect = measurer");
    # a custom user label trumps the aspect (make anyone anything)
    persona_role_override_set("Keeper of Symbols");
    assert(streq(persona_role(), "Keeper of Symbols") == 1, "custom override role wins");
    assert_eq(persona_role_is_override(), 1, "override flag set");
    assert(_ui_contains(persona_system_prompt(), "Keeper of Symbols") == 1, "system prompt carries the active role (steers the model)");
    # reset -> back to the archetype default
    persona_role_reset();
    assert(streq(persona_role(), "the Librarian") == 1, "reset -> default role");
    assert_eq(persona_role_is_override(), 0, "reset clears the override");
    # a persona switch resets the role state to the new archetype's dominant aspect
    persona_role_override_set("Temp");
    persona_set(egyptian_thoth());
    assert_eq(persona_role_is_override(), 0, "persona switch clears a custom override");
    assert_eq(persona_aspect(), profile_dominant_aspect(persona_profile()), "switch -> dominant aspect is the active default");
    # a NON-Thoth archetype's default role derives from its dominant aspect (0.24.5 change; was desc)
    var od = find_and_validate("Odin");
    if (is_err_result(od) == 0) {
        persona_set(result_unwrap(od));
        assert(streq(persona_role(), aspect_role(profile_dominant_aspect(persona_profile()))) == 1, "switched persona default role = its dominant aspect");
    }
    # out-of-range aspect select is a safe no-op
    persona_set(egyptian_thoth());
    assert_eq(persona_role_select_aspect(999), 0, "OOB aspect select refused");
    assert_eq(persona_role_select_aspect(0 - 1), 0, "negative aspect select refused");
    persona_role_reset();                       # leave a clean default for later tests
    return 0;
}

# _gui_ppm_dump: write an XRGB8888 buffer to a P6 PPM for visual inspection (test artifact).
fn _gui_ppm_dump(buf, w, h, path) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (fd < 0) { return 0; }
    var hdr = alloc(64);
    var o = 0;
    store8(hdr + o, 80); o = o + 1; store8(hdr + o, 54); o = o + 1; store8(hdr + o, 10); o = o + 1;   # "P6\n"
    o = o + fmt_int_buf(w, hdr + o);
    store8(hdr + o, 32); o = o + 1;
    o = o + fmt_int_buf(h, hdr + o);
    store8(hdr + o, 10); o = o + 1;
    store8(hdr + o, 50); o = o + 1; store8(hdr + o, 53); o = o + 1; store8(hdr + o, 53); o = o + 1; store8(hdr + o, 10); o = o + 1;   # "255\n"
    file_write(fd, hdr, o);
    var n = w * h;
    var rgb = alloc(n * 3);
    var i = 0;
    while (i < n) {
        var px = load32(buf + i * 4);
        store8(rgb + i * 3, (px / 65536) & 255);
        store8(rgb + i * 3 + 1, (px / 256) & 255);
        store8(rgb + i * 3 + 2, px & 255);
        i = i + 1;
    }
    file_write(fd, rgb, n * 3);
    file_close(fd);
    return 1;
}

fn test_gui() {
    test_group("GUI draw pipeline (gdraw/graster/gstatus, 0.29.0)");
    # --- draw-command builders ---
    var cmds = gd_list_new();
    gd_push_rect(cmds, 1, 2, 3, 4, 0x112233);
    assert_eq(vec_len(cmds), 1, "one command pushed");
    var c = vec_get(cmds, 0);
    assert_eq(gd_kind(c), GD_RECT, "kind RECT");
    assert_eq(gd_x(c), 1, "x"); assert_eq(gd_y(c), 2, "y");
    assert_eq(gd_w(c), 3, "w"); assert_eq(gd_h(c), 4, "h");
    assert_eq(gd_color(c), 0x112233, "color stored");
    # --- rasterize fill_rect into a 20x10 fb ---
    var W = 20; var H = 10;
    var fb = gr_fb_new(W, H);
    gr_fb_clear(fb, W, H, 0x000000);
    gr_clip_reset();
    gr_fb_fill_rect(fb, W, H, 2, 3, 4, 4, 0xFF0000);
    assert_eq(load32(fb + (3 * W + 2) * 4), 0xFF0000, "fill_rect top-left pixel red");
    assert_eq(load32(fb + (6 * W + 5) * 4), 0xFF0000, "fill_rect bottom-right pixel red");
    assert_eq(load32(fb + (3 * W + 6) * 4), 0x000000, "just past the rect stays bg");
    assert_eq(load32(fb + 0), 0x000000, "untouched corner stays bg");
    # --- border: a 1px outline leaves the interior bg ---
    gr_fb_clear(fb, W, H, 0x000000);
    gr_fb_border(fb, W, H, 1, 1, 6, 6, 0x00FF00);
    assert_eq(load32(fb + (1 * W + 1) * 4), 0x00FF00, "border top-left corner set");
    assert_eq(load32(fb + (3 * W + 3) * 4), 0x000000, "border interior stays bg");
    # --- glyph: rasterize 'A' (65) and confirm it lit AND cleared some pixels ---
    var W2 = 8; var H2 = 16;
    var gb = gr_fb_new(W2, H2);
    gr_fb_clear(gb, W2, H2, 0x000000);
    gr_ensure_font();
    gr_fb_glyph(gb, W2, H2, 0, 0, 65, 0xFFFFFF);
    var lit = 0; var clear = 0; var k = 0;
    while (k < W2 * H2) {
        if (load32(gb + k * 4) == 0xFFFFFF) { lit = lit + 1; } else { clear = clear + 1; }
        k = k + 1;
    }
    assert(lit > 0, "glyph 'A' set at least one pixel");
    assert(clear > 0, "glyph 'A' left some pixels clear (not a solid block)");
    # --- codepoint width (the layout pen must match the raster pen for non-ASCII) ---
    assert_eq(gr_text_cols("main", 0), 4, "gr_text_cols ASCII == byte count");
    assert_eq(gr_text_cols("caf\xc3\xa9", 0), 4, "gr_text_cols 'cafe-acute' = 4 codepoints (5 bytes)");
    assert_eq(strlen("caf\xc3\xa9"), 5, "the UTF-8 string is 5 bytes (the drift source strlen would use)");
    assert_eq(gr_text_cols("main", 2), 2, "gr_text_cols honors max_cp");
    assert_eq(gr_text_cols(0, 0), 0, "gr_text_cols null-safe");
    # --- the status strip: build from the view-model + rasterize + PPM dump ---
    session_set_model("claude-opus-4");
    var SW = 960; var SH = 34;
    var sb = gr_fb_new(SW, SH);
    var scmds = gd_list_new();
    var endx = gstatus_build(scmds, 0, 0, SW, SH);
    assert(endx > 0, "status strip advanced the pen");
    assert(vec_len(scmds) > 5, "status strip emitted several commands");
    gr_fb_clear(sb, SW, SH, 0x000000);
    gr_raster(scmds, sb, SW, SH);
    assert(load32(sb + (5 * SW + 5) * 4) != 0x000000, "status strip background painted over the clear");
    _gui_ppm_dump(sb, SW, SH, "/tmp/thoth_gui_status.ppm");
    session_set_model(0);
    return 0;
}

fn test_surface() {
    test_group("status view-model (surface.cyr, 0.28.0)");
    # snapshot mirrors the producers + single-sources the omit gates (drift-safety)
    session_set_model("gpt-5");
    status_snapshot();
    assert_eq(status_state(SF_MODEL), 0, "session model set -> STATE 0 (resolved)");
    assert(streq(status_sval(SF_MODEL), "gpt-5") == 1, "model SPTR == the session id");
    session_set_model(0);
    status_snapshot();
    # with no session model, resolution falls back to config; STATE=1 iff BOTH are null
    if (config_hoosh_model() == 0) {
        assert_eq(status_state(SF_MODEL), 1, "no model anywhere -> STATE 1");
        assert_eq(status_sval(SF_MODEL), 0, "no model -> SPTR 0");
    }
    assert_eq(status_ival(SF_TURNS), session_turns(), "turns ival == session_turns()");
    assert_eq(status_present(SF_TOKENS), session_tokens_seen(), "tokens present == session_tokens_seen() (one gate)");
    assert_eq(status_ival(SF_TOKENS), session_tokens(), "tokens ival == session_tokens()");
    assert_eq(status_present(SF_COST), session_cost_seen(), "cost present == session_cost_seen() (one gate)");
    assert_eq(status_ival(SF_COST), session_cost_micro(), "cost ival == session_cost_micro()");
    assert_eq(status_ival2(SF_COST), session_cost_unpriced_count(), "cost ival2 == unpriced count");
    # ctx: the KiB rounding formula, now single-sourced in the producer
    session_history_clear();
    session_history_append("user", "hello there world", 17);
    status_snapshot();
    assert_eq(status_ival(SF_CTX), hoosh_ctx_kib(), "ctx ival == hoosh_ctx_kib() (single-sourced)");
    assert_eq(status_ival(SF_CTX), (hoosh_ctx_bytes() + 512) / 1024, "ctx ival == the KiB rounding formula");
    assert_eq(status_ival2(SF_CTX), hoosh_ctx_budget_kib(), "ctx budget ival2 == hoosh_ctx_budget_kib()");
    assert_eq(status_state(SF_CTX), hoosh_ctx_evicted(), "ctx STATE == evicted count");
    # health enum tracks hoosh_health()
    hoosh_health_mark_down();
    status_snapshot();
    assert_eq(status_state(SF_HEALTH), HOOSH_HEALTH_DOWN, "health STATE == DOWN after mark_down");
    hoosh_health_mark_up();
    status_snapshot();
    assert_eq(status_state(SF_HEALTH), HOOSH_HEALTH_UP, "health STATE == UP after mark_up");
    # git mirrors the producer cache
    git_probe();
    status_snapshot();
    assert_eq(status_present(SF_GIT), git_present(), "git present == git_present()");
    assert_eq(status_ival(SF_GIT), git_dirty(), "git ival == git_dirty()");
    # surface / theme name pointers
    status_snapshot();
    assert(streq(status_sval(SF_SURFACE), ui_tier_name()) == 1, "surface sval == ui_tier_name()");
    assert(streq(status_sval(SF_THEME), ui_theme_name()) == 1, "theme sval == ui_theme_name()");
    # restore shared globals for any later test
    session_set_model(0);
    session_history_clear();
    return 0;
}

