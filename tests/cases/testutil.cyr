# tests/cases/testutil.cyr — SHARED pure test helpers (byte-buffer escape/count utilities, no module deps).
# Included by the render / tui / core domain test binaries (0.30.9).


# --- mdhl (0.15.1) test helpers -------------------------------------------
# _t_has_esc: 1 if src[0..len) contains an ESC (0x1b) byte.
fn _t_has_esc(ptr, len) {
    var i = 0;
    while (i < len) {
        if (load8(ptr + i) == 27) { return 1; }
        i = i + 1;
    }
    return 0;
}

# _t_strip_sgr: copy src[0..len) into dst, dropping whole ESC sequences (reusing the
# feed's escape-length scanner); nul-terminate. Recovers the visible text so a coverage
# check (strip_sgr(output) == input) proves _hl_span never dropped/reordered a byte.
fn _t_strip_sgr(dst, src, len) {
    var i = 0;
    var w = 0;
    while (i < len) {
        if (load8(src + i) == 27) { i = i + _feed_esc_len(src, i, len); }
        else { store8(dst + w, load8(src + i)); w = w + 1; i = i + 1; }
    }
    store8(dst + w, 0);
    return w;
}

# _t_count_sub: number of (possibly overlapping) occurrences of needle[0..m) in hay[0..n).
fn _t_count_sub(hay, n, needle, m) {
    if (m <= 0) { return 0; }
    var i = 0;
    var c = 0;
    while ((i + m) <= n) {
        var k = 0;
        var eq = 1;
        while ((k < m) && (eq == 1)) { if (load8(hay + i + k) != load8(needle + k)) { eq = 0; } k = k + 1; }
        if (eq == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# _canary_ok: 1 if all `n` bytes at `p` are still the 209 sentinel; else 0. Used by the 0.39.0 A-6
# buffer-saturation tests, where the overflow to catch is only a few bytes wide, so the canary has to
# start at the FIRST byte past the cap rather than at some comfortable distance beyond it.
fn _canary_ok(p, n) {
    var i = 0;
    while (i < n) { if (load8(p + i) != 209) { return 0; } i = i + 1; }
    return 1;
}
