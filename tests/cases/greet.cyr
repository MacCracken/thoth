# tests/cases/greet.cyr — the startup greeting block (0.45.3): src/greet.cyr's model + layout + piece walker,
# and the TUI leaf (tui_greeting_emit) captured under OUT_RING. The GUI leaf is covered in tests/cases/gui.cyr.

# _tg_row_text: concatenate row r's span texts into dst (cap bytes); returns the length. The reference for the
# "pieces reproduce the row" invariant.
fn _tg_row_text(r, dst, cap) {
    var o = 0;
    var k = 0;
    while (k < greet_row_spans(r)) {
        var t = greet_span_text(r, k);
        var n = strlen(t);
        if ((o + n) < cap) { var i = 0; while (i < n) { store8(dst + o + i, load8(t + i)); i = i + 1; } o = o + n; }
        k = k + 1;
    }
    store8(dst + o, 0);
    return o;
}

# _tg_pieces_text: walk EVERY physical row of logical row r and concatenate the pieces' bytes into dst; also
# checks each physical row's columns stay within the inner width (returns -1 on a violation).
fn _tg_pieces_text(r, dst, cap) {
    var o = 0;
    var s = 0;
    var bad = 0;
    var segs = greet_row_segs(r);
    while (s < segs) {
        greet_seg_begin(r, s);
        var cols = 0;
        while (greet_piece_next() == 1) {
            var n = greet_piece_len();
            if ((o + n) < cap) { var i = 0; while (i < n) { store8(dst + o + i, load8(greet_piece_ptr() + i)); i = i + 1; } o = o + n; }
            cols = cols + greet_piece_cols();
        }
        if (cols > greet_inner()) { bad = 1; }
        s = s + 1;
    }
    store8(dst + o, 0);
    if (bad == 1) { return 0 - 1; }
    return o;
}

# _tg_row_has: 1 if any span of row r is exactly `needle`.
fn _tg_row_has(r, needle) {
    var k = 0;
    while (k < greet_row_spans(r)) { if (streq(greet_span_text(r, k), needle) == 1) { return 1; } k = k + 1; }
    return 0;
}

fn test_greet() {
    println("=== the startup greeting block: model + layout + pieces (greet.cyr, 0.45.3) ===");
    var _t0 = ui_tier();
    var _d0 = ui_color_depth();
    ui_force(PT_PLAIN, CD_NONE);
    persona_role_reset();
    session_set_model(0);

    # --- the model: title, open row, status ---------------------------------------------------------------
    greet_build(1);
    assert_eq(greet_built(), 1, "greet_build marks the model built");
    assert(greet_rows() >= 3, "at least the title, the open row and the status row");
    assert_eq(greet_row_spans(0), 6, "the title row is six spans: owl, persona, ` - `, role, `: `, version");
    assert(streq(greet_span_text(0, 0), "{(o> ") == 1, "the title opens with the owl glyph");
    assert_eq(greet_span_role(0, 0), ROLE_ACCENT, "...in the accent role");
    assert(streq(greet_span_text(0, 1), persona_name()) == 1, "then the persona");
    assert(streq(greet_span_text(0, 3), persona_role_title()) == 1, "the role, title-cased for the title position");
    assert_eq(greet_span_role(0, 3), ROLE_ACCENT_DIM, "...accent-dim");
    assert(streq(greet_span_text(0, 5), thoth_version()) == 1, "the version closes the title");
    assert_eq(greet_span_role(0, 5), ROLE_MUTED, "...muted");
    assert_eq(greet_row_spans(1), 1, "row 1 is the tagline (0.45.3)");
    assert(streq(greet_span_text(1, 0), persona_tagline()) == 1, "...the backronym, under the title");
    assert_eq(greet_span_role(1, 0), ROLE_MUTED, "...muted");
    assert_eq(greet_row_spans(2), 0, "row 2 is the open line (a row with no spans)");
    assert(streq(greet_span_text(3, 0), "Status: ") == 1, "row 3 is the status row");
    assert_eq(greet_span_role(3, 0), ROLE_FAINT, "the `Status: ` label is faint");
    # the honesty rules (0.26.0): READY only when a CONFIGURED gateway answered — whichever state this test
    # process is in, `up` must be reported against it, never off the localhost default
    # 0.45.3: the line under `Status:` names the component at its address, in the MARK's colour
    if (config_hoosh_configured() == 1) {
        assert(streq(greet_span_text(3, 1), "READY") == 1, "a configured gateway that answered -> READY");
        assert_eq(greet_span_role(3, 1), ROLE_GREEN, "...green");
        assert(streq(greet_span_text(4, 0), "hoosh @ ") == 1, "...and the address line follows");
        assert(streq(greet_span_text(4, 1), config_hoosh_url()) == 1, "...naming the url");
        assert_eq(greet_span_role(4, 0), ROLE_GREEN, "...in the mark's green");
        assert_eq(greet_span_role(4, 1), ROLE_GREEN, "...the url too");
        assert_eq(greet_row_spans(4), 2, "...and nothing after the url when it answered");
        greet_build(0);
        assert(streq(greet_span_text(3, 1), "hoosh unreachable") == 1, "a configured gateway that did not answer -> unreachable");
        assert_eq(greet_span_role(3, 1), ROLE_RED, "...red");
        assert(streq(greet_span_text(4, 0), "hoosh @ ") == 1, "...the address line follows");
        assert(streq(greet_span_text(4, 1), config_hoosh_url()) == 1, "...naming the url");
        assert(streq(greet_span_text(4, 2), " (not found)") == 1, "...marked (not found)");
        assert_eq(greet_span_role(4, 0), ROLE_RED, "...in the SAME red as the mark");
        assert_eq(greet_span_role(4, 2), ROLE_RED, "...all of it");
        assert_eq(greet_row_spans(5), 0, "an open row between the status group and the model");
        assert(streq(greet_span_text(6, 0), "model ") == 1, "a configured gateway -> the model row follows");
        assert(streq(greet_span_text(6, 1), _hoosh_model()) == 1, "...with the model in play");
        if (config_parse_ok() == 1) {
            assert_eq(greet_row_spans(7), 0, "an open row between the model and the config");
            assert(streq(greet_span_text(8, 0), "config ") == 1, "...then the config row");
        }
    } else {
        assert(streq(greet_span_text(3, 1), "READY") == 0, "no configured gateway -> never READY, even when the default answered");
        assert_eq(greet_span_role(3, 1), ROLE_RED, "...the status is red");
        assert_eq(memeq(greet_span_text(4, 0), "hoosh @ (unset)", 15), 1, "...the address line says the url is unset");
        assert_eq(greet_span_role(4, 0), ROLE_RED, "...in the mark's red");
        assert_eq(_tg_row_has(4, "  [default "), 1, "...but the reachable default is NOTED, on the address line");
        greet_build(0);
        assert_eq(_tg_row_has(4, "  [default "), 0, "no answer -> no `[default … is reachable]` note");
        # no model row without a gateway: the row after the status group is the config group or nothing
        var _nr = greet_rows();
        var _r = 5;
        while (_r < _nr) { if (greet_row_spans(_r) > 0) { assert(streq(greet_span_text(_r, 0), "model ") == 0, "no gateway -> no model row"); } _r = _r + 1; }   # 0.51.0: the stores group (the tool-pin row) follows even with no config — skip its open row
        if (config_parse_ok() == 1) {
            assert_eq(greet_row_spans(5), 0, "an open row between the status group and the config");
            assert(streq(greet_span_text(6, 0), "config ") == 1, "...then the config row");
        }
    }
    var _cfg_rows = 0;
    var _cr = 4;
    while (_cr < greet_rows()) { if (greet_row_spans(_cr) > 0) { if (streq(greet_span_text(_cr, 0), "config ") == 1) { _cfg_rows = _cfg_rows + 1; } } _cr = _cr + 1; }
    assert_eq(_cfg_rows, config_parse_ok(), "exactly one config row when a config was read, none otherwise");
    if (config_parse_ok() == 1) {
        var _cfr = 6;
        if (config_hoosh_configured() == 1) { _cfr = 8; }
        assert(streq(greet_span_text(_cfr, 1), config_path_display(config_path())) == 1, "the config row names the file with $HOME folded to ~");
    }
    # the store OWNS its bytes: a span's text is a copy, not the producer's pointer
    assert(greet_span_text(0, 5) != thoth_version(), "the version span is a COPY of thoth_version() (the store owns its bytes)");

    # --- the layout: art choice by columns AND rows --------------------------------------------------------
    greet_layout(100, 35);
    assert_eq(greet_art_w(), 56, "100 cols x 35 rows -> the 56-col ibis (its 31 rows fit; 28 content cols are left)");
    assert_eq(greet_art_rows(), splash_rows(56), "...with its row count");
    assert_eq(greet_box_x(), 58, "the box starts after the art + the 2-col gap");
    assert(greet_inner() <= (100 - 56 - 2 - 4), "the box's inner width fits beside the art");
    assert_eq(greet_total(), 31, "the block is as tall as its taller part (the art)");
    assert_eq(greet_art_y(), 0, "the art is the taller part -> it starts at the top");
    assert_eq(greet_box_y(), (31 - greet_box_rows()) / 2, "the box is centred on the art");
    greet_layout(80, 20);
    assert_eq(greet_art_w(), 32, "80 x 20 -> the 32-col ibis (18 rows) — 40 cols would need 22 rows");
    greet_layout(80, 40);
    assert_eq(greet_art_w(), 40, "80 x 40 -> 40 cols: 48 would leave the box only 22 content cols");
    greet_layout(60, 40);
    assert_eq(greet_art_w(), 0, "60 cols -> no art: even 32 + gap + 28 + frame is 66");
    assert_eq(greet_box_x(), 0, "...so the box starts at the first column");
    assert(greet_inner() <= 56, "...and its inner width is what the grid allows");
    assert_eq(greet_total(), greet_box_rows(), "...and the block is the box");
    greet_layout(200, 10);
    assert_eq(greet_art_w(), 0, "10 rows -> no art (the smallest ibis is 18 rows): never a clipped ibis");
    greet_layout(24, 40);
    assert_eq(greet_inner(), 20, "a 24-col grid -> a 20-col box interior (the frame is 4)");

    # --- the wrap + the piece walker: every physical row within the inner width, bytes reproduced exactly ----
    var _ref[1024];
    var _got[1024];
    var _r2 = 0;
    while (_r2 < greet_rows()) {
        var _rl = _tg_row_text(_r2, &_ref, 1024);
        var _gl = _tg_pieces_text(_r2, &_got, 1024);
        assert(_gl >= 0, "every physical row of a wrapped row stays within the inner width");
        assert_eq(_gl, _rl, "the pieces of a row carry exactly the row's bytes (nothing lost or doubled at a wrap)");
        assert_eq(memeq(&_ref, &_got, _rl), 1, "...in order");
        _r2 = _r2 + 1;
    }
    # a word wrap: the title (34 cols) at a 20-col interior breaks after a space, so no physical row opens mid-word
    greet_seg_begin(0, 1);
    assert_eq(greet_piece_next(), 1, "the title's second physical row has a piece");
    assert(load8(greet_piece_ptr()) != 32, "a wrapped row never opens with the space it broke at");
    if (streq(persona_name(), "Thoth") == 1) {
        # `{(o> Thoth - The Librarian: <ver>` at 20 columns: the word that overflows is `Librarian:` (cols 17..26), so a
        # WORD wrap opens row 2 on it; a char wrap would have opened on `rarian`
        assert_eq(memeq(greet_piece_ptr(), "Librarian", 9), 1, "the break falls before the overflowing word, not inside it");
        assert_eq(greet_piece_len(), 9, "...and the piece is that word's slice of the role span");
    }
    assert(greet_phys_locate(0) == 1, "physical content row 0 exists");
    assert_eq(greet_loc_r(), 0, "...and is the title's first row");
    assert_eq(greet_loc_s(), 0, "...segment 0");
    assert(greet_phys_locate(greet_box_rows() - 2) == 0, "past the last content row -> 0");

    # --- the TUI leaf: one captured line per physical row, every line exactly as wide as the layout says ----
    feed_init();
    out_mode_set(OUT_RING);
    tui_greeting_emit(100, 35);
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), greet_total(), "tui_greeting_emit seeds exactly greet_total() feed lines");
    var _li = 0;
    var _wide = 0;
    while (_li < feed_count()) {
        if (feed_vis(_li) > 100) { _wide = _wide + 1; }
        var _bi = _li - greet_box_y();
        if ((_bi >= 0) && (_bi < greet_box_rows())) {
            assert_eq(feed_vis(_li), 58 + greet_inner() + 4, "a box row is art + gap + frame + interior wide, exactly");
        } else {
            assert_eq(feed_vis(_li), 58, "an art-only row is art + gap wide (padded)");
        }
        _li = _li + 1;
    }
    assert_eq(_wide, 0, "no greeting line is wider than the feed (nothing can soft-wrap under the block)");
    var _top = feed_line_ptr(greet_box_y());
    var _tn = feed_line_len(greet_box_y());
    assert_eq(_t_count_sub(_top, _tn, "┌", 3), 1, "the box's top border opens with ┌");
    assert_eq(_t_count_sub(_top, _tn, "┐", 3), 1, "...and closes with ┐");
    var _tl = feed_line_ptr(greet_box_y() + 1);
    var _tln = feed_line_len(greet_box_y() + 1);
    assert_eq(_t_count_sub(_tl, _tln, "│ {(o> ", 8), 1, "the title row is the first content row, behind `│ `");
    assert_eq(_t_count_sub(_tl, _tln, thoth_version(), strlen(thoth_version())), 1, "...carrying the version");
    # the tagline sits directly under the title's last physical row; it word-wraps at this interior (38 < 48 cols)
    var _tgr = greet_box_y() + 1 + greet_row_segs(0);
    var _tg = feed_line_ptr(_tgr);
    var _tgn = feed_line_len(_tgr);
    assert_eq(_t_count_sub(_tg, _tgn, persona_tagline(), 15), 1, "the tagline sits directly under the title (0.45.3)");
    assert(greet_row_segs(1) >= 2, "...wrapped at a 38-col interior (the backronym is 48 cols)");
    var _olr = _tgr + greet_row_segs(1);
    var _ol = feed_line_ptr(_olr);
    var _oln = feed_line_len(_olr);
    assert_eq(_t_count_sub(_ol, _oln, "│", 3), 2, "then the open row — an empty framed row — before the status");
    assert_eq(feed_vis(_olr), 58 + greet_inner() + 4, "...framed to the full box width");
    assert_eq(_t_count_sub(_ol, _oln, "Status", 6), 0, "...with nothing on it");
    var _bot = feed_line_ptr(greet_box_y() + greet_box_rows() - 1);
    var _botn = feed_line_len(greet_box_y() + greet_box_rows() - 1);
    assert_eq(_t_count_sub(_bot, _botn, "└", 3), 1, "the bottom border");
    var _a0 = feed_line_ptr(0);
    assert(load8(_a0) < 128, "row 0 is an art row (the art is the taller block) — a ramp byte or a space, not a frame glyph");
    # the art's bytes are the generated table's, verbatim (PT_PLAIN: no escapes to strip)
    var _row0 = splash_row(56, 0);
    assert_eq(memeq(_a0, _row0, strlen(_row0)), 1, "art row 0 reproduces the splash table's row 0");
    # no art: the box alone from column 0
    feed_init();
    out_mode_set(OUT_RING);
    tui_greeting_emit(40, 10);
    out_mode_set(OUT_FD1);
    assert_eq(greet_art_w(), 0, "40 x 10 -> no art");
    assert_eq(feed_count(), greet_box_rows(), "...the block is the box");
    assert_eq(_t_count_sub(feed_line_ptr(0), feed_line_len(0), "┌", 3), 1, "...opening with the top border in column 0");
    assert_eq(feed_vis(0), 40, "...spanning the whole 40-col grid (inner 36 + frame 4)");

    # --- 0.48.0 (F3): the session row — what a bound [session].file resumed, or that it could not be written ---
    var _sp = _sess_path; var _sr = _sess_resumed; var _sf = _sess_init_failed;
    _sess_path = 0; _sess_resumed = 0; _sess_init_failed = 0;
    greet_build(1);
    var _r = 0; var _hit = 0;
    while (_r < greet_rows()) { if (_tg_row_has(_r, "session ") == 1) { _hit = 1; } if (_tg_row_has(_r, "session file not writable") == 1) { _hit = 1; } _r = _r + 1; }
    assert_eq(_hit, 0, "persistence off: no session row (nothing to say)");
    var _base = greet_rows();
    _sess_path = "/home/someone/.thoth_session"; _sess_resumed = 0;
    greet_build(1);
    assert_eq(greet_rows(), _base, "bound but nothing resumed (an empty store): still no row");
    _sess_resumed = 12;
    greet_build(1);
    _r = 0; var _srow = 0 - 1;
    while (_r < greet_rows()) { if (_tg_row_has(_r, "session ") == 1) { _srow = _r; } _r = _r + 1; }
    assert(_srow > 0, "bound and resumed: a session row");
    assert_eq(greet_row_spans(_srow - 1), 0, "...under an open row (its own group)");
    assert(streq(greet_span_text(_srow, 0), "session ") == 1, "...the faint label first");
    assert_eq(greet_span_role(_srow, 0), ROLE_FAINT, "...faint");
    var _rt[256];
    _tg_row_text(_srow, &_rt, 256);
    assert(streq(&_rt, "session resumed 12 messages from /home/someone/.thoth_session") == 1, "...`session resumed 12 messages from <path>`");
    _sess_init_failed = 1;
    greet_build(1);
    _r = 0; var _frow = 0 - 1;
    while (_r < greet_rows()) { if (_tg_row_has(_r, "session file not writable") == 1) { _frow = _r; } _r = _r + 1; }
    assert(_frow > 0, "an unwritable session file: the red row instead");
    assert_eq(greet_span_role(_frow, 0), ROLE_RED, "...red");
    _tg_row_text(_frow, &_rt, 256);
    assert(streq(&_rt, "session file not writable — resume disabled") == 1, "...`session file not writable — resume disabled`");
    _r = 0; _hit = 0;
    while (_r < greet_rows()) { if (_tg_row_has(_r, "session ") == 1) { _hit = 1; } _r = _r + 1; }
    assert_eq(_hit, 0, "...and no resumed row beside it");
    _sess_init_failed = 2;
    greet_build(1);
    _r = 0; _frow = 0 - 1;
    while (_r < greet_rows()) { if (_tg_row_has(_r, "session file larger than thoth can load") == 1) { _frow = _r; } _r = _r + 1; }
    assert(_frow > 0, "a store larger than the load buffer: its own red row");
    _tg_row_text(_frow, &_rt, 256);
    assert(streq(&_rt, "session file larger than thoth can load — resume disabled (nothing is written back)") == 1, "...saying nothing is written back");
    # the session group sits AFTER the config group and its red warnings (which stay directly under the config row —
    # or under the two-layer rule row, 0.49.0: `local wins per key; /state shows both` on its own row, no parentheses)
    _sess_init_failed = 0; _sess_resumed = 3;
    var _un0 = _cfg_unknown_n;
    _cfg_unknown_n = 1;
    greet_build(1);
    _r = 0; var _crow = 0 - 1; var _wrow = 0 - 1; _srow = 0 - 1; var _lrow = 0 - 1;
    while (_r < greet_rows()) {
        if (_tg_row_has(_r, "config ") == 1) { _crow = _r; }
        if (_tg_row_has(_r, "config: ") == 1) { _wrow = _r; }
        if (_tg_row_has(_r, "session ") == 1) { _srow = _r; }
        if (_tg_row_has(_r, "local wins per key; /state shows both") == 1) { _lrow = _r; }
        _r = _r + 1;
    }
    assert((_wrow > 0) && (_srow > 0), "premise: the config warning and the session row are both built");
    if (_crow >= 0) {
        if (_lrow >= 0) {
            assert_eq(_lrow, _crow + 1, "two layers: the rule sits on its own row directly under the config row");
            assert_eq(greet_row_spans(_lrow), 1, "...one faint span, no parentheses");
            assert_eq(greet_span_role(_lrow, 0), ROLE_FAINT, "...faint");
            assert_eq(_wrow, _lrow + 1, "...and the red config warning directly under that");
        } else { assert_eq(_wrow, _crow + 1, "the red config warning sits directly under the config row"); }
    }
    else { assert(1, "(no config parsed in this process — the config row is absent, so only the order below is checked)"); }
    assert(_srow > _wrow, "...and the session row comes after the warning");
    _r = 0; _hit = 0;
    while (_r < greet_rows()) { if (_tg_row_has(_r, " (local wins per key; /state shows both)") == 1) { _hit = 1; } _r = _r + 1; }
    assert_eq(_hit, 0, "the parenthesised form is gone");
    assert_eq(greet_row_spans(_srow - 1), 0, "...under its own open row");
    _cfg_unknown_n = _un0;
    # the two-layer rule row, driven through the config seams (core.cyr's idiom) so it runs on every machine: a
    # local layer over a global one -> `config <local> + <global>`, then `local wins per key; /state shows both`
    # on the row under it, one faint span, no parentheses
    var _gp = "/tmp/thoth_t_greet_global.cyml";
    var _lp = "/tmp/thoth_t_greet_local.cyml";
    var _ft = alloc(128);
    var _fo = _append_cstr_cap(_ft, 0, 128, "[hoosh]\nurl = \"http://127.0.0.1:8088\"\n");
    file_write_all(_gp, _ft, _fo);
    _fo = _append_cstr_cap(_ft, 0, 128, "[hoosh]\nmodel = \"m\"\n");
    file_write_all(_lp, _ft, _fo);
    _cfg_gpath_c = _gp; _cfg_gpath_done = 1;
    _cfg_lpath_c = _lp; _cfg_lpath_done = 1; _cfg_lsource = 1;
    config_load();
    assert_eq(config_parse_ok(), 1, "premise: the two fixture layers loaded");
    assert((config_global_path() != 0) && (config_local_path() != 0), "premise: both layers are known");
    greet_build(1);
    _r = 0; _crow = 0 - 1; _lrow = 0 - 1;
    while (_r < greet_rows()) {
        if (_tg_row_has(_r, "config ") == 1) { _crow = _r; }
        if (_tg_row_has(_r, "local wins per key; /state shows both") == 1) { _lrow = _r; }
        _r = _r + 1;
    }
    assert(_crow >= 0, "two layers: the config row is built");
    assert(_lrow >= 0, "...and the rule row");
    assert_eq(_lrow, _crow + 1, "...directly under the config row (0.49.0: its own row, never a wrap mid-parenthesis)");
    assert_eq(greet_row_spans(_lrow), 1, "...one span");
    assert_eq(greet_span_role(_lrow, 0), ROLE_FAINT, "...faint");
    _tg_row_text(_crow, &_rt, 256);
    assert_eq(_t_count_sub(&_rt, strlen(&_rt), " + ", 3), 1, "...the config row names both layers with ` + `");
    assert_eq(_t_count_sub(&_rt, strlen(&_rt), "(", 1), 0, "...and carries no parenthesised rule any more");
    _cfg_gpath_c = 0; _cfg_gpath_done = 0; _cfg_lpath_c = 0; _cfg_lpath_done = 0; _cfg_lsource = 0; _cfg_path_c = 0;
    config_load();
    if (_cfg_parse_any == 0) { _cfg_hoosh_url = 0; _cfg_hoosh_model = 0; }   # no real layer (CI)
    xunlink(_gp); xunlink(_lp);
    # the path is cleaned on its way into the box (the TUI paints greeting spans as raw bytes)
    _sess_path = "/home/some\x1b[7mone/.thoth_session"; _sess_resumed = 2;
    greet_build(1);
    _r = 0; _srow = 0 - 1;
    while (_r < greet_rows()) { if (_tg_row_has(_r, "session ") == 1) { _srow = _r; } _r = _r + 1; }
    _tg_row_text(_srow, &_rt, 256);
    assert_eq(_t_count_sub(&_rt, strlen(&_rt), "\x1b", 1), 0, "an escape in the configured path never reaches the greeting store");
    assert_eq(_t_count_sub(&_rt, strlen(&_rt), "some?[7mone", 11), 1, "...it reads as '?'");
    _sess_path = _sp; _sess_resumed = _sr; _sess_init_failed = _sf;
