# tests/cases/gui.cyr — GUI: the T3 draw pipeline + view-builders (gdraw/graster/gstatus/ginput/gtree/gfeed) + the status view-model (surface).
# Split out of tests/thoth.tcyr (0.30.7). Included by the thoth.tcyr driver AFTER the src modules
# (and after helpers.cyr); the driver's main() calls these. Harness auto-resolves from lib/assert.cyr.



# _gui_ppm_dump: write an XRGB8888 buffer to a P6 PPM for visual inspection (test artifact).
fn _gui_ppm_dump(buf, w, h, path) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (fd < 0) { return 0; }
    var hdr = alloc(64);
    var o = 0;
    store8(hdr + o, 80); o = o + 1; store8(hdr + o, 54); o = o + 1; store8(hdr + o, 10); o = o + 1;   # "P6\n"
    o = o + fmt_int_buf(w, hdr + o);
    store8(hdr + o, 32); o = o + 1;
    o = o + fmt_int_buf(h, hdr + o);
    store8(hdr + o, 10); o = o + 1;
    store8(hdr + o, 50); o = o + 1; store8(hdr + o, 53); o = o + 1; store8(hdr + o, 53); o = o + 1; store8(hdr + o, 10); o = o + 1;   # "255\n"
    file_write(fd, hdr, o);
    var n = w * h;
    var rgb = alloc(n * 3);
    var i = 0;
    while (i < n) {
        var px = load32(buf + i * 4);
        store8(rgb + i * 3, (px / 65536) & 255);
        store8(rgb + i * 3 + 1, (px / 256) & 255);
        store8(rgb + i * 3 + 2, px & 255);
        i = i + 1;
    }
    file_write(fd, rgb, n * 3);
    file_close(fd);
    return 1;
}

fn test_gui() {
    test_group("GUI draw pipeline (gdraw/graster/gstatus, 0.29.0)");
    # --- draw-command builders ---
    var cmds = gd_list_new();
    gd_push_rect(cmds, 1, 2, 3, 4, 0x112233);
    assert_eq(vec_len(cmds), 1, "one command pushed");
    var c = vec_get(cmds, 0);
    assert_eq(gd_kind(c), GD_RECT, "kind RECT");
    assert_eq(gd_x(c), 1, "x"); assert_eq(gd_y(c), 2, "y");
    assert_eq(gd_w(c), 3, "w"); assert_eq(gd_h(c), 4, "h");
    assert_eq(gd_color(c), 0x112233, "color stored");
    # --- rasterize fill_rect into a 20x10 fb ---
    var W = 20; var H = 10;
    var fb = gr_fb_new(W, H);
    gr_fb_clear(fb, W, H, 0x000000);
    gr_clip_reset();
    gr_fb_fill_rect(fb, W, H, 2, 3, 4, 4, 0xFF0000);
    assert_eq(load32(fb + (3 * W + 2) * 4), 0xFF0000, "fill_rect top-left pixel red");
    assert_eq(load32(fb + (6 * W + 5) * 4), 0xFF0000, "fill_rect bottom-right pixel red");
    assert_eq(load32(fb + (3 * W + 6) * 4), 0x000000, "just past the rect stays bg");
    assert_eq(load32(fb + 0), 0x000000, "untouched corner stays bg");
    # --- border: a 1px outline leaves the interior bg ---
    gr_fb_clear(fb, W, H, 0x000000);
    gr_fb_border(fb, W, H, 1, 1, 6, 6, 0x00FF00);
    assert_eq(load32(fb + (1 * W + 1) * 4), 0x00FF00, "border top-left corner set");
    assert_eq(load32(fb + (3 * W + 3) * 4), 0x000000, "border interior stays bg");
    # --- glyph: rasterize 'A' (65) and confirm it lit AND cleared some pixels ---
    var W2 = 8; var H2 = 16;
    var gb = gr_fb_new(W2, H2);
    gr_fb_clear(gb, W2, H2, 0x000000);
    gr_ensure_font();
    gr_fb_glyph(gb, W2, H2, 0, 0, 65, 0xFFFFFF);
    var lit = 0; var clear = 0; var k = 0;
    while (k < W2 * H2) {
        if (load32(gb + k * 4) == 0xFFFFFF) { lit = lit + 1; } else { clear = clear + 1; }
        k = k + 1;
    }
    assert(lit > 0, "glyph 'A' set at least one pixel");
    assert(clear > 0, "glyph 'A' left some pixels clear (not a solid block)");
    # --- codepoint width (the layout pen must match the raster pen for non-ASCII) ---
    assert_eq(gr_text_cols("main", 0), 4, "gr_text_cols ASCII == byte count");
    assert_eq(gr_text_cols("caf\xc3\xa9", 0), 4, "gr_text_cols 'cafe-acute' = 4 codepoints (5 bytes)");
    assert_eq(strlen("caf\xc3\xa9"), 5, "the UTF-8 string is 5 bytes (the drift source strlen would use)");
    assert_eq(gr_text_cols("main", 2), 2, "gr_text_cols honors max_cp");
    assert_eq(gr_text_cols(0, 0), 0, "gr_text_cols null-safe");
    # --- the status strip: build from the view-model + rasterize + PPM dump ---
    session_set_model("claude-opus-4");
    var SW = 960; var SH = 34;
    var sb = gr_fb_new(SW, SH);
    var scmds = gd_list_new();
    var endx = gstatus_build(scmds, 0, 0, SW, SH);
    assert(endx > 0, "status strip advanced the pen");
    assert(vec_len(scmds) > 5, "status strip emitted several commands");
    gr_fb_clear(sb, SW, SH, 0x000000);
    gr_raster(scmds, sb, SW, SH);
    assert(load32(sb + (5 * SW + 5) * 4) != 0x000000, "status strip background painted over the clear");
    _gui_ppm_dump(sb, SW, SH, "/tmp/thoth_gui_status.ppm");
    # --- feed word-wrap: a long paragraph wraps to multiple lines ---
    var wcmds = gd_list_new();
    var yend = _gfeed_para(wcmds, 0, 0, 160, 0xFFFFFF, "the quick brown fox jumps over the lazy dog again and again yet more");
    assert(yend >= 3 * GFEED_LH, "long paragraph wrapped to >= 3 lines at 160px");
    assert(vec_len(wcmds) >= 3, "wrap emitted >= 3 text slices");
    var scmds2 = gd_list_new();
    assert_eq(_gfeed_para(scmds2, 0, 0, 800, 0xFFFFFF, "short"), GFEED_LH, "a short line is exactly one line high");
    assert_eq(_gfeed_para(gd_list_new(), 0, 0, 800, 0xFFFFFF, 0), 0, "null text advances nothing");
    # a wrapping message that STARTS with a space must never emit an uncapped (max_cp 0) slice — otherwise the
    # space-break branch (last_sp_cols == 0) would draw the whole string on line 1 (gr_fb_text: 0 == uncapped).
    var _lz = gd_list_new();
    _gfeed_para(_lz, 0, 0, 80, 0xFFFFFF, " aaaaaaaaaaaaaaaaa bbbbbbbbbbbbbbbbb");
    var _lzu = 0; var _lzi = 0;
    while (_lzi < vec_len(_lz)) {
        if (gd_aux(vec_get(_lz, _lzi)) == 0) { _lzu = _lzu + 1; }
        _lzi = _lzi + 1;
    }
    assert(vec_len(_lz) > 0, "leading-space wrap still emits its wrapped lines");
    assert_eq(_lzu, 0, "leading-space wrap emits NO uncapped slice (empty first segment skipped)");
    # populate a synthetic file tree (0.30.5) so the window-frame PPMs below show the tree pane alongside the feed
    ftree_init(); ftree_reset(); _ftree_set_cwd("/home/macro/Repos/thoth");
    _ftree_append("src", 1, 0); _ftree_append("docs", 1, 0);
    _ftree_append("CHANGELOG.md", 0, 0); _ftree_append("VERSION", 0, 0);
    _ftree_insert_at(1, "gui", 1, 1); _ftree_insert_at(2, "main.cyr", 0, 1); _ftree_insert_at(3, "gfeed.cyr", 0, 1);
    ftree_set_exp(0, 1);
    # --- feed bottom-anchoring (0.30.3): the feed follows the conversation ---
    session_history_clear();
    var _bu = "add a token-bucket rate limiter";
    var _ba = "Plan: scaffold a ratelimit module, implement TokenBucket behind a Mutex, expose try_acquire(n), then add unit tests covering exhaustion, refill-over-time, and an 8-thread contention check. Starting now.";
    var _bi = 0;
    while (_bi < 6) {
        session_history_append("user", _bu, strlen(_bu));
        session_history_append("assistant", _ba, strlen(_ba));
        _bi = _bi + 1;
    }
    var _bn = session_history_len();
    assert_eq(_bn, 12, "seeded a 12-message conversation");
    # measure pass (cmds == 0) emits nothing but covers the identical height a draw pass does
    var _mh = _gfeed_flow(0, 14, 0, 300, _bn);
    var _dl = gd_list_new();
    var _dh = _gfeed_flow(_dl, 14, 0, 300, _bn);
    assert_eq(_mh, _dh, "feed measure height == draw height (wrap parity — the anchor relies on it)");
    assert(vec_len(_dl) > _bn, "the draw pass emitted commands (markers + wrapped slices)");
    assert(_mh > 300, "the 12-message flow overflows a 300px region (exercises the anchor path)");
    # anchor decision: a flow that fits anchors at the top; an overflowing flow anchors to the bottom
    assert_eq(gfeed_anchor_y(50, 0, 400), GFEED_GAP, "a flow that fits anchors at the top");
    assert_eq(gfeed_anchor_y(1000, 0, 400), 400 - 1000, "an overflowing flow anchors bottom (y + h - total)");
    assert(gfeed_anchor_y(1000, 0, 400) < 0, "an overflowing flow starts above the region top (older msgs clip off)");
    # build the feed into a small region and confirm: newest line visible, oldest line clipped above the top
    var _fr = gd_list_new();
    var _fy = 40; var _fh = 200;
    gfeed_build(_fr, 0, _fy, 900, _fh);
    var _minY = 1000000; var _maxY = 0 - 1000000; var _ci = 0;
    while (_ci < vec_len(_fr)) {
        var _cc = vec_get(_fr, _ci);
        if (gd_kind(_cc) == GD_TEXT) {
            var _ty = gd_y(_cc);
            if (_ty < _minY) { _minY = _ty; }
            if (_ty > _maxY) { _maxY = _ty; }
        }
        _ci = _ci + 1;
    }
    assert(_minY < _fy, "oldest feed line is above the region top (clipped by the auto-scroll anchor)");
    assert(_maxY >= _fy, "newest feed line is at/below the region top (on screen)");
    assert(_maxY < _fy + _fh, "newest feed line is within the region bottom (visible)");
    # a rastered overflowing feed frame (visual confirmation the newest exchange sits at the bottom)
    var _abw = 900; var _abh = 300;
    var _abuf = gr_fb_new(_abw, _abh);
    gr_fb_clear(_abuf, _abw, _abh, _gframe_bg());
    gr_raster(gframe_build(_abw, _abh), _abuf, _abw, _abh);
    _gui_ppm_dump(_abuf, _abw, _abh, "/tmp/thoth_gui_anchor.ppm");
    session_history_clear();
    # --- a full window frame with a 2-message conversation -> raster + PPM ---
    session_history_clear();
    var _m1 = "add a token-bucket rate limiter as its own module, thread-safe";
    session_history_append("user", _m1, strlen(_m1));
    var _m2 = "Plan: scaffold a ratelimit module, implement TokenBucket behind a Mutex, expose try_acquire(n), then add tests. Starting now.";
    session_history_append("assistant", _m2, strlen(_m2));
    var FW = 900; var FH = 400;
    var fbuf = gr_fb_new(FW, FH);
    gr_fb_clear(fbuf, FW, FH, 0);
    var frame = gframe_build(FW, FH);
    assert(vec_len(frame) > 8, "frame emitted status + feed + composer commands");
    gr_raster(frame, fbuf, FW, FH);
    _gui_ppm_dump(fbuf, FW, FH, "/tmp/thoth_gui_frame.ppm");
    # a frame with a conversation + a half-typed composer (interactive state) -> PPM
    gcomp_reset();
    var _tu = "add async support to the rate limiter";
    session_history_clear();
    session_history_append("user", _tu, strlen(_tu));
    var _ta = "On it - I'll add an AsyncTokenBucket holding a Notify, so acquire(n) awaits a permit instead of returning false. Keeping the sync API behind a feature flag.";
    session_history_append("assistant", _ta, strlen(_ta));
    var _typed = "and criterion benches";
    var _ti = 0;
    while (load8(_typed + _ti) != 0) { gcomp_append(load8(_typed + _ti)); _ti = _ti + 1; }
    var tbuf = gr_fb_new(FW, FH);
    gr_fb_clear(tbuf, FW, FH, 0);
    gr_raster(gframe_build(FW, FH), tbuf, FW, FH);
    _gui_ppm_dump(tbuf, FW, FH, "/tmp/thoth_gui_typed.ppm");
    gcomp_reset();
    session_history_clear();
    # --- input: evdev keymap + composer buffer (0.32.0) ---
    assert_eq(ginput_ascii(30, 0), 0x61, "evdev 30 -> 'a'");
    assert_eq(ginput_ascii(30, 1), 0x41, "shift 30 -> 'A'");
    assert_eq(ginput_ascii(2, 1), 0x21, "shift 2 -> '!'");
    assert_eq(ginput_ascii(57, 0), 0x20, "evdev 57 -> space");
    assert_eq(ginput_ascii(103, 0), 0, "arrow key (103) -> not printable");
    gcomp_reset();
    assert_eq(gcomp_len(), 0, "composer starts empty");
    gcomp_append(0x68); gcomp_append(0x69);
    assert(streq(gcomp_cstr(), "hi") == 1, "composer cstr == 'hi'");
    gcomp_backspace();
    assert(streq(gcomp_cstr(), "h") == 1, "backspace -> 'h'");
    assert_eq(gcomp_key(28, 0), 2, "Enter -> submit (2)");
    assert_eq(gcomp_key(1, 0), 1, "Esc -> quit (1)");
    assert_eq(gcomp_key(31, 0), 0, "'s' key -> typed (0)");
    assert(streq(gcomp_cstr(), "hs") == 1, "gcomp_key typed 's' -> 'hs'");
    gcomp_reset();
    # --- turn working-state (0.30.4): pending message echo + working indicator on send ---
    gturn_begin("add async support to the rate limiter");
    assert_eq(gturn_active(), 1, "gturn active after begin");
    assert(streq(gturn_text(), "add async support to the rate limiter") == 1, "gturn_text == the copied submission");
    session_history_clear();
    # with EMPTY history + an active turn, the flow renders (NOT the greeting): a pending bubble + working line
    var _wl = gd_list_new();
    var _wdraw = _gfeed_flow(_wl, 14, 0, 800, 0);
    assert(_wdraw > 0, "working-state flow advances past 0 with empty history (pending + working line)");
    assert(vec_len(_wl) >= 3, "working-state emits >= 3 commands (marker + pending text + working indicator)");
    var _wmeasure = _gfeed_flow(0, 14, 0, 800, 0);
    assert_eq(_wmeasure, _wdraw, "working-state measure height == draw height (parity holds with the pending state)");
    # gfeed_build must NOT show the greeting while a turn is active on an empty history
    var _wfr = gd_list_new();
    gfeed_build(_wfr, 0, 0, 900, 300);
    assert(vec_len(_wfr) >= 3, "gfeed_build renders the working flow (not the greeting) during a turn");
    # a full working frame with prior history -> PPM (history + the just-sent message + 'thoth is working')
    session_history_clear();
    var _whu = "add streaming to the client";
    session_history_append("user", _whu, strlen(_whu));
    var _wha = "Sure - I'll wire an SSE reader into the transport and surface partial deltas as they arrive.";
    session_history_append("assistant", _wha, strlen(_wha));
    var _wbuf = gr_fb_new(FW, FH);
    gr_fb_clear(_wbuf, FW, FH, _gframe_bg());
    gr_raster(gframe_build(FW, FH), _wbuf, FW, FH);
    _gui_ppm_dump(_wbuf, FW, FH, "/tmp/thoth_gui_working.ppm");
    gturn_end();
    assert_eq(gturn_active(), 0, "gturn cleared after end");
    # --- 0.35.0 mid-turn pump: the LIVE streaming partial (_hoosh_acc) renders as the agent bubble during a turn ---
    gturn_begin("stream me a reply");
    session_history_clear();
    _hoosh_acc_reset();                                   # no content yet -> the "working" fallback renders
    var _p0 = gd_list_new();
    gfeed_build(_p0, 0, 0, 900, 300);
    var _pw0 = 0; var _pi0 = 0;
    while (_pi0 < vec_len(_p0)) {
        var _pc0 = vec_get(_p0, _pi0);
        if ((gd_kind(_pc0) == GD_TEXT) && (gd_text(_pc0) != 0)) {
            if (streq(gd_text(_pc0), "thoth is working...") == 1) { _pw0 = 1; }
        }
        _pi0 = _pi0 + 1;
    }
    assert_eq(_pw0, 1, "no partial yet -> the 'thoth is working...' mark renders");
    # content streams in -> the partial renders as the live agent bubble, replacing the working mark
    _hoosh_acc_append("Here is the partial streaming reply so far", 42);
    assert(hoosh_last_reply_len() > 0, "partial content present in _hoosh_acc");
    var _p1 = gd_list_new();
    gfeed_build(_p1, 0, 0, 900, 300);
    var _pfound = 0; var _pwork = 0; var _pi1 = 0;
    while (_pi1 < vec_len(_p1)) {
        var _pc1 = vec_get(_p1, _pi1);
        if ((gd_kind(_pc1) == GD_TEXT) && (gd_text(_pc1) != 0)) {
            if (streq(gd_text(_pc1), "Here is the partial streaming reply so far") == 1) { _pfound = 1; }
            if (streq(gd_text(_pc1), "thoth is working...") == 1) { _pwork = 1; }
        }
        _pi1 = _pi1 + 1;
    }
    assert_eq(_pfound, 1, "the streaming partial renders as the live agent bubble");
    assert_eq(_pwork, 0, "the static working mark is replaced once content streams");
    var _pmd = _gfeed_flow(0, 14, 0, 800, 0);             # measure/draw parity holds WITH the live partial
    var _pdl = gd_list_new();
    var _pdd = _gfeed_flow(_pdl, 14, 0, 800, 0);
    assert_eq(_pmd, _pdd, "live-partial measure height == draw height (bottom-anchor parity)");
    gturn_end();
    _hoosh_acc_reset();
    session_history_clear();
    # --- failed-turn transient notice (0.30.4): no assistant reply -> an honest notice, never silent vanishing ---
    gturn_begin("do a thing"); gturn_end(); gturn_fail();
    assert_eq(gturn_failed(), 1, "gturn_failed set after gturn_fail");
    session_history_clear();
    var _ffl = gd_list_new();
    var _ffh = _gfeed_flow(_ffl, 14, 0, 800, 0);          # empty history + failed -> the notice renders
    assert(_ffh > 0, "failed-turn flow advances (renders the notice) on empty history");
    assert(vec_len(_ffl) >= 1, "failed-turn emits the notice line");
    assert_eq(_gfeed_flow(0, 14, 0, 800, 0), _ffh, "failed-notice measure height == draw height (parity)");
    var _ffr = gd_list_new();
    gfeed_build(_ffr, 0, 0, 900, 300);                    # empty history + failed => the notice, NOT the greeting
    var _ffound = 0; var _ffi = 0;
    while (_ffi < vec_len(_ffr)) {
        var _ffc = vec_get(_ffr, _ffi);
        if ((gd_kind(_ffc) == GD_TEXT) && (gd_text(_ffc) != 0)) {
            if (streq(gd_text(_ffc), "the turn did not complete - is hoosh reachable? try /reprobe") == 1) { _ffound = 1; }
        }
        _ffi = _ffi + 1;
    }
    assert_eq(_ffound, 1, "gfeed_build renders the failure notice (not the greeting) on empty history");
    # a full failed-turn frame with prior history -> PPM (the user msg was popped on failure; the notice explains)
    session_history_clear();
    var _fpu = "connect to the gateway";
    session_history_append("user", _fpu, strlen(_fpu));
    var _fpa = "Connected. What would you like me to build?";
    session_history_append("assistant", _fpa, strlen(_fpa));
    var _fbuf = gr_fb_new(FW, FH);
    gr_fb_clear(_fbuf, FW, FH, _gframe_bg());
    gr_raster(gframe_build(FW, FH), _fbuf, FW, FH);
    _gui_ppm_dump(_fbuf, FW, FH, "/tmp/thoth_gui_failed.ppm");
    session_history_clear();
    gturn_begin("retry");
    assert_eq(gturn_failed(), 0, "a new submit (gturn_begin) clears the failure notice");
    gturn_end();
    session_history_clear();
    # --- stopped-turn transient notice (0.34.3): an Esc-interrupt with no partial -> a NEUTRAL "stopped" notice
    #     (distinct from the red "didn't complete" failure notice) ---
    gturn_begin("interrupt me"); gturn_end(); gturn_stop();
    assert_eq(gturn_stopped(), 1, "gturn_stopped set after gturn_stop");
    assert_eq(gturn_failed(), 0, "a stop is NOT a failure (no red notice)");
    session_history_clear();
    var _stl = gd_list_new();
    var _sth = _gfeed_flow(_stl, 14, 0, 800, 0);          # empty history + stopped -> the notice renders
    assert(_sth > 0, "stopped-turn flow advances (renders the notice)");
    assert_eq(_gfeed_flow(0, 14, 0, 800, 0), _sth, "stopped-notice measure height == draw height (parity)");
    var _str = gd_list_new();
    gfeed_build(_str, 0, 0, 900, 300);
    var _sfound = 0; var _sti = 0;
    while (_sti < vec_len(_str)) {
        var _stc = vec_get(_str, _sti);
        if ((gd_kind(_stc) == GD_TEXT) && (gd_text(_stc) != 0)) {
            if (streq(gd_text(_stc), "- stopped -") == 1) { _sfound = 1; }
        }
        _sti = _sti + 1;
    }
    assert_eq(_sfound, 1, "gfeed_build renders the '- stopped -' notice on an interrupted turn");
    gturn_begin("next");
    assert_eq(gturn_stopped(), 0, "a new submit clears the stopped notice");
    gturn_end();
    session_history_clear();
    # --- file-tree pane (gtree.cyr, 0.30.5; full coverage restored at 0.30.6 once cyrius 6.4.51 raised the
    #     output cap 16 MiB -> 1 GiB on Linux, so the command-scan + golden PPM no longer overflow) ---
    # responsive width: hidden on a narrow window, the fixed pane otherwise
    assert_eq(gtree_w(500), 0, "narrow window (<640) hides the tree");
    assert_eq(gtree_w(400), 0, "very narrow window hides the tree");
    assert_eq(gtree_w(960), GTREE_PANE_W, "wide window shows the 230px pane");
    assert_eq(gtree_w(700), GTREE_PANE_W, "700px window shows the full pane");
    # basename (the pane header = the project name)
    assert(streq(_gtree_basename("/home/macro/Repos/thoth"), "thoth") == 1, "basename of an absolute path");
    assert(streq(_gtree_basename("thoth"), "thoth") == 1, "basename of a bare name");
    assert(streq(_gtree_basename(""), "") == 1, "basename of empty is empty");
    assert(streq(_gtree_basename("/"), "/") == 1, "basename of root '/' is '/', not an empty header");
    # scroll-to-selection
    assert_eq(_gtree_scroll_first(5, 10, 0), 0, "a tree that fits starts at row 0");
    assert_eq(_gtree_scroll_first(100, 10, 0), 0, "overflow, selection at top -> row 0");
    assert_eq(_gtree_scroll_first(100, 10, 99), 90, "overflow, selection at bottom -> clamped to total-rows");
    # render a synthetic tree: src (dir, expanded) + main.cyr child + VERSION file
    ftree_init(); ftree_reset(); _ftree_set_cwd("/repo");
    _ftree_append("src", 1, 0); _ftree_append("VERSION", 0, 0);
    ftree_set_exp(0, 1); _ftree_insert_at(1, "main.cyr", 0, 1);
    assert_eq(_gtree_gitkind(0), 0, "_gtree_gitkind returns 0 for a directory (files-only gate)");
    var _tl = gd_list_new();
    gtree_build(_tl, 0, 40, 230, 400);
    assert(vec_len(_tl) > 4, "gtree_build emits bg + clip + header + rows + unclip");
    # dir name -> ROLE_BLUE, file name -> ROLE_MUTED, header -> the project name (== tui_draw_tree palette)
    var _tdir = 0; var _tfile = 0; var _thdr = 0; var _gti = 0;
    while (_gti < vec_len(_tl)) {
        var _gtc = vec_get(_tl, _gti);
        if ((gd_kind(_gtc) == GD_TEXT) && (gd_text(_gtc) != 0)) {
            if ((streq(gd_text(_gtc), "src") == 1) && (gd_color(_gtc) == _ui_rgb(ROLE_BLUE))) { _tdir = 1; }
            if ((streq(gd_text(_gtc), "VERSION") == 1) && (gd_color(_gtc) == _ui_rgb(ROLE_MUTED))) { _tfile = 1; }
            if (streq(gd_text(_gtc), "repo") == 1) { _thdr = 1; }
        }
        _gti = _gti + 1;
    }
    assert_eq(_tdir, 1, "a directory row renders in ROLE_BLUE");
    assert_eq(_tfile, 1, "a file row renders in ROLE_MUTED");
    assert_eq(_thdr, 1, "the pane header shows the project name (cwd basename)");
    var _tbuf = gr_fb_new(230, 400);
    gr_fb_clear(_tbuf, 230, 400, _gtree_bg());
    gr_raster(_tl, _tbuf, 230, 400);
    _gui_ppm_dump(_tbuf, 230, 400, "/tmp/thoth_gui_tree.ppm");
    # real-repo smoke: load the actual tree + probe git, then build the pane over it — exercises the git-badge
    # path (_gtree_gitkind: ftree_path -> strip cwd -> git_status_of) on real files, deterministically non-crashing
    git_probe();
    ftree_load();
    assert(ftree_count() > 0, "ftree_load listed the repo root");
    var _rl = gd_list_new();
    gtree_build(_rl, 0, 40, 230, 400);
    assert(vec_len(_rl) > 4, "gtree_build over the real repo tree emits the pane (git-badge path exercised)");
    ftree_reset();

    # --- conversation sidebar (gconv.cyr, 0.33.6) ---
    # responsive width (hidden below 640, fixed pane otherwise) + scroll-to-selection (mirrors the tree)
    assert_eq(gconv_w(500), 0, "narrow window (<640) hides the conversation sidebar");
    assert_eq(gconv_w(960), GCONV_PANE_W, "wide window shows the conversation pane");
    assert_eq(_gconv_scroll_first(3, 10, 0), 0, "a short list starts at row 0");
    assert_eq(_gconv_scroll_first(100, 10, 99), 90, "overflow, selection at bottom -> clamped to total-rows");
    # build a 2-conversation store, render the sidebar, confirm both titles + the active marker/accent appear
    session_reset();
    session_history_append("user", "first chat here", 15);   # conv 0 -> auto-titled "first chat here"
    conv_new(); conv_set_title(conv_active(), "second chat");
    session_history_append("user", "hi", 2);                  # conv 1 active now
    assert_eq(conv_count(), 2, "two conversations in the store");
    var _cl = gd_list_new();
    gconv_build(_cl, 0, 40, GCONV_PANE_W, 400);
    assert(vec_len(_cl) > 3, "gconv_build emits bg + clip + header + rows + unclip");
    var _c0 = 0; var _c1 = 0; var _chdr = 0; var _cact = 0; var _cvi = 0;
    while (_cvi < vec_len(_cl)) {
        var _cc = vec_get(_cl, _cvi);
        if ((gd_kind(_cc) == GD_TEXT) && (gd_text(_cc) != 0)) {
            if (streq(gd_text(_cc), "first chat here") == 1) { _c0 = 1; }
            if ((streq(gd_text(_cc), "second chat") == 1) && (gd_color(_cc) == _ui_rgb(ROLE_ACCENT))) { _c1 = 1; }   # active title in accent
            if (streq(gd_text(_cc), "conversations") == 1) { _chdr = 1; }
        }
        if ((gd_kind(_cc) == GD_RECT) && (gd_w(_cc) == 3) && (gd_color(_cc) == _ui_rgb(ROLE_ACCENT))) { _cact = 1; }   # active marker bar
        _cvi = _cvi + 1;
    }
    assert_eq(_chdr, 1, "the sidebar header 'conversations' renders");
    assert_eq(_c0, 1, "conversation 0's title renders");
    assert_eq(_c1, 1, "the ACTIVE conversation's title renders in accent");
    assert_eq(_cact, 1, "the active conversation shows an accent marker bar");
    # keyboard nav: reveal (preselect active) -> up -> Enter switches
    gconv_toggle_hidden();                       # reveal -> _gconv_sel = conv_active() = 1
    assert_eq(gconv_hidden(), 0, "Ctrl+K reveals the sidebar");
    assert_eq(gconv_sel(), 1, "reveal preselects the active conversation");
    gconv_sel_move(0 - 1);
    assert_eq(gconv_sel(), 0, "up moves the selection");
    gconv_key(28, 0);                            # Enter -> switch to conversation 0
    assert_eq(conv_active(), 0, "Enter switches to the selected conversation");
    assert_eq(gfocus(), GFOCUS_COMPOSER, "switching hands focus back to the composer");
    # full-frame layout integration: with the sidebar shown, gframe_build places its pane bg at the far left (x=0,
    # GCONV_PANE_W wide) ahead of the tree + feed; render the whole frame to a PPM artifact for visual inspection.
    var _fl = gframe_build(960, 600);
    var _fbg = 0; var _fli = 0;
    while (_fli < vec_len(_fl)) {
        var _flc = vec_get(_fl, _fli);
        if ((gd_kind(_flc) == GD_RECT) && (gd_x(_flc) == 0) && (gd_w(_flc) == GCONV_PANE_W) && (gd_color(_flc) == _gconv_bg())) { _fbg = 1; }
        _fli = _fli + 1;
    }
    assert_eq(_fbg, 1, "gframe_build places the sidebar pane (bg at x=0, GCONV_PANE_W wide) when shown");
    var _ffb = gr_fb_new(960, 600);
    gr_fb_clear(_ffb, 960, 600, _gframe_bg());
    gr_raster(_fl, _ffb, 960, 600);
    _gui_ppm_dump(_ffb, 960, 600, "/tmp/thoth_gui_convsidebar.ppm");
    gconv_toggle_hidden();                       # re-hide -> restore the default layout for later tests
    assert_eq(gconv_hidden(), 1, "re-hidden (default layout restored)");
    session_reset();

    session_set_model(0);
    return 0;
}

fn test_surface() {
    test_group("status view-model (surface.cyr, 0.28.0)");
    # snapshot mirrors the producers + single-sources the omit gates (drift-safety)
    session_set_model("gpt-5");
    status_snapshot();
    assert_eq(status_state(SF_MODEL), 0, "session model set -> STATE 0 (resolved)");
    assert(streq(status_sval(SF_MODEL), "gpt-5") == 1, "model SPTR == the session id");
    session_set_model(0);
    status_snapshot();
    # with no session model, resolution falls back to config; STATE=1 iff BOTH are null
    if (config_hoosh_model() == 0) {
        assert_eq(status_state(SF_MODEL), 1, "no model anywhere -> STATE 1");
        assert_eq(status_sval(SF_MODEL), 0, "no model -> SPTR 0");
    }
    assert_eq(status_ival(SF_TURNS), session_turns(), "turns ival == session_turns()");
    assert_eq(status_present(SF_TOKENS), session_tokens_seen(), "tokens present == session_tokens_seen() (one gate)");
    assert_eq(status_ival(SF_TOKENS), session_tokens(), "tokens ival == session_tokens()");
    assert_eq(status_present(SF_COST), session_cost_seen(), "cost present == session_cost_seen() (one gate)");
    assert_eq(status_ival(SF_COST), session_cost_micro(), "cost ival == session_cost_micro()");
    assert_eq(status_ival2(SF_COST), session_cost_unpriced_count(), "cost ival2 == unpriced count");
    # ctx: the KiB rounding formula, now single-sourced in the producer
    session_history_clear();
    session_history_append("user", "hello there world", 17);
    status_snapshot();
    assert_eq(status_ival(SF_CTX), hoosh_ctx_kib(), "ctx ival == hoosh_ctx_kib() (single-sourced)");
    assert_eq(status_ival(SF_CTX), (hoosh_ctx_bytes() + 512) / 1024, "ctx ival == the KiB rounding formula");
    assert_eq(status_ival2(SF_CTX), hoosh_ctx_budget_kib(), "ctx budget ival2 == hoosh_ctx_budget_kib()");
    assert_eq(status_state(SF_CTX), hoosh_ctx_evicted(), "ctx STATE == evicted count");
    # health enum tracks hoosh_health()
    hoosh_health_mark_down();
    status_snapshot();
    assert_eq(status_state(SF_HEALTH), HOOSH_HEALTH_DOWN, "health STATE == DOWN after mark_down");
    hoosh_health_mark_up();
    status_snapshot();
    assert_eq(status_state(SF_HEALTH), HOOSH_HEALTH_UP, "health STATE == UP after mark_up");
    # git mirrors the producer cache
    git_probe();
    status_snapshot();
    assert_eq(status_present(SF_GIT), git_present(), "git present == git_present()");
    assert_eq(status_ival(SF_GIT), git_dirty(), "git ival == git_dirty()");
    # surface / theme name pointers
    status_snapshot();
    assert(streq(status_sval(SF_SURFACE), ui_tier_name()) == 1, "surface sval == ui_tier_name()");
    assert(streq(status_sval(SF_THEME), ui_theme_name()) == 1, "theme sval == ui_theme_name()");
    # restore shared globals for any later test
    session_set_model(0);
    session_history_clear();
    return 0;
}

# GUI focus + file-tree keyboard nav (0.30.10): Tab toggles composer<->tree, arrows navigate, a printable key
# returns to the composer. PURE (drives the ftree model + gfocus/gkey); the present-loop wiring is main-only.
fn test_gui_nav() {
    test_group("GUI focus + file-tree keyboard nav (0.30.10)");
    ftree_init(); ftree_reset(); _ftree_set_cwd("/repo");
    _ftree_append("src", 1, 0); _ftree_append("VERSION", 0, 0);
    # Tab toggles composer <-> tree (tree is populated)
    gfocus_set(GFOCUS_COMPOSER);
    assert_eq(gkey(15, 0, 0), 0, "Tab is handled");
    assert_eq(gfocus(), GFOCUS_TREE, "Tab -> tree focus");
    assert_eq(gkey(15, 0, 0), 0, "Tab again handled");
    assert_eq(gfocus(), GFOCUS_COMPOSER, "Tab -> back to the composer");
    # arrows move the selection (clamped)
    gfocus_set(GFOCUS_TREE); ftree_set_sel(0);
    gkey(108, 0, 0); assert_eq(ftree_sel(), 1, "down -> row 1 (VERSION)");
    gkey(108, 0, 0); assert_eq(ftree_sel(), 1, "down clamps at the last row");
    gkey(103, 0, 0); assert_eq(ftree_sel(), 0, "up -> row 0 (src)");
    # Enter toggles a dir; left collapses; right expands
    ftree_set_sel(0);
    assert_eq(ftree_exp(0), 0, "src starts collapsed");
    gkey(28, 0, 0); assert_eq(ftree_exp(0), 1, "Enter on a collapsed dir -> expanded");
    gkey(105, 0, 0); assert_eq(ftree_exp(0), 0, "left -> collapsed");
    gkey(106, 0, 0); assert_eq(ftree_exp(0), 1, "right -> expanded");
    gkey(105, 0, 0);
    # a printable key while tree-focused returns to the composer + types it
    gfocus_set(GFOCUS_TREE); gcomp_reset();
    assert_eq(gkey(30, 0, 0), 0, "'a' while tree-focused is handled");
    assert_eq(gfocus(), GFOCUS_COMPOSER, "printable key returns focus to the composer");
    assert(streq(gcomp_cstr(), "a") == 1, "the key was typed into the composer");
    # Esc quits from any focus; Enter on the composer submits
    assert_eq(gkey(1, 0, 0), 1, "Esc -> quit");
    gcomp_reset(); gcomp_append(0x68); gfocus_set(GFOCUS_COMPOSER);
    assert_eq(gkey(28, 0, 0), 2, "Enter on the composer -> submit");
    # Tab with an EMPTY tree stays on the composer
    ftree_reset(); gfocus_set(GFOCUS_COMPOSER);
    gkey(15, 0, 0); assert_eq(gfocus(), GFOCUS_COMPOSER, "Tab with an empty tree stays on the composer");
    # Enter on a FILE inserts @<repo-relative path> into the composer + focuses it (0.30.13); a DIR still toggles
    ftree_init(); ftree_reset(); _ftree_set_cwd("/repo");
    _ftree_append("src", 1, 0); ftree_set_exp(0, 1); _ftree_insert_at(1, "main.cyr", 0, 1);   # src(exp) > main.cyr
    gcomp_reset(); gfocus_set(GFOCUS_TREE); ftree_set_sel(1);
    gkey(28, 0, 0);
    assert(streq(gcomp_cstr(), "@src/main.cyr ") == 1, "Enter on a file inserts @<relpath> + a space");
    assert_eq(gfocus(), GFOCUS_COMPOSER, "Enter on a file hands focus to the composer");
    gcomp_reset(); gfocus_set(GFOCUS_TREE); ftree_set_sel(0);
    gkey(28, 0, 0);
    assert_eq(ftree_exp(0), 0, "Enter on an expanded dir still collapses (no mention)");
    assert_eq(gcomp_len(), 0, "Enter on a dir inserts nothing into the composer");
    # a tree-FOCUSED frame -> golden PPM (bright selection highlight on the tree, dimmed composer prompt/caret)
    ftree_init(); ftree_reset(); _ftree_set_cwd("/home/macro/Repos/thoth");
    _ftree_append("src", 1, 0); _ftree_append("docs", 1, 0); _ftree_append("VERSION", 0, 0);
    ftree_set_sel(1); gfocus_set(GFOCUS_TREE);
    session_history_clear();
    var _nvu = "explore the codebase"; session_history_append("user", _nvu, strlen(_nvu));
    var _nvbuf = gr_fb_new(900, 400);
    gr_fb_clear(_nvbuf, 900, 400, _gframe_bg());
    gr_raster(gframe_build(900, 400), _nvbuf, 900, 400);
    _gui_ppm_dump(_nvbuf, 900, 400, "/tmp/thoth_gui_treefocus.ppm");
    session_history_clear();
    gcomp_reset(); gfocus_set(GFOCUS_COMPOSER); ftree_reset();
    return 0;
}

# GUI pane-visibility toggles (0.32.x): Ctrl+B hides/shows the file-tree pane, Ctrl+S the status strip. PURE over
# the ginput visibility state (gframe_build reads it for layout; that path is main-only). Keys: b=48, s=31, a=30.
fn test_gui_pane_toggles() {
    test_group("GUI pane toggles — hide files / status (0.32.x)");
    # both panes visible by default
    _gtree_hidden = 0; _gstatus_hidden = 0;
    assert_eq(gtree_hidden(), 0, "file-tree visible by default");
    assert_eq(gstatus_hidden(), 0, "status strip visible by default");
    # Ctrl+B toggles the tree; Ctrl+S the status strip (ctrl arg = 1)
    assert_eq(gkey(48, 0, 1), 0, "Ctrl+B handled");
    assert_eq(gtree_hidden(), 1, "Ctrl+B hides the file-tree pane");
    assert_eq(gkey(48, 0, 1), 0, "Ctrl+B again handled");
    assert_eq(gtree_hidden(), 0, "Ctrl+B again shows the file-tree pane");
    assert_eq(gkey(31, 0, 1), 0, "Ctrl+S handled");
    assert_eq(gstatus_hidden(), 1, "Ctrl+S hides the status strip");
    gkey(31, 0, 1); assert_eq(gstatus_hidden(), 0, "Ctrl+S again shows it");
    # a control chord must NOT type its letter into the composer
    gcomp_reset();
    gkey(48, 0, 1); gkey(31, 0, 1);
    assert_eq(gcomp_len(), 0, "Ctrl+B / Ctrl+S do not type into the composer");
    # an UNBOUND Ctrl+<letter> is swallowed (no text injected), but plain (no-ctrl) still types
    gcomp_reset(); _gtree_hidden = 0; _gstatus_hidden = 0;
    gkey(30, 0, 1);                                   # Ctrl+A -> swallowed
    assert_eq(gcomp_len(), 0, "unbound Ctrl+A injects no text");
    gkey(30, 0, 0);                                   # plain 'a' -> types
    assert(streq(gcomp_cstr(), "a") == 1, "plain 'a' still types");
    # hiding the tree while it is focused hands focus back to the composer (never stuck on a hidden pane)
    ftree_init(); ftree_reset(); _ftree_set_cwd("/repo"); _ftree_append("src", 1, 0);
    _gtree_hidden = 0; gfocus_set(GFOCUS_TREE);
    gkey(48, 0, 1);
    assert_eq(gtree_hidden(), 1, "Ctrl+B hid the tree");
    assert_eq(gfocus(), GFOCUS_COMPOSER, "focus left the hidden tree -> composer");
    # Tab does NOT focus a hidden (populated) tree
    gfocus_set(GFOCUS_COMPOSER); gkey(15, 0, 0);
    assert_eq(gfocus(), GFOCUS_COMPOSER, "Tab does not focus a hidden tree");
    # restore visible state for later tests
    _gtree_hidden = 0; _gstatus_hidden = 0; gcomp_reset(); gfocus_set(GFOCUS_COMPOSER); ftree_reset();
    return 0;
}

# GUI throbbing owl-eye status indicator (0.30.11): the `o` in {(o> pulses colour; its base reflects hoosh
# health. PURE colour math + the eye-cell recording gframe_build does; the throb LOOP is main-only.
fn test_gui_eye() {
    test_group("GUI throbbing owl-eye indicator (0.30.11)");
    assert(geye_color(0) != geye_color(6), "eye colour differs phase 0 (base) vs 6 (peak glow) — it throbs");
    assert_eq(geye_color(3), geye_color(9), "the pulse is a symmetric triangle wave (phase 3 == 12-9)");
    assert(geye_color(6) != _gframe_bg(), "the peak glow is never the background (visible, not a blink)");
    session_history_clear();
    gframe_build(900, 400);
    assert(geye_cell() != 0, "gframe_build recorded the owl-eye cell");
    assert_eq(gd_kind(geye_cell()), GD_TEXT, "the eye cell is a TEXT command");
    assert(streq(gd_text(geye_cell()), "o") == 1, "the eye cell draws the 'o'");
    store64(geye_cell() + GDC_COLOR, 0x123456);
    assert_eq(gd_color(geye_cell()), 0x123456, "the eye cell colour is mutable in place (the throb path)");
    hoosh_health_mark_down();
    assert_eq(_geye_base(), _ui_rgb(ROLE_RED), "hoosh DOWN -> red eye base (health indicator)");
    hoosh_health_mark_up();
    assert(_geye_base() == _ui_rgb(ROLE_ACCENT), "hoosh UP -> accent eye base");
    session_history_clear();
    return 0;
}

# GUI feed scrollback (0.30.14): PgUp/PgDn/End page the bottom-anchored feed; a submit snaps back to newest.
# PURE (drives gscroll_* + gfeed_build over session_history); the present-loop dirty-repaint is main-only.
fn test_gui_scroll() {
    test_group("GUI feed scrollback (0.30.14)");
    session_history_clear();
    var _su = "question";
    var _sa = "a fairly long answer that spans a couple of wrapped lines to build height in the feed region here";
    var _si = 0;
    while (_si < 8) { session_history_append("user", _su, strlen(_su)); session_history_append("assistant", _sa, strlen(_sa)); _si = _si + 1; }
    # scroll 0 = bottom-anchored (newest visible); record the top-most text y
    gscroll_reset();
    var _f0 = gd_list_new(); gfeed_build(_f0, 0, 40, 900, 200);
    var _min0 = 1000000; var _si2 = 0;
    while (_si2 < vec_len(_f0)) { var _c0 = vec_get(_f0, _si2); if (gd_kind(_c0) == GD_TEXT) { if (gd_y(_c0) < _min0) { _min0 = gd_y(_c0); } } _si2 = _si2 + 1; }
    # scroll up -> the flow shifts DOWN (older content into view; top-most y increases)
    gscroll_by(60);
    var _f1 = gd_list_new(); gfeed_build(_f1, 0, 40, 900, 200);
    var _min1 = 1000000; _si2 = 0;
    while (_si2 < vec_len(_f1)) { var _c1 = vec_get(_f1, _si2); if (gd_kind(_c1) == GD_TEXT) { if (gd_y(_c1) < _min1) { _min1 = gd_y(_c1); } } _si2 = _si2 + 1; }
    assert(_min1 > _min0, "PgUp shifts the flow down (older messages scroll into view)");
    assert(gscroll() > 0, "scroll offset > 0 after scrolling up");
    # scroll is CLAMPED at the top (two huge scrolls settle at the same offset, > 0 given overflow)
    gscroll_by(100000); gfeed_build(gd_list_new(), 0, 40, 900, 200); var _m1 = gscroll();
    gscroll_by(100000); gfeed_build(gd_list_new(), 0, 40, 900, 200); var _m2 = gscroll();
    assert_eq(_m1, _m2, "scroll clamps at the top (no runaway)");
    assert(_m1 > 0, "there is scrollable overflow");
    # gkey wiring: PgUp scrolls, End jumps to latest
    gscroll_reset(); gkey(104, 0, 0); assert(gscroll() > 0, "PgUp (104) scrolls the feed");
    gkey(107, 0, 0); assert_eq(gscroll(), 0, "End (107) jumps to the latest");
    # a submitted turn resets the scroll so the reply is visible
    gscroll_by(100); gcomp_reset(); gcomp_append(0x68); gfocus_set(GFOCUS_COMPOSER);
    assert_eq(gkey(28, 0, 0), 2, "Enter submits");
    assert_eq(gscroll(), 0, "a submitted turn snaps the feed back to the latest");
    # a scrolled-up frame -> golden PPM (older messages in view + the "-- more below --" hint)
    gscroll_reset(); gscroll_by(90);
    var _scbuf = gr_fb_new(900, 400);
    gr_fb_clear(_scbuf, 900, 400, _gframe_bg());
    gr_raster(gframe_build(900, 400), _scbuf, 900, 400);
    _gui_ppm_dump(_scbuf, 900, 400, "/tmp/thoth_gui_scroll.ppm");
    session_history_clear(); gscroll_reset(); gcomp_reset();
    return 0;
}

# GUI composer history recall (0.30.15): Up/Down over the inhist ring; a submit records; the draft is stashed.
fn test_gui_history() {
    test_group("GUI composer history recall (0.30.15)");
    inhist_init(); gfocus_set(GFOCUS_COMPOSER);
    gcomp_reset(); gcomp_append(0x66); gcomp_append(0x6f); gcomp_append(0x6f);   # "foo"
    assert_eq(gkey(28, 0, 0), 2, "Enter submits");
    assert_eq(inhist_count(), 1, "the submission is recorded in the ring");
    gcomp_reset();                                                                # (gpresent clears the composer after submit)
    gcomp_append(0x62); gcomp_append(0x61); gcomp_append(0x72);                   # "bar"
    gkey(28, 0, 0); gcomp_reset();
    assert_eq(inhist_count(), 2, "two submissions recorded");
    # Up recalls newest -> older
    gkey(103, 0, 0); assert(streq(gcomp_cstr(), "bar") == 1, "Up recalls the most recent submission");
    gkey(103, 0, 0); assert(streq(gcomp_cstr(), "foo") == 1, "Up again recalls the older submission");
    # Down walks newer, then restores the (empty) draft past the newest
    gkey(108, 0, 0); assert(streq(gcomp_cstr(), "bar") == 1, "Down walks back toward newer");
    gkey(108, 0, 0); assert_eq(gcomp_len(), 0, "Down past the newest restores the (empty) draft");
    # a typed draft is stashed on the first Up and restored on Down past newest
    gcomp_reset(); gcomp_append(0x7a);                                            # "z" draft
    gkey(103, 0, 0); assert(streq(gcomp_cstr(), "bar") == 1, "Up from a draft recalls the newest");
    gkey(108, 0, 0); assert(streq(gcomp_cstr(), "z") == 1, "Down restores the stashed draft");
    # a tree-focused Up still navigates the tree (not history)
    ftree_init(); ftree_reset(); _ftree_set_cwd("/r"); _ftree_append("a", 0, 0); _ftree_append("b", 0, 0);
    gfocus_set(GFOCUS_TREE); ftree_set_sel(1); gkey(103, 0, 0);
    assert_eq(ftree_sel(), 0, "tree-focused Up moves the tree selection, not history");
    gcomp_reset(); ftree_reset(); inhist_nav_reset(); gfocus_set(GFOCUS_COMPOSER);
    return 0;
}

# GUI tool-call cards (0.30.16): gtool_build renders the current turn's roundlog rounds as bordered cards,
# colored by status; measure==draw parity; filtered to the current turn; gfeed interleaves them above the reply.
fn test_gui_toolcards() {
    test_group("GUI tool-call cards (0.30.16)");
    roundlog_reset();
    session_history_clear();
    var turn = session_bump_turn();                  # this is the "current" turn gtool_build filters on
    roundlog_open(turn, 1);
    roundlog_add_call("shell", RL_ALLOWED, 1, 142, 512, "{\"command\":\"git status\"}");   # ok   -> green
    roundlog_add_call("memory_write", RL_ALLOWED, 0, 5, 0, "{\"text\":\"note\"}");          # err  -> red
    roundlog_open(turn, 2);
    roundlog_add_call("read_file", RL_DENIED, 0, 0, 0, "{\"path\":\"/etc/shadow\"}");       # deny -> red
    assert_eq(gtool_has_current(), 1, "the current turn has recorded rounds");
    # measure (cmds==0) and draw (cmds!=0) must agree on height (the feed bottom-anchor relies on it)
    var mh = gtool_build(0, 0, 0, 600);
    assert(mh > 0, "the card block has positive measured height");
    var cmds = gd_list_new();
    var dh = gtool_build(cmds, 0, 0, 600);
    assert_eq(mh, dh, "gtool measure height == draw height (parity)");
    # two rounds -> two bordered cards; walk the command list to prove structure + colors
    var borders = 0; var greens = 0; var reds = 0; var args = 0; var _ci = 0;
    while (_ci < vec_len(cmds)) {
        var c = vec_get(cmds, _ci);
        if (gd_kind(c) == GD_BORDER) { borders = borders + 1; }
        if (gd_kind(c) == GD_TEXT) {
            if (gd_color(c) == _ui_rgb(ROLE_GREEN)) { greens = greens + 1; }
            if (gd_color(c) == _ui_rgb(ROLE_RED)) { reds = reds + 1; }
            if (streq(gd_text(c), "{\"command\":\"git status\"}") == 1) { args = args + 1; }   # 0.30.17: args on the card
        }
        _ci = _ci + 1;
    }
    assert_eq(borders, 2, "one bordered card per round (2 rounds)");
    assert_eq(greens, 1, "the ok call is drawn green");
    assert(reds >= 2, "the err + deny calls are drawn red");
    assert_eq(args, 1, "the call's args are drawn on the card (0.30.17)");
    # filtered to the CURRENT turn: a new (later) turn with no rounds shows nothing
    session_bump_turn();
    assert_eq(gtool_has_current(), 0, "a later turn with no rounds has no cards");
    assert_eq(gtool_build(0, 0, 100, 600), 100, "gtool_build returns y unchanged when the turn ran no tools");
    # gfeed interleave: with the current turn's cards present, the feed flow is TALLER than with roundlog cleared
    session_reset();                                  # turn counter back to a clean base for the feed check
    var t2 = session_bump_turn();
    session_history_append("user", "run the tests", strlen("run the tests"));
    session_history_append("assistant", "done - all green.", strlen("done - all green."));
    roundlog_reset();
    var without = _gfeed_flow(0, 14, 0, 560, session_history_len());
    roundlog_open(t2, 1);
    roundlog_add_call("shell", RL_ALLOWED, 1, 88, 256, "{\"command\":\"cyrius test\"}");
    var with_cards = _gfeed_flow(0, 14, 0, 560, session_history_len());
    assert(with_cards > without, "the feed interleaves the current turn's cards above its reply");
    # visual artifact: raster the feed (with cards) to a PPM for eyeball inspection (the present loop is compositor-gated).
    var FW = 600; var FH = 300;
    var fbc = gr_fb_new(FW, FH);
    gr_fb_clear(fbc, FW, FH, _gframe_bg());
    gr_ensure_font();
    var fcmds = gd_list_new();
    gfeed_build(fcmds, 0, 0, FW, FH);
    gr_raster(fcmds, fbc, FW, FH);
    _gui_ppm_dump(fbc, FW, FH, "/tmp/thoth_gui_cards.ppm");
    roundlog_reset(); session_history_clear();
    return 0;
}

# GUI LIVE tool-call cards during a turn (0.35.1): while gturn_active, the feed renders the CURRENT turn's roundlog
# cards (above the streaming partial), so a card appears as each tool completes — riding the 0.35.0 pump. PURE
# (gtool_build over the roundlog + the gturn_active feed branch); the live repaint itself is compositor-gated.
fn test_gui_toolcards_live() {
    test_group("GUI live tool-call cards during a turn (0.35.1)");
    roundlog_reset(); session_reset();
    var turn = session_bump_turn();                   # the CURRENT turn gtool_build filters on
    roundlog_open(turn, 1);
    roundlog_add_call("shell", RL_ALLOWED, 1, 88, 256, "{\"command\":\"cyrius test\"}");
    gturn_begin("run the tests");                     # a turn is in flight (no reply landed yet)
    session_history_clear();
    _hoosh_acc_reset();
    # gfeed_build DURING the active turn must render the current turn's card (the tool name "shell")
    var cmds = gd_list_new();
    gfeed_build(cmds, 0, 0, 900, 400);
    var found = 0; var i = 0;
    while (i < vec_len(cmds)) {
        var c = vec_get(cmds, i);
        if ((gd_kind(c) == GD_TEXT) && (gd_text(c) != 0)) {
            if (streq(gd_text(c), "shell") == 1) { found = 1; }
        }
        i = i + 1;
    }
    assert_eq(found, 1, "the current turn's tool-call card ('shell') renders LIVE during the turn");
    # measure/draw parity holds with the live card in the active-turn flow
    var mh = _gfeed_flow(0, 14, 0, 800, 0);
    var dl = gd_list_new();
    var dh = _gfeed_flow(dl, 14, 0, 800, 0);
    assert_eq(mh, dh, "live-card measure height == draw height (bottom-anchor parity)");
    # with NO roundlog for the current turn, no card renders (just the working/partial state)
    roundlog_reset();
    var cmds2 = gd_list_new();
    gfeed_build(cmds2, 0, 0, 900, 400);
    var found2 = 0; var j = 0;
    while (j < vec_len(cmds2)) {
        var c2 = vec_get(cmds2, j);
        if ((gd_kind(c2) == GD_TEXT) && (gd_text(c2) != 0)) {
            if (streq(gd_text(c2), "shell") == 1) { found2 = 1; }
        }
        j = j + 1;
    }
    assert_eq(found2, 0, "no tool cards when the current turn ran none");
    gturn_end();
    roundlog_reset(); session_reset();
    return 0;
}

# GUI per-turn tool cards (0.30.19): each history message is turn-tagged, and the feed renders EACH turn's cards
# above ITS reply (not just the latest turn's). PURE (gtool_build_turn + session_history_turn over the feed).
fn test_gui_toolcards_perturn() {
    test_group("GUI per-turn tool cards (0.30.19)");
    roundlog_reset(); session_reset(); session_history_clear();
    # turn 1 used a tool; turn 2 did NOT
    var t1 = session_bump_turn();
    session_history_append("user", "q1", 2);
    roundlog_open(t1, 1);
    roundlog_add_call("shell", RL_ALLOWED, 1, 10, 20, "{\"command\":\"ls\"}");
    session_history_append("assistant", "a1", 2);
    var t2 = session_bump_turn();
    session_history_append("user", "q2", 2);
    session_history_append("assistant", "a2", 2);
    # every message carries its turn tag
    assert_eq(session_history_turn(0), t1, "user q1 tagged turn 1");
    assert_eq(session_history_turn(1), t1, "assistant a1 tagged turn 1");
    assert_eq(session_history_turn(3), t2, "assistant a2 tagged turn 2");
    # per-turn filtering: turn 1 has cards, turn 2 (no tools) has none
    assert(gtool_build_turn(0, 0, 0, 600, t1) > 0, "turn 1 (used a tool) has a card block");
    assert_eq(gtool_build_turn(0, 0, 50, 600, t2), 50, "turn 2 (no tools) renders no cards (returns y)");
    # the feed interleaves turn 1's cards above a1 even though a2 is the LATEST message — the regression the
    # per-turn change fixes (0.30.16-.18 only carded the current turn, so turn 1's cards vanished after turn 2).
    var with1 = _gfeed_flow(0, 14, 0, 560, session_history_len());
    # visual artifact: raster the 2-turn feed — turn 1's card must sit above a1, with a2 below and card-less.
    var PW = 600; var PH = 320;
    var pfb = gr_fb_new(PW, PH);
    gr_fb_clear(pfb, PW, PH, _gframe_bg());
    gr_ensure_font();
    var pcmds = gd_list_new();
    gfeed_build(pcmds, 0, 0, PW, PH);
    gr_raster(pcmds, pfb, PW, PH);
    _gui_ppm_dump(pfb, PW, PH, "/tmp/thoth_gui_cards_perturn.ppm");
    roundlog_reset();
    var without = _gfeed_flow(0, 14, 0, 560, session_history_len());
    assert(with1 > without, "an EARLIER turn's cards interleave above its reply, not just the newest turn's");
    roundlog_reset(); session_history_clear(); session_reset();
    return 0;
}

# GUI turn-success detection (0.30.19): gpresent raises the "didn't complete" notice via gturn_reply_landed(),
# which reads the last row's turn TAG (length-independent) — fixing the old net-growth check that false-fired at
# the SESS_HIST_MAX cap (surfacing a bogus notice + a duplicate current-turn card on every successful turn).
fn test_gturn_reply_landed() {
    test_group("GUI turn-success detection (0.30.19)");
    session_reset(); session_history_clear();
    var t = session_bump_turn();
    session_history_append("user", "q", 1);
    assert_eq(gturn_reply_landed(), 0, "user-only (no reply yet) -> not landed");
    session_history_append("assistant", "a", 1);
    assert_eq(gturn_reply_landed(), 1, "assistant tagged the current turn -> landed (true even at the cap)");
    # a later turn with no reply: the last assistant belongs to a PRIOR turn -> not landed. This is exactly what
    # the old `len <= _n0` check got wrong at the 40-message cap, where a SUCCESSFUL turn's length is pinned.
    session_bump_turn();
    assert_eq(gturn_reply_landed(), 0, "last assistant belongs to a prior turn -> not landed (the cap fix)");
    session_history_clear();
    assert_eq(gturn_reply_landed(), 0, "empty history -> not landed");
    session_reset(); session_history_clear();
    return 0;
}

# GUI per-turn reasoning fold (0.35.3): a LANDED turn keeps its thinking fold — the reasoning is persisted in
# reasonlog keyed by the turn tag and rendered above ITS reply, even after later turns land (the live 0.35.2 fold
# showed only the in-flight turn). PURE (greason_build_turn + reasonlog + session_history_turn over the feed).
fn test_gui_reason_perturn() {
    test_group("GUI per-turn reasoning fold (0.35.3)");
    reasonlog_reset(); roundlog_reset(); session_reset(); session_history_clear();
    if (greason_collapsed() == 1) { greason_toggle(); }   # ensure expanded so a record yields visible height
    # turn 1 reasoned; turn 2 did NOT
    var t1 = session_bump_turn();
    session_history_append("user", "q1", 2);
    reasonlog_record(t1, "because X then Y", 16);
    session_history_append("assistant", "a1", 2);
    var t2 = session_bump_turn();
    session_history_append("user", "q2", 2);
    session_history_append("assistant", "a2", 2);
    # per-turn filtering: turn 1 has a fold, turn 2 (no reasoning) renders nothing
    assert(greason_build_turn(0, 0, 0, 600, t1) > 0, "turn 1 (reasoned) has a fold block");
    assert_eq(greason_build_turn(0, 0, 50, 600, t2), 50, "turn 2 (no reasoning) renders no fold (returns y)");
    # measure == draw (parity): the measure-only height equals the drawn height
    var mh = greason_build_turn(0, 0, 0, 600, t1);
    var cmds = gd_list_new();
    var dh = greason_build_turn(cmds, 0, 0, 600, t1);
    assert_eq(mh, dh, "reasoning fold: measure height == draw height (parity)");
    # the fold SURVIVES the reply landing + a later turn — the whole point of 0.35.3: with the record the feed is
    # taller than without it (turn 1's fold interleaves above a1 even though a2 is the latest message).
    var with1 = _gfeed_flow(0, 14, 0, 560, session_history_len());
    reasonlog_reset();
    var without = _gfeed_flow(0, 14, 0, 560, session_history_len());
    assert(with1 > without, "a landed turn's reasoning fold persists above its reply after later turns land");
    # collapse shrinks it: collapsed (header only) < expanded (header + body), same record
    reasonlog_record(t1, "because X then Y", 16);
    var exph = greason_build_turn(0, 0, 0, 600, t1);
    greason_toggle();                                     # collapse
    var colh = greason_build_turn(0, 0, 0, 600, t1);
    greason_toggle();                                     # restore expanded (the default)
    assert(colh > 0, "collapsed fold still renders a header row");
    assert(exph > colh, "collapsing the fold shrinks it (header only vs header + body)");
    reasonlog_reset(); roundlog_reset(); session_history_clear(); session_reset();
    return 0;
}

# GUI structural markdown (mdmodel + gfeed, 0.36.0): assistant replies render with structure — headings ACCENT,
# **bold** brighter (FG), `inline code` + fenced code BLUE on a background rect, list markers ACCENT — via the
# shared model. PURE (_gfeed_md builds a gdraw command list; parity + a command-color scan, no raster/PPM).
fn test_gui_markdown() {
    test_group("GUI structural markdown (mdmodel + gfeed, 0.36.0)");
    var reply = "## Plan\nUse **foo** and `bar`.\n- step one\n```\ncode();\n```";
    # measure == draw parity
    var mh = _gfeed_md(0, 0, 0, 600, reply);
    var cmds = gd_list_new();
    var dh = _gfeed_md(cmds, 0, 0, 600, reply);
    assert_eq(mh, dh, "markdown feed: measure height == draw height (parity)");
    assert(dh > 0, "markdown feed advances y");
    # per-line structure (not one flat wrapped paragraph): heading + para + list + a code line -> >= 4 rows
    assert(dh >= 4 * GFEED_LH, "markdown produces per-line block structure");
    # the command list carries the accent heading, a blue code color, and the code-block background rect
    var accent = _ui_rgb(ROLE_ACCENT);
    var blue = _ui_rgb(ROLE_BLUE);
    var codebg = _md_code_bg();
    var seen_accent = 0; var seen_blue = 0; var seen_bg = 0; var ci = 0;
    while (ci < vec_len(cmds)) {
        var c = vec_get(cmds, ci);
        var k = gd_kind(c);
        var col = gd_color(c);
        if ((k == GD_TEXT) && (col == accent)) { seen_accent = 1; }
        if ((k == GD_TEXT) && (col == blue)) { seen_blue = 1; }
        if ((k == GD_RECT) && (col == codebg)) { seen_bg = 1; }
        ci = ci + 1;
    }
    assert_eq(seen_accent, 1, "heading (and list marker) drawn in ROLE_ACCENT");
    assert_eq(seen_blue, 1, "inline / fenced code drawn in ROLE_BLUE");
    assert_eq(seen_bg, 1, "fenced code sits on a background rect");
    # a plain reply (no markup) still renders as one paragraph, parity holds
    var plain = "just a normal sentence with no markup at all here";
    var pm = _gfeed_md(0, 0, 0, 600, plain);
    var pcmds = gd_list_new();
    var pd = _gfeed_md(pcmds, 0, 0, 600, plain);
    assert_eq(pm, pd, "plain reply: measure == draw");
    assert(pd > 0, "plain reply advances y");
    # empty reply -> no rows, no crash
    assert_eq(_gfeed_md(0, 0, 100, 600, ""), 100, "empty reply leaves y unchanged");
    return 0;
}

# GUI pipe table (mdmodel + gfeed, 0.36.1): a pipe table renders as an aligned grid — header cells ACCENT under a
# faint rule, body cells MUTED, delimiter row consumed. PURE (command-list scan + parity, no raster).
fn test_gui_table() {
    test_group("GUI pipe table (mdmodel + gfeed, 0.36.1)");
    var reply = "| name | qty |\n| --- | --: |\n| apples | 3 |\n| pears | 12 |";
    var mh = _gfeed_md(0, 0, 0, 600, reply);
    var cmds = gd_list_new();
    var dh = _gfeed_md(cmds, 0, 0, 600, reply);
    assert_eq(mh, dh, "table: measure height == draw height (parity)");
    # header + 2 body rows = 3 rows; the delimiter row is consumed, not rendered
    assert_eq(dh, 3 * GFEED_LH, "table renders header + 2 body rows (delimiter consumed)");
    var accent = _ui_rgb(ROLE_ACCENT); var muted = _ui_rgb(ROLE_MUTED); var faint = _ui_rgb(ROLE_FAINT);
    var seen_accent = 0; var seen_muted = 0; var seen_rule = 0; var ci = 0;
    while (ci < vec_len(cmds)) {
        var c = vec_get(cmds, ci);
        if ((gd_kind(c) == GD_TEXT) && (gd_color(c) == accent)) { seen_accent = 1; }
        if ((gd_kind(c) == GD_TEXT) && (gd_color(c) == muted)) { seen_muted = 1; }
        if ((gd_kind(c) == GD_RECT) && (gd_color(c) == faint)) { seen_rule = 1; }
        ci = ci + 1;
    }
    assert_eq(seen_accent, 1, "header cells drawn in ROLE_ACCENT");
    assert_eq(seen_muted, 1, "body cells drawn in ROLE_MUTED");
    assert_eq(seen_rule, 1, "a faint rule sits under the header");
    # a table followed by prose: the table ends at the blank line, the paragraph renders after it
    var reply2 = "| a | b |\n|---|---|\n| 1 | 2 |\n\nafter the table";
    var d2 = _gfeed_md(0, 0, 0, 600, reply2);
    assert_eq(d2, 4 * GFEED_LH, "table ends at the blank line; the blank + prose row render after");
    # a header + delimiter with NO body still renders one header row (no crash)
    var reply3 = "| only | header |\n| --- | --- |";
    var d3 = _gfeed_md(0, 0, 0, 600, reply3);
    assert_eq(d3, 1 * GFEED_LH, "header-only table renders one row");
    # NOT a table: a pipe-bearing prose line above a '---' (a 1-col delimiter) — the delimiter's column count (1)
    # must match the header's (2), else it stays prose with the '---' visible (regression guard, review-caught).
    var reply4 = "Inputs | Outputs\n---\nnext paragraph";
    var d4 = _gfeed_md(0, 0, 0, 600, reply4);
    assert_eq(d4, 3 * GFEED_LH, "pipe prose + '---' (col mismatch) is NOT a table -> 3 prose rows");
    return 0;
}

# GUI colored diff card (0.31.2): an `edit` call's stored editlog diff renders below its line in the card —
# del lines RED, add lines GREEN — growing the card height with measure/draw parity preserved.
fn test_gui_toolcards_diff() {
    test_group("GUI colored diff card (0.31.2)");
    roundlog_reset(); editlog_reset(); session_reset(); session_history_clear();
    var t = session_bump_turn();
    roundlog_open(t, 1);
    roundlog_add_call("edit", RL_ALLOWED, 1, 12, 40, "{\"path\":\"src/x.cyr\"}");
    var oo = "a\nOLD\nc\n"; var nn = "a\nNEW\nc\n";
    editlog_record(t, roundlog_cur_round(), 0, "src/x.cyr", oo, strlen(oo), nn, strlen(nn));
    assert(editlog_find(t, 1, 0) >= 0, "the edit diff is recorded for (turn,1,0)");
    # measure/draw parity with the taller (diff-bearing) card
    var mh = gtool_build_turn(0, 0, 0, 600, t);
    var cmds = gd_list_new();
    var dh = gtool_build_turn(cmds, 0, 0, 600, t);
    assert_eq(mh, dh, "diff card measure height == draw height (parity)");
    # del line RED with text 'OLD', add line GREEN with text 'NEW'; the edit call shows its clean PATH (blue,
    # 0.31.4) instead of the raw JSON args
    var reds = 0; var greens = 0; var delseen = 0; var addseen = 0; var pathseen = 0; var argjson = 0; var _ci = 0;
    while (_ci < vec_len(cmds)) {
        var c = vec_get(cmds, _ci);
        if (gd_kind(c) == GD_TEXT) {
            if (gd_color(c) == _ui_rgb(ROLE_RED)) { reds = reds + 1; if (streq(gd_text(c), "OLD") == 1) { delseen = 1; } }
            if (gd_color(c) == _ui_rgb(ROLE_GREEN)) { greens = greens + 1; if (streq(gd_text(c), "NEW") == 1) { addseen = 1; } }
            if ((gd_color(c) == _ui_rgb(ROLE_BLUE)) && (streq(gd_text(c), "src/x.cyr") == 1)) { pathseen = 1; }
            if (streq(gd_text(c), "{\"path\":\"src/x.cyr\"}") == 1) { argjson = 1; }
        }
        _ci = _ci + 1;
    }
    assert_eq(delseen, 1, "the deleted line 'OLD' is drawn RED");
    assert_eq(addseen, 1, "the added line 'NEW' is drawn GREEN");
    assert_eq(pathseen, 1, "the edit call shows its clean path 'src/x.cyr' in blue (0.31.4)");
    assert_eq(argjson, 0, "the noisy raw JSON args are NOT drawn for an edit call");
    # PPM artifact: a feed with the diff card
    session_history_append("user", "rename OLD to NEW", strlen("rename OLD to NEW"));
    session_history_append("assistant", "done.", strlen("done."));
    var FW = 620; var FH = 260;
    var fbc = gr_fb_new(FW, FH); gr_fb_clear(fbc, FW, FH, _gframe_bg()); gr_ensure_font();
    var fcmds = gd_list_new(); gfeed_build(fcmds, 0, 0, FW, FH); gr_raster(fcmds, fbc, FW, FH);
    _gui_ppm_dump(fbc, FW, FH, "/tmp/thoth_gui_diffcard.ppm");
    # the diff grows the card vs no editlog match
    editlog_reset();
    var nodiff_h = gtool_build_turn(0, 0, 0, 600, t);
    assert(dh > nodiff_h, "the edit diff grows the card height (vs no editlog entry)");
    roundlog_reset(); editlog_reset(); session_reset(); session_history_clear();
    return 0;
}

# GUI rainbow (0.38.1): the T3 tier of the per-grapheme HSV mode. The GUI has no escapes and no byte budget
# — it draws pixels — so the hue rides a SENTINEL color in the existing draw-command slot and the rasterizer
# resolves it per glyph. graster is pure CPU, so this is provable to the PIXEL, headless.
fn test_gui_rainbow() {
    test_group("GUI rainbow (graster/gfeed, 0.38.1)");
    gr_ensure_font();   # this test asserts PIXELS: on a cold font every glyph rasterizes empty and the
                        # assertions below pass vacuously. It only survived review because test_gui() happens
                        # to warm the font earlier in main() — an ordering dependency, not a guarantee.

    # REACHABILITY FIRST — the property that makes every other assertion here matter. ui_set_theme has only two
    # callers: cmd_theme (via dispatch) and the TUI's ⌃T. The GUI composer runs cmd_task() DIRECTLY, bypassing
    # dispatch, so `/theme rainbow` typed into the GUI goes to the MODEL as a task; there is no config key. So
    # until 0.38.1 bound Ctrl+T here, a `thoth gui` process could NEVER select rainbow and this whole tier was
    # unreachable dead code. Drive the KEY PATH (gkey), not ui_set_theme — asserting the mechanism while the
    # user has no way to reach it is exactly how that shipped.
    ui_force(PT_DESKTOP, CD_TRUE);
    ui_set_theme(THEME_DARK);
    gkey(20, 0, 1);                                        # Ctrl+T (evdev KEY_T)
    assert_eq(ui_theme(), THEME_LIGHT, "GUI Ctrl+T: dark -> light (the theme axis is REACHABLE in the GUI)");
    gkey(20, 0, 1);
    assert_eq(ui_theme(), THEME_RAINBOW, "GUI Ctrl+T: light -> rainbow (the T3 tier is selectable at all)");
    assert_eq(ui_rainbow_active(), 1, "  ... and it actually draws once selected");
    gkey(20, 0, 1);
    assert_eq(ui_theme(), THEME_DARK, "GUI Ctrl+T: rainbow -> dark (cycles home, never -1)");

    ui_set_theme(THEME_DARK);
    assert_eq(_gfeed_ink(ROLE_FG), _ui_rgb(ROLE_FG), "dark: prose ink is the role color");
    assert_eq(_md_role_color(MDI_CODE, ROLE_FG), _ui_rgb(ROLE_BLUE), "dark: inline code keeps its blue");
    ui_set_theme(THEME_RAINBOW);
    assert_eq(ui_rainbow_active(), 1, "PT_DESKTOP + CD_TRUE: the wl_shm surface IS truecolor -> rainbow live");
    assert_eq(_gfeed_ink(ROLE_FG), GD_RAINBOW, "rainbow: prose ink is the sentinel");
    assert_eq(_md_role_color(MDI_BOLD, ROLE_FG), GD_RAINBOW, "rainbow overrides emphasis + code (it IS the fg)");
    # Chrome never routes through _gfeed_ink, so its semantic roles survive — same line the TUI draws.
    assert_eq(_ui_rgb(ROLE_RED), _ui_rgb_dark(ROLE_RED), "chrome keeps its semantic role color under rainbow");

    # THE RASTERIZER: resolve per GLYPH, and never paint the sentinel itself.
    var fbw = 32;
    var fbh = 16;
    var fb = alloc(fbw * fbh * 4);
    gr_fb_clear(fb, fbw, fbh, 0);
    gr_fb_text(fb, fbw, fbh, 0, 0, "AB", GD_RAINBOW, 0);
    var inkA = 0;
    var inkB = 0;
    var leaked = 0;
    var y = 0;
    while (y < fbh) {
        var x = 0;
        while (x < fbw) {
            var p = load32(fb + (y * fbw + x) * 4);
            if (p != 0) {
                if (p == GD_RAINBOW) { leaked = 1; }
                if (x < GR_GLYPH_W) { inkA = p; } elif (x < (GR_GLYPH_W * 2)) { inkB = p; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    assert_eq(leaked, 0, "the SENTINEL never reaches a pixel (it is resolved, never painted)");
    assert(inkA != 0, "glyph 0 painted");
    assert(inkB != 0, "glyph 1 painted");
    assert(inkA != inkB, "each glyph gets its OWN hue (per-glyph resolve, not the IR's per-run color)");
    assert_eq(inkA, ui_rainbow_rgb(0), "glyph 0 = the hue at column 0 (red)");
    assert_eq(inkB, ui_rainbow_rgb(UI_RAINBOW_STEP), "glyph 1 = the hue one UI_RAINBOW_STEP on");

    # A real color still passes through untouched (the sentinel is out of the 24-bit range, so it can never
    # collide with one).
    gr_fb_clear(fb, fbw, fbh, 0);
    gr_fb_text(fb, fbw, fbh, 0, 0, "A", 255 * 65536, 0);
    var found = 0;
    var y2 = 0;
    while (y2 < fbh) {
        var x2 = 0;
        while (x2 < fbw) {
            if (load32(fb + (y2 * fbw + x2) * 4) == (255 * 65536)) { found = 1; }
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    assert_eq(found, 1, "a non-sentinel color is passed through to the pixels verbatim");

    ui_set_theme(THEME_DARK);
    ui_detect_tier();
    return 0;
}

# --- the T3 question modal (src/gui/gask.cyr, 0.44.0, T4-1) --------------------------------------
#
# The view-builder half, headless. The blocking poll loop lives in gpresent.cyr and needs a live
# compositor, but everything that decides what the operator SEES and what a keystroke MEANS is here.
#
# ⚠ This modal is why the T3 surface can answer a question at all. Audit A-11 recorded that the GUI had
# "no modal to render this in and no path from evdev to read_line", so gated tools DENY there rather
# than deadlock; ask_user closes that gap, and these assertions pin the two properties that make it
# safe — the model never occupies the trust position, and its bytes are clipped, not free to reflow.
fn _gask_find_text(cmds, needle) {
    var i = 0;
    while (i < vec_len(cmds)) {
        var c = vec_get(cmds, i);
        if (gd_kind(c) == GD_TEXT) {
            if (gd_text(c) != 0) { if (_ui_contains(gd_text(c), needle) == 1) { return c; } }
        }
        i = i + 1;
    }
    return 0;
}

# _gask_off_of: byte offset of `needle` inside `hay`, or -1. (testutil's _t_count_sub counts; this
# locates, which is what a clip test needs.)
fn _gask_off_of(hay, needle) {
    var hn = strlen(hay);
    var nn = strlen(needle);
    if (nn == 0) { return 0; }
    var i = 0;
    while ((i + nn) <= hn) {
        var j = 0;
        var ok = 1;
        while (j < nn) {
            if (load8(hay + i + j) != load8(needle + j)) { ok = 0; j = nn; }
            else { j = j + 1; }
        }
        if (ok == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# _gask_visible: 1 if `needle` falls inside the CLIP WINDOW of some drawn text command.
#
# ⚠ THE OBVIOUS TEST IS THE WRONG TEST, and writing it that way first is why this helper exists.
# gd_push_text stores the POINTER and the codepoint clip separately — the clip is applied by the
# rasterizer, not by truncating the string — so `_ui_contains(gd_text(c), needle)` answers "is the
# needle somewhere in the string this row starts at", which is true even when the row draws none of it.
# Reverting the wrap to one row left that assertion green while the operator saw nothing. What has to
# be asserted is the needle's CODEPOINT offset from the row's own start against that row's gd_aux.
fn _gask_visible(cmds, needle) {
    var i = 0;
    while (i < vec_len(cmds)) {
        var c = vec_get(cmds, i);
        if (gd_kind(c) == GD_TEXT) { if (gd_text(c) != 0) {
            var off = _gask_off_of(gd_text(c), needle);
            if (off >= 0) {
                var cps = 0;
                var b = 0;
                while (b < off) {
                    if ((load8(gd_text(c) + b) & 0xC0) != 0x80) { cps = cps + 1; }
                    b = b + 1;
                }
                # gd_aux 0 == no clip (thoth-owned chrome); otherwise the row draws gd_aux codepoints.
                if (gd_aux(c) == 0) { return 1; }
                if ((cps + 1) <= gd_aux(c)) { return 1; }
            }
        } }
        i = i + 1;
    }
    return 0;
}

fn test_gask() {
    test_group("T3 question modal (gui/gask.cyr, 0.44.0)");
    # inert until opened: the ordinary frame must be byte-identical when no question is pending
    gask_close();
    var idle = gd_list_new();
    gask_build(idle, 960, 600);
    assert_eq(vec_len(idle), 0, "no pending question -> the modal emits ZERO draw commands");

    gask_open("Which database should I use?");
    gask_add_option("PostgreSQL");
    gask_add_option("SQLite");
    assert_eq(gask_active(), 1, "opening raises the modal");
    assert_eq(gask_option_count(), 2, "options are held");
    assert_eq(gask_sel(), 0, "the first option starts highlighted");

    var cmds = gd_list_new();
    gask_build(cmds, 960, 600);
    assert(vec_len(cmds) > 0, "an open modal draws");
    # ⚠ THE TRUST ANCHOR: a fixed label this file owns always precedes the model's bytes, so a question
    # written to look like a prompt cannot pass itself off as thoth asking.
    assert(_gask_find_text(cmds, "the agent is asking") != 0, "the modal's own label is drawn");
    assert(_gask_find_text(cmds, "Which database") != 0, "...and the question after it");
    assert(_gask_find_text(cmds, "PostgreSQL") != 0, "option 0 is drawn");
    assert(_gask_find_text(cmds, "SQLite") != 0, "option 1 is drawn");
    assert(_gask_find_text(cmds, "Esc decline") != 0, "the affordance line is drawn");
    # ⚠ LAYOUT FORGERY is the GUI's threat, not escape forgery (graster has no escape interpreter): a
    # long question must be CLIPPED to the card, never allowed to push the card's own chrome off it.
    var qc = _gask_find_text(cmds, "Which database");
    assert(gd_aux(qc) > 0, "the question is drawn with a codepoint clip, not unbounded");

    # key folding: 0 = pending, 1 = accepted, 2 = declined
    assert_eq(_gask_key(108, 0), 0, "Down is pending");
    assert_eq(gask_sel(), 1, "...and moves the highlight");
    assert_eq(_gask_key(108, 0), 0, "Down at the end is pending");
    assert_eq(gask_sel(), 1, "...and does not run off the list");
    assert_eq(_gask_key(103, 0), 0, "Up is pending");
    assert_eq(gask_sel(), 0, "...and moves back");
    assert_eq(_gask_key(1, 0), 2, "Esc DECLINES");
    assert_eq(_gask_key(28, 0), 1, "Enter on a highlighted option ACCEPTS");

    # typing goes to the free-text field and takes the selection with it — one answer, not two modes
    gask_open("pick"); gask_add_option("a");
    assert_eq(gask_sel(), 0, "an option is highlighted to begin with");
    _gask_key(32, 0);                       # evdev 32 = 'd'
    assert(gask_len() > 0, "typing lands in the free-text field");
    assert_eq(gask_sel(), 0 - 1, "...and clears the highlight, so Enter cannot submit a suggestion instead");
    assert_eq(_gask_key(14, 0), 0, "Backspace is pending");
    assert_eq(gask_len(), 0, "...and deletes");
    assert_eq(_gask_key(28, 0), 2, "Enter with no text AND no highlight declines rather than answering blank");

    # --- 0.44.3: the question WRAPS, and the label names who is asking -------------------------------
    #
    # ⚠ THIS IS A SECURITY FIX WEARING TYPOGRAPHY'S CLOTHES. Through 0.44.2 the question was ONE
    # gd_push_text clipped to the card's interior (~86cp at the 720px cap). Fine for a model's short
    # question; NOT fine once `confirm` began posing authorization prompts through this same modal,
    # because that prompt's fixed preamble is 79 characters before the verb and object even start — so
    # the operator was shown a yes/no about an action whose text had been clipped off the card entirely.
    # Reverting the wrap in gask_build turns the "the object is visible" assertion below red.
    gask_close();
    gask_open("Authorize this action? (t-ron absent - thoth is asking because nothing else can) thoth_shell rm -rf /home/you/important-directory");
    gask_set_label(GASK_LABEL_AUTHZ);
    var wc = gd_list_new();
    gask_build(wc, 960, 600);
    assert(_gask_find_text(wc, "thoth needs your authorization") != 0, "an authorization prompt is labelled as THOTH asking");
    assert(_gask_find_text(wc, "the agent is asking") == 0, "...and never as the agent, which is the party being decided about");
    assert(_gask_find_text(wc, "Authorize this action") != 0, "the question's first row is drawn");
    # ⚠ The object is what the operator is actually authorizing, and this asserts it is INSIDE A DRAWN
    # ROW'S CLIP WINDOW — not merely inside a string some row points at. See _gask_visible: the naive
    # form of this assertion stayed green with the wrap reverted to one row, which is exactly the bug.
    assert_eq(_gask_visible(wc, "important-directory"), 1, "the ACTION being authorized is actually DRAWN, not clipped off the end");
    assert_eq(_gask_visible(wc, "Authorize this action"), 1, "...and so is the preamble that precedes it");

    # the wrap is BOUNDED — layout forgery is still refused. A question far past the row budget must not
    # grow the card without limit or push the affordance line off it.
    gask_close();
    gask_open("");
    var bc = gd_list_new();
    gask_build(bc, 960, 600);
    assert(_gask_find_text(bc, "Esc decline") != 0, "even a question far past the row budget leaves the affordance line on the card");
    assert_eq(_gask_q_rows(80), GASK_Q_ROWS, "...because the row count is clamped, not grown to fit");

    # the wrap advances by whole CODEPOINTS — a byte-wise advance would open a row mid-UTF-8 sequence
    gask_close();
    gask_open("aéb");                       # 'é' is two bytes
    var p0 = gask_question();
    assert_eq(load8(_gask_adv_cp(p0, 1)) & 255, 0xC3, "one codepoint past 'a' lands on the LEAD byte of the two-byte character");
    assert_eq(load8(_gask_adv_cp(p0, 2)) & 255, 98, "two codepoints past lands on 'b', not inside the sequence");
    assert_eq(load8(_gask_adv_cp(p0, 99)), 0, "advancing past the end stops at the terminator");

    # the label defaults back for the model's own questions — an authz label must never latch
    gask_close();
    gask_open("plain question");
    var lc = gd_list_new();
    gask_build(lc, 960, 600);
    assert(_gask_find_text(lc, "the agent is asking") != 0, "gask_open resets the label, so an authz prompt cannot latch onto the next ask_user");
    gask_close();
    return 0;
}
