# tests/cases/core.cyr — the core driver: classify, session, config, hoosh client, cost/usage, persona, oneshot, history, logging.
# Split out of tests/thoth.tcyr (0.30.7). Included by the thoth.tcyr driver AFTER the src modules
# (and after helpers.cyr); the driver's main() calls these. Harness auto-resolves from lib/assert.cyr.


fn _t_secs_line(ms, expect) {   # emit _task_emit_secs(ms) to the feed ring; 1 if row 0 contains `expect`
    feed_init();
    out_mode_set(OUT_RING);
    _task_emit_secs(ms);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    return _t_count_sub(feed_line_ptr(0), feed_line_len(0), expect, strlen(expect));
}

fn _t_reason_line(expect) {   # emit the /state reason row to the feed ring; occurrences of `expect` in row 0
    feed_init();
    out_mode_set(OUT_RING);
    _state_reason_row();
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    return _t_count_sub(feed_line_ptr(0), feed_line_len(0), expect, strlen(expect));
}

# /state reason row (0.35.4): the [hoosh].reasoning effort + turns-folded surface. PURE (config + reasonlog only,
# no network probe) — captured via the OUT_RING feed sink like the elapsed-secs row.
fn test_state_reason_row() {
    test_group("/state reason row (0.35.4)");
    reasonlog_reset();
    _cfg_hoosh_reasoning = 0;                  # off
    assert(_t_reason_line("off") >= 1, "reason row: off shows 'off'");
    assert(_t_reason_line("low|medium|high") >= 1, "reason row: off gives the enable hint");
    _cfg_hoosh_reasoning = 2;                  # medium, nothing folded yet (the Opus 4.8 case)
    assert(_t_reason_line("medium") >= 1, "reason row: shows the effort word");
    assert(_t_reason_line("internal") >= 1, "reason row: on + 0 folds -> 'may keep reasoning internal'");
    assert_eq(_t_reason_line("folded"), 0, "reason row: no folded-count when nothing captured");
    reasonlog_record(1, "r", 1);               # two turns' reasoning captured
    reasonlog_record(2, "r", 1);
    assert(_t_reason_line("folded") >= 1, "reason row: shows the folded surface once captured");
    assert(_t_reason_line("2") >= 1, "reason row: reports the 2 folded turns");
    _cfg_hoosh_reasoning = 0; reasonlog_reset();   # restore defaults
    return 0;
}

fn test_classify() {
    test_group("classify_input");
    assert_eq(classify_input(""), CMD_EMPTY, "empty -> CMD_EMPTY");
    assert_eq(classify_input("/help"), CMD_HELP, "/help");
    assert_eq(classify_input("/?"), CMD_HELP, "/? alias");
    assert_eq(classify_input("/quit"), CMD_QUIT, "/quit");
    assert_eq(classify_input("/exit"), CMD_QUIT, "/exit alias");
    assert_eq(classify_input("/seams"), CMD_SEAMS, "/seams");
    assert_eq(classify_input("/state"), CMD_STATE, "/state");
    assert_eq(classify_input("/model"), CMD_MODEL, "/model bare");
    assert_eq(classify_input("/model gpt-5"), CMD_MODEL, "/model with arg");
    assert_eq(classify_input("/read foo.txt"), CMD_READ, "/read with arg");
    assert_eq(classify_input("/write a b"), CMD_WRITE, "/write");
    assert_eq(classify_input("/run echo hi"), CMD_RUN, "/run");
    assert_eq(classify_input("/tools"), CMD_TOOLS, "/tools");
    # 0.43.0's three MCP resource/prompt commands. The ORDER of the two `/resource*` arms is
    # load-bearing (`/resource` is a prefix of `/resources`), which is exactly the kind of thing a
    # classify test exists to pin — and none of the three was asserted until 0.43.2.
    assert_eq(classify_input("/resources"), CMD_RESOURCES, "/resources");
    assert_eq(classify_input("/resource file:///x"), CMD_RESOURCE, "/resource with a uri");
    assert_eq(classify_input("/prompts"), CMD_PROMPTS, "/prompts");
    assert_eq(classify_input("/call echo {}"), CMD_CALL, "/call with args");
    assert_eq(classify_input("/audit"), CMD_AUDIT, "/audit");
    assert_eq(classify_input("/reset"), CMD_RESET, "/reset");
    assert_eq(classify_input("/clear"), CMD_CLEAR, "/clear");
    assert_eq(classify_input("/copy"), CMD_COPY, "/copy classifies to CMD_COPY");
    assert_eq(classify_input("/reprobe"), CMD_REPROBE, "/reprobe");
    assert_eq(classify_input("/ping"), CMD_REPROBE, "/ping aliases reprobe");
    assert_eq(classify_input("/history"), CMD_HISTORY, "/history");
    assert_eq(classify_input("/theme light"), CMD_THEME, "/theme with arg");
    assert_eq(classify_input("/retry"), CMD_RETRY, "/retry classifies");
    assert_eq(classify_input("/regenerate"), CMD_RETRY, "/regenerate aliases /retry");
    assert_eq(classify_input("/edit make it shorter"), CMD_EDIT, "/edit with arg classifies");
    assert_eq(classify_input("/bookmark"), CMD_BOOKMARK, "/bookmark classifies");
    assert_eq(classify_input("/thumbs up"), CMD_THUMBS, "/thumbs classifies");
    assert_eq(classify_input("/bogus"), CMD_UNKNOWN_SLASH, "unknown slash");
    assert_eq(classify_input("/"), CMD_UNKNOWN_SLASH, "lone slash");
    assert_eq(classify_input("write me a function"), CMD_TASK, "free text -> task");
    assert_eq(classify_input("hello"), CMD_TASK, "plain word -> task");
    return 0;
}

fn test_tokens() {
    test_group("token_is + arg_after");
    assert_eq(token_is("/help", "/help"), 1, "exact token");
    assert_eq(token_is("/model gpt", "/model"), 1, "token + space");
    assert_eq(token_is("/models", "/model"), 0, "prefix is not a token");
    assert_eq(token_is("/modelx", "/model"), 0, "no word boundary");
    assert_eq(arg_after("/help"), 0, "no arg -> 0");
    assert(streq(arg_after("/read foo.txt"), "foo.txt"), "arg extracted");
    assert(streq(arg_after("/model   gpt-5"), "gpt-5"), "skips extra spaces");
    assert(streq(arg_after("/write a.txt hi there"), "a.txt hi there"), "rest after first token");
    # 0.34.4: _params_one must be BOUNDED — /bookmark feeds it a whole assistant reply (up to 64 KiB), which the
    # old unbounded escaper wrote past the 32 KiB _gate_params buffer (heap overflow). A huge value now truncates
    # in-buffer and keeps the closing `"}` envelope, never overrunning the cap.
    var big = alloc(40001);
    var bi = 0;
    while (bi < 40000) { store8(big + bi, 65); bi = bi + 1; }   # 40000 'A' (> the 32 KiB cap)
    store8(big + 40000, 0);
    var pj = _params_one("text", big);
    var pl = strlen(pj);
    assert(pl < 32768, "params_one bounded to < GATE_PARAMS_CAP on a 40 KiB value (no overflow)");
    assert(pl > 8, "params_one produced a result");
    assert_eq(load8(pj + pl - 1), 125, "params_one result ends with '}' (closer never dropped)");
    assert_eq(load8(pj + pl - 2), 34, "params_one result ends with '\"}' (string closed)");
    return 0;
}

fn test_cstr() {
    test_group("cstr_starts_with");
    assert_eq(cstr_starts_with("hello", "he"), 1, "prefix");
    assert_eq(cstr_starts_with("hello", "hello"), 1, "equal");
    assert_eq(cstr_starts_with("he", "hello"), 0, "shorter than prefix");
    assert_eq(cstr_starts_with("abc", "x"), 0, "mismatch");
    assert_eq(cstr_starts_with("", ""), 1, "empty prefix of empty");
    return 0;
}

fn test_seams() {
    test_group("seam registry");
    assert_eq(SEAM_COUNT, 7, "seven seams (git added 0.13.0)");
    assert(streq(seam_name(SEAM_HOOSH), "hoosh"), "hoosh name");
    assert(streq(seam_name(SEAM_DAIMON), "daimon"), "daimon name");
    assert(streq(seam_name(SEAM_BOTE), "bote"), "bote name");
    assert(streq(seam_name(SEAM_TRON), "t-ron"), "t-ron name");
    assert(streq(seam_name(SEAM_AVATARA), "avatara"), "avatara name");
    assert(streq(seam_name(SEAM_MEMORY), "mneme"), "mneme name (memory domain owner)");
    assert(streq(seam_name(SEAM_GIT), "sit"), "sit name (git/VCS domain owner)");
    _daimon_mem_probed = 0 - 1;                      # 0.32.0: unprobed -> local fallback
    assert_eq(seam_status(SEAM_MEMORY), SEAM_ABSENT, "memory absent when mneme unbound");
    _daimon_mem_probed = 1;                          # simulate daimon advertising mneme_*
    assert_eq(seam_status(SEAM_MEMORY), SEAM_REMOTE, "memory REMOTE when mneme bound (daimon hosts mneme_*)");
    _daimon_mem_probed = 0 - 1;                      # reset (do not leak a bound cache into later tests)
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_status(SEAM_DAIMON), SEAM_ABSENT, "daimon absent when unconfigured");
    assert_eq(seam_status(SEAM_TRON), SEAM_ABSENT, "t-ron absent without a policy");
    assert_eq(seam_status(SEAM_BOTE), SEAM_NATIVE, "bote native (vendored core, M4)");
    assert_eq(seam_status(SEAM_AVATARA), SEAM_NATIVE, "avatara native (vendored archetype, M5)");
    assert_eq(seam_any_wired(), 1, "bote wired by construction");
    assert(streq(seam_status_label(SEAM_ABSENT), "absent"), "absent label");
    assert(streq(seam_status_label(SEAM_REMOTE), "remote-client"), "remote label");
    assert(streq(seam_status_label(SEAM_NATIVE), "native"), "native label");
    return 0;
}

fn test_capability_ladder() {
    test_group("capability ladder (full/degraded/absent)");
    # effect labels
    assert(streq(cap_state_label(CAP_FULL), "full"), "full label");
    assert(streq(cap_state_label(CAP_DEGRADED), "degraded"), "degraded label");
    assert(streq(cap_state_label(CAP_ABSENT), "absent"), "absent label");
    # always-native vendored seams are FULL regardless of config
    assert_eq(seam_cap_state(SEAM_BOTE), CAP_FULL, "bote full (vendored)");
    assert_eq(seam_cap_state(SEAM_AVATARA), CAP_FULL, "avatara full (vendored)");
    # unconfigured: hoosh/daimon have no fallback -> ABSENT (never faked)
    assert_eq(seam_cap_state(SEAM_HOOSH), CAP_ABSENT, "hoosh absent when unconfigured");
    assert_eq(seam_cap_state(SEAM_DAIMON), CAP_ABSENT, "daimon absent when unconfigured");
    # the honesty case: absent t-ron is DEGRADED (confirm gate), never ABSENT,
    # never silently allowing — security degrades CLOSED.
    assert_eq(seam_cap_state(SEAM_TRON), CAP_DEGRADED, "t-ron degrades closed, not absent");
    # full + fallback prose carry the honest semantics
    assert(streq(seam_cap_full(SEAM_TRON), "per-tool authorization on /run, /write, /call; deny is final"), "t-ron full prose");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_HOOSH), "absent:"), 1, "hoosh fallback is absent");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_DAIMON), "absent:"), 1, "daimon fallback is absent");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_TRON), "degraded:"), 1, "t-ron fallback is degraded");
    # memory (0.12.0): OFF by default -> ABSENT (byte-identical floor); when
    # [memory].enabled, the local .thoth/memory reader stands in -> DEGRADED
    # (never faked). mneme's semantic engine would be FULL (not reachable today).
    assert_eq(seam_cap_state(SEAM_MEMORY), CAP_ABSENT, "memory absent when disabled (default)");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_MEMORY), "absent:"), 1, "memory-off fallback is absent");
    _cfg_memory_enabled = 1;
    assert_eq(seam_cap_state(SEAM_MEMORY), CAP_DEGRADED, "memory degraded when enabled (local reader)");
    assert_eq(cstr_starts_with(seam_cap_fallback(SEAM_MEMORY), "degraded:"), 1, "memory-on fallback is degraded");
    # 0.32.0: mneme bound (daimon hosts mneme_*) -> FULL, regardless of the local flag.
    _daimon_mem_probed = 1;
    assert_eq(seam_cap_state(SEAM_MEMORY), CAP_FULL, "memory FULL when mneme bound");
    _daimon_mem_probed = 0 - 1;
    _cfg_memory_enabled = 0;
    return 0;
}

fn test_session() {
    test_group("session state");
    session_reset();
    assert_eq(session_turns(), 0, "turns start 0");
    assert_eq(session_model(), 0, "model starts none");
    session_bump_turn();
    session_bump_turn();
    assert_eq(session_turns(), 2, "two turns counted");
    session_set_model("gpt-5");
    assert(streq(session_model(), "gpt-5"), "model set");
    session_reset();
    assert_eq(session_turns(), 0, "reset clears turns");
    assert_eq(session_model(), 0, "reset clears model");
    return 0;
}

# conversation store (0.33.0): the keyed store of named conversations behind the single active thread.
fn test_conversations() {
    test_group("conversation store (0.33.0)");
    session_reset();
    assert_eq(conv_count(), 0, "no conversations until used");
    session_history_append("user", "hi in conv 0", 12);
    assert_eq(conv_count(), 1, "first append creates the default conversation");
    assert_eq(conv_active(), 0, "conversation 0 is active");
    assert_eq(session_history_len(), 1, "conv 0 has 1 message");
    assert(conv_id(0) > 0, "conversation has a positive id");
    assert(streq(conv_title(0), "hi in conv 0"), "auto-titled from the first user message (0.33.1)");
    # a new conversation is isolated + becomes active, untitled until its own first user message
    assert_eq(conv_new(), 1, "conv_new -> index 1");
    assert_eq(conv_count(), 2, "two conversations");
    assert_eq(conv_active(), 1, "the new conversation is active");
    assert_eq(conv_title(1), 0, "the new conversation starts untitled");
    assert_eq(session_history_len(), 0, "the new conversation has no messages");
    session_history_append("user", "hi in conv 1", 12);
    assert_eq(session_history_len(), 1, "conv 1 has its own message");
    assert(streq(conv_title(1), "hi in conv 1"), "conv 1 auto-titled from its first message");
    # switching restores each conversation's messages
    conv_switch(0);
    assert_eq(conv_active(), 0, "switched back to conv 0");
    assert_eq(session_history_len(), 1, "conv 0's message is intact after the round trip");
    assert(streq(session_history_content(0), "hi in conv 0"), "conv 0 content stayed isolated from conv 1");
    assert_eq(conv_switch(9), 0, "out-of-range switch keeps the active index");
    conv_set_title(0, "First chat");
    assert(streq(conv_title(0), "First chat"), "explicit title set + read back (rename)");
    # conv_delete (0.33.1): removes a conversation, fixes up the active index, never deletes the last
    assert_eq(conv_delete(1), 1, "delete conversation 1");
    assert_eq(conv_count(), 1, "one conversation left");
    assert_eq(conv_active(), 0, "active fixed up to the surviving conversation");
    assert_eq(conv_delete(0), 0, "refuse to delete the last conversation");
    assert_eq(conv_count(), 1, "still one conversation");
    # command classification (0.33.1)
    assert_eq(classify_input("/conversations"), CMD_CONVERSATIONS, "/conversations classifies");
    assert_eq(classify_input("/convos"), CMD_CONVERSATIONS, "/convos alias classifies");
    assert_eq(classify_input("/new my chat"), CMD_NEW, "/new classifies");
    assert_eq(classify_input("/switch 2"), CMD_SWITCH, "/switch classifies");
    assert_eq(classify_input("/rename foo"), CMD_RENAME, "/rename classifies");
    assert_eq(classify_input("/delete 3"), CMD_DELETE, "/delete classifies");
    assert_eq(classify_input("/search hello"), CMD_SEARCH, "/search classifies");
    # 0.33.7: cross-conversation search — the case-insensitive substring finder
    assert_eq(_search_find("Hello World", "world"), 6, "_search_find is case-insensitive (world @ 6)");
    assert_eq(_search_find("Hello World", "HELLO"), 0, "_search_find matches upper needle at 0");
    assert_eq(_search_find("Hello World", "xyz"), 0 - 1, "_search_find returns -1 when absent");
    assert_eq(_search_find("hi", "hello"), 0 - 1, "_search_find: needle longer than haystack -> -1");
    assert_eq(_search_find("abc", ""), 0, "_search_find: empty needle -> 0");
    session_reset();
    assert_eq(conv_count(), 0, "reset drops all conversations");
    return 0;
}

# context-budget meter (0.19.0): surface framed history bytes vs the ~32 KiB evict boundary that
# _hoosh_history_start uses, so context pressure is visible before it silently drops old turns.
fn test_ctx_meter() {
    test_group("context-budget meter (hoosh.cyr, 0.19.0)");
    assert_eq(hoosh_ctx_budget(), 32768, "budget is HOOSH_REQ_CAP/8 = 32 KiB");
    session_history_clear();
    assert_eq(hoosh_ctx_bytes(), 0, "empty history is 0 bytes");
    assert_eq(hoosh_ctx_evicted(), 0, "empty history evicts nothing");
    session_history_append("user", "hello", 5);
    assert_eq(hoosh_ctx_bytes(), 21, "one 'hello' = 5 content + 16 framing");
    assert_eq(hoosh_ctx_evicted(), 0, "small history evicts nothing");
    session_history_append("assistant", "world!", 6);
    assert_eq(hoosh_ctx_bytes(), 43, "two messages = 21 + (6+16)");
    # eviction: two ~20 KiB messages exceed the 32 KiB budget -> the oldest is dropped from the request
    session_history_clear();
    var big = alloc(20001);
    var i = 0;
    while (i < 20000) { store8(big + i, 120); i = i + 1; }   # 'x' * 20000
    store8(big + 20000, 0);
    session_history_append("user", big, 20000);
    assert_eq(hoosh_ctx_bytes(), 20016, "one 20K message = 20016 framed bytes");
    assert_eq(hoosh_ctx_evicted(), 0, "one 20K message fits under budget (nothing evicted)");
    session_history_append("assistant", big, 20000);
    assert_eq(hoosh_ctx_bytes(), 40032, "two 20K messages = 40032 framed bytes (> 32K budget)");
    assert_eq(hoosh_ctx_evicted(), 1, "the oldest of two over-budget turns is evicted");
    session_history_clear();
    return 0;
}

# live spine-health (0.19.3): the cached hoosh reachability driven by traffic outcomes — a turn's transport
# result (rc<0 = connection failure = DOWN; rc>=0 = the gateway answered = UP), the mark helpers, and the
# tri-state. (hoosh_health_probe needs a live gateway, so it is not unit-tested here.)
fn test_hoosh_health() {
    test_group("live spine-health (hoosh.cyr, 0.19.3)");
    hoosh_health_mark_up();
    assert_eq(hoosh_health(), HOOSH_HEALTH_UP, "mark_up -> UP");
    hoosh_health_note(0 - 1);
    assert_eq(hoosh_health(), HOOSH_HEALTH_DOWN, "a transport failure (rc<0) -> DOWN");
    hoosh_health_note(0);
    assert_eq(hoosh_health(), HOOSH_HEALTH_UP, "an answered turn (rc 0) -> UP");
    hoosh_health_note(500);
    assert_eq(hoosh_health(), HOOSH_HEALTH_UP, "a non-2xx (rc>0, gateway answered) is still UP");
    hoosh_health_mark_down();
    assert_eq(hoosh_health(), HOOSH_HEALTH_DOWN, "mark_down -> DOWN");
    return 0;
}

# The avatara persona overlay (M5): identity SOURCED from the vendored archetype
# bundle (egyptian_thoth via the prof_* accessors), not a hardcoded stub. soul +
# spirit are the prose that feeds the hoosh system prompt.
fn test_persona() {
    test_group("avatara persona (M5)");
    assert(streq(persona_name(), "Thoth"), "name from avatara archetype");
    assert(streq(persona_role(), "the Librarian"), "role is thoth's overlay framing");
    assert(persona_soul() != 0, "soul present from avatara");
    assert_eq(cstr_starts_with(persona_soul(), "You are Thoth"), 1, "soul is the Thoth archetype voice");
    assert(persona_spirit() != 0, "spirit present from avatara");
    assert_eq(cstr_starts_with(persona_spirit(), "Your nature is precision"), 1, "spirit is precision");
    assert(persona_desc() != 0, "desc present from avatara");
    # the hoosh system prompt (M5 step 2): soul + spirit + thoth's operating clause
    var sysp = persona_system_prompt();
    assert(sysp != 0, "system prompt built");
    assert_eq(cstr_starts_with(sysp, "You are Thoth"), 1, "system prompt opens with the archetype soul");
    assert(strlen(sysp) > strlen(persona_soul()), "system prompt appends spirit + operating clause");
    return 0;
}

# persona SWITCH (0.22.0): mid-session /persona — resolve via avatara find_and_validate, swap + invalidate
# the cached system prompt, role sourced per the identity split. Restores the default at the end so the M5
# test (and any later test) sees pristine Thoth.
fn test_persona_switch() {
    test_group("persona switch (session.cyr, 0.22.0)");
    persona_set(egyptian_thoth());                           # pristine default
    assert(streq(persona_name(), "Thoth") == 1, "default persona is Thoth");
    assert(streq(persona_role(), "the Librarian") == 1, "default role is 'the Librarian'");
    assert(streq(persona_tradition(), "Egyptian") == 1, "default tradition Egyptian");
    # SNAPSHOT the default prompt before switching — it is rebuilt IN PLACE, so a held pointer changes.
    var sys_default = persona_system_prompt();
    var snap = alloc(2048);
    var q = 0;
    while (load8(sys_default + q) != 0) { store8(snap + q, load8(sys_default + q)); q = q + 1; }
    store8(snap + q, 0);
    assert(cstr_starts_with(snap, "You are Thoth") == 1, "captured default prompt is the Thoth voice");

    assert_eq(persona_switch("Athena"), 1, "switch to a valid archetype (Athena) succeeds");
    assert(streq(persona_name(), "Athena") == 1, "active persona is now Athena");
    assert(streq(persona_role(), "the Librarian") == 0, "switched role is NOT 'the Librarian'");
    # 0.24.5 role modality: a switched persona's default role now derives from its DOMINANT trait aspect
    # (avatara's profile_dominant_aspect -> aspect_role), not the profile desc.
    assert(streq(persona_role(), aspect_role(profile_dominant_aspect(persona_profile()))) == 1, "switched role = dominant aspect (avatara-sourced)");
    var sys_athena = persona_system_prompt();
    assert(streq(sys_athena, snap) == 0, "system prompt rebuilt for the new persona (differs from the default)");
    assert(cstr_starts_with(sys_athena, "You are Thoth") == 0, "the rebuilt prompt is no longer the Thoth voice");

    assert_eq(persona_switch("NotARealArchetype_zzz"), 0, "unknown name -> refusal (0)");
    assert(streq(persona_name(), "Athena") == 1, "a failed switch leaves the active persona unchanged");
    assert(streq(persona_tagline(), "Thinks, Handles, Orchestrates, Transforms, Heals") == 1,
        "tagline is the fixed app backronym, constant across switches (identity split)");

    # 0.22.1 /personas card excerpt helper (returns the emitted byte count; discard the emit itself)
    out_mode_set(OUT_NULL);
    var big = alloc(128);
    var k = 0;
    while (k < 100) { store8(big + k, 97); k = k + 1; }     # 100 'a', no spaces
    store8(big + 100, 0);
    assert_eq(_persona_excerpt(big), 90, "excerpt hard-caps a no-space string at 90 bytes");
    assert_eq(_persona_excerpt("short one"), 9, "excerpt emits a short string whole (returns its length)");
    out_mode_set(OUT_FD1);

    # 0.22.2 shadow: shadow of the active persona -> a usable persona (inverted prose from avatara)
    persona_set(egyptian_thoth());
    assert_eq(persona_shadow(0), 1, "shadow of the active persona succeeds");
    assert(cstr_starts_with(persona_name(), "Shadow of ") == 1, "shadow name is 'Shadow of <base>'");
    assert(persona_soul() != 0, "shadow persona has soul prose (usable)");
    assert(streq(persona_role(), "the Librarian") == 0, "shadow role is not the Librarian");

    # 0.22.2 blend: weighted compose (Athena:2 + Odin) -> composite persona, dominant leads the voice
    persona_set(egyptian_thoth());
    var wv = vec_new();
    var ra = find_and_validate("Athena");
    var ro = find_and_validate("Odin");
    vec_push(wv, weighted_new(result_unwrap(ra), 2.0));
    vec_push(wv, weighted_new(result_unwrap(ro), 1.0));
    assert_eq(persona_blend(wv), 1, "weighted blend (Athena:2 + Odin) succeeds");
    assert(persona_soul() != 0, "blend persona has soul prose (from the dominant, usable)");
    assert(cstr_starts_with(persona_name(), "Athena") == 1, "composite name leads with the dominant (Athena)");

    persona_set(egyptian_thoth());                          # restore default for downstream tests
    assert(streq(persona_name(), "Thoth") == 1, "restored to the default Thoth");
    return 0;
}

# Config defaults when no thoth.cyml is loaded (the test process loads none).
fn test_config() {
    test_group("hoosh config (unconfigured)");
    assert_eq(config_hoosh_configured(), 0, "not configured by default");
    assert(streq(config_hoosh_url(), "http://127.0.0.1:8088"), "localhost default url");
    assert_eq(config_hoosh_token(), 0, "no token by default");
    assert_eq(config_hoosh_model(), 0, "no model by default");
    assert_eq(config_hoosh_parallel(), 1, "parallel tool calls on by default");
    # unconfigured -> hoosh seam stays absent (honest degradation)
    assert_eq(seam_status(SEAM_HOOSH), SEAM_ABSENT, "hoosh absent when unconfigured");

    # [ui].tier (0.43.2). Until this release the tier was `--tier=` ONLY, and the config parser drops
    # unknown keys with no diagnostic — so a `tier = "simple"` line under [ui] did nothing and said
    # nothing (this repo's own config carried one). ARGV STILL WINS, which is the property scripts rely
    # on, and `_oneshot_tier_seen` is what makes that decidable: the parsed default and an explicit
    # `--tier=auto` are both TIER_AUTO (0), so without it the config would override a deliberate "auto".
    var av2[64];
    store64(&av2 + 0, "thoth");
    assert_eq(_oneshot_parse(&av2, 1), ONESHOT_NONE, "bare argv parses");
    assert_eq(oneshot_tier_seen(), 0, "no --tier on argv -> not seen (the config may apply)");
    store64(&av2 + 8, "--tier=auto");
    _oneshot_parse(&av2, 2);
    assert_eq(oneshot_tier(), TIER_AUTO, "--tier=auto parses to TIER_AUTO");
    assert_eq(oneshot_tier_seen(), 1, "...and is SEEN, so [ui].tier must not override it");
    store64(&av2 + 8, "--tier=simple");
    _oneshot_parse(&av2, 2);
    assert_eq(oneshot_tier_seen(), 1, "an explicit tier is seen");
    # the config value itself maps through the same pure name->pref function main uses
    assert_eq(ui_tier_pref_from_name("simple"), TIER_SIMPLE, "[ui].tier = simple maps to TIER_SIMPLE");
    assert_eq(ui_tier_pref_from_name("rich"), TIER_RICH, "[ui].tier = rich maps to TIER_RICH");
    assert_eq(ui_tier_pref_from_name("auto"), TIER_AUTO, "[ui].tier = auto maps to TIER_AUTO");
    assert_eq(ui_tier_pref_from_name("bogus"), 0 - 1, "an unknown [ui].tier is REJECTED (main announces it)");
    assert_eq(config_ui_tier(), 0, "no [ui].tier configured in the test tree");
    return 0;
}

# The hoosh client's pure pieces: escape, int-append, request building, and
# response/error extraction (no network).
fn test_hoosh() {
    test_group("hoosh request building");
    var eb[64];
    # 0.37.0: exercise the BOUNDED escaper core (the unbounded _json_escape_into twin was deleted — a footgun); the
    # cap is generous so these tiny inputs never hit the (off+6)>=cap guard, so the escaping is byte-identical.
    var n = _json_escape_n_into_cap(&eb, 0, 64, "a\"b", 3);      # a " b
    store8(&eb + n, 0);
    assert(streq(&eb, "a\\\"b"), "escape double-quote");
    var n2 = _json_escape_n_into_cap(&eb, 0, 64, "x\ny", 3);     # x <LF> y
    store8(&eb + n2, 0);
    assert(streq(&eb, "x\\ny"), "escape newline");
    var n3 = _json_escape_n_into_cap(&eb, 0, 64, "c\\d", 3);     # c \ d
    store8(&eb + n3, 0);
    assert(streq(&eb, "c\\\\d"), "escape backslash");

    var ib[32];
    var inn = _append_int(&ib, 0, 4096);
    store8(&ib + inn, 0);
    assert(streq(&ib, "4096"), "append_int 4096");
    var iz = _append_int(&ib, 0, 0);
    store8(&ib + iz, 0);
    assert(streq(&ib, "0"), "append_int 0");

    var rb[256];
    hoosh_build_request(&rb, "m", 0, 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "request shape, no system (0)");
    hoosh_build_request(&rb, "m", "", 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "empty system omitted");
    hoosh_build_request(&rb, "m", "be precise", 0, "hi", 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"be precise\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "system message prepended");
    hoosh_build_request(&rb, "m", 0, 0, "hi", 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "stream=1 sets stream:true + usage opt");

    test_group("hoosh response extraction");
    var body = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hello world\"}}]}";
    var s = hoosh_extract_content(body, strlen(body));
    assert(s != 0, "content present");
    assert(str_eq_cstr(s, "hello world"), "content matches");

    var empty = "{\"choices\":[]}";
    assert_eq(hoosh_extract_content(empty, strlen(empty)), 0, "empty choices -> 0");
    var nojson = "not json";
    assert_eq(hoosh_extract_content(nojson, strlen(nojson)), 0, "unparseable -> 0");

    var ebody = "{\"error\":{\"message\":\"no provider for model\"}}";
    var em = hoosh_extract_error(ebody, strlen(ebody));
    assert(em != 0, "error present");
    assert(str_eq_cstr(em, "no provider for model"), "error message matches");
    assert_eq(hoosh_extract_error(body, strlen(body)), 0, "no error field -> 0");

    # 0.39.0 (audit A-6): a SATURATED request buffer must never be written past, and the returned
    # length must never name a byte outside the allocation. The bounded appenders stop with `off` at
    # exactly cap-1; `_append_int` then took no cap and wrote the `"max_tokens":<n>` digits at
    # cap-1..cap+2 — a heap OOB WRITE — and returned that over-cap length, which goes straight to
    # sandhi_http_post as the POST body length, TRANSMITTING adjacent heap bytes to the gateway.
    # Drive every capped builder past saturation and pin the invariant they all now share.
    test_group("request builders stay inside their buffer when saturated (hoosh.cyr/agent.cyr, 0.39.0)");
    var bign = 60000;                            # each 0x01 escapes to a 6-byte \u0001 -> ~360 KB >> 256 KB cap
    var bigp = alloc(bign + 1);
    var bi = 0;
    while (bi < bign) { store8(bigp + bi, 1); bi = bi + 1; }   # 0x01: worst-case 6x escape expansion
    store8(bigp + bign, 0);
    var rbuf = alloc(HOOSH_REQ_CAP + 64);        # slack AFTER the cap so an overflow is detectable, not fatal
    # The canary must start at the FIRST byte past the cap. The observed overflow was only 3-4 bytes
    # (cap .. cap+2 plus the terminator), so a canary placed further out would have sat there intact
    # and the test would have proved nothing — checked by reverting the fix and confirming it trips.
    var gi = 0;
    while (gi < 16) { store8(rbuf + HOOSH_REQ_CAP + gi, 209); gi = gi + 1; }
    var rlen = hoosh_build_request(rbuf, "m", "sys", 0, bigp, 0);
    assert(rlen <= (HOOSH_REQ_CAP - 1), "build_request: saturated length stays inside the buffer");
    assert_eq(_canary_ok(rbuf + HOOSH_REQ_CAP, 16), 1, "build_request: nothing was written past the cap (16-byte canary intact)");
    assert_eq(load8(rbuf + rlen), 0, "build_request: the returned length points at the NUL terminator");
    var dlen = hoosh_build_dry(rbuf, "m", "sys", 0, bigp, 0);
    assert(dlen <= (HOOSH_REQ_CAP - 1), "build_dry: saturated length stays inside the buffer");
    assert_eq(_canary_ok(rbuf + HOOSH_REQ_CAP, 16), 1, "build_dry: canary intact");
    var slen = _hoosh_sum_build(rbuf, "m", "sys", bigp);
    assert(slen <= (HOOSH_REQ_CAP - 1), "sum_build: saturated length stays inside its (smaller) buffer");
    assert_eq(_canary_ok(rbuf + HOOSH_REQ_CAP, 16), 1, "sum_build: canary intact");

    # --- context management: the compact floor (0.40.0, T1-5) ---
    # The 0.36.4 recap only fires when the byte framer is ALREADY skipping — a reaction to overflow.
    # /compact and [hoosh].compact_at act BEFORE the pressure bites, which needs a forced eviction point.
    # These pin the property that makes the floor safe: it can only ever evict MORE than the byte budget
    # would, never fewer (the other direction would re-admit history the framer decided cannot fit).
    # --- conversation forking (0.41.0, T2-6) ---
    # The store already did the hard part; a fork is one more operation on it. The load-bearing property
    # is that the two conversations DIVERGE: message RECORDS are copied because their last two fields are
    # attached lazily after the message exists (citations at +32, tool calls at +40, both on the newest
    # message), so sharing records would let the parent's next attach appear inside the fork.
    # 0.41.0: TOML LITERAL STRINGS were reaching consumers WITH THEIR QUOTES. `model = 'x'` produced the
    # model id `'x'`, quotes included, and the gateway 404'd on a name nobody could see was wrong. It bites
    # hardest on the keys most likely to use single quotes — a shell command in [hooks] or [verify] — and
    # for [hooks].pre_tool the result was catastrophic-but-silent: an unrunnable command exits non-zero,
    # and a non-zero exit is how pre_tool DENIES, so every tool call in the session was blocked.
    # Found by LIVE-testing against a real spine; the unit tests set config vars directly and so never went
    # through the parser at all. That gap is why this test exists at the parser boundary.
    test_group("config literal-string unquoting (config.cyr, 0.41.0)");
    assert(streq(_cfg_unquote("'quoted'"), "quoted") == 1, "a matching single-quote pair is stripped");
    assert(streq(_cfg_unquote("plain"), "plain") == 1, "an unquoted value is untouched");
    assert(streq(_cfg_unquote("\"double\""), "\"double\"") == 1, "double quotes are NOT stripped here (handled upstream)");
    assert(streq(_cfg_unquote("'unterminated"), "'unterminated") == 1, "a leading quote alone is not a pair");
    assert(streq(_cfg_unquote("trailing'"), "trailing'") == 1, "a trailing quote alone is not a pair");
    assert(streq(_cfg_unquote("'"), "'") == 1, "the single-character quote is left alone (needs two bytes)");
    assert(streq(_cfg_unquote("''"), "") == 1, "an empty literal string unquotes to empty");
    assert_eq(_cfg_unquote(0), 0, "a null value stays null");
    assert(streq(_cfg_unquote("'has space and / slash'"), "has space and / slash") == 1, "content is preserved verbatim");

    test_group("conversation forking (session.cyr, 0.41.0)");
    session_history_clear();
    var fbase = conv_active();
    session_history_append("user", "first", 5);
    session_history_append("assistant", "reply", 5);
    assert_eq(session_history_len(), 2, "parent has two messages");
    var fidx = conv_fork(fbase);
    assert(fidx >= 0, "fork returns a new index");
    assert(fidx != fbase, "...distinct from the source");
    assert_eq(conv_active(), fidx, "fork switches to the branch");
    assert_eq(session_history_len(), 2, "the fork carries the transcript");
    assert(streq(session_history_content(0), "first") == 1, "content came across");
    # DIVERGENCE: appending on the fork must not touch the parent
    session_history_append("user", "only-on-fork", 12);
    assert_eq(session_history_len(), 3, "fork grew to three");
    conv_switch(fbase);
    assert_eq(session_history_len(), 2, "the PARENT is untouched — still two");
    assert(streq(session_history_content(1), "reply") == 1, "parent's last message is unchanged");
    # and the reverse direction
    session_history_append("user", "only-on-parent", 14);
    assert_eq(session_history_len(), 3, "parent grew independently");
    conv_switch(fidx);
    assert_eq(session_history_len(), 3, "fork still has ITS three");
    assert(streq(session_history_content(2), "only-on-fork") == 1, "...with its own third message, not the parent's");
    # the record copy is what makes a lazily-attached field diverge too
    conv_switch(fbase);
    citations_reset();
    session_history_clear();
    conv_switch(fidx);
    session_history_clear();
    conv_switch(fbase);
    assert_eq(conv_fork(0 - 1), 0 - 1, "an out-of-range source is refused");
    assert_eq(conv_fork(9999), 0 - 1, "...in both directions");
    session_history_clear();

    test_group("forced compaction floor (hoosh.cyr, 0.40.0)");
    session_history_clear();
    hoosh_compact_floor_clear();
    assert_eq(hoosh_compact_floor(), 0, "floor starts clear");
    var ci = 0;
    while (ci < 10) { session_history_append("user", "hello there", 11); ci = ci + 1; }
    assert_eq(session_history_len(), 10, "ten short messages fit well inside the byte budget");
    assert_eq(_hoosh_history_start(HOOSH_REQ_CAP), 0, "with no floor the framer sends all ten");
    hoosh_compact_floor_set(4);
    assert_eq(_hoosh_history_start(HOOSH_REQ_CAP), 4, "the floor forces eviction the byte budget would not");
    hoosh_compact_floor_set(0);
    assert_eq(_hoosh_history_start(HOOSH_REQ_CAP), 0, "a zero floor is inert");
    # the floor is a FLOOR: it never re-admits what the byte budget already evicted
    hoosh_compact_floor_set(2);
    var bstart = _hoosh_history_start(1024);           # a tiny cap so the byte budget evicts hard
    assert(bstart >= 2, "a small floor never re-admits messages the byte budget dropped");
    hoosh_compact_floor_set(999);
    assert(_hoosh_history_start(HOOSH_REQ_CAP) <= session_history_len(), "a floor past the end clamps to the length");
    hoosh_compact_floor_clear();
    assert_eq(hoosh_compact_floor(), 0, "clear resets it");
    # /reset and a conversation switch must both drop the floor — it is an INDEX into one history
    hoosh_compact_floor_set(3);
    session_history_clear();
    conv_switch(conv_active());
    assert_eq(hoosh_compact_floor(), 0, "switching conversations clears the floor (it indexes one history)");
    session_history_clear();

    test_group("hoosh model catalog extraction");
    var mbody = "{\"object\":\"list\",\"data\":[{\"id\":\"claude-sonnet-4-6\"},{\"id\":\"gpt-4o\"}]}";
    var data = hoosh_extract_models(mbody, strlen(mbody));
    assert(data != 0, "model list present");
    assert_eq(bayan_json_v_arr_len(data), 2, "two models in data array");
    var m0 = bayan_json_v_obj_get(bayan_json_v_arr_get(data, 0), "id");
    assert(str_eq_cstr(bayan_json_v_str(m0), "claude-sonnet-4-6"), "first model id matches");
    var mempty = "{\"object\":\"list\",\"data\":[]}";
    assert_eq(bayan_json_v_arr_len(hoosh_extract_models(mempty, strlen(mempty))), 0, "empty catalog -> 0-length array");
    assert_eq(hoosh_extract_models(body, strlen(body)), 0, "no data field -> 0");
    assert_eq(hoosh_extract_models(nojson, strlen(nojson)), 0, "unparseable -> 0");
    # 0.39.0 (audit A-4): a NON-STRING "id" used to SIGSEGV the /models renderer. The guard was
    # `if (id != 0)`, which proves the KEY exists — but `bayan_json_v_str` answers 0 for any
    # non-JTAG_STR tag, and str_data/str_len/str_eq_cstr then dereferenced 0. The body is wire data
    # from a gateway relaying some provider's catalog, so a numeric id is a plausible upstream shape,
    # not a hostile edge case. The audit reproduced the crash in a standalone program before the fix.
    # Pinned at the extractor + accessor level, which is the layer the renderer's guard now mirrors.
    var mbadid = "{\"object\":\"list\",\"data\":[{\"id\":123},{\"id\":\"ok-model\"}]}";
    var dbad = hoosh_extract_models(mbadid, strlen(mbadid));
    assert(dbad != 0, "catalog with a numeric id still parses");
    assert_eq(bayan_json_v_arr_len(dbad), 2, "both entries present");
    var badid = bayan_json_v_obj_get(bayan_json_v_arr_get(dbad, 0), "id");
    assert(badid != 0, "the 'id' KEY exists (this is what the old guard checked)");
    assert_eq(bayan_json_v_str(badid), 0, "but its VALUE is not a string -> 0 (the deref that crashed)");
    var goodid = bayan_json_v_obj_get(bayan_json_v_arr_get(dbad, 1), "id");
    assert(str_eq_cstr(bayan_json_v_str(goodid), "ok-model"), "the well-formed sibling still renders");

    test_group("hoosh SSE delta extraction");
    var d1 = "{\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}";
    var ds = hoosh_extract_delta(d1, strlen(d1));
    assert(ds != 0, "delta content present");
    assert(str_eq_cstr(ds, "Hel"), "delta content matches");
    var drole = "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}";
    assert_eq(hoosh_extract_delta(drole, strlen(drole)), 0, "role-only delta -> 0");
    var dfin = "{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}";
    assert_eq(hoosh_extract_delta(dfin, strlen(dfin)), 0, "finish frame -> 0");
    var dnojson = "[DONE]";
    assert_eq(hoosh_extract_delta(dnojson, strlen(dnojson)), 0, "[DONE] sentinel -> 0");
    return 0;
}

# /models <provider> (0.7.1): hoosh's concrete per-provider catalog shares the
# /v1/models {object:list, data:[{id, owned_by}]} shape; the drill-down reuses
# hoosh_extract_models and filters owned_by with the case-insensitive _ci_eq.
fn test_provider_catalog() {
    test_group("provider model catalog (/models <provider>)");
    var cat = "{\"object\":\"list\",\"data\":[{\"id\":\"claude-sonnet-4\",\"object\":\"model\",\"owned_by\":\"anthropic\"},{\"id\":\"claude-opus-4\",\"object\":\"model\",\"owned_by\":\"anthropic\"},{\"id\":\"gpt-4o\",\"object\":\"model\",\"owned_by\":\"openai\"}]}";
    var d = hoosh_extract_models(cat, strlen(cat));
    assert(d != 0, "catalog data array present");
    assert_eq(bayan_json_v_arr_len(d), 3, "three catalog entries");
    var e0 = bayan_json_v_arr_get(d, 0);
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(e0, "owned_by")), "anthropic"), "entry owned_by parsed");
    assert(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(e0, "id")), "claude-sonnet-4"), "entry id parsed");
    # case-insensitive provider match (user may type 'Anthropic'; hoosh emits 'anthropic')
    assert_eq(_ci_eq("anthropic", "anthropic"), 1, "exact provider matches");
    assert_eq(_ci_eq("Anthropic", "anthropic"), 1, "provider match ignores case");
    assert_eq(_ci_eq("openai", "anthropic"), 0, "different providers do not match");
    assert_eq(_ci_eq("anthropic", "anthropi"), 0, "prefix is not a full match");
    # filter the catalog by provider (mirrors hoosh_list_provider_models)
    var matches = 0;
    var i = 0;
    while (i < bayan_json_v_arr_len(d)) {
        var m = bayan_json_v_arr_get(d, i);
        var ob = bayan_json_v_str(bayan_json_v_obj_get(m, "owned_by"));
        if (_ci_eq(str_cstr(ob), "anthropic") == 1) { matches = matches + 1; }
        i = i + 1;
    }
    assert_eq(matches, 2, "two anthropic models filtered from the catalog");
    return 0;
}

# [hoosh].stream config toggle: default on; the _cfg_bool reader maps the TOML
# literal true/false (parsed as text) and falls back on absent/garbage.
fn test_stream_config() {
    test_group("hoosh stream config");
    assert_eq(config_hoosh_stream(), 1, "streaming on by default (no config loaded)");
    assert_eq(_cfg_bool(0, "x", 1), 1, "null pairs -> default 1");
    assert_eq(_cfg_bool(0, "x", 0), 0, "null pairs -> default 0");
    var toml = "[hoosh]\nstream = false\non = true\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    var secs = bayan_toml_get_sections(sections, "hoosh");
    var pairs = bayan_toml_section_pairs(vec_get(secs, 0));
    assert_eq(_cfg_bool(pairs, "stream", 1), 0, "explicit false read as 0");
    assert_eq(_cfg_bool(pairs, "on", 0), 1, "explicit true read as 1");
    assert_eq(_cfg_bool(pairs, "missing", 1), 1, "absent key -> default");
    return 0;
}

# Token usage accounting (0.10.2): hoosh_extract_usage reads usage.total_tokens
# from a blocking completion body and from a streaming usage frame (choices:[] +
# usage), -1 when absent; the session accumulator sums only real figures and the
# seen-flag drives the honest-omit surface (ADR-0010).
fn test_usage() {
    test_group("token usage (0.10.2)");
    # blocking-completion body carrying usage
    var full = "{\"choices\":[{\"message\":{\"content\":\"hi\"}}],\"usage\":{\"prompt_tokens\":12,\"completion_tokens\":5,\"total_tokens\":17}}";
    assert_eq(hoosh_extract_usage(full, strlen(full)), 17, "blocking usage total_tokens parsed");
    # the streaming usage frame: choices empty, usage present (include_usage)
    var uframe = "{\"choices\":[],\"usage\":{\"prompt_tokens\":3,\"completion_tokens\":4,\"total_tokens\":7}}";
    assert_eq(hoosh_extract_usage(uframe, strlen(uframe)), 7, "streaming usage frame total parsed");
    # a normal delta frame has no usage -> -1 (absent, never 0)
    var delta = "{\"choices\":[{\"delta\":{\"content\":\"x\"}}]}";
    assert_eq(hoosh_extract_usage(delta, strlen(delta)), 0 - 1, "delta frame -> -1 (no usage)");
    # usage object without total_tokens -> -1
    var notot = "{\"usage\":{\"prompt_tokens\":1}}";
    assert_eq(hoosh_extract_usage(notot, strlen(notot)), 0 - 1, "usage without total_tokens -> -1");
    var nojson = "not json";
    assert_eq(hoosh_extract_usage(nojson, strlen(nojson)), 0 - 1, "unparseable body -> -1");

    # the session accumulator + seen-flag (the honest-omit gate)
    session_reset();
    assert_eq(session_tokens_seen(), 0, "no usage seen after reset");
    assert_eq(session_tokens(), 0, "zero tokens after reset");
    session_add_tokens(0 - 1);   # an absent (-1) report is ignored, never flips seen
    assert_eq(session_tokens_seen(), 0, "negative report ignored, still unseen");
    session_add_tokens(17);
    assert_eq(session_tokens_seen(), 1, "seen flips on first real report");
    assert_eq(session_tokens(), 17, "first report summed");
    session_add_tokens(7);
    assert_eq(session_tokens(), 24, "second report accumulates");
    session_reset();
    assert_eq(session_tokens(), 0, "reset clears the tally");
    assert_eq(session_tokens_seen(), 0, "reset clears the seen-flag");
    return 0;
}

# Cost accounting (0.10.3): the pure micro-USD pricing math, the $d.cc formatter, the
# [pricing.<model>] table (verbatim section-name match, including dashed ids), and the
# session cost accumulator + honest-omit seen/unpriced flags.
fn test_cost() {
    test_group("cost (0.10.3)");
    # pricing math: rates are micro-USD per 1000 tokens (= USD-per-1M x 1000).
    # 1000 prompt tokens at $3.00/1M (in_rate 3000) = $0.003 = 3000 micro-USD.
    assert_eq(hoosh_cost_micro(1000, 0, 3000, 15000), 3000, "prompt-only cost");
    # 1000 completion tokens at $15.00/1M (out_rate 15000) = $0.015 = 15000 micro-USD.
    assert_eq(hoosh_cost_micro(0, 1000, 3000, 15000), 15000, "completion-only cost");
    # 2000 in at $0.25/1M (250) + 500 out at $1.25/1M (1250) = 500 + 625 = 1125 micro-USD.
    assert_eq(hoosh_cost_micro(2000, 500, 250, 1250), 1125, "mixed cheap-model cost");
    assert_eq(hoosh_cost_micro(0, 0, 3000, 15000), 0, "zero tokens -> zero cost");

    # $d.cc formatter (truncates to whole cents; 1 cent = 10000 micro-USD).
    var cb[24];
    cost_fmt(&cb, 3000);     assert(streq(&cb, "$0.00"), "3000 micro-USD -> $0.00 (sub-cent floors)");
    cost_fmt(&cb, 50000);    assert(streq(&cb, "$0.05"), "50000 micro-USD -> $0.05");
    cost_fmt(&cb, 1234567);  assert(streq(&cb, "$1.23"), "1234567 micro-USD -> $1.23 (floors)");
    cost_fmt(&cb, 12000000); assert(streq(&cb, "$12.00"), "12000000 micro-USD -> $12.00");

    # the [pricing.<model>] table via a parsed TOML (verbatim dashed section name).
    var toml = "[pricing.claude-x]\ninput = 3000\noutput = 15000\n[pricing.cheap]\ninput = 250\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    _price_load(sections);
    assert_eq(config_price_input("claude-x"), 3000, "input rate for dashed model id");
    assert_eq(config_price_output("claude-x"), 15000, "output rate parsed");
    assert_eq(config_price_input("cheap"), 250, "second pricing section parsed");
    assert_eq(config_price_output("cheap"), 0 - 1, "missing output key -> -1");
    assert_eq(config_price_input("unknown"), 0 - 1, "unpriced model -> -1");

    # session cost accumulator + honest-omit flags.
    session_reset();
    assert_eq(session_cost_seen(), 0, "no cost seen after reset");
    assert_eq(session_cost_micro(), 0, "zero cost after reset");
    assert_eq(session_cost_unpriced_count(), 0, "no unpriced after reset");
    session_add_cost(0 - 5);                       # negative ignored
    assert_eq(session_cost_seen(), 0, "negative cost ignored, still unseen");
    session_add_cost(1125);
    assert_eq(session_cost_seen(), 1, "seen flips on first priced response");
    assert_eq(session_cost_micro(), 1125, "first cost summed");
    session_add_cost(15000);
    assert_eq(session_cost_micro(), 16125, "second cost accumulates");
    session_note_unpriced();
    assert_eq(session_cost_unpriced_count(), 1, "unpriced response counted");
    session_reset();
    assert_eq(session_cost_micro(), 0, "reset clears cost");
    assert_eq(session_cost_unpriced_count(), 0, "reset clears unpriced count");

    # end-to-end: _hoosh_account_usage wires the ACTIVE model -> [pricing] -> session
    # cost (the price-at-accumulate path the build sandbox can't exercise live). A body
    # with 1000+1000 tokens at claude-x (in 3000, out 15000) = (3e6 + 15e6)/1000 = 18000.
    _price_load(sections);                  # claude-x: in 3000, out 15000 (idempotent)
    session_reset();
    session_set_model("claude-x");
    var ubody = "{\"choices\":[{\"message\":{\"content\":\"hi\"}}],\"usage\":{\"prompt_tokens\":1000,\"completion_tokens\":1000,\"total_tokens\":2000}}";
    _hoosh_account_usage(bayan_json_v_parse_buf(ubody, strlen(ubody)));
    assert_eq(session_tokens(), 2000, "account_usage adds total_tokens");
    assert_eq(session_cost_micro(), 18000, "account_usage prices at the active model's rate");
    assert_eq(session_cost_seen(), 1, "priced response flips cost seen");
    # an unpriced active model: usage still counts tokens, but cost is noted not faked.
    session_reset();
    session_set_model("no-price-model");
    _hoosh_account_usage(bayan_json_v_parse_buf(ubody, strlen(ubody)));
    assert_eq(session_tokens(), 2000, "tokens still counted for unpriced model");
    assert_eq(session_cost_seen(), 0, "unpriced model -> cost stays unseen");
    assert_eq(session_cost_unpriced_count(), 1, "unpriced model -> noted once");
    # a HALF-declared [pricing.cheap] (input only, output omitted) must degrade to
    # unpriced+noted — NOT silently bill the missing side at $0 (ADR-0010 honest-omit).
    session_reset();
    session_set_model("cheap");
    _hoosh_account_usage(bayan_json_v_parse_buf(ubody, strlen(ubody)));
    assert_eq(session_tokens(), 2000, "tokens counted for half-declared model");
    assert_eq(session_cost_seen(), 0, "half-declared pricing -> cost stays unseen");
    assert_eq(session_cost_unpriced_count(), 1, "half-declared pricing -> noted unpriced");
    session_set_model(0);   # don't leak the test model into later tests
    session_reset();
    return 0;
}

# [alias] macros (0.11.4): the config table load + name extraction + the expand step of
# expand-then-redispatch. The dispatch recursion itself runs through dispatch() (verified
# live); here we pin the PURE pieces — table lookup/dedup, _alias_name_of, alias_expand
# (value verbatim + arg append + bounding), and the floor-identical-when-absent property.
fn test_alias() {
    test_group("[alias] macros (config.cyr / commands.cyr)");

    # _alias_name_of: the bare token after '/', up to a space or nul, cap-bounded.
    var nb[256];
    _alias_name_of("/ship", &nb, 256);     assert(streq(&nb, "ship"), "name of /ship");
    _alias_name_of("/ship arg", &nb, 256); assert(streq(&nb, "ship"), "name stops at the first space");
    _alias_name_of("/", &nb, 256);         assert(streq(&nb, ""), "bare / -> empty name");
    _alias_name_of("/  x", &nb, 256);      assert(streq(&nb, ""), "/<spaces> -> empty name");
    _alias_name_of("/abcdef", &nb, 4);     assert(streq(&nb, "abc"), "name truncates to cap-1, nul-terminated");

    # _alias_load from parsed TOML: a blank value is skipped; a duplicate key keeps the first.
    var toml = "[alias]\nship = \"/run git status\"\nexplain = \"explain this:\"\nblank = \"\"\nship = \"/second\"\n";
    var sections = bayan_toml_parse(str_new(toml, strlen(toml)));
    _alias_load(sections);
    assert_eq(config_alias_count(), 2, "two valid aliases loaded (blank skipped, dup deduped)");
    assert(streq(config_alias_lookup("ship"), "/run git status"), "duplicate key -> first definition wins");
    assert(streq(config_alias_lookup("explain"), "explain this:"), "lookup explain");
    assert_eq(config_alias_lookup("blank"), 0, "blank-value alias not stored");
    assert_eq(config_alias_lookup("nope"), 0, "undeclared alias -> 0");

    # alias_expand: the value verbatim, with any trailing args appended after one space.
    assert(streq(alias_expand("/ship", 0), "/run git status"), "expand /ship");
    assert(streq(alias_expand("/explain foo bar", 0), "explain this: foo bar"), "expand appends trailing args");
    assert_eq(alias_expand("/nope", 0), 0, "no alias -> 0 (falls through to unknown-command)");

    # per-depth buffers are disjoint: a depth-1 expansion must not clobber a depth-0 one.
    var d0 = alias_expand("/ship", 0);
    var d1 = alias_expand("/explain z", 1);
    assert(d0 != d1, "different depths use different buffer slots");
    assert(streq(d0, "/run git status"), "depth-0 line intact after a depth-1 expansion");

    # bounding: a value longer than ALIAS_LINE_CAP truncates and stays nul-terminated
    # (white-box: install an oversized value directly, past the parsed table).
    var bigval[2100];
    var bi = 0;
    while (bi < 2048) { store8(&bigval + bi, 65); bi = bi + 1; }   # 2048 'A'
    store8(&bigval + 2048, 0);
    store64(_alias_names + config_alias_count() * 8, "big");
    store64(_alias_vals + config_alias_count() * 8, &bigval);
    _alias_n = _alias_n + 1;
    var big = alias_expand("/big", 0);
    assert(big != 0, "oversized-value alias still resolves");
    assert_eq(strlen(big), ALIAS_LINE_CAP - 1, "expansion truncated to ALIAS_LINE_CAP-1");
    assert_eq(load8(big + ALIAS_LINE_CAP - 1), 0, "truncated expansion stays nul-terminated");

    # an alias name >= 256 chars is SKIPPED at load (it could never match a typed token,
    # which the TUI caps at 255) — so it is not a dead, count-inflating entry. Build
    # "[alias]\n<256 'a'> = \"x\"\n" and confirm the table stays empty.
    var lt[400];
    var lp = 0;
    var hdr = "[alias]\n";
    var hi = 0;
    while (load8(hdr + hi) != 0) { store8(&lt + lp, load8(hdr + hi)); lp = lp + 1; hi = hi + 1; }
    var ai = 0;
    while (ai < 256) { store8(&lt + lp, 97); lp = lp + 1; ai = ai + 1; }   # a 256-char name
    var tl = " = \"x\"\n";
    var ti = 0;
    while (load8(tl + ti) != 0) { store8(&lt + lp, load8(tl + ti)); lp = lp + 1; ti = ti + 1; }
    var oversec = bayan_toml_parse(str_new(&lt, lp));
    _alias_load(oversec);
    assert_eq(config_alias_count(), 0, "256-char alias name skipped at load (no dead unmatchable entry)");

    # floor: with no aliases loaded, expansion is always 0 -> the unknown-command path is
    # byte-identical to a build without alias support.
    _alias_n = 0;
    assert_eq(alias_expand("/ship", 0), 0, "no aliases -> no expansion (byte-identical floor)");
    return 0;
}

# /dry request-body preview (0.11.5): hoosh_build_dry composes the EXACT request body
# thoth would send for a task WITHOUT mutating session history (so /dry is side-effect-free).
# The bodies are deterministic, so we pin them with exact string equality; the no-mutation
# invariant is the load-bearing guarantee.
fn test_dry() {
    test_group("/dry request preview (hoosh.cyr / commands.cyr)");
    session_set_model(0);
    session_reset();
    var dst[4096];

    # /dry classifies + the model accessor mirrors hoosh_send's precedence.
    assert_eq(classify_input("/dry write a fn"), CMD_DRY, "/dry classifies to CMD_DRY");
    assert(streq(hoosh_model_cur(), "default"), "no model set -> 'default' (hoosh routes)");
    session_set_model("claude-x");
    assert(streq(hoosh_model_cur(), "claude-x"), "session model wins");
    session_set_model(0);

    # bare body: empty history, no system, blocking -> a single user message.
    var l1 = hoosh_build_dry(&dst, "m", 0, 0, "hi", 0);
    store8(&dst + l1, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: bare user turn");

    # with a system (persona) message prepended.
    var l2 = hoosh_build_dry(&dst, "m", "SYS", 0, "hi", 0);
    store8(&dst + l2, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"SYS\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: system + user");

    # streaming adds stream + stream_options (matching the real request shape).
    var l3 = hoosh_build_dry(&dst, "m", 0, 0, "hi", 1);
    store8(&dst + l3, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "dry body: streaming flags");

    # with conversation history: the tail is serialized, then the PENDING user turn,
    # and history is NOT mutated by the preview.
    session_history_append("user", "Q", 1);
    session_history_append("assistant", "A", 1);
    var before = session_history_len();
    var l4 = hoosh_build_dry(&dst, "m", 0, 0, "now", 0);
    store8(&dst + l4, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"Q\"},{\"role\":\"assistant\",\"content\":\"A\"},{\"role\":\"user\",\"content\":\"now\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: history tail + pending user");
    assert_eq(session_history_len(), before, "hoosh_build_dry does NOT mutate history (side-effect-free)");

    # the prompt is JSON-escaped like the real builders (a quote can't break the body).
    session_reset();                       # clear the history appended above
    var l5 = hoosh_build_dry(&dst, "m", 0, 0, "a\"b", 0);
    store8(&dst + l5, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"a\\\"b\"}],\"max_tokens\":4096,\"stream\":false}"), "dry body: prompt is JSON-escaped");

    session_set_model(0);
    session_reset();
    return 0;
}

# One-shot / argv front-door (0.11.0): the pure argv classifier + task assembly.
# _oneshot_parse takes a hand-built argv snapshot (cstr-ptr array) so the mode
# selection and positional-joining are testable without the real /proc/self/cmdline.
fn test_oneshot() {
    test_group("one-shot / argv (0.11.0)");
    var av[64];   # 8 cstr pointers x 8 bytes (buffers are BYTES, not entries)
    store64(&av + 0, "thoth");
    assert_eq(_oneshot_parse(&av, 1), ONESHOT_NONE, "no argv task -> NONE (TUI/REPL)");
    store64(&av + 8, "review");
    store64(&av + 16, "this");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "positionals -> RUN");
    assert(streq(_oneshot_task, "review this"), "positionals joined by a space");
    store64(&av + 8, "--version");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_VERSION, "--version -> VERSION");
    store64(&av + 8, "-v");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_VERSION, "-v -> VERSION");
    store64(&av + 8, "--help");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_HELP, "--help -> HELP");
    store64(&av + 8, "-h");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_HELP, "-h -> HELP");
    store64(&av + 8, "-p");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "-p forces RUN (task from stdin)");
    store64(&av + 8, "-p");
    store64(&av + 16, "summarize");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "-p + positional -> RUN");
    assert(streq(_oneshot_task, "summarize"), "the -p flag is not part of the task");
    # --tier (0.11.10): a global modifier — parsed, mapped to a pref, does NOT force a run.
    store64(&av + 8, "--tier=rich");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "--tier alone -> NONE (no run forced)");
    assert_eq(oneshot_tier(), TIER_RICH, "--tier=rich -> TIER_RICH");
    assert_eq(oneshot_tier_bad(), 0, "valid tier -> not bad");
    store64(&av + 8, "--tier"); store64(&av + 16, "simple");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_NONE, "--tier simple (space form) -> NONE");
    assert_eq(oneshot_tier(), TIER_SIMPLE, "--tier simple -> TIER_SIMPLE");
    store64(&av + 8, "--tier"); store64(&av + 16, "auto");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_NONE, "--tier auto -> NONE");
    assert_eq(oneshot_tier(), TIER_AUTO, "--tier auto -> TIER_AUTO");
    store64(&av + 8, "--tier=bogus");
    _oneshot_parse(&av, 2);
    assert_eq(oneshot_tier_bad(), 1, "--tier=bogus -> bad flag");
    assert_eq(oneshot_tier(), TIER_AUTO, "a bad tier value falls back to AUTO");
    # the space form must NOT swallow a following flag: --tier --version still yields VERSION
    store64(&av + 8, "--tier"); store64(&av + 16, "--version");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_VERSION, "--tier --version -> VERSION (flag not eaten)");
    # a real value still leaves a following positional as the task -> RUN
    store64(&av + 8, "--tier"); store64(&av + 16, "rich"); store64(&av + 24, "do"); store64(&av + 32, "x");
    assert_eq(_oneshot_parse(&av, 5), ONESHOT_RUN, "--tier rich + positional -> RUN");
    assert_eq(oneshot_tier(), TIER_RICH, "--tier rich applied alongside a task");
    assert(streq(_oneshot_task, "do x"), "the task excludes '--tier rich'");
    # task buffer: reset + bounded append
    _oneshot_task_reset();
    assert_eq(_oneshot_task_len, 0, "task reset clears the length");
    assert_eq(_oneshot_task_append_cstr("abc"), 3, "append returns bytes written");
    assert(streq(_oneshot_task, "abc"), "append assembles the task");
    return 0;
}

# 0.43.2 — piped stdin is UNTRUSTED and must not reach the @mention reader.
#
# `cmd | thoth <task>` appends the pipe to the task, and cmd_task's second act is mention_expand(),
# an UNJAILED reader (no project confinement, no `..` rejection, no absolute-path rejection) whose
# safety premise is "the path came from a message the USER typed". A piped `git diff` is whatever a
# contributor wrote, so a `@/home/you/.ssh/id_rsa` line in it was read and POSTed to the gateway —
# silently, because one-shot runs under OUT_NULL and even the "(+1 file(s) attached)" notice is
# discarded. _oneshot_compose_prompt splits the task by PROVENANCE; this pins the split.
#
# `@VERSION` is the probe because VERSION is git-TRACKED — a local-only fixture would pass here and
# fail in CI. The expansion marker is the delimiter mention.cyr writes, not the file's contents.
fn test_oneshot_pipe_provenance() {
    test_group("piped stdin is untrusted — no @mention expansion (oneshot.cyr, 0.43.2)");
    # (a) argv only: the operator's OWN words — expansion is unchanged.
    _oneshot_task_reset();
    assert_eq(_oneshot_stdin_at, 0 - 1, "reset clears the piped-payload split");
    _oneshot_task_append_cstr("check @VERSION");
    var p1 = _oneshot_compose_prompt();
    assert_eq(_ui_contains(p1, "--- @VERSION ---"), 1, "an argv @mention still expands");

    # (b) argv + piped payload: the SAME mention must stay literal on the piped side.
    _oneshot_task_reset();
    _oneshot_task_append_cstr("review this");
    _oneshot_argv_len = _oneshot_task_len;
    _oneshot_task_append("\n\n", 2);
    _oneshot_stdin_at = _oneshot_task_len;
    _oneshot_task_append_cstr("+ consult @VERSION for the number");
    var p2 = _oneshot_compose_prompt();
    assert_eq(_ui_contains(p2, "review this"), 1, "the argv half survives the compose");
    assert_eq(_ui_contains(p2, "@VERSION"), 1, "the piped @mention stays in the text, literally");
    assert_eq(_ui_contains(p2, "--- @VERSION ---"), 0, "a piped @mention is NOT expanded");

    # (c) -p: stdin is the WHOLE task (no argv half) — the payload survives intact, unexpanded.
    _oneshot_task_reset();
    _oneshot_argv_len = 0;
    _oneshot_stdin_at = 0;
    _oneshot_task_append_cstr("summarize @VERSION please");
    var p3 = _oneshot_compose_prompt();
    assert_eq(_ui_contains(p3, "summarize @VERSION please"), 1, "-p keeps the whole piped task");
    assert_eq(_ui_contains(p3, "--- @VERSION ---"), 0, "-p does not expand a piped @mention");

    # (d) a mixed task expands the argv half exactly ONCE — the piped copy adds no second block.
    _oneshot_task_reset();
    _oneshot_task_append_cstr("read @VERSION");
    _oneshot_argv_len = _oneshot_task_len;
    _oneshot_task_append("\n\n", 2);
    _oneshot_stdin_at = _oneshot_task_len;
    _oneshot_task_append_cstr("and also @VERSION from the pipe");
    var p4 = _oneshot_compose_prompt();
    assert_eq(_ui_contains(p4, "--- @VERSION ---"), 1, "the argv half of a mixed task expands");
    assert_eq(mention_count(), 1, "exactly one file is attached — the piped copy adds none");
    return 0;
}

# JSON-envelope output (0.11.6): the --json/-j one-shot flag (a modifier, not a mode) and the
# pure envelope serializer. tokens/cost follow ADR-0010 omit-until-present; the reply escapes
# BY LENGTH (an embedded NUL survives). elapsed_ms is a param so the builder is deterministic.
fn test_json_envelope() {
    test_group("JSON-envelope output (oneshot.cyr / hoosh.cyr)");

    # ⚠ 0.44.2 — THE ENVELOPE USED THE UNBOUNDED _append_int. Every bounded appender before it stops with
    # `off` at cap-1, so once an earlier field saturated the buffer, _append_int wrote digits at cap,
    # cap+1, ... and then a NUL past the end — a heap out-of-bounds WRITE — and returned a length GREATER
    # than the cap, which the caller hands straight to emit_raw_n and the -o writer. Adjacent heap bytes
    # were printed to stdout and written to the user's file. Exactly the 0.39.0 A-6 defect, in the one
    # builder that never got the _cap treatment. A tiny cap forces the saturation deterministically.
    var eb[80];
    var ei = 0;
    while (ei < 80) { store8(&eb + ei, 0xEE); ei = ei + 1; }        # canary the WHOLE buffer
    var elen = oneshot_json_envelope(&eb, 48, "a reply long enough to saturate a 48-byte envelope", 50, 123456);
    assert(elen <= 47, "the returned length never names a byte outside the buffer");
    assert_eq(load8(&eb + elen), 0, "the NUL lands inside the allocation");
    assert_eq(load8(&eb + 60), 0xEE, "and nothing past the cap was touched");

    var av[64];
    store64(&av + 0, "thoth");
    # --json / -j set the flag without forcing a run or joining the task.
    store64(&av + 8, "--json");
    store64(&av + 16, "task");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "--json + task -> RUN");
    assert_eq(_oneshot_json, 1, "--json sets the json flag");
    assert(streq(_oneshot_task, "task"), "--json is not part of the task");
    store64(&av + 8, "-j");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_RUN, "-j + task -> RUN");
    assert_eq(_oneshot_json, 1, "-j sets the json flag");
    # --json alone records the flag but is no run intent -> NONE (falls through to the TUI).
    store64(&av + 8, "--json");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "--json alone -> NONE (no task)");
    # a plain task leaves the flag clear; the n<=1 early return RESETS it (no stale flag).
    store64(&av + 8, "plain");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "plain task -> RUN");
    assert_eq(_oneshot_json, 0, "no --json -> flag stays 0");
    store64(&av + 8, "--json");
    _oneshot_parse(&av, 2);
    assert_eq(_oneshot_json, 1, "flag set before the reset check");
    assert_eq(_oneshot_parse(&av, 1), ONESHOT_NONE, "n<=1 -> NONE");
    assert_eq(_oneshot_json, 0, "the n<=1 early return resets the json flag (no stale)");
    # the --json elif must not break -p (its else branch still runs the positional path).
    store64(&av + 8, "-p");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "-p still forces RUN after the --json elif");
    assert_eq(_oneshot_json, 0, "-p does not set json");

    # the envelope serializer (deterministic — elapsed is a param).
    session_set_model(0);
    session_reset();
    session_bump_turn();              # turns -> 1
    session_set_model("m");
    var jb[2048];
    var e1 = oneshot_json_envelope(&jb, 2048, "hi", 2, 42);
    store8(&jb + e1, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\",\"turns\":1,\"elapsed_ms\":42}"), "envelope: response+model+turns+elapsed (no tokens/cost yet)");
    session_add_tokens(100);
    var e2 = oneshot_json_envelope(&jb, 2048, "hi", 2, 42);
    store8(&jb + e2, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\",\"turns\":1,\"tokens\":100,\"elapsed_ms\":42}"), "envelope: +tokens once seen");
    session_add_cost(18000);          # 18000 micro-USD = $0.018 -> $0.01 (floors)
    var e3 = oneshot_json_envelope(&jb, 2048, "hi", 2, 42);
    store8(&jb + e3, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\",\"turns\":1,\"tokens\":100,\"cost\":\"$0.01\",\"elapsed_ms\":42}"), "envelope: +cost once priced");

    # the reply is escaped BY LENGTH — an embedded NUL becomes \u0000, not a truncation.
    session_reset();
    session_bump_turn();
    session_set_model("m");
    var rbuf[8];
    store8(&rbuf + 0, 97);            # 'a'
    store8(&rbuf + 1, 0);             # NUL
    store8(&rbuf + 2, 98);            # 'b'
    var e4 = oneshot_json_envelope(&jb, 2048, &rbuf, 3, 7);
    store8(&jb + e4, 0);
    assert(streq(&jb, "{\"response\":\"a\\u0000b\",\"model\":\"m\",\"turns\":1,\"elapsed_ms\":7}"), "envelope: embedded NUL escaped by length");
    # a model id with a quote is JSON-escaped (can't break the object).
    session_set_model("m\"x");
    var e5 = oneshot_json_envelope(&jb, 2048, "hi", 2, 0);
    store8(&jb + e5, 0);
    assert(streq(&jb, "{\"response\":\"hi\",\"model\":\"m\\\"x\",\"turns\":1,\"elapsed_ms\":0}"), "envelope: model id JSON-escaped");
    session_set_model(0);
    session_reset();
    return 0;
}

# -o / --out file tee (0.11.7): the flag parse (consumes the next token as the path, not a
# positional; dangling -o; reset across calls) and the file writer (tees bytes + a trailing
# newline, matching stdout; degrades closed on an unwritable path). The writer is unit-testable
# because file I/O works in the harness (a scratch file under build/), unlike a live TCP turn.
fn test_oneshot_out() {
    test_group("-o / --out file tee (oneshot.cyr)");
    var av[64];
    store64(&av + 0, "thoth");
    # -o consumes the NEXT token as the path; the path is NOT joined into the task.
    store64(&av + 8, "-o");
    store64(&av + 16, "out.txt");
    store64(&av + 24, "task");
    assert_eq(_oneshot_parse(&av, 4), ONESHOT_RUN, "-o <file> <task> -> RUN");
    assert(streq(_oneshot_out_path, "out.txt"), "-o records the output path");
    assert(streq(_oneshot_task, "task"), "the -o path is not part of the task");
    # --out alias + -o is a modifier (path but no task -> NONE, like --json alone).
    store64(&av + 8, "--out");
    store64(&av + 16, "f2");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_NONE, "--out <file> alone -> NONE (no task)");
    assert(streq(_oneshot_out_path, "f2"), "--out still records the path");
    # a dangling -o (no following token) leaves no path and no crash.
    store64(&av + 8, "-o");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "dangling -o -> NONE");
    assert_eq(_oneshot_out_path, 0, "dangling -o leaves no path");
    # reset across calls: a plain task clears the out path.
    store64(&av + 8, "plain");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "plain task -> RUN");
    assert_eq(_oneshot_out_path, 0, "no -o -> out path reset to 0");
    # -o composes with --json and a positional task.
    store64(&av + 8, "-o");
    store64(&av + 16, "o.json");
    store64(&av + 24, "--json");
    store64(&av + 32, "do it");
    assert_eq(_oneshot_parse(&av, 5), ONESHOT_RUN, "-o + --json + task -> RUN");
    assert(streq(_oneshot_out_path, "o.json"), "-o path set with --json present");
    assert_eq(_oneshot_json, 1, "--json flag set alongside -o");

    # the writer: a reply with no trailing newline gets one (matching stdout).
    var path = "build/.thoth_out_test.tmp";
    var rbuf[64];
    assert_eq(_oneshot_write_out(path, "hello", 5), 0, "write_out succeeds");
    var n1 = file_read_all(path, &rbuf, 63);
    assert_eq(n1, 6, "file = 'hello' + a trailing newline");
    store8(&rbuf + n1, 0);
    assert(streq(&rbuf, "hello\n"), "file content is the bytes + a newline");
    # a reply ALREADY ending in a newline is not doubled.
    assert_eq(_oneshot_write_out(path, "bye\n", 4), 0, "write_out (already-newline) succeeds");
    var n2 = file_read_all(path, &rbuf, 63);
    assert_eq(n2, 4, "already-newline reply is not doubled");
    store8(&rbuf + n2, 0);
    assert(streq(&rbuf, "bye\n"), "no extra newline appended");
    # an unwritable path degrades closed (-1), not a crash or a silent success.
    assert_eq(_oneshot_write_out("/no_such_dir_thoth_xyz/f", "x", 1), 0 - 1, "unwritable path -> -1 (degrade closed)");
    return 0;
}

# shell completion (0.11.8): the --completion / --completions parse — the COMPLETION mode and
# the captured shell name (default, reset, position-independent short-circuit). The emitted
# bash/zsh SCRIPTS are validated by a host smoke (`thoth --completion bash | bash -n`, `zsh -n`,
# and a functional COMPREPLY check) — shell tools the in-process unit harness lacks.
fn test_completion() {
    test_group("shell completion parse (oneshot.cyr)");
    var av[64];
    store64(&av + 0, "thoth");
    # --completion <shell> -> COMPLETION mode + the captured shell name.
    store64(&av + 8, "--completion");
    store64(&av + 16, "bash");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_COMPLETION, "--completion <shell> -> COMPLETION");
    assert(streq(_oneshot_compl_shell, "bash"), "--completion captures the shell name");
    store64(&av + 16, "zsh");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_COMPLETION, "--completion zsh -> COMPLETION");
    assert(streq(_oneshot_compl_shell, "zsh"), "shell = zsh");
    # the --completions alias.
    store64(&av + 8, "--completions");
    store64(&av + 16, "bash");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_COMPLETION, "--completions alias -> COMPLETION");
    # no shell given -> COMPLETION, shell stays 0 (the printer defaults to bash).
    store64(&av + 8, "--completion");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_COMPLETION, "--completion (no shell) -> COMPLETION");
    assert_eq(_oneshot_compl_shell, 0, "no shell -> 0 (printer defaults to bash)");
    # position-independent short-circuit (like --version): a task before --completion still wins.
    store64(&av + 8, "task");
    store64(&av + 16, "--completion");
    store64(&av + 24, "zsh");
    assert_eq(_oneshot_parse(&av, 4), ONESHOT_COMPLETION, "--completion after a task still short-circuits");
    assert(streq(_oneshot_compl_shell, "zsh"), "shell captured after a positional");
    # reset across calls: a plain task clears the captured shell.
    store64(&av + 8, "hello");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_RUN, "plain task -> RUN");
    assert_eq(_oneshot_compl_shell, 0, "no --completion -> shell reset to 0");
    return 0;
}

# Multi-turn conversation history (0.5.1): append/accessors, stable copy,
# pop/clear, and the drop-oldest cap.
fn test_history() {
    test_group("multi-turn history");
    session_reset();
    assert_eq(session_history_len(), 0, "history empty after reset");
    assert_eq(config_hoosh_history(), 1, "history on by default");

    session_history_append("user", "hello", 5);
    session_history_append("assistant", "hi there", 8);
    assert_eq(session_history_len(), 2, "two messages recorded");
    assert(streq(session_history_role(0), "user"), "msg 0 role user");
    assert(streq(session_history_content(0), "hello"), "msg 0 content");
    assert(streq(session_history_role(1), "assistant"), "msg 1 role assistant");
    assert(streq(session_history_content(1), "hi there"), "msg 1 content");

    # content is a STABLE COPY, not an alias of the caller's buffer.
    var buf[8];
    store8(&buf + 0, 104); store8(&buf + 1, 105); store8(&buf + 2, 0);   # "hi"
    session_history_append("user", &buf, 2);
    store8(&buf + 0, 88);                                                # clobber -> "Xi"
    assert(streq(session_history_content(2), "hi"), "content copied, not aliased");

    session_history_pop_last();
    assert_eq(session_history_len(), 2, "pop_last drops the newest turn");
    session_history_clear();
    assert_eq(session_history_len(), 0, "clear empties history");

    var i = 0;
    while (i < SESS_HIST_MAX + 5) { session_history_append("user", "x", 1); i = i + 1; }
    assert_eq(session_history_len(), SESS_HIST_MAX, "capped at SESS_HIST_MAX (oldest dropped)");
    session_reset();
    return 0;
}

# rewind for /retry (regenerate-last) + /edit (edit-last) — 0.34.0. Exercises the pure session helpers the two
# commands share: locate the last user message, then drop it + its reply and return the exact stored prompt.
fn test_rewind() {
    test_group("rewind for /retry + /edit (0.34.0)");
    session_reset();
    assert_eq(session_last_user_index(), 0 - 1, "no user message in an empty conversation");
    assert_eq(session_rewind_to_last_user(), 0, "rewind on empty returns 0 (nothing to rewind)");

    # a completed two-turn conversation: rewind drops the LAST turn (user + reply) only
    session_history_append("user", "first q", 7);
    session_history_append("assistant", "first a", 7);
    session_history_append("user", "second q", 8);
    session_history_append("assistant", "second a", 8);
    assert_eq(session_history_len(), 4, "four messages recorded");
    assert_eq(session_last_user_index(), 2, "the last user message is index 2 (second q)");
    assert(streq(session_last_assistant_content(), "second a"), "session_last_assistant_content -> the newest reply (0.34.4 /bookmark)");
    var c = session_rewind_to_last_user();
    assert(streq(c, "second q"), "rewind returns the LAST user message's content");
    assert_eq(session_history_len(), 2, "rewind dropped the last turn (user + its reply)");
    assert(streq(session_history_content(0), "first q"), "the earlier turn's user message is intact");
    assert(streq(session_history_content(1), "first a"), "the earlier turn's reply is intact");
    assert_eq(session_last_user_index(), 0, "now the earlier user message is the last user");

    # a user message with no reply yet (an aborted / failed turn) still rewinds
    session_reset();
    session_history_append("user", "lonely q", 8);
    assert_eq(session_last_user_index(), 0, "a lone user message is found");
    var d = session_rewind_to_last_user();
    assert(streq(d, "lonely q"), "rewind returns the lone user message's content");
    assert_eq(session_history_len(), 0, "rewind emptied the conversation");

    # the returned content is a STABLE copy — usable after the message is dropped AND after later appends
    session_reset();
    session_history_append("user", "keepme", 6);
    session_history_append("assistant", "reply", 5);
    var e = session_rewind_to_last_user();
    session_history_append("user", "unrelated later message", 23);   # further mutation must not disturb e
    assert(streq(e, "keepme"), "rewound content survives later appends (stable copy, never freed)");

    # session_history_last_is_reply_for: a fresh assistant reply tagged with `turn` is detected length-independently
    session_reset();
    session_history_append("user", "q", 1);            # turn 0 (no bump)
    session_history_append("assistant", "a", 1);       # turn 0
    assert_eq(session_history_last_is_reply_for(0), 1, "last is an assistant reply for turn 0");
    assert_eq(session_history_last_is_reply_for(7), 0, "not a reply for a different turn");
    session_history_append("user", "q2", 2);           # now the last message is a user
    assert_eq(session_history_last_is_reply_for(0), 0, "a trailing user message is not a reply");

    # settle RESTORES when the re-run recorded no fresh reply (transport/empty/stateless failure)
    session_reset();
    session_history_append("user", "keep-q", 6);
    session_history_append("assistant", "keep-a", 6);
    session_rewind_to_last_user();                     # snapshot [keep-q, keep-a]; history now empty
    assert_eq(session_history_len(), 0, "rewind emptied history before the re-run");
    assert_eq(session_rewind_settle(session_turns()), 1, "settle restores when no fresh reply landed");
    assert_eq(session_history_len(), 2, "the prior exchange is restored");
    assert(streq(session_history_content(0), "keep-q"), "restored user prompt intact");
    assert(streq(session_history_content(1), "keep-a"), "restored reply intact");
    assert_eq(session_rewind_settle(session_turns()), 0, "settle is a no-op once the snapshot is consumed");

    # settle COMMITS (drops the snapshot, no restore) when a fresh reply landed
    session_reset();
    session_history_append("user", "old-q", 5);
    session_history_append("assistant", "old-a", 5);
    session_rewind_to_last_user();                     # snapshot [old-q, old-a]; history empty
    session_bump_turn();                               # simulate the re-run's new turn
    var t = session_turns();
    session_history_append("user", "new-q", 5);        # tagged turn t
    session_history_append("assistant", "new-a", 5);   # tagged turn t -> a fresh reply landed
    assert_eq(session_rewind_settle(t), 0, "settle commits (no restore) when a fresh reply landed");
    assert_eq(session_history_len(), 2, "the re-run's exchange stands, the old one is not re-added");
    assert(streq(session_history_content(0), "new-q"), "committed to the new prompt");

    # rollback reverts the TITLE too: a failed re-run may auto-title a previously-untitled conversation; restore
    # must undo that so no stale title survives (an untitled conv has an empty first line -> _conv_autotitle -> 0).
    session_reset();
    session_history_append("user", "\nleading-blank first line", 25);   # empty first line -> stays UNTITLED
    assert_eq(conv_title(0), 0, "conversation is untitled (empty first line)");
    session_history_append("assistant", "a reply", 7);
    session_rewind_to_last_user();                     # snapshot the messages AND the (0) title
    session_bump_turn();                               # the re-run's new turn
    session_history_append("user", "titled edit", 11); # a re-run's user append auto-titles the untitled conv
    assert(conv_title(0) != 0, "the re-run's append auto-titled the untitled conversation");
    session_history_pop_last();                        # ...then the turn FAILS -> agent_turn rolls back the user append
    assert_eq(session_rewind_settle(session_turns()), 1, "settle restores when no fresh reply landed");
    assert_eq(session_history_len(), 2, "the old exchange is restored");
    assert_eq(conv_title(0), 0, "restore reverted the title to untitled (no stale title survives)");
    assert(streq(session_history_content(0), "\nleading-blank first line"), "the old first message is restored");
    session_reset();
    return 0;
}

# a test front-end interrupt hook (the GUI's 0.34.2 mechanism): a registered poll that raises the flag.
fn _test_intr_hook() { intr_signal(); return 0; }

# the front-end-agnostic interrupt seam (0.34.1): intr_signal/check/pending + the hook + suspend/resume no-ops.
fn test_interrupt() {
    test_group("agentic-loop interrupt seam (0.34.1)");
    intr_check_hook_set(0);                    # start from the built-in stdin poll
    intr_reset();
    assert_eq(intr_pending(), 0, "flag clear after reset");
    assert_eq(intr_check(), 0, "check is clear with no hook + not armed (built-in stdin poll, no-op)");
    intr_signal();
    assert_eq(intr_pending(), 1, "signal raises the flag");
    assert_eq(intr_check(), 1, "check reports the raised flag");
    intr_reset();
    assert_eq(intr_pending(), 0, "reset clears the flag");
    # suspend/resume are no-ops off the TUI (intr is never armed there) — they must not disturb the flag
    assert_eq(intr_armed(), 0, "not armed outside the TUI (OUT_RING-gated)");
    intr_signal();
    intr_suspend();
    intr_resume();
    assert_eq(intr_pending(), 1, "suspend/resume preserve the flag (no-ops when not armed)");
    intr_reset();
    # a registered front-end poll HOOK (the GUI plugs its input poll here) — intr_check invokes it
    intr_check_hook_set(&_test_intr_hook);
    assert_eq(intr_check(), 1, "check invokes the registered front-end hook, which signalled interrupt");
    intr_check_hook_set(0);                    # unregister so later tests use the stdin poll
    intr_reset();
    assert_eq(intr_check(), 0, "after unregistering + reset, check is clear again");

    # _agent_finish_interrupted (0.34.1): the interrupt LANDING — the new tool-phase abort shares it with the
    # streaming (kind 4) abort, so a cancelled turn leaves history a clean sequence of completed exchanges.
    # Case A: a streamed partial is KEPT — appended as the assistant reply, completing the user+assistant pair.
    session_reset();
    session_history_append("user", "do a thing", 10);
    _hoosh_acc_reset();
    _hoosh_acc_append("partial answer so far", 21);
    _agent_finish_interrupted(0);
    assert_eq(session_history_len(), 2, "interrupt with a partial: user + assistant recorded");
    assert(streq(session_history_role(1), "assistant"), "the kept partial is an assistant reply");
    assert(streq(session_history_content(1), "partial answer so far"), "the partial content is what was recorded");
    # Case B: nothing streamed this round -> the unanswered user turn is POPPED (no dangling half-exchange).
    session_reset();
    session_history_append("user", "another thing", 13);
    _hoosh_acc_reset();                        # no partial
    assert_eq(session_history_len(), 1, "user recorded before the interrupt");
    _agent_finish_interrupted(0);
    assert_eq(session_history_len(), 0, "interrupt with no partial: the unanswered user turn is popped");
    session_reset();
    _hoosh_acc_reset();
    return 0;
}

# The multi-turn request builder + the byte-budget that bounds it.
fn test_history_request() {
    test_group("multi-turn request building");
    session_reset();
    assert_eq(_hoosh_history_start(262144), 0, "empty history -> start 0");
    session_history_append("user", "a", 1);
    session_history_append("assistant", "b", 1);
    session_history_append("user", "c", 1);
    assert_eq(_hoosh_history_start(262144), 0, "ample budget includes all");
    assert_eq(_hoosh_history_start(8), 2, "tiny budget keeps only the newest");

    var rb[512];
    hoosh_build_messages(&rb, "m", 0, 0, 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"a\"},{\"role\":\"assistant\",\"content\":\"b\"},{\"role\":\"user\",\"content\":\"c\"}],\"max_tokens\":4096,\"stream\":false}"), "multi-turn shape, no system");
    hoosh_build_messages(&rb, "m", "sys", 0, 1);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"a\"},{\"role\":\"assistant\",\"content\":\"b\"},{\"role\":\"user\",\"content\":\"c\"}],\"max_tokens\":4096,\"stream\":true,\"stream_options\":{\"include_usage\":true}}"), "multi-turn shape, system + stream + usage opt");
    session_reset();
    return 0;
}

# Composer input-history recall (0.11.1): the in-memory ring + nav cursor
# (src/inhist.cyr) and the TUI load/stash glue (src/tui.cyr _tui_recall_*). DISTINCT
# from the multi-turn CONVERSATION history above — this is the user's own keystrokes,
# navigated with Up/Down in the raw-mode composer (TUI-only; the REPL floor is
# untouched).
fn test_inhist() {
    test_group("input-history recall");
    inhist_init();
    assert_eq(inhist_count(), 0, "empty after init");
    assert_eq(inhist_nav_at_draft(), 1, "cursor starts at the draft");
    assert_eq(inhist_nav_up(), 0 - 1, "Up with no history -> -1 (nothing)");

    # push records lines; ignoredups + skip-empty.
    assert_eq(inhist_push("first", 5), 1, "push 'first' stored");
    assert_eq(inhist_push("second", 6), 1, "push 'second' stored");
    assert_eq(inhist_push("", 0), 0, "empty line skipped");
    assert_eq(inhist_push("second", 6), 0, "consecutive duplicate skipped (ignoredups)");
    assert_eq(inhist_count(), 2, "two distinct lines stored");
    assert(streq(inhist_entry_ptr(0), "first"), "entry 0 = oldest = 'first'");
    assert(streq(inhist_entry_ptr(1), "second"), "entry 1 = newest = 'second'");
    assert_eq(inhist_entry_len(1), 6, "newest length");

    # nav: reset to draft, then Up walks newest->oldest, Down walks back to the draft.
    inhist_nav_reset();
    assert_eq(inhist_nav_at_draft(), 1, "reset -> draft");
    assert_eq(inhist_nav_up(), 1, "Up #1 -> newest (idx 1)");
    assert_eq(inhist_nav_at_draft(), 0, "now navigating");
    assert_eq(inhist_nav_up(), 0, "Up #2 -> older (idx 0)");
    assert_eq(inhist_nav_up(), 0, "Up at the oldest clamps (idx 0)");
    assert_eq(inhist_nav_down(), 1, "Down -> newer (idx 1)");
    assert_eq(inhist_nav_down(), 0 - 1, "Down past the newest -> draft (-1)");
    assert_eq(inhist_nav_at_draft(), 1, "back at the draft");

    # the TUI glue: stash a half-typed draft, load recalled entries, restore the draft.
    led_reset();
    led_feed(KEY_CHAR, 97); led_feed(KEY_CHAR, 98);   # type "ab"
    assert_eq(led_len(), 2, "draft 'ab' in the composer");
    _tui_recall_stash_draft();
    _tui_recall_load(1);                              # load newest 'second'
    assert(streq(led_buf(), "second"), "composer loaded with 'second'");
    assert_eq(led_len(), 6, "composer len = 6 after recall");
    assert_eq(led_cur(), 6, "cursor at end after recall");
    _tui_recall_load(0);                              # load oldest 'first'
    assert(streq(led_buf(), "first"), "composer loaded with 'first'");
    _tui_recall_restore_draft();                     # back to the stashed draft
    assert(streq(led_buf(), "ab"), "draft 'ab' restored");
    assert_eq(led_len(), 2, "draft len restored");

    # ring eviction: fill past INHIST_CAP — the oldest drops, count caps, order holds.
    inhist_init();
    var b[16];
    var i = 0;
    while (i < INHIST_CAP + 3) {
        var o = 1;
        store8(&b, 76);                              # 'L'
        o = _append_int(&b, o, i);                   # distinct lines "L0".."L130"
        store8(&b + o, 0);
        inhist_push(&b, o);
        i = i + 1;
    }
    assert_eq(inhist_count(), INHIST_CAP, "count caps at INHIST_CAP (oldest evicted)");
    assert(streq(inhist_entry_ptr(0), "L3"), "oldest is 'L3' after evicting L0,L1,L2");
    assert(streq(inhist_entry_ptr(INHIST_CAP - 1), "L130"), "newest is 'L130'");
    inhist_init();
    led_reset();
    return 0;
}

# Input-history PERSISTENCE (0.11.2): the opt-in on-disk file. Uses real file I/O under
# build/ (gitignored). Verifies load->ring, save->reload round-trip, ignoredups across
# persistence, and the degrade-closed unwritable-path path. The 0600 create-mode is
# asserted empirically by the shell (stat) after the suite creates the mode-check file.
fn test_inhist_persist() {
    test_group("input-history persistence (0.11.2)");
    var lpath = "build/.thoth_hist_load.tmp";
    var seed = "alpha\nalpha\nbeta\n";          # a consecutive dup -> proves init is non-destructive
    file_write_all(lpath, seed, strlen(seed));
    inhist_init();
    var n = inhist_persist_init(lpath);
    assert_eq(n, 2, "two recalled (the consecutive dup collapses in the ring)");
    assert_eq(inhist_count(), 2, "ring holds two");
    assert(streq(inhist_entry_ptr(0), "alpha"), "oldest = alpha");
    assert(streq(inhist_entry_ptr(1), "beta"), "newest = beta");
    assert_eq(inhist_nav_at_draft(), 1, "cursor at the draft after load");
    assert_eq(inhist_persist_active(), 1, "persistence active (file writable)");
    assert_eq(inhist_persist_broke(), 0, "not broken after a clean init");

    # init is NON-DESTRUCTIVE: the file is untouched (still holds the raw dup, not rewritten).
    var rbuf[64];
    var r1 = file_read_all(lpath, &rbuf, 63);
    store8(&rbuf + r1, 0);
    assert(streq(&rbuf, "alpha\nalpha\nbeta\n"), "init did not rewrite the file");

    # a stored submit rewrites the file FROM the ring (deduped/normalized); a reload sees it.
    inhist_push("gamma", 5);
    inhist_persist_save();
    var r2 = file_read_all(lpath, &rbuf, 63);
    store8(&rbuf + r2, 0);
    assert(streq(&rbuf, "alpha\nbeta\ngamma\n"), "save rewrote the file from the ring");
    inhist_init();
    _inhist_load_file(lpath);
    assert_eq(inhist_count(), 3, "gamma persisted -> three on reload");
    assert(streq(inhist_entry_ptr(2), "gamma"), "newest reloaded = gamma");

    # multi-line + backslash round-trip (0.11.9): embedded newlines (from the multi-line
    # composer) and literal backslashes survive save->reload — escaped on write, decoded on
    # read — instead of shattering the line-oriented file into bogus entries.
    inhist_init();
    var mpath = "build/.thoth_hist_ml.tmp";
    file_write_all(mpath, "", 0);                # start empty (isolate from a prior run's file)
    inhist_persist_init(mpath);                  # bind (empty -> ring empty)
    inhist_push("a\nb", 3);                      # an embedded newline (a multi-line entry)
    inhist_push("c\\d", 3);                      # a literal backslash
    inhist_persist_save();
    inhist_init();
    _inhist_load_file(mpath);
    assert_eq(inhist_count(), 2, "two entries round-trip (no shatter on embedded newline)");
    assert_eq(inhist_entry_len(0), 3, "multi-line entry length intact (a<nl>b)");
    assert(streq(inhist_entry_ptr(0), "a\nb"), "embedded newline preserved");
    assert(streq(inhist_entry_ptr(1), "c\\d"), "literal backslash preserved");

    # _inhist_escape_into (pure): '\' -> '\\', newline -> '\' 'n', plain bytes pass through.
    var ebuf[32];
    var en = _inhist_escape_into(&ebuf, 32, "a\nb", 3);
    store8(&ebuf + en, 0);
    assert_eq(en, 4, "3-byte 'a<nl>b' escapes to 4 bytes");
    assert(streq(&ebuf, "a\\nb"), "newline encodes as backslash-n");
    var en2 = _inhist_escape_into(&ebuf, 32, "c\\d", 3);
    store8(&ebuf + en2, 0);
    assert_eq(en2, 4, "3-byte 'c\\d' escapes to 4 bytes");
    assert(streq(&ebuf, "c\\\\d"), "backslash encodes as double backslash");

    # degrade-closed: an unwritable path -> persistence stays OFF (-1); the caller announces.
    inhist_init();
    var bad = inhist_persist_init("build/.no_such_dir_xyz/hist.tmp");
    assert_eq(bad, 0 - 1, "unwritable path -> -1");
    assert_eq(inhist_persist_active(), 0, "persistence OFF after a write failure");

    # create the 0600 mode-check file (fresh path); the shell asserts the perms post-suite.
    inhist_init();
    inhist_persist_init("build/.thoth_hist_mode.tmp");

    inhist_persist_init(0);          # unbind persistence -> clean slate for later tests
    inhist_init();
    led_reset();
    return 0;
}

# Structured driver-event logging (0.5.2): the pure message builder + level
# parse + config defaults. The sakshi emit path is I/O and not unit-tested here.
fn test_logging() {
    test_group("structured logging");
    # off by default (no config, no init)
    assert_eq(config_log_file(), 0, "no log file by default");
    assert_eq(config_log_level(), 0, "no log level by default");
    assert_eq(log_active(), 0, "logging off without init");

    # level parse
    assert_eq(_log_parse_level("off"), 0 - 1, "off -> disabled");
    assert_eq(_log_parse_level("fatal"), SK_FATAL, "fatal");
    assert_eq(_log_parse_level("error"), SK_ERROR, "error");
    assert_eq(_log_parse_level("warn"), SK_WARN, "warn");
    assert_eq(_log_parse_level("info"), SK_INFO, "info");
    assert_eq(_log_parse_level("debug"), SK_DEBUG, "debug");
    assert_eq(_log_parse_level("trace"), SK_TRACE, "trace");
    assert_eq(_log_parse_level(0), SK_INFO, "unset -> default info");
    assert_eq(_log_parse_level("bogus"), SK_INFO, "unknown -> default info");

    # structured message builder
    log_begin("hoosh_turn");
    log_kv_str("model", "gpt-5");
    log_kv_int("status", 200);
    assert(streq(log_message(), "event=hoosh_turn model=gpt-5 status=200"), "structured message shape");
    log_begin("authz");
    log_kv_str("tool", 0);
    assert(streq(log_message(), "event=authz tool=-"), "null value renders as -");
    log_begin("x");
    log_kv_int("d", 0 - 5);
    assert(streq(log_message(), "event=x d=-5"), "negative int field");

    # --- 0.44.2: the SESSION LOG ---
    # ⚠ `[log].file` WITH NO `[log].level` CRASHED THOTH AT STARTUP: the announcement did emit(lvls) with
    # lvls == 0, and emit is write(2, s, strlen(s)) — strlen(0) faults. That is the OBVIOUS way to write
    # the config (the level has a default), so the crash sat on the likeliest spelling of the feature.
    # Here we can only prove the level RESOLVES without a configured string; log_init's file open is I/O.
    assert_eq(_log_parse_level(config_log_level()), SK_INFO, "file-without-level resolves to the info default (no null deref)");

    # log_text: long values become a RUN of part=i of=n lines rather than one clipped record.
    # The chunker is exercised through log_message by driving log_begin/log_kv_int directly — log_text
    # itself commits through sakshi, which needs a bound sink.
    var lt = alloc(LOG_TEXT_CHUNK * 2 + 16);
    var li = 0;
    while (li < (LOG_TEXT_CHUNK + 5)) { store8(lt + li, 97); li = li + 1; }   # 'a' x (chunk+5)
    store8(lt + li, 0);
    assert_eq((strlen(lt) + LOG_TEXT_CHUNK - 1) / LOG_TEXT_CHUNK, 2, "a value 5 bytes past one chunk needs exactly two parts");

    # _log_append_clean neutralises what would otherwise END the record early or reach a terminal.
    log_begin("t");
    _log_append(" v=");
    var lc = alloc(8);
    store8(lc + 0, 65); store8(lc + 1, 10); store8(lc + 2, 27); store8(lc + 3, 66); store8(lc + 4, 0);   # "A\n<ESC>B"
    _log_append_clean(lc, 4);
    assert(streq(log_message(), "event=t v=A\\n?B"), "a newline becomes a literal \\n and ESC becomes '?' — one record stays one line");

    # log_tool renders the verdict as a word (log.cyr is included BEFORE roundlog.cyr, so it cannot
    # reference RL_*; the caller passes roundlog_kind_str, and these are the three it can produce).
    assert(streq(roundlog_kind_str(RL_ALLOWED), "allow"), "roundlog verdict word: allow");
    assert(streq(roundlog_kind_str(RL_DENIED), "deny"), "roundlog verdict word: deny");
    assert(streq(roundlog_kind_str(RL_NONAME), "noname"), "roundlog verdict word: noname");
    return 0;
}

# --- 0.44.2: --logs / --log-level on argv ---------------------------------------------------------
# `[log].file` binds logging from the CONFIG — read after several things that can already fail, and only
# if the operator wrote it down BEFORE the session that broke. `--logs FILE` binds it from argv at the top
# of main, so a run that dies on a bad config, an unreachable gateway or a hang still leaves a record.
fn test_logs_flag() {
    test_group("--logs / --log-level (0.44.2)");
    var av[64];

    # --logs=FILE (attached form)
    store64(&av + 0, "thoth"); store64(&av + 8, "--logs=/tmp/t.log");
    assert_eq(_oneshot_parse(&av, 2), ONESHOT_NONE, "--logs alone does NOT force a one-shot (it is a modifier, like -o)");
    assert(streq(oneshot_log_path(), "/tmp/t.log"), "--logs=FILE captures the path");
    assert_eq(oneshot_log_level(), 0, "no level given -> unset (log_argv_init defaults it to debug)");

    # --logs FILE (separate form) + --log-level
    store64(&av + 0, "thoth"); store64(&av + 8, "--logs"); store64(&av + 16, "/tmp/s.log");
    store64(&av + 24, "--log-level"); store64(&av + 32, "warn"); store64(&av + 40, "review this");
    assert_eq(_oneshot_parse(&av, 6), ONESHOT_RUN, "a task alongside --logs still runs one-shot");
    assert(streq(oneshot_log_path(), "/tmp/s.log"), "--logs FILE consumes the next token");
    assert(streq(oneshot_log_level(), "warn"), "--log-level FILE consumes the next token");
    assert(streq(_oneshot_task, "review this"), "neither flag's VALUE leaks into the task text");

    # the singular spelling half of everyone types
    store64(&av + 0, "thoth"); store64(&av + 8, "--log=/tmp/one.log");
    _oneshot_parse(&av, 2);
    assert(streq(oneshot_log_path(), "/tmp/one.log"), "--log= is accepted as a synonym");

    # ⚠ a following FLAG is never eaten as the value (same rule --tier and -o follow)
    store64(&av + 0, "thoth"); store64(&av + 8, "--logs"); store64(&av + 16, "--version");
    assert_eq(_oneshot_parse(&av, 3), ONESHOT_VERSION, "--logs --version still prints the version");
    assert_eq(oneshot_log_path(), 0, "a dangling --logs captures no path rather than eating the next flag");

    # absent -> 0, and the parser RESETS both before its early return (no stale path across calls)
    store64(&av + 0, "thoth");
    assert_eq(_oneshot_parse(&av, 1), ONESHOT_NONE, "bare thoth -> interactive");
    assert_eq(oneshot_log_path(), 0, "no --logs -> no path (state reset before the early return)");
    assert_eq(oneshot_log_level(), 0, "no --log-level -> no level");
    return 0;
}

# --- 0.44.2: [hoosh].timeout_ms ------------------------------------------------------------------
# Until this key existed thoth passed sandhi no options, so read_ms was 0, so SO_RCVTIMEO was never set
# and every recv was unbounded. A gateway that accepted and then went silent parked thoth in recv
# permanently — with Esc unpolled and Ctrl-C disabled by the TUI's own termios, only kill recovered it.
fn test_hoosh_timeout() {
    test_group("[hoosh].timeout_ms (0.44.2)");
    var saved = _cfg_hoosh_timeout_ms;
    _cfg_hoosh_timeout_ms = 0 - 1;
    assert_eq(config_hoosh_timeout_ms(), HOOSH_TIMEOUT_MS_DEFAULT, "absent -> the generous default (a stall detector, not a latency budget)");
    _cfg_hoosh_timeout_ms = 0;
    assert_eq(config_hoosh_timeout_ms(), 0, "an explicit 0 restores the pre-0.44.2 unbounded behaviour");
    _cfg_hoosh_timeout_ms = 5;
    assert_eq(config_hoosh_timeout_ms(), HOOSH_TIMEOUT_MS_MIN, "a silly-small value is floored, not honoured");
    _cfg_hoosh_timeout_ms = 45000;
    assert_eq(config_hoosh_timeout_ms(), 45000, "a real value passes through");
    assert_eq(_cfg_known_key("hoosh", "timeout_ms"), 1, "timeout_ms is a KNOWN key (the 0.43.5 spell-checker must not flag it)");
    # the probe profile is deliberately NOT configurable: raising the turn timeout for a slow model must
    # not turn a reachability check that runs before the first paint into a three-minute freeze.
    assert(HOOSH_PROBE_MS < HOOSH_TIMEOUT_MS_DEFAULT, "the probe deadline is far shorter than the turn deadline");
    assert(HOOSH_PROBE_CONNECT_MS < HOOSH_CONNECT_MS, "so is its connect deadline");
    _cfg_hoosh_timeout_ms = saved;
    return 0;
}

# M4 config defaults when no thoth.cyml is loaded.
fn test_config_m4() {
    test_group("daimon/tron config (unconfigured)");
    assert_eq(config_daimon_configured(), 0, "daimon not configured by default");
    assert_eq(config_daimon_url(), 0, "no daimon url by default");
    assert_eq(config_tron_policy(), 0, "no t-ron policy by default");
    assert(streq(config_tron_agent(), "thoth"), "default agent id");
    assert_eq(gate_active(), 0, "gate inactive without a policy");
    return 0;
}

# Mid-session model switch stores a COPY (the arg aliases a reused line buffer).
fn test_model_switch() {
    test_group("mid-session model switch");
    session_reset();
    assert_eq(session_model(), 0, "no model after reset");
    var scratch[16];
    store8(&scratch + 0, 103); store8(&scratch + 1, 112); store8(&scratch + 2, 116);
    store8(&scratch + 3, 0);                                   # "gpt"
    session_set_model_copy(&scratch);
    store8(&scratch + 0, 88);                                  # clobber to "Xpt"
    assert(streq(session_model(), "gpt"), "model is a stable copy, not an alias");
    # 0.22.3 terminal window-title builder (pure): the active model appears in the title
    var tb = alloc(256);
    session_set_model_copy("opus-x");
    _term_title_build(tb, 256);
    assert(streq(tb, "thoth - opus-x") == 1, "title reflects the active model (session_model wins)");
    # control bytes (BEL 0x07 / ESC 0x1b / DEL 0x7f) in the model are stripped -> no OSC escape injection
    var mbuf[16];
    store8(&mbuf + 0, 97); store8(&mbuf + 1, 7); store8(&mbuf + 2, 98);   # 'a' BEL 'b'
    store8(&mbuf + 3, 27); store8(&mbuf + 4, 99); store8(&mbuf + 5, 127); store8(&mbuf + 6, 0);  # ESC 'c' DEL
    session_set_model_copy(&mbuf);
    _term_title_build(tb, 256);
    assert(streq(tb, "thoth - abc") == 1, "control bytes stripped from the title (no escape injection)");
    session_reset();
    return 0;
}

fn test_git() {
    test_group("git producer (git.cyr / SEAM_GIT, 0.13.0)");
    # seam registration on the capability ladder
    assert_eq(SEAM_COUNT, 7, "SEAM_COUNT includes git (7)");
    assert(streq(seam_name(SEAM_GIT), "sit"), "SEAM_GIT owner is sit");
    assert_eq(seam_status(SEAM_GIT), SEAM_NATIVE, "sit binds native by construction (vendored bundle)");
    assert_eq(_ui_contains(seam_domain(SEAM_GIT), "version control"), 1, "domain names version control");
    # probe is callable; git_present() matches the probe result and is a clean 0/1
    var p = git_probe();
    assert(((p == 0) || (p == 1)), "git_probe returns 0/1");
    assert_eq(git_present(), p, "git_present matches the probe result");
    # capability-effect <-> presence invariant (holds whether or not there's a repo)
    if (git_present() == 1) {
        # cyrius test runs at the thoth repo root -> a real read through sit's .git backend
        assert_eq(seam_cap_state(SEAM_GIT), CAP_FULL, "repo present -> capability FULL");
        # A present repo may be on a NAMED branch or a DETACHED HEAD — CI checkouts are
        # commonly detached (GitHub Actions checks out a bare SHA), so don't assume a branch.
        # Attached -> git_branch() is a real name; detached -> the '?' sentinel (the UI renders
        # "(detached)" off git_detached(), never the sentinel). Assert whichever case holds.
        if (git_detached() == 0) {
            assert_eq(streq(git_branch(), "?"), 0, "attached -> a real branch, not the '?' sentinel");
        } else {
            assert_eq(streq(git_branch(), "?"), 1, "detached -> git_branch() is the '?' sentinel (UI shows (detached))");
        }
        assert(git_dirty() >= 0, "dirty count is a non-negative snapshot");
    } else {
        assert_eq(seam_cap_state(SEAM_GIT), CAP_ABSENT, "no repo at cwd -> capability ABSENT (honest, never faked)");
    }
    # ensure_probed is idempotent — same result, no re-crash
    git_ensure_probed();
    assert_eq(git_present(), p, "ensure_probed keeps the probe result stable");

    # 0.22.4 file-tree git badges: git_status_of over the per-file status cache (white-box: inject entries,
    # then re-probe to restore the real state). kinds 1=modified, 2=new, 3=deleted; 0 = unchanged / no repo.
    if (_git_status_ptr == 0) { _git_status_ptr = alloc(GIT_STATUS_MAX * 8); _git_status_kind = alloc(GIT_STATUS_MAX); _git_status_buf = alloc(GIT_STATUS_BUF); }
    _git_present = 1;
    store64(_git_status_ptr + 0, "src/main.cyr");  store8(_git_status_kind + 0, 1);
    store64(_git_status_ptr + 8, "docs/x.md");      store8(_git_status_kind + 1, 2);
    store64(_git_status_ptr + 16, "gone.txt");      store8(_git_status_kind + 2, 3);
    _git_status_n = 3;
    assert_eq(git_status_of("src/main.cyr"), 1, "modified -> kind 1");
    assert_eq(git_status_of("docs/x.md"), 2, "new -> kind 2");
    assert_eq(git_status_of("gone.txt"), 3, "deleted -> kind 3");
    assert_eq(git_status_of("untouched.cyr"), 0, "unchanged path -> 0");
    _git_present = 0;
    assert_eq(git_status_of("src/main.cyr"), 0, "no repo -> 0 regardless of the cache");
    git_probe();   # restore the real probe state for any later reader
    return 0;
}

# _save_read: read back a file a /save test just wrote, closing the two hazards the 0.43.2 review found.
# (1) file_read_all returns NEGATIVE on failure, and the old `store8(buf + n, 0)` then wrote BEFORE the
#     buffer — an out-of-bounds store in the failure path of every one of these five sites.
# (2) The callers now xunlink() the fixed /tmp path first. Without that, a save that silently failed
#     (cmd_save returns 0 on an open failure just as it does on success) read back a LEFTOVER file from
#     an earlier run and satisfied every assertion — green over a save that never happened.
fn _save_read(path, buf, cap) {
    var n = file_read_all(path, buf, cap);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return n;
}

fn test_save() {
    test_group("/save transcript export (feed_strip_ansi_into + cmd_save, 0.24.1)");
    # --- feed_strip_ansi_into: drop role/reset markers + CSI, keep text ---
    var src = alloc(64);
    var o = 0;
    store8(src + o, 65); o = o + 1; store8(src + o, 66); o = o + 1;    # "AB"
    store8(src + o, 27); o = o + 1; store8(src + o, 176); o = o + 1;   # role marker  ESC + 0xB0
    store8(src + o, 67); o = o + 1; store8(src + o, 68); o = o + 1;    # "CD"
    store8(src + o, 27); o = o + 1; store8(src + o, 91); o = o + 1;    # CSI intro    ESC + '['
    store8(src + o, 51); o = o + 1; store8(src + o, 49); o = o + 1; store8(src + o, 109); o = o + 1;  # "31m"
    store8(src + o, 69); o = o + 1; store8(src + o, 70); o = o + 1;    # "EF"
    store8(src + o, 27); o = o + 1; store8(src + o, 191); o = o + 1;   # reset marker ESC + 0xBF
    store8(src + o, 71); o = o + 1; store8(src + o, 72); o = o + 1;    # "GH"
    var dst = alloc(64);
    var n = feed_strip_ansi_into(dst, 64, src, o);
    store8(dst + n, 0);
    assert_eq(n, 8, "stripped length is 8 (ABCDEFGH)");
    assert(streq(dst, "ABCDEFGH") == 1, "role markers + CSI stripped; text preserved");
    var s2 = alloc(4); store8(s2, 88); store8(s2 + 1, 27);            # "X" + a trailing lone ESC
    var n2 = feed_strip_ansi_into(dst, 64, s2, 2);
    store8(dst + n2, 0);
    assert(streq(dst, "X") == 1, "trailing lone ESC dropped; X preserved");
    var n3 = feed_strip_ansi_into(dst, 64, "plain", 5);
    store8(dst + n3, 0);
    assert(streq(dst, "plain") == 1, "plain text passes verbatim");

    # --- cmd_save round-trip: populate the ring, save, read the file back ---
    feed_init();
    out_mode_set(OUT_RING);
    oprintln("first line");
    ui_emit(ROLE_ACCENT, "second"); emit(" line"); feed_flush_pending();   # a line carrying a role marker
    out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 2, "ring holds 2 lines");
    xunlink("/tmp/thoth_save_test.md");
    cmd_save("/save /tmp/thoth_save_test.md");
    var rb = alloc(4096);
    var rn = _save_read("/tmp/thoth_save_test.md", rb, 4095);
    assert(rn > 0, "saved file is non-empty");
    assert(_ui_contains(rb, "# thoth transcript") == 1, "file has the markdown header");
    assert(_ui_contains(rb, "first line") == 1, "file contains the first feed line");
    assert(_ui_contains(rb, "second line") == 1, "file contains the second line, ANSI-stripped");
    var has_esc = 0; var k = 0;
    while (k < rn) { if (load8(rb + k) == 27) { has_esc = 1; } k = k + 1; }
    assert_eq(has_esc, 0, "saved file has no escape bytes (markers fully stripped)");

    # --- cmd_save LINE-MODE path (0.27.0): empty feed ring -> save the conversation history ---
    feed_init();                       # clears the ring -> line-mode /save path
    assert_eq(feed_count(), 0, "ring empty for the line-mode /save path");
    session_history_clear();
    session_history_append("user", "hello there", 11);
    session_history_append("assistant", "hi! reply", 9);
    xunlink("/tmp/thoth_save_hist.md");
    cmd_save("/save /tmp/thoth_save_hist.md");
    var hb = alloc(4096);
    var hn = _save_read("/tmp/thoth_save_hist.md", hb, 4095);
    assert(hn > 0, "history-mode saved file is non-empty");
    assert(_ui_contains(hb, "# thoth transcript") == 1, "history file has the markdown header");
    assert(_ui_contains(hb, "## user") == 1, "history file has a user turn header");
    assert(_ui_contains(hb, "hello there") == 1, "history file has the user content");
    assert(_ui_contains(hb, "## assistant") == 1, "history file has an assistant turn header");
    assert(_ui_contains(hb, "hi! reply") == 1, "history file has the assistant content");
    session_history_clear();
    return 0;
}

fn test_session_persist() {
    test_group("conversation resume ([session].file, session.cyr, 0.24.2)");
    # --- _sess_uint_into (decimal formatter) ---
    var b = alloc(16);
    var e = _sess_uint_into(b, 0, 0); store8(b + e, 0); assert(streq(b, "0") == 1, "uint 0");
    e = _sess_uint_into(b, 0, 12345); store8(b + e, 0); assert(streq(b, "12345") == 1, "uint 12345");
    # --- _sess_role_literal maps to STABLE literals (append stores the ptr uncopied) ---
    assert(streq(_sess_role_literal("assistant", 9), "assistant") == 1, "role literal: assistant");
    assert(streq(_sess_role_literal("user", 4), "user") == 1, "role literal: user");
    assert(streq(_sess_role_literal("weird", 5), "user") == 1, "unknown role -> user");

    # --- save -> clear -> load round-trip, incl. multi-line content (length-prefixed, no escaping) ---
    session_history_clear();
    session_history_append("user", "hello there", 11);
    session_history_append("assistant", "hi! line1\nline2", 15);   # embedded newline
    session_history_append("user", "bye", 3);
    assert_eq(session_history_len(), 3, "3 messages in memory");
    assert_eq(_sess_write_file("/tmp/thoth_sess_test"), 0, "write file ok");
    session_history_clear();
    assert_eq(session_history_len(), 0, "cleared in memory");
    assert_eq(_sess_load_file("/tmp/thoth_sess_test"), 3, "loaded 3 records");
    assert_eq(session_history_len(), 3, "3 messages restored");
    assert(streq(session_history_role(0), "user") == 1, "msg0 role user");
    assert(streq(session_history_content(0), "hello there") == 1, "msg0 content round-trips");
    assert(streq(session_history_role(1), "assistant") == 1, "msg1 role assistant");
    assert(streq(session_history_content(1), "hi! line1\nline2") == 1, "msg1 MULTI-LINE content survives (length-prefixed)");
    assert(streq(session_history_content(2), "bye") == 1, "msg2 content round-trips");

    # --- a foreign / corrupt first line -> load skipped (0), nothing corrupted ---
    var fd = file_open("/tmp/thoth_sess_bad", O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    file_write(fd, "NOT-A-SESSION\nuser\t3\nabc\n", 25);
    file_close(fd);
    session_history_clear();
    assert_eq(_sess_load_file("/tmp/thoth_sess_bad"), 0, "foreign magic -> load skipped");
    assert_eq(session_history_len(), 0, "nothing loaded from a foreign file");
    assert_eq(_sess_load_file("/tmp/thoth_no_such_sess_zzz"), 0, "absent file -> 0 (no crash)");

    # --- sess_persist_init end-to-end: load + activate; a later save rewrites the window ---
    session_history_clear();
    session_history_append("user", "q1", 2);
    session_history_append("assistant", "a1", 2);
    _sess_write_file("/tmp/thoth_sess_init");
    session_history_clear();
    assert_eq(sess_persist_init("/tmp/thoth_sess_init"), 2, "init resumed 2 messages");
    assert_eq(sess_persist_active(), 1, "init activated persistence");
    assert_eq(sess_persist_resumed(), 2, "resumed count = 2");
    session_history_append("user", "q2", 2);
    session_history_append("assistant", "a2", 2);   # would trigger sess_persist_save() live; call it explicitly
    sess_persist_save();
    session_history_clear();
    assert_eq(_sess_load_file("/tmp/thoth_sess_init"), 4, "the save persisted all 4 messages");

    # --- the reported resume count is capped at what survives SESS_HIST_MAX=40 (review-caught fix) ---
    var fd2 = file_open("/tmp/thoth_sess_big", O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    file_write(fd2, "THOTH-SESSION-1\n", 16);
    var rec = 0;
    while (rec < 42) { file_write(fd2, "user\t1\nx\n", 9); rec = rec + 1; }   # 42 one-byte records
    file_close(fd2);
    session_history_clear();
    var big = sess_persist_init("/tmp/thoth_sess_big");
    assert_eq(session_history_len(), 40, "history capped at SESS_HIST_MAX=40");
    assert_eq(big, 40, "reported resumed count capped at 40 (not the 42 parsed)");
    assert_eq(sess_persist_resumed(), 40, "sess_persist_resumed() == 40");

    # --- 0.33.2: multi-conversation persistence (THOTH-SESSION-2) round-trip ---
    _sess_path = 0;                # no live auto-save during the build
    session_reset();              # fresh store (default conv created on first append)
    session_history_append("user", "in alpha", 8);        # conv 0 -> auto-titled "in alpha"
    session_history_append("assistant", "reply a", 7);
    conv_new();                                            # conv 1 (untitled)
    conv_set_title(conv_active(), "beta chat");           # explicit title (not derived from a message)
    session_history_append("user", "in beta", 7);
    conv_switch(0);                                        # save with conv 0 active
    assert_eq(conv_count(), 2, "v2: two conversations before save");
    assert_eq(_sess_write_file("/tmp/thoth_sess_v2"), 0, "v2 write ok");
    session_reset();                                       # drop the whole store
    assert_eq(conv_count(), 0, "v2: store dropped before load");
    assert_eq(_sess_load_file("/tmp/thoth_sess_v2"), 3, "v2 load: 3 total message records");
    assert_eq(conv_count(), 2, "v2 load: 2 conversations restored");
    assert_eq(conv_active(), 0, "v2 load: active conversation index restored");
    assert(streq(conv_title(0), "in alpha") == 1, "v2 load: conv0 auto-title restored");
    assert(streq(conv_title(1), "beta chat") == 1, "v2 load: conv1 explicit title restored");
    conv_switch(0);
    assert_eq(session_history_len(), 2, "v2 load: conv0 has 2 messages");
    assert(streq(session_history_content(0), "in alpha") == 1, "v2 load: conv0 msg0 content");
    assert(streq(session_history_role(1), "assistant") == 1, "v2 load: conv0 msg1 role");
    conv_switch(1);
    assert_eq(session_history_len(), 1, "v2 load: conv1 has 1 message (isolated)");
    assert(streq(session_history_content(0), "in beta") == 1, "v2 load: conv1 msg0 content");

    # --- 0.33.2 review fix: a newline-leading first message derives NO title (stays untitled, never a blank "")
    # so it round-trips as untitled instead of re-deriving from a different surviving message ---
    session_reset();
    session_history_append("user", "\nfix the bug", 12);   # empty first line
    assert_eq(conv_title(0), 0, "empty first line -> conversation stays untitled (no blank title)");
    session_history_append("user", "second line here", 16);  # a later user message DOES title it
    assert(streq(conv_title(0), "second line here") == 1, "a later non-empty user message auto-titles");
    assert_eq(_sess_write_file("/tmp/thoth_sess_v2b"), 0, "v2b write ok");
    session_reset();
    _sess_load_file("/tmp/thoth_sess_v2b");
    assert(streq(conv_title(0), "second line here") == 1, "v2 round-trip: title exact after reload (not re-derived)");

    # --- 0.33.3: per-message model attribution — captured, stable across a switch, persisted ---
    session_reset();
    session_set_model_copy("claude-opus-4-8");
    session_history_append("user", "hi", 2);              # user -> no model tag
    session_history_append("assistant", "hey", 3);        # assistant -> tagged with the active model
    assert_eq(session_history_model(0), 0, "0.33.3: user message carries no model");
    assert(streq(session_history_model(1), "claude-opus-4-8") == 1, "0.33.3: assistant tagged with the session model");
    session_set_model_copy("claude-sonnet-5");            # a mid-session switch (overwrites the shared _model_buf)
    assert(streq(session_history_model(1), "claude-opus-4-8") == 1, "0.33.3: earlier reply's model UNCHANGED by a switch (stable copy, not an alias)");
    session_history_append("assistant", "yo", 2);         # tagged with the NEW model
    assert(streq(session_history_model(2), "claude-sonnet-5") == 1, "0.33.3: later reply tagged with the switched model");
    assert_eq(_sess_write_file("/tmp/thoth_sess_v3"), 0, "0.33.3: v3 write ok");
    session_reset();
    _sess_load_file("/tmp/thoth_sess_v3");
    assert_eq(session_history_model(0), 0, "0.33.3 round-trip: user still untagged");
    assert(streq(session_history_model(1), "claude-opus-4-8") == 1, "0.33.3 round-trip: msg1 model restored");
    assert(streq(session_history_model(2), "claude-sonnet-5") == 1, "0.33.3 round-trip: msg2 (switched) model restored");
    assert(streq(session_history_content(1), "hey") == 1, "0.33.3 round-trip: content intact alongside the model field");
    assert(streq(session_history_role(2), "assistant") == 1, "0.33.3 round-trip: role intact alongside the model field");

    # --- 0.33.4: per-message citations persist (alongside the model field, on the same reply) ---
    session_reset();
    session_set_model_copy("claude-opus-4-8");
    session_history_append("user", "q", 1);               # user -> no model, no citations
    session_history_append("assistant", "a", 1);          # assistant -> model-tagged + cited
    session_history_cite_last_add("Design Notes");
    session_history_cite_last_add("API Reference");
    assert_eq(session_history_citation_count(1), 2, "0.33.4: two citations on the reply");
    assert(streq(session_history_citation_title(1, 0), "Design Notes") == 1, "0.33.4: citation 0 title");
    assert(streq(session_history_citation_title(1, 1), "API Reference") == 1, "0.33.4: citation 1 title");
    assert_eq(session_history_citation_count(0), 0, "0.33.4: user message carries no citations");
    session_history_cite_last_clear();                    # the attach glue clears then re-adds -> must be idempotent
    assert_eq(session_history_citation_count(1), 0, "0.33.4: clear resets the citation set");
    session_history_cite_last_add("Design Notes");
    session_history_cite_last_add("API Reference");
    assert_eq(session_history_citation_count(1), 2, "0.33.4: re-add after clear restores both");
    assert_eq(_sess_write_file("/tmp/thoth_sess_v4"), 0, "0.33.4: v4 write ok");
    session_reset();
    _sess_load_file("/tmp/thoth_sess_v4");
    assert_eq(session_history_citation_count(1), 2, "0.33.4 round-trip: 2 citations restored");
    assert(streq(session_history_citation_title(1, 0), "Design Notes") == 1, "0.33.4 round-trip: citation 0 restored");
    assert(streq(session_history_citation_title(1, 1), "API Reference") == 1, "0.33.4 round-trip: citation 1 restored");
    assert_eq(session_history_citation_count(0), 0, "0.33.4 round-trip: user still uncited");
    assert(streq(session_history_model(1), "claude-opus-4-8") == 1, "0.33.4 round-trip: model field intact beside CITE frames");
    assert(streq(session_history_content(1), "a") == 1, "0.33.4 round-trip: content intact");

    # 0.33.4 hardening: an orphan CITE frame before any record must NOT spawn a spurious conversation (a corrupt file)
    var fdc = file_open("/tmp/thoth_sess_citefirst", O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    file_write(fdc, "THOTH-SESSION-2\t0\nCITE\t3\nfoo\nuser\t1\nx\n", 38);
    file_close(fdc);
    session_reset();
    _sess_load_file("/tmp/thoth_sess_citefirst");
    assert_eq(conv_count(), 1, "0.33.4: a leading orphan CITE does not spawn a spurious conversation");
    assert_eq(session_history_len(), 1, "0.33.4: the record after a leading CITE still loads");
    assert_eq(session_history_citation_count(0), 0, "0.33.4: the orphan CITE attached to nothing");

    # --- 0.33.5: per-message tool calls persist (alongside the model field AND citations, on the same reply) ---
    session_reset();
    session_set_model_copy("claude-opus-4-8");
    session_history_append("user", "q", 1);
    session_history_append("assistant", "a", 1);          # model-tagged + cited + tool calls
    session_history_cite_last_add("Design Notes");
    session_history_tool_last_add(1, 1, "read_file", "path=foo.txt");   # kind=allow, ok
    session_history_tool_last_add(0, 0, "shell", "rm -rf /");           # kind=deny, not ok
    assert_eq(session_history_tool_count(1), 2, "0.33.5: two tool calls on the reply");
    assert(streq(session_history_tool_name(1, 0), "read_file") == 1, "0.33.5: call 0 name");
    assert(streq(session_history_tool_args(1, 0), "path=foo.txt") == 1, "0.33.5: call 0 args");
    assert_eq(session_history_tool_kind(1, 0), 1, "0.33.5: call 0 kind=allow");
    assert_eq(session_history_tool_ok(1, 0), 1, "0.33.5: call 0 ok");
    assert_eq(session_history_tool_kind(1, 1), 0, "0.33.5: call 1 kind=deny");
    assert_eq(session_history_tool_count(0), 0, "0.33.5: user message has no tool calls");
    session_history_tool_last_clear();                    # idempotent clear + re-add (the attach glue clears first)
    assert_eq(session_history_tool_count(1), 0, "0.33.5: clear resets the tool set");
    session_history_tool_last_add(1, 1, "read_file", "path=foo.txt");
    session_history_tool_last_add(0, 0, "shell", "rm -rf /");
    assert_eq(_sess_write_file("/tmp/thoth_sess_v5"), 0, "0.33.5: v5 write ok");
    session_reset();
    _sess_load_file("/tmp/thoth_sess_v5");
    assert_eq(session_history_tool_count(1), 2, "0.33.5 round-trip: 2 tool calls restored");
    assert(streq(session_history_tool_name(1, 0), "read_file") == 1, "0.33.5 round-trip: call 0 name");
    assert(streq(session_history_tool_args(1, 0), "path=foo.txt") == 1, "0.33.5 round-trip: call 0 args");
    assert_eq(session_history_tool_kind(1, 0), 1, "0.33.5 round-trip: call 0 kind");
    assert_eq(session_history_tool_ok(1, 0), 1, "0.33.5 round-trip: call 0 ok");
    assert(streq(session_history_tool_name(1, 1), "shell") == 1, "0.33.5 round-trip: call 1 name");
    assert(streq(session_history_tool_args(1, 1), "rm -rf /") == 1, "0.33.5 round-trip: call 1 args (spaces preserved)");
    assert_eq(session_history_tool_kind(1, 1), 0, "0.33.5 round-trip: call 1 kind=deny");
    assert_eq(session_history_tool_ok(1, 1), 0, "0.33.5 round-trip: call 1 ok=0");
    assert(streq(session_history_model(1), "claude-opus-4-8") == 1, "0.33.5 round-trip: model field intact beside CITE+TOOL frames");
    assert_eq(session_history_citation_count(1), 1, "0.33.5 round-trip: citation intact beside TOOL frames");

    _sess_path = 0;                # deactivate so later tests' assistant-appends don't write a file
    session_reset();              # leave a clean single-conversation store for subsequent tests
    session_history_clear();
    return 0;
}

fn test_ui_niceties() {
    test_group("turn niceties ([ui] bell/elapsed, 0.24.3)");
    # --- _task_emit_secs: milliseconds -> "N.Ns" (one decimal), clamped at 0 ---
    assert_eq(_t_secs_line(3200, "3.2s"), 1, "3200ms -> 3.2s");
    assert_eq(_t_secs_line(800, "0.8s"), 1, "800ms -> 0.8s");
    assert_eq(_t_secs_line(0, "0.0s"), 1, "0ms -> 0.0s");
    assert_eq(_t_secs_line(0 - 5, "0.0s"), 1, "negative -> 0.0s (clamped)");
    assert_eq(_t_secs_line(65900, "65.9s"), 1, "65900ms -> 65.9s");

    # --- _task_turn_feedback: interactive-only, and only when [ui].elapsed is on ---
    _cfg_ui_bell = 0; _cfg_ui_elapsed = 1;
    one_shot_set(1);                              # one-shot -> suppressed (clean output)
    feed_init(); out_mode_set(OUT_RING); _task_turn_feedback(clock_now_ms()); feed_flush_pending(); out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 0, "one-shot: no turn feedback emitted");
    one_shot_set(0);                             # interactive -> the elapsed line prints
    feed_init(); out_mode_set(OUT_RING); _task_turn_feedback(clock_now_ms()); feed_flush_pending(); out_mode_set(OUT_FD1);
    assert(feed_count() >= 1, "interactive + [ui].elapsed: an elapsed line is emitted");
    assert_eq(_t_count_sub(feed_line_ptr(0), feed_line_len(0), "s)", 2), 1, "the elapsed line is a (…s) form");

    # both off -> nothing, even interactive (byte-identical floor)
    _cfg_ui_bell = 0; _cfg_ui_elapsed = 0;
    feed_init(); out_mode_set(OUT_RING); _task_turn_feedback(clock_now_ms()); feed_flush_pending(); out_mode_set(OUT_FD1);
    assert_eq(feed_count(), 0, "both off: no feedback (floor unchanged)");
    return 0;
}

fn test_reload() {
    test_group("/reload config (agent tool-cache reset, 0.24.4)");
    # agent_tools_cache_reset drops the session-stable tool cache so the next turn re-advertises — the
    # mechanism /reload relies on to pick up a changed [shell].enabled / [hoosh].tools. (cmd_reload itself
    # re-reads thoth.cyml, which is gitignored/absent in CI, so it is live-verified, not unit-tested here.)
    _agent_tools_ready = 1; _agent_tools_len = 42;
    agent_tools_cache_reset();
    assert_eq(_agent_tools_ready, 0, "reset clears the tool-ready flag (re-advertise next turn)");
    assert_eq(_agent_tools_len, 0, "reset clears the cached tool length");
    # config_load re-run must be safe (the reload re-parses in place). It degrades gracefully on an
    # absent/unreadable file (keeps prior state); reaching the next assertion proves it did not crash.
    config_load();
    assert_eq(_agent_tools_ready, 0, "config_load re-run did not spuriously rebuild the tool cache");
    return 0;
}

fn test_role() {
    test_group("role modality (persona aspects + /role, 0.24.5)");
    persona_set(egyptian_thoth());              # pristine default (persona_set resets aspect+override)
    assert(streq(persona_role(), "the Librarian") == 1, "default Thoth role = the Librarian");
    # select an aspect -> the role follows (avatara-sourced, not thoth-authored)
    var mi = aspect_index_by_name("measurer");
    assert(mi >= 0, "measurer aspect exists in avatara");
    persona_role_select_aspect(mi);
    assert(streq(persona_role(), "the Measurer") == 1, "select measurer -> role 'the Measurer'");
    assert_eq(persona_role_is_override(), 0, "an aspect selection is not a custom override");
    assert_eq(persona_aspect(), mi, "active aspect = measurer");
    # a custom user label trumps the aspect (make anyone anything)
    persona_role_override_set("Keeper of Symbols");
    assert(streq(persona_role(), "Keeper of Symbols") == 1, "custom override role wins");
    assert_eq(persona_role_is_override(), 1, "override flag set");
    assert(_ui_contains(persona_system_prompt(), "Keeper of Symbols") == 1, "system prompt carries the active role (steers the model)");
    # reset -> back to the archetype default
    persona_role_reset();
    assert(streq(persona_role(), "the Librarian") == 1, "reset -> default role");
    assert_eq(persona_role_is_override(), 0, "reset clears the override");
    # a persona switch resets the role state to the new archetype's dominant aspect
    persona_role_override_set("Temp");
    persona_set(egyptian_thoth());
    assert_eq(persona_role_is_override(), 0, "persona switch clears a custom override");
    assert_eq(persona_aspect(), profile_dominant_aspect(persona_profile()), "switch -> dominant aspect is the active default");
    # a NON-Thoth archetype's default role derives from its dominant aspect (0.24.5 change; was desc)
    var od = find_and_validate("Odin");
    if (is_err_result(od) == 0) {
        persona_set(result_unwrap(od));
        assert(streq(persona_role(), aspect_role(profile_dominant_aspect(persona_profile()))) == 1, "switched persona default role = its dominant aspect");
    }
    # out-of-range aspect select is a safe no-op
    persona_set(egyptian_thoth());
    assert_eq(persona_role_select_aspect(999), 0, "OOB aspect select refused");
    assert_eq(persona_role_select_aspect(0 - 1), 0, "negative aspect select refused");
    persona_role_reset();                       # leave a clean default for later tests
    return 0;
}


# Project-memory injection (0.12.0, ADR-0012). The mem system message rides the
# same builders as the persona — a second {role:system} block AFTER the persona,
# BEFORE the user turn/history. mem == 0 (disabled/absent) -> byte-identical floor.
fn test_memory() {
    test_group("project memory injection (0.12.0)");
    assert_eq(classify_input("/remember a durable fact"), CMD_REMEMBER, "/remember classifies to CMD_REMEMBER");
    assert_eq(classify_input("/notes auth flow"), CMD_NOTES, "/notes classifies to CMD_NOTES (0.32.6)");
    session_reset();
    var dst[4096];

    # persona + memory + user, in order (both system messages present).
    var l1 = hoosh_build_dry(&dst, "m", "SYS", "MEM", "hi", 0);
    store8(&dst + l1, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"SYS\"},{\"role\":\"system\",\"content\":\"MEM\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "memory: persona + memory + user, in order");

    # mem == 0 -> NO memory message (byte-identical floor).
    var l2 = hoosh_build_dry(&dst, "m", "SYS", 0, "hi", 0);
    store8(&dst + l2, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"SYS\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "memory off: byte-identical (no memory message)");

    # single-turn builder threads mem the same way (persona 0, memory present).
    var l3 = hoosh_build_request(&dst, "m", 0, "MEM", "hi", 0);
    store8(&dst + l3, 0);
    assert(streq(&dst, "{\"model\":\"m\",\"messages\":[{\"role\":\"system\",\"content\":\"MEM\"},{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "single-turn: memory system message");

    # reader is OFF by default -> content-blind gate returns 0, no I/O, no faked line.
    assert_eq(config_memory_enabled(), 0, "memory off by default");
    assert_eq(memory_context(0), 0, "memory_context(0) 0 when disabled");
    assert_eq(memory_system_prompt(), 0, "memory_system_prompt() 0 when disabled");
    assert_eq(memory_fact_count(), 0, "memory_fact_count() 0 when disabled");

    # 0.12.2: memory_write agentic tool — advertised only when the seam is active.
    var tb[8192];
    var pre = "[{\"x\":1}]";
    var pl = strlen(pre);
    memcpy(&tb, pre, pl); store8(&tb + pl, 0);
    assert_eq(agent_tools_add_memory(&tb, pl), pl, "memory_write NOT advertised when memory disabled");
    _cfg_memory_enabled = 1;
    memcpy(&tb, pre, pl); store8(&tb + pl, 0);
    var a2 = agent_tools_add_memory(&tb, pl);
    store8(&tb + a2, 0);
    assert(strstr(&tb, "\"x\":1},{\"type\":\"function\"") != 0, "memory_write spliced after comma into non-empty array");
    assert_eq(load8(&tb + a2 - 1), 93, "tools array still closes with ']'");
    var a3 = agent_tools_add_memory(&tb, 0);
    store8(&tb + a3, 0);
    assert_eq(load8(&tb), 91, "empty-registry tools array opens with '['");
    assert(strstr(&tb, "memory_write") != 0, "memory_write advertised (empty registry)");
    _cfg_memory_enabled = 0;
    # memory_write_tool argument validation (no I/O on the error paths).
    assert_eq(cstr_starts_with(memory_write_tool(0), "memory_write:"), 1, "memory_write_tool null args -> error");
    assert_eq(cstr_starts_with(memory_write_tool("{}"), "memory_write:"), 1, "memory_write_tool missing text -> error");

    session_reset();
    return 0;
}

# test_mem_seam (0.32.0): the mneme memory-seam probe — the PURE parts (name match,
# registry scan + cache, title derivation). The actual mneme_create_note marshalling
# is network I/O (daimon_invoke) and is exercised live, not here.
fn test_mem_seam() {
    test_group("mneme memory seam (0.32.0)");
    # tool-name prefix match
    assert_eq(_daimon_name_is_mneme(str_from("mneme_search")), 1, "mneme_search matches");
    assert_eq(_daimon_name_is_mneme(str_from("mneme_create_note")), 1, "mneme_create_note matches");
    assert_eq(_daimon_name_is_mneme(str_from("web_search")), 0, "web_search does not match");
    assert_eq(_daimon_name_is_mneme(str_from("mneme")), 0, "bare 'mneme' (no underscore) does not match");
    assert_eq(_daimon_name_is_mneme(str_from("mnem")), 0, "short name does not match");

    # scan a parsed registry "tools" array -> verdict + cache read
    _daimon_mem_probed = 0 - 1;
    var s1 = "[{\"name\":\"web_fetch\"},{\"name\":\"mneme_search\"}]";
    var t1 = bayan_json_v_parse_buf(s1, strlen(s1));
    assert_eq(daimon_mem_scan(t1), 1, "scan finds mneme_* -> bound");
    assert_eq(daimon_mem_bound(), 1, "cache reads bound after scan");
    var s2 = "[{\"name\":\"web_fetch\"},{\"name\":\"web_search\"}]";
    var t2 = bayan_json_v_parse_buf(s2, strlen(s2));
    assert_eq(daimon_mem_scan(t2), 0, "scan without mneme_* -> unbound");
    assert_eq(daimon_mem_bound(), 0, "cache reads unbound after scan");
    assert_eq(daimon_mem_scan(0), 0, "scan of null array -> unbound (no crash)");

    # title derivation for mneme_create_note: first line, verbatim
    assert(streq(_mem_derive_title("hello world"), "hello world"), "title = full short fact");
    assert(streq(_mem_derive_title("line one\nline two"), "line one"), "title stops at the first newline");

    # recall gating (0.32.2): memory_context(query) is the injectable memory message. [memory].enabled is the
    # master switch; a query with the seam UNBOUND takes the local reader (0 here — no .thoth/memory in the test
    # cwd). daimon is unconfigured in the harness, so daimon_mem_probe() is a no-op (no network) and bound stays 0.
    _daimon_mem_probed = 0 - 1;
    assert_eq(config_memory_enabled(), 0, "memory off by default (guard)");
    assert_eq(memory_context("find the auth handler"), 0, "recall: disabled -> 0 regardless of query");
    _cfg_memory_enabled = 1;
    assert_eq(memory_context("find the auth handler"), 0, "recall: enabled + unbound + no local mem -> 0 (local fallback)");
    assert_eq(memory_context(0), 0, "recall: query=0 -> local path (network-free), 0 with no local mem");
    _cfg_memory_enabled = 0;

    # citations (0.32.3): the defensive parse of mneme's numbered result -> (title, path) per hit.
    var csample = "search_id: s:1\n\nFound 2 result(s):\n\n1. **Frobnicator** (ID: abc, score: 0)\n   Path: frobnicator.md\n   the code is ZEBRA\n\n2. **Auth Flow** (ID: def, score: 0)\n   Path: docs/auth.md\n   login steps\n";
    assert_eq(citations_capture(csample), 2, "citations: 2 sources from a 2-hit result");
    assert_eq(streq(citations_title(0), "Frobnicator"), 1, "citations[0] title");
    assert_eq(streq(citations_path(0), "frobnicator.md"), 1, "citations[0] path");
    assert_eq(streq(citations_title(1), "Auth Flow"), 1, "citations[1] title");
    assert_eq(streq(citations_path(1), "docs/auth.md"), 1, "citations[1] path");
    assert_eq(citations_title(2), 0, "citations: out-of-range -> 0");
    # 0.34.4: the same parse also captures the search_id + the FIRST hit's note id, for /thumbs -> mneme_search_feedback
    citations_capture(csample);
    assert_eq(streq(citations_search_id(), "s:1"), 1, "citations: search_id captured from the header");
    assert_eq(streq(citations_feedback_note_id(), "abc"), 1, "citations: first hit's note id captured for feedback");
    # defensive: an unparseable result (no **) captures nothing, no crash, and no stale feedback target
    assert_eq(citations_capture("No notes found matching your query."), 0, "citations: no ** -> 0 sources");
    # 0.39.0 (audit A-5): exhausting the citations arena must DEGRADE, not overflow. The old _cite_copy
    # clamped `avail` to 0 but still wrote the NUL at `dst + len` and still advanced `_cite_off`, so once
    # the arena filled exactly it wrote one byte past the end — and kept creeping one byte further on every
    # subsequent call, scribbling NULs through whatever the bump heap had handed out next. Drive it well
    # past the cap and pin the two invariants that make the write safe: _cite_off never exceeds the cap,
    # and an exhausted arena returns a usable empty string rather than a pointer into someone else's memory.
    citations_reset();
    var cfill = 0;
    var cbad = 0;                               # accumulate, then assert ONCE — a per-iteration assert would
    var cnull = 0;                              # inflate the suite count by 400 for a single invariant
    while (cfill < 200) {                       # 200 x ~64 B >> CITE_BUF_CAP (2048): guaranteed exhaustion
        var cp = _cite_copy("0123456789012345678901234567890123456789012345678901234567890123", 64);
        if (cp == 0) { cnull = cnull + 1; }
        if (_cite_off > CITE_BUF_CAP) { cbad = cbad + 1; }
        cfill = cfill + 1;
    }
    assert_eq(cnull, 0, "citations: a copy never returns a null pointer, even when exhausted");
    assert_eq(cbad, 0, "citations: _cite_off never passes the arena cap across 200 copies (the overflow)");
    assert_eq(_cite_off, CITE_BUF_CAP, "citations: arena settles exactly AT the cap, never beyond");
    assert_eq(load8(_cite_copy("x", 1)), 0, "citations: an exhausted arena yields an empty cstr, not a wild write");
    citations_reset();
    assert_eq(_cite_off, 0, "citations: reset reclaims the arena");
    assert_eq(citations_search_id(), 0, "citations: no result -> no stale search_id");
    assert_eq(citations_feedback_note_id(), 0, "citations: no result -> no stale note id");
    citations_reset();
    assert_eq(citations_count(), 0, "citations_reset clears");
    assert_eq(citations_search_id(), 0, "citations_reset clears the feedback search_id");

    # grounding (0.32.4): scan the reply for [N] refs vs the recalled source count.
    var gr_ok = "Per [1], the frobnicator code is ZEBRA.";
    assert_eq(grounding_verdict(gr_ok, strlen(gr_ok), 2), GROUND_OK, "grounding: a valid [1] cited -> OK");
    var gr_both = "See [1] and also [2] for details.";
    assert_eq(grounding_verdict(gr_both, strlen(gr_both), 2), GROUND_OK, "grounding: [1]+[2] cited -> OK");
    var gr_none = "The code is ZEBRA, no attribution.";
    assert_eq(grounding_verdict(gr_none, strlen(gr_none), 2), GROUND_UNVERIFIED, "grounding: recalled but none cited -> UNVERIFIED");
    var gr_bad = "As shown in source [3] above.";
    assert_eq(grounding_verdict(gr_bad, strlen(gr_bad), 2), GROUND_BAD, "grounding: [3] beyond 2 recalled -> BAD (likely fabricated)");
    var gr_code = "The value is arr[15] in the buffer.";
    assert_eq(grounding_verdict(gr_code, strlen(gr_code), 2), GROUND_UNVERIFIED, "grounding: large [15] ignored (code, not a citation)");
    assert_eq(grounding_verdict(gr_ok, strlen(gr_ok), 0), GROUND_NONE, "grounding: 0 sources recalled -> NONE");

    # memlog (0.32.5): the per-turn record the GUI feed reads (recorded from the live citations + a verdict).
    memlog_reset();
    citations_capture(csample);              # 2 sources: "Frobnicator", "Auth Flow"
    memlog_record(7, GROUND_OK);
    var mslot = memlog_find(7);
    assert(mslot != 0, "memlog_find locates the recorded turn");
    assert_eq(memlog_verdict(mslot), GROUND_OK, "memlog verdict = OK");
    assert_eq(memlog_nsources(mslot), 2, "memlog captured 2 sources");
    assert_eq(streq(memlog_title(mslot, 0), "Frobnicator"), 1, "memlog title[0] = Frobnicator");
    assert_eq(streq(memlog_title(mslot, 1), "Auth Flow"), 1, "memlog title[1] = Auth Flow");
    assert_eq(memlog_find(99), 0, "memlog_find miss -> 0");
    memlog_record(0, GROUND_OK);             # untagged turn (<=0) -> not recorded
    assert_eq(memlog_find(0), 0, "memlog: untagged turn not recorded");
    citations_reset();
    memlog_record(8, GROUND_OK);             # nothing recalled -> not recorded
    assert_eq(memlog_find(8), 0, "memlog: no recall -> not recorded");
    memlog_reset();
    assert_eq(memlog_find(7), 0, "memlog_reset clears");

    # reasonlog (0.35.3): the per-turn reasoning record the GUI feed reads so a LANDED thinking fold survives.
    reasonlog_reset();
    reasonlog_record(7, "step one then two", 17);
    var rslot = reasonlog_find(7);
    assert(rslot != 0, "reasonlog_find locates the recorded turn");
    assert_eq(reasonlog_len(rslot), 17, "reasonlog len = 17");
    assert_eq(streq(reasonlog_text(rslot), "step one then two"), 1, "reasonlog text round-trips (NUL-terminated)");
    assert_eq(reasonlog_find(99), 0, "reasonlog_find miss -> 0");
    reasonlog_record(0, "x", 1);             # untagged turn (<=0) -> not recorded
    assert_eq(reasonlog_find(0), 0, "reasonlog: untagged turn not recorded");
    reasonlog_record(8, "x", 0);             # no reasoning (len<=0) -> not recorded (the Opus 4.8 case)
    assert_eq(reasonlog_find(8), 0, "reasonlog: no reasoning -> not recorded");
    reasonlog_record(9, 0, 5);               # null text -> not recorded
    assert_eq(reasonlog_find(9), 0, "reasonlog: null text -> not recorded");
    # newest-wins: re-recording a turn returns the latest text
    reasonlog_record(5, "old", 3);
    reasonlog_record(5, "newer", 5);
    var r5 = reasonlog_find(5);
    assert_eq(reasonlog_len(r5), 5, "reasonlog newest-wins: latest len");
    assert_eq(streq(reasonlog_text(r5), "newer"), 1, "reasonlog newest-wins: latest text");
    # aging out: only the last REASONLOG_CAP turns stay in the ring window; older turns read as 0
    reasonlog_reset();
    var cap1 = REASONLOG_CAP + 1;
    var ti = 1;
    while (ti <= cap1) { reasonlog_record(ti, "r", 1); ti = ti + 1; }
    assert_eq(reasonlog_find(1), 0, "reasonlog: oldest turn aged out of the ring");
    assert(reasonlog_find(2) != 0, "reasonlog: turn within the ring window kept");
    assert(reasonlog_find(cap1) != 0, "reasonlog: newest turn kept");
    reasonlog_reset();
    assert_eq(reasonlog_find(7), 0, "reasonlog_reset clears");

    _daimon_mem_probed = 0 - 1;   # reset the cache — later tests assume unprobed
    return 0;
}

# destructive history cap (session.cyr, 0.36.4): SESS_HIST_MAX permanently FREES the oldest message (gone from the
# feed, /save, everything) — distinct from the framer's byte-budget skip (hoosh_ctx_evicted), which holds them all.
# It used to do this silently + unmetered; conv_dropped now counts the real losses so /state can be honest.
fn test_history_dropped() {
    test_group("destructive history cap is metered (session.cyr, 0.36.4)");
    session_reset(); session_history_clear();
    assert_eq(session_history_dropped(), 0, "a fresh conversation has dropped nothing");
    var i = 0;
    while (i < SESS_HIST_MAX) { session_history_append("user", "m", 1); i = i + 1; }
    assert_eq(session_history_len(), SESS_HIST_MAX, "history fills to the cap");
    assert_eq(session_history_dropped(), 0, "at the cap exactly, nothing has been dropped yet");
    session_history_append("user", "over", 4);                 # the 41st message evicts the oldest, for good
    assert_eq(session_history_len(), SESS_HIST_MAX, "length stays pinned at the cap");
    assert_eq(session_history_dropped(), 1, "the destructive drop is COUNTED (was silent + unmetered)");
    session_history_append("user", "over2", 5);
    assert_eq(session_history_dropped(), 2, "each further append drops (and counts) one more");
    # the byte-budget skip is a DIFFERENT thing and loses nothing — it must not be conflated with a real drop
    session_reset(); session_history_clear();
    session_history_append("user", "small", 5);
    assert_eq(session_history_dropped(), 0, "a byte-budget skip is not a drop");
    session_reset(); session_history_clear();
    return 0;
}

# summarize-on-overflow plumbing (0.36.4): the recap cache + its injection into the framed request. The SIDE-CALL
# itself needs a live gateway (verified separately); these cover everything around it — most importantly that the
# request is byte-identical when no recap applies, and that a recap only rides when it covers EXACTLY the skip.
fn test_recap() {
    test_group("summarize-on-overflow plumbing (0.36.4)");
    session_reset(); session_history_clear();
    assert_eq(session_recap(), 0, "a fresh conversation has no recap");
    assert_eq(session_recap_covers(), 0, "and covers nothing");
    # the recap only rides when it covers EXACTLY the messages the framer skips
    session_set_recap("earlier: agreed on X", 3);
    assert_eq(session_recap_covers(), 3, "recap remembers its coverage");
    assert_eq(_hoosh_has_recap(3), 1, "a recap covering exactly the skip is used");
    assert_eq(_hoosh_has_recap(4), 0, "coverage mismatch -> NOT used (never a stale/partial recap)");
    assert_eq(_hoosh_has_recap(0), 0, "nothing skipped -> no recap");
    # a rewind un-says messages the recap may describe -> it must be dropped
    session_history_append("user", "q", 1);
    session_set_recap("stale", 1);
    session_rewind_to_last_user();
    assert_eq(session_recap(), 0, "a rewind clears the recap (it described un-said messages)");
    # clearing history clears it too
    session_set_recap("stale2", 1);
    session_history_clear();
    assert_eq(session_recap(), 0, "clearing history clears the recap");
    # OFF by default: the framer is byte-identical to pre-0.36.4 when no recap applies
    session_reset(); session_history_clear();
    assert_eq(config_hoosh_summarize(), 0, "[hoosh].summarize defaults OFF (never spends tokens uninvited)");
    session_history_append("user", "hi", 2);
    var rb[1024];
    hoosh_build_messages(&rb, "m", 0, 0, 0);
    assert(streq(&rb, "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":4096,\"stream\":false}"), "no recap -> request byte-identical to pre-0.36.4");
    # ensure() is a no-op when disabled (must not call out, must not cache)
    hoosh_recap_ensure(HOOSH_REQ_CAP);
    assert_eq(session_recap(), 0, "recap_ensure is a no-op while [hoosh].summarize is off");
    session_reset(); session_history_clear();
    return 0;
}

# recap vs the destructive cap (0.36.4, live-caught): the cap drops from the FRONT, shifting every index down — so
# the recap's index-based coverage must shrink with it, else it claims to cover messages it never summarized.
fn test_recap_drop_shift() {
    test_group("recap coverage shrinks with destructive drops (0.36.4)");
    session_reset(); session_history_clear();
    var i = 0;
    while (i < SESS_HIST_MAX) { session_history_append("user", "m", 1); i = i + 1; }
    session_set_recap("covers the four oldest", 4);
    assert_eq(session_recap_covers(), 4, "recap covers the 4 oldest");
    session_history_append("user", "over", 4);          # drops 1 from the front -> every index shifts down by 1
    assert_eq(session_history_dropped(), 1, "one message was destroyed");
    assert_eq(session_recap_covers(), 3, "coverage shrank with the shift (still a SUPERSET of the skipped range)");
    session_history_append("user", "over2", 5);
    assert_eq(session_recap_covers(), 2, "and again");
    assert(session_recap() != 0, "the recap TEXT survives — it still describes what the cap destroyed");
    session_reset(); session_history_clear();
    return 0;
}

# /save export formats (0.36.5): --json / --plain are TIER-NEUTRAL (the conversation, not the rendered scrollback),
# so a machine/bare export does not depend on whether you were in the TUI. Markdown stays the untouched default.
fn test_save_formats() {
    test_group("/save export formats (0.36.5)");
    # the flag parser peels the format off and leaves the path
    assert_eq(_save_parse_fmt("out.md"), SAVE_FMT_MD, "no flag -> markdown (the unchanged default)");
    assert(streq(_save_fmt_path, "out.md"), "path preserved when unflagged");
    assert_eq(_save_parse_fmt("--json out.json"), SAVE_FMT_JSON, "--json -> JSON");
    assert(streq(_save_fmt_path, "out.json"), "--json peeled off, path left");
    assert_eq(_save_parse_fmt("--plain out.txt"), SAVE_FMT_PLAIN, "--plain -> plain");
    assert(streq(_save_fmt_path, "out.txt"), "--plain peeled off, path left");
    # round-trip a small conversation through each writer
    session_reset(); session_history_clear();
    session_history_append("user", "hi \"there\"", 10);      # a quote: JSON must escape it
    session_history_append("assistant", "line1\nline2", 11); # a newline: JSON must escape it
    feed_init();
    xunlink("/tmp/thoth_t_save.json");
    cmd_save("/save --json /tmp/thoth_t_save.json");
    var jbuf[4096];
    var jn = _save_read("/tmp/thoth_t_save.json", &jbuf, 4095);
    var jb = &jbuf;
    assert(jn > 0, "json export wrote a file");
    assert(_ui_contains(jb, "\"messages\"") == 1, "json has a messages array");
    assert(_ui_contains(jb, "\\\"there\\\"") == 1, "json ESCAPES an embedded quote");
    assert(_ui_contains(jb, "line1\\nline2") == 1, "json ESCAPES an embedded newline");
    assert_eq(_ui_contains(jb, "# thoth transcript"), 0, "json carries no markdown scaffolding");
    xunlink("/tmp/thoth_t_save.txt");
    cmd_save("/save --plain /tmp/thoth_t_save.txt");
    var pbuf[4096];
    var pn = _save_read("/tmp/thoth_t_save.txt", &pbuf, 4095);
    var pb = &pbuf;
    assert(pn > 0, "plain export wrote a file");
    assert(_ui_contains(pb, "user: hi") == 1, "plain is bare 'role: content'");
    assert_eq(_ui_contains(pb, "# thoth transcript"), 0, "plain carries no markdown header");
    assert_eq(_ui_contains(pb, "## user"), 0, "plain carries no markdown role headers");
    # markdown default still produces the transcript it always did
    xunlink("/tmp/thoth_t_save.md");
    cmd_save("/save /tmp/thoth_t_save.md");
    var mbuf[4096];
    var mn = _save_read("/tmp/thoth_t_save.md", &mbuf, 4095);
    var mb = &mbuf;
    assert(mn > 0, "markdown export wrote a file");
    assert(_ui_contains(mb, "# thoth transcript") == 1, "markdown default unchanged");
    session_reset(); session_history_clear();
    return 0;
}

# shell buffer re-sizing (shell.cyr, 0.37.0): the capture/result buffers were alloc'd ONCE from
# config_shell_output_cap(), but /reload re-parses [shell].max_output — RAISING it then re-running a command wrote
# up to the new (larger) cap into the old (smaller) block (file_read_all fills to buflen): a heap overflow on a
# natural operator action. _shell_bufs_ensure re-allocs when the cap changes. This is the review-caught bug's guard.
fn test_shell_bufs_realloc() {
    test_group("shell buffers re-size when the cap grows (shell.cyr, 0.37.0)");
    _cfg_shell_output_cap = 2048;                       # size at a small cap
    var c1 = _shell_bufs_ensure();
    assert_eq(c1, 2048, "buffers sized to the small cap");
    assert_eq(_shell_buf_cap, 2048, "tracked cap = 2048");
    var b1 = _shell_cap_buf;
    assert(b1 != 0, "capture buffer allocated");
    _cfg_shell_output_cap = 1048576;                    # a /reload raises max_output to the 1 MiB ceiling
    var c2 = _shell_bufs_ensure();
    assert_eq(c2, 1048576, "buffers re-sized to the raised cap (the overflow fix)");
    assert_eq(_shell_buf_cap, 1048576, "tracked cap grew with the config");
    assert(_shell_cap_buf != b1, "the capture buffer was RE-allocated (a fresh, larger block — no overflow)");
    var b3 = _shell_cap_buf;
    _shell_bufs_ensure();                               # same cap again -> stable, no churn
    assert(_shell_cap_buf == b3, "unchanged cap -> no re-alloc (buffers stable)");
    _cfg_shell_output_cap = 0 - 1;                      # restore the unset/default for later tests
    _shell_bufs_ensure();
    return 0;
}

# --- CONFIG LAYERING (0.43.3): ~/.thoth/config.cyml as the base, local on top ----------------------
#
# The scalars are the easy half and the collections are the half that can go quietly wrong, so both are
# pinned here. The security rule under test is STRICTEST WINS: a deny-list UNIONS across layers (a
# project may add denies and can never drop the user's), while `[shell].allow` and `[project].read_roots`
# GRANT authority and are therefore REPLACED wholesale by the local layer rather than merged — a repo you
# cloned must not be able to widen your global allow-list or read jail by appending one entry.
fn _lay_parse(txt) { return bayan_toml_parse(str_new(txt, strlen(txt))); }
fn _lay_deny_has(pat) {
    var i = 0;
    while (i < config_shell_deny_count()) { if (streq(config_shell_deny_at(i), pat) == 1) { return 1; } i = i + 1; }
    return 0;
}
fn _lay_allow_has(pat) {
    var i = 0;
    while (i < config_shell_allow_count()) { if (streq(config_shell_allow_at(i), pat) == 1) { return 1; } i = i + 1; }
    return 0;
}

fn test_config_layering() {
    test_group("config layering: local over global (config.cyr, 0.43.3)");

    # --- the presence-not-value rule the whole design rests on ---
    var g1 = _lay_parse("[hoosh]\nurl = \"G-URL\"\nmodel = \"G-MODEL\"\nstream = false\nmax_iters = 9\n");
    var l1 = _lay_parse("[hoosh]\nmodel = \"L-MODEL\"\nstream = true\n");
    var hg = _cfg_section_pairs(g1, "hoosh");
    var hl = _cfg_section_pairs(l1, "hoosh");
    assert(streq(_cfg2_str(hl, hg, "url"), "G-URL") == 1, "a key only the GLOBAL sets is inherited");
    assert(streq(_cfg2_str(hl, hg, "model"), "L-MODEL") == 1, "a key BOTH set resolves to the local one");
    assert_eq(_cfg2_str(hl, hg, "token"), 0, "a key NEITHER sets stays absent");
    # ⚠ the bug this prevents: _cfg_bool returns the DEFAULT for an absent key, so layering on its
    # return would make a local `stream = true` indistinguishable from no local `stream` at all.
    assert_eq(_cfg2_bool(hl, hg, "stream", 1), 1, "an explicit local bool WINS over the global's");
    assert_eq(_cfg2_bool(0, hg, "stream", 1), 0, "...and with no local layer the global's bool applies");
    assert_eq(_cfg2_bool(hl, hg, "history", 1), 1, "a bool neither layer sets falls to the default");
    assert_eq(_cfg2_int(hl, hg, "max_iters"), 9, "an int only the global sets is inherited");
    assert_eq(_cfg2_int(hl, hg, "compact_at"), 0 - 1, "an int neither sets stays -1 (absent)");
    assert_eq(_cfg2_str(0, 0, "url"), 0, "two absent layers answer absent, not a crash");

    # --- [shell] deny UNIONS · allow does NOT ---
    var gs = _lay_parse("[shell]\ndeny = [\"rm *\", \"shared *\"]\nallow = [\"ls *\", \"cat *\"]\n");
    var ls = _lay_parse("[shell]\ndeny = [\"curl *\", \"shared *\"]\n");
    _shell_globs_load2(_cfg_section_pairs(ls, "shell"), ls, _cfg_section_pairs(gs, "shell"), gs);
    assert_eq(config_shell_deny_count(), 3, "deny UNIONS both layers, de-duplicated (curl, shared, rm)");
    assert_eq(_lay_deny_has("curl *"), 1, "...the local deny is kept");
    assert_eq(_lay_deny_has("rm *"), 1, "...the GLOBAL deny survives a local [shell] block");
    assert_eq(_lay_deny_has("shared *"), 1, "...a deny in both appears once");
    # the local layer declared NO allow -> it inherits the global's rather than being empty
    assert_eq(config_shell_allow_count(), 2, "allow is INHERITED when the local layer does not declare one");

    # a local layer that DOES declare allow replaces the global's wholesale — never a union
    var ls2 = _lay_parse("[shell]\nallow = [\"git *\"]\n");
    _shell_globs_load2(_cfg_section_pairs(ls2, "shell"), ls2, _cfg_section_pairs(gs, "shell"), gs);
    assert_eq(config_shell_allow_count(), 1, "a local allow REPLACES the global's — authority never accumulates");
    assert_eq(_lay_allow_has("git *"), 1, "...with the local pattern");
    assert_eq(_lay_allow_has("ls *"), 0, "...and the global's is NOT merged in");
    # an EXPLICITLY EMPTY local allow must stay empty, not fall through to the global
    var ls3 = _lay_parse("[shell]\nallow = []\n");
    _shell_globs_load2(_cfg_section_pairs(ls3, "shell"), ls3, _cfg_section_pairs(gs, "shell"), gs);
    assert_eq(config_shell_allow_count(), 0, "an explicitly EMPTY local allow stays empty (declared != absent)");

    # --- [alias] and [pricing.*] merge by key, local winning ---
    var ga = _lay_parse("[alias]\ng = \"from-global\"\nonlyglobal = \"kept\"\n");
    var la = _lay_parse("[alias]\ng = \"from-local\"\n");
    _alias_load2(la, ga);
    assert_eq(config_alias_count(), 2, "aliases MERGE across layers");
    assert(streq(config_alias_lookup("g"), "from-local") == 1, "a name in both resolves to the local one");
    assert(streq(config_alias_lookup("onlyglobal"), "kept") == 1, "a global-only alias still resolves");

    var gp = _lay_parse("[pricing.m1]\ninput = 10\noutput = 20\n[pricing.m2]\ninput = 30\noutput = 40\n");
    var lp = _lay_parse("[pricing.m1]\ninput = 1\noutput = 2\n");
    _price_load2(lp, gp);
    assert_eq(config_price_input("m1"), 1, "a local [pricing.<model>] overrides the global rate");
    assert_eq(config_price_input("m2"), 30, "...while a global-only model keeps its rate");

    # --- UNKNOWN KEYS ARE NAMED, NOT SWALLOWED (0.43.5) ---
    # ⚠ The parser drops what it does not recognise, and that silence cost real time twice: a
    # `tier = "simple"` that did nothing before 0.43.2 made the key live, and `max-iter = 200`
    # (real name: `max_iters`) which left the agentic loop capped at 8 while the operator believed
    # it was 200 — presenting as "the agent gives up after 8 rounds" with nothing pointing at the
    # config. A typo must never look identical to not having written the line.
    _cfg_unknown_n = 0;
    _cfg_scan_unknown(_lay_parse("[hoosh]\nurl = \"u\"\nmax-iter = 200\nmax_iters = 9\n"));
    assert_eq(config_unknown_count(), 1, "the typo is reported and the good keys are not");
    assert(streq(config_unknown_at(0), "hoosh.max-iter") == 1, "...named as <section>.<key>");
    # an unrecognised TABLE is reported once, not once per key inside it
    _cfg_unknown_n = 0;
    _cfg_scan_unknown(_lay_parse("[nosuch]\na = 1\nb = 2\n"));
    assert_eq(config_unknown_count(), 1, "an unknown TABLE is reported once, not per key");
    assert(streq(config_unknown_at(0), "nosuch.*") == 1, "...named with a * to show the table is unknown");
    # tables whose keys the USER chooses must never be flagged
    _cfg_unknown_n = 0;
    _cfg_scan_unknown(_lay_parse("[alias]\nwhatever = \"x\"\n[shell.deny]\nlabel = \"rm *\"\n[pricing.m]\ninput = 1\noutput = 2\n"));
    assert_eq(config_unknown_count(), 0, "user-chosen keys ([alias], [shell.*] labels, pricing rates) are never flagged");
    # ...but a wrong key inside a dynamic table still is
    _cfg_unknown_n = 0;
    _cfg_scan_unknown(_lay_parse("[pricing.m]\ninput = 1\nouput = 2\n"));
    assert_eq(config_unknown_count(), 1, "a typo'd pricing rate IS flagged");
    assert(streq(config_unknown_at(0), "pricing.m.ouput") == 1, "...with the full dotted path");
    # every real key of every real table must pass clean — this is the guard against the checker
    # itself drifting behind the config surface it describes
    _cfg_unknown_n = 0;
    _cfg_scan_unknown(_lay_parse("[hoosh]\nurl=\"u\"\ntoken=\"t\"\nmodel=\"m\"\nstream=true\nhistory=true\ntools=true\nmax_iters=1\ncompact_at=1\nparallel=true\nreasoning=\"low\"\nsummarize=true\n"));
    _cfg_scan_unknown(_lay_parse("[daimon]\nurl=\"u\"\n"));
    _cfg_scan_unknown(_lay_parse("[tron]\npolicy=\"p\"\nagent=\"a\"\n"));
    _cfg_scan_unknown(_lay_parse("[log]\nfile=\"f\"\nlevel=\"info\"\n"));
    _cfg_scan_unknown(_lay_parse("[history]\nfile=\"f\"\n"));
    _cfg_scan_unknown(_lay_parse("[session]\nfile=\"f\"\n"));
    _cfg_scan_unknown(_lay_parse("[ui]\nbell=true\nelapsed=true\ntier=\"rich\"\n"));
    _cfg_scan_unknown(_lay_parse("[memory]\nenabled=true\n"));
    _cfg_scan_unknown(_lay_parse("[persona]\nname=\"n\"\n"));
    _cfg_scan_unknown(_lay_parse("[project]\nvidya=\"v\"\nread_roots=[\"/a\"]\n"));
    _cfg_scan_unknown(_lay_parse("[hooks]\nsession_start=\"s\"\npre_tool=\"p\"\npost_tool=\"q\"\nsession_end=\"e\"\ntimeout_ms=1\n"));
    _cfg_scan_unknown(_lay_parse("[toolpin]\nenabled=true\n"));
    _cfg_scan_unknown(_lay_parse("[subagent]\nenabled=true\nmax_iters=1\n"));
    _cfg_scan_unknown(_lay_parse("[guard]\nenabled=true\n"));
    _cfg_scan_unknown(_lay_parse("[verify]\ncommand=\"c\"\ntimeout_ms=1\n"));
    _cfg_scan_unknown(_lay_parse("[redact]\nenabled=true\n"));
    _cfg_scan_unknown(_lay_parse("[shell]\nenabled=true\ntimeout_ms=1\nmax_output=1\ndeny=[\"a\"]\nallow=[\"b\"]\n"));
    _cfg_scan_unknown(_lay_parse("[edit]\nenabled=true\n"));
    assert_eq(config_unknown_count(), 0, "EVERY documented key of EVERY table passes the checker clean");
    _cfg_unknown_n = 0;
    return 0;
}
