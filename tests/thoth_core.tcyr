# thoth INTEGRATION tests — everything that needs the commands/tui hub: CLI/session/config/hoosh/
# persona/cost/history/oneshot (core) + the agent spine + the rich TUI. FULL includes (the hub couples
# these to the whole codebase — agent->spin_label, shell->_params_one, tui->dispatch). 0.30.9.
include "src/vendor/bote-core.cyr"
include "src/vendor/libro.cyr"
include "src/vendor/t-ron.cyr"
include "src/vendor/avatara.cyr"
include "src/vendor/vyakarana.cyr"
include "src/vendor/darshana.cyr"
include "src/vendor/anuenue.cyr"    # HSV hue for /theme rainbow (0.38.0); before ui.cyr
# agnosai (2.0.7 [lib.guard] profile) — the secret/PII scanner + redactor behind [redact] (0.40.0, T1-3).
# TWO modules, ~530 lines: agnosai's units + output_filter. NOT the orchestration engine — thoth consumes
# hoosh for inference and daimon for tools, and agnosai's own llm/ layer names thoth's hoosh.cyr as its
# reference implementation. The profile was published upstream at thoth's request rather than the two
# files being hand-copied, so this stays one source of truth. See scripts/sync-agnosai.sh.
include "src/vendor/agnosai-guard.cyr"
include "src/vendor/sankoch.cyr"    # git-object inflate (0.13.0); before sit-read
include "src/vendor/sit-read.cyr"   # sit read-only VCS API (branch/status/diff)
include "src/util.cyr"
include "src/version.cyr"
include "src/ui.cyr"
include "src/feed.cyr"
include "src/ftree.cyr"
include "src/inhist.cyr"
include "src/fsearch.cyr"
include "src/mention.cyr"
include "src/project.cyr"  # model-invokable read_file/list_dir project tools (0.23.0/0.23.1); before config (config_load grants configured roots)
include "src/search.cyr"   # model-invokable `search` tool (0.40.0, T1-1); AFTER project.cyr — reuses its jail predicates
include "src/config.cyr"
include "src/log.cyr"
include "src/gate.cyr"
include "src/git.cyr"      # git producer (0.13.0); before seams (SEAM_GIT reads git_present)
include "src/seams.cyr"
include "src/session.cyr"
include "src/roundlog.cyr"
include "src/editlog.cyr"  # model edit diff ring (0.31.1)
include "src/exec.cyr"
include "src/intr.cyr"    # turn-interrupt substrate (Esc abort); extracted from tui (0.30.8); before hoosh/agent poll it
include "src/hoosh.cyr"
include "src/mpick.cyr"    # model-picker palette state/filter/nav (0.24.0)
include "src/memory.cyr"
include "src/memlog.cyr"
include "src/reasonlog.cyr"
include "src/shell.cyr"    # model-invokable `shell` agentic tool (0.16.0, ADR-0014)
include "src/checkpoint.cyr" # file checkpoints + /rewind for model writes (0.40.0, T1-4); BEFORE edit.cyr, which gates its writes on ckpt_capture
include "src/edit.cyr"     # model-invokable `edit` agentic tool (0.31.0, ADR-0016)
include "src/daimon.cyr"
include "src/mcpres.cyr"   # MCP resources + prompts via daimon 2.1.0 (0.43.0, T2-7); after daimon (uses _daimon_url_join)
include "src/guard.cyr"     # prompt-injection defense over untrusted PROSE (0.41.0, T2-3); glue over the vendored agnosai guard
include "src/redact.cyr"    # secret redaction over tool results (0.40.0, T1-3); glue over the vendored agnosai guard; before agent.cyr
include "src/hooks.cyr"     # lifecycle hooks, incl. a BLOCKING pre_tool (0.41.0, T2-4); after exec/shell, before agent.cyr calls them
include "src/verify.cyr"    # the verification loop (0.41.0, T2-5); after exec/shell, before agent.cyr folds it into a tool result
include "src/events.cyr"    # streaming NDJSON events for machine consumers (0.42.0, T3); after hoosh (uses _append_int_cap/_json_escape_*)
include "src/toolpin.cyr"   # TOFU pinning of MCP tool definitions (0.42.0, T3); before agent.cyr, which gates advertisement on it
include "src/agent.cyr"
include "src/subagent.cyr"  # scoped child context, the `delegate` tool (0.43.0, T2-1, ADR-0018); AFTER agent.cyr (reuses its dispatch + builders)
include "src/diff.cyr"
include "src/mdhl.cyr"     # markdown fenced-code highlighter (0.15.1); after diff (calls _hl_span)
include "src/mdmodel.cyr"  # 0.36.0: structural-markdown model (gfeed leaf lowers it)
include "src/surface.cyr"  # status view-model (0.28.0, Stage B); after its producers (session/hoosh/git/ui), before commands+tui
include "src/commands.cyr"
include "src/repl.cyr"
include "src/oneshot.cyr"
include "src/tui.cyr"

include "tests/cases/testutil.cyr"
include "tests/cases/core.cyr"
include "tests/cases/tui.cyr"
include "tests/cases/agent.cyr"
include "tests/cases/vendor.cyr"   # vendor-pin integrity (0.38.6); no thoth deps — pure fs+str over src/vendor/

