# thoth — top-level test entry (referenced by cyrius.cyml [build].test).
# For unit tests, add the case to the right topical file under tests/cases/ (gui/render/tui/agent/core.cyr;
# shared byte-buffer helpers in testutil.cyr) and wire the new test_* call into the matching CURATED test binary
# in tests/ (0.30.9): tests/thoth_gui.tcyr (LEAN — no tui/mdhl/feed/commands), tests/thoth_render.tcyr (LEAN —
# diff/mdhl/vyakarana), tests/thoth_core.tcyr (FULL — the commands/tui-coupled integration tests: core + agent +
# tui). Each .tcyr curates only its transitive src includes. `cyrius test` runs all tests/*.tcyr.

include "lib/syscalls.cyr"

fn main() {
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
