# thoth — hoosh seam client (M3).
#
# The signature seam. hoosh owns LLM inference, multi-provider routing, and the
# mid-session model switch; thoth only DRIVES it (own-the-stack, never reic). It
# is reached as a REMOTE client over HTTP: thoth POSTs an OpenAI-compatible
# chat-completions request to the configured gateway (thoth.cyml [hoosh].url)
# and prints the completion. Off AGNOS this is the networked gateway; on AGNOS
# the same contract is reached co-resident. Transport is sandhi — we COMPOSE a
# client, never hand-roll sockets. No spine domain logic lives here.
#
# Mid-session model switching needs no session protocol: hoosh routes per
# request by the "model" field, so a different model on the next request IS the
# switch. The current model comes from session state (set by /model), falling
# back to thoth.cyml [hoosh].model, then to hoosh's own routing default.
#
# The request builder + JSON escaper + response extractor are PURE and unit-
# tested in tests/. Only hoosh_send does I/O (the network round-trip).

# Reused request buffer — the bump allocator never frees, so one buffer avoids
# accreting a fresh alloc every turn over a long session. A single turn's prompt
# is bounded by the 4096-byte input line; the 0.5.1 multi-turn request carries
# the conversation tail, byte-budgeted at HOOSH_REQ_CAP/8 of raw content so even
# worst-case (~6x) JSON escaping plus the system prompt and framing stays under
# this cap. Allocated lazily, heap-resident (too large for a stack buffer).
var _hoosh_req = 0;
var HOOSH_REQ_CAP = 262144;
var HOOSH_MAX_TOKENS = 4096;
var _hoosh_auth = 0;        # cached "Bearer <token>" header value
var _hoosh_endpoint = 0;    # cached base url + the OpenAI path
var _hoosh_models_ep = 0;   # cached base url + the OpenAI /v1/models path
var HOOSH_PATH = "/v1/chat/completions";
var HOOSH_MODELS_PATH = "/v1/models";
var _hoosh_catalog_ep = 0;  # cached base url + the concrete per-provider catalog path
var HOOSH_CATALOG_PATH = "/v1/models/catalog";

# Assistant-reply accumulator (0.5.1): both turn paths leave the full assistant
# text here (streaming appends each delta; blocking copies the parsed content) so
# hoosh_send can record it in the conversation history. Reset at each turn start.
var _hoosh_acc = 0;
var _hoosh_acc_len = 0;
var HOOSH_ACC_CAP = 65536;
fn _hoosh_acc_reset() { _hoosh_acc_len = 0; return 0; }

# hoosh_last_reply / _len (0.11.0): the most recent turn's full assistant text and
# its byte length (the blocking path copies the parsed content here, streaming
# appends each delta; agent_turn leaves the final answer here too). One-shot mode
# reads this AFTER the turn to print just the clean answer to stdout.
fn hoosh_last_reply() { return _hoosh_acc; }
fn hoosh_last_reply_len() { return _hoosh_acc_len; }
fn _hoosh_acc_append(p, n) {
    if (_hoosh_acc == 0) { _hoosh_acc = alloc(HOOSH_ACC_CAP); }
    var room = HOOSH_ACC_CAP - 1 - _hoosh_acc_len;
    if (n > room) { n = room; }
    if (n <= 0) { return 0; }
    memcpy(_hoosh_acc + _hoosh_acc_len, p, n);
    _hoosh_acc_len = _hoosh_acc_len + n;
    store8(_hoosh_acc + _hoosh_acc_len, 0);
    return 0;
}

# _hoosh_endpoint_url: the full POST target = configured base url + the
# well-known OpenAI-compatible path. thoth owns this path (it is fixed by the
# contract hoosh speaks), so thoth.cyml carries only the gateway base. One
# trailing slash on the base is trimmed. Cached.
fn _hoosh_endpoint_url() {
    if (_hoosh_endpoint != 0) { return _hoosh_endpoint; }
    var base = config_hoosh_url();
    var blen = strlen(base);
    if (blen > 0) { if (load8(base + blen - 1) == 47) { blen = blen - 1; } }   # trim one '/'
    _hoosh_endpoint = alloc(blen + strlen(HOOSH_PATH) + 1);
    var off = 0;
    var i = 0;
    while (i < blen) { store8(_hoosh_endpoint + off, load8(base + i)); off = off + 1; i = i + 1; }
    off = _append_cstr(_hoosh_endpoint, off, HOOSH_PATH);
    store8(_hoosh_endpoint + off, 0);
    return _hoosh_endpoint;
}

# _hoosh_models_url: the GET target for the model catalog = configured base url
# + the well-known OpenAI-compatible /v1/models path. Same base-trim + cache
# convention as _hoosh_endpoint_url. Cached.
fn _hoosh_models_url() {
    if (_hoosh_models_ep != 0) { return _hoosh_models_ep; }
    var base = config_hoosh_url();
    var blen = strlen(base);
    if (blen > 0) { if (load8(base + blen - 1) == 47) { blen = blen - 1; } }   # trim one '/'
    _hoosh_models_ep = alloc(blen + strlen(HOOSH_MODELS_PATH) + 1);
    var off = 0;
    var i = 0;
    while (i < blen) { store8(_hoosh_models_ep + off, load8(base + i)); off = off + 1; i = i + 1; }
    off = _append_cstr(_hoosh_models_ep, off, HOOSH_MODELS_PATH);
    store8(_hoosh_models_ep + off, 0);
    return _hoosh_models_ep;
}

# _hoosh_catalog_url: GET target for hoosh's concrete per-provider model catalog
# (hoosh >= 2.4.9: GET /v1/models/catalog → {object:list, data:[{id, owned_by}]}).
# Same base-trim + cache convention as _hoosh_endpoint_url. Cached.
fn _hoosh_catalog_url() {
    if (_hoosh_catalog_ep != 0) { return _hoosh_catalog_ep; }
    var base = config_hoosh_url();
    var blen = strlen(base);
    if (blen > 0) { if (load8(base + blen - 1) == 47) { blen = blen - 1; } }   # trim one '/'
    _hoosh_catalog_ep = alloc(blen + strlen(HOOSH_CATALOG_PATH) + 1);
    var off = 0;
    var i = 0;
    while (i < blen) { store8(_hoosh_catalog_ep + off, load8(base + i)); off = off + 1; i = i + 1; }
    off = _append_cstr(_hoosh_catalog_ep, off, HOOSH_CATALOG_PATH);
    store8(_hoosh_catalog_ep + off, 0);
    return _hoosh_catalog_ep;
}

# _ci_eq: 1 if NUL-terminated a and b are equal ignoring ASCII case. Pure. Used to
# match a user-typed provider (e.g. "Anthropic") against hoosh's lowercase
# owned_by ("anthropic").
fn _ci_eq(a, b) {
    var i = 0;
    var ret = 0 - 2;
    while (ret == (0 - 2)) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if ((ca >= 65) && (ca <= 90)) { ca = ca + 32; }
        if ((cb >= 65) && (cb <= 90)) { cb = cb + 32; }
        if (ca != cb) { ret = 0; }
        elif (ca == 0) { ret = 1; }
        else { i = i + 1; }
    }
    return ret;
}

# _hoosh_hex_digit: 0..15 -> ASCII hex (lowercase). Pure. (Named to avoid
# colliding with stdlib patra's identical private _hex_digit.)
fn _hoosh_hex_digit(n) {
    if (n < 10) { return 48 + n; }      # '0'..'9'
    return 87 + n;                      # 'a'..'f'  (97 - 10)
}

# _append_cstr: copy NUL-terminated s into dst at off; return new off. Pure.
fn _append_cstr(dst, off, s) {
    var i = 0;
    while (load8(s + i) != 0) {
        store8(dst + off, load8(s + i));
        off = off + 1;
        i = i + 1;
    }
    return off;
}

# _append_cstr_cap: bounded _append_cstr — copy NUL-terminated s into dst at off
# but NEVER write at or past `cap` - 1 (one byte reserved for a trailing NUL the
# caller writes). Returns the new off (<= cap - 1). The defensive form used for
# any source that is NOT length-trusted — model tool_call name/arguments, daimon
# tool metadata — so an oversized untrusted string truncates in-buffer instead of
# overflowing a fixed destination (load8/store8 are unchecked). Pure.
fn _append_cstr_cap(dst, off, cap, s) {
    var i = 0;
    while ((load8(s + i) != 0) && (off < (cap - 1))) {
        store8(dst + off, load8(s + i));
        off = off + 1;
        i = i + 1;
    }
    return off;
}

# _json_escape_n_into_cap: the bounded JSON-escape core — escape src[0..src_len) into dst at
# off, bounded to cap. A single source byte expands to at most 6 output bytes (\u00XX), so it
# stops before any char whose worst-case expansion could reach `cap` - 1, guaranteeing the
# write stays in-buffer with a byte left for the caller's terminator. Truncation is at a
# CHARACTER boundary, so the partial output is still well-formed escaped text (never a split
# escape). LENGTH-bounded (not NUL-terminated) so the one-shot reply — held by length and
# possibly containing a legitimate 0 byte — escapes faithfully. The defensive escaper for
# untrusted (model/MCP) strings. Pure.
fn _json_escape_n_into_cap(dst, off, cap, src, src_len) {
    var i = 0;
    var stop = 0;
    while ((i < src_len) && (stop == 0)) {
        if ((off + 6) >= cap) { stop = 1; }
        else {
            var c = load8(src + i);
            if (c == 34) {                  # "
                store8(dst + off, 92); off = off + 1;
                store8(dst + off, 34); off = off + 1;
            } elif (c == 92) {              # backslash
                store8(dst + off, 92); off = off + 1;
                store8(dst + off, 92); off = off + 1;
            } elif (c == 10) {              # \n
                store8(dst + off, 92); off = off + 1;
                store8(dst + off, 110); off = off + 1;
            } elif (c == 13) {              # \r
                store8(dst + off, 92); off = off + 1;
                store8(dst + off, 114); off = off + 1;
            } elif (c == 9) {               # \t
                store8(dst + off, 92); off = off + 1;
                store8(dst + off, 116); off = off + 1;
            } elif (c < 32) {               # other control -> \u00XX
                var hi = c / 16;
                var lo = c - hi * 16;
                store8(dst + off, 92); off = off + 1;
                store8(dst + off, 117); off = off + 1;
                store8(dst + off, 48); off = off + 1;
                store8(dst + off, 48); off = off + 1;
                store8(dst + off, _hoosh_hex_digit(hi)); off = off + 1;
                store8(dst + off, _hoosh_hex_digit(lo)); off = off + 1;
            } else {
                store8(dst + off, c); off = off + 1;
            }
            i = i + 1;
        }
    }
    return off;
}

# _json_escape_into_cap: the NUL-terminated wrapper (escape up to the first 0 byte). The
# defensive sibling of _json_escape_into for untrusted (model/MCP) cstrings. Delegates to the
# length-bounded core at strlen(src) — byte-identical to the prior NUL-loop. Pure.
fn _json_escape_into_cap(dst, off, cap, src) {
    return _json_escape_n_into_cap(dst, off, cap, src, strlen(src));
}

# _append_int: write non-negative n as decimal into dst at off; return new off.
fn _append_int(dst, off, n) {
    if (n == 0) { store8(dst + off, 48); return off + 1; }
    var tmp[24];
    var ti = 0;
    while (n > 0) {
        store8(&tmp + ti, 48 + (n - (n / 10) * 10));
        ti = ti + 1;
        n = n / 10;
    }
    while (ti > 0) {
        ti = ti - 1;
        store8(dst + off, load8(&tmp + ti));
        off = off + 1;
    }
    return off;
}

# _json_escape_into: append src (cstring) into dst at off as the BODY of a JSON
# string (no surrounding quotes); return new off. Escapes ", \, and control
# bytes (\n \r \t, else \u00XX) so an arbitrary prompt is valid JSON. Pure —
# unit-tested. Caller sizes dst for the ~6x worst case.
fn _json_escape_into(dst, off, src) {
    var i = 0;
    while (load8(src + i) != 0) {
        var c = load8(src + i);
        if (c == 34) {                  # "
            store8(dst + off, 92); off = off + 1;
            store8(dst + off, 34); off = off + 1;
        } elif (c == 92) {              # backslash
            store8(dst + off, 92); off = off + 1;
            store8(dst + off, 92); off = off + 1;
        } elif (c == 10) {              # \n
            store8(dst + off, 92); off = off + 1;
            store8(dst + off, 110); off = off + 1;
        } elif (c == 13) {              # \r
            store8(dst + off, 92); off = off + 1;
            store8(dst + off, 114); off = off + 1;
        } elif (c == 9) {               # \t
            store8(dst + off, 92); off = off + 1;
            store8(dst + off, 116); off = off + 1;
        } elif (c < 32) {               # other control -> \u00XX
            var hi = c / 16;
            var lo = c - hi * 16;
            store8(dst + off, 92); off = off + 1;       # backslash
            store8(dst + off, 117); off = off + 1;      # u
            store8(dst + off, 48); off = off + 1;       # 0
            store8(dst + off, 48); off = off + 1;       # 0
            store8(dst + off, _hoosh_hex_digit(hi)); off = off + 1;
            store8(dst + off, _hoosh_hex_digit(lo)); off = off + 1;
        } else {
            store8(dst + off, c); off = off + 1;
        }
        i = i + 1;
    }
    return off;
}

# hoosh_build_request: write a chat-completions JSON request for
# (model, system, prompt) into dst, NUL-terminated; return the byte length.
# Pure — unit-tested. A non-empty `system` (the avatara persona, M5 step 2) is
# emitted as a leading {role:system} message; an empty/0 system is omitted (the
# original single-user-message shape, preserved). `stream` (1/0) sets the
# OpenAI `"stream"` field — true makes the gateway answer with SSE deltas. Shape:
#   {"model":"M","messages":[{"role":"system","content":"S"},{"role":"user","content":"P"}],"max_tokens":N,"stream":true|false}
fn hoosh_build_request(dst, model, system, mem, prompt, stream) {
    var cap = HOOSH_REQ_CAP;
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "{\"model\":\"");
    off = _json_escape_into_cap(dst, off, cap, model);
    off = _append_cstr_cap(dst, off, cap, "\",\"messages\":[");
    if ((system != 0) && (load8(system) != 0)) {
        off = _append_cstr_cap(dst, off, cap, "{\"role\":\"system\",\"content\":\"");
        off = _json_escape_into_cap(dst, off, cap, system);
        off = _append_cstr_cap(dst, off, cap, "\"},");
    }
    # project memory (0.12.0): a second system message after the persona, before
    # the user turn. Off/absent -> mem is 0 -> omitted (byte-identical floor).
    if ((mem != 0) && (load8(mem) != 0)) {
        off = _append_cstr_cap(dst, off, cap, "{\"role\":\"system\",\"content\":\"");
        off = _json_escape_into_cap(dst, off, cap, mem);
        off = _append_cstr_cap(dst, off, cap, "\"},");
    }
    off = _append_cstr_cap(dst, off, cap, "{\"role\":\"user\",\"content\":\"");
    off = _json_escape_into_cap(dst, off, cap, prompt);
    off = _append_cstr_cap(dst, off, cap, "\"}],\"max_tokens\":");
    off = _append_int(dst, off, HOOSH_MAX_TOKENS);
    # stream_options:{include_usage} makes the gateway append a final usage frame to
    # the SSE stream (0.10.2) — without it a streamed turn carries no token count.
    if (stream == 1) { off = _append_cstr_cap(dst, off, cap, ",\"stream\":true,\"stream_options\":{\"include_usage\":true}}"); }
    else { off = _append_cstr_cap(dst, off, cap, ",\"stream\":false}"); }
    store8(dst + off, 0);
    return off;
}

# _hoosh_emit_msg: append one {"role":"R","content":"<escaped C>"} at off; return
# the new off. Pure. The multi-turn message serializer (0.5.1).
fn _hoosh_emit_msg(dst, off, role, content) {
    off = _append_cstr(dst, off, "{\"role\":\"");
    off = _append_cstr(dst, off, role);
    off = _append_cstr(dst, off, "\",\"content\":\"");
    off = _json_escape_into(dst, off, content);
    off = _append_cstr(dst, off, "\"}");
    return off;
}

# _hoosh_emit_msg_cap: bounded _hoosh_emit_msg — every write is clamped to `cap`
# so a long history `content` (e.g. a prior assistant reply up to HOOSH_ACC_CAP,
# re-sent on the next turn) truncates in-buffer instead of overflowing the request
# buffer. `role` is a trusted literal; `content` is the untrusted part. Pure.
fn _hoosh_emit_msg_cap(dst, off, cap, role, content) {
    off = _append_cstr_cap(dst, off, cap, "{\"role\":\"");
    off = _append_cstr_cap(dst, off, cap, role);
    off = _append_cstr_cap(dst, off, cap, "\",\"content\":\"");
    off = _json_escape_into_cap(dst, off, cap, content);
    off = _append_cstr_cap(dst, off, cap, "\"}");
    return off;
}

# _hoosh_history_start: the index of the OLDEST conversation message to include
# so the serialized request stays within the request buffer. Walks newest->oldest
# summing content bytes (+ per-message framing) against a budget of cap/8 — that
# leaves >6x headroom for JSON escaping (worst case) plus the system prompt and
# fixed framing, so the build cannot overflow `cap`. Always keeps at least the
# newest message. Pure (reads the global history via the session accessors).
fn _hoosh_history_start(cap) {
    var n = session_history_len();
    if (n == 0) { return 0; }
    var budget = cap / 8;
    var used = 0;
    var start = n;
    var i = n - 1;
    while (i >= 0) {
        var clen = strlen(session_history_content(i)) + 16;   # +framing
        if (((used + clen) > budget) && (start != n)) { i = 0 - 1; }
        else { used = used + clen; start = i; i = i - 1; }
    }
    return start;
}

# --- context-budget meter (0.19.0) ----------------------------------------
# hoosh keeps only the NEWEST tail of the conversation whose framed content bytes fit HOOSH_REQ_CAP/8
# (~32 KiB); older turns are silently EVICTED from each request (_hoosh_history_start). These PURE accessors
# surface that so /state + the status bar can show context pressure before it bites — no new producer, just
# thoth-owned data it already computes each turn.
fn hoosh_ctx_budget() { return HOOSH_REQ_CAP / 8; }        # the eviction boundary in framed bytes

# hoosh_ctx_bytes: total FRAMED history bytes — sum of content length + per-message framing over ALL
# messages. Uses `strlen(content) + 16` to MATCH _hoosh_history_start EXACTLY (line-for-line), so the meter
# predicts the real eviction boundary rather than an independent estimate: bytes-vs-budget IS the eviction
# decision. History content is a C string (no interior NUL) — the same invariant the eviction budget and the
# request serialization already rely on; an interior NUL would move the eviction boundary itself and the
# meter would still mirror it.
fn hoosh_ctx_bytes() {
    var n = session_history_len();
    var used = 0;
    var i = 0;
    while (i < n) { used = used + strlen(session_history_content(i)) + 16; i = i + 1; }
    return used;
}

# hoosh_ctx_evicted: how many OLDEST turns are currently dropped from a request (0 = the whole history
# fits). == _hoosh_history_start (messages [0, start) are excluded from the request tail).
fn hoosh_ctx_evicted() { return _hoosh_history_start(HOOSH_REQ_CAP); }

# hoosh_build_messages: write a chat-completions request carrying the full
# conversation (system persona + the budgeted tail of session history) into dst,
# NUL-terminated; return the byte length. The newest user turn must already be in
# history. Pure (reads the session history). Shape mirrors hoosh_build_request
# but with N messages instead of one.
fn hoosh_build_messages(dst, model, system, mem, stream) {
    var cap = HOOSH_REQ_CAP;
    var start = _hoosh_history_start(HOOSH_REQ_CAP);
    var total = session_history_len();
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "{\"model\":\"");
    off = _json_escape_into_cap(dst, off, cap, model);
    off = _append_cstr_cap(dst, off, cap, "\",\"messages\":[");
    var wrote = 0;
    if ((system != 0) && (load8(system) != 0)) {
        off = _hoosh_emit_msg_cap(dst, off, cap, "system", system);
        wrote = 1;
    }
    # project memory (0.12.0): a second system message after the persona, before
    # history. Off/absent -> mem is 0 -> omitted (byte-identical floor).
    if ((mem != 0) && (load8(mem) != 0)) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, "system", mem);
        wrote = 1;
    }
    var i = start;
    while (i < total) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, session_history_role(i), session_history_content(i));
        wrote = 1;
        i = i + 1;
    }
    off = _append_cstr_cap(dst, off, cap, "],\"max_tokens\":");
    off = _append_int(dst, off, HOOSH_MAX_TOKENS);
    if (stream == 1) { off = _append_cstr_cap(dst, off, cap, ",\"stream\":true,\"stream_options\":{\"include_usage\":true}}"); }
    else { off = _append_cstr_cap(dst, off, cap, ",\"stream\":false}"); }
    store8(dst + off, 0);
    return off;
}

# hoosh_build_dry: the request body thoth WOULD send for `prompt` in multi-turn mode,
# built WITHOUT mutating session history — so the `/dry` preview (src/commands.cyr) has no
# side effects. Like hoosh_build_messages, but it serializes the current history tail and
# then appends `prompt` as the final user message itself (the real path appends to history
# first; here we read-only). NUL-terminates, returns the byte length. Pure.
#
# KNOWN second-order edge (acceptable for a preview): `_hoosh_history_start` budgets the
# history tail over the CURRENT history (without `prompt`'s bytes), whereas the live turn
# appends `prompt` first so its budget includes them. At a ~32 KiB-of-history boundary the
# preview can include one more old message than the live turn would (the prompt is bounded
# by the 4 KiB input line, so the skew is small). Faithful for any normal conversation.
fn hoosh_build_dry(dst, model, system, mem, prompt, stream) {
    var cap = HOOSH_REQ_CAP;
    var start = _hoosh_history_start(HOOSH_REQ_CAP);
    var total = session_history_len();
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "{\"model\":\"");
    off = _json_escape_into_cap(dst, off, cap, model);
    off = _append_cstr_cap(dst, off, cap, "\",\"messages\":[");
    var wrote = 0;
    if ((system != 0) && (load8(system) != 0)) {
        off = _hoosh_emit_msg_cap(dst, off, cap, "system", system);
        wrote = 1;
    }
    # project memory (0.12.0): a second system message after the persona, before
    # history (mirrors hoosh_build_messages so /dry shows the exact bytes).
    if ((mem != 0) && (load8(mem) != 0)) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, "system", mem);
        wrote = 1;
    }
    var i = start;
    while (i < total) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, session_history_role(i), session_history_content(i));
        wrote = 1;
        i = i + 1;
    }
    if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }   # the pending user turn
    off = _hoosh_emit_msg_cap(dst, off, cap, "user", prompt);
    off = _append_cstr_cap(dst, off, cap, "],\"max_tokens\":");
    off = _append_int(dst, off, HOOSH_MAX_TOKENS);
    if (stream == 1) { off = _append_cstr_cap(dst, off, cap, ",\"stream\":true,\"stream_options\":{\"include_usage\":true}}"); }
    else { off = _append_cstr_cap(dst, off, cap, ",\"stream\":false}"); }
    store8(dst + off, 0);
    return off;
}

# hoosh_model_cur: the model id the NEXT turn would request — the exact precedence
# `hoosh_send` uses (session /model override, else [hoosh].model, else "default" under
# hoosh routing). A public accessor so /dry can't drift from the real path.
fn hoosh_model_cur() { return _hoosh_model(); }

# hoosh_dry_buf: the shared request buffer (lazily allocated). /dry composes into the
# SAME buffer a real turn uses — harmless (it is overwritten by the next turn) and keeps
# the preview byte-for-byte what the turn would build.
fn hoosh_dry_buf() {
    if (_hoosh_req == 0) { _hoosh_req = alloc(HOOSH_REQ_CAP); }
    return _hoosh_req;
}

# hoosh_extract_content: parse an OpenAI-shaped response body and return the
# assistant text as a Str (choices[0].message.content), or 0 if absent/wrong
# shape. Pure — unit-tested against canned bodies.
fn hoosh_extract_content(body, body_len) {
    var v = bayan_json_v_parse_str(body, body_len);
    if (v == 0) { return 0; }
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 0; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { return 0; }
    var msg = bayan_json_v_obj_get(first, "message");
    if (msg == 0) { return 0; }
    var content = bayan_json_v_obj_get(msg, "content");
    if (content == 0) { return 0; }
    return bayan_json_v_str(content);
}

# hoosh_extract_delta: pull choices[0].delta.content out of ONE OpenAI SSE
# streaming frame's `data:` JSON as a Str, or 0 when absent (the role-only
# opening delta, the finish frame, or a malformed payload). Pure — unit-tested.
# This is the streaming sibling of hoosh_extract_content (which reads the
# non-streaming message.content).
fn hoosh_extract_delta(body, body_len) {
    var v = bayan_json_v_parse_str(body, body_len);
    if (v == 0) { return 0; }
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 0; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { return 0; }
    var delta = bayan_json_v_obj_get(first, "delta");
    if (delta == 0) { return 0; }
    var content = bayan_json_v_obj_get(delta, "content");
    if (content == 0) { return 0; }
    return bayan_json_v_str(content);
}

# hoosh_extract_error: pull error.message out of an error response body as a
# Str, or 0 if not present. Pure — unit-tested.
fn hoosh_extract_error(body, body_len) {
    var v = bayan_json_v_parse_str(body, body_len);
    if (v == 0) { return 0; }
    var err = bayan_json_v_obj_get(v, "error");
    if (err == 0) { return 0; }
    var m = bayan_json_v_obj_get(err, "message");
    if (m == 0) { return 0; }
    return bayan_json_v_str(m);
}

# hoosh_extract_models: parse an OpenAI /v1/models list body and return the
# `data` JSON array value (each element `{"id":"...","object":"model",...}`), or
# 0 if absent/wrong shape. The caller iterates it with bayan_json_v_arr_*. Pure —
# unit-tested. Shape consumed: {"object":"list","data":[{"id":"M"},...]}
fn hoosh_extract_models(body, body_len) {
    var v = bayan_json_v_parse_str(body, body_len);
    if (v == 0) { return 0; }
    var data = bayan_json_v_obj_get(v, "data");
    if (data == 0) { return 0; }
    return data;
}

# _hoosh_usage_field: given an already-parsed JSON value, return usage.<key> as an
# int, or -1 when there is no usage object / no such field (a normal streaming delta
# frame, or a gateway that omits usage). Pure. The shared core so the SSE callback can
# reuse the value it already parsed instead of parsing twice per frame.
fn _hoosh_usage_field(v, key) {
    if (v == 0) { return 0 - 1; }
    var u = bayan_json_v_obj_get(v, "usage");
    if (u == 0) { return 0 - 1; }
    var t = bayan_json_v_obj_get(u, key);
    if (t == 0) { return 0 - 1; }
    return bayan_json_v_int(t);
}

# _hoosh_usage_total: usage.total_tokens, or -1 when absent. Pure.
fn _hoosh_usage_total(v) { return _hoosh_usage_field(v, "total_tokens"); }

# hoosh_cost_micro: the micro-USD cost of (prompt, completion) tokens at the given
# input/output rates (each micro-USD per 1000 tokens). Integer division truncates the
# sub-micro-USD remainder, so cost is never overstated. Pure — unit-tested.
fn hoosh_cost_micro(prompt, completion, in_rate, out_rate) {
    return (prompt * in_rate + completion * out_rate) / 1000;
}

# _hoosh_account_usage: fold one response's usage (from an already-parsed value) into
# the session token + cost tallies (0.10.2/0.10.3). Tokens come from total_tokens; cost
# is priced AT ACCUMULATE — prompt/completion tokens times the ACTIVE model's
# [pricing.<model>] rate, so a mid-session switch prices each turn correctly. A frame
# with no usage is a no-op; usage present but the model unpriced is recorded honestly
# (session_note_unpriced) rather than counted as $0. Called from both turn paths.
fn _hoosh_account_usage(v) {
    if (v == 0) { return 0; }
    var tot = _hoosh_usage_field(v, "total_tokens");
    if (tot >= 0) { session_add_tokens(tot); }
    var p = _hoosh_usage_field(v, "prompt_tokens");
    var c = _hoosh_usage_field(v, "completion_tokens");
    if ((p < 0) && (c < 0)) { return 0; }     # no token breakdown -> nothing to price
    if (p < 0) { p = 0; }
    if (c < 0) { c = 0; }
    var model = _hoosh_model();
    var in_rate = config_price_input(model);
    var out_rate = config_price_output(model);
    # Price only when BOTH rates are declared. A half-declared section (one side
    # omitted -> -1) degrades to unpriced+noted rather than silently billing the
    # missing side at $0 and showing an understated total (ADR-0010 honest-omit).
    # An explicit `= 0` reads as 0 (declared free), so a deliberately-free side
    # still prices — _cfg_int distinguishes an omitted key (-1) from `= 0`.
    if ((in_rate < 0) || (out_rate < 0)) { session_note_unpriced(); return 0; }
    session_add_cost(hoosh_cost_micro(p, c, in_rate, out_rate));
    return 0;
}

# hoosh_extract_usage: pull usage.total_tokens out of a response body (the blocking
# completion, or a streaming usage frame when stream_options:{include_usage} was
# sent) as an int, or -1 when absent. Pure — unit-tested. hoosh owns the count;
# thoth only reads what it's told (ADR-0010: omit-until-present, never faked).
fn hoosh_extract_usage(body, body_len) {
    return _hoosh_usage_total(bayan_json_v_parse_str(body, body_len));
}

# hoosh_reachable: a SILENT reachability probe (0.11.9). GET the gateway's models endpoint
# and return 1 iff the TRANSPORT reached the server — any HTTP status counts (even 404/401
# means the gateway is UP); only a connection failure (refused / timeout / DNS) returns 0.
# Emits NOTHING (unlike hoosh_list_models), so the TUI greeting can state the LIVE status
# instead of merely "configured". Uses the same plain sandhi GET + default timeout a real
# turn uses, so it reflects what a turn would actually find: a refused localhost gateway
# (the common case) fails instantly; a black-hole REMOTE url uses the same blocking connect
# a turn would (a bounded-connect probe is a possible later refinement).
fn hoosh_reachable() {
    var url = _hoosh_models_url();
    var h = sandhi_headers_new();
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    var r = sandhi_http_get(url, h);
    if (sandhi_http_err_kind(r) == SANDHI_OK) { return 1; }
    return 0;
}

# --- live spine-health (0.19.3) --------------------------------------------
# A cached hoosh reachability state driven by TRAFFIC OUTCOMES — no background timer / idle probe. It is
# seeded by the startup greeting's probe, updated by each turn's transport result (a connection failure ->
# DOWN; any answered request, even a non-2xx, -> UP), and re-probed on demand (Ctrl-R). The status bar shows
# it as a dot so the user sees the spine go down mid-session instead of discovering it on the next turn.
var HOOSH_HEALTH_UNKNOWN = 0;
var HOOSH_HEALTH_UP = 1;
var HOOSH_HEALTH_DOWN = 2;
var _hoosh_health = 0;

fn hoosh_health() { return _hoosh_health; }
fn hoosh_health_mark_up() { _hoosh_health = HOOSH_HEALTH_UP; return 0; }
fn hoosh_health_mark_down() { _hoosh_health = HOOSH_HEALTH_DOWN; return 0; }

# hoosh_health_note: record a turn's transport result — rc < 0 is a connection failure (the gateway did not
# answer -> DOWN); rc >= 0 means it answered (200 or a non-2xx status -> reachable, UP).
fn hoosh_health_note(rc) {
    if (rc < 0) { _hoosh_health = HOOSH_HEALTH_DOWN; } else { _hoosh_health = HOOSH_HEALTH_UP; }
    return 0;
}

# hoosh_health_probe: an on-demand silent reachability probe (startup + Ctrl-R) — updates + returns the
# cached state. Blocking (the same GET a turn's connect uses); no idle polling.
fn hoosh_health_probe() {
    if (hoosh_reachable() == 1) { _hoosh_health = HOOSH_HEALTH_UP; } else { _hoosh_health = HOOSH_HEALTH_DOWN; }
    return _hoosh_health;
}

# hoosh_list_models: GET the gateway's model catalog and print each model id,
# marking the one this session would route to (session override, else config
# default). Returns 0 on success, negative on transport failure, the HTTP status
# on non-2xx. Degrades honestly: an unreachable gateway is announced, not faked.
# I/O — the catalog itself is hoosh's domain (provider routing); thoth only asks.
fn hoosh_list_models() {
    var url = _hoosh_models_url();
    var h = sandhi_headers_new();
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    ui_emit(ROLE_FAINT, "  -> hoosh "); oprintln(url);
    var r = sandhi_http_get(url, h);
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        var ename = sandhi_err_kind_name(sandhi_http_err_kind(r));
        emit("  hoosh transport error: "); oprintln(ename);
        emit("  endpoint "); emit(url);
        oprintln(" unreachable — is the gateway up? (degraded, not faked)");
        return 0 - 1;
    }
    var status = sandhi_http_status(r);
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        var em = hoosh_extract_error(body, blen);
        if (em != 0) { emit("  "); _hoosh_print_str(em); }
        return status;
    }
    var data = hoosh_extract_models(body, blen);
    if (data == 0) { oprintln("  hoosh: response received but no model list could be parsed."); return 0 - 1; }
    var n = bayan_json_v_arr_len(data);
    var cur = _hoosh_model();
    ui_emit(ROLE_ACCENT, "models hoosh offers ("); ofmt_int(n); ui_emit(ROLE_ACCENT, "):"); oprintln("");
    if (n == 0) { oprintln("  (none advertised — hoosh routes by its own provider config)"); }
    var i = 0;
    while (i < n) {
        var m = bayan_json_v_arr_get(data, i);
        var id = bayan_json_v_obj_get(m, "id");
        if (id != 0) {
            var ids = bayan_json_v_str(id);
            if (str_eq_cstr(ids, cur) == 1) { ui_emit(ROLE_GREEN, "* "); ui_emit_n(ROLE_ACCENT, str_data(ids), str_len(ids)); }
            else { emit("  "); ui_emit_n(ROLE_FG, str_data(ids), str_len(ids)); }
            oprintln("");
        }
        i = i + 1;
    }
    emit("(* = current; switch with /model <id>. routing target now: "); emit(cur); oprintln(")");
    return 0;
}

# --- model catalog for the picker (0.24.0) ---------------------------------
var HOOSH_CAT_OK = 0;
var HOOSH_CAT_TRANSPORT = 1;   # the gateway did not answer (connection failed)
var HOOSH_CAT_HTTP = 2;        # the gateway answered non-2xx (even after the /v1/models fallback)
var _hoosh_cat_err = 0;

# hoosh_catalog_fetch: the DATA-returning sibling of hoosh_list_models for the model-picker palette (0.24.0).
# GETs the concrete per-provider catalog (/v1/models/catalog, hoosh >= 2.4.9) and, on 404, falls back to the
# plain /v1/models list (both share the {object:list, data:[{id, owned_by}]} shape). Returns the parsed JSON
# `data` array VALUE, or 0 on any failure; hoosh_catalog_last_err() then reports the kind for honest caller
# messaging. Prints NOTHING (the picker owns the UI). I/O — the catalog is hoosh's domain (provider routing);
# thoth only asks. The returned value points into the bump-heap response body (not freed); copy ids promptly.
fn hoosh_catalog_fetch() {
    _hoosh_cat_err = HOOSH_CAT_OK;
    var auth = _hoosh_auth_header();
    var h = sandhi_headers_new();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    var r = sandhi_http_get(_hoosh_catalog_url(), h);
    if (sandhi_http_err_kind(r) != SANDHI_OK) { _hoosh_cat_err = HOOSH_CAT_TRANSPORT; return 0; }
    var status = sandhi_http_status(r);
    if (status == 404) {                          # older gateway: fall back to the plain models list
        var h2 = sandhi_headers_new();
        if (auth != 0) { sandhi_headers_set(h2, "Authorization", auth); }
        r = sandhi_http_get(_hoosh_models_url(), h2);
        if (sandhi_http_err_kind(r) != SANDHI_OK) { _hoosh_cat_err = HOOSH_CAT_TRANSPORT; return 0; }
        status = sandhi_http_status(r);
    }
    if ((status < 200) || (status >= 300)) { _hoosh_cat_err = HOOSH_CAT_HTTP; return 0; }
    return hoosh_extract_models(sandhi_http_body(r), sandhi_http_body_len(r));
}

# hoosh_catalog_last_err: the outcome of the last hoosh_catalog_fetch (HOOSH_CAT_*). PURE.
fn hoosh_catalog_last_err() { return _hoosh_cat_err; }

# hoosh_list_provider_models: list the concrete, switchable models a given provider
# offers (GET /v1/models/catalog, filtered by owned_by), marking the active routing
# target. The catalog is hoosh's domain (hoosh >= 2.4.9 enumerates the routable
# models per provider); thoth only asks and filters. Returns 0 on success, negative
# on transport failure, the HTTP status on non-2xx. Degrades honestly: an old hoosh
# without the catalog endpoint (404) is announced, not faked. I/O.
fn hoosh_list_provider_models(provider) {
    var url = _hoosh_catalog_url();
    var h = sandhi_headers_new();
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    ui_emit(ROLE_FAINT, "  -> hoosh "); oprintln(url);
    var r = sandhi_http_get(url, h);
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        var ename = sandhi_err_kind_name(sandhi_http_err_kind(r));
        emit("  hoosh transport error: "); oprintln(ename);
        emit("  endpoint "); emit(url);
        oprintln(" unreachable — is the gateway up? (degraded, not faked)");
        return 0 - 1;
    }
    var status = sandhi_http_status(r);
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        if (status == 404) { oprintln("  (this gateway has no per-provider catalog — needs hoosh >= 2.4.9; /models lists providers)"); }
        else { var em = hoosh_extract_error(body, blen); if (em != 0) { emit("  "); _hoosh_print_str(em); } }
        return status;
    }
    # The catalog shares /v1/models' {object:list, data:[...]} shape, each entry
    # {id, owned_by}; reuse the same extractor and filter on owned_by.
    var data = hoosh_extract_models(body, blen);
    if (data == 0) { oprintln("  hoosh: response received but no model catalog could be parsed."); return 0 - 1; }
    var n = bayan_json_v_arr_len(data);
    var cur = _hoosh_model();
    ui_emit(ROLE_ACCENT, "models for provider '"); ui_emit(ROLE_ACCENT, provider); ui_emit(ROLE_ACCENT, "':"); oprintln("");
    var i = 0;
    var shown = 0;
    while (i < n) {
        var m = bayan_json_v_arr_get(data, i);
        var ob = bayan_json_v_obj_get(m, "owned_by");
        if (ob != 0) {
            var obs = bayan_json_v_str(ob);
            if ((obs != 0) && (_ci_eq(str_cstr(obs), provider) == 1)) {
                var id = bayan_json_v_obj_get(m, "id");
                if (id != 0) {
                    var ids = bayan_json_v_str(id);
                    if (str_eq_cstr(ids, cur) == 1) { ui_emit(ROLE_GREEN, "* "); ui_emit_n(ROLE_ACCENT, str_data(ids), str_len(ids)); }
                    else { emit("  "); ui_emit_n(ROLE_FG, str_data(ids), str_len(ids)); }
                    oprintln("");
                    shown = shown + 1;
                }
            }
        }
        i = i + 1;
    }
    if (shown == 0) {
        emit("  (no models for '"); emit(provider); oprintln("' — run /models to list providers)");
        return 0;
    }
    emit("(* = current; switch with /model <id>. "); ofmt_int(shown); oprintln(" model(s).)");
    return 0;
}

# _hoosh_model: the model for this turn — session override, else config default,
# else "default" (let hoosh route by its own provider config).
fn _hoosh_model() {
    var m = session_model();
    if (m != 0) { return m; }
    m = config_hoosh_model();
    if (m != 0) { return m; }
    return "default";
}

# _hoosh_auth_header: cache and return the "Bearer <token>" header value, or 0
# if no token is configured (unauthenticated gateway).
fn _hoosh_auth_header() {
    var tok = config_hoosh_token();
    if (tok == 0) { return 0; }
    if (_hoosh_auth != 0) { return _hoosh_auth; }
    _hoosh_auth = alloc(strlen(tok) + 8);
    var off = _append_cstr(_hoosh_auth, 0, "Bearer ");
    off = _append_cstr(_hoosh_auth, off, tok);
    store8(_hoosh_auth + off, 0);
    return _hoosh_auth;
}

# hoosh_auth_cache_reset: drop the cached "Bearer <token>" header so the next request rebuilds it from the
# current [hoosh].token. Used by /reload (0.24.4) — a rotated token would otherwise keep sending the stale
# header (silent 401s). The prior header leaks (bump heap) — acceptable for an infrequent command.
fn hoosh_auth_cache_reset() { _hoosh_auth = 0; return 0; }

# _hoosh_print_str: write a Str (ptr+len) to stdout with a trailing newline if
# it doesn't already end in one. I/O.
fn _hoosh_print_str(s) {
    var d = str_data(s);
    var n = str_len(s);
    emit_n(d, n);
    if (n > 0) { if (load8(d + n - 1) != 10) { oprintln(""); } }
    return 0;
}

# _hoosh_print_reply: like _hoosh_print_str but routes the assistant REPLY through the
# markdown fenced-code highlighter (0.15.1). ONLY reply content uses this — error bodies
# keep _hoosh_print_str (never highlighted). The trailing-newline courtesy reads the RAW
# str, unchanged, so a plain (fence-free) reply is byte-identical and the floor holds
# (mdhl_reply is a verbatim pass-through at PT_PLAIN).
fn _hoosh_print_reply(s) {
    var d = str_data(s);
    var n = str_len(s);
    mdhl_reply(d, n);
    if (n > 0) { if (load8(d + n - 1) != 10) { oprintln(""); } }
    return 0;
}

# _hoosh_sse_cb: the SSE event callback (sandhi calls cb(ctx, event) per parsed
# frame; return 1 to keep consuming, 0 to stop). Each OpenAI streaming frame's
# `data:` is a JSON delta — we print choices[0].delta.content as it arrives. The
# `[DONE]` sentinel ends the stream cleanly. ctx is an i64 cell counting bytes
# emitted, so the caller can finish the line honestly and detect an empty stream.
# Each delta is also appended to _hoosh_acc so the full reply can enter history
# (0.5.1) — printing happens before accumulation, so a saved reply may be
# truncated to HOOSH_ACC_CAP while the on-screen output is never clipped.
fn _hoosh_sse_cb(ctx, ev) {
    if (intr_poll() == 1) { return 0; }   # 0.17.4: Esc -> stop the stream cleanly (partial kept)
    var data = sandhi_sse_event_data(ev);
    if (data == 0) { return 1; }
    if (streq(data, "[DONE]") == 1) { return 0; }
    # Parse the frame once (was: hoosh_extract_delta re-parsing) so the trailing
    # usage frame (0.10.2 — choices:[] + a usage object, sent because the request
    # carried stream_options:{include_usage}) is captured on the same pass.
    var v = bayan_json_v_parse_str(data, strlen(data));
    if (v == 0) { return 1; }
    _hoosh_account_usage(v);
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 1; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { return 1; }            # usage frame / empty choices
    var delta = bayan_json_v_obj_get(first, "delta");
    if (delta == 0) { return 1; }
    var content = bayan_json_v_obj_get(delta, "content");
    if (content == 0) { return 1; }          # role-only / finish / non-content frame
    var s = bayan_json_v_str(content);
    if (s == 0) { return 1; }
    var n = str_len(s);
    if (n > 0) {
        mdhl_feed(str_data(s), n);   # 0.15.1: fenced-code highlighter (verbatim pass-through at PT_PLAIN)
        store64(ctx, load64(ctx) + n);
        _hoosh_acc_append(str_data(s), n);
        feed_stream_tick();   # 0.9.2: TUI incremental paint + spinner (no-op off the TUI)
    }
    return 1;
}

# _hoosh_stream_turn: the streaming branch of a turn. POSTs the (stream:true)
# request and prints SSE deltas as they arrive. Same honest-degradation contract
# as the blocking path. Returns 0 on success, negative on transport failure, the
# HTTP status on non-2xx. The stream result exposes status but not the body, so a
# non-2xx error message is not surfaced here (point the user at stream=false).
fn _hoosh_stream_turn(url, h, len, model) {
    sandhi_headers_set(h, "Accept", "text/event-stream");
    var cell = alloc(8);
    store64(cell, 0);
    ui_emit(ROLE_FAINT, "  -> hoosh ("); ui_emit(ROLE_ACCENT, model); ui_emit(ROLE_FAINT, ", stream) "); oprintln(url);
    mdhl_reset();    # 0.15.1: bracket the fenced-code highlighter around the stream
    intr_arm();      # 0.17.4: enter Esc-poll mode around the stream (TUI-only; no-op off OUT_RING)
    var sr = sandhi_http_stream(url, "POST", h, _hoosh_req, len, &_hoosh_sse_cb, cell);
    intr_disarm();   # 0.17.4: restore cooked (for a following confirm / the next turn)
    mdhl_finish();   # flush the filter (residual line + any open block) BEFORE status branching, so every exit path drains
    var serr = sandhi_stream_err(sr);
    var emitted = load64(cell);
    if (intr_pending() == 1) {                        # 0.17.4: Esc aborted the stream — land the partial honestly
        if (emitted > 0) { oprintln(""); }            # end the streamed line
        intr_note();                                  # the "— interrupted" marker (feed-only)
        return 0;                                     # rc==0 -> hoosh_send appends the partial (consistent pair)
    }
    if (serr != SANDHI_OK) {
        if (emitted > 0) { oprintln(""); }
        var ename = sandhi_err_kind_name(serr);
        emit("  hoosh stream error: "); oprintln(ename);
        emit("  endpoint "); emit(url);
        oprintln(" unreachable or interrupted — is the gateway up? (degraded, not faked)");
        return 0 - 1;
    }
    var status = sandhi_stream_status(sr);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        oprintln("  (error body not surfaced in stream mode; set [hoosh].stream=false to see it)");
        return status;
    }
    if (emitted > 0) { oprintln(""); return 0; }
    oprintln("  hoosh: stream completed but no content was parsed.");
    return 0 - 1;
}

# _hoosh_blocking_turn: the blocking branch of a turn. One POST, wait for the
# full completion, print it. On success the parsed assistant text is also copied
# into _hoosh_acc (so it can enter history) and 0 is returned; transport errors
# return negative, non-2xx returns the status (and surfaces the error body, which
# stream mode cannot). I/O.
fn _hoosh_blocking_turn(url, h, len, model) {
    ui_emit(ROLE_FAINT, "  -> hoosh ("); ui_emit(ROLE_ACCENT, model); ui_emit(ROLE_FAINT, ") "); oprintln(url);
    var r = sandhi_http_post(url, h, _hoosh_req, len);
    var ek = sandhi_http_err_kind(r);
    if (ek != SANDHI_OK) {
        # NB: bind to a var before println — passing an explicitly `: i64`-typed
        # sandhi getter straight into oprintln(cstring) mis-dispatches to the int
        # print path in this cyrius (6.1.22). Storing first prints the name.
        var ename = sandhi_err_kind_name(ek);
        emit("  hoosh transport error: "); oprintln(ename);
        emit("  endpoint "); emit(url);
        oprintln(" unreachable — is the gateway up? (degraded, not faked)");
        return 0 - 1;
    }
    var status = sandhi_http_status(r);
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        var em = hoosh_extract_error(body, blen);
        if (em != 0) { emit("  "); _hoosh_print_str(em); }
        return status;
    }
    var content = hoosh_extract_content(body, blen);
    if (content == 0) {
        oprintln("  hoosh: response received but no completion could be parsed.");
        return 0 - 1;
    }
    _hoosh_acc_append(str_data(content), str_len(content));
    _hoosh_account_usage(bayan_json_v_parse_str(body, blen));
    _hoosh_print_reply(content);   # 0.15.1: fenced-code highlighting (raw acc already stored above)
    return 0;
}

# hoosh_send: route one turn through the hoosh gateway and print the completion.
# Multi-turn by default ([hoosh].history): the user turn is recorded, the whole
# conversation is sent, and the assistant reply is recorded on success (rolled
# back on failure so history holds only completed exchanges). Streams the deltas
# (SSE) by default, or one blocking round-trip when [hoosh].stream = false.
# Returns 0 on success, negative on transport failure, or the HTTP status on a
# non-2xx response. Degrades honestly: an unreachable gateway is announced, not
# faked. I/O — the only impure path in this module.
fn hoosh_send(prompt) {
    var url = _hoosh_endpoint_url();
    var model = _hoosh_model();
    if (_hoosh_req == 0) { _hoosh_req = alloc(HOOSH_REQ_CAP); }
    # The avatara persona (M5) becomes the system message when the seam is bound
    # (native by construction); absent -> 0 and the request degrades to the bare
    # user turn. thoth only carries the persona; hoosh owns the inference.
    var sys = 0;
    if (seam_status(SEAM_AVATARA) == SEAM_NATIVE) { sys = persona_system_prompt(); }
    # project memory (0.12.0): the second system message when the memory seam is
    # not absent (local .thoth/memory reader, or mneme when it binds). ADR-0012.
    var mem = 0;
    if (seam_cap_state(SEAM_MEMORY) != CAP_ABSENT) { mem = memory_context(); }
    var want_stream = config_hoosh_stream();
    var multi = config_hoosh_history();
    _hoosh_acc_reset();
    intr_reset();      # 0.17.4: clear any stale Esc-interrupt flag at the start of the turn

    var len = 0;
    if (multi == 1) {
        session_history_append("user", prompt, strlen(prompt));
        len = hoosh_build_messages(_hoosh_req, model, sys, mem, want_stream);
    } else {
        len = hoosh_build_request(_hoosh_req, model, sys, mem, prompt, want_stream);
    }

    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }

    var rc = 0;
    if (want_stream == 1) { rc = _hoosh_stream_turn(url, h, len, model); }
    else { rc = _hoosh_blocking_turn(url, h, len, model); }

    if (multi == 1) {
        if ((rc == 0) && (_hoosh_acc_len > 0)) {
            session_history_append("assistant", _hoosh_acc, _hoosh_acc_len);
            sess_persist_save();          # 0.24.2: mirror to [session].file if resume is active
        } else {
            session_history_pop_last();   # roll back the unanswered user turn
        }
    }

    log_begin("hoosh_turn");
    log_kv_str("model", model);
    log_kv_int("stream", want_stream);
    log_kv_int("multi", multi);
    if (rc == 0) { log_kv_str("result", "ok"); log_commit(SK_INFO); }
    elif (rc < 0) { log_kv_str("result", "transport_error"); log_commit(SK_WARN); }
    else { log_kv_str("result", "http_error"); log_kv_int("status", rc); log_commit(SK_WARN); }
    hoosh_health_note(rc);                        # 0.19.3: this turn's transport outcome drives the health dot
    return rc;
}
