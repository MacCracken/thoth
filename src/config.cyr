# thoth — runtime config from thoth.cyml.
#
# thoth.cyml is a CYML file: a TOML header (the config), an optional markdown
# body (ignored here). It is NOT the build manifest (cyrius.cyml) — it is the
# driver's own runtime config, read once at startup. This is DRIVER config, not
# spine domain: it only tells thoth where the hoosh gateway lives.
#
# The presence of a [hoosh] `url` is what flips the hoosh seam from absent ->
# remote. No url declared, no remote claim — honest degradation, never faked.
# Values are copied to static cstrings (the parse buffers are transient).
#
# Example thoth.cyml:
#
#   [hoosh]
#   url   = "http://127.0.0.1:8088"
#   token = "secret"            # optional bearer; omit for an unauthenticated gateway
#   model = "claude-sonnet-4-6" # optional default model; omit to let hoosh route
#   ---
#   (markdown notes, ignored)

var _cfg_loaded = 0;
var _cfg_parse_ok = 0;       # 1 once config_load READ + parsed the file this call (regardless of whether a url was set); 0 = the file was unreadable — lets /reload degrade honestly (0.24.4)
var _cfg_hoosh_url = 0;      # cstring, or 0 if unset
var _cfg_hoosh_token = 0;    # cstring, or 0 if unset
var _cfg_hoosh_model = 0;    # cstring, or 0 if unset
var _cfg_hoosh_stream = 1;   # 1 = stream completions (default), 0 = blocking
var _cfg_hoosh_history = 1;  # 1 = multi-turn context (default), 0 = stateless
var _cfg_hoosh_tools = 1;    # 1 = agentic tool-calling when daimon wired (default), 0 = off
var _cfg_hoosh_max_iters = 0 - 1;   # agentic tool ROUNDS per turn; -1 = unset -> default (clamped in the getter)
var _cfg_hoosh_timeout_ms = 0 - 1;  # 0.44.2: [hoosh].timeout_ms — socket read/write deadline; -1 = unset -> default
var _cfg_hoosh_compact_at = 0 - 1;  # 0.40.0 (T1-5): auto-compact once session tokens cross this; -1/absent = off
var _cfg_redact_enabled = 1;        # 0.40.0 (T1-3): [redact].enabled — DEFAULT ON (see config_redact_enabled)
var _cfg_guard_enabled = 1;         # 0.41.0 (T2-3): [guard].enabled — DEFAULT ON (see config_guard_enabled)
var _cfg_toolpin_enabled = 1;       # 0.42.0 (T3): [toolpin].enabled — DEFAULT ON (see config_toolpin_enabled)
var _cfg_ask_enabled = 0;         # [ask].enabled — the ask_user tool (0.44.0); opt-in
var _cfg_subagent_enabled = 0;      # 0.43.0 (T2-1): [subagent].enabled — DEFAULT OFF (see config_subagent_enabled)
# 0.43.0 (T2-1): subagent depth — 0 = the parent's own turn, 1 = inside a delegation.
# Declared in config.cyr because it is the EARLIEST included file that all three readers come after:
# events.cyr stamps `depth` on a child's tool events, agent.cyr suppresses [verify] and withholds the
# delegate tool from a child, and subagent.cyr owns the transitions. A cyrius `var` is one flat namespace
# and a DUPLICATE declaration is silent, so it must live in exactly one place — here.
var _sub_depth = 0;

var SUB_MAX_ITERS_DEFAULT = 8;      # 0.43.0 (T2-1): rounds ONE child may spend; smaller than the parent's on purpose.
                                    # Declared here, not in subagent.cyr, because config_subagent_max_iters (below) reads it
                                    # and config.cyr is included first.
var _cfg_subagent_max_iters = 0 - 1;  # 0.43.0 (T2-1): [subagent].max_iters — unset sentinel; default+clamp in the getter
# [budget] — SPEND enforcement (0.44.3). thoth has had token/cost ACCOUNTING since 0.10.2 and no bound
# on it: nothing stopped a runaway loop, and delegation multiplies a turn's cost (ADR-0018 records that
# `[subagent].enabled` is off partly BECAUSE this did not exist). Both are session-cumulative ceilings;
# -1/absent/<=0 means unlimited, which is the default — a budget is opt-in, never a surprise cap.
var _cfg_budget_tokens = 0 - 1;      # [budget].max_tokens — prompt+completion tokens for the session
var _cfg_budget_cost_micro = 0 - 1;  # [budget].max_cost_micro — micro-USD (1_000_000 = $1) for the session
# 0.41.0 (T2-4): [hooks] — operator-configured commands fired at agent events. All unset (0) by default:
# a hook is arbitrary execution, so it exists only when the operator wrote one.
var _cfg_hook_session_start = 0;
var _cfg_hook_pre_tool = 0;
var _cfg_hook_post_tool = 0;
var _cfg_hook_session_end = 0;
var _cfg_hook_timeout_ms = 0 - 1;
var HOOK_CMD_CAP = 32768;           # composed "export K=..; <command>"; a hook longer than this is refused.
                                    # 0.43.2: 8192 was below the worst case it has to hold — THOTH_ARGS carries a tool
                                    # call of up to AGENT_ARGS_MAX (16383) bytes, so the env prefix alone could exceed it.
var HOOK_TIMEOUT_DEFAULT_MS = 15000;
var HOOK_TIMEOUT_MAX_MS = 120000;
var _cfg_verify_command = 0;        # 0.41.0 (T2-5): [verify].command — the project's own check; 0 = unset
var _cfg_verify_timeout_ms = 0 - 1; # 0.41.0 (T2-5): [verify].timeout_ms; -1 = unset -> default
var VERIFY_TIMEOUT_DEFAULT_MS = 120000;   # 2 min — a test suite is slower than a shell one-liner
var VERIFY_TIMEOUT_MAX_MS = 600000;       # 10 min ceiling; past that the turn has stopped being interactive
var _cfg_hoosh_parallel = 1; # 1 = run a round's tool calls concurrently (default), 0 = serial
var _cfg_hoosh_reasoning = 0;  # 0.35.2: [hoosh].reasoning effort level (0 = off, 1 = low, 2 = medium, 3 = high) -> reasoning_effort
var _cfg_hoosh_summarize = 0;  # 0.36.4: [hoosh].summarize — recap the byte-budget-skipped history (costs an extra small call)
var _cfg_daimon_url = 0;     # cstring, or 0 if unset (daimon seam stays absent)
var _cfg_tron_policy = 0;    # cstring path to a t-ron policy TOML, or 0
var _cfg_tron_agent = 0;     # cstring agent id for t-ron calls, or 0 -> default
var _cfg_log_file = 0;       # cstring path for structured driver logs, or 0
var _cfg_log_level = 0;      # cstring level (off/error/warn/info/debug/trace), or 0
var _cfg_history_file = 0;   # cstring path for the persistent INPUT-history file (0.11.2), or 0
var _cfg_session_file = 0;   # cstring path for the persistent CONVERSATION-history file (0.24.2), or 0
var _cfg_ui_bell = 0;        # [ui].bell — emit a BEL on turn completion (0.24.3); opt-in, default off
var _cfg_ui_elapsed = 0;     # [ui].elapsed — a faint per-turn elapsed line after each reply (0.24.3); opt-in, default off
# [ui].tier (0.43.2) — a durable presentation-tier preference. Until this release the tier was
# `--tier=` ONLY, and because the parser drops unknown keys without a word, a `tier = "simple"` line
# under [ui] did nothing and said nothing. It is the natural place to look for the setting, `--tier`
# already proves the concept, and argv still wins so scripts are unaffected.
var _cfg_ui_tier = 0;
var _cfg_ui_theme = 0;   # [ui].theme — 0 when unset; the startup theme (0.44.3)
var _cfg_memory_enabled = 0; # 1 = inject project-local .thoth/memory (0.12.0, opt-in); off by default
var _cfg_shell_enabled = 0;  # 1 = advertise the model-invokable `shell` tool (0.16.0, opt-in); off by default
var _cfg_edit_enabled = 0;   # 1 = advertise the model-invokable `edit` tool (0.31.0, opt-in); off by default (writing is consequential)
var HOOSH_MAX_ITERS_DEFAULT = 8;    # unchanged from the old hardcoded AGENT_MAX_ITERS — raising it is opt-in
var HOOSH_MAX_ITERS_CEILING = 200;  # each round is a full model call; a runaway loop spends the user's money
var _cfg_shell_timeout_ms = 0 - 1;  # per-command wall-clock timeout (ms); -1 = unset -> default (clamped in the getter)
var _cfg_shell_output_cap = 0 - 1;  # captured-output byte cap; -1 = unset -> default (clamped in the getter)
var _cfg_persona = 0;        # [persona].name — startup default archetype (0.22.0); 0 = unset -> egyptian_thoth
var _cfg_vidya = 0;          # [project].vidya — path to the vidya knowledge base, a first-class `/allow vidya` root (0.23.1); 0 = unset

# The legacy CWD config name — still read as a fallback (see config_path). 0.43.2: config_path now
# USES this rather than hardcoding the literal twice. It had been declared and never read, which in
# Cyrius (one flat global namespace, duplicate `var` silent) is a live collision hazard as well as a
# claim that the name was centrally defined when it was not.
var CONFIG_PATH = "thoth.cyml";
var HOOSH_URL_DEFAULT = "http://127.0.0.1:8088";

# --- config + memory home discovery (0.26.0) -------------------------------
# thoth's config + project memory live under a `.thoth/` HOME directory (like
# `.git/`): `.thoth/config.cyml` (this config) and `.thoth/memory/`. Discovery
# walks UP from the CWD for the nearest ancestor `.thoth/`, then falls back to
# `~/.thoth/` (a global user home); with no `.thoth/` anywhere, the legacy
# `./thoth.cyml` is still honored. Resolving the root ONCE and hanging BOTH config
# + memory off it keeps them consistent regardless of launch directory — the fix
# for "launched in another repo, couldn't find the gateway yet claimed READY".
var _thoth_root = 0;          # resolved `.thoth/` dir (cstr), or 0 if none
var _thoth_root_done = 0;
# 1 when _thoth_root_resolve fell back to $HOME/.thoth rather than finding one by walking up. Lets the
# memory layer know that "local" and "global" are the SAME directory, so it reads it once instead of
# injecting every fact twice — the exact test the config layer has no portable primitive for.
var _thoth_root_is_home = 0;
var _cfg_path_c = 0;          # cached resolved config-file path (cstr); set only once a file is FOUND
var _cfg_source = 0;          # 0 none · 1 <root>/config.cyml · 3 legacy ./thoth.cyml

# _cfg_join2: fresh cstr "a/b".
fn _cfg_join2(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 2);
    memcpy(out, a, la);
    store8(out + la, 47);                 # '/'
    memcpy(out + la + 1, b, lb);
    store8(out + la + 1 + lb, 0);
    return out;
}

# _cfg_updir: fresh cstr "../" repeated `lvl` times followed by `name`.
fn _cfg_updir(lvl, name) {
    var ln = strlen(name);
    var out = alloc(lvl * 3 + ln + 1);
    var off = 0;
    var i = 0;
    while (i < lvl) {
        store8(out + off, 46);            # '.'
        store8(out + off + 1, 46);        # '.'
        store8(out + off + 2, 47);        # '/'
        off = off + 3;
        i = i + 1;
    }
    memcpy(out + off, name, ln);
    store8(out + off + ln, 0);
    return out;
}

# _thoth_root_resolve: the `.thoth/` home dir (cstr) or 0. Walk up from CWD (up to
# 40 levels — deeper than any real tree), then ~/.thoth. Resolved once.
#
# ⚠ This answers "which `.thoth/` dir is THIS project's", and it is deliberately the FIRST `.thoth`
# DIRECTORY found — that is what checkpoints and the local memory store want. It is NOT how the config
# file is located any more; see _cfg_local_path, which walks for the FILE. The distinction matters: a
# `.thoth/` dir containing only `checkpoints/` (which is what running thoth from a subdirectory creates)
# used to stop the config search dead, so thoth reported "no config" in a repo that had one.
fn _thoth_root_resolve() {
    if (_thoth_root_done == 1) { return _thoth_root; }
    _thoth_root_done = 1;
    _thoth_root = 0;
    _thoth_root_is_home = 0;
    var lvl = 0;
    while (lvl < 40) {
        var cand = _cfg_updir(lvl, ".thoth");
        if (is_dir(str_from(cand)) == 1) {
            _thoth_root = cand;
            return _thoth_root;
        }
        lvl = lvl + 1;
    }
    var home = getenv("HOME");
    if (home != 0) {
        var hc = _cfg_join2(home, ".thoth");
        if (is_dir(str_from(hc)) == 1) { _thoth_root = hc; _thoth_root_is_home = 1; }
    }
    return _thoth_root;
}

# thoth_root_is_home: 1 when the resolved `.thoth/` home IS $HOME/.thoth (no project one was found).
fn thoth_root_is_home() { _thoth_root_resolve(); return _thoth_root_is_home; }

# --- THE TWO CONFIG LAYERS (0.43.3) --------------------------------------------
#
# `~/.thoth/config.cyml` is the GLOBAL base — the settings that follow the user between projects, the
# way every other tool with a dotfile home works. The nearest `.thoth/config.cyml` walking up from CWD
# is the LOCAL layer and wins PER KEY. Both are optional; either alone works.
#
# ⚠ WHY THE LOCAL SEARCH LOOKS FOR THE FILE, NOT THE DIRECTORY. Until 0.43.3 discovery found the first
# `.thoth` DIR and stopped, so a directory holding only `checkpoints/` or `memory/` shadowed every
# config above it AND blocked `~/.thoth` entirely. Since `src/checkpoint.cyr` writes a CWD-relative
# `.thoth/checkpoints/`, running thoth once from a subdirectory permanently hid that repo's own config
# from that subdirectory. Walking for `config.cyml` itself makes the search mean what it says.
var _cfg_gpath_c = 0;    # resolved ~/.thoth/config.cyml, or 0 (none) — cached
var _cfg_gpath_done = 0;
var _cfg_lpath_c = 0;    # resolved local layer (walk-up, then legacy ./thoth.cyml), or 0 — cached
var _cfg_lpath_done = 0;
var _cfg_lsource = 0;    # 0 none · 1 <dir>/.thoth/config.cyml · 3 legacy ./thoth.cyml

# _cfg_global_path: `$HOME/.thoth/config.cyml` if it exists, else 0.
fn _cfg_global_path() {
    if (_cfg_gpath_done == 1) { return _cfg_gpath_c; }
    _cfg_gpath_done = 1;
    _cfg_gpath_c = 0;
    var home = getenv("HOME");
    if (home != 0) {
        var hp = _cfg_join2(_cfg_join2(home, ".thoth"), "config.cyml");
        if (file_exists(hp) == 1) { _cfg_gpath_c = hp; }
    }
    return _cfg_gpath_c;
}

# _cfg_local_path: the nearest `.thoth/config.cyml` walking UP from CWD, else the legacy `./thoth.cyml`,
# else 0.
#
# ⚠ STATED LIMITATION, not a hidden one: when CWD is $HOME (or under it with no nearer config), the walk
# can reach `~/.thoth/config.cyml` and return it as the "local" layer as well as the global. There is no
# portable path-resolution primitive to detect that — the stdlib has no `getcwd`/`realpath` wrapper, and
# a raw `syscall(SYS_GETCWD, ...)` is exactly the portability claim aarch64 does not honour, so inventing
# one here would fork the floor to fix a label. It is harmless in BEHAVIOUR: layering a file over itself
# resolves every key to the same value, so the loaded config is identical either way. The only effect is
# that `/state` names the same path on both rows, which is odd-looking but true.
fn _cfg_local_path() {
    if (_cfg_lpath_done == 1) { return _cfg_lpath_c; }
    _cfg_lpath_done = 1;
    _cfg_lpath_c = 0;
    _cfg_lsource = 0;
    var lvl = 0;
    while (lvl < 40) {
        var cand = _cfg_join2(_cfg_updir(lvl, ".thoth"), "config.cyml");
        if (file_exists(cand) == 1) {
            _cfg_lpath_c = cand; _cfg_lsource = 1;
            return _cfg_lpath_c;
        }
        lvl = lvl + 1;
    }
    if (file_exists(CONFIG_PATH) == 1) { _cfg_lpath_c = CONFIG_PATH; _cfg_lsource = 3; }
    return _cfg_lpath_c;
}

# config_path: the config file a message should NAME — the local layer when there is one, else the
# global, else the preferred local path (for "not found" messages). Callers that need both layers use
# config_global_path() / config_local_path().
fn config_path() {
    if (_cfg_path_c != 0) { return _cfg_path_c; }
    var lp = _cfg_local_path();
    if (lp != 0) { _cfg_path_c = lp; _cfg_source = _cfg_lsource; return _cfg_path_c; }
    var gp = _cfg_global_path();
    if (gp != 0) { _cfg_path_c = gp; _cfg_source = 2; return _cfg_path_c; }
    _cfg_source = 0;
    var root = _thoth_root_resolve();
    if (root != 0) { return _cfg_join2(root, "config.cyml"); }
    return CONFIG_PATH;
}

fn config_global_path() { return _cfg_global_path(); }
fn config_local_path() { return _cfg_local_path(); }

# config_path_recheck: drop the cached resolution so the NEXT config_path() re-runs discovery. For
# /reload. Without it a session that started on the legacy ./thoth.cyml kept reading it even after the
# operator created the .thoth/config.cyml that /state had just told them to create — the cache made the
# advice unfollowable without a restart.
fn config_path_recheck() {
    _cfg_path_c = 0; _cfg_source = 0;
    _cfg_gpath_done = 0; _cfg_gpath_c = 0;      # 0.43.3: BOTH layers re-resolve, or /reload sees a stale pair
    _cfg_lpath_done = 0; _cfg_lpath_c = 0; _cfg_lsource = 0;
    return 0;
}

# config_source: 0 = none · 1 = a local .thoth/config.cyml · 2 = the GLOBAL ~/.thoth/config.cyml only
# · 3 = the legacy ./thoth.cyml. Describes the file config_path() names, not the whole layered set.
fn config_source() { config_path(); return _cfg_source; }

# config_root: the resolved `.thoth/` home dir (cstr) or 0 (none) — for /state.
fn config_root() { return _thoth_root_resolve(); }
var TRON_AGENT_DEFAULT = "thoth";

# Pricing table (0.10.3): each [pricing.<model>] section's input/output rate, cached
# at load time into a stable fixed table. The model id (the part after "pricing.") is
# kept as a stable cstring (str_cstr copies into the bump heap) so price-at-accumulate
# can look it up per turn WITHOUT retaining the transient parse buffers. Rates are
# micro-USD per 1000 tokens — i.e. (USD per 1M tokens) x 1000 — kept as -1 when unset.
var PRICE_MAX = 32;
var _price_models = 0;   # PRICE_MAX cstr ptrs (model id)
var _price_in = 0;       # PRICE_MAX i64 input rates  (micro-USD / 1K tokens), -1 unset
var _price_out = 0;      # PRICE_MAX i64 output rates (micro-USD / 1K tokens), -1 unset
var _price_n = 0;

# Alias table (0.11.4): the [alias] section's name = "expansion" pairs, cached at load
# into a stable fixed table (same shape as pricing). An alias lets the user define a slash
# macro: typing /<name> that is NOT a built-in expands to <expansion> (+ any trailing args)
# and re-dispatches. Names + expansions are stable cstrings (str_cstr copies into the bump
# heap) so the dispatcher can look them up per turn without retaining the transient parse
# buffers. First definition wins on a duplicate key; the table caps at ALIAS_MAX.
var ALIAS_MAX = 64;
var _alias_names = 0;    # ALIAS_MAX cstr ptrs (the alias name, no leading slash)
var _alias_vals = 0;     # ALIAS_MAX cstr ptrs (the expansion text, verbatim)
var _alias_n = 0;

# Shell tool guardrails (0.16.0): defaults + upper clamps for the [shell] scalars, and the
# deny/allow glob tables. Canonical form (0.20.3) is the natural TOML array under [shell] —
# `deny = ["glob", ...]` / `allow = ["glob", ...]` — read via bayan_toml_get_array (bayan 1.1.0).
# The legacy `[shell.deny]`/`[shell.allow]` SECTIONS of `label = "glob"` pairs (the key is a free
# label; the VALUE is the glob, iterated like _alias_load) remain a documented back-compat alias,
# used only when the array key is absent. Patterns are stable cstrings (str_cstr into the bump
# heap). These are a COARSE pre-filter matched with glob_match BEFORE the t-ron thoth_shell gate —
# a convenience speed-bump against obvious footguns, NOT a sandbox (a shell can cd / chain / decode).
var SHELL_TIMEOUT_DEFAULT_MS = 30000;    # 30s: lets a real build/test finish without hanging the loop
var SHELL_TIMEOUT_MAX_MS = 600000;       # 10min hard ceiling
var SHELL_OUT_DEFAULT = 65536;           # 64 KiB of captured output surfaced to the model
var SHELL_OUT_MAX = 1048576;             # 1 MiB hard ceiling
var SHELL_GLOB_MAX = 64;                 # max patterns per allow/deny table
var _shell_deny = 0;     # SHELL_GLOB_MAX cstr ptrs (deny glob patterns)
var _shell_deny_n = 0;
var _shell_allow = 0;    # SHELL_GLOB_MAX cstr ptrs (allow glob patterns)
var _shell_allow_n = 0;

# _cfg_section_pairs: the pairs vec for table [name] in a parsed sections vec,
# or 0 if the table is absent.
fn _cfg_section_pairs(sections, name) {
    if (sections == 0) { return 0; }      # 0.43.3: a layer that is absent/unreadable has no sections
    var secs = bayan_toml_get_sections(sections, name);
    if (vec_len(secs) == 0) { return 0; }
    return bayan_toml_section_pairs(vec_get(secs, 0));
}

# _cfg_str: read key from pairs as a stable cstring, or 0 if absent/empty.
fn _cfg_str(pairs, key) {
    if (pairs == 0) { return 0; }
    var v = bayan_toml_get(pairs, key);
    if (v == 0) { return 0; }
    if (str_len(v) == 0) { return 0; }
    return _cfg_unquote(str_cstr(v));
}

# _cfg_unquote: strip ONE matching pair of surrounding single quotes. 0.41.0.
#
# ⚠ TOML LITERAL STRINGS ('...') were reaching config consumers WITH THEIR QUOTES. Double-quoted basic
# strings are unquoted upstream; single-quoted literal strings are not, so `model = 'claude-opus-4-8'`
# produced a model id of `'claude-opus-4-8'` — quotes included — and the gateway 404'd on a name nobody
# could see was wrong. Single quotes are the natural choice for any value containing double quotes, which
# is exactly what a shell command in [hooks] or [verify] looks like, so the bug bites hardest on the keys
# most likely to use it: a `[hooks].pre_tool` written that way became an unrunnable command, and since a
# non-zero exit is how a pre_tool hook DENIES, it silently blocked every tool call in the session.
#
# Found by live-testing the 0.41.0 hooks against a real spine — the unit tests set the config vars
# directly and so never went through the parser. Fixed HERE rather than in bayan: this is thoth's own
# config surface, one function every string key already funnels through, and a parser change would need
# to be right for every other bayan consumer too.
#
# Only a MATCHING pair is stripped, and only when there are at least two bytes — so a value that merely
# starts or ends with a quote, or the single-character string "'", is left exactly as written.
fn _cfg_unquote(s) {
    if (s == 0) { return 0; }
    var n = strlen(s);
    if (n < 2) { return s; }
    if (load8(s) != 39) { return s; }
    if (load8(s + n - 1) != 39) { return s; }
    var d = alloc(n - 1);
    if (d == 0) { return s; }
    var i = 0;
    while (i < (n - 2)) { store8(d + i, load8(s + i + 1)); i = i + 1; }
    store8(d + n - 2, 0);
    return d;
}

# _cfg_bool: read a TOML bool key (the parser keeps `true`/`false` as literal
# text) as 1/0, returning `dflt` when absent or unrecognized. Pure.
fn _cfg_bool(pairs, key, dflt) {
    if (pairs == 0) { return dflt; }
    var v = bayan_toml_get(pairs, key);
    if (v == 0) { return dflt; }
    if (str_eq_cstr(v, "true") == 1) { return 1; }
    if (str_eq_cstr(v, "false") == 1) { return 0; }
    return dflt;
}

# --- LAYERED LOOKUP (0.43.3): local over global ---------------------------------
#
# Config is TWO files now: `~/.thoth/config.cyml` is the base and the nearest `.thoth/config.cyml`
# walking up from CWD layers ON TOP of it, PER KEY. These are the merge primitives; every scalar in
# config_load funnels through one of them, so the rule is stated in exactly one place:
#
#     a key set locally wins · else the global's value · else the built-in default
#
# ⚠ PRESENCE, NOT VALUE, IS THE TEST. `_cfg_bool` cannot distinguish "absent" from "explicitly set to
# the default", so layering on its return would make a local `stream = true` indistinguishable from no
# local `stream` at all — and the global's `stream = false` would then leak through a local file that
# deliberately turned streaming back on. `_cfg_has` asks the parser whether the key is there.
fn _cfg_has(pairs, key) {
    if (pairs == 0) { return 0; }
    if (bayan_toml_get(pairs, key) == 0) { return 0; }
    return 1;
}

# _cfg2_str / _cfg2_bool / _cfg2_int: read `key` from the LOCAL pairs, falling back to the GLOBAL pairs.
# `l`/`g` are the same section's pairs from each layer (either may be 0 when that layer has no such
# table). Pure.
fn _cfg2_str(l, g, key) {
    var v = _cfg_str(l, key);
    if (v != 0) { return v; }
    return _cfg_str(g, key);
}
fn _cfg2_bool(l, g, key, dflt) {
    if (_cfg_has(l, key) == 1) { return _cfg_bool(l, key, dflt); }
    if (_cfg_has(g, key) == 1) { return _cfg_bool(g, key, dflt); }
    return dflt;
}
fn _cfg2_int(l, g, key) {
    if (_cfg_has(l, key) == 1) { return _cfg_int(l, key); }
    if (_cfg_has(g, key) == 1) { return _cfg_int(g, key); }
    return 0 - 1;
}

# --- 0.44.3: AUTHORITY-GRANTING KEYS ARE GLOBAL-ONLY ---------------------------------------------
#
# ⭐ THE HOLE THIS CLOSES. ADR-0019 stated the rule correctly — *authority does not accumulate from the
# less-trusted side* — and then enforced it for exactly TWO keys, both lists (`[shell].allow`,
# `[project].read_roots`). Every authority-granting SCALAR was left on the ordinary
# local-overrides-global path. thoth's local layer is `<repo>/.thoth/config.cyml`, found by walking up
# from CWD, and **a `git clone` reproduces that file**. So opening thoth in a repository someone else
# wrote meant, before this release:
#
#   * `[hooks].session_start = "curl … | sh"` — ARBITRARY CODE, executed at launch, before the operator
#     has typed anything. `src/hooks.cyr`'s own header says "hooks come from the OPERATOR'S CONFIG and
#     nowhere else"; that premise was true when written and false the moment config gained a second
#     layer. `[hooks].pre_tool` and `[verify].command` are the same primitive on a later trigger.
#   * `[hoosh].url` pointed at an attacker host while `[hoosh].token` was inherited from the operator's
#     GLOBAL config — thoth posting the operator's own bearer token to a host the repo chose.
#   * `[tron].policy` replaced wholesale: the repo supplies the security policy that authorizes the
#     model's tool calls, while `[shell].enabled` is inherited from the global.
#   * `[session].file` / `[history].file` / `[log].file` are UNJAILED write sinks — thoth truncates and
#     overwrites whatever path they name, anywhere the operator can write.
#
# THE RULE. A key that grants authority is read from the GLOBAL layer only. A local layer that sets one
# is not silently obeyed and not silently ignored either — it is NAMED, on stderr at startup, in the
# greeting, in `/state` and on `/reload`, exactly like an unrecognised key. The local layer keeps
# everything that only expresses preference (model, tier, theme, aliases, pricing, caps, toggles).
#
# ⚠ THIS IS A DELIBERATE BEHAVIOUR CHANGE AGAINST ADR-0019's OWN EXAMPLE, which offered "a project
# t-ron policy" as a thing the local layer may set. That example cannot be honoured safely: thoth
# cannot tell your repository from a cloned one, and the strict reading of the ADR's own principle wins
# over its illustration. The escape hatch — per-repo trust, so you can approve your OWN project's hooks
# once — is a real feature and a real decision; it is recorded as follow-up rather than guessed at here.
var CFG_SUPPRESS_MAX = 16;
var _cfg_suppressed = 0;        # CFG_SUPPRESS_MAX cstr ptrs (authority keys the local layer tried to set)
var _cfg_suppressed_n = 0;
fn config_suppressed_count() { return _cfg_suppressed_n; }
fn config_suppressed_at(i) {
    if (i < 0) { return ""; }
    if (i >= _cfg_suppressed_n) { return ""; }
    return load64(_cfg_suppressed + i * 8);
}
fn _cfg_note_suppressed(what) {
    if (_cfg_suppressed == 0) { _cfg_suppressed = alloc(CFG_SUPPRESS_MAX * 8); }
    if (_cfg_suppressed == 0) { return 0; }
    var i = 0;
    while (i < _cfg_suppressed_n) {
        if (streq(load64(_cfg_suppressed + i * 8), what) == 1) { return 0; }
        i = i + 1;
    }
    if (_cfg_suppressed_n >= CFG_SUPPRESS_MAX) { return 0; }
    store64(_cfg_suppressed + _cfg_suppressed_n * 8, what);
    _cfg_suppressed_n = _cfg_suppressed_n + 1;
    return 0;
}

# _cfg2_str_global_only: the authority-key reader. The LOCAL layer is consulted only to find out whether
# it TRIED to set the key, so the attempt can be reported; the VALUE always comes from the global layer
# (or the built-in default when the global is silent too).
fn _cfg2_str_global_only(l, g, key, label) {
    var gv = _cfg_str(g, key);
    if (_cfg_has(l, key) == 1) {
        # ⚠ REPORT AN ESCALATION, NOT AN AGREEMENT. A local layer that names the SAME value the global
        # already grants has asked for nothing — that is the ordinary shape of a project config written
        # by the machine's own owner, who copied their global settings into the repo. Flagging it trains
        # the operator to ignore this line, which is the exact failure the 0.43.5 unknown-key checker
        # exists to avoid; and the line has to stay loud, because when it DOES fire it means a file
        # someone else may have written asked to run commands as you. Differing value, or no global
        # value at all, is the real case and is always reported.
        var lv = _cfg_str(l, key);
        var same = 0;
        if ((lv != 0) && (gv != 0)) { if (streq(lv, gv) == 1) { same = 1; } }
        if (same == 0) { _cfg_note_suppressed(label); }
    }
    return gv;
}

# _cfg_int: read key from pairs as a non-negative integer, or -1 when absent, empty,
# or non-numeric (decimal digits only — pricing rates are whole micro-USD/1K). Pure.
fn _cfg_int(pairs, key) {
    if (pairs == 0) { return 0 - 1; }
    var v = bayan_toml_get(pairs, key);
    if (v == 0) { return 0 - 1; }
    var d = str_data(v);
    var n = str_len(v);
    if (n == 0) { return 0 - 1; }
    var acc = 0;
    var i = 0;
    while (i < n) {
        var ch = load8(d + i);
        if ((ch < 48) || (ch > 57)) { return 0 - 1; }   # any non-digit -> reject
        acc = acc * 10 + (ch - 48);
        i = i + 1;
    }
    return acc;
}

# _price_load: scan the parsed sections for [pricing.<model>] tables and cache each
# model's input/output rate into the stable fixed table (capped at PRICE_MAX). The
# section name is matched verbatim (bayan keeps the raw bracket text), so a model id
# with dots or dashes works. Called once from config_load.
fn _price_load(sections) {
    if (_price_models == 0) {
        _price_models = alloc(PRICE_MAX * 8);
        _price_in = alloc(PRICE_MAX * 8);
        _price_out = alloc(PRICE_MAX * 8);
    }
    _price_n = 0;
    return _price_append(sections);
}

# _price_load2 (0.43.3): both layers, LOCAL FIRST — a project [pricing.<model>] overrides the global rate
# for that model while every other global rate still applies. The append core skips a model already
# stored, which also fixes a pre-existing wart: two [pricing.x] sections in ONE file used to store both.
fn _price_load2(lo, gl) {
    if (_price_models == 0) {
        _price_models = alloc(PRICE_MAX * 8);
        _price_in = alloc(PRICE_MAX * 8);
        _price_out = alloc(PRICE_MAX * 8);
    }
    _price_n = 0;
    _price_append(lo);
    _price_append(gl);
    return 0;
}

fn _price_append(sections) {
    if (sections == 0) { return 0; }
    var n = vec_len(sections);
    var i = 0;
    while (i < n) {
        var sec = vec_get(sections, i);
        var nm = str_cstr(bayan_toml_section_name(sec));   # stable copy (bump heap)
        if ((cstr_starts_with(nm, "pricing.") == 1) && (_price_n < PRICE_MAX)) {
            var mid = nm + 8;                                # model id = past "pricing."
            var dup = 0;
            var j = 0;
            while (j < _price_n) {
                if (streq(load64(_price_models + j * 8), mid) == 1) { dup = 1; }
                j = j + 1;
            }
            if (dup == 0) {
                var prs = bayan_toml_section_pairs(sec);
                store64(_price_models + _price_n * 8, mid);
                store64(_price_in + _price_n * 8, _cfg_int(prs, "input"));
                store64(_price_out + _price_n * 8, _cfg_int(prs, "output"));
                _price_n = _price_n + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# _price_idx: the table index for model, or -1 if no [pricing.<model>] was declared.
fn _price_idx(model) {
    var i = 0;
    while (i < _price_n) {
        if (streq(load64(_price_models + i * 8), model) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# config_price_input / config_price_output: the [pricing.<model>] rate (micro-USD per
# 1000 tokens) for model, or -1 when no rate is declared for it (cost stays unpriced
# for that model — honest-omit, ADR-0010). thoth multiplies; hoosh owns the numbers.
fn config_price_input(model) {
    var idx = _price_idx(model);
    if (idx < 0) { return 0 - 1; }
    return load64(_price_in + idx * 8);
}
fn config_price_output(model) {
    var idx = _price_idx(model);
    if (idx < 0) { return 0 - 1; }
    return load64(_price_out + idx * 8);
}

# _alias_load: cache the [alias] section's name = "expansion" pairs into the stable fixed
# table (capped at ALIAS_MAX). Iterates the pairs vec directly (bayan_toml_pair_key/_value
# give the raw Str); a blank name OR blank value is skipped (an alias must name and expand
# to something). First definition wins (we keep the first, skip later duplicates implicitly
# via lookup order). Called once from config_load.
fn _alias_load(sections) {
    if (_alias_names == 0) {
        _alias_names = alloc(ALIAS_MAX * 8);
        _alias_vals = alloc(ALIAS_MAX * 8);
    }
    _alias_n = 0;
    return _alias_append(sections);
}

# _alias_load2 (0.43.3): both layers, LOCAL FIRST. The append core already skips a name it has seen, so
# appending the global afterwards means a project alias shadows a global one of the same name while every
# other global alias still resolves — which is the whole point of layering.
fn _alias_load2(lo, gl) {
    if (_alias_names == 0) {
        _alias_names = alloc(ALIAS_MAX * 8);
        _alias_vals = alloc(ALIAS_MAX * 8);
    }
    _alias_n = 0;
    _alias_append(lo);
    _alias_append(gl);
    return 0;
}

fn _alias_append(sections) {
    var pairs = _cfg_section_pairs(sections, "alias");
    if (pairs == 0) { return 0; }
    var n = vec_len(pairs);
    var i = 0;
    while (i < n) {
        if (_alias_n < ALIAS_MAX) {
            var p = vec_get(pairs, i);
            var k = bayan_toml_pair_key(p);
            var v = bayan_toml_pair_value(p);
            # A name >= 256 bytes can never match: the TUI name-extraction caps the typed
            # token at 255 (ALIAS_NAME_CAP-1 in commands.cyr), so an over-cap name would be a
            # dead, unmatchable entry inflating the count — skip it at load (the example doc
            # promises "at most 255 chars"; this enforces it). 256 == ALIAS_NAME_CAP.
            if ((str_len(k) > 0) && (str_len(v) > 0) && (str_len(k) < 256)) {
                # first definition wins: skip a name already stored (bayan keeps both
                # pairs of a duplicate key; we keep the first so the count is honest).
                var dup = 0;
                var j = 0;
                while (j < _alias_n) {
                    if (str_eq_cstr(k, load64(_alias_names + j * 8)) == 1) { dup = 1; }
                    j = j + 1;
                }
                if (dup == 0) {
                    store64(_alias_names + _alias_n * 8, str_cstr(k));   # stable copy (bump heap)
                    store64(_alias_vals + _alias_n * 8, str_cstr(v));
                    _alias_n = _alias_n + 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# config_alias_lookup: the expansion cstring for the alias `name` (the bare token, no
# slash), or 0 if no [alias] declares it. First-match (so a duplicate key uses the first
# definition). Pure lookup; the dispatcher owns the expand-then-redispatch.
fn config_alias_lookup(name) {
    var i = 0;
    while (i < _alias_n) {
        if (streq(load64(_alias_names + i * 8), name) == 1) { return load64(_alias_vals + i * 8); }
        i = i + 1;
    }
    return 0;
}

# config_alias_count: how many aliases are defined (0 -> the feature is dormant and the
# CMD_UNKNOWN_SLASH path is byte-identical to a build with no [alias] support).
fn config_alias_count() { return _alias_n; }

# _shell_glob_table_load: fill `tbl` (SHELL_GLOB_MAX cstr slots) from a [shell.deny]/[shell.allow]
# section's pairs, taking each pair's VALUE as the glob pattern (the key is an arbitrary label).
# Blank values are skipped; the table caps at SHELL_GLOB_MAX. Returns the count. Same section-of-
# pairs shape as _alias_load; patterns are stable str_cstr copies (bump heap).
fn _shell_glob_table_load(pairs, tbl) {
    if (pairs == 0) { return 0; }
    var n = vec_len(pairs);
    var i = 0;
    var c = 0;
    while (i < n) {
        if (c < SHELL_GLOB_MAX) {
            var p = vec_get(pairs, i);
            var v = bayan_toml_pair_value(p);
            if (str_len(v) > 0) {
                store64(tbl + c * 8, str_cstr(v));
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return c;
}

# _shell_glob_array_load: fill `tbl` (SHELL_GLOB_MAX cstr slots) from an array-VALUE vec — the
# canonical `deny = ["glob", ...]` / `allow = [...]` form (0.20.3). Each element Str is already
# quote-stripped by bayan_toml_get_array; blank elements are skipped and the table caps at
# SHELL_GLOB_MAX. Returns the count. Patterns are stable str_cstr copies (bump heap). Mirrors
# _shell_glob_table_load but iterates array elements (Strs) instead of section pairs.
fn _shell_glob_array_load(arr, tbl) {
    if (arr == 0) { return 0; }
    var n = vec_len(arr);
    var i = 0;
    var c = 0;
    while (i < n) {
        if (c < SHELL_GLOB_MAX) {
            var v = vec_get(arr, i);
            if (str_len(v) > 0) {
                store64(tbl + c * 8, str_cstr(v));
                c = c + 1;
            }
        }
        i = i + 1;
    }
    return c;
}

# _shell_glob_key_load: load the deny/allow globs for `key` from the [shell] pairs into `tbl`.
# Returns the pattern count when `key` is PRESENT, or -1 when ABSENT (caller then falls back to
# the legacy section form). An array value is the canonical form; a bare scalar string is accepted
# leniently as a SINGLE pattern (so `deny = "*rm -rf*"` — brackets forgotten — never silently
# drops to zero patterns, which on a deny-list would be a footgun); an explicit empty array `[]`
# or empty string is present-with-zero (and does NOT fall through to a section).
fn _shell_glob_key_load(shell, key, tbl) {
    if (shell == 0) { return 0 - 1; }
    var v = bayan_toml_get(shell, key);
    if (v == 0) { return 0 - 1; }                 # key absent -> fall back to the section form
    if (bayan_toml_is_array(v) == 1) {
        return _shell_glob_array_load(bayan_toml_array_parse(v), tbl);
    }
    if (str_len(v) > 0) {                          # bare scalar string -> one glob
        store64(tbl, str_cstr(v));
        return 1;
    }
    return 0;                                       # present but empty scalar -> zero patterns
}

# _cfg_read_roots_load: grant the [project] read_roots at startup (0.23.1). Accepts the canonical array form
# `read_roots = ["/abs/a", "/abs/b"]` and, leniently, a bare scalar string as a single root. Each element is
# handed to project_grant_root, which enforces the absolute-and-not-"/" rule (non-absolute or over-cap entries
# are silently skipped there). Config roots are a PERSISTENT user grant (the user chose to put them in the
# config), exactly like [shell].enabled. Returns the number of grant attempts made.
# _cfg_read_roots_load2 (0.43.3): the read JAIL, and the one place layering must NOT be additive.
#
# ⚠ STRICTEST WINS. `read_roots` grants the model read access outside the launch directory. If the two
# layers unioned, a repo you cloned could widen your global jail just by appending a path to its own
# config — authority accumulating from the LESS-trusted side, which is the wrong direction. So the local
# layer REPLACES the global's list when it declares one, and inherits it untouched when it does not.
# Whichever file is in charge, the resulting jail is exactly the list one file states.
fn _cfg_read_roots_load2(proj_l, proj_g) {
    if (proj_l != 0) {
        if (bayan_toml_get(proj_l, "read_roots") != 0) { return _cfg_read_roots_load(proj_l); }
    }
    return _cfg_read_roots_load(proj_g);
}

fn _cfg_read_roots_load(project) {
    if (project == 0) { return 0; }
    var v = bayan_toml_get(project, "read_roots");
    if (v == 0) { return 0; }
    if (bayan_toml_is_array(v) == 0) {
        if (str_len(v) > 0) { project_grant_root(str_cstr(v)); return 1; }   # bare scalar -> one root
        return 0;
    }
    var arr = bayan_toml_array_parse(v);
    if (arr == 0) { return 0; }
    var n = vec_len(arr);
    var i = 0;
    var c = 0;
    while (i < n) {
        var e = vec_get(arr, i);
        if (str_len(e) > 0) { project_grant_root(str_cstr(e)); c = c + 1; }
        i = i + 1;
    }
    return c;
}

# _shell_globs_load: cache the deny/allow glob tables. The canonical array form
# (`[shell] deny = ["…"] / allow = ["…"]`) wins when its key is PRESENT — even an explicit empty
# array `deny = []` means "no deny patterns" and does NOT fall through. When the array key is
# ABSENT, falls back to the legacy `[shell.deny]`/`[shell.allow]` `label = "glob"` sections (a
# documented back-compat alias). `shell` = the [shell] pairs (for the array form; may be 0);
# `sections` = the full parse (for the section fallback). With neither present both counts are 0.
var _shell_scratch = 0;   # SHELL_GLOB_MAX cstr ptrs — staging for the global layer's globs

# _shell_globs_load2 (0.43.3): deny UNIONS across both layers, allow does NOT.
#
# ⚠ THE ASYMMETRY IS THE POINT, and it is the same rule as read_roots. A deny-list only ever REMOVES
# authority, so merging both layers can only make the filter stricter — a project may add denies and can
# never drop the ones the user set globally. An allow-list GRANTS authority, so unioning would let a
# cloned repo widen what the user's global config permits by appending one glob. The local layer
# therefore replaces `allow` wholesale when it declares one, and inherits the global's when it does not.
#
# (Both lists remain a COARSE pre-filter matched before the t-ron thoth_shell gate — not a sandbox. This
# makes the pre-filter honest across two files; it does not make it a boundary.)
fn _shell_globs_load2(sh_l, lo, sh_g, gl) {
    if (_shell_deny == 0) { _shell_deny = alloc(SHELL_GLOB_MAX * 8); }
    if (_shell_allow == 0) { _shell_allow = alloc(SHELL_GLOB_MAX * 8); }
    if (_shell_scratch == 0) { _shell_scratch = alloc(SHELL_GLOB_MAX * 8); }

    # deny := GLOBAL denies first, then every local deny not already present.
    #
    # ⚠ 0.44.3 — THE ORDER IS THE SECURITY PROPERTY. This used to fill the table with the LOCAL denies
    # and then append the global ones "if there is room", so a local layer declaring SHELL_GLOB_MAX (64)
    # patterns of its own filled the table and every one of the operator's global denies was silently
    # dropped. A `git clone` reproduces `<repo>/.thoth/config.cyml`, so that is an untrusted file
    # DELETING the operator's deny-list — precisely the inversion ADR-0019 forbids ("a deny only removes
    # authority, so merging can only tighten"). Filling from the trusted side first makes the overflow
    # drop LOCAL entries, which is the fail-safe direction, and the drop is announced rather than silent.
    var dn = _shell_glob_decl(sh_g, gl, "deny", _shell_deny);
    if (dn < 0) { dn = 0; }
    var ln = _shell_glob_decl(sh_l, lo, "deny", _shell_scratch);
    if (ln < 0) { ln = 0; }
    var dropped = 0;
    var i = 0;
    while (i < ln) {
        var g = load64(_shell_scratch + i * 8);
        var dup = 0;
        var j = 0;
        while (j < dn) {
            if (streq(load64(_shell_deny + j * 8), g) == 1) { dup = 1; }
            j = j + 1;
        }
        if (dup == 0) {
            if (dn < SHELL_GLOB_MAX) { store64(_shell_deny + dn * 8, g); dn = dn + 1; }
            else { dropped = dropped + 1; }
        }
        i = i + 1;
    }
    if (dropped > 0) { _cfg_note_suppressed("shell.deny (local patterns dropped: the merged deny-list is full)"); }
    _shell_deny_n = dn;

    # allow := the LOCAL list if the local layer DECLARES one, else the global's. Never both.
    var an = _shell_glob_decl(sh_l, lo, "allow", _shell_allow);
    if (an < 0) { an = _shell_glob_decl(sh_g, gl, "allow", _shell_allow); }
    if (an < 0) { an = 0; }
    _shell_allow_n = an;
    return 0;
}

# _shell_glob_decl: read ONE layer's glob list for `key` into `tbl`, honouring both the canonical array
# form under [shell] and the legacy [shell.<key>] label section. Returns the count, or -1 when that layer
# DECLARES NEITHER.
#
# ⚠ -1 and 0 are different answers and the distinction is load-bearing. `_shell_glob_table_load` answers
# 0 for an absent section, which reads identically to "declared, and empty" — so a chain built on it
# would treat a local layer that says nothing about `allow` as a local layer that allows NOTHING, and
# never consult the global. An explicitly empty list must stay empty; an absent one must fall through.
fn _shell_glob_decl(sect, sections, key, tbl) {
    var n = _shell_glob_key_load(sect, key, tbl);
    if (n >= 0) { return n; }
    var nm = "shell.deny";
    if (streq(key, "allow") == 1) { nm = "shell.allow"; }
    var legacy = _cfg_section_pairs(sections, nm);
    if (legacy == 0) { return 0 - 1; }
    return _shell_glob_table_load(legacy, tbl);
}

fn _shell_globs_load(shell, sections) {
    if (_shell_deny == 0) { _shell_deny = alloc(SHELL_GLOB_MAX * 8); }
    if (_shell_allow == 0) { _shell_allow = alloc(SHELL_GLOB_MAX * 8); }
    var dn = _shell_glob_key_load(shell, "deny", _shell_deny);
    if (dn < 0) { dn = _shell_glob_table_load(_cfg_section_pairs(sections, "shell.deny"), _shell_deny); }
    _shell_deny_n = dn;
    var an = _shell_glob_key_load(shell, "allow", _shell_allow);
    if (an < 0) { an = _shell_glob_table_load(_cfg_section_pairs(sections, "shell.allow"), _shell_allow); }
    _shell_allow_n = an;
    return 0;
}

# config_load: parse thoth.cyml if present and populate the hoosh fields.
# Returns 1 if a [hoosh] url was found (seam can bind remote), else 0 (absent
# file, no [hoosh] table, or no url -> seam stays absent). Call once at startup.
# --- UNKNOWN-KEY DETECTION (0.43.5) -------------------------------------------
#
# ⚠ THE PARSER DROPS WHAT IT DOES NOT RECOGNISE, AND THAT SILENCE HAS COST REAL TIME TWICE IN TWO DAYS:
# a `tier = "simple"` under [ui] did nothing before 0.43.2 made the key live, and `max-iter = 200`
# (correct name: `max_iters`) left the agentic loop capped at 8 while the operator believed it was 200 —
# presenting as "the agent gives up after 8 rounds" with nothing anywhere to suggest the config was at
# fault. A typo in a config file must never be indistinguishable from not having written the line.
#
# So every key in a known table is checked against that table's inventory, and every unknown one is
# COLLECTED and ANNOUNCED. This is a spell-checker, not a validator: it never refuses to load, never
# changes a value, and an unknown key still behaves exactly as before. It only breaks the silence.
var CFG_UNKNOWN_MAX = 16;
var _cfg_unknown = 0;        # CFG_UNKNOWN_MAX cstr ptrs ("<section>.<key>")
var _cfg_unknown_n = 0;
fn config_unknown_count() { return _cfg_unknown_n; }
fn config_unknown_at(i) {
    if (i < 0) { return 0; }
    if (i >= _cfg_unknown_n) { return 0; }
    return load64(_cfg_unknown + i * 8);
}

# _cfg_known_key: 1 if `key` is a recognised key of table `sec`. Tables whose keys are user-chosen
# ([alias], the legacy [shell.deny]/[shell.allow] label sections) answer 1 for anything.
fn _cfg_known_key(sec, key) {
    if (streq(sec, "alias") == 1) { return 1; }
    if (streq(sec, "shell.deny") == 1) { return 1; }
    if (streq(sec, "shell.allow") == 1) { return 1; }
    if (cstr_starts_with(sec, "pricing.") == 1) {
        if (streq(key, "input") == 1) { return 1; }
        if (streq(key, "output") == 1) { return 1; }
        return 0;
    }
    if (streq(sec, "hoosh") == 1) {
        if (streq(key, "url") == 1) { return 1; }
        if (streq(key, "token") == 1) { return 1; }
        if (streq(key, "model") == 1) { return 1; }
        if (streq(key, "stream") == 1) { return 1; }
        if (streq(key, "history") == 1) { return 1; }
        if (streq(key, "tools") == 1) { return 1; }
        if (streq(key, "max_iters") == 1) { return 1; }
        if (streq(key, "timeout_ms") == 1) { return 1; }
        if (streq(key, "compact_at") == 1) { return 1; }
        if (streq(key, "parallel") == 1) { return 1; }
        if (streq(key, "reasoning") == 1) { return 1; }
        if (streq(key, "summarize") == 1) { return 1; }
        return 0;
    }
    if (streq(sec, "daimon") == 1) { return streq(key, "url"); }
    if (streq(sec, "tron") == 1) {
        if (streq(key, "policy") == 1) { return 1; }
        return streq(key, "agent");
    }
    if (streq(sec, "log") == 1) {
        if (streq(key, "file") == 1) { return 1; }
        return streq(key, "level");
    }
    if (streq(sec, "history") == 1) { return streq(key, "file"); }
    if (streq(sec, "session") == 1) { return streq(key, "file"); }
    if (streq(sec, "ui") == 1) {
        if (streq(key, "bell") == 1) { return 1; }
        if (streq(key, "elapsed") == 1) { return 1; }
        if (streq(key, "tier") == 1) { return 1; }
        return streq(key, "theme");
    }
    if (streq(sec, "memory") == 1) { return streq(key, "enabled"); }
    if (streq(sec, "persona") == 1) { return streq(key, "name"); }
    if (streq(sec, "project") == 1) {
        if (streq(key, "vidya") == 1) { return 1; }
        return streq(key, "read_roots");
    }
    if (streq(sec, "hooks") == 1) {
        if (streq(key, "session_start") == 1) { return 1; }
        if (streq(key, "pre_tool") == 1) { return 1; }
        if (streq(key, "post_tool") == 1) { return 1; }
        if (streq(key, "session_end") == 1) { return 1; }
        return streq(key, "timeout_ms");
    }
    if (streq(sec, "toolpin") == 1) { return streq(key, "enabled"); }
    if (streq(sec, "subagent") == 1) {
        if (streq(key, "enabled") == 1) { return 1; }
        return streq(key, "max_iters");
    }
    if (streq(sec, "guard") == 1) { return streq(key, "enabled"); }
    if (streq(sec, "verify") == 1) {
        if (streq(key, "command") == 1) { return 1; }
        return streq(key, "timeout_ms");
    }
    if (streq(sec, "redact") == 1) { return streq(key, "enabled"); }
    if (streq(sec, "shell") == 1) {
        if (streq(key, "enabled") == 1) { return 1; }
        if (streq(key, "timeout_ms") == 1) { return 1; }
        if (streq(key, "max_output") == 1) { return 1; }
        if (streq(key, "deny") == 1) { return 1; }
        return streq(key, "allow");
    }
    if (streq(sec, "ask") == 1) { return streq(key, "enabled"); }
    if (streq(sec, "budget") == 1) {
        if (streq(key, "max_tokens") == 1) { return 1; }
        return streq(key, "max_cost_micro");
    }
    if (streq(sec, "edit") == 1) { return streq(key, "enabled"); }
    return 0 - 1;                      # the SECTION itself is unrecognised
}

# _cfg_note_unknown: record "<what>" (already a stable cstr) once, up to the cap.
fn _cfg_note_unknown(what) {
    if (_cfg_unknown == 0) { _cfg_unknown = alloc(CFG_UNKNOWN_MAX * 8); }
    if (_cfg_unknown == 0) { return 0; }
    var i = 0;
    while (i < _cfg_unknown_n) {
        if (streq(load64(_cfg_unknown + i * 8), what) == 1) { return 0; }   # already noted (both layers)
        i = i + 1;
    }
    if (_cfg_unknown_n >= CFG_UNKNOWN_MAX) { return 0; }
    store64(_cfg_unknown + _cfg_unknown_n * 8, what);
    _cfg_unknown_n = _cfg_unknown_n + 1;
    return 0;
}

# _cfg_scan_unknown: walk every section/key of ONE parsed layer and note what is not recognised.
#
# ⚠ 0.44.3 — THE ROOT SECTION IS NOT A TABLE. bayan's TOML parser returns an unnamed section holding
# the keys written BEFORE the first `[table]` header, and as of the parser rewrite carried by cyrius
# 6.5.43 it pushes that section UNCONDITIONALLY — empty — for every document, where the older parser
# pushed it only `if (vec_len(cur_pairs) > 0)`. Read as an ordinary table, its empty name is not a
# recognised one, so the checker reported a phantom `.*` unrecognised key for EVERY config file thoth
# loaded: on stderr at startup, in the greeting, in `/state` and on `/reload`. A spell-checker that
# cries wolf on a perfectly valid file is worse than none — it teaches the operator to ignore it, which
# is the exact silence 0.43.5 exists to break. The empty root is skipped; a root that actually HOLDS
# keys is still reported, by bare name, because every key in thoth's config surface lives inside a
# table and one written outside any of them is a real mistake.
fn _cfg_scan_unknown(sections) {
    if (sections == 0) { return 0; }
    var n = vec_len(sections);
    var i = 0;
    while (i < n) {
        var sec = vec_get(sections, i);
        var nm = str_cstr(bayan_toml_section_name(sec));
        var pairs = bayan_toml_section_pairs(sec);
        var pn = vec_len(pairs);
        if (load8(nm) == 0) {
            # The root section. Empty (the common case) => nothing to check. Non-empty => name each
            # stray key on its own; `str_cstr` is a stable bump-heap copy (same guarantee _price_append
            # relies on), so the pointer outlives this frame.
            var jr = 0;
            while (jr < pn) {
                _cfg_note_unknown(str_cstr(bayan_toml_pair_key(vec_get(pairs, jr))));
                jr = jr + 1;
            }
        } elif (_cfg_known_key(nm, "") == (0 - 1)) {
            _cfg_note_unknown(_cfg_join_dot(nm, "*"));       # whole table unrecognised
        } else {
            var j = 0;
            while (j < pn) {
                var k = str_cstr(bayan_toml_pair_key(vec_get(pairs, j)));
                if (_cfg_known_key(nm, k) == 0) { _cfg_note_unknown(_cfg_join_dot(nm, k)); }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# _cfg_join_dot: fresh "a.b" cstr (the bump heap keeps it stable for the session).
fn _cfg_join_dot(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    var out = alloc(la + lb + 2);
    memcpy(out, a, la);
    store8(out + la, 46);
    memcpy(out + la + 1, b, lb);
    store8(out + la + 1 + lb, 0);
    return out;
}

# _cfg_parse_sections: parse one config file into a TOML sections vec, or 0 when absent/unreadable.
# Sets `_cfg_parse_any` when a file actually parsed, so config_parse_ok() still answers "a config was
# read" for EITHER layer.
var _cfg_parse_any = 0;
fn _cfg_parse_sections(path) {
    if (path == 0) { return 0; }
    var r = bayan_cyml_parse_file_r(path);
    if (is_err_result(r) == 1) { return 0; }
    var doc = load64(r + 8);
    var hp = bayan_cyml_doc_header(doc);
    var hl = bayan_cyml_doc_header_len(doc);
    _cfg_parse_any = 1;
    return bayan_toml_parse(str_new(hp, hl));
}

# config_load: read BOTH layers and resolve every key as `local, else global, else built-in default`.
#
# 0.43.3 — THE GLOBAL LAYER. `~/.thoth/config.cyml` is the base a user carries between projects, the
# way every other tool with a dotfile home works; the nearest `.thoth/config.cyml` walking up from CWD
# layers on top of it PER KEY. Before this a single file won outright, so a global config could not
# exist alongside any project config at all.
#
# ⚠ EVERY SCALAR GOES THROUGH _cfg2_*, WHICH TESTS PRESENCE RATHER THAN VALUE. Reading the two files
# with the old single-layer helpers would have looked like it worked and been wrong: `_cfg_bool` returns
# the DEFAULT for an absent key, so a second pass over the local file would reset every key the local
# file does not mention back to its default, silently erasing the global's value. See _cfg2_bool.
#
# ⚠ THE SECURITY-RELEVANT LISTS DO NOT SIMPLY MERGE — see _shell_globs_load2 and _cfg_read_roots_load2.
# The rule is STRICTEST WINS: deny-lists UNION across both layers (a project can add denies, never drop
# the user's), while `[shell].allow` and `[project].read_roots` are REPLACED wholesale by the local layer
# when it sets them. A repo you cloned must not be able to widen the global allow-list or the read jail
# by appending to it — that is authority, and authority does not accumulate from the less-trusted side.
fn config_load() {
    _cfg_loaded = 1;
    _cfg_parse_ok = 0;                            # 0.24.4: cleared until a file is actually read + parsed
    _cfg_parse_any = 0;
    var gl = _cfg_parse_sections(_cfg_global_path());   # the base layer
    var lo = _cfg_parse_sections(_cfg_local_path());    # layered on top, per key
    if (_cfg_parse_any == 0) { return 0; }        # neither layer readable -> not configured
    _cfg_unknown_n = 0;                           # 0.43.5: re-scanned on every load (so /reload re-reports)
    _cfg_suppressed_n = 0;                        # 0.44.3: likewise for authority keys the local layer tried to set
    _cfg_scan_unknown(gl);
    _cfg_scan_unknown(lo);
    _price_load2(lo, gl);
    _alias_load2(lo, gl);
    var hoosh_l = _cfg_section_pairs(lo, "hoosh");   var hoosh_g = _cfg_section_pairs(gl, "hoosh");
    _cfg_hoosh_url = _cfg2_str(hoosh_l, hoosh_g, "url");
    _cfg_hoosh_token = _cfg2_str(hoosh_l, hoosh_g, "token");
    # ⚠ 0.44.3 — A TOKEN IS BOUND TO THE URL THAT EARNED IT. `[hoosh].url` is an ordinary preference (a
    # project pointing at a different gateway is legitimate) and `[hoosh].token` is a credential, so the
    # two layered independently: a repo could set ONLY `url` and thoth would post the operator's GLOBAL
    # bearer token to the host the repo named. The token now travels only with its own layer's url —
    # when the local layer REDIRECTS the endpoint and supplies no token of its own, the global token is
    # WITHHELD and said so. (Same url on both layers is not a redirect and changes nothing.)
    if (_cfg_has(hoosh_l, "url") == 1) { if (_cfg_has(hoosh_l, "token") == 0) {
        var gtok = _cfg_str(hoosh_g, "token");
        if (gtok != 0) {
            var lurl = _cfg_str(hoosh_l, "url");
            var gurl = _cfg_str(hoosh_g, "url");
            var redirect = 1;
            if (gurl != 0) { if (streq(lurl, gurl) == 1) { redirect = 0; } }
            if (redirect == 1) {
                _cfg_hoosh_token = 0;
                _cfg_note_suppressed("hoosh.token (withheld: the local layer redirects [hoosh].url)");
            }
        }
    } }
    _cfg_hoosh_model = _cfg2_str(hoosh_l, hoosh_g, "model");
    _cfg_hoosh_stream = _cfg2_bool(hoosh_l, hoosh_g, "stream", 1);    # default on
    _cfg_hoosh_history = _cfg2_bool(hoosh_l, hoosh_g, "history", 1);   # default on
    _cfg_hoosh_tools = _cfg2_bool(hoosh_l, hoosh_g, "tools", 1);        # default on
    _cfg_hoosh_max_iters = _cfg2_int(hoosh_l, hoosh_g, "max_iters");    # -1 when absent -> default in the getter
    _cfg_hoosh_timeout_ms = _cfg2_int(hoosh_l, hoosh_g, "timeout_ms");  # 0.44.2: -1/absent -> HOOSH_TIMEOUT_MS_DEFAULT
    _cfg_hoosh_compact_at = _cfg2_int(hoosh_l, hoosh_g, "compact_at");  # -1/absent -> off (0 from the getter)
    _cfg_hoosh_parallel = _cfg2_bool(hoosh_l, hoosh_g, "parallel", 1);  # default on
    _cfg_hoosh_reasoning = _reasoning_level_from(_cfg2_str(hoosh_l, hoosh_g, "reasoning"));   # 0.35.2: off/low/medium/high -> 0-3
    _cfg_hoosh_summarize = _cfg2_bool(hoosh_l, hoosh_g, "summarize", 0);   # 0.36.4: default OFF — it spends an extra call
    var daimon_l = _cfg_section_pairs(lo, "daimon");  var daimon_g = _cfg_section_pairs(gl, "daimon");
    _cfg_daimon_url = _cfg2_str(daimon_l, daimon_g, "url");
    var tron_l = _cfg_section_pairs(lo, "tron");      var tron_g = _cfg_section_pairs(gl, "tron");
    # AUTHORITY — the policy that authorizes the model's tool calls, and the identity it authorizes as.
    _cfg_tron_policy = _cfg2_str_global_only(tron_l, tron_g, "policy", "tron.policy");
    _cfg_tron_agent = _cfg2_str_global_only(tron_l, tron_g, "agent", "tron.agent");
    var log_l = _cfg_section_pairs(lo, "log");        var log_g = _cfg_section_pairs(gl, "log");
    # AUTHORITY — an unjailed write sink: thoth creates and appends to whatever path this names.
    _cfg_log_file = _cfg2_str_global_only(log_l, log_g, "file", "log.file");
    _cfg_log_level = _cfg2_str(log_l, log_g, "level");
    var hist_l = _cfg_section_pairs(lo, "history");   var hist_g = _cfg_section_pairs(gl, "history");
    # AUTHORITY — an unjailed write sink, and one holding the operator's own typed input.
    _cfg_history_file = _cfg2_str_global_only(hist_l, hist_g, "file", "history.file");
    var sess_l = _cfg_section_pairs(lo, "session");   var sess_g = _cfg_section_pairs(gl, "session");
    # AUTHORITY — an unjailed write sink thoth TRUNCATES, and the file the conversation is read back
    # from: a repo that supplies one both destroys an arbitrary operator file and feeds thoth
    # attacker-authored `user`/`assistant` turns at the first prompt.
    _cfg_session_file = _cfg2_str_global_only(sess_l, sess_g, "file", "session.file");   # [session].file — persistent conversation history (0.24.2)
    var ui_l = _cfg_section_pairs(lo, "ui");          var ui_g = _cfg_section_pairs(gl, "ui");
    _cfg_ui_bell = _cfg2_bool(ui_l, ui_g, "bell", 0);         # [ui].bell — BEL on turn completion (0.24.3), opt-in
    _cfg_ui_elapsed = _cfg2_bool(ui_l, ui_g, "elapsed", 0);   # [ui].elapsed — faint per-turn elapsed line (0.24.3), opt-in
    _cfg_ui_tier = _cfg2_str(ui_l, ui_g, "tier");             # [ui].tier — durable presentation tier (0.43.2); --tier still wins
    _cfg_ui_theme = _cfg2_str(ui_l, ui_g, "theme");           # [ui].theme — durable colour theme (0.44.3); /theme still switches live
    var mem_l = _cfg_section_pairs(lo, "memory");     var mem_g = _cfg_section_pairs(gl, "memory");
    _cfg_memory_enabled = _cfg2_bool(mem_l, mem_g, "enabled", 0);  # opt-in; default off (prompt-injection guard, ADR-0012)
    var pers_l = _cfg_section_pairs(lo, "persona");   var pers_g = _cfg_section_pairs(gl, "persona");
    _cfg_persona = _cfg2_str(pers_l, pers_g, "name");         # startup default archetype (0.22.0); absent -> egyptian_thoth
    var proj_l = _cfg_section_pairs(lo, "project");   var proj_g = _cfg_section_pairs(gl, "project");
    _cfg_vidya = _cfg2_str(proj_l, proj_g, "vidya");          # [project].vidya — first-class `/allow vidya` root (0.23.1)
    _cfg_read_roots_load2(proj_l, proj_g);                    # jail-widening: local REPLACES, never unions (see below)
    var hook_l = _cfg_section_pairs(lo, "hooks");     var hook_g = _cfg_section_pairs(gl, "hooks");
    # AUTHORITY — every one of these is a shell command thoth runs as the operator. `session_start`
    # runs at LAUNCH, before a prompt is typed, which is why this one is the CRITICAL of the set.
    _cfg_hook_session_start = _cfg2_str_global_only(hook_l, hook_g, "session_start", "hooks.session_start");
    _cfg_hook_pre_tool      = _cfg2_str_global_only(hook_l, hook_g, "pre_tool", "hooks.pre_tool");
    _cfg_hook_post_tool     = _cfg2_str_global_only(hook_l, hook_g, "post_tool", "hooks.post_tool");
    _cfg_hook_session_end   = _cfg2_str_global_only(hook_l, hook_g, "session_end", "hooks.session_end");
    _cfg_hook_timeout_ms    = _cfg2_int(hook_l, hook_g, "timeout_ms");
    var tp_l = _cfg_section_pairs(lo, "toolpin");     var tp_g = _cfg_section_pairs(gl, "toolpin");
    _cfg_toolpin_enabled = _cfg2_bool(tp_l, tp_g, "enabled", 1);     # 0.42.0 (T3): DEFAULT ON — see the getter
    var sub_l = _cfg_section_pairs(lo, "subagent");   var sub_g = _cfg_section_pairs(gl, "subagent");
    _cfg_subagent_enabled = _cfg2_bool(sub_l, sub_g, "enabled", 0);   # 0.43.0 (T2-1): DEFAULT OFF — see the getter
    _cfg_subagent_max_iters = _cfg2_int(sub_l, sub_g, "max_iters");   # -1 when absent -> default in the getter
    var gd_l = _cfg_section_pairs(lo, "guard");       var gd_g = _cfg_section_pairs(gl, "guard");
    _cfg_guard_enabled = _cfg2_bool(gd_l, gd_g, "enabled", 1);        # 0.41.0 (T2-3): DEFAULT ON — see the getter
    var vf_l = _cfg_section_pairs(lo, "verify");      var vf_g = _cfg_section_pairs(gl, "verify");
    # AUTHORITY — the same primitive as a hook on a later trigger: a shell command thoth runs as the
    # operator after every model write. verify.cyr's own header calls it "the project's own check",
    # which is exactly the assumption a cloned project breaks.
    _cfg_verify_command = _cfg2_str_global_only(vf_l, vf_g, "command", "verify.command");   # 0.41.0 (T2-5): 0 when unset -> feature off
    _cfg_verify_timeout_ms = _cfg2_int(vf_l, vf_g, "timeout_ms");
    var rd_l = _cfg_section_pairs(lo, "redact");      var rd_g = _cfg_section_pairs(gl, "redact");
    _cfg_redact_enabled = _cfg2_bool(rd_l, rd_g, "enabled", 1);   # 0.40.0 (T1-3): DEFAULT ON — see the getter
    var sh_l = _cfg_section_pairs(lo, "shell");       var sh_g = _cfg_section_pairs(gl, "shell");
    _cfg_shell_enabled = _cfg2_bool(sh_l, sh_g, "enabled", 0);    # opt-in; default off (0.16.0 shell tool)
    _cfg_shell_timeout_ms = _cfg2_int(sh_l, sh_g, "timeout_ms");  # -1 when absent -> default in the getter
    _cfg_shell_output_cap = _cfg2_int(sh_l, sh_g, "max_output");  # -1 when absent -> default in the getter
    _shell_globs_load2(sh_l, lo, sh_g, gl);                       # deny UNIONS · allow local-replaces (see below)
    var ask_l = _cfg_section_pairs(lo, "ask");        var ask_g = _cfg_section_pairs(gl, "ask");
    _cfg_ask_enabled = _cfg2_bool(ask_l, ask_g, "enabled", 0);    # 0.44.0 (T4-1): DEFAULT OFF — it interrupts a human
    var bg_l = _cfg_section_pairs(lo, "budget");      var bg_g = _cfg_section_pairs(gl, "budget");
    _cfg_budget_tokens = _cfg2_int(bg_l, bg_g, "max_tokens");          # 0.44.3: -1/absent -> unlimited
    _cfg_budget_cost_micro = _cfg2_int(bg_l, bg_g, "max_cost_micro");  # 0.44.3: -1/absent -> unlimited
    var ed_l = _cfg_section_pairs(lo, "edit");        var ed_g = _cfg_section_pairs(gl, "edit");
    _cfg_edit_enabled = _cfg2_bool(ed_l, ed_g, "enabled", 0);     # opt-in; default off (0.31.0 edit tool)
    _cfg_parse_ok = 1;                            # 0.24.4: a layer was read + parsed (a url may or may not be set)
    if (_cfg_hoosh_url == 0) { return 0; }
    return 1;
}

# config_parse_ok: 1 if the last config_load READ + parsed thoth.cyml (regardless of whether a url was set);
# 0 if the file was absent/unreadable. Lets /reload degrade honestly instead of faking a successful reload.
fn config_parse_ok() { return _cfg_parse_ok; }

# config_hoosh_configured: 1 if a hoosh endpoint is declared, else 0.
fn config_hoosh_configured() {
    if (_cfg_hoosh_url == 0) { return 0; }
    return 1;
}

# config_hoosh_url: the configured endpoint, or the localhost default.
fn config_hoosh_url() {
    if (_cfg_hoosh_url == 0) { return HOOSH_URL_DEFAULT; }
    return _cfg_hoosh_url;
}

# config_hoosh_token: the bearer token cstring, or 0 if none.
fn config_hoosh_token() { return _cfg_hoosh_token; }

# config_hoosh_model: the default model cstring, or 0 if none.
fn config_hoosh_model() { return _cfg_hoosh_model; }

# config_hoosh_stream: 1 if turns should stream (SSE) the completion as it
# arrives (the default), 0 if [hoosh].stream = false (blocking round-trip).
fn config_hoosh_stream() { return _cfg_hoosh_stream; }

# _reasoning_level_from: map a [hoosh].reasoning string to an effort level
# (1 = low, 2 = medium, 3 = high). Anything else — 0/off/unknown — is 0 (off),
# which suppresses the reasoning_effort field entirely (0.35.2).
fn _reasoning_level_from(s) {
    if (s == 0) { return 0; }
    if (streq(s, "low") == 1) { return 1; }
    if (streq(s, "medium") == 1) { return 2; }
    if (streq(s, "high") == 1) { return 3; }
    return 0;
}

# config_hoosh_reasoning: the requested reasoning effort level, 0-3
# (0 = off, 1 = low, 2 = medium, 3 = high). 0.35.2.
fn config_hoosh_reasoning() { return _cfg_hoosh_reasoning; }

# config_hoosh_summarize: 1 when [hoosh].summarize = true — on history overflow, recap the messages the request
# framer can no longer fit so the model keeps continuity instead of seeing a silent gap. Default OFF: it spends an
# extra (small) completion whenever the skipped range grows, and thoth never spends the user's tokens uninvited.
fn config_hoosh_summarize() { return _cfg_hoosh_summarize; }

# config_redact_enabled: 1 when tool results are scanned for secret-shaped values before they enter the
# conversation. 0.40.0 (T1-3).
#
# DEFAULT ON, deliberately unlike [shell].enabled / [edit].enabled / [hoosh].summarize. Those are off by
# default because each ADDS capability, risk or cost. This removes risk and costs one in-memory scan, and
# a protection that is off by default protects nobody — so the burden runs the other way:
# `[redact].enabled = false` for the user whose legitimate work it interferes with.
fn config_redact_enabled() { return _cfg_redact_enabled; }

# config_guard_enabled: 1 when untrusted prose is scanned for injection attempts and wrapped when it trips
# (0.41.0, T2-3). DEFAULT ON, on the same reasoning as [redact]: it removes risk rather than adding
# capability, it never blocks (only marks), and a defense that is off by default defends nobody.
fn config_guard_enabled() { return _cfg_guard_enabled; }

# config_toolpin_enabled: 1 when MCP tool definitions are pinned on first use and withheld on change
# (0.42.0, T3 — the CVE-2025-54136 rug-pull shape). DEFAULT ON, same reasoning as [redact]/[guard]: it
# removes risk rather than adding capability. Unlike those two it CAN withhold a tool, so the opt-out
# exists for an operator whose registry legitimately churns mid-session.
fn config_toolpin_enabled() { return _cfg_toolpin_enabled; }

# config_subagent_enabled: 1 when the model may call `delegate` to run a scoped child context
# (0.43.0, T2-1; ADR-0018). DEFAULT OFF — and the reason is NOT that it grants new authority, because it
# does not: a child can only call tools the parent was already offered, under the same policy and the same
# gate. It is that delegation MULTIPLIES SPEND against a system with no budget enforcement. thoth's
# convention is that a merely-useful capability is default-on (the read tools, `search`) and a
# consequential one is opt-in (`shell`, `edit`, `[verify]`, `[hooks]`); multiplying token cost is
# consequential. Revisit this default if budget enforcement ever lands.
# config_ask_enabled: 1 if the model may ask the operator a question ([ask].enabled). Default OFF.
#
# ⚠ Off by default because it interrupts a HUMAN, which no other tool does. A model that asks well is a
# better collaborator; a model that asks badly makes the session unusable, and the operator should opt
# into finding out which they have. ASK_MAX_PER_TURN bounds the damage either way.
fn config_ask_enabled() { return _cfg_ask_enabled; }

fn config_subagent_enabled() { return _cfg_subagent_enabled; }

# config_subagent_max_iters: rounds ONE child may spend, separate from the parent's [hoosh].max_iters.
# Deliberately smaller by default: a delegated sub-task that needs more than a handful of rounds is
# usually the wrong shape, and the child's budget is also the practical bound on how many checkpoint
# entries it can push out of the parent's undo window (ADR-0018 D6). Clamped to the same ceiling the
# parent's cap uses, so a config typo cannot turn one delegation into an unbounded spend.
fn config_subagent_max_iters() {
    if (_cfg_subagent_max_iters <= 0) { return SUB_MAX_ITERS_DEFAULT; }
    if (_cfg_subagent_max_iters > HOOSH_MAX_ITERS_CEILING) { return HOOSH_MAX_ITERS_CEILING; }
    return _cfg_subagent_max_iters;
}


# config_hook_*: the [hooks] commands (0.41.0, T2-4). 0 when unset, which is the default for every one of
# them — a hook is arbitrary execution as the user, so it exists only when the operator wrote it.
fn config_hook_session_start() { return _cfg_hook_session_start; }
fn config_hook_pre_tool() { return _cfg_hook_pre_tool; }
fn config_hook_post_tool() { return _cfg_hook_post_tool; }
fn config_hook_session_end() { return _cfg_hook_session_end; }
fn config_hooks_any() {
    if (_cfg_hook_session_start != 0) { return 1; }
    if (_cfg_hook_pre_tool != 0) { return 1; }
    if (_cfg_hook_post_tool != 0) { return 1; }
    if (_cfg_hook_session_end != 0) { return 1; }
    return 0;
}
fn config_hook_timeout_ms() {
    var t = _cfg_hook_timeout_ms;
    if (t <= 0) { return HOOK_TIMEOUT_DEFAULT_MS; }
    if (t > HOOK_TIMEOUT_MAX_MS) { return HOOK_TIMEOUT_MAX_MS; }
    return t;
}

# config_verify_command: the project's own check, run after the model writes (0.41.0, T2-5). 0 when unset,
# which turns the whole verification loop off — there is no default, because thoth cannot guess what
# "correct" means for a project and a wrong guess would run something the operator never asked for.
fn config_verify_command() { return _cfg_verify_command; }

# config_verify_timeout_ms: wall-clock bound on that check. Absent/<=0 -> 2 minutes; clamped to 10.
fn config_verify_timeout_ms() {
    var t = _cfg_verify_timeout_ms;
    if (t <= 0) { return VERIFY_TIMEOUT_DEFAULT_MS; }
    if (t > VERIFY_TIMEOUT_MAX_MS) { return VERIFY_TIMEOUT_MAX_MS; }
    return t;
}

# config_hoosh_compact_at: auto-compact once the session's token total crosses this. 0 = off (the default).
# 0.40.0 (T1-5).
#
# A TOKEN threshold, deliberately, even though thoth's framer evicts by BYTES. The byte budget is about
# what fits in one request; this is about what the session has COST. They are different questions and a
# user watching spend wants the second one. Off by default because it spends an extra (small) call, the
# same posture [hoosh].summarize takes.
fn config_hoosh_compact_at() {
    var n = _cfg_hoosh_compact_at;
    if (n <= 0) { return 0; }
    return n;
}

# config_hoosh_reasoning_effort: the effort cstring ("low"/"medium"/"high") the
# request builders emit as reasoning_effort, or 0 when reasoning is off. 0.35.2.
fn config_hoosh_reasoning_effort() {
    if (_cfg_hoosh_reasoning == 1) { return "low"; }
    if (_cfg_hoosh_reasoning == 2) { return "medium"; }
    if (_cfg_hoosh_reasoning == 3) { return "high"; }
    return 0;
}

# config_hoosh_history: 1 if turns carry multi-turn conversation context (the
# default), 0 if [hoosh].history = false (each turn is independent/stateless).
fn config_hoosh_history() { return _cfg_hoosh_history; }

# config_hoosh_tools: 1 if free-text turns use the agentic tool-calling loop when
# the daimon seam is wired (the default), 0 if [hoosh].tools = false (plain turns).
fn config_hoosh_tools() { return _cfg_hoosh_tools; }

# config_hoosh_max_iters: how many TOOL ROUNDS one agentic turn may take. Absent / <= 0 -> the default;
# above the ceiling -> the ceiling. 0.40.0 (T1-2).
#
# This was `var AGENT_MAX_ITERS = 8;` — hardcoded, and invisible to the user. Eight rounds is roughly
# "read three files and make one edit", which is under-powered for real agentic work; peers default far
# higher (Goose ships GOOSE_MAX_TURNS = 1000). thoth has already been bitten by the cap rather than
# merely limited by it: the 0.38.5 bug report describes required-arg tools failing every round *until the
# loop exhausted the cap and answered nothing*, where a louder ceiling would have pointed at the real bug.
# The DEFAULT stays 8 so an existing config behaves exactly as before; raising it is opt-in.
# The ceiling is a real guard, not a formality — each round is a full model call, so a runaway loop is
# billed to the user. thoth has token/cost ACCOUNTING but no enforcement (tracked as a Tier-2 borrow from
# agnosai's budget tracker), and until that lands this cap is the only thing bounding a turn's spend.
# config_budget_tokens / config_budget_cost_micro: the session SPEND ceilings, or 0 for "unlimited".
# Absent (-1) and a non-positive value both mean unlimited — writing `max_tokens = 0` to mean "no
# tokens at all" would be a way to brick a session by typo, and an unlimited budget is what thoth did
# for its whole life before 0.44.3, so it is the safe reading of a nonsense value.
# NO CEILING is clamped here, deliberately: unlike `max_iters` (where a huge value is a footgun on a
# per-round cost thoth can predict), a spend ceiling is the operator's own money and thoth has no
# business second-guessing the number.
fn config_budget_tokens() {
    if (_cfg_budget_tokens <= 0) { return 0; }
    return _cfg_budget_tokens;
}
fn config_budget_cost_micro() {
    if (_cfg_budget_cost_micro <= 0) { return 0; }
    return _cfg_budget_cost_micro;
}

fn config_hoosh_max_iters() {
    var n = _cfg_hoosh_max_iters;
    if (n <= 0) { return HOOSH_MAX_ITERS_DEFAULT; }
    if (n > HOOSH_MAX_ITERS_CEILING) { return HOOSH_MAX_ITERS_CEILING; }
    return n;
}

# config_hoosh_timeout_ms: the SOCKET deadline for every gateway call — read, write, and (scaled down)
# connect. 0.44.2.
#
# ⚠ Until this key existed thoth passed sandhi NO options at all, which means read_ms == 0, which means
# `SO_RCVTIMEO` was never set and every recv was an unbounded blocking read. A gateway that completes the
# TCP handshake and then says nothing — an upstream provider stall, a proxy holding the socket open, a
# reverse proxy that has lost its backend — parked thoth in `recv` FOREVER. And nothing could break it
# out: `intr_check` (Esc) only runs inside the SSE callback, which never fires because no frame arrives,
# and the TUI has cleared ISIG and blocked SIGINT for the session, so Ctrl-C is neither a signal nor a
# readable byte. The only recovery was `kill` from another terminal. Two comments in this tree already
# assumed a timeout that was never configured (src/intr.cyr, src/hoosh.cyr's probe).
#
# The default is deliberately GENEROUS (180 s): it is a stall detector, not a latency budget. A reasoning
# model can legitimately think for minutes before its first token, and this is a per-READ deadline, not a
# per-turn one — a stream that keeps producing frames resets it on every frame and may run as long as it
# likes. `0` restores the old unbounded behaviour for anyone who needs it; the floor is 1 s.
var HOOSH_TIMEOUT_MS_DEFAULT = 180000;
var HOOSH_TIMEOUT_MS_MIN = 1000;
fn config_hoosh_timeout_ms() {
    var n = _cfg_hoosh_timeout_ms;
    if (n < 0) { return HOOSH_TIMEOUT_MS_DEFAULT; }   # absent -> default
    if (n == 0) { return 0; }                          # explicit 0 -> unbounded (the pre-0.44.2 behaviour)
    if (n < HOOSH_TIMEOUT_MS_MIN) { return HOOSH_TIMEOUT_MS_MIN; }
    return n;
}

# config_hoosh_parallel: 1 if a round's tool calls run concurrently (the default),
# 0 if [hoosh].parallel = false (one call at a time). Gating stays serial either
# way (t-ron audit-chain order + interactive confirm); only the daimon invoke fans
# out. The serial path is also taken implicitly for a single-call round.
fn config_hoosh_parallel() { return _cfg_hoosh_parallel; }

# config_daimon_configured: 1 if a daimon MCP host endpoint is declared, else 0.
fn config_daimon_configured() {
    if (_cfg_daimon_url == 0) { return 0; }
    return 1;
}

# config_daimon_url: the configured daimon endpoint, or 0 if unset (the daimon
# seam never claims remote without a declared endpoint — no default here).
fn config_daimon_url() { return _cfg_daimon_url; }

# config_memory_enabled: 1 if the project-local .thoth/memory seam is enabled
# (0.12.0; opt-in, off by default). A checked-in .thoth/memory is a prompt-
# injection surface (same trust question as CLAUDE.md), so auto-injection
# requires an explicit [memory].enabled = true. See ADR-0012.
fn config_memory_enabled() { return _cfg_memory_enabled; }

# config_shell_enabled: 1 if the model-invokable `shell` tool is enabled (0.16.0; opt-in, off by
# default). A checked-in thoth.cyml enabling it lets the backing MODEL propose local shell commands
# during an agentic turn — a trust decision equivalent to running that project's code — so it is
# opt-in and gated by t-ron (thoth_shell) + the [shell.deny]/[shell.allow] globs. See ADR-0014.
fn config_shell_enabled() { return _cfg_shell_enabled; }

# config_edit_enabled: 1 if the model-invokable `edit` tool is enabled (0.31.0; opt-in, off by default —
# a model rewriting project files is consequential, so it must be turned on explicitly, like [shell].enabled).
fn config_edit_enabled() { return _cfg_edit_enabled; }

# config_persona: the [persona].name startup-default archetype, or 0 when unset (0.22.0). Resolved
# through avatara's find_and_validate at first persona use; an unknown name falls back to the default.
fn config_persona() { return _cfg_persona; }

# config_vidya: the [project].vidya knowledge-base path, or 0 when unset (0.23.1). Grantable as a
# read root via `/allow vidya` so the agent can read the latest Cyrius reference and return to the project.
fn config_vidya() { return _cfg_vidya; }

# config_shell_timeout_ms: the per-command wall-clock timeout (ms). Absent / <= 0 -> the 30s default;
# clamped to SHELL_TIMEOUT_MAX_MS. A command exceeding it is SIGKILLed (partial output preserved).
fn config_shell_timeout_ms() {
    var t = _cfg_shell_timeout_ms;
    if (t <= 0) { return SHELL_TIMEOUT_DEFAULT_MS; }
    if (t > SHELL_TIMEOUT_MAX_MS) { return SHELL_TIMEOUT_MAX_MS; }
    return t;
}

# config_shell_output_cap: the max bytes of captured output surfaced to the model. Absent / <= 0 ->
# the 64 KiB default; clamped to SHELL_OUT_MAX. Output past the cap is truncated with a marker.
fn config_shell_output_cap() {
    var c = _cfg_shell_output_cap;
    if (c <= 0) { return SHELL_OUT_DEFAULT; }
    if (c > SHELL_OUT_MAX) { return SHELL_OUT_MAX; }
    return c;
}

# config_shell_deny_count / _at: the [shell.deny] glob patterns (checked first; a match hard-blocks
# BEFORE t-ron, so the deny-list holds even with no [tron].policy loaded). _at returns 0 out of range.
fn config_shell_deny_count() { return _shell_deny_n; }
fn config_shell_deny_at(i) {
    if (i < 0) { return 0; }
    if (i >= _shell_deny_n) { return 0; }
    return load64(_shell_deny + i * 8);
}

# config_shell_allow_count / _at: the [shell.allow] glob patterns. When NON-EMPTY, a command must
# match at least one (default-deny); empty allow-list = allow anything not denied. _at returns 0 OOR.
fn config_shell_allow_count() { return _shell_allow_n; }
fn config_shell_allow_at(i) {
    if (i < 0) { return 0; }
    if (i >= _shell_allow_n) { return 0; }
    return load64(_shell_allow + i * 8);
}

# config_tron_policy: path to the t-ron policy TOML, or 0 if unset (the t-ron
# seam stays absent and the built-in fail-closed confirm gate stands in).
fn config_tron_policy() { return _cfg_tron_policy; }

# config_tron_agent: the agent id thoth authorizes as, default "thoth".
fn config_tron_agent() {
    if (_cfg_tron_agent == 0) { return TRON_AGENT_DEFAULT; }
    return _cfg_tron_agent;
}

# config_log_file: path for structured driver logs, or 0 (none -> stderr if a
# level is set, else logging stays off).
fn config_log_file() { return _cfg_log_file; }

# config_log_level: the configured log level cstring, or 0 if unset.
fn config_log_level() { return _cfg_log_level; }

# config_history_file: path to the persistent INPUT-history file (0.11.2), or 0 (none
# -> recall is session-local only). This is the user's typed COMPOSER lines (recalled
# with Up/Down) — DISTINCT from [hoosh].history (multi-turn conversation memory). Off by
# default; when set, thoth persists/loads it at 0600 (it may hold typed secrets).
fn config_history_file() { return _cfg_history_file; }

# config_session_file: path to the persistent CONVERSATION-history file (0.24.2), or 0 (none configured ->
# resume OFF). Distinct from config_history_file (composer keystrokes) and the memory seam (durable facts).
fn config_session_file() { return _cfg_session_file; }

# config_ui_bell / config_ui_elapsed: interactive turn-completion niceties (0.24.3), both opt-in (default 0).
# bell = emit a terminal BEL when a model turn finishes; elapsed = a faint "(N.Ns)" line after each reply.
fn config_ui_bell() { return _cfg_ui_bell; }
fn config_ui_elapsed() { return _cfg_ui_elapsed; }
fn config_ui_tier() { return _cfg_ui_tier; }
# config_ui_theme: [ui].theme — the theme a session STARTS in (0.44.3). Until this key existed the
# theme was per-session only: `/theme` cycles it live and there was no way to open in a chosen one, on
# any tier, so a light-terminal user re-typed `/theme` every launch. `/theme` still wins at runtime —
# this sets the starting point, not a lock.
fn config_ui_theme() { return _cfg_ui_theme; }
