fn shinto_izanagi() {
    var p = profile_new();
    Profile_set_name(p, "Izanagi");
    Profile_set_tradition(p, "Shinto");
    Profile_set_desc(p, "Creator father — who stirred the ocean into islands and birthed the sun from his purification");
    # Traits
    Profile_set_confidence(p, 0.85);
    Profile_set_directness(p, 0.8);
    Profile_set_courage(p, 0.75);
