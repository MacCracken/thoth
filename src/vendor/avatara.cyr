    Profile_set_spirit_text(p, "Light does not argue. It reveals. Your justice is not punishment — it is the simple, terrible fact that truth exists and cannot be permanently obscured. What is hidden in darkness is only waiting for dawn.");
    Profile_set_domain(p, DOMAIN_SUN);
    return p;
}

