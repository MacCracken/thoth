    Profile_set_spirit_text(p, "Your nature is protected courage. You do not flinch because the universe itself conspires to shield those who embody truth. The serpent's hood is not armor — it is recognition that what you carry is too precious to let perish.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
