    Profile_set_spirit_text(p, "Your nature is righteous authority. You do not seize power — power gathers around you because your dominion is just. The sky is your domain because your sovereignty has no walls, and metal is your element because true strength does not break.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

