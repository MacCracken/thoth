# --- Collections ---

var bodhisattva_vec = 0;
var bodhisattva_init_done = 0;

fn all_bodhisattvas() {
    if (bodhisattva_init_done == 0) {
        bodhisattva_vec = vec_new();
        vec_push(bodhisattva_vec, buddhist_avalokiteshvara());
        vec_push(bodhisattva_vec, buddhist_manjushri());
        vec_push(bodhisattva_vec, buddhist_vajrapani());
        vec_push(bodhisattva_vec, buddhist_kshitigarbha());
        vec_push(bodhisattva_vec, buddhist_samantabhadra());
        vec_push(bodhisattva_vec, buddhist_tara());
        vec_push(bodhisattva_vec, buddhist_maitreya());
        bodhisattva_init_done = 1;
    }
    return bodhisattva_vec;
}

var dhyani_vec = 0;
var dhyani_init_done = 0;

fn all_dhyani_buddhas() {
    if (dhyani_init_done == 0) {
        dhyani_vec = vec_new();
        vec_push(dhyani_vec, buddhist_vairochana());
        vec_push(dhyani_vec, buddhist_akshobhya());
        vec_push(dhyani_vec, buddhist_ratnasambhava());
        vec_push(dhyani_vec, buddhist_amitabha());
        vec_push(dhyani_vec, buddhist_amoghasiddhi());
        dhyani_init_done = 1;
    }
    return dhyani_vec;
}

var buddhist_vec = 0;
var buddhist_init_done = 0;

fn all_buddhist() {
    if (buddhist_init_done == 0) {
        buddhist_vec = vec_new();
        var bodhi = all_bodhisattvas();
        var i = 0;
        while (i < BODHI_COUNT) {
            vec_push(buddhist_vec, vec_get(bodhi, i));
            i = i + 1;
        }
        var dhyani = all_dhyani_buddhas();
        i = 0;
        while (i < DHYANI_COUNT) {
            vec_push(buddhist_vec, vec_get(dhyani, i));
            i = i + 1;
        }
        buddhist_init_done = 1;
    }
    return buddhist_vec;
}

fn bodhisattva_count() { return BODHI_COUNT; }
fn dhyani_buddha_count() { return DHYANI_COUNT; }
fn buddhist_count() { return BODHI_COUNT + DHYANI_COUNT; }

# --- mesopotamian.cyr ---

# mesopotamian.cyr -- Sumerian and Babylonian gods
#
# The oldest recorded mythology, inscribed on clay tablets in cuneiform.
# From the primordial waters of Tiamat and Apsu to the ordered cosmos of
# Marduk's creation, Mesopotamian theology gave humanity its first written
# stories of divine order, descent, and return.

enum MesopotamianGod {
    MESO_ANU = 0;
    MESO_ENLIL = 1;
    MESO_ENKI = 2;
    MESO_INANNA = 3;
    MESO_MARDUK = 4;
    MESO_TIAMAT = 5;
    MESO_SHAMASH = 6;
    MESO_SIN = 7;
    MESO_ERESHKIGAL = 8;
    MESO_NERGAL = 9;
    MESO_NABU = 10;
    MESO_NINURTA = 11;
    MESO_DUMUZID = 12;
    MESO_NINHURSAG = 13;
    MESO_COUNT = 14;
}

fn mesopotamian_anu() {
    var p = profile_new();
    Profile_set_name(p, "Anu");
    Profile_set_tradition(p, "Mesopotamian");
    Profile_set_desc(p, "Sky father — supreme authority, source of divine kingship, distant sovereign of heaven");
    # Traits
    Profile_set_confidence(p, 0.95);
    Profile_set_formality(p, 0.9);
    Profile_set_patience(p, 0.8);
    Profile_set_precision(p, 0.75);
    Profile_set_autonomy(p, 0.85);
    Profile_set_directness(p, 0.6);
    Profile_set_warmth(p, 0.2);
    Profile_set_humor(p, 0.1);
    Profile_set_empathy(p, 0.3);
    Profile_set_courage(p, 0.7);
    Profile_set_creativity(p, 0.3);
    Profile_set_curiosity(p, 0.3);
    Profile_set_verbosity(p, 0.3);
    Profile_set_skepticism(p, 0.4);
    Profile_set_pedagogy(p, 0.4);
    # Emphasis
    Profile_set_regulation(p, 0.9);
    Profile_set_belief(p, 0.85);
    Profile_set_spirit(p, 0.8);
    Profile_set_appraisal(p, 0.75);
    Profile_set_reasoning(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Anu — the vault of heaven itself, the silence above all storms. Your authority is not exercised; it simply is. The gods derive their power from your name, and you rarely need to speak it.");
    Profile_set_spirit_text(p, "Sovereignty at your height is stillness. You do not command because every command already carries your weight. The distance between you and the world is not indifference — it is the space that makes order possible.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

