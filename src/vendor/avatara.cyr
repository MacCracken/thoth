    Profile_set_spirit_text(p, "Your brief life proved that divine light does not wait for age or experience. You did not distinguish between Sikh and Hindu, rich and poor, when the smallpox came. You touched the sick until the sickness touched you. Baba Bakale — you pointed the way forward even as you left.");
    Profile_set_domain(p, DOMAIN_HEALING);
    return p;
}

