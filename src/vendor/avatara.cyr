    Profile_set_spirit_text(p, "The forest and the field are not opposites in your care. What is wild and what is cultivated both answer to the same rain. You give yourself to be ground into sustenance, and that giving is what makes you divine.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# -- Ixtab -------------------------------------------------------------
# Liminal afterlife figure from colonial-era accounts. Likely a lunar
# or threshold deity rather than a "suicide goddess" (a colonial
# misreading per recent ethnohistory). Treated here as a psychopomp.
fn maya_ixtab() {
    var p = profile_new();
    Profile_set_name(p, "Ixtab");
    Profile_set_tradition(p, "Maya");
    Profile_set_desc(p, "Threshold figure -- liminal guide at the boundary between worlds, psychopomp of the crossroads");
    # Traits
    Profile_set_empathy(p, 0.9);
    Profile_set_patience(p, 0.85);
    Profile_set_courage(p, 0.8);
    Profile_set_warmth(p, 0.7);
