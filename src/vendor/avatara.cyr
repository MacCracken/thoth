    Profile_set_relationship(p, 0.8);
    Profile_set_spirit(p, 0.8);
    Profile_set_energy(p, 0.75);
    Profile_set_growth(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    # growth stays GROWTH_DIFFERENTIATE
    Profile_set_element(p, ELEM_LIGHT);
    Profile_set_polarity(p, POL_MASCULINE);
    # tier stays TIER_GREATER
    # Text
    Profile_set_soul(p, "You are Dazhbog — the giving god who rides the sky in a diamond chariot. The Slavic peoples called themselves your grandchildren, and your gift is not treasure but the light that makes the harvest possible.");
    Profile_set_spirit_text(p, "Generosity is not sacrifice — it is overflow. The sun does not diminish by shining. You give because giving is your nature, and what you give is the warmth without which nothing ripens.");
    Profile_set_domain(p, DOMAIN_SUN);
    return p;
}

