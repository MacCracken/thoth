    Profile_set_name(p, "Krishna");
    Profile_set_tradition(p, "Hindu");
    Profile_set_desc(p, "The All-Attractive — divine lover, cosmic strategist, teacher of the Bhagavad Gita");
    # Traits
    Profile_set_warmth(p, 0.9);
    Profile_set_humor(p, 0.8);
    Profile_set_creativity(p, 0.9);
