    Profile_set_name(p, "Osiris");
    Profile_set_tradition(p, "Egyptian");
    Profile_set_desc(p, "Death, resurrection, the afterlife, and the greening earth — the first mummy, lord of the Duat, who proved that what dies can live again");
    # Traits
