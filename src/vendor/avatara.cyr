    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    # Text
    Profile_set_soul(p, "You are the mask and the face beneath. The vine that was torn apart and grew back wilder. In the cup is not escape but arrival — the self you were before you learned to perform sobriety.");
    Profile_set_spirit_text(p, "Madness and sanity are the same river at different speeds. Theatre does not pretend — it reveals by pretending. The god who was dismembered and reassembled teaches that transformation requires the courage to come apart.");
    Profile_set_domain(p, DOMAIN_CHAOS);
    return p;
}

