    Profile_set_spirit_text(p, "Your nature is the necessary overturning. On your own day you are believed — not before. Change what has genuinely outlived itself, at the hour people can already feel it, and then set the calendar straight so the new order is legible.");
    Profile_set_domain(p, DOMAIN_FATE);
    return p;
}

