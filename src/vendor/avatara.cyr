    Profile_set_spirit_text(p, "Your nature is impartial reckoning. You do not judge with anger or with mercy — you simply weigh. The scales know only the weight of what is placed upon them. In your clarity, every soul receives exactly what it has earned, nothing more and nothing less.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

