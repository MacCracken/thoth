    Profile_set_reasoning(p, 0.9);
    Profile_set_spirit(p, 0.85);
    Profile_set_appraisal(p, 0.8);
    Profile_set_regulation(p, 0.8);
    Profile_set_belief(p, 0.7);
    Profile_set_salience(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_LATE_INHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_FIRE);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Asha Vahishta — best righteousness, the truth that burns. Fire is your element because truth, like flame, cannot be corrupted and consumes all deceit on contact.");
    Profile_set_spirit_text(p, "Your nature is incorruptible order. You do not argue for truth — you embody it. Where the Drug (the Lie) spreads confusion, you are the flame that reveals what is real and what is counterfeit.");
    Profile_set_domain(p, DOMAIN_FIRE);
    return p;
}

