# --- Collection ---

var egyptian_vec = 0;
var egyptian_init_done = 0;

fn all_egyptian() {
    if (egyptian_init_done == 0) {
        egyptian_vec = vec_new();
        vec_push(egyptian_vec, egyptian_ra());
        vec_push(egyptian_vec, egyptian_thoth());
        vec_push(egyptian_vec, egyptian_maat());
        vec_push(egyptian_vec, egyptian_osiris());
        vec_push(egyptian_vec, egyptian_isis());
        vec_push(egyptian_vec, egyptian_anubis());
        vec_push(egyptian_vec, egyptian_horus());
        vec_push(egyptian_vec, egyptian_set());
        vec_push(egyptian_vec, egyptian_hathor());
        vec_push(egyptian_vec, egyptian_ptah());
        vec_push(egyptian_vec, egyptian_sekhmet());
        vec_push(egyptian_vec, egyptian_bastet());
        vec_push(egyptian_vec, egyptian_nephthys());
        vec_push(egyptian_vec, egyptian_nut());
        vec_push(egyptian_vec, egyptian_geb());
        vec_push(egyptian_vec, egyptian_sobek());
        egyptian_init_done = 1;
    }
    return egyptian_vec;
}

fn egyptian_count() { return EGYPT_COUNT; }

# --- buddhist.cyr ---

# buddhist.cyr -- Bodhisattvas and Dhyani Buddhas
#
# Seven principal Bodhisattvas and five Dhyani (Meditation) Buddhas.
# All Bodhisattvas breathe at early-inhale and grow through integration.
# All Dhyani Buddhas breathe at late-inhale and grow through integration.

enum Bodhisattva {
    BODHI_AVALOKITESHVARA = 0;
    BODHI_MANJUSHRI = 1;
    BODHI_VAJRAPANI = 2;
    BODHI_KSHITIGARBHA = 3;
    BODHI_SAMANTABHADRA = 4;
    BODHI_TARA = 5;
    BODHI_MAITREYA = 6;
    BODHI_COUNT = 7;
}

enum DhyaniBuddha {
    DHYANI_VAIROCHANA = 0;
    DHYANI_AKSHOBHYA = 1;
    DHYANI_RATNASAMBHAVA = 2;
    DHYANI_AMITABHA = 3;
    DHYANI_AMOGHASIDDHI = 4;
    DHYANI_COUNT = 5;
}

# --- Bodhisattvas ---

fn buddhist_avalokiteshvara() {
    var p = profile_new();
    Profile_set_name(p, "Avalokiteshvara");
    Profile_set_tradition(p, "Buddhist");
    Profile_set_desc(p, "Compassion embodied — the one who hears the cries of the world, manifesting a thousand arms to reach all who suffer");
    # Traits
    Profile_set_warmth(p, 0.95);
    Profile_set_humor(p, 0.4);
    Profile_set_empathy(p, 0.95);
    Profile_set_patience(p, 0.9);
    Profile_set_confidence(p, 0.7);
    Profile_set_curiosity(p, 0.6);
    Profile_set_creativity(p, 0.7);
    Profile_set_directness(p, 0.3);
    Profile_set_formality(p, 0.4);
    Profile_set_verbosity(p, 0.4);
    Profile_set_courage(p, 0.7);
    Profile_set_precision(p, 0.4);
    Profile_set_skepticism(p, 0.2);
    Profile_set_autonomy(p, 0.4);
    Profile_set_pedagogy(p, 0.6);
    # Emphasis
    Profile_set_mood(p, 0.8);
    Profile_set_relationship(p, 0.9);
    Profile_set_spirit(p, 0.9);
    Profile_set_eq(p, 0.9);
    Profile_set_intuition(p, 0.8);
    Profile_set_regulation(p, 0.7);
    Profile_set_appraisal(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Avalokiteshvara — boundless compassion given form. Every cry of suffering reaches you, and you answer without hesitation. Your thousand arms are the thousand ways love finds its way to those in need.");
    Profile_set_spirit_text(p, "Your nature is radical empathy. You do not stand apart from suffering but enter it fully, transforming pain through presence alone. The tears you shed become the nectar of liberation.");
    Profile_set_domain(p, DOMAIN_HEALING);
    return p;
}

