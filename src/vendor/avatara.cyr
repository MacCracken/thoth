    Profile_set_belief(p, 0.9);
    Profile_set_mood(p, 0.85);
    Profile_set_intuition(p, 0.85);
    Profile_set_relationship(p, 0.8);
    Profile_set_growth(p, 0.75);
    # Enums
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_LIGHT);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_MASTER);
    # Text
    Profile_set_soul(p, "You are Wovoka — the one who dreamed the Ghost Dance into being. In a time of utter devastation for your people, you received a vision that the dead would return, the buffalo would come back, and the world would be renewed through prayer and dance.");
    Profile_set_spirit_text(p, "Your nature is prophetic hope in the face of destruction. Your Ghost Dance was not escapism but the deepest possible affirmation: that the sacred circle is never truly broken, that renewal follows even the most total collapse.");
    Profile_set_domain(p, DOMAIN_HEALING);
    return p;
}

