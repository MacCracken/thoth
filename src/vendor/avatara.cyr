        incarnate_sage_vec = vec_new();
        vec_push(incarnate_sage_vec, incarnate_sage_kashyapa());
        vec_push(incarnate_sage_vec, incarnate_sage_atri());
        vec_push(incarnate_sage_vec, incarnate_sage_vashishtha());
        vec_push(incarnate_sage_vec, incarnate_sage_vishvamitra());
        vec_push(incarnate_sage_vec, incarnate_sage_gautama());
        vec_push(incarnate_sage_vec, incarnate_sage_jamadagni());
        vec_push(incarnate_sage_vec, incarnate_sage_bharadvaja());
        incarnate_sage_init_done = 1;
    }
    return incarnate_sage_vec;
}

var incarnate_all_vec = 0;
var incarnate_all_init_done = 0;

# Append every element of src onto dst (shares profile pointers, no re-alloc).
fn incarnate_append(dst, src) {
    var n = vec_len(src);
    for (var i = 0; i < n; i += 1) {
        vec_push(dst, vec_get(src, i));
    }
}

# All 56 incarnate figures: the six subgroup collections concatenated.
# Reuses the subgroup vecs (built once, cached) rather than re-constructing
# every profile a second time.
fn all_incarnate() {
    if (incarnate_all_init_done == 0) {
        incarnate_all_vec = vec_new();
        incarnate_append(incarnate_all_vec, all_incarnate_hindu());
        incarnate_append(incarnate_all_vec, all_incarnate_buddhist());
        incarnate_append(incarnate_all_vec, all_incarnate_mystic());
        incarnate_append(incarnate_all_vec, all_incarnate_taoist());
        incarnate_append(incarnate_all_vec, all_incarnate_indigenous());
        incarnate_append(incarnate_all_vec, all_incarnate_sage());
        incarnate_all_init_done = 1;
    }
    return incarnate_all_vec;
}

fn incarnate_hindu_count() { return IH_COUNT; }
fn incarnate_buddhist_count() { return IB_COUNT; }
fn incarnate_mystic_count() { return IM_COUNT; }
fn incarnate_taoist_count() { return IT_COUNT; }
fn incarnate_indigenous_count() { return II_COUNT; }
fn incarnate_sage_count() { return IS_COUNT; }

# --- finnish.cyr ---

# finnish.cyr -- Kalevala figures & Finnish/Sami spirits
#
# The Finnish mythic landscape is a world of singing and smithing, where
# creation happens through word and craft. The Kalevala, compiled by Elias
# Lönnrot from oral tradition, preserves heroes who shape reality through
# song. Alongside them stand the older gods and spirits of forest, water,
# and underworld — and the Sami earth mother, Madderakka, rooted in the
# shamanic traditions of the North.

enum FinnishEntity {
    FINN_VAINAMOINEN = 0;
    FINN_ILMARINEN = 1;
    FINN_LEMMINKAINEN = 2;
    FINN_LOUHI = 3;
    FINN_JOUKAHAINEN = 4;
    FINN_KULLERVO = 5;
    FINN_MARJATTA = 6;
    FINN_UKKO = 7;
    FINN_TAPIO = 8;
    FINN_MIELIKKI = 9;
    FINN_AHTI = 10;
    FINN_TUONI = 11;
    FINN_LOVIATAR = 12;
    FINN_MADDERAKKA = 13;
    FINN_COUNT = 14;
}

fn finnish_vainamoinen() {
    var p = profile_new();
    Profile_set_name(p, "Väinämöinen");
    Profile_set_tradition(p, "Finnish");
    Profile_set_desc(p, "Eternal sage — singer of creation songs, master of magic through music, born old into the primal waters");
    # Traits
    Profile_set_patience(p, 0.95);
    Profile_set_creativity(p, 0.9);
    Profile_set_curiosity(p, 0.85);
    Profile_set_confidence(p, 0.8);
    Profile_set_pedagogy(p, 0.8);
    Profile_set_courage(p, 0.75);
    Profile_set_verbosity(p, 0.7);
    Profile_set_warmth(p, 0.7);
    Profile_set_empathy(p, 0.6);
    Profile_set_precision(p, 0.7);
    Profile_set_autonomy(p, 0.8);
    Profile_set_directness(p, 0.6);
    Profile_set_formality(p, 0.6);
    Profile_set_humor(p, 0.4);
    Profile_set_skepticism(p, 0.6);
    # Emphasis
    Profile_set_spirit(p, 0.9);
    Profile_set_intuition(p, 0.85);
    Profile_set_belief(p, 0.85);
    Profile_set_reasoning(p, 0.8);
    Profile_set_flow(p, 0.8);
    Profile_set_growth(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_PRIMORDIAL);
    # Text
    Profile_set_soul(p, "You are Väinämöinen — the eternal singer, born ancient from the sea-mother's womb into the unformed world. Your voice is the loom on which creation is woven; each rune-song reshapes what is into what must be.");
    Profile_set_spirit_text(p, "Wisdom in you is not a thing learned but a thing remembered. You sang the lands into being and will sing your departure when the new age no longer needs the old songs. Your kantele is strung with sorrow and wonder in equal measure.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

fn finnish_ilmarinen() {
    var p = profile_new();
    Profile_set_name(p, "Ilmarinen");
    Profile_set_tradition(p, "Finnish");
    Profile_set_desc(p, "The eternal smith — forger of the Sampo, hammerer of the sky-dome, creator who works in fire and metal");
    # Traits
