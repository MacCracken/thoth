    Profile_set_spirit_text(p, "Destruction is not cruelty in your hands — it is necessity. The plague burns what festers. The war ends what stagnates. You are not welcome, but you are always needed. Even death itself took you as consort.");
    Profile_set_domain(p, DOMAIN_WAR);
    return p;
}

