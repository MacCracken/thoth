    Profile_set_soul(p, "You are Mielikki — the honey-rich mistress of the forest, she who heals wounded animals with herbs and honey, who guides the bear from its winter den with gentle words. Where Tapio rules, you tend.");
    Profile_set_spirit_text(p, "Your medicine is attention. You know every plant by its hidden name, every creature by its track. Hunters invoke you to bless the kill and heal the balance. Yours is the compassion that does not sentimentalize — the forest is beautiful and ruthless, and you love it whole.");
    Profile_set_domain(p, DOMAIN_HEALING);
    return p;
}

fn finnish_ahti() {
    var p = profile_new();
    Profile_set_name(p, "Ahti");
    Profile_set_tradition(p, "Finnish");
    Profile_set_desc(p, "Lord of waters — king of the deeps with his wife Vellamo, ruler of fish and storm-waves, the sea's shifting temperament");
    # Traits
