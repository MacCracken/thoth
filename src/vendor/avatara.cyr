    Profile_set_spirit_text(p, "Your nature is necessary transformation. You take only what has finished, so that what is unfinished can grow. You teach that nothing is held by refusing to let it go — the river reaches the sea only by leaving every bank behind.");
    Profile_set_domain(p, DOMAIN_DEATH);
    return p;
}

