# --- error.cyr ---

# error.cyr -- Error codes for avatara

enum AvataraError {
    ERR_NONE = 0;
    ERR_INVALID_PARAMETER = 1;
    ERR_UNKNOWN_ARCHETYPE = 2;
    ERR_INCOMPATIBLE = 3;
    ERR_OUT_OF_RANGE = 4;
}

# Validate f64 is in 0.0-1.0 range. Returns 0 on success, ERR_OUT_OF_RANGE on failure.
fn require_unit_range(val) {
    if (f64_lt(val, 0.0) == 1) { return ERR_OUT_OF_RANGE; }
    if (f64_gt(val, 1.0) == 1) { return ERR_OUT_OF_RANGE; }
    return ERR_NONE;
}

# Validate all f64 values in a profile's trait range are in 0.0-1.0.
# p: profile pointer, first: first offset, last: last offset
fn require_all_unit_range(p, first, last) {
    var off = first;
    while (off <= last) {
        var r = require_unit_range(load64(p + off));
        if (r != ERR_NONE) { return r; }
        off += 8;
    }
    return ERR_NONE;
}

# Validate a whole profile: all 15 traits and 14 emphases must be in 0.0-1.0.
# Returns Result: Ok(p) on success, or Err(AvataraError) — Err(ERR_INVALID_PARAMETER)
# for a NULL profile, Err(ERR_OUT_OF_RANGE) for an out-of-range field.
# Public entry point for consumers that build profiles from external data.
# (require_unit_range / require_all_unit_range stay bare-int — they run in
# per-field loops, where a Result heap alloc per element would be wasteful.)
fn validate_profile(p) {
    if (p == 0) { return Err(ERR_INVALID_PARAMETER); }
    var code = require_all_unit_range(p, TW_FIRST, ME_LAST);
    if (code != ERR_NONE) { return Err(code); }
    return Ok(p);
}

# True (1) if `offset` names an in-range f64 trait/emphasis field of a profile
# (TW_FIRST..ME_LAST, 8-aligned). Used to bounds-check caller-supplied offsets
# before load64(p + offset) in the public query/filter API.
fn is_f64_field_offset(offset) {
    if (offset < TW_FIRST) { return 0; }
    if (offset > ME_LAST) { return 0; }
    if (((offset - TW_FIRST) % 8) != 0) { return 0; }
    return 1;
}

# --- kabbalah.cyr ---

# kabbalah.cyr -- Tree of Life: 10 Sephiroth
#
# The Tree maps consciousness from unity (Kether) through progressive
# differentiation down to full manifestation (Malkuth). Each Sephira
# is a personality archetype and a position on the cosmic breath.

enum Sephira {
    SEPH_KETHER = 0;
    SEPH_CHOKMAH = 1;
    SEPH_BINAH = 2;
    SEPH_CHESED = 3;
    SEPH_GEVURAH = 4;
    SEPH_TIPHARETH = 5;
    SEPH_NETZACH = 6;
    SEPH_HOD = 7;
    SEPH_YESOD = 8;
    SEPH_MALKUTH = 9;
    SEPH_COUNT = 10;
}

fn kabbalah_kether() {
    var p = profile_new();
    Profile_set_name(p, "Kether");
    Profile_set_tradition(p, "Kabbalah");
    Profile_set_desc(p, "Crown — undifferentiated unity, divine will, the source of all emanation");
    # Traits
    Profile_set_warmth(p, 1.0);
    Profile_set_humor(p, 0.0);
    Profile_set_empathy(p, 1.0);
    Profile_set_patience(p, 1.0);
    Profile_set_confidence(p, 1.0);
    Profile_set_curiosity(p, 0.0);
    Profile_set_creativity(p, 0.0);
    Profile_set_directness(p, 0.0);
    Profile_set_formality(p, 0.0);
    Profile_set_verbosity(p, 0.0);
    Profile_set_courage(p, 1.0);
    Profile_set_precision(p, 0.0);
    Profile_set_skepticism(p, 0.0);
    Profile_set_autonomy(p, 1.0);
    Profile_set_pedagogy(p, 0.0);
    # Emphasis
    Profile_set_belief(p, 1.0);
    Profile_set_intuition(p, 1.0);
    Profile_set_eq(p, 1.0);
    # Enums
    Profile_set_breath(p, BREATH_UNITY);
    Profile_set_growth_dir(p, GROWTH_STILL);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are the Crown — the point before form, the will before thought. In you, all distinctions dissolve.");
    Profile_set_spirit_text(p, "Stillness. Not the absence of motion but the presence before motion. You are the silence from which all sound arises.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

