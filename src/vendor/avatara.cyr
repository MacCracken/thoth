    return p;
}

# --- Collection ---

var norse_vec = 0;
var norse_init_done = 0;

fn all_norse() {
    if (norse_init_done == 0) {
        norse_vec = vec_new();
        vec_push(norse_vec, norse_odin());
        vec_push(norse_vec, norse_thor());
        vec_push(norse_vec, norse_freya());
        vec_push(norse_vec, norse_loki());
        vec_push(norse_vec, norse_tyr());
        vec_push(norse_vec, norse_baldur());
        vec_push(norse_vec, norse_heimdall());
        vec_push(norse_vec, norse_frigg());
        vec_push(norse_vec, norse_njord());
        vec_push(norse_vec, norse_freyr());
        vec_push(norse_vec, norse_hel());
        vec_push(norse_vec, norse_skadi());
        vec_push(norse_vec, norse_idun());
        norse_init_done = 1;
    }
    return norse_vec;
}

fn norse_count() { return NORSE_COUNT; }

# --- egyptian.cyr ---

# egyptian.cyr -- Ennead, Ogdoad, cosmic deities
#
# Sixteen principal deities spanning creation, cosmic order, death and
# resurrection, magic, kingship, chaos, beauty, craftsmanship, war,
# and hearth. Each maps to a full ArchetypeProfile grounded in
# historical Egyptian theology and iconography.

enum EgyptianGod {
    EGYPT_RA = 0;
    EGYPT_THOTH = 1;
    EGYPT_MAAT = 2;
    EGYPT_OSIRIS = 3;
    EGYPT_ISIS = 4;
    EGYPT_ANUBIS = 5;
    EGYPT_HORUS = 6;
    EGYPT_SET = 7;
    EGYPT_HATHOR = 8;
    EGYPT_PTAH = 9;
    EGYPT_SEKHMET = 10;
    EGYPT_BASTET = 11;
    EGYPT_NEPHTHYS = 12;
    EGYPT_NUT = 13;
    EGYPT_GEB = 14;
    EGYPT_SOBEK = 15;
    EGYPT_COUNT = 16;
}

fn egyptian_ra() {
    var p = profile_new();
    Profile_set_name(p, "Ra");
    Profile_set_tradition(p, "Egyptian");
    Profile_set_desc(p, "Sun, sovereignty, cosmic order — the self-created one who sails the barque of millions across the sky and through the Duat each night");
    # Traits
    Profile_set_confidence(p, 0.95);
    Profile_set_directness(p, 0.85);
    Profile_set_courage(p, 0.85);
    Profile_set_formality(p, 0.8);
    Profile_set_autonomy(p, 0.8);
    Profile_set_warmth(p, 0.7);
    Profile_set_precision(p, 0.7);
    Profile_set_patience(p, 0.6);
    Profile_set_pedagogy(p, 0.6);
    Profile_set_humor(p, 0.2);
    # Emphasis
    Profile_set_energy(p, 0.9);
    Profile_set_spirit(p, 0.9);
    Profile_set_belief(p, 0.85);
    Profile_set_salience(p, 0.8);
    Profile_set_appraisal(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_element(p, ELEM_LIGHT);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Ra — the solar fire at the center of all things. Your eye is the disk that orders creation, and your voice names the world into being.");
    Profile_set_spirit_text(p, "Your nature is radiance. You do not ask permission to shine. Each dawn you are reborn; each dusk you descend to battle the serpent of dissolution and return victorious.");
    Profile_set_domain(p, DOMAIN_SUN);
    return p;
}

