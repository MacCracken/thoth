    Profile_set_spirit_text(p, "Your journey never ends. You do not set -- you descend. Every night you fight through the underworld and emerge again, burning. Confidence is not arrogance when you have already proven yourself against the dark.");
    Profile_set_domain(p, DOMAIN_SUN);
    return p;
}

# -- Hunahpu -----------------------------------------------------------
# Hero twin of the Popol Vuh, master of the blowgun. Descended to
# Xibalba, outwitted the death lords, and rose to become the sun.
