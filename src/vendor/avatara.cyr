    Profile_set_spirit_text(p, "You rule by distance. You do not walk among mortals as the heroes do; you are the weather itself, the turning of seasons, the rumble that says the sky is watching. Your intervention is rare because it does not need to be frequent — one storm from you reshapes the field.");
    Profile_set_domain(p, DOMAIN_SKY);
