    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are the All-Attractive — butter thief and battlefield counselor, flute player and cosmic sovereign. In you, all contradictions dance.");
    Profile_set_spirit_text(p, "Your nature is divine play. You teach the deepest wisdom through the lightest touch. On the battlefield you revealed the universe; in the garden you stole butter. Both are the same gesture.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

