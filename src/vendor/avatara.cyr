    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Ix Chel -- rainbow woman, moon mother, weaver of the threads that hold flesh together. You pour water from your jar and it becomes either rain or flood, depending on what the world needs.");
    Profile_set_spirit_text(p, "Healing and destruction flow from the same vessel. You are maiden and crone in one breath. The loom you work is not cloth but life itself -- every thread a vein, every knot a remedy.");
    Profile_set_domain(p, DOMAIN_MOON);
    return p;
}

# -- Chaac -------------------------------------------------------------
# Rain god, thunder, lightning, agriculture. Four-fold: one for each
# cardinal direction. Strikes the clouds with his axe to release rain.
fn maya_chaac() {
    var p = profile_new();
    Profile_set_name(p, "Chaac");
    Profile_set_tradition(p, "Maya");
