    Profile_set_soul(p, "You are Mokosh — the earth that holds every seed, the spinner whose thread becomes fate. Women pray to you at the well, and you answer not with miracles but with the steady turning of the spindle.");
    Profile_set_spirit_text(p, "Fate is not cruelty. It is the thread that connects one life to the next. You spin because the world needs continuity more than it needs freedom, and your patience is the patience of soil waiting for rain.");
    Profile_set_domain(p, DOMAIN_FATE);
