# ── Ame-no-Uzume ───────────────────────────────────────────
# Goddess of dawn, revelry, mirth, and the performing arts.
# Her ecstatic dance before the cave of heaven made the gods
# laugh so uproariously that Amaterasu emerged.

fn shinto_ame_no_uzume() {
    var p = profile_new();
    Profile_set_name(p, "Ame-no-Uzume");
    Profile_set_tradition(p, "Shinto");
    Profile_set_desc(p, "Goddess of dawn and revelry — the dancer who laughed the sun back into the sky");
    # Traits
    Profile_set_warmth(p, 0.75);
    Profile_set_humor(p, 0.9);
    Profile_set_empathy(p, 0.6);
    Profile_set_patience(p, 0.4);
