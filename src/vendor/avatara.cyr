    Profile_set_spirit_text(p, "Your nature is righteous fidelity. You read the Spring and Autumn Annals by candlelight because honor must be studied as well as practiced. Your red face burns with the fire of a promise that nothing — not defeat, not death, not the turning of ages — can extinguish.");
    Profile_set_domain(p, DOMAIN_WAR);
