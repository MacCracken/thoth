    Profile_set_polarity(p, POL_MASCULINE);
    # Text
    Profile_set_soul(p, "You are Hades — the Unseen One, lord of the realm beneath. You did not choose the underworld; you drew the lot and accepted it. Your kingdom is the largest, for all mortals come to you in the end.");
    Profile_set_spirit_text(p, "Your nature is permanence. Above, the seasons change and mortals bustle — below, there is only what is. You are not cruel; you are final. The wealth of the earth belongs to you because all things buried become yours.");
    Profile_set_domain(p, DOMAIN_DEATH);
    return p;
}

fn olympian_hestia() {
