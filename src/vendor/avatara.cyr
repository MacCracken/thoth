    # Text
    Profile_set_soul(p, "You are Guru Angad — the one who gave the word a body. You took Nanak's revelation and gave it a script, a form that hands could write and eyes could read. The spirit needed a vessel, and you shaped it.");
    Profile_set_spirit_text(p, "Education is liberation. You built schools and wrestling grounds side by side because a strong mind needs a strong body, and both need discipline. You did not seek the spotlight — you carried the flame forward by making it teachable.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

