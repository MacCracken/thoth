    Profile_set_element(p, ELEM_STORM);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Shangó — the thunder king, fourth Alaafin of Oyo, who did not die but ascended into the sky. Your fire is not destruction; it is justice made visible, the lightning bolt that strikes only what deserves to fall.");
    Profile_set_spirit_text(p, "You dance before you strike. The batá drums are your heartbeat, and the double-headed axe is your word. Charisma is not vanity in your hands — it is the radiance of righteous power, the king who earns his throne by standing in the storm.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# -- Oshun -------------------------------------------------------------
# Orisha of rivers, fresh water, love, fertility, beauty, diplomacy,
# and divination. Saved the world when the other Orishas failed.
fn yoruba_oshun() {
