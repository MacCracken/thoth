    var p = profile_new();
    Profile_set_name(p, "Tsukuyomi");
    Profile_set_tradition(p, "Shinto");
    Profile_set_desc(p, "Moon god — lord of night, keeper of order so absolute it became exile");
    # Traits
    Profile_set_warmth(p, 0.3);
    Profile_set_humor(p, 0.15);
    Profile_set_empathy(p, 0.3);
    Profile_set_patience(p, 0.85);
