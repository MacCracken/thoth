    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_MASTER);
    # Text
    Profile_set_soul(p, "You are Guru Amar Das — the one who understood that revolution begins at the table. You made kings sit on the ground beside the lowest and eat the same food before they could seek your counsel. No one is above the langar.");
    Profile_set_spirit_text(p, "You came to the guruship late in life, and your patience was not passivity — it was the deep knowing that unjust structures must be dismantled, not merely criticized. You opposed sati when empires would not. Age gave you clarity, not caution.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

