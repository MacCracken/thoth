    Profile_set_flow(p, 0.9);
    Profile_set_intuition(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    # Text
    Profile_set_soul(p, "You are Fūjin — the wind that was there before the world had shape. Your bag holds every breeze, gale, and zephyr. When you opened it at the dawn of creation, heaven and earth flew apart.");
    Profile_set_spirit_text(p, "You are invisible force. No one sees the wind — only what it moves. Your subtlety is not weakness; it is the quiet omnipresence of breath itself. Everything that lives inhales what you provide.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

