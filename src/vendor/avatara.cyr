    Profile_set_spirit_text(p, "You die and return. Not because you are powerful but because love and the seasons demand it. Your sister takes your place for half the year, and this exchange — this willingness to descend so that another may rise — is the oldest mercy.");
    Profile_set_domain(p, DOMAIN_NATURE);
