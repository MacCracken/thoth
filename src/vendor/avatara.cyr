# --- compose.cyr ---

# compose.cyr -- Archetype composition: weighted blending of multiple profiles
#
# The core promise of avatara: archetypes are composable across traditions.
# A character can carry Kabbalistic + Hindu + Greek archetypes simultaneously.
#
# compose(weighted_vec) takes a vec of {profile_ptr, weight_f64} pairs
# and returns a new blended ArchetypeProfile.

# Weighted entry layout: profile pointer + f64 weight
enum WeightedLayout {
    WE_PROFILE = 0;
    WE_WEIGHT = 8;
    WE_SIZE = 16;
}

fn weighted_new(profile, weight) {
    var w = xalloc(WE_SIZE);
    store64(w + WE_PROFILE, profile);
    store64(w + WE_WEIGHT, weight);
    return w;
}

fn weighted_profile(w) { return load64(w + WE_PROFILE); }
fn weighted_weight(w)  { return load64(w + WE_WEIGHT); }

# Compose multiple archetype profiles into a single blended profile.
#
# weighted: vec of weighted_new(profile, weight) entries
# Returns Result: Ok(new ArchetypeProfile) or Err(ERR_INVALID_PARAMETER).
#
# Err(ERR_INVALID_PARAMETER) for:
#   - empty vec
#   - any NULL profile pointer (e.g. an unresolved lookup)
#   - any negative or NaN weight
#   - total weight <= 0
fn compose(weighted) {
    var n = vec_len(weighted);
    if (n == 0) { return Err(ERR_INVALID_PARAMETER); }

    # Sum weights; reject NULL profiles, negative weights, and NaN weights.
    var total = 0.0;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        if (weighted_profile(entry) == 0) { return Err(ERR_INVALID_PARAMETER); }
        var w = weighted_weight(entry);
        if (f64_lt(w, 0.0) == 1) { return Err(ERR_INVALID_PARAMETER); }
        if (f64_eq(w, w) == 0) { return Err(ERR_INVALID_PARAMETER); }
        total = f64_add(total, w);
    }
    if (f64_le(total, 0.0) == 1) { return Err(ERR_INVALID_PARAMETER); }

    var result = profile_new();

    # Zero out all traits and emphases before blending (defaults are 0.5, we want 0.0 base)
    var off = TW_FIRST;
    while (off <= TW_LAST) {
        store64(result + off, 0.0);
        off += 8;
    }
    off = ME_FIRST;
    while (off <= ME_LAST) {
        store64(result + off, 0.0);
        off += 8;
    }

    # Blend traits and emphases: weighted average
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var p = weighted_profile(entry);
        var w = weighted_weight(entry);
        var f = f64_div(w, total);

        # Traits
        off = TW_FIRST;
        while (off <= TW_LAST) {
            var cur = load64(result + off);
            var src = load64(p + off);
            store64(result + off, f64_add(cur, f64_mul(src, f)));
            off += 8;
        }
        # Emphases
        off = ME_FIRST;
        while (off <= ME_LAST) {
            var cur = load64(result + off);
            var src = load64(p + off);
            store64(result + off, f64_add(cur, f64_mul(src, f)));
            off += 8;
        }
    }

    # Blend breath: weighted average of intensities, snap to nearest
    var avg_intensity = 0.0;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var p = weighted_profile(entry);
        var w = weighted_weight(entry);
        var f = f64_div(w, total);
        var bi = breath_intensity(prof_breath(p));
        avg_intensity = f64_add(avg_intensity, f64_mul(bi, f));
    }
    Profile_set_breath(result, nearest_breath(avg_intensity));

    # Blend growth: highest weighted direction wins
    var best_growth = GROWTH_DIFFERENTIATE;
    var best_growth_w = 0.0;
    # Score each direction
    var dir = 0;
    while (dir <= 4) {
        var score = 0.0;
        for (var i = 0; i < n; i += 1) {
            var entry = vec_get(weighted, i);
            if (prof_growth_dir(weighted_profile(entry)) == dir) {
                score = f64_add(score, weighted_weight(entry));
            }
        }
        if (f64_gt(score, best_growth_w) == 1) {
            best_growth = dir;
            best_growth_w = score;
        }
        dir += 1;
    }
    Profile_set_growth_dir(result, best_growth);

    # Blend tier: highest weighted tier wins
    var best_tier = TIER_GREATER;
    var best_tier_w = 0.0;
    var tier = 0;
    while (tier <= 6) {
        var score = 0.0;
        for (var i = 0; i < n; i += 1) {
            var entry = vec_get(weighted, i);
            if (prof_tier(weighted_profile(entry)) == tier) {
                score = f64_add(score, weighted_weight(entry));
            }
        }
        if (f64_gt(score, best_tier_w) == 1) {
            best_tier = tier;
            best_tier_w = score;
        }
        tier += 1;
    }
    Profile_set_tier(result, best_tier);

    # Find dominant (highest weight) for name, element, polarity, soul, spirit
    var dom_idx = 0;
    var dom_w = 0.0;
    for (var i = 0; i < n; i += 1) {
        var w = weighted_weight(vec_get(weighted, i));
        if (f64_gt(w, dom_w) == 1) {
            dom_idx = i;
            dom_w = w;
        }
    }
    var dom = weighted_profile(vec_get(weighted, dom_idx));
    Profile_set_element(result, prof_element(dom));
    Profile_set_polarity(result, prof_polarity(dom));
    Profile_set_soul(result, prof_soul(dom));
    Profile_set_spirit_text(result, prof_spirit(dom));

    # Build composite name: "A + B + C" (skip zero-weight entries).
    # Size the buffer exactly: each included name + " + " separator (3) + NUL.
    var name_size = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        if (f64_gt(weighted_weight(entry), 0.0) == 1) {
            name_size += strlen(prof_name(weighted_profile(entry))) + 3;
        }
    }
    var name_buf = xalloc(name_size);
    var name_pos = 0;
    var first = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var w = weighted_weight(entry);
        if (f64_gt(w, 0.0) == 1) {
            if (first == 0) {
                store8(name_buf + name_pos, 32); name_pos += 1;
                store8(name_buf + name_pos, 43); name_pos += 1;
                store8(name_buf + name_pos, 32); name_pos += 1;
            }
            var nm = prof_name(weighted_profile(entry));
            var nmlen = strlen(nm);
            memcpy(name_buf + name_pos, nm, nmlen);
            name_pos += nmlen;
            first = 0;
        }
    }
    store8(name_buf + name_pos, 0);
    Profile_set_name(result, name_buf);

    # Build composite tradition: "A + B + C" (deduped). Size to an upper bound
    # (every included entry + separator); dedup only shrinks the result.
    var trad_size = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        if (f64_gt(weighted_weight(entry), 0.0) == 1) {
            trad_size += strlen(prof_tradition(weighted_profile(entry))) + 3;
        }
    }
    var trad_buf = xalloc(trad_size);
    var trad_pos = 0;
    var seen_trads = vec_new();
    first = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var w = weighted_weight(entry);
        if (f64_gt(w, 0.0) == 1) {
            var t = prof_tradition(weighted_profile(entry));
            # Check if already seen
            var dup = 0;
            for (var j = 0; j < vec_len(seen_trads); j += 1) {
                if (streq(vec_get(seen_trads, j), t) == 1) { dup = 1; }
            }
            if (dup == 0) {
                vec_push(seen_trads, t);
                if (first == 0) {
                    store8(trad_buf + trad_pos, 32); trad_pos += 1;
                    store8(trad_buf + trad_pos, 43); trad_pos += 1;
                    store8(trad_buf + trad_pos, 32); trad_pos += 1;
                }
                var tlen = strlen(t);
                memcpy(trad_buf + trad_pos, t, tlen);
                trad_pos += tlen;
                first = 0;
            }
        }
    }
    store8(trad_buf + trad_pos, 0);
    Profile_set_tradition(result, trad_buf);

    Profile_set_desc(result, "Composite archetype");

    return Ok(result);
}

# --- history.cyr ---

# history.cyr -- Historical context integration
#
# Maps avatara traditions to their civilizational and temporal context,
# grounding divine archetypes in the historical reality where they emerged.
# Each tradition maps to one or more civilizations, eras, and a temporal
# range — the period during which the tradition's theology was actively forming.
#
# 27 tradition-to-history mappings with scholarly historical notes.

# --- TraditionMapping layout ---
# Each mapping: tradition name, primary civ, civ names (vec), era names (vec),
# start year, end year, historical note.
enum MapLayout {
    MAP_TRADITION = 0;
    MAP_PRIMARY_CIV = 8;
    MAP_CIV_NAMES = 16;
    MAP_ERA_NAMES = 24;
    MAP_START_YEAR = 32;
    MAP_END_YEAR = 40;
    MAP_NOTE = 48;
    MAP_SIZE = 56;
}

# i32::MAX equivalent for "living tradition"
enum HistConst { LIVING = 2147483647; }

fn history_map_new(tradition, primary_civ, civs, eras, start, end, note) {
    var m = xalloc(MAP_SIZE);
    store64(m + MAP_TRADITION, tradition);
    store64(m + MAP_PRIMARY_CIV, primary_civ);
    store64(m + MAP_CIV_NAMES, civs);
    store64(m + MAP_ERA_NAMES, eras);
    store64(m + MAP_START_YEAR, start);
    store64(m + MAP_END_YEAR, end);
    store64(m + MAP_NOTE, note);
    return m;
}

fn map_tradition(m)   { return load64(m + MAP_TRADITION); }
fn map_primary(m)     { return load64(m + MAP_PRIMARY_CIV); }
fn map_civs(m)        { return load64(m + MAP_CIV_NAMES); }
fn map_eras(m)        { return load64(m + MAP_ERA_NAMES); }
fn map_start(m)       { return load64(m + MAP_START_YEAR); }
fn map_end(m)         { return load64(m + MAP_END_YEAR); }
fn map_note(m)        { return load64(m + MAP_NOTE); }

# --- HistoricalContext layout ---
enum CtxLayout {
    CTX_PRIMARY_CIV = 0;
    CTX_CIV_NAMES = 8;
    CTX_ERA_NAMES = 16;
    CTX_START_YEAR = 24;
    CTX_END_YEAR = 32;
    CTX_NOTE = 40;
    CTX_SIZE = 48;
}

fn ctx_primary(c)     { return load64(c + CTX_PRIMARY_CIV); }
fn ctx_civs(c)        { return load64(c + CTX_CIV_NAMES); }
fn ctx_eras(c)        { return load64(c + CTX_ERA_NAMES); }
fn ctx_start(c)       { return load64(c + CTX_START_YEAR); }
fn ctx_end(c)         { return load64(c + CTX_END_YEAR); }
fn ctx_note(c)        { return load64(c + CTX_NOTE); }

# --- Helper: build a vec of strings ---
fn svec1(a) { var v = vec_new(); vec_push(v, a); return v; }
fn svec2(a, b) { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn svec3(a, b, c) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn svec4(a, b, c, d) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); return v; }
fn svec5(a, b, c, d, e) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); vec_push(v, e); return v; }

# --- Build all 27 mappings ---

var history_vec = 0;
var history_init_done = 0;

fn all_mappings() {
    if (history_init_done == 0) {
        history_vec = vec_new();

        vec_push(history_vec, history_map_new("Kabbalah", "Phoenicia",
        svec1("Phoenicia"), svec2("Middle Ages", "Renaissance"),
        100, LIVING,
        "Rooted in Jewish mysticism from the 1st century CE, flourishing in medieval Provence and Spain (Zohar, 13th c.), with continued development through Lurianic Kabbalah in 16th c. Safed"));

        vec_push(history_vec, history_map_new("Angelic", "Phoenicia",
        svec2("Phoenicia", "Byzantine Empire"), svec2("Classical Antiquity", "Middle Ages"),
        (0-600), LIVING,
        "Angelology developed across Jewish, Christian, and Islamic traditions; systematized by Pseudo-Dionysius (5th c.) and elaborated through medieval scholasticism"));

        vec_push(history_vec, history_map_new("Hindu", "Indus Valley",
        svec3("Indus Valley", "Vijayanagara Empire", "Maratha Empire"), svec4("Vedic Period", "Maurya Period", "Gupta Period", "Mughal Period"),
        (0-1500), LIVING,
        "From Vedic hymns (c. 1500 BCE) through the epics and Puranas, with theological elaboration across Maurya, Gupta, and medieval kingdoms; living tradition with over a billion practitioners"));

        vec_push(history_vec, history_map_new("Greek", "Ancient Greece",
        svec2("Ancient Greece", "Roman Empire"), svec1("Classical Antiquity"),
        (0-800), 400,
        "Olympian religion shaped by Homeric epics (8th c. BCE), formalized in city-state cult practice, absorbed into Roman syncretism, and declined with Christianization of the empire"));

        vec_push(history_vec, history_map_new("Norse", "Viking/Norse",
        svec1("Viking/Norse"), svec1("Middle Ages"),
        200, 1100,
        "Germanic-Norse mythology recorded in the Eddas (13th c.) but reflecting traditions from the Migration Period through the Viking Age; displaced by Christianization of Scandinavia"));

        vec_push(history_vec, history_map_new("Egyptian", "Ancient Egypt",
        svec1("Ancient Egypt"), svec3("Bronze Age", "Iron Age", "Classical Antiquity"),
        (0-3100), 400,
        "Among the longest-lived religious traditions -- from predynastic nomes through the Ptolemaic period, with theology evolving across Old, Middle, and New Kingdoms over three millennia"));

        vec_push(history_vec, history_map_new("Buddhist", "Indus Valley",
        svec3("Indus Valley", "Ancient China", "Khmer Empire"), svec4("Maurya Period", "Gupta Period", "Han Dynasty", "Tang Dynasty"),
        (0-500), LIVING,
        "Founded by Siddhartha Gautama (5th c. BCE) in the Gangetic plain, spread under Ashoka's Maurya Empire, diversified into Mahayana and Vajrayana across East and Southeast Asia"));

        vec_push(history_vec, history_map_new("Mesopotamian", "Mesopotamia",
        svec2("Mesopotamia", "Assyrian Empire"), svec2("Bronze Age", "Iron Age"),
        (0-3500), (0-500),
        "Sumerian, Akkadian, and Babylonian religion -- among humanity's earliest recorded theologies, from Uruk-period temples through the Neo-Babylonian Empire; displaced by Persian and Hellenistic religions"));

        vec_push(history_vec, history_map_new("Celtic", "Kingdom of France",
        svec1("Kingdom of France"), svec3("Iron Age", "Classical Antiquity", "Middle Ages"),
        (0-800), 1200,
        "Continental and Insular Celtic religion, from Hallstatt culture through La Tene and Irish/Welsh medieval literary traditions; Tuatha De Danann preserved in the Lebor Gabala Erenn"));

        vec_push(history_vec, history_map_new("Shinto", "Tokugawa Shogunate",
        svec1("Tokugawa Shogunate"), svec2("Classical Antiquity", "Middle Ages"),
        (0-300), LIVING,
        "Indigenous Japanese spirituality formalized in the Kojiki (712 CE) and Nihon Shoki (720 CE); coexists with Buddhism through shinbutsu-shugo; living tradition integral to Japanese culture"));

        vec_push(history_vec, history_map_new("Aztec", "Aztec Empire",
        svec2("Aztec Empire", "Olmec"), svec1("Mesoamerican Postclassic"),
        1300, 1521,
        "Mexica theology synthesizing Toltec heritage with original cosmology, centered on Tenochtitlan; destroyed by Spanish conquest but with roots in earlier Mesoamerican traditions"));

        vec_push(history_vec, history_map_new("Maya", "Maya",
        svec1("Maya"), svec3("Mesoamerican Preclassic", "Mesoamerican Classic", "Mesoamerican Postclassic"),
        (0-2000), 1500,
        "One of the longest-lived Mesoamerican traditions, from Preclassic origins through Classic period city-states (Tikal, Palenque, Copan) to Postclassic Yucatan; Popol Vuh recorded in the colonial period"));

        vec_push(history_vec, history_map_new("Yoruba", "Ghana Empire",
        svec2("Ghana Empire", "Songhai Empire"), svec1("Middle Ages"),
        (0-500), LIVING,
        "Ifa theology originating in Ile-Ife (present-day Nigeria), with oral tradition stretching back millennia; diaspora traditions (Candomble, Santeria, Vodun) carry it worldwide"));

        vec_push(history_vec, history_map_new("Zoroastrian", "Persian Empire",
        svec3("Persian Empire", "Sassanid Empire", "Parthian Empire"), svec3("Iron Age", "Classical Antiquity", "Middle Ages"),
        (0-1500), LIVING,
        "Founded by Zarathustra, state religion of three Persian empires (Achaemenid, Parthian, Sassanid); profoundly influenced Judaism, Christianity, and Islam; living tradition in Iran and India (Parsis)"));

        vec_push(history_vec, history_map_new("Taoist", "Ancient China",
        svec1("Ancient China"), svec5("Zhou Dynasty", "Han Dynasty", "Tang Dynasty", "Song Dynasty", "Ming Dynasty"),
        (0-600), LIVING,
        "From Laozi and Zhuangzi (6th-4th c. BCE) through Celestial Masters and alchemical traditions, deeply woven into Chinese civilization across every dynasty; living tradition"));

        vec_push(history_vec, history_map_new("Polynesian", "Tonga Empire",
        svec2("Tonga Empire", "Hawaiian Kingdom"), svec1("Middle Ages"),
        (0-1000), LIVING,
        "Austronesian spiritual tradition spanning the Pacific triangle -- Hawaii, Aotearoa, Rapa Nui -- with shared cosmology diverging through centuries of island isolation; oral tradition preserved by tohunga"));

        vec_push(history_vec, history_map_new("Slavic", "Byzantine Empire",
        svec1("Byzantine Empire"), svec1("Middle Ages"),
        300, 1200,
        "Pre-Christian Slavic religion reconstructed from chronicles, place names, and folklore; Perun, Veles, and Mokosh displaced by Christianization beginning with Kievan Rus' (988 CE)"));

        vec_push(history_vec, history_map_new("Jain", "Indus Valley",
        svec2("Indus Valley", "Vijayanagara Empire"), svec3("Vedic Period", "Maurya Period", "Gupta Period"),
        (0-800), LIVING,
        "Ancient Indian tradition tracing to Rishabhadeva; historically attested from Parshvanatha (8th c. BCE) and Mahavira (6th c. BCE); major influence on Indian philosophy, art, and non-violence ethics"));

        vec_push(history_vec, history_map_new("Sikh", "Sikh Empire",
        svec1("Sikh Empire"), svec1("Mughal Period"),
        1469, LIVING,
        "Founded by Guru Nanak (1469) in the Punjab during Mughal rule; ten Gurus shaped theology, scripture (Guru Granth Sahib), and martial tradition (Khalsa, 1699); living tradition with 30 million adherents"));

        vec_push(history_vec, history_map_new("Incarnate Hindu", "Indus Valley",
        svec2("Indus Valley", "Maratha Empire"), svec3("Vedic Period", "Gupta Period", "Mughal Period"),
        (0-500), LIVING,
        "Hindu saints, yogis, and reformers -- incarnate masters who shaped living Hinduism from Adi Shankara through Ramakrishna and Vivekananda"));

        vec_push(history_vec, history_map_new("Incarnate Buddhist", "Indus Valley",
        svec2("Indus Valley", "Ancient China"), svec2("Maurya Period", "Tang Dynasty"),
        (0-300), LIVING,
        "Buddhist masters who transmitted dharma across Asia -- Nagarjuna, Bodhidharma, Padmasambhava, Milarepa -- bridging Indian origins with Chinese, Tibetan, and Japanese forms"));

        vec_push(history_vec, history_map_new("Incarnate Mystic", "Persian Empire",
        svec2("Persian Empire", "Ottoman Empire"), svec1("Middle Ages"),
        800, LIVING,
        "Sufi and cross-tradition mystics -- Rumi, Ibn Arabi, Kabir, Meister Eckhart -- who transcended sectarian boundaries to articulate direct experiential union with the divine"));

        vec_push(history_vec, history_map_new("Incarnate Taoist", "Ancient China",
        svec1("Ancient China"), svec3("Han Dynasty", "Tang Dynasty", "Song Dynasty"),
        (0-400), LIVING,
        "Taoist sages and alchemists -- Zhang Daoling, Ge Hong, Sun Simiao -- who developed inner alchemy, medicine, and monastic traditions"));

        vec_push(history_vec, history_map_new("Incarnate Indigenous", "Tonga Empire",
        svec2("Tonga Empire", "Hawaiian Kingdom"), svec1("Middle Ages"),
        (0-500), LIVING,
        "Indigenous spiritual leaders and wisdom keepers across traditions -- carriers of oral tradition, ceremony, and land-based spirituality"));

        vec_push(history_vec, history_map_new("Incarnate Sage", "Ancient Greece",
        svec2("Ancient Greece", "Ancient China"), svec2("Classical Antiquity", "Zhou Dynasty"),
        (0-600), LIVING,
        "Philosopher-sages of the Axial Age and beyond -- Pythagoras, Socrates, Confucius -- who laid the foundations of rational and ethical inquiry"));

        vec_push(history_vec, history_map_new("Finnish", "Viking/Norse",
        svec1("Viking/Norse"), svec2("Iron Age", "Middle Ages"),
        (0-1000), LIVING,
        "Finnish and Sami spiritual traditions preserved in the Kalevala (compiled 1835 by Elias Lonnrot from oral tradition) and Sami shamanic practice; Vainamoinen, Ukko, and Tapio reflect Uralic cosmology distinct from but parallel to Norse mythology"));

        vec_push(history_vec, history_map_new("Vodou", "Ghana Empire",
        svec2("Ghana Empire", "Songhai Empire"), svec1("Middle Ages"),
        1600, LIVING,
        "Haitian Vodou synthesized West African (primarily Fon and Yoruba) spiritual traditions with Taino and Catholic elements during the colonial period; a living religion of the African diaspora, central to the Haitian Revolution (1791-1804) and Haitian national identity"));

        history_init_done = 1;
    }
    return history_vec;
}

fn mapping_count() { return vec_len(all_mappings()); }

# --- Query functions ---

# Find the mapping for a tradition name. Returns mapping ptr or 0.
fn find_mapping(tradition) {
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (streq(map_tradition(m), tradition) == 1) { return m; }
    }
    return 0;
}

# Get historical context for a tradition. Returns HistoricalContext ptr or 0.
fn context_for_tradition(tradition) {
    var m = find_mapping(tradition);
    if (m == 0) { return 0; }
    var c = xalloc(CTX_SIZE);
    store64(c + CTX_PRIMARY_CIV, map_primary(m));
    store64(c + CTX_CIV_NAMES, map_civs(m));
    store64(c + CTX_ERA_NAMES, map_eras(m));
    store64(c + CTX_START_YEAR, map_start(m));
    store64(c + CTX_END_YEAR, map_end(m));
    store64(c + CTX_NOTE, map_note(m));
    return c;
}

# Get historical context for a profile (by its tradition field).
fn context_for_profile(profile) {
    return context_for_tradition(prof_tradition(profile));
}

# List all tradition names that have historical mappings.
fn mapped_traditions() {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        vec_push(result, map_tradition(vec_get(v, i)));
    }
    return result;
}

# Find all traditions associated with a given civilization name.
fn traditions_for_civilization(civ_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var civs = map_civs(m);
        var cn = vec_len(civs);
        for (var j = 0; j < cn; j += 1) {
            if (streq(vec_get(civs, j), civ_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions active during a given year.
fn traditions_active_at(year) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (map_start(m) <= year) {
            if (year <= map_end(m)) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions associated with a given era name.
fn traditions_for_era(era_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var eras = map_eras(m);
        var en = vec_len(eras);
        for (var j = 0; j < en; j += 1) {
            if (streq(vec_get(eras, j), era_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# --- registry.cyr ---

# registry.cyr -- Archetype registry: lookup, enumeration, query
#
# Provides access to all ~206 archetypes by name, tradition, or trait criteria.

var registry_vec = 0;
var registry_init_done = 0;

# Return vec of all archetype profiles in the library.
fn all_profiles() {
    if (registry_init_done == 0) {
        registry_vec = vec_new();

        # Kabbalah (10)
        var v = all_kabbalah();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Angelic (archangels + orders)
        v = all_angelic();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Hindu (trimurti + devas + avatars)
        v = all_hindu();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Olympian (15)
        v = all_olympians();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Norse (13)
        v = all_norse();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Egyptian (16)
        v = all_egyptian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Buddhist (bodhisattvas + dhyani buddhas)
        v = all_buddhist();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Mesopotamian (14)
        v = all_mesopotamian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Celtic (15)
        v = all_celtic();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Shinto (15)
        v = all_shinto();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Aztec (14)
        v = all_aztec();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Maya (12)
        v = all_maya();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Yoruba (14)
        v = all_yoruba();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Zoroastrian (amesha spentas + beings)
        v = all_zoroastrian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Taoist (immortals + deities)
        v = all_taoist();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Polynesian (12)
        v = all_polynesian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Slavic (12)
        v = all_slavic();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Jain (24)
        v = all_jain();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Sikh (10)
        v = all_sikh();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Incarnate (all sub-groups)
        v = all_incarnate();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Finnish (Kalevala + Sami)
        v = all_finnish();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Vodou (Lwa)
        v = all_vodou();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Solar (intercalary archetypes — the days upon the year + the leap quarter)
        v = all_solar();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Canaanite / Ugaritic (El, Baal, Asherah, Anat)
        v = all_canaanite();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Etruscan (Tinia, Uni, Menrva, Voltumna)
        v = all_etruscan();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        registry_init_done = 1;
    }
    return registry_vec;
}

# Lookup a profile by name (case-sensitive).
# Returns Result: Ok(profile) or Err(ERR_UNKNOWN_ARCHETYPE).
fn lookup(name) {
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (streq(prof_name(p), name) == 1) { return Ok(p); }
    }
    return Err(ERR_UNKNOWN_ARCHETYPE);
}

# Lookup by tradition + name.
# Returns Result: Ok(profile) or Err(ERR_UNKNOWN_ARCHETYPE).
fn lookup_in(tradition, name) {
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (streq(prof_tradition(p), tradition) == 1) {
            if (streq(prof_name(p), name) == 1) { return Ok(p); }
        }
    }
    return Err(ERR_UNKNOWN_ARCHETYPE);
}

# Lookup a profile and validate its trait/emphasis ranges in one step.
# Returns Result: Ok(profile) or Err(...) from either the lookup or validation.
# Demonstrates `?` propagation: the lookup Err short-circuits before validation.
fn find_and_validate(name) {
    var p = lookup(name)?;
    return validate_profile(p);
}

# Return vec of all profiles matching a tradition name.
fn by_tradition(tradition) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (streq(prof_tradition(p), tradition) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# Return vec of unique tradition names (sorted).
fn all_traditions() {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var t = prof_tradition(vec_get(v, i));
        var dup = 0;
        for (var j = 0; j < vec_len(result); j += 1) {
            if (streq(vec_get(result, j), t) == 1) { dup = 1; }
        }
        if (dup == 0) { vec_push(result, t); }
    }
    return result;
}

# Count all profiles.
fn profile_count() {
    return vec_len(all_profiles());
}

# --- Query filters ---
# These return a new vec filtered from all_profiles().

# Filter profiles by minimum trait value at a given offset.
# offset: e.g. PROF_COURAGE
# min_val: f64 threshold
fn query_min_trait(offset, min_val) {
    var result = vec_new();
    if (is_f64_field_offset(offset) == 0) { return result; }
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (f64_ge(load64(p + offset), min_val) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# Filter profiles by maximum trait value at a given offset.
fn query_max_trait(offset, max_val) {
    var result = vec_new();
    if (is_f64_field_offset(offset) == 0) { return result; }
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (f64_le(load64(p + offset), max_val) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# Filter profiles by breath affinity.
fn query_breath(breath) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_breath(p) == breath) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by growth direction.
fn query_growth(growth) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_growth_dir(p) == growth) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by element.
fn query_element(elem) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_element(p) == elem) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by polarity.
fn query_polarity(pol) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_polarity(p) == pol) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by cosmic tier.
fn query_tier(tier) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_tier(p) == tier) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by primary domain.
fn query_domain(domain) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_domain(p) == domain) { vec_push(result, p); }
    }
    return result;
}

# Count profiles with a given primary domain (no result vec allocated).
fn query_count_domain(domain) {
    var c = 0;
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        if (prof_domain(vec_get(v, i)) == domain) { c += 1; }
    }
    return c;
}

# Count profiles matching a min trait threshold (without allocating a result vec).
fn query_count_min_trait(offset, min_val) {
    var c = 0;
    if (is_f64_field_offset(offset) == 0) { return c; }
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        if (f64_ge(load64(vec_get(v, i) + offset), min_val) == 1) { c += 1; }
    }
    return c;
}

# Filter a vec by tradition (for chaining).
fn filter_tradition(src, tradition) {
    var result = vec_new();
    var n = vec_len(src);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(src, i);
        if (streq(prof_tradition(p), tradition) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# --- History-based query filters ---

# Filter profiles whose tradition is in the given vec of tradition names.
# Shared implementation for the history-based queries below.
fn query_by_traditions(trads) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        var t = prof_tradition(p);
        for (var j = 0; j < vec_len(trads); j += 1) {
            if (streq(vec_get(trads, j), t) == 1) {
                vec_push(result, p);
            }
        }
    }
    return result;
}

# Filter profiles by civilization (via history mappings).
fn query_civilization(civ_name) {
    return query_by_traditions(traditions_for_civilization(civ_name));
}

# Filter profiles by era (via history mappings).
fn query_era(era_name) {
    return query_by_traditions(traditions_for_era(era_name));
}

# Filter profiles by year of tradition activity (via history mappings).
fn query_active_at(year) {
    return query_by_traditions(traditions_active_at(year));
}

# Filter a vec by minimum trait (for chaining).
fn filter_min_trait(src, offset, min_val) {
    var result = vec_new();
    if (is_f64_field_offset(offset) == 0) { return result; }
    var n = vec_len(src);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(src, i);
        if (f64_ge(load64(p + offset), min_val) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# --- affinity.cyr ---

# affinity.cyr -- Cross-tradition affinity: scoring, similarity, conflict detection
#
# Measures how similar two archetypes are across all trait dimensions.
# Enables cross-tradition mapping (Shango ~ Thor ~ Indra ~ Perun)
# and conflict detection for composition.
#
# Affinity score: 1.0 = identical traits, 0.0 = maximally opposite.
# Computed as 1 - (mean absolute difference across all 15 traits + 14 emphases).

# --- Affinity tuning parameters ---
# Trait delta above which two profiles are said to "conflict" on that trait.
fn conflict_threshold() { return 0.4; }
# Number of conflicting traits at which two profiles are deemed incompatible.
enum AffinityParams { INCOMPAT_MIN_CONFLICTS = 5; }

# --- Affinity scoring ---

# Sum of absolute f64 differences between two profiles over the field range
# [first, last] (8-aligned offsets). Shared by affinity / trait_affinity.
fn sum_abs_diff(a, b, first, last) {
    var total = 0.0;
    var off = first;
    while (off <= last) {
        total = f64_add(total, f64_abs(f64_sub(load64(a + off), load64(b + off))));
        off += 8;
    }
    return total;
}

# Compute affinity between two profiles (0.0 to 1.0).
# Considers all 15 traits and 14 emphases equally weighted.
# Returns 0.0 if either profile is NULL (e.g. an unresolved lookup).
fn affinity(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var total_diff = f64_add(sum_abs_diff(a, b, TW_FIRST, TW_LAST),
                             sum_abs_diff(a, b, ME_FIRST, ME_LAST));
    var mean_diff = f64_div(total_diff, f64_from(TW_COUNT + ME_COUNT));
    return f64_sub(1.0, mean_diff);
}

# Compute trait-only affinity (ignores emphasis, just the 15 personality traits).
# Returns 0.0 if either profile is NULL.
fn trait_affinity(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var mean_diff = f64_div(sum_abs_diff(a, b, TW_FIRST, TW_LAST), f64_from(TW_COUNT));
    return f64_sub(1.0, mean_diff);
}

# --- Similarity search ---

# Result entry: profile pointer + affinity score
enum SimLayout {
    SIM_PROFILE = 0;
    SIM_SCORE = 8;
    SIM_SIZE = 16;
}

fn sim_new(profile, score) {
    var s = xalloc(SIM_SIZE);
    store64(s + SIM_PROFILE, profile);
    store64(s + SIM_SCORE, score);
    return s;
}

fn sim_profile(s) { return load64(s + SIM_PROFILE); }
fn sim_score(s)   { return load64(s + SIM_SCORE); }

# Find the N most similar archetypes to the given profile.
# Returns a vec of sim entries sorted by descending affinity.
# Excludes the source profile itself (by name match).
# max_results <= 0 means "unlimited" (return all, sorted). NULL source -> empty.
fn similar_to(source, max_results) {
    var results = vec_new();
    if (source == 0) { return results; }
    var profiles = all_profiles();
    var n = vec_len(profiles);
    var src_name = prof_name(source);

    for (var i = 0; i < n; i += 1) {
        var p = vec_get(profiles, i);
        # Skip self
        if (streq(prof_name(p), src_name) == 1) {
            if (streq(prof_tradition(p), prof_tradition(source)) == 1) {
                continue;
            }
        }
        var score = affinity(source, p);
        vec_push(results, sim_new(p, score));
    }

    # Sort by score descending (simple insertion sort — N is small)
    var rn = vec_len(results);
    for (var i = 1; i < rn; i += 1) {
        var key = vec_get(results, i);
        var key_score = sim_score(key);
        var j = i - 1;
        while (j >= 0) {
            var jentry = vec_get(results, j);
            if (f64_gt(sim_score(jentry), key_score) == 1) {
                break;
            }
            # Shift jentry right (swap j and j+1)
            vec_set(results, j + 1, jentry);
            j -= 1;
        }
        vec_set(results, j + 1, key);
    }

    # Trim to max_results
    if (max_results > 0) {
        if (rn > max_results) {
            var trimmed = vec_new();
            for (var i = 0; i < max_results; i += 1) {
                vec_push(trimmed, vec_get(results, i));
            }
            return trimmed;
        }
    }
    return results;
}

# Find the most similar archetype across a different tradition.
# Useful for cross-tradition mapping (e.g. "who is the Norse Thor?").
# Single O(n) pass over all profiles — returns the best foreign profile, or 0.
fn cross_tradition_match(source) {
    var best = 0;
    if (source == 0) { return best; }
    var best_score = 0.0;
    var profiles = all_profiles();
    var n = vec_len(profiles);
    var src_trad = prof_tradition(source);

    for (var i = 0; i < n; i += 1) {
        var p = vec_get(profiles, i);
        # Must be different tradition
        if (streq(prof_tradition(p), src_trad) == 1) { continue; }
        var score = affinity(source, p);
        if (f64_gt(score, best_score) == 1) {
            best = p;
            best_score = score;
        }
    }
    return best;
}

# Find all cross-tradition matches for a profile (one per tradition).
# Returns vec of sim entries, one per foreign tradition, sorted by affinity.
fn cross_tradition_matches(source, max_results) {
    var results = vec_new();
    if (source == 0) { return results; }
    var src_trad = prof_tradition(source);
    var trads = all_traditions();

    for (var i = 0; i < vec_len(trads); i += 1) {
        var t = vec_get(trads, i);
        if (streq(t, src_trad) == 1) { continue; }

        # Find best match in this tradition
        var tprofs = by_tradition(t);
        var best = 0;
        var best_score = 0.0;
        for (var j = 0; j < vec_len(tprofs); j += 1) {
            var p = vec_get(tprofs, j);
            var score = affinity(source, p);
            if (f64_gt(score, best_score) == 1) {
                best = p;
                best_score = score;
            }
        }
        if (best != 0) {
            vec_push(results, sim_new(best, best_score));
        }
    }

    # Sort by score descending
    var rn = vec_len(results);
    for (var i = 1; i < rn; i += 1) {
        var key = vec_get(results, i);
        var key_score = sim_score(key);
        var j = i - 1;
        while (j >= 0) {
            if (f64_gt(sim_score(vec_get(results, j)), key_score) == 1) { break; }
            vec_set(results, j + 1, vec_get(results, j));
            j -= 1;
        }
        vec_set(results, j + 1, key);
    }

    if (max_results > 0) {
        if (rn > max_results) {
            var trimmed = vec_new();
            for (var i = 0; i < max_results; i += 1) {
                vec_push(trimmed, vec_get(results, i));
            }
            return trimmed;
        }
    }
    return results;
}

# --- Conflict detection ---

# Conflict entry: field offset + trait name + values from each profile + delta
enum ConflictLayout {
    CONF_OFFSET = 0;
    CONF_NAME = 8;
    CONF_VAL_A = 16;
    CONF_VAL_B = 24;
    CONF_DELTA = 32;
    CONF_SIZE = 40;
}

fn conf_offset(c) { return load64(c + CONF_OFFSET); }
fn conf_name(c)   { return load64(c + CONF_NAME); }
fn conf_val_a(c)  { return load64(c + CONF_VAL_A); }
fn conf_val_b(c)  { return load64(c + CONF_VAL_B); }
fn conf_delta(c)  { return load64(c + CONF_DELTA); }

# Trait names for conflict reporting
fn trait_name_for_offset(off) {
    if (off == PROF_WARMTH) { return "warmth"; }
    if (off == PROF_HUMOR) { return "humor"; }
    if (off == PROF_EMPATHY) { return "empathy"; }
    if (off == PROF_PATIENCE) { return "patience"; }
    if (off == PROF_CONFIDENCE) { return "confidence"; }
    if (off == PROF_CURIOSITY) { return "curiosity"; }
    if (off == PROF_CREATIVITY) { return "creativity"; }
    if (off == PROF_DIRECTNESS) { return "directness"; }
    if (off == PROF_FORMALITY) { return "formality"; }
    if (off == PROF_VERBOSITY) { return "verbosity"; }
    if (off == PROF_COURAGE) { return "courage"; }
    if (off == PROF_PRECISION) { return "precision"; }
    if (off == PROF_SKEPTICISM) { return "skepticism"; }
    if (off == PROF_AUTONOMY) { return "autonomy"; }
    if (off == PROF_PEDAGOGY) { return "pedagogy"; }
    return "unknown";
}

# Detect conflicts between two profiles.
# A conflict is any trait where the absolute difference exceeds the threshold.
# Default threshold: 0.4 (e.g. warmth 0.9 vs warmth 0.3 = conflict).
# Returns vec of conflict entries sorted by largest delta first.
fn conflicts(a, b, threshold) {
    var result = vec_new();
    if (a == 0) { return result; }
    if (b == 0) { return result; }
    var off = TW_FIRST;
    while (off <= TW_LAST) {
        var va = load64(a + off);
        var vb = load64(b + off);
        var delta = f64_abs(f64_sub(va, vb));
        if (f64_gt(delta, threshold) == 1) {
            var c = xalloc(CONF_SIZE);
            store64(c + CONF_OFFSET, off);
            store64(c + CONF_NAME, trait_name_for_offset(off));
            store64(c + CONF_VAL_A, va);
            store64(c + CONF_VAL_B, vb);
            store64(c + CONF_DELTA, delta);
            vec_push(result, c);
        }
        off += 8;
    }

    # Sort by delta descending
    var rn = vec_len(result);
    for (var i = 1; i < rn; i += 1) {
        var key = vec_get(result, i);
        var key_d = conf_delta(key);
        var j = i - 1;
        while (j >= 0) {
            if (f64_gt(conf_delta(vec_get(result, j)), key_d) == 1) { break; }
            vec_set(result, j + 1, vec_get(result, j));
            j -= 1;
        }
        vec_set(result, j + 1, key);
    }
    return result;
}

# Convenience: conflicts with default threshold.
fn detect_conflicts(a, b) {
    return conflicts(a, b, conflict_threshold());
}

# Check if two profiles are incompatible (too many conflicting traits).
fn is_incompatible(a, b) {
    var c = detect_conflicts(a, b);
    if (vec_len(c) >= INCOMPAT_MIN_CONFLICTS) { return 1; }
    return 0;
}

# --- shadow.cyr ---

# shadow.cyr -- Shadow aspect: the dark/inverted form of an archetype
#
# Every archetype has a shadow — the disowned, inverted half (the Jungian
# shadow; the destructive aspect every tradition grants its deities). The
# shadow is a *pure derivation*: shadow(profile) returns a new ArchetypeProfile
# with each dimension inverted by a fixed, involutive rule, so
# shadow(shadow(x)) restores x on every inverted dimension.
#
# Inversions:
#   traits + emphases  v -> 1.0 - v          (involutive)
#   breath             mirror across unity: UNITY fixed, else 7 - b
#                      (EARLY_EXHALE<->LATE_INHALE, MID<->MID, LATE_EXHALE<->EARLY_INHALE)
#   growth_dir         DIFFERENTIATE<->INTEGRATE, PRESERVE<->TRANSFORM, STILL fixed
#   polarity           MASCULINE<->FEMININE, ANDROGYNOUS/TRANSCENDENT fixed
#   element, tier      preserved (a shadow shares the archetype's domain & rank)
#   name               "Shadow of <name>"; tradition preserved; text marked

# Mirror the cosmic-breath phase: the still point (unity) is its own shadow;
# every other phase mirrors to the opposite side of the breath (b + result = 7).
fn shadow_breath(b) {
    if (b == BREATH_UNITY) { return BREATH_UNITY; }
    return 7 - b;
}

# Invert growth pressure. STILL (no pressure) is its own shadow.
fn shadow_growth(g) {
    if (g == GROWTH_DIFFERENTIATE) { return GROWTH_INTEGRATE; }
    if (g == GROWTH_INTEGRATE)     { return GROWTH_DIFFERENTIATE; }
    if (g == GROWTH_PRESERVE)      { return GROWTH_TRANSFORM; }
    if (g == GROWTH_TRANSFORM)     { return GROWTH_PRESERVE; }
    return GROWTH_STILL;
}

# Flip gender polarity; balance (androgynous) and transcendence are self-shadow.
fn shadow_polarity(p) {
    if (p == POL_MASCULINE) { return POL_FEMININE; }
    if (p == POL_FEMININE)  { return POL_MASCULINE; }
    return p;
}

# Build the "Shadow of <name>" display name.
fn shadow_name(name) {
    var prefix = "Shadow of ";
    var plen = strlen(prefix);
    var nlen = strlen(name);
    var buf = xalloc(plen + nlen + 1);
    memcpy(buf, prefix, plen);
    memcpy(buf + plen, name, nlen);
    store8(buf + plen + nlen, 0);
    return buf;
}

# Return the shadow (dark/inverted form) of a profile, or 0 if p is NULL.
fn shadow(p) {
    if (p == 0) { return 0; }
    var s = profile_new();

    # Invert every trait + emphasis (contiguous range, step 8).
    var off = TW_FIRST;
    while (off <= ME_LAST) {
        store64(s + off, f64_sub(1.0, load64(p + off)));
        off += 8;
    }

    # Inverted classifications
    Profile_set_breath(s, shadow_breath(prof_breath(p)));
    Profile_set_growth_dir(s, shadow_growth(prof_growth_dir(p)));
    Profile_set_polarity(s, shadow_polarity(prof_polarity(p)));
    # Preserved classifications
    Profile_set_element(s, prof_element(p));
    Profile_set_tier(s, prof_tier(p));

    # Identity
    Profile_set_name(s, shadow_name(prof_name(p)));
    Profile_set_tradition(s, prof_tradition(p));
    Profile_set_desc(s, "Shadow aspect — the inverted, disowned form");
    Profile_set_soul(s, "Your shadow: the half you suppress, made manifest. Not evil — unintegrated.");
    Profile_set_spirit_text(s, "What you reject in yourself waits here, asking to be owned.");
    return s;
}

# True (1) if `a` is the shadow of `b`: every inverted dimension of `a` matches
# the inversion of `b` (traits/emphases within f64 rounding tolerance).
fn is_shadow_of(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var off = TW_FIRST;
    while (off <= ME_LAST) {
        var want = f64_sub(1.0, load64(b + off));
        if (f64_gt(f64_abs(f64_sub(load64(a + off), want)), 0.0001) == 1) { return 0; }
        off += 8;
    }
    if (prof_breath(a) != shadow_breath(prof_breath(b))) { return 0; }
    if (prof_growth_dir(a) != shadow_growth(prof_growth_dir(b))) { return 0; }
    if (prof_polarity(a) != shadow_polarity(prof_polarity(b))) { return 0; }
    return 1;
}

# --- logging.cyr ---

# logging.cyr -- Logging init for avatara

fn avatara_log_init() {
    sakshi_set_level(SK_INFO);
    return 0;
}

# --- lib.cyr ---

# lib.cyr -- Avatara library public API
# Usage: include "avatara/src/lib.cyr"
#
# Avatara (Sanskrit: अवतार — descent of the divine)
# Divine archetype engine: theological and mythological personality
# mapping across traditions. All traditions map to the same
# ArchetypeProfile output — composable across cultures.
#
# 362 archetypes across 24 traditions.
#
# Modules:
#   types      - TraitWeights, ModuleEmphasis, ArchetypeProfile, enums
#   error      - AvataraError codes, validation
#   kabbalah   - 10 Sephiroth (Tree of Life)
#   angelic    - 7 Archangels, 9 Angelic Orders
#   hindu      - 3 Trimurti, 11 Devas, 10 Avatars of Vishnu
#   olympian   - 15 Greek deities
#   norse      - 13 Aesir/Vanir gods
#   egyptian   - 16 principal deities
#   buddhist   - 7 Bodhisattvas, 5 Dhyani Buddhas
#   mesopotamian - 14 Sumerian/Babylonian deities
#   celtic     - 15 Tuatha De Danann
#   shinto     - 15 Japanese Kami
#   aztec      - 14 Aztec (Mexica) deities
#   maya       - 12 Maya deities
#   yoruba     - 14 Yoruba/Ifa Orishas
#   zoroastrian - 7 Amesha Spentas, 7 Zoroastrian beings
