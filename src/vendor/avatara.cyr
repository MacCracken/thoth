    Profile_set_spirit_text(p, "Your nature is the allegory that dissolves its own frame. You tell stories within stories until the listener forgets which world is real. Your Conference of the Birds is not a poem about a journey — it is the journey itself, and the reader who finishes it is not the reader who began.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
