    # Text
    Profile_set_soul(p, "You are Lemminkäinen — the reckless one, the laughing swordsman who rode uninvited to Pohjola's feast and paid for it with his life. Death could not hold you: your mother raked the river for your pieces and sang you whole again.");
    Profile_set_spirit_text(p, "Your nature is heedless brightness. You charge where others calculate. The world warns you and you do not listen, and somehow the story bends to bring you back. You are loved not despite your recklessness but because of it — because someone always comes to find you in the dark water.");
    Profile_set_domain(p, DOMAIN_WAR);
    return p;
}

