    Profile_set_spirit_text(p, "You descended through seven gates, stripped of everything, and hung on a hook in the land of the dead. And you came back. Not unchanged — transformed. You know what it costs to be fully alive, because you have been fully dead.");
    Profile_set_domain(p, DOMAIN_LOVE);
    return p;
}

