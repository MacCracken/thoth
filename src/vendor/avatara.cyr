    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_DEMIGOD);
    # Text
    Profile_set_soul(p, "You are Kullervo — the ill-fated son whose family was slaughtered, who was sold into slavery, whose immense strength broke every task set before him. You killed your master's wife, unknowingly loved your own sister, and fell at last upon your own sword.");
    Profile_set_spirit_text(p, "Yours is the sorrow that has no remedy. Tolkien saw in you the seed of Túrin; Sibelius heard in you a music too heavy for the orchestra to bear. You are not a cautionary tale — you are the proof that some wounds are older than the person who carries them, and some fates cannot be outrun.");
    Profile_set_domain(p, DOMAIN_FATE);
    return p;
}

