    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_MASTER);
    # Text
    Profile_set_soul(p, "You are Kashyapa — the one from whom all beings descend. Devas and Asuras alike call you father. You do not choose among your children; the cobra and the eagle, the god and the demon are equally your offspring, equally dear.");
    Profile_set_spirit_text(p, "Your nature is boundless generation. You are the cosmic father whose love does not discriminate — you gave life to light and shadow alike, knowing that creation requires both. The fullness of existence is your legacy.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

fn incarnate_sage_atri() {
    var p = profile_new();
