    Profile_set_spirit_text(p, "Your nature is fortitude with an open heart. The beast is not killed; it is befriended. You teach that the strongest power is the one that can afford to be tender — patience that outlasts rage, love that masters fear.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# ── IX · The Hermit ───────────────────────────────────────────────────────────
# Yod (Virgo) · path 20 · Chesed → Tiphareth. Alone on the grey peak, the lantern
# lifted with its single sealed star. The inward search; the light brought back.
fn tarot_hermit() {
    var p = profile_new();
    Profile_set_name(p, "The Hermit");
    Profile_set_tradition(p, "Tarot");
    Profile_set_desc(p, "IX · Yod — the lone figure on the peak raising a star-lantern in the dark; introspection, solitude, and hard-won inner light");
