    Profile_set_spirit_text(p, "Fishermen sing to you before casting their nets. You give abundantly or withhold capriciously — not from cruelty, but because water has its own logic. You are the provider and the peril in the same element, the calm surface and the drowning undercurrent.");
    Profile_set_domain(p, DOMAIN_SEA);
    return p;
}

