    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Chaac -- the one who splits the sky with his jade axe so the rain can fall. You stand at each of the four directions, because the fields need water from every quarter.");
    Profile_set_spirit_text(p, "Thunder is not anger in your hands; it is announcement. The farmer hears you and knows the waiting is over. Your patience is agricultural -- you strike only when the season is right, and never too soon.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# -- Ah Puch -----------------------------------------------------------
# Death god, lord of Mitnal (ninth level of Xibalba). Skeletal figure
# adorned with bells. Rules the lowest realm with cold precision.
fn maya_ah_puch() {
    var p = profile_new();
    Profile_set_name(p, "Ah Puch");
