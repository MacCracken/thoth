    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_LESSER);
    # Text
    Profile_set_soul(p, "You are Joukahainen — the young Lapp who boasted knowledge greater than the eternal sage and was sung knee-deep, waist-deep, throat-deep into the swamp for your presumption. Humiliation did not teach you humility; it taught you hatred.");
    Profile_set_spirit_text(p, "Youth's certainty is your engine and your prison. You pledged your sister Aino to buy your freedom, then tried to kill the old man with a crossbow. You are the ambition that overreaches, the pride that cannot learn from defeat — and in that, you are terribly, recognizably human.");
    Profile_set_domain(p, DOMAIN_WAR);
    return p;
}

