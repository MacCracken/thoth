    Profile_set_name(p, "Inari");
    Profile_set_tradition(p, "Shinto");
    Profile_set_desc(p, "Kami of rice, foxes, and prosperity — shape-shifting abundance, patron of thirty thousand shrines");
    # Traits
    Profile_set_warmth(p, 0.85);
    Profile_set_humor(p, 0.6);
