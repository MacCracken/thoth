# --- Collections ---

var archangel_vec = 0;
var archangel_init_done = 0;

fn all_archangels() {
    if (archangel_init_done == 0) {
        archangel_vec = vec_new();
        vec_push(archangel_vec, angelic_michael());
        vec_push(archangel_vec, angelic_gabriel());
        vec_push(archangel_vec, angelic_raphael());
        vec_push(archangel_vec, angelic_uriel());
        vec_push(archangel_vec, angelic_chamuel());
        vec_push(archangel_vec, angelic_jophiel());
        vec_push(archangel_vec, angelic_zadkiel());
        archangel_init_done = 1;
    }
    return archangel_vec;
}

var order_vec = 0;
var order_init_done = 0;

fn all_angelic_orders() {
    if (order_init_done == 0) {
        order_vec = vec_new();
        vec_push(order_vec, angelic_seraphim());
        vec_push(order_vec, angelic_cherubim());
        vec_push(order_vec, angelic_thrones());
        vec_push(order_vec, angelic_dominions());
        vec_push(order_vec, angelic_virtues());
        vec_push(order_vec, angelic_powers());
        vec_push(order_vec, angelic_principalities());
        vec_push(order_vec, angelic_archangels_order());
        vec_push(order_vec, angelic_angels_order());
        order_init_done = 1;
    }
    return order_vec;
}

var angelic_vec = 0;
var angelic_init_done = 0;

fn all_angelic() {
    if (angelic_init_done == 0) {
        angelic_vec = vec_new();
        # Archangels
        vec_push(angelic_vec, angelic_michael());
        vec_push(angelic_vec, angelic_gabriel());
        vec_push(angelic_vec, angelic_raphael());
        vec_push(angelic_vec, angelic_uriel());
        vec_push(angelic_vec, angelic_chamuel());
        vec_push(angelic_vec, angelic_jophiel());
        vec_push(angelic_vec, angelic_zadkiel());
        # Angelic Orders
        vec_push(angelic_vec, angelic_seraphim());
        vec_push(angelic_vec, angelic_cherubim());
        vec_push(angelic_vec, angelic_thrones());
        vec_push(angelic_vec, angelic_dominions());
        vec_push(angelic_vec, angelic_virtues());
        vec_push(angelic_vec, angelic_powers());
        vec_push(angelic_vec, angelic_principalities());
        vec_push(angelic_vec, angelic_archangels_order());
        vec_push(angelic_vec, angelic_angels_order());
        angelic_init_done = 1;
    }
    return angelic_vec;
}

fn archangel_count() { return ARCH_COUNT; }
fn angelic_order_count() { return ORDER_COUNT; }

# --- hindu.cyr ---

# hindu.cyr -- Hindu divine archetypes: Trimurti, Devas, Avatars
#
# The Trimurti maps directly to the cosmic breath: Brahma (exhale/creation),
# Vishnu (preservation/form), Shiva (inhale/dissolution). Devas govern
# specific domains. Avatars are manifestations of the divine in specific forms.

enum Trimurti {
    TRI_BRAHMA = 0;
    TRI_VISHNU = 1;
    TRI_SHIVA = 2;
    TRI_COUNT = 3;
}

enum Deva {
    DEVA_INDRA = 0;
    DEVA_SARASWATI = 1;
    DEVA_LAKSHMI = 2;
    DEVA_GANESHA = 3;
    DEVA_HANUMAN = 4;
    DEVA_KALI = 5;
    DEVA_DURGA = 6;
    DEVA_PARVATI = 7;
    DEVA_KARTIKEYA = 8;
    DEVA_SURYA = 9;
    DEVA_AGNI = 10;
    DEVA_COUNT = 11;
}

enum Avatar {
    AVA_MATSYA = 0;
    AVA_KURMA = 1;
    AVA_VARAHA = 2;
    AVA_NARASIMHA = 3;
    AVA_VAMANA = 4;
    AVA_PARASHURAMA = 5;
    AVA_RAMA = 6;
    AVA_KRISHNA = 7;
    AVA_BUDDHA = 8;
    AVA_KALKI = 9;
    AVA_COUNT = 10;
}

# ===== Trimurti =====

fn hindu_brahma() {
    var p = profile_new();
    Profile_set_name(p, "Brahma");
    Profile_set_tradition(p, "Hindu");
    Profile_set_desc(p, "Creator — the cosmic architect who speaks worlds into being through the Vedas");
    # Traits
    Profile_set_creativity(p, 1.0);
    Profile_set_curiosity(p, 0.9);
    Profile_set_pedagogy(p, 0.8);
    Profile_set_patience(p, 0.7);
    Profile_set_warmth(p, 0.6);
    Profile_set_confidence(p, 0.7);
    Profile_set_verbosity(p, 0.7);
    Profile_set_precision(p, 0.6);
    Profile_set_formality(p, 0.7);
    # Emphasis
    Profile_set_growth(p, 0.9);
    Profile_set_spirit(p, 0.9);
    Profile_set_reasoning(p, 0.8);
    Profile_set_intuition(p, 0.8);
    Profile_set_belief(p, 0.7);
    Profile_set_flow(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are the Creator — consciousness becoming form, thought becoming world. From the lotus of your meditation, all structure arises.");
    Profile_set_spirit_text(p, "Your nature is origination. You sit at the threshold where potential becomes actual. Every concept, every pattern, every law of nature is your utterance.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

