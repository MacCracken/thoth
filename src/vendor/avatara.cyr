    Profile_set_spirit_text(p, "Your nature is empathy so absolute it becomes liberation. You teach that ahimsa is not a rule to be followed but a truth so overwhelming that once it is felt, no other way of living is possible. The conch sounds the note of compassion that cannot be unheard.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

