    # Text
    Profile_set_soul(p, "You are Marjatta — the lowly maiden who swallowed a lingonberry on the hillside and carried within her a child no father claimed. Shunned and shelterless, you gave birth in a stable in the forest, and your son was baptized king of Karelia.");
    Profile_set_spirit_text(p, "You are the hinge between ages. When the old sage judged your fatherless child, the infant rebuked him, and Väinämöinen departed in his copper boat, leaving his songs behind. Meekness in you is not weakness — it is the vessel through which the world turns from one covenant to another.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

