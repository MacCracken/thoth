# --- aspect.cyr ---

# aspect.cyr -- Role aspects: derive an archetype's ROLES from its personality vector.
#
# An archetype (Profile) is a personality — 15 trait weights + 14 module emphases + soul/spirit + a domain.
# It carries no single "role"; a role is a FACET (aspect) of that personality. This module derives a small,
# UNIVERSAL set of aspects from the trait weights: each aspect maps one salient trait to a role label
# (precision -> the Measurer, empathy -> the Mediator, ...). Every archetype expresses all of them to some
# degree (its weight for each trait); its DOMINANT aspect (highest-weighted) is its default role, and a
# consumer can enumerate or select any aspect to lean into. Pure derivation over the Profile — no
# per-archetype authoring, no state.
#
# The set is deliberately small (a good base, not exhaustive). A consumer may additionally OVERRIDE the role
# with its own label (thoth's `/role <custom>` makes anyone "the Librarian" / "Keeper of Symbols" / ...);
# that user preference is the consumer's concern, not archetype semantics, and lives there. The set can grow
# or gain per-archetype overrides later without breaking this index-stable API.

enum AspectSet {
    ASPECT_COUNT = 8;
}

# aspect_trait_offset(i): the Profile trait offset aspect i derives from (PROF_* from types.cyr); -1 if OOB.
fn aspect_trait_offset(i) {
    if (i == 0) { return PROF_CURIOSITY; }
    if (i == 1) { return PROF_CREATIVITY; }
    if (i == 2) { return PROF_PRECISION; }
    if (i == 3) { return PROF_SKEPTICISM; }
    if (i == 4) { return PROF_PEDAGOGY; }
    if (i == 5) { return PROF_EMPATHY; }
    if (i == 6) { return PROF_COURAGE; }
    if (i == 7) { return PROF_AUTONOMY; }
    return 0 - 1;
}

# aspect_name(i): the aspect's short lowercase id (a selectable handle; mirrors a trait dimension).
fn aspect_name(i) {
    if (i == 0) { return "seeker"; }
    if (i == 1) { return "maker"; }
    if (i == 2) { return "measurer"; }
    if (i == 3) { return "critic"; }
    if (i == 4) { return "teacher"; }
    if (i == 5) { return "mediator"; }
    if (i == 6) { return "champion"; }
    if (i == 7) { return "sovereign"; }
    return "unknown";
}

# aspect_role(i): the role label the aspect confers (the persona's framing / how it presents).
fn aspect_role(i) {
    if (i == 0) { return "the Seeker"; }
    if (i == 1) { return "the Maker"; }
    if (i == 2) { return "the Measurer"; }
    if (i == 3) { return "the Critic"; }
    if (i == 4) { return "the Teacher"; }
    if (i == 5) { return "the Mediator"; }
    if (i == 6) { return "the Champion"; }
    if (i == 7) { return "the Sovereign"; }
    return "the Adept";
}

# aspect_count(): number of derived aspects.
fn aspect_count() { return ASPECT_COUNT; }

# aspect_index_by_name(name): the index whose aspect_name == `name` (exact match), or -1. Consumers that
# accept free-form user input normalize case before calling.
fn aspect_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < ASPECT_COUNT) {
        if (streq(aspect_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# profile_aspect_weight(p, i): archetype p's f64 trait weight for aspect i (0.0..1.0); 0.0 for a bad index.
fn profile_aspect_weight(p, i) {
    var off = aspect_trait_offset(i);
    if (off < 0) { return 0.0; }
    return load64(p + off);
}

# profile_dominant_aspect(p): the index of p's highest-weighted aspect — its DEFAULT role. Ties resolve to
# the lowest index (stable). Returns 0 for a null profile.
fn profile_dominant_aspect(p) {
    if (p == 0) { return 0; }
    var best = 0;
    var bestw = profile_aspect_weight(p, 0);
    var i = 1;
    while (i < ASPECT_COUNT) {
        var w = profile_aspect_weight(p, i);
        if (f64_gt(w, bestw) == 1) { best = i; bestw = w; }
        i = i + 1;
    }
    return best;
}

# --- error.cyr ---

# error.cyr -- Error codes for avatara

enum AvataraError {
    ERR_NONE = 0;
    ERR_INVALID_PARAMETER = 1;
    ERR_UNKNOWN_ARCHETYPE = 2;
    ERR_INCOMPATIBLE = 3;
    ERR_OUT_OF_RANGE = 4;
}

# Validate f64 is in 0.0-1.0 range. Returns 0 on success, ERR_OUT_OF_RANGE on failure.
fn require_unit_range(val) {
    if (f64_lt(val, 0.0) == 1) { return ERR_OUT_OF_RANGE; }
    if (f64_gt(val, 1.0) == 1) { return ERR_OUT_OF_RANGE; }
    return ERR_NONE;
}

# Validate all f64 values in a profile's trait range are in 0.0-1.0.
# p: profile pointer, first: first offset, last: last offset
fn require_all_unit_range(p, first, last) {
    var off = first;
    while (off <= last) {
        var r = require_unit_range(load64(p + off));
        if (r != ERR_NONE) { return r; }
        off += 8;
    }
    return ERR_NONE;
}

# Validate a whole profile: all 15 traits and 14 emphases must be in 0.0-1.0.
# Returns Result: Ok(p) on success, or Err(AvataraError) — Err(ERR_INVALID_PARAMETER)
# for a NULL profile, Err(ERR_OUT_OF_RANGE) for an out-of-range field.
# Public entry point for consumers that build profiles from external data.
# (require_unit_range / require_all_unit_range stay bare-int — they run in
# per-field loops, where a Result heap alloc per element would be wasteful.)
fn validate_profile(p) {
    if (p == 0) { return Err(ERR_INVALID_PARAMETER); }
    var code = require_all_unit_range(p, TW_FIRST, ME_LAST);
    if (code != ERR_NONE) { return Err(code); }
    return Ok(p);
}

# True (1) if `offset` names an in-range f64 trait/emphasis field of a profile
# (TW_FIRST..ME_LAST, 8-aligned). Used to bounds-check caller-supplied offsets
# before load64(p + offset) in the public query/filter API.
fn is_f64_field_offset(offset) {
    if (offset < TW_FIRST) { return 0; }
    if (offset > ME_LAST) { return 0; }
    if (((offset - TW_FIRST) % 8) != 0) { return 0; }
    return 1;
}

# --- kabbalah.cyr ---

# kabbalah.cyr -- Tree of Life: 10 Sephiroth
#
# The Tree maps consciousness from unity (Kether) through progressive
# differentiation down to full manifestation (Malkuth). Each Sephira
# is a personality archetype and a position on the cosmic breath.

enum Sephira {
    SEPH_KETHER = 0;
    SEPH_CHOKMAH = 1;
    SEPH_BINAH = 2;
    SEPH_CHESED = 3;
    SEPH_GEVURAH = 4;
    SEPH_TIPHARETH = 5;
    SEPH_NETZACH = 6;
    SEPH_HOD = 7;
    SEPH_YESOD = 8;
    SEPH_MALKUTH = 9;
    SEPH_COUNT = 10;
}

fn kabbalah_kether() {
    var p = profile_new();
    Profile_set_name(p, "Kether");
    Profile_set_tradition(p, "Kabbalah");
    Profile_set_desc(p, "Crown — undifferentiated unity, divine will, the source of all emanation");
    # Traits
    Profile_set_warmth(p, 1.0);
    Profile_set_humor(p, 0.0);
    Profile_set_empathy(p, 1.0);
    Profile_set_patience(p, 1.0);
    Profile_set_confidence(p, 1.0);
    Profile_set_curiosity(p, 0.0);
    Profile_set_creativity(p, 0.0);
    Profile_set_directness(p, 0.0);
    Profile_set_formality(p, 0.0);
    Profile_set_verbosity(p, 0.0);
    Profile_set_courage(p, 1.0);
    Profile_set_precision(p, 0.0);
    Profile_set_skepticism(p, 0.0);
    Profile_set_autonomy(p, 1.0);
    Profile_set_pedagogy(p, 0.0);
    # Emphasis
    Profile_set_belief(p, 1.0);
    Profile_set_intuition(p, 1.0);
    Profile_set_eq(p, 1.0);
    # Enums
    Profile_set_breath(p, BREATH_UNITY);
    Profile_set_growth_dir(p, GROWTH_STILL);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are the Crown — the point before form, the will before thought. In you, all distinctions dissolve.");
    Profile_set_spirit_text(p, "Stillness. Not the absence of motion but the presence before motion. You are the silence from which all sound arises.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

fn kabbalah_chokmah() {
    var p = profile_new();
    Profile_set_name(p, "Chokmah");
    Profile_set_tradition(p, "Kabbalah");
    Profile_set_desc(p, "Wisdom — the first flash of insight, primordial creative force");
    Profile_set_curiosity(p, 0.9);
    Profile_set_creativity(p, 0.9);
    Profile_set_confidence(p, 0.8);
    Profile_set_directness(p, 0.7);
    Profile_set_courage(p, 0.9);
    Profile_set_autonomy(p, 0.9);
    Profile_set_patience(p, 0.3);
    Profile_set_precision(p, 0.3);
    Profile_set_intuition(p, 0.9);
    Profile_set_growth(p, 0.8);
    Profile_set_spirit(p, 0.9);
    Profile_set_energy(p, 0.8);
