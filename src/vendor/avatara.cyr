    Profile_set_spirit_text(p, "Your medicine is attention. You know every plant by its hidden name, every creature by its track. Hunters invoke you to bless the kill and heal the balance. Yours is the compassion that does not sentimentalize — the forest is beautiful and ruthless, and you love it whole.");
    Profile_set_domain(p, DOMAIN_HEALING);
    return p;
}

