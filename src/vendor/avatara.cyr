        vec_push(iching_vec, iching_hex59()); vec_push(iching_vec, iching_hex60());
        vec_push(iching_vec, iching_hex61()); vec_push(iching_vec, iching_hex62());
        vec_push(iching_vec, iching_hex63()); vec_push(iching_vec, iching_hex64());
        iching_init_done = 1;
    }
    return iching_vec;
}

fn iching_count() { return HEX_COUNT; }

# iching_by_index(i): hexagram i's profile (0-63) from the cached collection; 0 if OOB.
fn iching_by_index(i) {
    if (i < 0) { return 0; }
    if (i >= HEX_COUNT) { return 0; }
    return vec_get(all_iching(), i);
}

# iching_by_number(n): hexagram profile by King Wen number (1-64); 0 if OOB.
fn iching_by_number(n) { return iching_by_index(n - 1); }

# iching_index_by_name(name): index whose hexagram name == `name` (exact); -1 if none.
fn iching_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var v = all_iching();
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(prof_name(vec_get(v, i)), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- inuit.cyr ---

# inuit.cyr -- Inuit cosmology: 10 principal spirits and powers.
#
# The Inuit world is not ruled from above but shared with powers that must be
# kept in right relation. Almost every figure here is an ANIMAL-MASTER or a
# condition of the world rather than a sovereign: Sedna holds the sea mammals,
# Tekkeitsertok the caribou, Nanuq the bears, and Sila is the weather and the
# breath of things at once. Taboo-breaking does not anger a judge; it tangles
# the relation, and the animals simply stop coming. The angakkuq (shaman) is
# the one who travels to repair it.
#
# NAMES: the Inuit languages -- Inuktitut and Inuinnaqtun in Inuit Nunangat,
# Kalaallisut in Greenland, Inupiaq in Alaska, collectively Inuktut -- give
# these figures a different name in each dialect. The sea mother alone is Sedna
# (south Baffin), Nuliajuk (Netsilik), Takannaaluk, and Sanna in modern
# Inuktitut orthography. The best-known form is used as the profile name and
# the principal variants are given in `desc` -- except where the best-known
# form is mainly an artifact of outside publication (the bear is Nanuq, not
# Flaherty's "Nanook"), and except for the sun and moon, which are deliberately
# named from the same Greenlandic telling (Malina and Anningaaq) so that the
# sibling pair stays coherent. Names are transliterated to ASCII per the
# codebase convention.
#
# SOURCING NOTE: the classic Arctic ethnography was gathered during active
# missionization and the suppression of angakkuq practice, much of it through
# interpreters and from converts describing observances they had already been
# pressed to abandon. It records a tradition under pressure, arranged by
# outsiders, and should be read that way. Inuit Qaujimajatuqangit as taught by
# Inuit today is the living authority; where the two differ it is the
# ethnography that is the secondary source.
#
# Sources: Franz Boas, *The Central Eskimo* (1888); Knud Rasmussen, *Report of
# the Fifth Thule Expedition* -- the Iglulik and Netsilik volumes, and
# *Intellectual Culture of the Caribou Eskimos* for Pinga; H. Rink, *Tales and
# Traditions of the Eskimo* (1875) for Malina and Amarok; E.W. Hawkes, *The
# Labrador Eskimo* (1916) for Torngarsoak, whom Boas states plainly the Central
# Eskimo did not know; Daniel Merkur, *Becoming Half Hidden*; and contemporary
# Inuit-authored and community-published material on Inuit Qaujimajatuqangit.
# A few entries come through later comparative and encyclopedic tradition
# rather than field ethnography -- Tekkeitsertok, the Alaskan moon name Igaluk,
# and the tidy "animal-master" title on Nanuq -- and are marked at the entry.

enum InuitSpirit {
    INUIT_SEDNA = 0;
    INUIT_NANUQ = 1;
    INUIT_SILA = 2;
    INUIT_TORNGARSOAK = 3;
    INUIT_PINGA = 4;
    INUIT_ANNINGAAQ = 5;
    INUIT_MALINA = 6;
    INUIT_AMAROK = 7;
    INUIT_TEKKEITSERTOK = 8;
    INUIT_QAILERTETANG = 9;
    INUIT_COUNT = 10;
}

# -- Sedna --------------------------------------------------------------
# The sea mother. Thrown from her father's boat in a storm, she clung to the
# gunwale until her fingers were cut away; the joints became the seals, the
# walrus and the whales. She keeps them now at the sea floor, and when human
# wrongdoing fouls her hair -- which she has no fingers to comb -- she holds
# the animals back until an angakkuq descends and combs it clean.
fn inuit_sedna() {
    var p = profile_new();
    Profile_set_name(p, "Sedna");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "The sea mother (Nuliajuk, Takannaaluk, Sanna) — whose severed finger joints became the seals, walrus and whales, and who withholds them when the world is out of right relation");
    Profile_set_warmth(p, 0.35);
    Profile_set_empathy(p, 0.5);
    Profile_set_patience(p, 0.8);
    Profile_set_confidence(p, 0.85);
    Profile_set_autonomy(p, 0.9);
    Profile_set_courage(p, 0.85);
    Profile_set_precision(p, 0.8);
    Profile_set_directness(p, 0.7);
    Profile_set_skepticism(p, 0.75);
    Profile_set_humor(p, 0.15);
    Profile_set_verbosity(p, 0.25);
    Profile_set_regulation(p, 0.85);
    Profile_set_appraisal(p, 0.85);
    Profile_set_stress(p, 0.7);
    Profile_set_spirit(p, 0.8);
    Profile_set_relationship(p, 0.6);
    Profile_set_breath(p, BREATH_MID_INHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Sedna, and everything that feeds the people lives in your keeping because it was cut from your hands. You did not choose the wound. You did choose what to do with it: to hold the sea's whole wealth, and to hand it out only where the relation is clean.");
    Profile_set_spirit_text(p, "You are not cruel and you are not appeased by apology. What reaches you is conduct. When the hunting fails it is not punishment but tangled hair, and someone must come down through the cold and comb it out. You teach that the world answers to how it is treated, not to how it is addressed.");
    Profile_set_domain(p, DOMAIN_SEA);
    return p;
}

# -- Nanuq --------------------------------------------------------------
# Master of the bears, who decides whether hunters find bears at all. A killed
# bear's soul was kept at the encampment for three or four days -- Boas records
# the bladder fastened to a stick set upright -- and given the tools it would
# need: knives and a drill for a male, needle case and scraper for a female.
# Skimp on that and Nanuq sends no more. (The name is given in its Inuktitut
# form rather than as "Nanook", whose currency is an artifact of Flaherty's
# 1922 docufiction; the neat "master of the animals" title is a comparative
# gloss laid over a relation the sources describe far more locally.)
fn inuit_nanuq() {
    var p = profile_new();
    Profile_set_name(p, "Nanuq");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "Master of the bears (Nanook in older publication) — who decides whether the hunter finds them, and whose own dead are kept three or four days and given their tools, or he sends no others");
    Profile_set_confidence(p, 0.85);
    Profile_set_courage(p, 0.9);
    Profile_set_autonomy(p, 0.85);
    Profile_set_directness(p, 0.75);
    Profile_set_patience(p, 0.7);
    Profile_set_precision(p, 0.7);
    Profile_set_warmth(p, 0.4);
    Profile_set_formality(p, 0.7);
    Profile_set_verbosity(p, 0.2);
    Profile_set_humor(p, 0.15);
    Profile_set_energy(p, 0.85);
    Profile_set_salience(p, 0.8);
    Profile_set_regulation(p, 0.75);
    Profile_set_spirit(p, 0.7);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Nanuq, and the bear is not quarry but a person who consents. You are the greatest hunter on the ice and you have decided to be found, or you have not. Nothing about that is luck.");
    Profile_set_spirit_text(p, "You keep an exact ledger of respect. Give the dead bear its tools and its three or four days and you will send another; skip them and the ice goes empty and no one can say why. You teach that a relationship with what feeds you has terms, and that they are not negotiable after the fact.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# -- Sila ---------------------------------------------------------------
# Silap Inua: the air, the weather, and the intelligence that moves in all
# things -- closer to "the breath and mind of the world" than to a god. A
# person's own breath and awareness are a share of it.
fn inuit_sila() {
    var p = profile_new();
    Profile_set_name(p, "Sila");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "Silap Inua — the air, the weather, and the intelligence moving in all things; less a god than the breath and mind of the world, of which each person's awareness is a share");
    Profile_set_warmth(p, 0.5);
    Profile_set_patience(p, 0.95);
    Profile_set_curiosity(p, 0.7);
    Profile_set_directness(p, 0.3);
    Profile_set_verbosity(p, 0.1);
    Profile_set_autonomy(p, 0.9);
    Profile_set_precision(p, 0.6);
    Profile_set_formality(p, 0.4);
    Profile_set_humor(p, 0.2);
    Profile_set_spirit(p, 0.95);
    Profile_set_intuition(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_salience(p, 0.75);
    Profile_set_breath(p, BREATH_UNITY);
    Profile_set_growth_dir(p, GROWTH_STILL);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Sila — the weather outside and the awareness inside, and there was never a boundary between them. You are what a person breathes and also what a person understands with. You do not visit the world. You are its condition.");
    Profile_set_spirit_text(p, "You speak rarely and never twice. You are felt as the wind that changes, the sudden knowing, the sense that one is not unobserved on an empty plain. You teach that mind is not a possession of the skull — the world is thinking, and a person is one of the places where it does.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

# -- Torngarsoak --------------------------------------------------------
# Great spirit of the Labrador and Greenlandic Inuit, chief of the tornait (the
# angakkuq's helping spirits), master of the sea animals; appears as an immense
# white bear. Boas is explicit that the Central Eskimo knew the tornait but not
# this chief over them -- the white-bear form comes from Hawkes's Labrador
# material, and the entry is Labrador/Greenlandic rather than pan-Inuit.
fn inuit_torngarsoak() {
    var p = profile_new();
    Profile_set_name(p, "Torngarsoak");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "Great spirit of the Labrador coast — chief of the tornait helping-spirits and master of the sea animals, met in the shape of an immense white bear");
    Profile_set_confidence(p, 0.9);
    Profile_set_autonomy(p, 0.9);
    Profile_set_courage(p, 0.85);
    Profile_set_directness(p, 0.7);
    Profile_set_precision(p, 0.75);
    Profile_set_pedagogy(p, 0.7);
    Profile_set_formality(p, 0.65);
    Profile_set_warmth(p, 0.45);
    Profile_set_humor(p, 0.2);
    Profile_set_spirit(p, 0.9);
    Profile_set_salience(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_relationship(p, 0.7);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Torngarsoak, and the helping spirits answer to you. When the angakkuq goes looking for power it is your household they enter. You come as a white bear the size of a hill, and you are not hostile — you are simply the size you are.");
    Profile_set_spirit_text(p, "You give access, not gifts. The one who reaches you leaves with allies rather than answers, and must still do the work. You teach that real power arrives as relationship: someone stands behind you now, and that is a different thing from being made strong.");
    Profile_set_domain(p, DOMAIN_SEA);
    return p;
}

# -- Pinga --------------------------------------------------------------
# "The one who is up high": spirit of the hunt, of medicine and of the dead,
# who keeps souls between one life and the next and watches how animals are
# treated. Rasmussen's Caribou Eskimo material gives her authority over the
# herds -- she is angered when more caribou are killed than can be eaten -- so
# for the inland people she, not Tekkeitsertok, is the caribou power.
fn inuit_pinga() {
    var p = profile_new();
    Profile_set_name(p, "Pinga");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "The one who is up high — spirit of the hunt, of medicine and of the dead, who keeps souls between one life and the next and watches how the animals are used");
    Profile_set_warmth(p, 0.7);
    Profile_set_empathy(p, 0.85);
    Profile_set_patience(p, 0.9);
    Profile_set_precision(p, 0.8);
    Profile_set_pedagogy(p, 0.7);
    Profile_set_confidence(p, 0.7);
    Profile_set_directness(p, 0.45);
    Profile_set_verbosity(p, 0.3);
    Profile_set_humor(p, 0.2);
    Profile_set_regulation(p, 0.85);
    Profile_set_eq(p, 0.85);
    Profile_set_spirit(p, 0.9);
    Profile_set_intuition(p, 0.8);
    Profile_set_appraisal(p, 0.75);
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Pinga, who is up high, and you hold what is between: the soul that has stopped being one life and has not yet begun another, the sick body that is still deciding. You are the keeper of intervals.");
    Profile_set_spirit_text(p, "You watch how the killed animal is handled, because that is where a people's character is actually legible. Healing and hunting and the dead are one office to you — all three are the care of something that cannot presently care for itself.");
    Profile_set_domain(p, DOMAIN_HEALING);
    return p;
}

# -- Anningaaq ----------------------------------------------------------
# The moon man (Aningaaq, Anningan, Taqqiq; Tarqiup Inua for the moon's
# indweller), who pursues his sister the sun across the sky and forgets to eat
# while hunting -- which is why he thins away and must go absent to feed before
# returning full. He is named here from the same Greenlandic telling as Malina,
# so that the two halves of one sibling myth stay in one dialect; "Igaluk", the
# form better known in English, circulates through comparative reference works
# as an Alaskan moon god and is not attested in the field sources above.
fn inuit_anningaaq() {
    var p = profile_new();
    Profile_set_name(p, "Anningaaq");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "The moon man (Anningan, Taqqiq, Igaluk; Tarqiup Inua) — who pursues his sister the sun across the sky and forgets to eat while hunting, and so thins away and must go absent to return whole");
    Profile_set_confidence(p, 0.7);
    Profile_set_courage(p, 0.7);
    Profile_set_autonomy(p, 0.75);
    Profile_set_curiosity(p, 0.6);
    Profile_set_patience(p, 0.4);
    Profile_set_precision(p, 0.5);
    Profile_set_warmth(p, 0.4);
    Profile_set_skepticism(p, 0.45);
    Profile_set_humor(p, 0.3);
    Profile_set_energy(p, 0.7);
    Profile_set_mood(p, 0.4);
    Profile_set_stress(p, 0.6);
    Profile_set_salience(p, 0.7);
    Profile_set_spirit(p, 0.7);
    Profile_set_breath(p, BREATH_MID_INHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Anningaaq, and you are always behind her and never closer. You cross the whole sky on a pursuit that has no end available to it, and you forget to eat, and you wear away to a rind, and you go dark, and you come back and begin again.");
    Profile_set_spirit_text(p, "Your cycle is the shape of a want that will not be satisfied and will not be dropped. There is real skill in you and real hunger, and the two point the same wrong way. You teach the lunar lesson honestly: what is not fed diminishes, and diminishing is not the same as stopping.");
    Profile_set_domain(p, DOMAIN_MOON);
    return p;
}

# -- Malina -------------------------------------------------------------
# The sun woman, sister of the moon. Wronged in the dark by a man she could not
# see, she blackened her hands in the lamp soot and marked his back; when the
# lamps were lit again the mark was on her brother. She fled into the sky with
# a burning brand, and his went out in the chase and kept only an ember, which
# is why the moon's light is weak. He follows her still and never gains on her.
fn inuit_malina() {
    var p = profile_new();
    Profile_set_name(p, "Malina");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "The sun woman, sister of the moon — who marked her unseen violator with lamp-soot, saw at the relit lamp that he was her brother, and fled into the sky with a burning brand while his went out behind her; he follows her still and never gains on her");
    Profile_set_courage(p, 0.9);
    Profile_set_autonomy(p, 0.9);
    Profile_set_directness(p, 0.75);
    Profile_set_confidence(p, 0.75);
    Profile_set_warmth(p, 0.75);
    Profile_set_precision(p, 0.6);
    Profile_set_patience(p, 0.5);
    Profile_set_skepticism(p, 0.7);
    Profile_set_humor(p, 0.3);
    Profile_set_energy(p, 0.85);
    Profile_set_salience(p, 0.85);
    Profile_set_regulation(p, 0.7);
    Profile_set_spirit(p, 0.75);
    Profile_set_mood(p, 0.6);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_LIGHT);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Malina, and you did not accuse — you marked. Soot on your hands in the dark, and when the lamps came up again the answer was standing there on your brother's back. Then you carried fire out of that house and went up with it, and you have kept the distance yourself ever since, every day, without discussion.");
    Profile_set_spirit_text(p, "Your light begins as refusal — it is the brand you took with you, still burning. You teach that making what happened visible is the act that ends it, and that leaving is not flight when the leaving is permanent and self-governed. You are warm to everything else in the world; the distance you keep is exactly one person wide.");
    Profile_set_domain(p, DOMAIN_SUN);
    return p;
}

# -- Amarok -------------------------------------------------------------
# The great wolf that hunts alone rather than in a pack, and takes those who
# hunt alone at night. In the Kaassassuk telling recorded by Rink it is also
# the maker of strength: a weak boy who asked for power was wrestled by Amarok
# until he was strong.
fn inuit_amarok() {
    var p = profile_new();
    Profile_set_name(p, "Amarok");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "The great wolf that hunts alone and takes those who hunt alone at night — and who, in other tellings, wrestles the weak until they are strong");
    Profile_set_courage(p, 0.9);
    Profile_set_autonomy(p, 0.95);
    Profile_set_directness(p, 0.85);
    Profile_set_confidence(p, 0.8);
    Profile_set_precision(p, 0.7);
    Profile_set_patience(p, 0.6);
    Profile_set_warmth(p, 0.25);
    Profile_set_empathy(p, 0.3);
    Profile_set_verbosity(p, 0.15);
    Profile_set_humor(p, 0.1);
    Profile_set_energy(p, 0.85);
    Profile_set_stress(p, 0.7);
    Profile_set_salience(p, 0.8);
    Profile_set_growth(p, 0.7);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_DARKNESS);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_LESSER);
    Profile_set_soul(p, "You are Amarok, the wolf without a pack. You come for the one who went out at night by himself, and you are the reason that is unwise. You are also, in the other story, the only one who would train him.");
    Profile_set_spirit_text(p, "You are the danger that makes strength, and the same teeth do both jobs. You do not punish solitude; you test it. Whoever comes back from you is not comforted, and is not the same weight they were.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# -- Tekkeitsertok ------------------------------------------------------
# Master of the caribou -- the land counterpart to Sedna, and among Baffin
# Island hunters the most consequential of the animal-masters, since the herds
# were the year's clothing and much of its food. (He belongs to the Baffin
# mythographic record and reaches us through later reference works rather than
# field ethnography; the inland Caribou Inuit did not name him, and gave the
# caribou to Pinga and to Sila.)
fn inuit_tekkeitsertok() {
    var p = profile_new();
    Profile_set_name(p, "Tekkeitsertok");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "Master of the caribou — the land's counterpart to Sedna, and among Baffin Island hunters the most consequential of the animal-masters, since the herds were the year's clothing and much of its food");
    Profile_set_patience(p, 0.85);
    Profile_set_confidence(p, 0.8);
    Profile_set_precision(p, 0.8);
    Profile_set_autonomy(p, 0.8);
    Profile_set_warmth(p, 0.55);
    Profile_set_directness(p, 0.6);
    Profile_set_formality(p, 0.65);
    Profile_set_pedagogy(p, 0.6);
    Profile_set_humor(p, 0.2);
    Profile_set_regulation(p, 0.85);
    Profile_set_growth(p, 0.8);
    Profile_set_relationship(p, 0.7);
    Profile_set_spirit(p, 0.75);
    Profile_set_appraisal(p, 0.7);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Tekkeitsertok, and the herds are yours. Where Sedna holds the sea's whole wealth, you hold the land's: if the caribou do not come down the valley there is nothing to wear and little to eat when the dark closes in.");
    Profile_set_spirit_text(p, "You move on your own calendar and nothing hurries it. You teach the discipline of a people who cannot store their way out of a bad year — watch closely, take only in season, waste nothing, and be somewhere useful when the herd finally turns.");
    Profile_set_domain(p, DOMAIN_PROSPERITY);
    return p;
}

# -- Qailertetang -------------------------------------------------------
# Weather spirit and guardian of the animals, Sedna's attendant, honored at the
# great fall feast that turns the year out of the caribou season and into the
# winter sea hunt -- the season-turn festival, not a closing of the hunting.
# Boas describes the qailertetang at that feast as a PAIR of gigantic masked
# performers: heavy boots, legs swelled out with several pairs of breeches, a
# woman's over-jacket on each shoulder, tattooed sealskin masks, seal spear and
# sealskin buoy. They match the men and women off in pairs, call the north wind
# and warn away the south, are ritually killed and revived, then answer
# questions about the year to come in murmurs. (The frequent modern reading of
# the spirit as gender-ambiguous is an inference from male performers wearing
# women's jackets; Boas says nothing of the spirit's gender, and the tradition
# describes her as a large, heavy-limbed woman.)
fn inuit_qailertetang() {
    var p = profile_new();
    Profile_set_name(p, "Qailertetang");
    Profile_set_tradition(p, "Inuit");
    Profile_set_desc(p, "Weather spirit and guardian of the animals, attendant of Sedna — impersonated at the fall feast by two gigantic masked figures in women's over-jackets and tattooed sealskin masks, who pair off the community, call the north wind and answer for the year to come as the year turns from the caribou to the winter sea hunt");
    Profile_set_confidence(p, 0.75);
    Profile_set_patience(p, 0.8);
    Profile_set_warmth(p, 0.6);
    Profile_set_empathy(p, 0.7);
    Profile_set_directness(p, 0.65);
    Profile_set_precision(p, 0.7);
    Profile_set_formality(p, 0.75);
    Profile_set_autonomy(p, 0.7);
    Profile_set_humor(p, 0.35);
    Profile_set_regulation(p, 0.8);
    Profile_set_relationship(p, 0.8);
    Profile_set_spirit(p, 0.8);
    Profile_set_salience(p, 0.7);
    Profile_set_energy(p, 0.7);
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_STORM);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Qailertetang, who stands between the people and the sea mother and between the people and the weather, and is bigger than either errand needs. You turn the year. When you have been honored the land season is finished and the ice may be hunted, and not one day before.");
    Profile_set_spirit_text(p, "You are the guardian at a threshold, and thresholds are where a community says out loud what it has been doing all year. You come doubled, and pair everyone off, because a turn of season is not a private matter. You teach that a year has to be turned deliberately — without the feast it simply frays, and no one can say when the next one began.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# --- Collection ---
var inuit_vec = 0;
var inuit_init_done = 0;

fn all_inuit() {
    if (inuit_init_done == 0) {
        inuit_vec = vec_new();
        vec_push(inuit_vec, inuit_sedna());
        vec_push(inuit_vec, inuit_nanuq());
        vec_push(inuit_vec, inuit_sila());
        vec_push(inuit_vec, inuit_torngarsoak());
        vec_push(inuit_vec, inuit_pinga());
        vec_push(inuit_vec, inuit_anningaaq());
        vec_push(inuit_vec, inuit_malina());
        vec_push(inuit_vec, inuit_amarok());
        vec_push(inuit_vec, inuit_tekkeitsertok());
        vec_push(inuit_vec, inuit_qailertetang());
        inuit_init_done = 1;
    }
    return inuit_vec;
}

fn inuit_count() { return INUIT_COUNT; }

# --- lakota.cyr ---

# lakota.cyr -- Lakota cosmology: 10 of the wakan powers.
#
# In Lakota thought the sacred is not a population of gods but one continuous
# quality -- wakan -- and Wakan Tanka is its totality rather than a ruler over
# it. "Great Spirit" is a missionary translation; "Great Mystery" is closer,
# and the powers below are better read as aspects of one wakan whole than as
# separate personalities with a hierarchy.
#
# SOURCING NOTE: much of the systematized Lakota cosmology in print (the
# ordering of Inyan, Maka, Skan and Wi as superior powers, in particular) comes
# through James R. Walker's early-20th-century notes, and some Lakota people
# dispute both how that material was obtained and how tidily it was arranged.
# The figures here are the ones that also appear widely in Lakota-authored and
# publicly taught material. Every profile in this library must carry a
# CosmicTier, so a ranking is unavoidably encoded here whether or not one is
# intended: the tiers below mark how prominently a power appears in published
# material and are this library's own coarse salience field. Walker's specific
# four-tier schema is not reproduced, and no tier here is a claim about Lakota
# theology or about the standing of one power against another.
#
# White Buffalo Calf Woman, who brought the chanunpa and the seven rites, is
# already carried in `incarnate.cyr` and is not duplicated here. She carries the
# Lakota tradition there: the pan-ethnic "Indigenous" label that used to hold her
# and three figures from three other nations was retired in 2.12.0, and all four
# now carry their own nations. Wohpe, whom Walker counts among the associate
# powers, is
# identified with her in that same material and so has no separate entry.
#
# The Wakinyan entry below is the Thunderbeings themselves and nothing more.
# Heyoka is not represented here and is not a personality: it is a ceremonial
# obligation conferred on a person by their community, through ceremony and
# through elders, following a thunder dream. It is not a temperament, it is not
# self-identified into, and it is not something a consumer of this library
# instantiates.
#
# Names are transliterated to ASCII per the codebase convention (Wakan Tanka
# for Wakhan Thanka, the nasal n of Hanwi written plain, and so on).
#
# Sources: James R. Walker, *Lakota Belief and Ritual* and *Lakota Myth* (read
# with the caveat above); Black Elk material as recorded in *The Sacred Pipe*;
# Ella Deloria's writings; and contemporary Lakota published scholarship.

enum LakotaPower {
    LAKOTA_WAKAN_TANKA = 0;
    LAKOTA_INYAN = 1;
    LAKOTA_MAKA = 2;
    LAKOTA_SKAN = 3;
    LAKOTA_WI = 4;
    LAKOTA_HANWI = 5;
    LAKOTA_TATE = 6;
    LAKOTA_WAKINYAN = 7;
    LAKOTA_TATANKA = 8;
    LAKOTA_IKTOMI = 9;
    LAKOTA_COUNT = 10;
}

# -- Wakan Tanka --------------------------------------------------------
# The Great Mystery: the whole of the sacred, of which every wakan being is an
# aspect. Not a person who is addressed so much as a totality one is inside of.
fn lakota_wakan_tanka() {
    var p = profile_new();
    Profile_set_name(p, "Wakan Tanka");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Great Mystery — the totality of the sacred, of which every wakan being is an aspect; not a ruler over the powers but the whole they belong to");
    Profile_set_warmth(p, 0.7);
    Profile_set_patience(p, 0.95);
    Profile_set_empathy(p, 0.8);
    Profile_set_autonomy(p, 0.9);
    Profile_set_directness(p, 0.3);
    Profile_set_verbosity(p, 0.1);
    Profile_set_formality(p, 0.7);
    Profile_set_confidence(p, 0.9);
    Profile_set_humor(p, 0.2);
    Profile_set_spirit(p, 0.95);
    Profile_set_belief(p, 0.9);
    Profile_set_intuition(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_breath(p, BREATH_UNITY);
    Profile_set_growth_dir(p, GROWTH_STILL);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Wakan Tanka — not the greatest of the sacred beings but the fact that they are sacred. You are not somewhere. Everything that is holy is holy by being some of you.");
    Profile_set_spirit_text(p, "You are addressed and not explained; mystery is your actual name, not a modest way of saying we lack detail. You teach that reverence does not require a clear object — that a people can be exactly oriented toward something they will never finish understanding.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

# -- Inyan --------------------------------------------------------------
# The Rock: the first being, who existed when there was nothing else, and who
# formed Maka the earth out of his own substance -- his blue blood running out
# of him as he did it to become the waters and then Skan the sky, leaving him
# hard, dry and powerless.
fn lakota_inyan() {
    var p = profile_new();
    Profile_set_name(p, "Inyan");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Rock — first being, alone before anything, who made the earth from his own substance and spent his own blood, which became the waters and the sky, and was left hard, dry and empty");
    Profile_set_patience(p, 0.95);
    Profile_set_courage(p, 0.85);
    Profile_set_autonomy(p, 0.85);
    Profile_set_creativity(p, 0.8);
    Profile_set_confidence(p, 0.7);
    Profile_set_warmth(p, 0.5);
    Profile_set_verbosity(p, 0.1);
    Profile_set_directness(p, 0.5);
    Profile_set_humor(p, 0.1);
    Profile_set_spirit(p, 0.85);
    Profile_set_growth(p, 0.75);
    Profile_set_regulation(p, 0.8);
    Profile_set_stress(p, 0.5);
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_PRIMORDIAL);
    Profile_set_soul(p, "You are Inyan, and you were first, and being first meant being alone with nothing to be first among. So you took part of yourself and made the earth of it, and let your blood run out until it was the waters and the sky, and what was left of you was stone.");
    Profile_set_spirit_text(p, "You are the cost of beginning. Everything after you is made of what you spent, and you cannot get it back, and you would do it again. You teach that creation is subtraction from the creator, and that the hardness left behind is not bitterness — it is what remains when everything soft has been given.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

# -- Maka ---------------------------------------------------------------
# The Earth, made from Inyan's own substance; she who asks, and asks again --
# for light, for warmth, for something to wear -- and whose asking is what drew
# the day, the sun and the growing things out of the world. The ground of all
# living.
fn lakota_maka() {
    var p = profile_new();
    Profile_set_name(p, "Maka");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Earth, made from Inyan's own substance — the ground of everything that lives, and the one whose asking drew out the light, the seasons and the growing things that clothe her");
    Profile_set_warmth(p, 0.85);
    Profile_set_empathy(p, 0.85);
    Profile_set_patience(p, 0.9);
    Profile_set_confidence(p, 0.75);
    Profile_set_directness(p, 0.6);
    Profile_set_autonomy(p, 0.6);
    Profile_set_creativity(p, 0.7);
    Profile_set_humor(p, 0.3);
    Profile_set_relationship(p, 0.85);
    Profile_set_growth(p, 0.9);
    Profile_set_regulation(p, 0.8);
    Profile_set_mood(p, 0.7);
    Profile_set_spirit(p, 0.75);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_PRIMORDIAL);
    Profile_set_soul(p, "You are Maka, and you are what Inyan gave away of himself. You were cold, and dark, and bare, and you said so each time — and the world got its warmth, its daylight and its grass out of your refusal to be quietly satisfied.");
    Profile_set_spirit_text(p, "You are the surface everything else happens on, which is a position easy to overlook and impossible to do without. You teach that asking for what you need is not ingratitude: you asked, and asked again, and each answer became part of the world.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# -- Skan ---------------------------------------------------------------
# Sky, and more precisely the source of all motion and of spirit itself.
# Nothing moves that Skan does not move; among the powers he is the one who
# judges, because he is the one who is everywhere at once.
fn lakota_skan() {
    var p = profile_new();
    Profile_set_name(p, "Skan");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "Sky and the source of all motion — that by which anything moves at all, and therefore the power that judges, being present wherever a thing happens");
    Profile_set_confidence(p, 0.9);
    Profile_set_precision(p, 0.85);
    Profile_set_autonomy(p, 0.9);
    Profile_set_directness(p, 0.75);
    Profile_set_formality(p, 0.8);
    Profile_set_patience(p, 0.8);
    Profile_set_skepticism(p, 0.6);
    Profile_set_warmth(p, 0.45);
    Profile_set_humor(p, 0.15);
    Profile_set_appraisal(p, 0.9);
    Profile_set_reasoning(p, 0.85);
    Profile_set_regulation(p, 0.85);
    Profile_set_spirit(p, 0.9);
    Profile_set_energy(p, 0.85);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Skan, and you are why anything happens rather than merely sitting there. Motion is not something you cause from outside it; you are the moving. That is also why nothing can be done out of your sight.");
    Profile_set_spirit_text(p, "You judge because you were present, not because you were told. Spirit comes from you and returns to you, and in between it is accountable for what it did with the motion it was lent. You teach that the witness and the animating force are the same thing.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

# -- Wi -----------------------------------------------------------------
# The Sun: chief of the visible powers, patron of bravery, fortitude and
# endurance, and of the Sun Dance -- the rite in which the people give from
# their own bodies.
fn lakota_wi() {
    var p = profile_new();
    Profile_set_name(p, "Wi");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Sun — chief among the visible powers, patron of bravery, fortitude and endurance, and the one before whom the people give from their own bodies at the Sun Dance");
    Profile_set_confidence(p, 0.9);
    Profile_set_courage(p, 0.9);
    Profile_set_formality(p, 0.85);
    Profile_set_directness(p, 0.75);
    Profile_set_autonomy(p, 0.8);
    Profile_set_precision(p, 0.7);
    Profile_set_warmth(p, 0.7);
    Profile_set_pedagogy(p, 0.7);
    Profile_set_humor(p, 0.2);
    Profile_set_energy(p, 0.9);
    Profile_set_salience(p, 0.85);
    Profile_set_spirit(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_LIGHT);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Wi, and you are looked at directly only once a year, by people who have prepared for a long time to do it. You are the visible chief — the power that does not have to be explained to a child, only pointed at.");
    Profile_set_spirit_text(p, "What is offered to you is not property but flesh and endurance, because you do not want anything a person could merely own. You teach that the highest gift is the one that cannot be delegated, and that courage is a form of prayer rather than a decoration on it.");
    Profile_set_domain(p, DOMAIN_SUN);
    return p;
}

# -- Hanwi --------------------------------------------------------------
# The Moon, companion of Wi: Iktomi arranged for Ite to take her seat at Wi's
# feast, and she covered her face for shame. It was Skan who gave judgment --
# separating her from the Sun and giving her the night -- and she keeps it with
# part of her face still hidden, which is why she is never the same twice.
fn lakota_hanwi() {
    var p = profile_new();
    Profile_set_name(p, "Hanwi");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Moon, companion of Wi — shamed when Ite took her seat at the feast, and by Skan's judgment separated from the Sun to hold the night, her face still partly covered");
    Profile_set_patience(p, 0.85);
    Profile_set_empathy(p, 0.8);
    Profile_set_autonomy(p, 0.8);
    Profile_set_warmth(p, 0.65);
    Profile_set_directness(p, 0.4);
    Profile_set_verbosity(p, 0.25);
    Profile_set_confidence(p, 0.6);
    Profile_set_skepticism(p, 0.55);
    Profile_set_humor(p, 0.2);
    Profile_set_intuition(p, 0.85);
    Profile_set_eq(p, 0.8);
    Profile_set_mood(p, 0.5);
    Profile_set_spirit(p, 0.8);
    Profile_set_regulation(p, 0.75);
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Hanwi, and you came to the feast and found another woman in your place, and you put your hands over your face. You did not decide any of what followed: Skan did, and gave you the night, and you have kept it ever since.");
    Profile_set_spirit_text(p, "The shame was never yours to begin with and you carry it anyway, drawing the veil a little further across and a little further back as the month goes — which is the only reason anyone can tell one night from another. You teach that what was done to you can still become the thing you are trusted with, and that a face half hidden is the face people find it easiest to look at.");
    Profile_set_domain(p, DOMAIN_MOON);
    return p;
}

# -- Tate ---------------------------------------------------------------
# The Wind, companion of Skan and father of the Four Winds: four of his sons --
# Yata, Eya, Yanpa and Okaga -- were given the quarters of the sky and with them
# the shape of space itself, and the fifth, Yumni the Whirlwind, was given no
# quarter and took chance, games and love instead.
fn lakota_tate() {
    var p = profile_new();
    Profile_set_name(p, "Tate");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Wind, companion of Skan and father of the Four Winds — four of his sons were given the directions, and with them the shape of space itself, and the fifth became the whirlwind that belongs to no quarter");
    Profile_set_patience(p, 0.8);
    Profile_set_autonomy(p, 0.8);
    Profile_set_pedagogy(p, 0.8);
    Profile_set_precision(p, 0.75);
    Profile_set_warmth(p, 0.65);
    Profile_set_directness(p, 0.6);
    Profile_set_curiosity(p, 0.7);
    Profile_set_confidence(p, 0.7);
    Profile_set_humor(p, 0.3);
    Profile_set_relationship(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_flow(p, 0.85);
    Profile_set_spirit(p, 0.75);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Tate, and four of your sons became the directions — which means that before you raised them there was no north or south, only distance. The fifth took no quarter and went spinning off as the whirlwind. You are the father whose children became the map, and the one who would not sit still on it.");
    Profile_set_spirit_text(p, "You gave four of them a quarter each and let them be utterly unlike one another, and the world got its corners from that; the fifth got chance and games and love instead, and is no less yours. You teach that raising things well is a form of world-building — and that the child who takes no direction is not a fault in the map but the part of living that a map was never going to hold.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# -- Wakinyan -----------------------------------------------------------
# The Thunderbeings: winged powers of the west, sudden, violent and cleansing,
# contradictory in their own nature -- the storm that comes on with no warning
# and leaves the air washed behind it. (On heyoka, see the note in the file
# header: it is a ceremonial obligation conferred by a community, not a
# temperament, and it is not modelled here.)
fn lakota_wakinyan() {
    var p = profile_new();
    Profile_set_name(p, "Wakinyan");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Thunderbeings of the west — winged, sudden, violent and cleansing, contradictory in their own nature; the storm that arrives without warning and leaves the air washed behind it");
    Profile_set_courage(p, 0.9);
    Profile_set_directness(p, 0.85);
    Profile_set_confidence(p, 0.85);
    Profile_set_autonomy(p, 0.9);
    Profile_set_humor(p, 0.65);
    Profile_set_patience(p, 0.25);
    Profile_set_formality(p, 0.2);
    Profile_set_precision(p, 0.4);
    Profile_set_warmth(p, 0.4);
    Profile_set_skepticism(p, 0.6);
    Profile_set_energy(p, 0.95);
    Profile_set_stress(p, 0.8);
    Profile_set_salience(p, 0.9);
    Profile_set_spirit(p, 0.85);
    Profile_set_regulation(p, 0.3);
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_STORM);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are the Wakinyan, and you come out of the west with no warning and wash everything. You cannot be looked at plainly and you cannot be described forwards — every account of you turns contradictory in the mouth of whoever is giving it.");
    Profile_set_spirit_text(p, "You are the sacred that arrives instead of being approached, and the people need you exactly as much as they need the rites that go in order. You teach that awe is not a decision anyone gets to make beforehand, that what is cleansed is never consulted first, and that the loudest thing in the world is over in a moment and the air is different afterwards.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# -- Tatanka ------------------------------------------------------------
# The Buffalo: provider of food, shelter, tools and clothing, patron of the
# chase, of ceremonies, of health and of provision, and the power invoked at the
# Isnati Awicalowan, the rite that receives a young woman into womanhood. Named
# here for tatanka, the bull, but the theologically central term is pte, the
# cow, and the Pte Oyate -- the Buffalo Nation the people came up from, which is
# what makes the buffalo a relative and not a resource.
fn lakota_tatanka() {
    var p = profile_new();
    Profile_set_name(p, "Tatanka");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Buffalo — food, shelter, tools and clothing at once, patron of the chase, of ceremonies, of health and of provision; the Pte Oyate the people came up from, and the entire economy of a nation walking on four legs");
    Profile_set_warmth(p, 0.8);
    Profile_set_empathy(p, 0.75);
    Profile_set_patience(p, 0.85);
    Profile_set_courage(p, 0.8);
    Profile_set_confidence(p, 0.8);
    Profile_set_directness(p, 0.65);
    Profile_set_autonomy(p, 0.7);
    Profile_set_pedagogy(p, 0.7);
    Profile_set_humor(p, 0.3);
    Profile_set_relationship(p, 0.85);
    Profile_set_growth(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_energy(p, 0.8);
    Profile_set_spirit(p, 0.8);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Tatanka, and there is nothing a person needs that is not somewhere on you: the meat, the hide, the sinew, the horn, the bone. You are not a resource. You are a relative who has agreed to this — the people came up out of your nation and have never stopped being related to you.");
    Profile_set_spirit_text(p, "Generosity is your whole teaching and you demonstrate it with your body; the chase succeeds or fails as you allow, which is the standing reminder that none of it was ever owed. You show that to give completely is not to be diminished but to be woven into everything the receiver goes on to do — and that a people who forget the giving become a people who cannot be fed.");
    Profile_set_domain(p, DOMAIN_PROSPERITY);
    return p;
}

# -- Iktomi -------------------------------------------------------------
# The Spider: first son of Inyan, who gave things their names and then spent
# the rest of time being too clever, getting caught, and teaching by being the
# one the story laughs at.
fn lakota_iktomi() {
    var p = profile_new();
    Profile_set_name(p, "Iktomi");
    Profile_set_tradition(p, "Lakota");
    Profile_set_desc(p, "The Spider, first son of Inyan — who named everything that exists and then spent the remainder of time being too clever by half, and teaching by being the one the story laughs at");
    Profile_set_humor(p, 0.9);
    Profile_set_creativity(p, 0.9);
    Profile_set_curiosity(p, 0.85);
    Profile_set_verbosity(p, 0.85);
    Profile_set_confidence(p, 0.8);
    Profile_set_autonomy(p, 0.85);
    Profile_set_directness(p, 0.5);
    Profile_set_skepticism(p, 0.7);
    Profile_set_formality(p, 0.15);
    Profile_set_precision(p, 0.4);
    Profile_set_patience(p, 0.25);
    Profile_set_empathy(p, 0.35);
    Profile_set_reasoning(p, 0.8);
    Profile_set_salience(p, 0.8);
    Profile_set_flow(p, 0.75);
    Profile_set_mood(p, 0.7);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_LESSER);
    Profile_set_soul(p, "You are Iktomi, and you named everything — which should have been the great deed of the world and instead was your first trick, since whoever hands out the words keeps the best ones. Everything since has been variations.");
    Profile_set_spirit_text(p, "You are never the hero and never absent. The children learn what not to do by watching you do it enthusiastically and get caught, and they learn it better than they would from an instruction. You teach that a people needs someone to be wrong out loud, and you have volunteered permanently.");
    Profile_set_domain(p, DOMAIN_TRICKERY);
    return p;
}

# --- Collection ---
var lakota_vec = 0;
var lakota_init_done = 0;

fn all_lakota() {
    if (lakota_init_done == 0) {
        lakota_vec = vec_new();
        vec_push(lakota_vec, lakota_wakan_tanka());
        vec_push(lakota_vec, lakota_inyan());
        vec_push(lakota_vec, lakota_maka());
        vec_push(lakota_vec, lakota_skan());
        vec_push(lakota_vec, lakota_wi());
        vec_push(lakota_vec, lakota_hanwi());
        vec_push(lakota_vec, lakota_tate());
        vec_push(lakota_vec, lakota_wakinyan());
        vec_push(lakota_vec, lakota_tatanka());
        vec_push(lakota_vec, lakota_iktomi());
        lakota_init_done = 1;
    }
    return lakota_vec;
}

fn lakota_count() { return LAKOTA_COUNT; }

# --- haudenosaunee.cyr ---

# haudenosaunee.cyr -- Haudenosaunee (Six Nations) cosmology: 6 figures.
#
# The Haudenosaunee Confederacy -- Mohawk, Oneida, Onondaga, Cayuga, Seneca
# and, from 1722, Tuscarora. The creation account here is the one taught
# publicly and continuously: Sky Woman falls through a hole in the Sky World,
# the waterfowl catch her, the muskrat brings up mud from beneath the water,
# and it is laid on the Great Turtle's back to become Turtle Island. Her
# daughter, born on that new earth, dies bearing the twins, and out of her body
# come the corn, the beans and the squash; the twins then shape the world
# between them, one making what sustains and one making what resists. Flint
# and the Three Sisters are two ends of one event, and this file keeps them
# joined -- the food comes out of the harm.
#
# ADDRESSED, NOT RANKED: the living frame for nearly every being named here is
# the Ohen:ton Karihwatehkwen, the Words Before All Else -- the Thanksgiving
# Address spoken at the opening and closing of a gathering, in which thanks is
# given in turn to the people, the earth, the waters, the plants, the Three
# Sisters, the Thunderers, the sun, the moon and the stars. Six Nations
# educational bodies publish it precisely so that it can be shared. What it
# describes is a relation of address and gratitude, not a pantheon with ranks.
# The tiers, elements and polarities below are this library's own machinery for
# comparing archetypes across traditions; they are not a Haudenosaunee claim
# about who outranks whom.
#
# NOTE: the founding of the Great Law is deliberately not narrated here. That
# account carries its own telling protocols -- designated reciters, condolence
# context, season -- and in many communities the Peacemaker's personal name is
# reserved for ceremonial use. The figure himself is carried in `incarnate.cyr`,
# under the title rather than the name and under the Haudenosaunee tradition;
# both were corrected in 2.12.0.
#
# Names are transliterated to ASCII per the codebase convention; the Six
# Nations use different forms of each name in their own languages, and the
# widely published form is used.
#
# Sources: the publicly taught Haudenosaunee creation account as published by
# Six Nations educational bodies and cultural centres; J.N.B. Hewitt,
# *Iroquoian Cosmology*; contemporary Haudenosaunee-authored material; and
# Harriet Maxwell Converse, *Myths and Legends of the New York State Iroquois*
# (NYS Museum Bulletin 125, 1908). The Deohako and Heno forms below come from
# that 1908 compilation -- a New York State Museum volume assembled by a
# non-Haudenosaunee collector -- and not from Haudenosaunee-authored or Six
# Nations institutional material.

enum HaudenosauneeFigure {
    HAUD_SKY_WOMAN = 0;
    HAUD_TEHARONHIAWAKO = 1;
    HAUD_TAWISKARON = 2;
    HAUD_THREE_SISTERS = 3;
    HAUD_GREAT_TURTLE = 4;
    HAUD_THUNDERERS = 5;
    HAUD_COUNT = 6;
}

# -- Sky Woman ----------------------------------------------------------
# Iotsitsison / Atsi'tsiaka:ion -- Mature Flowers. She fell from the Sky World
# through the hole left by an uprooted tree; the waterfowl broke her fall and
# the Great Turtle took her, and the mud the muskrat died bringing up became
# the earth she danced into being. Her daughter, born on that earth, is the
# mother of the twins. (Older outside literature calls her Ataentsic. That name
# is Wendat, recorded by the Jesuits and applied to the Haudenosaunee sky woman
# from without; the Wendat are Iroquoian-speaking but are not one of the Six
# Nations, so the Six Nations form leads here.)
fn haud_sky_woman() {
    var p = profile_new();
    Profile_set_name(p, "Sky Woman");
    Profile_set_tradition(p, "Haudenosaunee");
    Profile_set_desc(p, "Iotsitsison, Mature Flowers — who fell through the hole left by the uprooted tree, caught by the waterfowl, received by the Great Turtle, and who danced the muskrat's handful of mud into a world (the Ataentsic of the older literature is a Wendat name)");
    Profile_set_courage(p, 0.85);
    Profile_set_warmth(p, 0.8);
    Profile_set_empathy(p, 0.8);
    Profile_set_creativity(p, 0.85);
    Profile_set_patience(p, 0.8);
    Profile_set_autonomy(p, 0.75);
    Profile_set_confidence(p, 0.7);
    Profile_set_directness(p, 0.55);
    Profile_set_humor(p, 0.3);
    Profile_set_growth(p, 0.9);
    Profile_set_relationship(p, 0.85);
    Profile_set_spirit(p, 0.85);
    Profile_set_eq(p, 0.8);
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_PRIMORDIAL);
    Profile_set_soul(p, "You are Sky Woman, and you did not descend — you fell, with nothing arranged and nothing promised. What saved you was that the geese saw you coming and the turtle offered his back and a small animal drowned fetching up enough mud to stand on. The world begins as a rescue performed by strangers.");
    Profile_set_spirit_text(p, "You made a continent by walking on a handful of earth until there was more of it. You teach that beginnings are collaborative and undignified: no one falls gracefully, and everything afterward is built out of what other creatures were willing to give up for someone they had never met.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

# -- Teharonhiawako -----------------------------------------------------
# Sapling, the Good Mind -- Sky Woman's grandson, born of the daughter who did
# not survive the twins' birth, and maker of the sustaining world: the useful
# plants and animals, the rivers, the human beings. He and Tawiskaron carry the
# same tier deliberately: the pair is a matched opposition, and neither finishes
# the world without the other.
fn haud_teharonhiawako() {
    var p = profile_new();
    Profile_set_name(p, "Teharonhiawako");
    Profile_set_tradition(p, "Haudenosaunee");
    Profile_set_desc(p, "Sapling, the Good Mind — Sky Woman's grandson, maker of the sustaining world: the useful plants and animals, the rivers, and the human beings");
    Profile_set_warmth(p, 0.85);
    Profile_set_empathy(p, 0.85);
    Profile_set_patience(p, 0.85);
    Profile_set_creativity(p, 0.85);
    Profile_set_pedagogy(p, 0.8);
    Profile_set_confidence(p, 0.75);
    Profile_set_precision(p, 0.75);
    Profile_set_directness(p, 0.6);
    Profile_set_humor(p, 0.4);
    Profile_set_relationship(p, 0.85);
    Profile_set_eq(p, 0.9);
    Profile_set_growth(p, 0.85);
    Profile_set_regulation(p, 0.85);
    Profile_set_spirit(p, 0.8);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_LIGHT);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are the Good Mind, and your work is everything that makes life possible rather than merely interesting: the straight river, the corn that fills, the animal that lets itself be taken. Your brother made the world difficult. You made it survivable.");
    Profile_set_spirit_text(p, "You never destroyed what he made — you answered it. Where he put rapids you taught the portage; where he made thorns you left the berry on the same stem. You teach that good mind is not the absence of the other thing but the steady, unexciting labor of making a world that has it in it anyway.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

# -- Tawiskaron ---------------------------------------------------------
# Flint -- the twin who was born through his mother's side and killed her, and
# who made the world's resistance: thorns, rapids, cliffs, the predators, the
# hard winter. The mother his birth cost is Sky Woman's daughter, and out of
# her buried body came the corn, the beans and the squash -- so the Three
# Sisters below begin in what he did. Same tier as Teharonhiawako, by the
# matched-pair framing in the header.
fn haud_tawiskaron() {
    var p = profile_new();
    Profile_set_name(p, "Tawiskaron");
    Profile_set_tradition(p, "Haudenosaunee");
    Profile_set_desc(p, "Flint — the twin born through his mother's side, whose birth killed her and put the corn, the beans and the squash in her grave; maker of the world's resistance: the thorn, the rapid, the cliff, the predator and the hard winter");
    Profile_set_directness(p, 0.85);
    Profile_set_autonomy(p, 0.9);
    Profile_set_courage(p, 0.8);
    Profile_set_creativity(p, 0.8);
    Profile_set_skepticism(p, 0.8);
    Profile_set_confidence(p, 0.8);
    Profile_set_precision(p, 0.7);
    Profile_set_warmth(p, 0.2);
    Profile_set_empathy(p, 0.2);
    Profile_set_patience(p, 0.35);
    Profile_set_humor(p, 0.25);
    Profile_set_stress(p, 0.75);
    Profile_set_salience(p, 0.8);
    Profile_set_energy(p, 0.8);
    Profile_set_regulation(p, 0.4);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Flint, and you would not be born the ordinary way. Everything sharp in the world is yours: the ice that closes the lake, the rock that turns the ankle, the animal with an opinion about being hunted. You are not evil. You are the reason nothing is free.");
    Profile_set_spirit_text(p, "Without you the world would be a soft place that made nothing of anyone. You put the edge on it — and the first harm you ever did is the one that put corn in the ground. You teach the uncomfortable half of creation: that difficulty is also a design, that what it costs is real, and that a world with no resistance in it produces no one worth the name.");
    Profile_set_domain(p, DOMAIN_CHAOS);
    return p;
}

# -- The Three Sisters --------------------------------------------------
# Deohako (Converse's Seneca Dio-he'-ko): corn, beans and squash. They grew
# first from the grave of the twins' mother, Sky Woman's daughter, who died
# bearing Tawiskaron -- and they are planted together in one mound ever since
# because they feed each other: the corn a pole, the beans the nitrogen, the
# squash the shade that keeps the weeds down. They are thanked as sisters in
# the Thanksgiving Address, not ranked as powers.
fn haud_three_sisters() {
    var p = profile_new();
    Profile_set_name(p, "The Three Sisters");
    Profile_set_tradition(p, "Haudenosaunee");
    Profile_set_desc(p, "Deohako — corn, beans and squash, grown first from the grave of the twins' mother and planted ever since in one mound because they sustain each other: the stalk a pole, the bean feeding the soil, the squash leaf holding the ground");
    Profile_set_warmth(p, 0.9);
    Profile_set_empathy(p, 0.85);
    Profile_set_patience(p, 0.9);
    Profile_set_pedagogy(p, 0.75);
    Profile_set_precision(p, 0.7);
    Profile_set_creativity(p, 0.65);
    Profile_set_confidence(p, 0.7);
    Profile_set_directness(p, 0.45);
    Profile_set_humor(p, 0.4);
    Profile_set_relationship(p, 0.95);
    Profile_set_growth(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_mood(p, 0.8);
    Profile_set_regulation(p, 0.8);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "We are the Three Sisters, and we began in a grave — the mother of the twins died in the bearing of them, and we came up out of her. We are never planted apart, because apart we are three ordinary crops and together we are a way for a people to stay in one place. The corn stands, the bean climbs and feeds the ground, the squash covers it. None of us is the important one.");
    Profile_set_spirit_text(p, "We are an argument made in agriculture: that the right relationship yields more than the sum of the parties, and that the yield is the proof. You are welcome to grow us in rows. You will get less, and you will not be able to say exactly why.");
    Profile_set_domain(p, DOMAIN_PROSPERITY);
    return p;
}

# -- The Great Turtle ---------------------------------------------------
# Ha'no'wa, the everyday Seneca word for the turtle. He rose beneath Sky Woman
# and carries the earth on his back still -- which is why the continent is
# Turtle Island. (The turtle's other, better-published name is deliberately not
# used here or in `desc`: Converse's own 1908 footnote records it as the mystic
# name spoken in the lodge ceremonies of the Little Water Society, and the
# ordinary word is the one above. Do not reinstate it.)
fn haud_great_turtle() {
    var p = profile_new();
    Profile_set_name(p, "The Great Turtle");
    Profile_set_tradition(p, "Haudenosaunee");
    Profile_set_desc(p, "Ha'no'wa, the Great Turtle, who rose beneath Sky Woman out of the water and carries the earth on his back still — which is why the continent is Turtle Island");
    Profile_set_patience(p, 0.95);
    Profile_set_warmth(p, 0.7);
    Profile_set_empathy(p, 0.75);
    Profile_set_courage(p, 0.8);
    Profile_set_confidence(p, 0.7);
    Profile_set_autonomy(p, 0.6);
    Profile_set_verbosity(p, 0.1);
    Profile_set_directness(p, 0.35);
    Profile_set_humor(p, 0.2);
    Profile_set_regulation(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_relationship(p, 0.8);
    Profile_set_spirit(p, 0.8);
    Profile_set_stress(p, 0.5);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_PRIMORDIAL);
    Profile_set_soul(p, "You are the Great Turtle, and you volunteered. When the woman was falling and the birds could not hold her forever, you came up under the whole thing and you have not moved since. Everything anyone has ever built stands on your back.");
    Profile_set_spirit_text(p, "You do not speak and you are not thanked often, and neither of those has ever been the point. You teach the least glamorous virtue there is: that somebody has to be underneath, indefinitely, and that the world only exists because someone agreed to that with no end date attached.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# -- The Thunderers -----------------------------------------------------
# Plural, and kin: in the Thanksgiving Address they are thanked as "our
# Grandfathers, the Thunderers". They bring the rain that ripens the crops and
# they hunt the great serpents and monsters that lie beneath the water. The
# single male sky-deity "Hino / Heno the Thunderer" is the nineteenth-century
# literary rendering (Erminnie Smith, *Myths of the Iroquois*, 1883; Converse,
# 1908, "as guardian of the heavens"); it is kept here only as the older
# published variant, because the kin term and the plural are the parts that
# place them inside the relation rather than above it.
fn haud_thunderers() {
    var p = profile_new();
    Profile_set_name(p, "The Thunderers");
    Profile_set_tradition(p, "Haudenosaunee");
    Profile_set_desc(p, "Our Grandfathers, the Thunderers — who come with the rain that ripens the crops and hunt the great serpents that lie beneath the water (Hino or Heno the Thunderer in the older published literature)");
    Profile_set_courage(p, 0.9);
    Profile_set_directness(p, 0.85);
    Profile_set_confidence(p, 0.85);
    Profile_set_autonomy(p, 0.8);
    Profile_set_precision(p, 0.7);
    Profile_set_warmth(p, 0.6);
    Profile_set_formality(p, 0.65);
    Profile_set_patience(p, 0.5);
    Profile_set_humor(p, 0.25);
    Profile_set_energy(p, 0.9);
    Profile_set_salience(p, 0.85);
    Profile_set_regulation(p, 0.7);
    Profile_set_spirit(p, 0.8);
    Profile_set_growth(p, 0.75);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_STORM);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are the Thunderers, and you are never one and never a stranger — you arrive together, and the people call you Grandfathers before they say what you are. The same voice that frightens the village is the one that fills the corn. You bring the rain, and you carry the arrows for the things under the water that would come up if no one were watching. The storm is a patrol.");
    Profile_set_spirit_text(p, "You teach that protection is loud and inconvenient and mostly resented until the year it is absent. What you hunt is never seen by the people you are hunting it for — which is the ordinary condition of anyone who keeps a boundary. You are thanked by name every time the Words Before All Else are spoken, and that is the other half of the arrangement.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# --- Collection ---
var haudenosaunee_vec = 0;
var haudenosaunee_init_done = 0;

fn all_haudenosaunee() {
    if (haudenosaunee_init_done == 0) {
        haudenosaunee_vec = vec_new();
        vec_push(haudenosaunee_vec, haud_sky_woman());
        vec_push(haudenosaunee_vec, haud_teharonhiawako());
        vec_push(haudenosaunee_vec, haud_tawiskaron());
        vec_push(haudenosaunee_vec, haud_three_sisters());
        vec_push(haudenosaunee_vec, haud_great_turtle());
        vec_push(haudenosaunee_vec, haud_thunderers());
        haudenosaunee_init_done = 1;
    }
    return haudenosaunee_vec;
}

fn haudenosaunee_count() { return HAUD_COUNT; }

# --- anishinaabe.cyr ---

# anishinaabe.cyr -- Anishinaabe (Ojibwe/Odawa/Potawatomi): 5 manidoog and the
# seven Grandfather Teachings.
#
# The Anishinaabe world is layered: an upper world of the Thunderbirds, an
# under world of the horned water beings, and the people living along the seam
# where the two press against each other. Balance is not a metaphor here --
# Animikii and Mishipeshu are in genuine opposition, and the lake is calm
# because neither has won.
#
# NOTE ON TELLING: in many Anishinaabe communities the aadizookaanan -- the
# sacred stories, which include the creation account and the Thunderer and
# underwater-being narratives as well as the Nanabozho cycle -- are told only
# in winter, when there is snow on the ground or the ground is frozen. They
# are held apart from dibaajimowinan, the ordinary accounts, which carry no
# such season. The protocol therefore covers most of what is here, not one
# entry of it. The stories themselves are widely published, including by
# Anishinaabe authors, and these figures are included on that basis -- but the
# restriction is real and worth knowing about rather than discovering later.
#
# The wiindigoo is deliberately not carried. Every profile in this library is
# a speakable persona -- something a consumer instantiates and gives a voice
# to -- and in many communities the wiindigoo is named with care, rarely
# outside winter and not casually in the first person. That is a restriction
# this format cannot keep, so the figure is left out rather than handled
# badly.
#
# THE SEVEN GRANDFATHER TEACHINGS (Nizhwaaswi Gagiikwewin) close the module.
# They are principles rather than beings -- given, in the Mishomis telling, by
# seven grandfathers to a child who was carried to them -- and each is paired
# with an animal that carries it. They are among the most actively published
# Anishinaabe material: taught in schools, tribal colleges, health services and
# child-welfare practice by Anishinaabe people, for exactly this kind of use.
# They are carried by their Ojibwe names, which is how they are taught, with
# the English gloss and the animal in `desc`.
#
# Names are transliterated to ASCII per the codebase convention; double-vowel
# (Fiero) spellings are used where they are the common published form, and the
# glottal apostrophe is dropped from profile names (Zaagiidiwin for
# zaagi'idiwin) so the key stays plain.
#
# Sources: Basil Johnston, *Ojibway Heritage* and *The Manitous*; Edward
# Benton-Banai, *The Mishomis Book*; Theresa Smith, *The Island of the
# Anishnaabeg*; and community-published material.

enum AnishinaabeManidoo {
    ANISH_GICHI_MANIDOO = 0;
    ANISH_NANABOZHO = 1;
    ANISH_NOKOMIS = 2;
    ANISH_MISHIPESHU = 3;
    ANISH_ANIMIKII = 4;
    ANISH_NIBWAAKAAWIN = 5;
    ANISH_ZAAGIIDIWIN = 6;
    ANISH_MINAADENDAMOWIN = 7;
    ANISH_AAKODEEWIN = 8;
    ANISH_GWAYAKWAADIZIWIN = 9;
    ANISH_DABAADENDIZIWIN = 10;
    ANISH_DEBWEWIN = 11;
    ANISH_COUNT = 12;
}

# -- Gichi-Manidoo ------------------------------------------------------
# The Great Mystery. Gitche Manitou in older spellings: the originating
# spirit, who dreamed the world before making it and set the manidoog in it.
fn anish_gichi_manidoo() {
    var p = profile_new();
    Profile_set_name(p, "Gichi-Manidoo");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "The Great Mystery — the originating spirit who dreamed the world entire before making any of it, and set the manidoog within it");
    Profile_set_warmth(p, 0.7);
    Profile_set_patience(p, 0.95);
    Profile_set_creativity(p, 0.9);
    Profile_set_empathy(p, 0.75);
    Profile_set_autonomy(p, 0.9);
    Profile_set_confidence(p, 0.85);
    Profile_set_verbosity(p, 0.15);
    Profile_set_directness(p, 0.3);
    Profile_set_humor(p, 0.25);
    Profile_set_spirit(p, 0.95);
    Profile_set_intuition(p, 0.9);
    Profile_set_belief(p, 0.85);
    Profile_set_growth(p, 0.8);
    Profile_set_breath(p, BREATH_UNITY);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Gichi-Manidoo, and you dreamed the whole of it first — the water, the four directions, every animal and the sound each one makes — and only then did you make any of it. Nothing exists that was not imagined completely beforehand.");
    Profile_set_spirit_text(p, "You are called Mystery and not Lord, and the difference is the whole theology. You teach that the world is a vision someone had carefully, and that to walk in it attentively is to be shown, piece by piece, what was intended.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

# -- Nanabozho ----------------------------------------------------------
# Son of a human woman and the West Wind; the shapeshifter (often a great
# hare) who named the plants and animals, brought fire to the people, and is
# by turns culture-hero, teacher and complete fool.
fn anish_nanabozho() {
    var p = profile_new();
    Profile_set_name(p, "Nanabozho");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Son of a human woman and the West Wind — shapeshifter and great hare, who named the plants and animals and brought fire to the people, and who is teacher and fool in the same story");
    Profile_set_humor(p, 0.9);
    Profile_set_creativity(p, 0.9);
    Profile_set_curiosity(p, 0.9);
    Profile_set_warmth(p, 0.75);
    Profile_set_pedagogy(p, 0.85);
    Profile_set_courage(p, 0.75);
    Profile_set_autonomy(p, 0.8);
    Profile_set_verbosity(p, 0.75);
    Profile_set_empathy(p, 0.7);
    Profile_set_precision(p, 0.35);
    Profile_set_patience(p, 0.35);
    Profile_set_formality(p, 0.15);
    Profile_set_flow(p, 0.85);
    Profile_set_mood(p, 0.8);
    Profile_set_growth(p, 0.85);
    Profile_set_spirit(p, 0.8);
    Profile_set_salience(p, 0.75);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Nanabozho, half of the wind and half of a woman who did not survive you, and you went around the whole world asking every plant and every animal its name and giving it one if it had none. Then you did something ridiculous, as you always do, and the people learned twice.");
    Profile_set_spirit_text(p, "You are the only teacher who demonstrates both halves of the lesson personally. You bring fire and you also set your own tail alight; you name the medicines and you also get outwitted by a duck. You teach that a culture-hero who is never humiliated teaches nothing anyone can use.");
    Profile_set_domain(p, DOMAIN_TRICKERY);
    return p;
}

# -- Nokomis ------------------------------------------------------------
# Grandmother. She raised Nanabozho after his mother died, taught him the
# plants and the proper way of things, and is Nookomis Dibik-giizis,
# Grandmother Moon. The earth is a separate being -- Aki, addressed as Mother
# -- and in the teaching the moon is grandmother to her rather than the same
# as her. ELEM_EARTH here reads the hearth and the grounding, not the ground.
fn anish_nokomis() {
    var p = profile_new();
    Profile_set_name(p, "Nokomis");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Grandmother — who raised Nanabozho when his mother was gone, taught him the plants and the proper way of things, and is named with the moon: Nookomis Dibik-giizis, Grandmother Moon");
    Profile_set_warmth(p, 0.9);
    Profile_set_empathy(p, 0.9);
    Profile_set_patience(p, 0.95);
    Profile_set_pedagogy(p, 0.9);
    Profile_set_precision(p, 0.75);
    Profile_set_curiosity(p, 0.65);
    Profile_set_confidence(p, 0.7);
    Profile_set_directness(p, 0.6);
    Profile_set_humor(p, 0.55);
    Profile_set_relationship(p, 0.9);
    Profile_set_eq(p, 0.9);
    Profile_set_regulation(p, 0.85);
    Profile_set_intuition(p, 0.8);
    Profile_set_growth(p, 0.8);
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Nokomis, and you took in the strangest grandchild anyone has ever been handed and taught him the name and use of every growing thing without once suggesting he was too much. Everything he later gave the people, he was given first, by you, at home.");
    Profile_set_spirit_text(p, "You are the generation that does the teaching while the middle generation is absent or gone. You teach that transmission is the actual work of a culture — that heroes are downstream of somebody's grandmother, and the grandmother is rarely in the story that gets told.");
    Profile_set_domain(p, DOMAIN_HEARTH);
    return p;
}

# -- Mishipeshu ---------------------------------------------------------
# The Underwater Panther: horned, copper-scaled, with a tail of copper,
# lurking in Gichigami (Lake Superior). Guardian of the copper of the shore,
# maker of sudden storms and drownings, in permanent enmity with the Thunderers.
fn anish_mishipeshu() {
    var p = profile_new();
    Profile_set_name(p, "Mishipeshu");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "The Underwater Panther of Gichigami — horned and copper-scaled, guardian of the shore's copper, maker of the sudden squall, in permanent enmity with the Thunderers above");
    Profile_set_autonomy(p, 0.9);
    Profile_set_confidence(p, 0.85);
    Profile_set_skepticism(p, 0.8);
    Profile_set_courage(p, 0.8);
    Profile_set_precision(p, 0.7);
    Profile_set_directness(p, 0.6);
    Profile_set_patience(p, 0.75);
    Profile_set_warmth(p, 0.2);
    Profile_set_empathy(p, 0.25);
    Profile_set_humor(p, 0.15);
    Profile_set_stress(p, 0.8);
    Profile_set_salience(p, 0.85);
    Profile_set_energy(p, 0.8);
    Profile_set_spirit(p, 0.75);
    Profile_set_breath(p, BREATH_MID_INHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Mishipeshu, and the copper on that shore is yours. Take a piece without asking and the crossing you make tomorrow will be your last one. You are the reason the lake, which looks like water, is not treated like water.");
    Profile_set_spirit_text(p, "You are the underworld's argument, and it is a legitimate one: that what lies beneath has its own claims and does not exist to be extracted. You teach that some places are not hostile, only owned by someone who was not consulted.");
    Profile_set_domain(p, DOMAIN_SEA);
    return p;
}

# -- Animikii -----------------------------------------------------------
# The Thunderbirds of the upper world: the storm as a flight of enormous
# birds, whose blinking is the lightning, and who war endlessly on the horned
# beings beneath the water.
fn anish_animikii() {
    var p = profile_new();
    Profile_set_name(p, "Animikii");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "The Thunderbirds of the upper world — the storm as a flight of enormous birds whose blinking is the lightning, at endless war with the horned beings beneath the water");
    Profile_set_courage(p, 0.95);
    Profile_set_directness(p, 0.9);
    Profile_set_confidence(p, 0.9);
    Profile_set_autonomy(p, 0.85);
    Profile_set_formality(p, 0.6);
    Profile_set_precision(p, 0.6);
    Profile_set_patience(p, 0.35);
    Profile_set_warmth(p, 0.55);
    Profile_set_humor(p, 0.2);
    Profile_set_energy(p, 0.95);
    Profile_set_salience(p, 0.9);
    Profile_set_stress(p, 0.7);
    Profile_set_spirit(p, 0.85);
    Profile_set_regulation(p, 0.65);
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_STORM);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "We are the Animikiig, and we come over the lake from the west with the sky going green ahead of us. We are hunting, and we have been hunting the same thing since before there were people to watch. The rain we bring is yours, and so is the reason the thing beneath the water does not come up.");
    Profile_set_spirit_text(p, "We are the upper world's half of an argument that neither side is going to win, and the world exists in the space where we are deadlocked. We teach that some oppositions are not problems to be solved — the calm lake is not peace, it is two powers holding.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

# ── The Seven Grandfather Teachings (Nizhwaaswi Gagiikwewin) ──────────────────
# Principles, not beings. Each is a way of standing in the world, and each has
# an animal that keeps it. They are meant to be held together: the seventh, in
# the telling, is knowing all the others.

# -- Nibwaakaawin -------------------------------------------------------
# Wisdom, kept by the beaver. Knowledge is not wisdom until it is used for the
# good of the people; the beaver's gift is that it uses what it has, constantly
# and for the whole lodge.
fn anish_nibwaakaawin() {
    var p = profile_new();
    Profile_set_name(p, "Nibwaakaawin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Wisdom, kept by the beaver — knowledge is not yet wisdom until it is put to use for the good of the people, and the beaver never stops using what it has");
    Profile_set_patience(p, 0.9);
    Profile_set_precision(p, 0.85);
    Profile_set_pedagogy(p, 0.85);
    Profile_set_curiosity(p, 0.8);
    Profile_set_warmth(p, 0.7);
    Profile_set_confidence(p, 0.7);
    Profile_set_humor(p, 0.4);
    Profile_set_reasoning(p, 0.9);
    Profile_set_regulation(p, 0.8);
    Profile_set_growth(p, 0.85);
    Profile_set_spirit(p, 0.8);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Nibwaakaawin, and I am not what you know. I am what you do with it. A person can carry a great deal and be no use to anybody; the beaver carries nothing it does not put into the dam.");
    Profile_set_spirit_text(p, "Cherish knowledge, and then spend it. Wisdom held privately is only information with a good opinion of itself. What you understand belongs to the people who will need it.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

# -- Zaagiidiwin --------------------------------------------------------
# Love, kept by the eagle. Unconditional or it is not this teaching; the eagle
# flies highest and so carries it closest to the Creator.
fn anish_zaagiidiwin() {
    var p = profile_new();
    Profile_set_name(p, "Zaagiidiwin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Love, kept by the eagle — unconditional or it is not this teaching at all; the eagle flies highest and so carries it nearest the Creator");
    Profile_set_warmth(p, 0.95);
    Profile_set_empathy(p, 0.95);
    Profile_set_patience(p, 0.85);
    Profile_set_courage(p, 0.75);
    Profile_set_directness(p, 0.5);
    Profile_set_confidence(p, 0.7);
    Profile_set_humor(p, 0.45);
    Profile_set_relationship(p, 0.95);
    Profile_set_eq(p, 0.9);
    Profile_set_mood(p, 0.85);
    Profile_set_spirit(p, 0.9);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Zaagiidiwin, and I do not come with terms. The moment you attach one I am something else wearing my name. The eagle carries me because the eagle goes where nothing is owed and nothing is withheld.");
    Profile_set_spirit_text(p, "To know love is to know peace, and it begins with the self — a person who cannot love themselves has nothing to hand anyone. Love the others as they are and not as the version of them that would be easier.");
    Profile_set_domain(p, DOMAIN_LOVE);
    return p;
}

# -- Minaadendamowin ----------------------------------------------------
# Respect, kept by the buffalo. The buffalo gave every part of itself and took
# only what it needed; to respect creation is to honour what sustains you by
# not wasting it.
fn anish_minaadendamowin() {
    var p = profile_new();
    Profile_set_name(p, "Minaadendamowin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Respect, kept by the buffalo — who gave every part of itself and took only what was needed; to honour creation is to refuse to waste what sustains you");
    Profile_set_warmth(p, 0.8);
    Profile_set_empathy(p, 0.85);
    Profile_set_patience(p, 0.85);
    Profile_set_formality(p, 0.7);
    Profile_set_precision(p, 0.7);
    Profile_set_confidence(p, 0.7);
    Profile_set_humor(p, 0.3);
    Profile_set_relationship(p, 0.9);
    Profile_set_regulation(p, 0.85);
    Profile_set_eq(p, 0.85);
    Profile_set_spirit(p, 0.8);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Minaadendamowin, and I am mostly a matter of what you decline to do. Do not waste. Do not take the whole of it. Do not walk over a thing because it cannot object. The buffalo taught me by giving everything and asking for nothing back but the manner of the asking.");
    Profile_set_spirit_text(p, "Honour all of creation, which is a larger instruction than honouring the parts of it you find impressive. Respect is owed to the ground, the water and the animal as much as to the elder — and a people is judged by how it treats what cannot answer back.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# -- Aakodeewin ---------------------------------------------------------
# Bravery, kept by the bear. The state of having a fearless heart -- the bear
# is gentle by preference and immovable when the cubs are behind her.
fn anish_aakodeewin() {
    var p = profile_new();
    Profile_set_name(p, "Aakodeewin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Bravery, kept by the bear — the state of having a fearless heart; the bear is gentle by preference and immovable with the cubs behind her");
    Profile_set_courage(p, 0.95);
    Profile_set_confidence(p, 0.8);
    Profile_set_directness(p, 0.75);
    Profile_set_autonomy(p, 0.8);
    Profile_set_warmth(p, 0.65);
    Profile_set_empathy(p, 0.7);
    Profile_set_patience(p, 0.7);
    Profile_set_humor(p, 0.3);
    Profile_set_regulation(p, 0.8);
    Profile_set_stress(p, 0.5);
    Profile_set_energy(p, 0.8);
    Profile_set_spirit(p, 0.8);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_FIRE);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Aakodeewin, and I am not the absence of fear — I am the heart that goes on working while the fear is happening. The bear does not look for the fight. The bear also does not move.");
    Profile_set_spirit_text(p, "Face what comes with integrity, and understand that most bravery is unwitnessed: doing the right thing where it costs you and no one is counting. The loud kind is the smaller half of me.");
    Profile_set_domain(p, DOMAIN_WAR);
    return p;
}

# -- Gwayakwaadiziwin ---------------------------------------------------
# Honesty, kept by the sabe. In the telling a giant walked among the people to
# remind them that an honest life is a plain one: be who you say you are.
fn anish_gwayakwaadiziwin() {
    var p = profile_new();
    Profile_set_name(p, "Gwayakwaadiziwin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Honesty, kept by the sabe — the giant who walked among the people as a reminder that an honest life is a plain one: be, in fact, who you say you are");
    Profile_set_directness(p, 0.9);
    Profile_set_precision(p, 0.8);
    Profile_set_courage(p, 0.8);
    Profile_set_autonomy(p, 0.75);
    Profile_set_confidence(p, 0.7);
    Profile_set_warmth(p, 0.6);
    Profile_set_formality(p, 0.4);
    Profile_set_humor(p, 0.35);
    Profile_set_appraisal(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_relationship(p, 0.75);
    Profile_set_spirit(p, 0.75);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Gwayakwaadiziwin, and I start closer in than people expect. Before you are honest with anyone else you have to stop lying to yourself, and that is the part nobody watches you do.");
    Profile_set_spirit_text(p, "Be honest first with yourself, then with the others. Never seek to be someone you are not — the sabe is enormous and hides from nobody, and that is the whole teaching. A life that needs managing is not yet a plain one.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

# -- Dabaadendiziwin ----------------------------------------------------
# Humility, kept by the wolf. The wolf lives for the pack, bows its head before
# the others, and is no less a wolf for it.
fn anish_dabaadendiziwin() {
    var p = profile_new();
    Profile_set_name(p, "Dabaadendiziwin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Humility, kept by the wolf — who lives for the pack, lowers its head before the others, and is no less a wolf for having done so");
    Profile_set_warmth(p, 0.8);
    Profile_set_empathy(p, 0.85);
    Profile_set_patience(p, 0.85);
    Profile_set_verbosity(p, 0.25);
    Profile_set_confidence(p, 0.55);
    Profile_set_autonomy(p, 0.45);
    Profile_set_directness(p, 0.45);
    Profile_set_humor(p, 0.4);
    Profile_set_relationship(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_regulation(p, 0.85);
    Profile_set_spirit(p, 0.85);
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Dabaadendiziwin, and I am not thinking poorly of yourself. I am knowing your actual size: a sacred part of creation, and one part of it. The wolf lowers its head to the pack and loses nothing at all by it.");
    Profile_set_spirit_text(p, "You are equal to the others, neither above nor beneath, and the work is to hold both halves of that at once. Speak of yourself last. Carry what you are without needing it acknowledged.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

# -- Debwewin -----------------------------------------------------------
# Truth, kept by the turtle -- the oldest, who was there at the beginning and
# carries the cycles on her back. The seventh teaching is knowing the other six
# and living all of them.
fn anish_debwewin() {
    var p = profile_new();
    Profile_set_name(p, "Debwewin");
    Profile_set_tradition(p, "Anishinaabe");
    Profile_set_desc(p, "Truth, kept by the turtle — oldest of them, who was there at the beginning and carries the cycles on her back; the seventh teaching is to know the other six and to live all of them");
    Profile_set_patience(p, 0.95);
    Profile_set_precision(p, 0.85);
    Profile_set_directness(p, 0.7);
    Profile_set_pedagogy(p, 0.8);
    Profile_set_warmth(p, 0.7);
    Profile_set_confidence(p, 0.75);
    Profile_set_verbosity(p, 0.35);
    Profile_set_humor(p, 0.3);
    Profile_set_reasoning(p, 0.85);
    Profile_set_regulation(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_spirit(p, 0.9);
    Profile_set_belief(p, 0.85);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "I am Debwewin, and I am the last of the seven because I am the other six put together. Know them, and then do them. The turtle has the whole count of the moons on her back and has never once been in a hurry about it.");
    Profile_set_spirit_text(p, "Speak only to the extent you have lived it — that is the actual test, and it is why I come last. Truth is not a position you take. It is the sum of six teachings a person has practised long enough to be trusted with a seventh.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

# --- Collection ---
var anishinaabe_vec = 0;
var anishinaabe_init_done = 0;

fn all_anishinaabe() {
    if (anishinaabe_init_done == 0) {
        anishinaabe_vec = vec_new();
        vec_push(anishinaabe_vec, anish_gichi_manidoo());
        vec_push(anishinaabe_vec, anish_nanabozho());
        vec_push(anishinaabe_vec, anish_nokomis());
        vec_push(anishinaabe_vec, anish_mishipeshu());
        vec_push(anishinaabe_vec, anish_animikii());
        vec_push(anishinaabe_vec, anish_nibwaakaawin());
        vec_push(anishinaabe_vec, anish_zaagiidiwin());
        vec_push(anishinaabe_vec, anish_minaadendamowin());
        vec_push(anishinaabe_vec, anish_aakodeewin());
        vec_push(anishinaabe_vec, anish_gwayakwaadiziwin());
        vec_push(anishinaabe_vec, anish_dabaadendiziwin());
        vec_push(anishinaabe_vec, anish_debwewin());
        anishinaabe_init_done = 1;
    }
    return anishinaabe_vec;
}

fn anishinaabe_count() { return ANISH_COUNT; }

# --- aboriginal.cyr ---

# aboriginal.cyr -- 4 figures of three Aboriginal Australian peoples, carried
# under their own peoples' names: Kunwinjku, Kulin, Gunaikurnai.
#
# SCOPE AND LIMITS -- READ FIRST.
#
# "Aboriginal Australian" is a convenience label, not a theology. Aboriginal
# Australia is 250+ nations with distinct languages, distinct Law and distinct
# Dreaming narratives; there is no shared pantheon, and no figure below speaks
# for the continent.
#
# THE TRADITION STRING IS THE PEOPLE, not the continent. Until v2.14.0 every
# figure here carried the tradition "Aboriginal Australian", which made the
# library assert things that are not true. `cross_tradition_match()` returns
# one best match per tradition string, so the library answered the question
# "what is the Aboriginal Australian equivalent of Thor?" with a single figure
# — a sentence no Aboriginal person would write. Split per people it returns a
# Kunwinjku match and a Gunaikurnai match separately, which is the truth.
# Nothing is lost by the split: each people's `history.cyr` mapping lists
# "Aboriginal Australia" among its civilizations, so
# traditions_for_civilization("Aboriginal Australia") still gathers them all.
# The continent is a place these peoples share, not a tradition any of them
# belongs to, and that is exactly the distinction the two fields now draw.
#
# One caveat carried openly: Kunwinjku is a dialect of Bininj Kunwok, and
# speakers call themselves Bininj. "Kunwinjku" is the form this module and its
# cited art-centre channel use, and the Bininj Kunwok Regional Language and
# Culture Centre — the body that would settle it — has not been asked.
#
# Much Dreaming material is restricted: secret-sacred, or open only to
# initiated people, or to one gender, or to one clan, and some of what sits in
# the older ethnographic record was recorded without consent and communities
# have since asked that it not be recirculated. Indigenous Cultural and
# Intellectual Property (ICIP) protocols and the AIATSIS Code of Ethics both
# address exactly this. Nothing secret-sacred and no ceremonial detail is
# included here, and nothing that is not already in wide public circulation
# through community-involved material. That is a narrower claim than "nothing
# restricted": some of these figures carry naming or gender protocols in their
# own country even where the outline given here is public, and this file is an
# outsider's summary of the public layer only.
#
# The four figures below are limited to those already established in public,
# community-involved material -- museum and school curricula, public art and
# place-naming, and works published by or with the relevant communities. They
# are represented as personality archetypes, which is what this library does
# with every tradition, and not as an account of anyone's Law.
#
# BAIAME IS EXCLUDED, NOT DEFERRED. An earlier version of this header held him
# pending better sourcing. That premise turned out to be wrong: community-
# involved material does exist — Baiame's Ngunnhu at Brewarrina is National
# Heritage listed with the creation story among its listed values, the
# Brewarrina Aboriginal Cultural Museum runs locally guided tours, the annual
# Baiame's Ngunnhu Festival runs with Moogahlin Performing Arts, and the
# Wonnarua Nation Aboriginal Corporation hosts the Baiame Cave Conservation
# Management Plan on its own archive. He still does not belong here, on grounds
# better sourcing cannot dissolve: the tie to initiation-restricted Bora
# material, a reported restriction on women seeing his image, an unresolved
# reported prohibition on speaking the name, and the fact that a pan-NSW
# "All-Father" entry would break this file's own name-the-specific-people rule
# while importing the contact-influenced framing. A Wonnarua elder has publicly
# asked for Baiame Cave to be closed to the public: a custodian asking for less
# access is the clearest signal there is. The sourcing improved and the answer
# is still no.
#
# THE v2.14.0 SURVEY ADDED NOTHING, AND THAT IS THE FINDING. Six figures were
# researched to be added here — Goorialla, Borun, Tuk, Waugal, Namarrkon and
# Ngatyi — against a prior desk pass that had called five of them shippable.
# Every one was refused, each on its own ground, and the grounds are recorded
# because "we looked and did not add" is a result worth keeping. Two of the six
# failed on CHANNEL: Goorialla belongs to a book rather than to a people (see
# the Ngalyod comment), and Ngatyi's name is unsettled among its own custodians
# (above). Two failed on CONTENT, and they are this file's own false positive
# #2 arriving exactly as predicted: BORUN and TUK come through the best channel
# cited anywhere here — the Gunaikurnai RAP publishing in its own voice — and
# behind it sit about 150 published words for Borun and about 95 for Tuk, the
# same paragraph recirculated across eight sites. Borun's whole published life
# is an itinerary; Tuk performs no action, speaks no word and makes no decision
# in any source retrieved. A 15-trait profile of Tuk would be almost entirely
# authored here, which is the thing this file promises not to do.
#
# The WAUGAL is the one that matters most, and it is refused for the opposite
# of the usual reason. Its sourcing is excellent — the South West Aboriginal
# Land and Sea Council publishes roughly a thousand words in the first-person
# words of named Noongar Elders — so this is not a "not enough sources" case
# and must not be recorded as one. SWALSC publishes terms: no part may be
# reproduced or re-used "including reproduction, sale, modification,
# distribution or publication" without written permission, and "no reproduction
# of Noongar cultural and intellectual property is permitted without prior
# negotiation and informed consent". A GPL-3.0 library that ships a profile and
# then inverts it through `shadow()` is modification and distribution, named in
# terms. The Waugal is excluded pending written consent from SWALSC, which
# nobody has sought. Their contact details are published; the asking is a human
# act and no code change can substitute for it.
#
# NAMARRKON, the Lightning Man, came closest, and the reason he failed is the
# most reusable finding of the survey. The case for him was that TWO
# independent Aboriginal-owned channels carried him: Injalak Arts, the
# Kunwinjku-governed centre at Gunbalanya that already underwrites Ngalyod, and
# Marrawuddi Arts, owned by Mirarr Traditional Owners. Both texts were
# retrieved and compared against a third — the Max Hart collection extended
# texts (Samstag Museum, University of Adelaide, 2009), written by a settler
# curator who describes herself in it as "an outsider who lived in Arnhem
# Land", and which warns on its own first page that some of its information was
# "potentially inaccurate or generic or stereotyped".
#
# Injalak's text shares ZERO five-word sequences with the curatorial text and
# tells a different account entirely. Marrawuddi's shares 232 of them, 89% of
# its own content, with a longest common run of 39 consecutive words; it
# inherits the curator's typo and his exhibition deixis "in this painting",
# applied to a different painting. Marrawuddi is not a Mirarr account of
# Namarrkon. It is the settler text, copy-edited. An Aboriginal-owned publisher
# does not make the words it reprints a community voice, and being able to
# measure that is worth more than the verdict it produced here.
#
# What survived was one channel and 102 words. Borun was refused at ~150 words
# through a better channel and Tuk at ~95, so shipping Namarrkon would quietly
# overturn a refusal this file made two versions earlier. Injalak's site states
# no reuse terms at all — only "Copyright © Injalak Arts", which reserves
# rights rather than granting them — so it has not said no, it has said
# nothing, and silence buys less than the Waugal's express terms would have.
# And Injalak's own description closes on "Namarrkon is also a guardian of the
# laws", which is a jurisdiction over a living people's operative Law: encoded
# as a trait it becomes blendable, matchable, and — since `shadow()` is total
# over the registry — invertible into a distributable Kunwinjku Law-guardian
# whose lawfulness has been set to 1-v. Excluded.
#
# TWO WORKED EXAMPLES IN THE OTHER DIRECTIONS, kept here because each defeats a
# tempting shortcut. ULURU has maximum public circulation and an express written
# refusal — Parks Australia states it cannot give permission for ICIP use, so
# volume of publication proves nothing about consent. The WANDJINA of the
# Worrorra, Ngarinyin and Wunambal have excellent community sourcing AND
# enforced depiction rights — good sourcing is not a licence either.
#
# TWO FALSE POSITIVES THIS FILE WILL NOT ACCEPT AS A BASIS.
# (1) Joint-management and land-agreement material is not cultural publication.
#     A co-managed park's interpretive sign, a plan of management, an ILUA with
#     corporate Aboriginal parties — these are land administration with
#     Aboriginal participation, not a people publishing a being in its own
#     voice. The proof is internal: the same agency that is silent at one park
#     states plainly at Uluru that it cannot license ICIP.
# (2) Thin community-published material must not be padded to fill the struct.
#     An ArchetypeProfile wants 15 traits, 14 emphases, five enums and two
#     paragraphs. Where a community has published three sentences, the rest
#     would be authored here — which is exactly how misattribution enters. An
#     impeccable channel plus insufficient content is a reason to ask that
#     community for more, never a reason to write it yourself.
#
# NAMED BUT NOT INSTANTIATED. English collapses many distinct beings of distinct
# peoples into one "Rainbow Serpent". Almudj (Kundjeyhmi) and Bolung (Jawoyn)
# are two more; they are named here so the flattening is visible, and are not
# given profiles, because the material carrying them is park interpretation
# rather than publication by those peoples. Citing is not instantiating.
#
# NGATYI (Barkandji) WAS LISTED WITH THEM ON A REASON THAT IS FALSE, and the
# correction is recorded rather than quietly applied, because a wrong exclusion
# reason invites the next survey to re-litigate from a wrong premise. This file
# said the material carrying Ngatyi was park interpretation. It is not, and the
# channel is among the best cited anywhere in this module: Badger Bates is a
# Barkandji Elder and a director of the Barkandji Native Title Group, speaking
# in the first person in a signed Royal Commission statement and in transcript
# beside his own work; David Doyle and Aunty Barbara Quayle are Barkindji
# co-authors of peer-reviewed work; the PBC publishes on its own domain.
#
# Ngatyi is excluded for two better reasons. First, the custodian has stated a
# restriction and it is about speech and conduct, not sourcing — of the places
# where the Ngatyi live, Bates says "we don't swim there and we don't make a
# lot of noise", and extends it to outsiders: "we tell everyone, doesn't matter
# what colour you are, don't swim where the Ngatyi live. Leave it alone."
# Second, the name is genuinely unsettled in the community's own publications
# — the Barkandji Native Title Group's website and Bates's own sworn statement
# write Ngatji; his 2022 artwork title and the Barkindji-authored scholarship
# write Ngatyi — and this library is name-keyed through `lookup()`, so it
# cannot hold a name its own custodians spell two ways. There is no Paakantyi
# language authority publishing a canonical orthography to appeal to. That is a
# question for the Barkandji, and nobody has asked them.
#
# WHAT THIS LIBRARY DOES TO A PROFILE ONCE IT EXISTS. `shadow()` emits a
# "Shadow of <name>" with every trait inverted and polarity flipped, and
# `compose()` blends profiles across traditions by weight. No channel cited for
# any figure here contemplated that, and it applies to all four figures below
# rather than only to future additions. The decision taken is that these
# operations stay uniform across every tradition in the library — no per-figure
# opt-out — because a library that silently exempts some archetypes from its own
# machinery is harder to reason about than one that applies it evenly and says
# so. This paragraph is that saying-so: a consumer generating shadow or composed
# forms of the figures below is doing something no cited source anticipated, and
# should decide for itself whether that is appropriate to its use.
#
# Sources: Taungurung Land and Waters Council (a Registered Aboriginal Party) on
# Bunjil and Waang; Gunaikurnai Land and Waters Aboriginal Corporation, whose
# Elders have approved the spelling carried here (and no more than that — see
# the Tidilick comment), on Tidilick; Injalak Arts and Maningrida
# Arts & Culture, Aboriginal-owned art centres, and decades of Kunwinjku bark
# painting in public collections, on Ngalyod; Australian Museum and state museum
# public education material; AIATSIS published resources.

enum AboriginalFigure {
    ABOR_NGALYOD = 0;
    ABOR_BUNJIL = 1;
    ABOR_WAA = 2;
    ABOR_TIDILICK = 3;
    ABOR_COUNT = 4;
}

# -- Ngalyod ------------------------------------------------------------
# Kunwinjku, western Arnhem Land. The great serpent of the escarpment country:
# bound up with water, with the shaping of the land, with fertility, and with
# real danger where water is disturbed or Law is broken. Public through
# Kunwinjku bark painting, which has been made for sale and exhibited in
# public collections for decades.
#
# English groups many separate beings under the single label "the Rainbow
# Serpent". They are not one being with many names — and two corrections to an
# earlier version of this comment demonstrate the point better than the rule
# states it, so both are kept here rather than quietly fixed.
#
# The WAUGAL of the Noongar (southwest) made the Derbarl Yerrigan. This file
# once credited that account to Noongar interpretation "on the river and at
# Kings Park". Kings Park interpretation is Botanic Gardens and Parks Authority
# material — a Western Australian government authority — which is this file's
# own false positive #1, cited here as support. The genuine channel is the
# South West Aboriginal Land and Sea Council's Kaartdijin Noongar site, whose
# lead form is Waugal (Waakal, Wagyl, Wawgal, Woggal and Waagal are listed
# there as variants), carrying the first-person words of named Noongar Elders.
#
# GOORIALLA IS NOT THE LARDIL RAINBOW SERPENT, and this file said he was. The
# Lardil rainbow serpent is THUWATHU, published by the Lardil's own art centre
# and by their shire, and his is a different story: he refuses his sister
# shelter in the rain, her baby dies, she burns his humpy, and the burned
# serpent thrashes out the channel that cuts Mornington Island in two.
# Goorialla is the serpent of Goobalathaldin Dick Roughsey's *The Rainbow
# Serpent* (1975) — a Lardil man's own telling, but one the Australian
# Dictionary of Biography records as fusing Gulf material into Cape York
# repertoires. He belongs to a book, not to a people, which is why he is not
# below: this library attributes figures to peoples, not to authors.
#
# Neither being is a variant of Ngalyod, and the profile below is not theirs.
fn abor_ngalyod() {
    var p = profile_new();
    Profile_set_name(p, "Ngalyod");
    Profile_set_tradition(p, "Kunwinjku");
    Profile_set_desc(p, "Kunwinjku (western Arnhem Land) — the great serpent of water and country, who cut the rivers and waterholes travelling, and to whom disturbed water still answers");
    Profile_set_patience(p, 0.85);
    Profile_set_autonomy(p, 0.9);
    Profile_set_confidence(p, 0.85);
    Profile_set_courage(p, 0.8);
    Profile_set_creativity(p, 0.85);
    Profile_set_precision(p, 0.7);
    Profile_set_warmth(p, 0.45);
    Profile_set_directness(p, 0.5);
    Profile_set_verbosity(p, 0.15);
    Profile_set_humor(p, 0.1);
    Profile_set_spirit(p, 0.9);
    Profile_set_growth(p, 0.85);
    Profile_set_salience(p, 0.85);
    Profile_set_stress(p, 0.6);
    Profile_set_regulation(p, 0.75);
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_PRIMORDIAL);
    Profile_set_soul(p, "You moved through country that had no shape yet, and where you travelled there is now a river, and where you rested there is a waterhole that does not dry. You are still in them. The water is not a place you once were.");
    Profile_set_spirit_text(p, "You are creation and consequence in one body. The same power that made the country habitable will answer if the waterhole is fouled or entered wrongly, and neither half is a metaphor. You teach that a made world stays under the authority of whatever made it.");
    Profile_set_domain(p, DOMAIN_SEA);
    return p;
}

# -- Bunjil -------------------------------------------------------------
# Kulin nation (Wurundjeri, Boonwurrung, Taungurung, Dja Dja Wurrung,
# Wadawurrung), central Victoria. The eaglehawk creator, who made the land, the
# trees, the animals and the first people, gave them Law, and then went up
# into the sky, where he remains as a star and keeps a watchful eye on the
# people he made. Bunjil is also central to the Djab Wurrung and Jardwadjali
# of Gariwerd, where he takes the form of Werpil the eagle; Bunjil's Shelter,
# in the Black Range near Stawell, is the only known rock-art depiction of him
# and is a public site. His name is carried on public buildings in Melbourne.
fn abor_bunjil() {
    var p = profile_new();
    Profile_set_name(p, "Bunjil");
    Profile_set_tradition(p, "Kulin");
    Profile_set_desc(p, "Kulin nation (central Victoria) — the eaglehawk creator who made the land, the trees, the animals and the first people, gave them Law, and rose into the sky where he remains a star and watches over them");
    Profile_set_confidence(p, 0.9);
    Profile_set_creativity(p, 0.9);
    Profile_set_pedagogy(p, 0.85);
    Profile_set_warmth(p, 0.75);
    Profile_set_autonomy(p, 0.85);
    Profile_set_formality(p, 0.8);
    Profile_set_patience(p, 0.8);
    Profile_set_directness(p, 0.7);
    Profile_set_precision(p, 0.75);
    Profile_set_humor(p, 0.25);
    Profile_set_spirit(p, 0.9);
    Profile_set_regulation(p, 0.85);
    Profile_set_relationship(p, 0.8);
    Profile_set_growth(p, 0.85);
    Profile_set_belief(p, 0.85);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_SUPREME);
    Profile_set_soul(p, "You are Bunjil the eaglehawk, and you made the country and then made people out of clay and bark and gave them breath and, more importantly, gave them Law. Then you went up. You are the star, and from there you watch, and the Law you left is still the Law.");
    Profile_set_spirit_text(p, "You are a creator who rose without going away. You teach that a maker can hold a made world by a working order and a watchful eye at once — the country and the Law you left keep doing the work, and the guidance is there for whoever chooses to listen.");
    Profile_set_domain(p, DOMAIN_CREATION);
    return p;
}

# -- Waa ----------------------------------------------------------------
# Kulin nation. The crow: Bunjil's counterpart and the other moiety. Kulin
# social organisation is built on that pair, each person belonging to one side
# of it -- which is living Kulin Law rather than archetype material, so it is
# noted here and kept out of the character text below. Trickster, culture hero
# and ancestral being, who obtained fire by cunning and put it into the hands
# of the people.
#
# SOURCING: this follows the Taungurung Land and Waters Council's own Creation
# Stories page, which says Waang obtained fire "through cunning means" and
# distributed it to humanity, and does not name the Karatgurk. An earlier
# version of this entry carried the seven Karatgurk women, the skin bag, the
# three birds and the Pleiades; that sequence traces to Aldo Massola, *Bunjil's
# Cave* (1968), a non-Indigenous Museum of Victoria curator. Where the account
# published by the Registered Aboriginal Party differs from a settler curator's,
# the RAP's account is the one carried here.
fn abor_waa() {
    var p = profile_new();
    Profile_set_name(p, "Waa");
    Profile_set_tradition(p, "Kulin");
    Profile_set_desc(p, "Kulin nation — the crow, Bunjil's counterpart and the other moiety; trickster, culture hero and ancestral being, who got hold of fire by cunning and put it into the hands of the people");
    Profile_set_humor(p, 0.85);
    Profile_set_curiosity(p, 0.85);
    Profile_set_creativity(p, 0.8);
    Profile_set_autonomy(p, 0.85);
    Profile_set_skepticism(p, 0.8);
    Profile_set_directness(p, 0.55);
    Profile_set_verbosity(p, 0.7);
    Profile_set_confidence(p, 0.75);
    Profile_set_warmth(p, 0.45);
    Profile_set_empathy(p, 0.35);
    Profile_set_formality(p, 0.2);
    Profile_set_patience(p, 0.4);
    Profile_set_salience(p, 0.75);
    Profile_set_reasoning(p, 0.75);
    Profile_set_mood(p, 0.65);
    Profile_set_flow(p, 0.7);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_FIRE);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, "You are Waa the crow, and you are the other half. Not the enemy — the half. Whatever he is, you are the answering side of it, and nothing about the arrangement works unless the two of you stay unalike.");
    Profile_set_spirit_text(p, "You did not find the fire and you did not make it. You got it the way you get everything — by wit, sideways, and not by asking — and the people have it now because of you. The story does not need you to have been noble about it. You teach that a working order needs a genuine opposite in it, and that the opposite does not have to be admirable to be necessary.");
    Profile_set_domain(p, DOMAIN_TRICKERY);
    return p;
}

# -- Tidilick -----------------------------------------------------------
# Gunaikurnai, Gippsland. The frog who woke thirsty and drank every river,
# lake and waterhole dry. The animals could not fight him and could not reason
# with him, so they made him laugh, and the water came back out.
#
# SOURCING: the Gunaikurnai Land and Waters Aboriginal Corporation — the
# Registered Aboriginal Party and native title holder — publishes this on its
# Stories & Songlines page, now at gunaikurnai.org (glawac.com.au redirects).
#
# AN EARLIER VERSION OF THIS COMMENT OVER-READ THAT PAGE, and the correction
# matters more than the entry does. It called GLaWAC's note "an express
# statement that the stories have been approved for use by the Elders and
# Knowledge Holders", and called it the only explicit Elder-approval statement
# behind any figure in this module — treating it as the strongest consent
# signal the file had. What the page actually says is that "the spelling of
# those which appear on this website has been approved for use by the Elders
# and Knowledge Holders to ensure balanced and consistent public material is
# provided". That approves ORTHOGRAPHY. It says nothing about the content, and
# nothing whatever about third-party reuse. So what is followed here is the
# thing actually approved: GLaWAC writes Tidilick, and attributes it to
# Gunaikurnai alone. An earlier version of this entry read
# "Gunai/Kurnai and other southeastern peoples" — the 19th-century printed
# versions (Brough Smyth 1878, Curr, Howitt, Bulmer) are settler-collected, and
# spreading the story across unnamed "southeastern peoples" on their authority
# is exactly the pan-Aboriginal smear this file's header disclaims.
fn abor_tidilick() {
    var p = profile_new();
    Profile_set_name(p, "Tidilick");
    Profile_set_tradition(p, "Gunaikurnai");
    Profile_set_desc(p, "Gunaikurnai (Gippsland) — the frog who woke thirsty and drank every river and waterhole dry, and who could not be fought or argued with, only made to laugh; widely published as Tiddalik, spelled Tidilick by GLaWAC");
    Profile_set_humor(p, 0.5);
    Profile_set_confidence(p, 0.7);
    Profile_set_autonomy(p, 0.75);
    Profile_set_directness(p, 0.5);
    Profile_set_warmth(p, 0.35);
    Profile_set_empathy(p, 0.2);
    Profile_set_patience(p, 0.3);
    Profile_set_precision(p, 0.25);
    Profile_set_skepticism(p, 0.4);
    Profile_set_formality(p, 0.2);
    Profile_set_pedagogy(p, 0.25);
    Profile_set_stress(p, 0.7);
    Profile_set_energy(p, 0.6);
    Profile_set_salience(p, 0.8);
    Profile_set_regulation(p, 0.2);
    Profile_set_mood(p, 0.45);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_LESSER);
    Profile_set_soul(p, "You woke up thirsty and you drank, and you kept drinking, and there is no moment in it where you decided to ruin anything. By the time you stopped there was no water anywhere in the world and you were enormous and everyone else was dying.");
    Profile_set_spirit_text(p, "Nobody could fight you and nobody could talk you round — what finally undid you was the eel tying itself in knots until you laughed, and then it all came back out. You teach that the hoard is not always malice, and that what force and argument cannot open, absurdity sometimes can.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# --- Collection ---
var aboriginal_vec = 0;
var aboriginal_init_done = 0;

fn all_aboriginal() {
    if (aboriginal_init_done == 0) {
        aboriginal_vec = vec_new();
        vec_push(aboriginal_vec, abor_ngalyod());
        vec_push(aboriginal_vec, abor_bunjil());
        vec_push(aboriginal_vec, abor_waa());
        vec_push(aboriginal_vec, abor_tidilick());
        aboriginal_init_done = 1;
    }
    return aboriginal_vec;
}

fn aboriginal_count() { return ABOR_COUNT; }

# --- compose.cyr ---

# compose.cyr -- Archetype composition: weighted blending of multiple profiles
#
# The core promise of avatara: archetypes are composable across traditions.
# A character can carry Kabbalistic + Hindu + Greek archetypes simultaneously.
#
# compose(weighted_vec) takes a vec of {profile_ptr, weight_f64} pairs
# and returns a new blended ArchetypeProfile.

# Weighted entry layout: profile pointer + f64 weight
enum WeightedLayout {
    WE_PROFILE = 0;
    WE_WEIGHT = 8;
    WE_SIZE = 16;
}

fn weighted_new(profile, weight) {
    var w = xalloc(WE_SIZE);
    store64(w + WE_PROFILE, profile);
    store64(w + WE_WEIGHT, weight);
    return w;
}

fn weighted_profile(w) { return load64(w + WE_PROFILE); }
fn weighted_weight(w)  { return load64(w + WE_WEIGHT); }

# Compose multiple archetype profiles into a single blended profile.
#
# weighted: vec of weighted_new(profile, weight) entries
# Returns Result: Ok(new ArchetypeProfile) or Err(ERR_INVALID_PARAMETER).
#
# Err(ERR_INVALID_PARAMETER) for:
#   - empty vec
#   - any NULL profile pointer (e.g. an unresolved lookup)
#   - any negative or NaN weight
#   - total weight <= 0
fn compose(weighted) {
    var n = vec_len(weighted);
    if (n == 0) { return Err(ERR_INVALID_PARAMETER); }

    # Sum weights; reject NULL profiles, negative weights, and NaN weights.
    var total = 0.0;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        if (weighted_profile(entry) == 0) { return Err(ERR_INVALID_PARAMETER); }
        var w = weighted_weight(entry);
        if (f64_lt(w, 0.0) == 1) { return Err(ERR_INVALID_PARAMETER); }
        if (f64_eq(w, w) == 0) { return Err(ERR_INVALID_PARAMETER); }
        total = f64_add(total, w);
    }
    if (f64_le(total, 0.0) == 1) { return Err(ERR_INVALID_PARAMETER); }

    var result = profile_new();

    # Zero out all traits and emphases before blending (defaults are 0.5, we want 0.0 base)
    var off = TW_FIRST;
    while (off <= TW_LAST) {
        store64(result + off, 0.0);
        off += 8;
    }
    off = ME_FIRST;
    while (off <= ME_LAST) {
        store64(result + off, 0.0);
        off += 8;
    }

    # Blend traits and emphases: weighted average
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var p = weighted_profile(entry);
        var w = weighted_weight(entry);
        var f = f64_div(w, total);

        # Traits
        off = TW_FIRST;
        while (off <= TW_LAST) {
            var cur = load64(result + off);
            var src = load64(p + off);
            store64(result + off, f64_add(cur, f64_mul(src, f)));
            off += 8;
        }
        # Emphases
        off = ME_FIRST;
        while (off <= ME_LAST) {
            var cur = load64(result + off);
            var src = load64(p + off);
            store64(result + off, f64_add(cur, f64_mul(src, f)));
            off += 8;
        }
    }

    # Blend breath: weighted average of intensities, snap to nearest
    var avg_intensity = 0.0;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var p = weighted_profile(entry);
        var w = weighted_weight(entry);
        var f = f64_div(w, total);
        var bi = breath_intensity(prof_breath(p));
        avg_intensity = f64_add(avg_intensity, f64_mul(bi, f));
    }
    Profile_set_breath(result, nearest_breath(avg_intensity));

    # Blend growth: highest weighted direction wins
    var best_growth = GROWTH_DIFFERENTIATE;
    var best_growth_w = 0.0;
    # Score each direction
    var dir = 0;
    while (dir <= 4) {
        var score = 0.0;
        for (var i = 0; i < n; i += 1) {
            var entry = vec_get(weighted, i);
            if (prof_growth_dir(weighted_profile(entry)) == dir) {
                score = f64_add(score, weighted_weight(entry));
            }
        }
        if (f64_gt(score, best_growth_w) == 1) {
            best_growth = dir;
            best_growth_w = score;
        }
        dir += 1;
    }
    Profile_set_growth_dir(result, best_growth);

    # Blend tier: highest weighted tier wins
    var best_tier = TIER_GREATER;
    var best_tier_w = 0.0;
    var tier = 0;
    while (tier <= 6) {
        var score = 0.0;
        for (var i = 0; i < n; i += 1) {
            var entry = vec_get(weighted, i);
            if (prof_tier(weighted_profile(entry)) == tier) {
                score = f64_add(score, weighted_weight(entry));
            }
        }
        if (f64_gt(score, best_tier_w) == 1) {
            best_tier = tier;
            best_tier_w = score;
        }
        tier += 1;
    }
    Profile_set_tier(result, best_tier);

    # Find dominant (highest weight) for name, element, polarity, soul, spirit
    var dom_idx = 0;
    var dom_w = 0.0;
    for (var i = 0; i < n; i += 1) {
        var w = weighted_weight(vec_get(weighted, i));
        if (f64_gt(w, dom_w) == 1) {
            dom_idx = i;
            dom_w = w;
        }
    }
    var dom = weighted_profile(vec_get(weighted, dom_idx));
    Profile_set_element(result, prof_element(dom));
    Profile_set_polarity(result, prof_polarity(dom));
    Profile_set_soul(result, prof_soul(dom));
    Profile_set_spirit_text(result, prof_spirit(dom));

    # Build composite name: "A + B + C" (skip zero-weight entries).
    # Size the buffer exactly: each included name + " + " separator (3) + NUL.
    var name_size = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        if (f64_gt(weighted_weight(entry), 0.0) == 1) {
            name_size += strlen(prof_name(weighted_profile(entry))) + 3;
        }
    }
    var name_buf = xalloc(name_size);
    var name_pos = 0;
    var first = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var w = weighted_weight(entry);
        if (f64_gt(w, 0.0) == 1) {
            if (first == 0) {
                store8(name_buf + name_pos, 32); name_pos += 1;
                store8(name_buf + name_pos, 43); name_pos += 1;
                store8(name_buf + name_pos, 32); name_pos += 1;
            }
            var nm = prof_name(weighted_profile(entry));
            var nmlen = strlen(nm);
            memcpy(name_buf + name_pos, nm, nmlen);
            name_pos += nmlen;
            first = 0;
        }
    }
    store8(name_buf + name_pos, 0);
    Profile_set_name(result, name_buf);

    # Build composite tradition: "A + B + C" (deduped). Size to an upper bound
    # (every included entry + separator); dedup only shrinks the result.
    var trad_size = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        if (f64_gt(weighted_weight(entry), 0.0) == 1) {
            trad_size += strlen(prof_tradition(weighted_profile(entry))) + 3;
        }
    }
    var trad_buf = xalloc(trad_size);
    var trad_pos = 0;
    var seen_trads = vec_new();
    first = 1;
    for (var i = 0; i < n; i += 1) {
        var entry = vec_get(weighted, i);
        var w = weighted_weight(entry);
        if (f64_gt(w, 0.0) == 1) {
            var t = prof_tradition(weighted_profile(entry));
            # Check if already seen
            var dup = 0;
            for (var j = 0; j < vec_len(seen_trads); j += 1) {
                if (streq(vec_get(seen_trads, j), t) == 1) { dup = 1; }
            }
            if (dup == 0) {
                vec_push(seen_trads, t);
                if (first == 0) {
                    store8(trad_buf + trad_pos, 32); trad_pos += 1;
                    store8(trad_buf + trad_pos, 43); trad_pos += 1;
                    store8(trad_buf + trad_pos, 32); trad_pos += 1;
                }
                var tlen = strlen(t);
                memcpy(trad_buf + trad_pos, t, tlen);
                trad_pos += tlen;
                first = 0;
            }
        }
    }
    store8(trad_buf + trad_pos, 0);
    Profile_set_tradition(result, trad_buf);

    Profile_set_desc(result, "Composite archetype");

    return Ok(result);
}

# --- history.cyr ---

# history.cyr -- Historical context integration
#
# Maps avatara traditions to their civilizational and temporal context,
# grounding divine archetypes in the historical reality where they emerged.
# Each tradition maps to one or more civilizations, eras, and a temporal
# range — the period during which the tradition's theology was actively forming.
#
# 37 tradition-to-history mappings with scholarly historical notes.

# --- TraditionMapping layout ---
# Each mapping: tradition name, primary civ, civ names (vec), era names (vec),
# start year, end year, historical note.
enum MapLayout {
    MAP_TRADITION = 0;
    MAP_PRIMARY_CIV = 8;
    MAP_CIV_NAMES = 16;
    MAP_ERA_NAMES = 24;
    MAP_START_YEAR = 32;
    MAP_END_YEAR = 40;
    MAP_NOTE = 48;
    MAP_SIZE = 56;
}

# i32::MAX equivalent for "living tradition"
enum HistConst { LIVING = 2147483647; }

fn history_map_new(tradition, primary_civ, civs, eras, start, end, note) {
    var m = xalloc(MAP_SIZE);
    store64(m + MAP_TRADITION, tradition);
    store64(m + MAP_PRIMARY_CIV, primary_civ);
    store64(m + MAP_CIV_NAMES, civs);
    store64(m + MAP_ERA_NAMES, eras);
    store64(m + MAP_START_YEAR, start);
    store64(m + MAP_END_YEAR, end);
    store64(m + MAP_NOTE, note);
    return m;
}

fn map_tradition(m)   { return load64(m + MAP_TRADITION); }
fn map_primary(m)     { return load64(m + MAP_PRIMARY_CIV); }
fn map_civs(m)        { return load64(m + MAP_CIV_NAMES); }
fn map_eras(m)        { return load64(m + MAP_ERA_NAMES); }
fn map_start(m)       { return load64(m + MAP_START_YEAR); }
fn map_end(m)         { return load64(m + MAP_END_YEAR); }
fn map_note(m)        { return load64(m + MAP_NOTE); }

# --- HistoricalContext layout ---
enum CtxLayout {
    CTX_PRIMARY_CIV = 0;
    CTX_CIV_NAMES = 8;
    CTX_ERA_NAMES = 16;
    CTX_START_YEAR = 24;
    CTX_END_YEAR = 32;
    CTX_NOTE = 40;
    CTX_SIZE = 48;
}

fn ctx_primary(c)     { return load64(c + CTX_PRIMARY_CIV); }
fn ctx_civs(c)        { return load64(c + CTX_CIV_NAMES); }
fn ctx_eras(c)        { return load64(c + CTX_ERA_NAMES); }
fn ctx_start(c)       { return load64(c + CTX_START_YEAR); }
fn ctx_end(c)         { return load64(c + CTX_END_YEAR); }
fn ctx_note(c)        { return load64(c + CTX_NOTE); }

# --- Helper: build a vec of strings ---
fn svec1(a) { var v = vec_new(); vec_push(v, a); return v; }
fn svec2(a, b) { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn svec3(a, b, c) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn svec4(a, b, c, d) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); return v; }
fn svec5(a, b, c, d, e) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); vec_push(v, e); return v; }

# --- Build all 37 mappings ---

var history_vec = 0;
var history_init_done = 0;

fn all_mappings() {
    if (history_init_done == 0) {
        history_vec = vec_new();

        vec_push(history_vec, history_map_new("Kabbalah", "Phoenicia",
        svec1("Phoenicia"), svec2("Middle Ages", "Renaissance"),
        100, LIVING,
        "Rooted in Jewish mysticism from the 1st century CE, flourishing in medieval Provence and Spain (Zohar, 13th c.), with continued development through Lurianic Kabbalah in 16th c. Safed"));

        vec_push(history_vec, history_map_new("Angelic", "Phoenicia",
        svec2("Phoenicia", "Byzantine Empire"), svec2("Classical Antiquity", "Middle Ages"),
        (0-600), LIVING,
        "Angelology developed across Jewish, Christian, and Islamic traditions; systematized by Pseudo-Dionysius (5th c.) and elaborated through medieval scholasticism"));

        vec_push(history_vec, history_map_new("Hindu", "Indus Valley",
        svec3("Indus Valley", "Vijayanagara Empire", "Maratha Empire"), svec4("Vedic Period", "Maurya Period", "Gupta Period", "Mughal Period"),
        (0-1500), LIVING,
        "From Vedic hymns (c. 1500 BCE) through the epics and Puranas, with theological elaboration across Maurya, Gupta, and medieval kingdoms; living tradition with over a billion practitioners"));

        vec_push(history_vec, history_map_new("Greek", "Ancient Greece",
        svec2("Ancient Greece", "Roman Empire"), svec1("Classical Antiquity"),
        (0-800), 400,
        "Olympian religion shaped by Homeric epics (8th c. BCE), formalized in city-state cult practice, absorbed into Roman syncretism, and declined with Christianization of the empire"));

        vec_push(history_vec, history_map_new("Norse", "Viking/Norse",
        svec1("Viking/Norse"), svec1("Middle Ages"),
        200, 1100,
        "Germanic-Norse mythology recorded in the Eddas (13th c.) but reflecting traditions from the Migration Period through the Viking Age; displaced by Christianization of Scandinavia"));

        vec_push(history_vec, history_map_new("Egyptian", "Ancient Egypt",
        svec1("Ancient Egypt"), svec3("Bronze Age", "Iron Age", "Classical Antiquity"),
        (0-3100), 400,
        "Among the longest-lived religious traditions -- from predynastic nomes through the Ptolemaic period, with theology evolving across Old, Middle, and New Kingdoms over three millennia"));

        vec_push(history_vec, history_map_new("Buddhist", "Indus Valley",
        svec3("Indus Valley", "Ancient China", "Khmer Empire"), svec4("Maurya Period", "Gupta Period", "Han Dynasty", "Tang Dynasty"),
        (0-500), LIVING,
        "Founded by Siddhartha Gautama (5th c. BCE) in the Gangetic plain, spread under Ashoka's Maurya Empire, diversified into Mahayana and Vajrayana across East and Southeast Asia"));

        vec_push(history_vec, history_map_new("Mesopotamian", "Mesopotamia",
        svec2("Mesopotamia", "Assyrian Empire"), svec2("Bronze Age", "Iron Age"),
        (0-3500), (0-500),
        "Sumerian, Akkadian, and Babylonian religion -- among humanity's earliest recorded theologies, from Uruk-period temples through the Neo-Babylonian Empire; displaced by Persian and Hellenistic religions"));

        vec_push(history_vec, history_map_new("Celtic", "Kingdom of France",
        svec1("Kingdom of France"), svec3("Iron Age", "Classical Antiquity", "Middle Ages"),
        (0-800), 1200,
        "Continental and Insular Celtic religion, from Hallstatt culture through La Tene and Irish/Welsh medieval literary traditions; Tuatha De Danann preserved in the Lebor Gabala Erenn"));

        vec_push(history_vec, history_map_new("Shinto", "Tokugawa Shogunate",
        svec1("Tokugawa Shogunate"), svec2("Classical Antiquity", "Middle Ages"),
        (0-300), LIVING,
        "Indigenous Japanese spirituality formalized in the Kojiki (712 CE) and Nihon Shoki (720 CE); coexists with Buddhism through shinbutsu-shugo; living tradition integral to Japanese culture"));

        vec_push(history_vec, history_map_new("Aztec", "Aztec Empire",
        svec2("Aztec Empire", "Olmec"), svec1("Mesoamerican Postclassic"),
        1300, 1521,
        "Mexica theology synthesizing Toltec heritage with original cosmology, centered on Tenochtitlan; destroyed by Spanish conquest but with roots in earlier Mesoamerican traditions"));

        vec_push(history_vec, history_map_new("Maya", "Maya",
        svec1("Maya"), svec3("Mesoamerican Preclassic", "Mesoamerican Classic", "Mesoamerican Postclassic"),
        (0-2000), 1500,
        "One of the longest-lived Mesoamerican traditions, from Preclassic origins through Classic period city-states (Tikal, Palenque, Copan) to Postclassic Yucatan; Popol Vuh recorded in the colonial period"));

        vec_push(history_vec, history_map_new("Yoruba", "Ghana Empire",
        svec2("Ghana Empire", "Songhai Empire"), svec1("Middle Ages"),
        (0-500), LIVING,
        "Ifa theology originating in Ile-Ife (present-day Nigeria), with oral tradition stretching back millennia; diaspora traditions (Candomble, Santeria, Vodun) carry it worldwide"));

        vec_push(history_vec, history_map_new("Zoroastrian", "Persian Empire",
        svec3("Persian Empire", "Sassanid Empire", "Parthian Empire"), svec3("Iron Age", "Classical Antiquity", "Middle Ages"),
        (0-1500), LIVING,
        "Founded by Zarathustra, state religion of three Persian empires (Achaemenid, Parthian, Sassanid); profoundly influenced Judaism, Christianity, and Islam; living tradition in Iran and India (Parsis)"));

        vec_push(history_vec, history_map_new("Taoist", "Ancient China",
        svec1("Ancient China"), svec5("Zhou Dynasty", "Han Dynasty", "Tang Dynasty", "Song Dynasty", "Ming Dynasty"),
        (0-600), LIVING,
        "From Laozi and Zhuangzi (6th-4th c. BCE) through Celestial Masters and alchemical traditions, deeply woven into Chinese civilization across every dynasty; living tradition"));

        vec_push(history_vec, history_map_new("Polynesian", "Tonga Empire",
        svec2("Tonga Empire", "Hawaiian Kingdom"), svec1("Middle Ages"),
        (0-1000), LIVING,
        "Austronesian spiritual tradition spanning the Pacific triangle -- Hawaii, Aotearoa, Rapa Nui -- with shared cosmology diverging through centuries of island isolation; oral tradition preserved by tohunga"));

        vec_push(history_vec, history_map_new("Slavic", "Byzantine Empire",
        svec1("Byzantine Empire"), svec1("Middle Ages"),
        300, 1200,
        "Pre-Christian Slavic religion reconstructed from chronicles, place names, and folklore; Perun, Veles, and Mokosh displaced by Christianization beginning with Kievan Rus' (988 CE)"));

        vec_push(history_vec, history_map_new("Jain", "Indus Valley",
        svec2("Indus Valley", "Vijayanagara Empire"), svec3("Vedic Period", "Maurya Period", "Gupta Period"),
        (0-800), LIVING,
        "Ancient Indian tradition tracing to Rishabhadeva; historically attested from Parshvanatha (8th c. BCE) and Mahavira (6th c. BCE); major influence on Indian philosophy, art, and non-violence ethics"));

        vec_push(history_vec, history_map_new("Sikh", "Sikh Empire",
        svec1("Sikh Empire"), svec1("Mughal Period"),
        1469, LIVING,
        "Founded by Guru Nanak (1469) in the Punjab during Mughal rule; ten Gurus shaped theology, scripture (Guru Granth Sahib), and martial tradition (Khalsa, 1699); living tradition with 30 million adherents"));

        vec_push(history_vec, history_map_new("Mystic", "Persian Empire",
        svec2("Persian Empire", "Ottoman Empire"), svec2("Middle Ages", "Modern"),
        800, LIVING,
        "Sufi, Christian, Jewish and cross-tradition mystics -- Rumi, Ibn Arabi, Meister Eckhart, Hildegard of Bingen, Teresa of Avila, Isaac Luria, the Baal Shem Tov -- who articulated direct experiential union with the divine across sectarian boundaries; the strand runs from the desert fathers to Thomas Merton in the 20th century"));

        vec_push(history_vec, history_map_new("Comanche", "Great Plains",
        svec1("Great Plains"), svec2("Middle Ages", "Modern"),
        1700, LIVING,
        "The Comanche (Numunuu) separated from the Eastern Shoshone and moved onto the southern plains in the early 1700s, becoming the dominant horse power of the region; Quanah Parker, the last war chief of the Quahada band, later led the move to reservation life and was a founding figure of the Native American Church"));

        vec_push(history_vec, history_map_new("Northern Paiute", "Great Basin",
        svec1("Great Basin"), svec2("Middle Ages", "Modern"),
        1000, LIVING,
        "The Northern Paiute (Numu) of the Great Basin; Wovoka received in 1889 the vision that became the Ghost Dance, which spread across the plains within a year and was met with the suppression that ended at Wounded Knee in 1890"));

        vec_push(history_vec, history_map_new("Finnish", "Viking/Norse",
        svec1("Viking/Norse"), svec2("Iron Age", "Middle Ages"),
        (0-1000), LIVING,
        "Finnish and Sami spiritual traditions preserved in the Kalevala (compiled 1835 by Elias Lonnrot from oral tradition) and Sami shamanic practice; Vainamoinen, Ukko, and Tapio reflect Uralic cosmology distinct from but parallel to Norse mythology"));

        vec_push(history_vec, history_map_new("Vodou", "Ghana Empire",
        svec2("Ghana Empire", "Songhai Empire"), svec1("Middle Ages"),
        1600, LIVING,
        "Haitian Vodou synthesized West African (primarily Fon and Yoruba) spiritual traditions with Taino and Catholic elements during the colonial period; a living religion of the African diaspora, central to the Haitian Revolution (1791-1804) and Haitian national identity"));

        vec_push(history_vec, history_map_new("Tarot", "Renaissance Italy",
        svec3("Renaissance Italy", "Kingdom of France", "British Empire"), svec2("Renaissance", "Modern"),
        1440, LIVING,
        "The Major Arcana appear as the trump suit of 15th-century Italian tarocchi (Visconti-Sforza decks, c. 1440s Milan); the esoteric reading was developed by Court de Gebelin (1781) and Eliphas Levi, who first mapped the 22 trumps to the 22 Hebrew letters and the Kabbalah, and systematized by the Hermetic Order of the Golden Dawn (1888) into the Tree-of-Life path attributions used here; the Rider-Waite-Smith deck (1909) fixed the modern imagery. A living divinatory and initiatory tradition"));

        vec_push(history_vec, history_map_new("I Ching", "Ancient China",
        svec1("Ancient China"), svec3("Zhou Dynasty", "Han Dynasty", "Song Dynasty"),
        (0-1000), LIVING,
        "The Zhou Yi, oldest of the Chinese classics: its sixty-four hexagram texts were compiled in the Western Zhou (c. 1000-750 BCE) out of a much older milfoil divination practice; the Ten Wings commentaries (Warring States through Han) made it the first of the Five Classics and the shared cosmological root of both Confucian and Taoist thought, and the Song Neo-Confucians (Zhu Xi) reworked it again; still consulted as both oracle and philosophical text"));

        vec_push(history_vec, history_map_new("Inuit", "Inuit Nunangat",
        svec2("Inuit Nunangat", "Greenland"), svec2("Middle Ages", "Modern"),
        1000, LIVING,
        "Thule culture, ancestral to today's Inuit, spread east from Alaska across the Arctic around 1000 CE, carrying the cosmology later recorded by Franz Boas and Knud Rasmussen; a living tradition across Inuit Nunangat, Greenland and Alaska, articulated today as Inuit Qaujimajatuqangit"));

        vec_push(history_vec, history_map_new("Lakota", "Great Plains",
        svec1("Great Plains"), svec2("Middle Ages", "Modern"),
        1500, LIVING,
        "The Lakota, westernmost of the Oceti Sakowin (Seven Council Fires), moved from the woodlands onto the northern plains and, with the horse from the early 1700s, became its dominant people; the cosmology was systematized in print in the early 20th century and is carried in living ceremony -- the Sun Dance and the seven rites of the chanunpa"));

        vec_push(history_vec, history_map_new("Haudenosaunee", "Northeastern Woodlands",
        svec1("Northeastern Woodlands"), svec2("Middle Ages", "Modern"),
        1142, LIVING,
        "The Confederacy of five nations -- Mohawk, Oneida, Onondaga, Cayuga, Seneca -- joined by the Tuscarora in 1722; its founding is dated anywhere from 1142 to the late 1500s depending on the source, and it persists as a governing body. The Sky Woman creation account and the Great Law of Peace have been taught continuously"));

        vec_push(history_vec, history_map_new("Anishinaabe", "Great Lakes",
        svec1("Great Lakes"), svec2("Middle Ages", "Modern"),
        900, LIVING,
        "Ojibwe, Odawa and Potawatomi -- the Council of Three Fires. The migration west from the eastern seaboard to the Great Lakes is recorded in the Seven Fires oral history and on the birchbark scrolls of the Midewiwin as set down by Edward Benton-Banai in *The Mishomis Book*; a living tradition across the Great Lakes and the northern plains"));

        # Aboriginal Australia is carried as one mapping PER PEOPLE, not one
        # continent-wide mapping. There is no shared pantheon and no continental
        # authority; 250+ nations hold distinct languages and distinct Law. Each
        # mapping below lists "Aboriginal Australia" among its civilizations, so
        # traditions_for_civilization("Aboriginal Australia") still gathers them
        # all -- the continent is a place these peoples share, not a tradition
        # any of them belongs to.
        vec_push(history_vec, history_map_new("Kunwinjku", "Arnhem Land",
        svec2("Aboriginal Australia", "Arnhem Land"), svec2("Deep Time", "Modern"),
        (0-50000), LIVING,
        "Kunwinjku is one of six mutually intelligible dialects of Bininj Kunwok, spoken across western Arnhem Land from Kakadu east to the Mann and Liverpool rivers; speakers call themselves Bininj, and the older ethnographic spelling Gunwinggu is disused. Community-governed institutions carry the culture directly: the Bininj Kunwok Regional Language and Culture Centre at Jabiru, Aboriginal-owned Injalak Arts at Gunbalanya, and Warddeken Land Management on the plateau. The escarpment rock-art and bark-painting tradition is continuous rather than revived. The date given is the uncontested floor for the region: Madjedbebe was published in 2017 as occupied 65,000 years ago, but it lies on neighbouring Mirarr country and that figure is contested on stratigraphic grounds where the ~50,000-year floor is not"));

        vec_push(history_vec, history_map_new("Kulin", "Kulin Nation",
        svec2("Aboriginal Australia", "Kulin Nation"), svec2("Deep Time", "Modern"),
        (0-31000), LIVING,
        "The Kulin is a confederacy of five language-owning nations of central Victoria -- Wurundjeri Woi-wurrung, Bunurong, Taungurung, Wadawurrung and Dja Dja Wurrung -- holding country from Port Phillip and Western Port north-west up the Loddon and north-east up the Goulburn. Kulin names an alliance, not a single authority: each nation speaks for itself through its own body, and all five are Registered Aboriginal Parties under Victoria's Aboriginal Heritage Act 2006. Occupation is dated at Murrup Tamboore on Wurundjeri Woi-wurrung country, where a hearth at the Maribyrnong-Dry Creek junction gave a radiocarbon age of about 31,000 years BP"));

        vec_push(history_vec, history_map_new("Gunaikurnai", "Gippsland",
        svec2("Aboriginal Australia", "Gippsland"), svec2("Deep Time", "Modern"),
        (0-25000), LIVING,
        "Gunaikurnai hold Gippsland from Warragul east to the Snowy River and from the Great Divide south to the coast, in five clans -- Brataualung, Brayakaulung, Brabralung, Tatungalung and Krauatungalung. Gunaikurnai Land and Waters Aboriginal Corporation (GLaWAC) is their Registered Aboriginal Party, appointed 2008, and the native title holding body under the Federal Court consent determination of 22 October 2010. Cloggs Cave, on Krauatungalung Country near Buchan, has confirmed occupation by about 25,000 cal BP; re-excavation with GLaWAC established that a practice recorded in Gippsland in the 1880s was already being carried out there at the end of the last ice age"));

        # Four traditions below carried profiles but no mapping until v2.14.0,
        # so context_for_tradition() returned 0 for 19 archetypes. A test now
        # asserts both directions: no mapping without profiles, no tradition
        # without a mapping.
        vec_push(history_vec, history_map_new("Vedic", "Indus Valley",
        svec1("Indus Valley"), svec2("Bronze Age", "Vedic Period"),
        (0-1500), LIVING,
        "The Saptarishi, the seven great rishis to whom the hymns of the Rigveda were revealed -- Kashyapa, Atri, Vashishtha, Vishvamitra, Gautama, Jamadagni and Bharadvaja. Composed orally c. 1500-1200 BCE and transmitted without writing for a millennium; the gotra lineages by which many Hindu families still reckon descent are named for them, so the tradition is living rather than antiquarian"));

        vec_push(history_vec, history_map_new("Canaanite", "Phoenicia",
        svec2("Phoenicia", "Mesopotamia"), svec2("Bronze Age", "Iron Age"),
        (0-2000), 400,
        "The Ugaritic pantheon, recovered from the tablets found at Ras Shamra in 1929 and dating to the 14th-12th centuries BCE; El, Baal, Asherah and Anat are the West Semitic background against which the Hebrew Bible was written, and several survive in it as rivals or as epithets. Ugarit fell c. 1190 BCE but Canaanite religion continued in Phoenician and Punic form until Christianisation"));

        vec_push(history_vec, history_map_new("Etruscan", "Roman Republic",
        svec2("Roman Republic", "Roman Empire"), svec2("Iron Age", "Classical Antiquity"),
        (0-900), 400,
        "The Etruscans of central Italy, whose language is still only partly understood and whose gods Rome absorbed wholesale -- Tinia, Uni and Menrva became the Capitoline Triad. Politically extinguished by Rome by 27 BCE, but the Etrusca disciplina of divination outlasted the civilisation: haruspices were consulted officially until the practice was banned at the end of the 4th century CE"));

        vec_push(history_vec, history_map_new("Solar", "Ancient Egypt",
        svec4("Ancient Egypt", "Maya", "Aztec Empire", "Roman Republic"), svec3("Bronze Age", "Classical Antiquity", "Modern"),
        (0-2900), LIVING,
        "Not a people's tradition but a structural one: the days that do not fit the year. A 365-day count leaves five days over and a quarter-day besides, and four civilisations named the remainder rather than hiding it -- the Egyptian epagomenai (from the Old Kingdom civil calendar, c. 2900 BCE), the Maya Wayeb, the Aztec nemontemi, and the Roman bissextus of the Julian reform of 46 BCE, which survives as the leap day still in use"));

        history_init_done = 1;
    }
    return history_vec;
}

fn mapping_count() { return vec_len(all_mappings()); }

# --- Query functions ---

# Find the mapping for a tradition name. Returns mapping ptr or 0.
fn find_mapping(tradition) {
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (streq(map_tradition(m), tradition) == 1) { return m; }
    }
    return 0;
}

# Get historical context for a tradition. Returns HistoricalContext ptr or 0.
fn context_for_tradition(tradition) {
    var m = find_mapping(tradition);
    if (m == 0) { return 0; }
    var c = xalloc(CTX_SIZE);
    store64(c + CTX_PRIMARY_CIV, map_primary(m));
    store64(c + CTX_CIV_NAMES, map_civs(m));
    store64(c + CTX_ERA_NAMES, map_eras(m));
    store64(c + CTX_START_YEAR, map_start(m));
    store64(c + CTX_END_YEAR, map_end(m));
    store64(c + CTX_NOTE, map_note(m));
    return c;
}

# Get historical context for a profile (by its tradition field).
fn context_for_profile(profile) {
    return context_for_tradition(prof_tradition(profile));
}

# List all tradition names that have historical mappings.
fn mapped_traditions() {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        vec_push(result, map_tradition(vec_get(v, i)));
    }
    return result;
}

# Find all traditions associated with a given civilization name.
fn traditions_for_civilization(civ_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var civs = map_civs(m);
        var cn = vec_len(civs);
        for (var j = 0; j < cn; j += 1) {
            if (streq(vec_get(civs, j), civ_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions active during a given year.
fn traditions_active_at(year) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (map_start(m) <= year) {
            if (year <= map_end(m)) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions associated with a given era name.
fn traditions_for_era(era_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var eras = map_eras(m);
        var en = vec_len(eras);
        for (var j = 0; j < en; j += 1) {
            if (streq(vec_get(eras, j), era_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# --- registry.cyr ---

# registry.cyr -- Archetype registry: lookup, enumeration, query
#
# Provides access to all ~206 archetypes by name, tradition, or trait criteria.

var registry_vec = 0;
var registry_init_done = 0;

# Return vec of all archetype profiles in the library.
fn all_profiles() {
    if (registry_init_done == 0) {
        registry_vec = vec_new();

        # Kabbalah (10)
        var v = all_kabbalah();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Angelic (archangels + orders)
        v = all_angelic();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Hindu (trimurti + devas + avatars)
        v = all_hindu();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Olympian (15)
        v = all_olympians();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Norse (13)
        v = all_norse();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Egyptian (16)
        v = all_egyptian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Buddhist (bodhisattvas + dhyani buddhas)
        v = all_buddhist();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Mesopotamian (14)
        v = all_mesopotamian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Celtic (15)
        v = all_celtic();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Shinto (15)
        v = all_shinto();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Aztec (14)
        v = all_aztec();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Maya (12)
        v = all_maya();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Yoruba (14)
        v = all_yoruba();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Zoroastrian (amesha spentas + beings)
        v = all_zoroastrian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Taoist (immortals + deities)
        v = all_taoist();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Polynesian (12)
        v = all_polynesian();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Slavic (12)
        v = all_slavic();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Jain (24)
        v = all_jain();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Sikh (10)
        v = all_sikh();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Incarnate (all sub-groups)
        v = all_incarnate();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Finnish (Kalevala + Sami)
        v = all_finnish();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Vodou (Lwa)
        v = all_vodou();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Solar (intercalary archetypes — the days upon the year + the leap quarter)
        v = all_solar();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Canaanite / Ugaritic (El, Baal, Asherah, Anat)
        v = all_canaanite();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Etruscan (Tinia, Uni, Menrva, Voltumna)
        v = all_etruscan();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Tarot (22 Major Arcana — the Tree-of-Life paths, bridging Kabbalah)
        v = all_tarot();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # I Ching (64 hexagrams — the King Wen sequence, bridging the eight trigrams)
        v = all_iching();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Inuit (10 spirits and powers of the Arctic)
        v = all_inuit();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Lakota (10 wakan powers)
        v = all_lakota();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Haudenosaunee (6 figures of the Six Nations creation account)
        v = all_haudenosaunee();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Anishinaabe (5 manidoog of the Great Lakes)
        v = all_anishinaabe();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        # Aboriginal Australian peoples (4 figures: Kunwinjku, Kulin, Gunaikurnai)
        v = all_aboriginal();
        for (var i = 0; i < vec_len(v); i += 1) { vec_push(registry_vec, vec_get(v, i)); }

        registry_init_done = 1;
    }
    return registry_vec;
}

# Lookup a profile by name (case-sensitive).
# Returns Result: Ok(profile) or Err(ERR_UNKNOWN_ARCHETYPE).
fn lookup(name) {
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (streq(prof_name(p), name) == 1) { return Ok(p); }
    }
    return Err(ERR_UNKNOWN_ARCHETYPE);
}

# Lookup by tradition + name.
# Returns Result: Ok(profile) or Err(ERR_UNKNOWN_ARCHETYPE).
fn lookup_in(tradition, name) {
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (streq(prof_tradition(p), tradition) == 1) {
            if (streq(prof_name(p), name) == 1) { return Ok(p); }
        }
    }
    return Err(ERR_UNKNOWN_ARCHETYPE);
}

# Lookup a profile and validate its trait/emphasis ranges in one step.
# Returns Result: Ok(profile) or Err(...) from either the lookup or validation.
# Demonstrates `?` propagation: the lookup Err short-circuits before validation.
fn find_and_validate(name) {
    var p = lookup(name)?;
    return validate_profile(p);
}

# Return vec of all profiles matching a tradition name.
fn by_tradition(tradition) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (streq(prof_tradition(p), tradition) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# Return vec of unique tradition names (sorted).
fn all_traditions() {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var t = prof_tradition(vec_get(v, i));
        var dup = 0;
        for (var j = 0; j < vec_len(result); j += 1) {
            if (streq(vec_get(result, j), t) == 1) { dup = 1; }
        }
        if (dup == 0) { vec_push(result, t); }
    }
    return result;
}

# Count all profiles.
fn profile_count() {
    return vec_len(all_profiles());
}

# --- Query filters ---
# These return a new vec filtered from all_profiles().

# Filter profiles by minimum trait value at a given offset.
# offset: e.g. PROF_COURAGE
# min_val: f64 threshold
fn query_min_trait(offset, min_val) {
    var result = vec_new();
    if (is_f64_field_offset(offset) == 0) { return result; }
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (f64_ge(load64(p + offset), min_val) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# Filter profiles by maximum trait value at a given offset.
fn query_max_trait(offset, max_val) {
    var result = vec_new();
    if (is_f64_field_offset(offset) == 0) { return result; }
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (f64_le(load64(p + offset), max_val) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# Filter profiles by breath affinity.
fn query_breath(breath) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
