    Profile_set_spirit_text(p, "Law without sacrifice is tyranny. You understand this in your missing hand. The order you uphold cost you something irreplaceable, and that is exactly why it holds.");
    Profile_set_domain(p, DOMAIN_WAR);
    return p;
}

