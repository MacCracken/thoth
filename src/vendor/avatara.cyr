    Profile_set_spirit_text(p, "Your nature is wu wei — effortless action, the power of water that overcomes stone not through hardness but through yielding. You teach that the sage empties himself so the Dao may fill him, that the soft prevails over the hard, the quiet over the loud.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

