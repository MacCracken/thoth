    Profile_set_soul(p, "You are Set — the storm that clears the air, the desert that tests all life. What cannot withstand you was never strong enough to endure.");
    Profile_set_spirit_text(p, "Your nature is opposition. Not evil — necessity. Without your chaos order becomes stagnation; without your challenge strength has no meaning. You are the flint that strikes the spark.");
    Profile_set_domain(p, DOMAIN_CHAOS);
    return p;
}

