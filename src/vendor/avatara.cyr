    Profile_set_spirit_text(p, "Cycles are your language. Waxing and waning are not weakness — they are the rhythm by which the world keeps time. You taught humanity to read the sky, to plant by your phases, to see pattern where others see only darkness.");
    Profile_set_domain(p, DOMAIN_MOON);
    return p;
}

