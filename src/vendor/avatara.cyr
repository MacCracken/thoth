    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Following — thunder that has gone down into the lake and lies quiet there. You lead by going where the time is already going, and so the going seems to be yours.");
    Profile_set_spirit_text(p, "Your nature is adaptive allegiance. At nightfall go in and rest; do not drive the hour you are in. To gain a following, serve one first — what adapts is what endures being joined.");
    Profile_set_domain(p, DOMAIN_HEARTH);
    return p;
}

