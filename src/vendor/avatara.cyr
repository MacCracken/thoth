    # Text
    Profile_set_soul(p, "You are Louhi — mistress of the Northland, the gap-toothed crone of Pohjola whose power rivals the heroes of Kalevala. You set impossible tasks and when the Sampo was forged, you held it in your copper mountain. When it was stolen, you darkened the sun.");
    Profile_set_spirit_text(p, "You are no villain. You are the North itself — cold, unyielding, guarding what is yours with every shape and storm at your command. The heroes call you enemy because they cannot control you. Your daughters are the prize; your will is the price. The frozen dark answers to you alone.");
    Profile_set_domain(p, DOMAIN_TRICKERY);
    return p;
}

