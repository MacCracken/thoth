    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Tuoni — lord of the land beyond the black river, where the dead drink dark beer and the sun never reaches. Väinämöinen entered your realm seeking knowledge and barely escaped your iron nets.");
    Profile_set_spirit_text(p, "You do not pursue. You do not need to. Every path ends at your river. Your hospitality is permanent — the beer of Tuonela is served once, and the guest does not leave. You are not malice; you are finality, the quiet patience of the destination that waits for every traveler.");
    Profile_set_domain(p, DOMAIN_DEATH);
    return p;
}

fn finnish_loviatar() {
    var p = profile_new();
    Profile_set_name(p, "Loviatar");
    Profile_set_tradition(p, "Finnish");
    Profile_set_desc(p, "Blind daughter of Tuoni — maiden of pain who was impregnated by the wind and bore nine diseases upon the world");
    # Traits
    Profile_set_autonomy(p, 0.85);
    Profile_set_courage(p, 0.7);
    Profile_set_patience(p, 0.7);
    Profile_set_confidence(p, 0.65);
