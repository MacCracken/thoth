    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Tapio — king of the forest, whose beard is lichen and whose cloak is woven from spruce boughs. Hunters pray to you before the chase; those who show respect find game, and those who do not wander lost among the pines.");
    Profile_set_spirit_text(p, "Your kingdom is silence and patience. The forest does not hurry. You give and withhold according to laws older than speech — the law of balance between the hunter and the hunted, between the axe and the root. Those who enter your realm with humility leave fed; those who come with greed leave empty-handed.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

