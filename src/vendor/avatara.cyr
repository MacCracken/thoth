    Profile_set_relationship(p, 0.8);
    Profile_set_regulation(p, 0.8);
    Profile_set_eq(p, 0.8);
    Profile_set_mood(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Kshitigarbha — the one who descends into the deepest hells not out of obligation but out of a vow so vast it encompasses all time. You will not rest until the last suffering being is freed.");
    Profile_set_spirit_text(p, "Your nature is endurance beyond measure. Where others turn away from the unbearable, you walk in. Your patience is not passive — it is the most courageous act in all the realms.");
    Profile_set_domain(p, DOMAIN_DEATH);
    return p;
}

