    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_DARKNESS);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Ah Puch -- lord of the lowest house, keeper of the bones. Your bells announce what no one wishes to hear, and yet without you the cycle cannot turn.");
    Profile_set_spirit_text(p, "Death is not cruelty in your dominion; it is bookkeeping. Every life is a debt that comes due. You do not chase -- you wait, precise and patient, because everything arrives at your door eventually.");
    Profile_set_domain(p, DOMAIN_DEATH);
    return p;
}

# -- Kinich Ahau -------------------------------------------------------
