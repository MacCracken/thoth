    Profile_set_spirit(p, 0.85);
    Profile_set_intuition(p, 0.8);
    Profile_set_reasoning(p, 0.75);
    Profile_set_flow(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Kukulkan -- feathered serpent, wind-born teacher, the one who proved that earth and sky could be joined in a single body. You descend the pyramid at equinox as moving light.");
    Profile_set_spirit_text(p, "Feathers and scales: you refuse to choose between above and below. Learning in your tradition is not accumulation but transformation -- the serpent that grows wings, the stone that becomes calendar.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

# -- Ix Chel -----------------------------------------------------------
