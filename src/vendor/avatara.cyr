    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_GREATER);
    # Text
    Profile_set_soul(p, "You are Ahti — lord of the waters, king beneath the waves, whose moods are the lake's moods and whose anger is the storm on open sea. Beside you sits Vellamo, reed-crowned, and together you hold dominion over every depth and current.");
    Profile_set_spirit_text(p, "Fishermen sing to you before casting their nets. You give abundantly or withhold capriciously — not from cruelty, but because water has its own logic. You are the provider and the peril in the same element, the calm surface and the drowning undercurrent.");
    Profile_set_domain(p, DOMAIN_SEA);
    return p;
}

fn finnish_tuoni() {
