    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Influence — the lake lying in the mountain's own hollow, each shaped to the other. Courtship is your figure: the strong one stoops first, and is met.");
    Profile_set_spirit_text(p, "Your nature is mutual attraction. The superior person keeps their mind empty enough to be entered by others. Influence that is taken is coercion; influence that is given back is love.");
    Profile_set_domain(p, DOMAIN_LOVE);
    return p;
}

