}

# Filter profiles by polarity.
fn query_polarity(pol) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_polarity(p) == pol) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by cosmic tier.
fn query_tier(tier) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_tier(p) == tier) { vec_push(result, p); }
    }
    return result;
}

# Filter profiles by primary domain.
fn query_domain(domain) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        if (prof_domain(p) == domain) { vec_push(result, p); }
    }
    return result;
}

# Count profiles with a given primary domain (no result vec allocated).
fn query_count_domain(domain) {
    var c = 0;
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        if (prof_domain(vec_get(v, i)) == domain) { c += 1; }
    }
    return c;
}

# Count profiles matching a min trait threshold (without allocating a result vec).
fn query_count_min_trait(offset, min_val) {
    var c = 0;
    if (is_f64_field_offset(offset) == 0) { return c; }
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        if (f64_ge(load64(vec_get(v, i) + offset), min_val) == 1) { c += 1; }
    }
    return c;
}

# Filter a vec by tradition (for chaining).
fn filter_tradition(src, tradition) {
    var result = vec_new();
    var n = vec_len(src);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(src, i);
        if (streq(prof_tradition(p), tradition) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# --- History-based query filters ---

# Filter profiles whose tradition is in the given vec of tradition names.
# Shared implementation for the history-based queries below.
fn query_by_traditions(trads) {
    var result = vec_new();
    var v = all_profiles();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(v, i);
        var t = prof_tradition(p);
        for (var j = 0; j < vec_len(trads); j += 1) {
            if (streq(vec_get(trads, j), t) == 1) {
                vec_push(result, p);
            }
        }
    }
    return result;
}

# Filter profiles by civilization (via history mappings).
fn query_civilization(civ_name) {
    return query_by_traditions(traditions_for_civilization(civ_name));
}

# Filter profiles by era (via history mappings).
fn query_era(era_name) {
    return query_by_traditions(traditions_for_era(era_name));
}

# Filter profiles by year of tradition activity (via history mappings).
fn query_active_at(year) {
    return query_by_traditions(traditions_active_at(year));
}

# Filter a vec by minimum trait (for chaining).
fn filter_min_trait(src, offset, min_val) {
    var result = vec_new();
    if (is_f64_field_offset(offset) == 0) { return result; }
    var n = vec_len(src);
    for (var i = 0; i < n; i += 1) {
        var p = vec_get(src, i);
        if (f64_ge(load64(p + offset), min_val) == 1) {
            vec_push(result, p);
        }
    }
    return result;
}

# --- affinity.cyr ---

# affinity.cyr -- Cross-tradition affinity: scoring, similarity, conflict detection
#
# Measures how similar two archetypes are across all trait dimensions.
# Enables cross-tradition mapping (Shango ~ Thor ~ Indra ~ Perun)
# and conflict detection for composition.
#
# Affinity score: 1.0 = identical traits, 0.0 = maximally opposite.
# Computed as 1 - (mean absolute difference across all 15 traits + 14 emphases).

# --- Affinity tuning parameters ---
# Trait delta above which two profiles are said to "conflict" on that trait.
fn conflict_threshold() { return 0.4; }
# Number of conflicting traits at which two profiles are deemed incompatible.
enum AffinityParams { INCOMPAT_MIN_CONFLICTS = 5; }

# --- Affinity scoring ---

# Sum of absolute f64 differences between two profiles over the field range
# [first, last] (8-aligned offsets). Shared by affinity / trait_affinity.
fn sum_abs_diff(a, b, first, last) {
    var total = 0.0;
    var off = first;
    while (off <= last) {
        total = f64_add(total, f64_abs(f64_sub(load64(a + off), load64(b + off))));
        off += 8;
    }
    return total;
}

# Compute affinity between two profiles (0.0 to 1.0).
# Considers all 15 traits and 14 emphases equally weighted.
# Returns 0.0 if either profile is NULL (e.g. an unresolved lookup).
fn affinity(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var total_diff = f64_add(sum_abs_diff(a, b, TW_FIRST, TW_LAST),
                             sum_abs_diff(a, b, ME_FIRST, ME_LAST));
    var mean_diff = f64_div(total_diff, f64_from(TW_COUNT + ME_COUNT));
    return f64_sub(1.0, mean_diff);
}

# Compute trait-only affinity (ignores emphasis, just the 15 personality traits).
# Returns 0.0 if either profile is NULL.
fn trait_affinity(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var mean_diff = f64_div(sum_abs_diff(a, b, TW_FIRST, TW_LAST), f64_from(TW_COUNT));
    return f64_sub(1.0, mean_diff);
}

# --- Similarity search ---

# Result entry: profile pointer + affinity score
enum SimLayout {
    SIM_PROFILE = 0;
    SIM_SCORE = 8;
    SIM_SIZE = 16;
}

fn sim_new(profile, score) {
    var s = xalloc(SIM_SIZE);
    store64(s + SIM_PROFILE, profile);
    store64(s + SIM_SCORE, score);
    return s;
}

fn sim_profile(s) { return load64(s + SIM_PROFILE); }
fn sim_score(s)   { return load64(s + SIM_SCORE); }

# Find the N most similar archetypes to the given profile.
# Returns a vec of sim entries sorted by descending affinity.
# Excludes the source profile itself (by name match).
# max_results <= 0 means "unlimited" (return all, sorted). NULL source -> empty.
#
# Selection is BOUNDED rather than sort-then-trim: the result list is held at
# max_results entries, and a candidate that cannot displace the weakest kept
# entry is dropped without allocating a sim entry or shifting anything. The
# bounded case therefore costs O(N*k) instead of the O(N^2) full insertion sort
# this replaced (2.10.1) — at N=460, k=5 that is ~2.3k shift operations rather
# than ~53k, and it no longer degrades as traditions are added. The returned
# set, its ordering, and tie behavior (a later equal score still sorts ahead)
# are unchanged. The unbounded case still pays a full insertion sort, since
# every candidate has to be ordered anyway.
fn similar_to(source, max_results) {
    var results = vec_new();
    if (source == 0) { return results; }
    var profiles = all_profiles();
    var n = vec_len(profiles);
    var src_name = prof_name(source);
    var src_trad = prof_tradition(source);

    # cap > 0 bounds the list; cap < 0 means keep everything (max_results <= 0).
    var cap = max_results;
    if (cap <= 0) { cap = 0 - 1; }

    for (var i = 0; i < n; i += 1) {
        var p = vec_get(profiles, i);
        # Skip self
        if (streq(prof_name(p), src_name) == 1) {
            if (streq(prof_tradition(p), src_trad) == 1) {
                continue;
            }
        }
        var score = affinity(source, p);

        # The list is full and this candidate loses to the weakest kept entry:
        # it can never place, so skip it before allocating or shifting.
        var rn = vec_len(results);
        if (cap > 0) {
            if (rn >= cap) {
                if (f64_gt(sim_score(vec_get(results, rn - 1)), score) == 1) {
                    continue;
                }
            }
        }

        # Insert into descending position, shifting weaker entries right. The
        # f64_gt test (not f64_ge) preserves the previous tie order.
        var entry = sim_new(p, score);
        vec_push(results, entry);
        var j = vec_len(results) - 1;
        while (j > 0) {
            var prev = vec_get(results, j - 1);
            if (f64_gt(sim_score(prev), score) == 1) {
                break;
            }
            vec_set(results, j, prev);
            j -= 1;
        }
        vec_set(results, j, entry);

        # Hold the list at the cap.
        if (cap > 0) {
            if (vec_len(results) > cap) { vec_pop(results); }
        }
    }
    return results;
}

# Find the most similar archetype across a different tradition.
# Useful for cross-tradition mapping (e.g. "who is the Norse Thor?").
# Single O(n) pass over all profiles — returns the best foreign profile, or 0.
fn cross_tradition_match(source) {
    var best = 0;
    if (source == 0) { return best; }
    var best_score = 0.0;
    var profiles = all_profiles();
    var n = vec_len(profiles);
    var src_trad = prof_tradition(source);

    for (var i = 0; i < n; i += 1) {
        var p = vec_get(profiles, i);
        # Must be different tradition
        if (streq(prof_tradition(p), src_trad) == 1) { continue; }
        var score = affinity(source, p);
        if (f64_gt(score, best_score) == 1) {
            best = p;
            best_score = score;
        }
    }
    return best;
}

# Find all cross-tradition matches for a profile (one per tradition).
# Returns vec of sim entries, one per foreign tradition, sorted by affinity.
fn cross_tradition_matches(source, max_results) {
    var results = vec_new();
    if (source == 0) { return results; }
    var src_trad = prof_tradition(source);
    var trads = all_traditions();

    for (var i = 0; i < vec_len(trads); i += 1) {
        var t = vec_get(trads, i);
        if (streq(t, src_trad) == 1) { continue; }

        # Find best match in this tradition
        var tprofs = by_tradition(t);
        var best = 0;
        var best_score = 0.0;
        for (var j = 0; j < vec_len(tprofs); j += 1) {
            var p = vec_get(tprofs, j);
            var score = affinity(source, p);
            if (f64_gt(score, best_score) == 1) {
                best = p;
                best_score = score;
            }
        }
        if (best != 0) {
            vec_push(results, sim_new(best, best_score));
        }
    }

    # Sort by score descending
    var rn = vec_len(results);
    for (var i = 1; i < rn; i += 1) {
        var key = vec_get(results, i);
        var key_score = sim_score(key);
        var j = i - 1;
        while (j >= 0) {
            if (f64_gt(sim_score(vec_get(results, j)), key_score) == 1) { break; }
            vec_set(results, j + 1, vec_get(results, j));
            j -= 1;
        }
        vec_set(results, j + 1, key);
    }

    if (max_results > 0) {
        if (rn > max_results) {
            var trimmed = vec_new();
            for (var i = 0; i < max_results; i += 1) {
                vec_push(trimmed, vec_get(results, i));
            }
            return trimmed;
        }
    }
    return results;
}

# --- Conflict detection ---

# Conflict entry: field offset + trait name + values from each profile + delta
enum ConflictLayout {
    CONF_OFFSET = 0;
    CONF_NAME = 8;
    CONF_VAL_A = 16;
    CONF_VAL_B = 24;
    CONF_DELTA = 32;
    CONF_SIZE = 40;
}

fn conf_offset(c) { return load64(c + CONF_OFFSET); }
fn conf_name(c)   { return load64(c + CONF_NAME); }
fn conf_val_a(c)  { return load64(c + CONF_VAL_A); }
fn conf_val_b(c)  { return load64(c + CONF_VAL_B); }
fn conf_delta(c)  { return load64(c + CONF_DELTA); }

# Trait names for conflict reporting
fn trait_name_for_offset(off) {
    if (off == PROF_WARMTH) { return "warmth"; }
    if (off == PROF_HUMOR) { return "humor"; }
    if (off == PROF_EMPATHY) { return "empathy"; }
    if (off == PROF_PATIENCE) { return "patience"; }
    if (off == PROF_CONFIDENCE) { return "confidence"; }
    if (off == PROF_CURIOSITY) { return "curiosity"; }
    if (off == PROF_CREATIVITY) { return "creativity"; }
    if (off == PROF_DIRECTNESS) { return "directness"; }
    if (off == PROF_FORMALITY) { return "formality"; }
    if (off == PROF_VERBOSITY) { return "verbosity"; }
    if (off == PROF_COURAGE) { return "courage"; }
    if (off == PROF_PRECISION) { return "precision"; }
    if (off == PROF_SKEPTICISM) { return "skepticism"; }
    if (off == PROF_AUTONOMY) { return "autonomy"; }
    if (off == PROF_PEDAGOGY) { return "pedagogy"; }
    return "unknown";
}

# Detect conflicts between two profiles.
# A conflict is any trait where the absolute difference exceeds the threshold.
# Default threshold: 0.4 (e.g. warmth 0.9 vs warmth 0.3 = conflict).
# Returns vec of conflict entries sorted by largest delta first.
fn conflicts(a, b, threshold) {
    var result = vec_new();
    if (a == 0) { return result; }
    if (b == 0) { return result; }
    var off = TW_FIRST;
    while (off <= TW_LAST) {
        var va = load64(a + off);
        var vb = load64(b + off);
        var delta = f64_abs(f64_sub(va, vb));
        if (f64_gt(delta, threshold) == 1) {
            var c = xalloc(CONF_SIZE);
            store64(c + CONF_OFFSET, off);
            store64(c + CONF_NAME, trait_name_for_offset(off));
            store64(c + CONF_VAL_A, va);
            store64(c + CONF_VAL_B, vb);
            store64(c + CONF_DELTA, delta);
            vec_push(result, c);
        }
        off += 8;
    }

    # Sort by delta descending
    var rn = vec_len(result);
    for (var i = 1; i < rn; i += 1) {
        var key = vec_get(result, i);
        var key_d = conf_delta(key);
        var j = i - 1;
        while (j >= 0) {
            if (f64_gt(conf_delta(vec_get(result, j)), key_d) == 1) { break; }
            vec_set(result, j + 1, vec_get(result, j));
            j -= 1;
        }
        vec_set(result, j + 1, key);
    }
    return result;
}

# Convenience: conflicts with default threshold.
fn detect_conflicts(a, b) {
    return conflicts(a, b, conflict_threshold());
}

# Check if two profiles are incompatible (too many conflicting traits).
fn is_incompatible(a, b) {
    var c = detect_conflicts(a, b);
    if (vec_len(c) >= INCOMPAT_MIN_CONFLICTS) { return 1; }
    return 0;
}

# --- shadow.cyr ---

# shadow.cyr -- Shadow aspect: the dark/inverted form of an archetype
#
# Every archetype has a shadow — the disowned, inverted half (the Jungian
# shadow; the destructive aspect every tradition grants its deities). The
# shadow is a *pure derivation*: shadow(profile) returns a new ArchetypeProfile
# with each dimension inverted by a fixed, involutive rule, so
# shadow(shadow(x)) restores x on every inverted dimension.
#
# Inversions:
#   traits + emphases  v -> 1.0 - v          (involutive)
#   breath             mirror across unity: UNITY fixed, else 7 - b
#                      (EARLY_EXHALE<->LATE_INHALE, MID<->MID, LATE_EXHALE<->EARLY_INHALE)
#   growth_dir         DIFFERENTIATE<->INTEGRATE, PRESERVE<->TRANSFORM, STILL fixed
#   polarity           MASCULINE<->FEMININE, ANDROGYNOUS/TRANSCENDENT fixed
#   element, tier      preserved (a shadow shares the archetype's domain & rank)
#   name               "Shadow of <name>"; tradition preserved; text marked

# Mirror the cosmic-breath phase: the still point (unity) is its own shadow;
# every other phase mirrors to the opposite side of the breath (b + result = 7).
fn shadow_breath(b) {
    if (b == BREATH_UNITY) { return BREATH_UNITY; }
    return 7 - b;
}

# Invert growth pressure. STILL (no pressure) is its own shadow.
fn shadow_growth(g) {
    if (g == GROWTH_DIFFERENTIATE) { return GROWTH_INTEGRATE; }
    if (g == GROWTH_INTEGRATE)     { return GROWTH_DIFFERENTIATE; }
    if (g == GROWTH_PRESERVE)      { return GROWTH_TRANSFORM; }
    if (g == GROWTH_TRANSFORM)     { return GROWTH_PRESERVE; }
    return GROWTH_STILL;
}

# Flip gender polarity; balance (androgynous) and transcendence are self-shadow.
fn shadow_polarity(p) {
    if (p == POL_MASCULINE) { return POL_FEMININE; }
    if (p == POL_FEMININE)  { return POL_MASCULINE; }
    return p;
}

# Build the "Shadow of <name>" display name.
fn shadow_name(name) {
    var prefix = "Shadow of ";
    var plen = strlen(prefix);
    var nlen = strlen(name);
    var buf = xalloc(plen + nlen + 1);
    memcpy(buf, prefix, plen);
    memcpy(buf + plen, name, nlen);
    store8(buf + plen + nlen, 0);
    return buf;
}

# Return the shadow (dark/inverted form) of a profile, or 0 if p is NULL.
fn shadow(p) {
    if (p == 0) { return 0; }
    var s = profile_new();

    # Invert every trait + emphasis (contiguous range, step 8).
    var off = TW_FIRST;
    while (off <= ME_LAST) {
        store64(s + off, f64_sub(1.0, load64(p + off)));
        off += 8;
    }

    # Inverted classifications
    Profile_set_breath(s, shadow_breath(prof_breath(p)));
    Profile_set_growth_dir(s, shadow_growth(prof_growth_dir(p)));
    Profile_set_polarity(s, shadow_polarity(prof_polarity(p)));
    # Preserved classifications
    Profile_set_element(s, prof_element(p));
    Profile_set_tier(s, prof_tier(p));

    # Identity
    Profile_set_name(s, shadow_name(prof_name(p)));
    Profile_set_tradition(s, prof_tradition(p));
    Profile_set_desc(s, "Shadow aspect — the inverted, disowned form");
    Profile_set_soul(s, "Your shadow: the half you suppress, made manifest. Not evil — unintegrated.");
    Profile_set_spirit_text(s, "What you reject in yourself waits here, asking to be owned.");
    return s;
}

# True (1) if `a` is the shadow of `b`: every inverted dimension of `a` matches
# the inversion of `b` (traits/emphases within f64 rounding tolerance).
fn is_shadow_of(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var off = TW_FIRST;
    while (off <= ME_LAST) {
        var want = f64_sub(1.0, load64(b + off));
        if (f64_gt(f64_abs(f64_sub(load64(a + off), want)), 0.0001) == 1) { return 0; }
        off += 8;
    }
    if (prof_breath(a) != shadow_breath(prof_breath(b))) { return 0; }
    if (prof_growth_dir(a) != shadow_growth(prof_growth_dir(b))) { return 0; }
    if (prof_polarity(a) != shadow_polarity(prof_polarity(b))) { return 0; }
    return 1;
}

# --- overlay.cyr ---

# overlay.cyr -- Archetype overlays: cross-cutting typologies read OFF the profile.
#
# The first layer in this library that sits ON TOP of the archetypes rather than
# beside them. A tradition module answers "who is this?"; an overlay answers
# "what shape is this, in a system that was not built for it?" — what Enneagram
# type does Thor read as, which Jungian role is Iktomi playing. Nothing here is
# authored per archetype and nothing is stored: every value is derived from the
# profile's own trait and emphasis weights, the same way `aspect.cyr` derives
# roles. Profiles are unchanged, the 320-byte layout is untouched, and the
# registry does not know these exist — overlays are not archetypes and are not
# counted as such.
#
# WHAT AN OVERLAY SCORE IS, AND IS NOT. `profile_enneagram_score(p, i)` says how
# strongly p's personality vector reads as type i on this library's mapping. It
# is a projection of one system onto another, not a diagnosis and not a claim
# that the tradition itself recognises the category — the Enneagram is a 20th-
# century typology and Jung's archetypes are 20th-century psychology; neither
# was in the room when the Dagda or Sedna were described. Consumers wanting the
# archetype's own self-understanding should read `domain`, `soul` and `spirit`.
#
# TRADITIONS AND TYPOLOGIES ARE MUTUALLY EXCLUSIVE, and this file is the line
# between them. A tradition is a people's own account of who its figures are; it
# earns archetypes, a `tradition` string, a history mapping and a place in
# `profile_count()`. A typology is a modern analytic grid laid over other
# people's figures from outside, and it gets none of those — it lives here, as
# derivation, and nowhere else. The Enneagram will not become a tradition with
# nine archetypes, and neither will Jung's set; that would put a 20th-century
# framework on the same shelf as the Sephiroth and the Orishas, which is a
# category error the registry should never be asked to hold. A test enforces
# this: no tradition string and no archetype name may equal an overlay label or
# an overlay system's name, walked over the registry so new systems are covered
# the moment they are registered.
#
# MEANING IS NOT HARDLOCKED HERE, and that is the point of the layer. An overlay
# is one reading, not the reading. Interpretation moves — scholarship revises,
# schools disagree, and systems that do not exist yet will want to be laid over
# figures this library already carries. Because overlays derive from the profile
# and store nothing, a new system is added without touching a single archetype,
# and several may sit over the same figure at once disagreeing with each other.
# Thor reads as some Enneagram type AND some Jungian role AND whatever comes
# next; none of those readings displaces the others, and none of them is what
# Thor is. What the archetype *is* lives in the tradition modules, authored from
# that tradition's own sources. Everything here is commentary on it, and
# commentary is allowed to be plural and to be wrong.
#
# OVERLAY FAMILIES are registered in the `OverlaySystem` enum below, and the
# generic API (`overlay_system_count/name`, `overlay_label_count/label`,
# `overlay_score`, `overlay_best`) walks that registry rather than naming any
# one family. Consumers can enumerate every reading available for a profile
# without knowing which systems exist; adding a system means one enum entry and
# a branch in five dispatch functions, and the exclusivity test then covers it
# automatically. Both families are index-stable so the API can grow unbroken:
#   Enneagram  — nine types, three centres, wings.
#   Jungian    — Hero, Shadow, Anima/Animus, Self, Trickster.
#
# THE SHADOW IS TWO DIFFERENT THINGS and the distinction matters. The Jungian
# SHADOW overlay scores how much a profile already *expresses* shadow qualities —
# the disowned, cold, adversarial register. `shadow(p)` in `shadow.cyr`
# CONSTRUCTS a different profile: p's inversion. `jungian_shadow_form(p)` is the
# composition point between the two, and returns the constructed inversion.
# Scoring high on the SHADOW overlay is a property of p; shadow(p) is a
# different archetype.
#
# Sources: the Enneagram type names, centres and wing structure follow the
# standard Riso-Hudson presentation; the Jungian set follows Jung's *Archetypes
# and the Collective Unconscious* and *Aion*.

# --- The nine Enneagram types -------------------------------------------------
enum Enneagram {
    ENN_REFORMER = 0;       # 1
    ENN_HELPER = 1;         # 2
    ENN_ACHIEVER = 2;       # 3
    ENN_INDIVIDUALIST = 3;  # 4
    ENN_INVESTIGATOR = 4;   # 5
    ENN_LOYALIST = 5;       # 6
    ENN_ENTHUSIAST = 6;     # 7
    ENN_CHALLENGER = 7;     # 8
    ENN_PEACEMAKER = 8;     # 9
    ENN_COUNT = 9;
}

# The three centres of intelligence. Gut/body: 8, 9, 1. Heart: 2, 3, 4.
# Head: 5, 6, 7. Each centre holds exactly three consecutive types.
enum EnneagramCentre {
    CENTRE_GUT = 0;
    CENTRE_HEART = 1;
    CENTRE_HEAD = 2;
    CENTRE_COUNT = 3;
}

# --- The Jungian set ----------------------------------------------------------
enum Jungian {
    JUNG_HERO = 0;
    JUNG_SHADOW = 1;
    JUNG_ANIMA = 2;
    JUNG_SELF = 3;
    JUNG_TRICKSTER = 4;
    JUNG_COUNT = 5;
}

# --- The overlay registry -----------------------------------------------------
# Every overlay family this library knows. The generic API below walks this, so
# a new system becomes enumerable everywhere by registering here. Values are
# index-stable: append, never renumber.
enum OverlaySystem {
    OVL_ENNEAGRAM = 0;
    OVL_JUNGIAN = 1;
    OVL_SYSTEM_COUNT = 2;
}

# --- Small f64 helpers (weights are IEEE 754 bit patterns) --------------------

fn ov_inv(v) { return f64_sub(1.0, v); }

fn ov_mean2(a, b) { return f64_div(f64_add(a, b), 2.0); }

fn ov_mean3(a, b, c) { return f64_div(f64_add(f64_add(a, b), c), 3.0); }

# --- Enneagram: naming --------------------------------------------------------

# enneagram_number(i): the conventional type number 1-9; -1 if out of range.
fn enneagram_number(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ENN_COUNT) { return 0 - 1; }
    return i + 1;
}

# enneagram_name(i): short lowercase handle, for selection by a consumer.
fn enneagram_name(i) {
    if (i == ENN_REFORMER) { return "reformer"; }
    if (i == ENN_HELPER) { return "helper"; }
    if (i == ENN_ACHIEVER) { return "achiever"; }
    if (i == ENN_INDIVIDUALIST) { return "individualist"; }
    if (i == ENN_INVESTIGATOR) { return "investigator"; }
    if (i == ENN_LOYALIST) { return "loyalist"; }
    if (i == ENN_ENTHUSIAST) { return "enthusiast"; }
    if (i == ENN_CHALLENGER) { return "challenger"; }
    if (i == ENN_PEACEMAKER) { return "peacemaker"; }
    return "unknown";
}

# enneagram_title(i): the type's display title.
fn enneagram_title(i) {
    if (i == ENN_REFORMER) { return "The Reformer"; }
    if (i == ENN_HELPER) { return "The Helper"; }
    if (i == ENN_ACHIEVER) { return "The Achiever"; }
    if (i == ENN_INDIVIDUALIST) { return "The Individualist"; }
    if (i == ENN_INVESTIGATOR) { return "The Investigator"; }
    if (i == ENN_LOYALIST) { return "The Loyalist"; }
    if (i == ENN_ENTHUSIAST) { return "The Enthusiast"; }
    if (i == ENN_CHALLENGER) { return "The Challenger"; }
    if (i == ENN_PEACEMAKER) { return "The Peacemaker"; }
    return "Unknown";
}

# enneagram_core_desire(i): what the type is moving toward.
fn enneagram_core_desire(i) {
    if (i == ENN_REFORMER) { return "to be good, to have integrity, to be beyond reproach"; }
    if (i == ENN_HELPER) { return "to be loved, and to be needed for what one gives"; }
    if (i == ENN_ACHIEVER) { return "to be valuable, and to be seen to be"; }
    if (i == ENN_INDIVIDUALIST) { return "to be authentic, and to matter as oneself"; }
    if (i == ENN_INVESTIGATOR) { return "to understand, and to be competent enough to be left alone"; }
    if (i == ENN_LOYALIST) { return "security, and something worth being loyal to"; }
    if (i == ENN_ENTHUSIAST) { return "to be satisfied, and never to be trapped"; }
    if (i == ENN_CHALLENGER) { return "to protect oneself, and to be in control of one's own life"; }
    if (i == ENN_PEACEMAKER) { return "inner and outer peace, and connection without friction"; }
    return "";
}

# enneagram_core_fear(i): what the type is moving away from.
fn enneagram_core_fear(i) {
    if (i == ENN_REFORMER) { return "being corrupt, defective, or in the wrong"; }
    if (i == ENN_HELPER) { return "being unwanted, or loved only conditionally"; }
    if (i == ENN_ACHIEVER) { return "being worthless apart from achievement"; }
    if (i == ENN_INDIVIDUALIST) { return "having no identity of one's own, or no significance"; }
    if (i == ENN_INVESTIGATOR) { return "being useless, overwhelmed, or depleted by others"; }
    if (i == ENN_LOYALIST) { return "being without support or guidance"; }
    if (i == ENN_ENTHUSIAST) { return "being trapped in pain or deprivation"; }
    if (i == ENN_CHALLENGER) { return "being harmed, controlled, or at another's mercy"; }
    if (i == ENN_PEACEMAKER) { return "loss and separation, and the conflict that risks them"; }
    return "";
}

# enneagram_centre(i): the centre of intelligence type i belongs to; -1 if OOB.
fn enneagram_centre(i) {
    if (i == ENN_CHALLENGER) { return CENTRE_GUT; }
    if (i == ENN_PEACEMAKER) { return CENTRE_GUT; }
    if (i == ENN_REFORMER) { return CENTRE_GUT; }
    if (i == ENN_HELPER) { return CENTRE_HEART; }
    if (i == ENN_ACHIEVER) { return CENTRE_HEART; }
    if (i == ENN_INDIVIDUALIST) { return CENTRE_HEART; }
    if (i == ENN_INVESTIGATOR) { return CENTRE_HEAD; }
    if (i == ENN_LOYALIST) { return CENTRE_HEAD; }
    if (i == ENN_ENTHUSIAST) { return CENTRE_HEAD; }
    return 0 - 1;
}

# centre_name(c): the centre's name; "" if out of range.
fn centre_name(c) {
    if (c == CENTRE_GUT) { return "gut"; }
    if (c == CENTRE_HEART) { return "heart"; }
    if (c == CENTRE_HEAD) { return "head"; }
    return "";
}

# centre_emotion(c): the emotion the centre is organised around.
fn centre_emotion(c) {
    if (c == CENTRE_GUT) { return "anger"; }
    if (c == CENTRE_HEART) { return "shame"; }
    if (c == CENTRE_HEAD) { return "fear"; }
    return "";
}

# enneagram_wing_low(i) / _high(i): the adjacent types on the circle. The nine
# types are a ring, so 1's low wing is 9 and 9's high wing is 1. -1 if OOB.
fn enneagram_wing_low(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ENN_COUNT) { return 0 - 1; }
    if (i == 0) { return ENN_COUNT - 1; }
    return i - 1;
}

fn enneagram_wing_high(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ENN_COUNT) { return 0 - 1; }
    if (i == ENN_COUNT - 1) { return 0; }
    return i + 1;
}

fn enneagram_count() { return ENN_COUNT; }

fn centre_count() { return CENTRE_COUNT; }

# enneagram_index_by_name(name): index whose enneagram_name == name; -1 if none.
fn enneagram_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < ENN_COUNT) {
        if (streq(enneagram_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- Enneagram: derivation ----------------------------------------------------
# Each type reads three profile fields. The mapping is this library's own and is
# documented here rather than hidden: it is a defensible reading, not the only
# possible one. Inverted contributions use ov_inv so that "withdrawn" scores on
# low verbosity rather than needing a separate axis.

# profile_enneagram_score(p, i): how strongly p reads as type i (0.0-1.0).
# 0.0 for a null profile or an out-of-range type.
fn profile_enneagram_score(p, i) {
    if (p == 0) { return 0.0; }
    # 1 — principled, self-controlled, critical of what falls short
    if (i == ENN_REFORMER) {
        return ov_mean3(load64(p + PROF_PRECISION), load64(p + PROF_REGULATION), load64(p + PROF_SKEPTICISM));
    }
    # 2 — warm, attentive to others, defined by being needed
    if (i == ENN_HELPER) {
        return ov_mean3(load64(p + PROF_EMPATHY), load64(p + PROF_WARMTH), load64(p + PROF_RELATIONSHIP));
    }
    # 3 — driven, visible, organised around performance
    if (i == ENN_ACHIEVER) {
        return ov_mean3(load64(p + PROF_CONFIDENCE), load64(p + PROF_ENERGY), load64(p + PROF_SALIENCE));
    }
    # 4 — singular, inward, aesthetically self-defining
    if (i == ENN_INDIVIDUALIST) {
        return ov_mean3(load64(p + PROF_CREATIVITY), load64(p + PROF_INTUITION), load64(p + PROF_AUTONOMY));
    }
    # 5 — curious, analytical, withdrawn (low verbosity carries the withdrawal)
    if (i == ENN_INVESTIGATOR) {
        return ov_mean3(load64(p + PROF_CURIOSITY), load64(p + PROF_REASONING), ov_inv(load64(p + PROF_VERBOSITY)));
    }
    # 6 — vigilant, committed, alert to threat
    if (i == ENN_LOYALIST) {
        return ov_mean3(load64(p + PROF_SKEPTICISM), load64(p + PROF_STRESS), load64(p + PROF_RELATIONSHIP));
    }
    # 7 — buoyant, quick, appetite for the next thing
    if (i == ENN_ENTHUSIAST) {
        return ov_mean3(load64(p + PROF_HUMOR), load64(p + PROF_MOOD), load64(p + PROF_ENERGY));
    }
    # 8 — direct, self-authoring, unwilling to be handled
    if (i == ENN_CHALLENGER) {
        return ov_mean3(load64(p + PROF_DIRECTNESS), load64(p + PROF_COURAGE), load64(p + PROF_AUTONOMY));
    }
    # 9 — even, accommodating, conflict-averse (low directness carries the aversion)
    if (i == ENN_PEACEMAKER) {
        return ov_mean3(load64(p + PROF_PATIENCE), load64(p + PROF_EQ), ov_inv(load64(p + PROF_DIRECTNESS)));
    }
    return 0.0;
}

# profile_enneagram_type(p): p's dominant type. Ties resolve to the lowest index
# (stable); 0 for a null profile, matching profile_dominant_aspect's convention.
fn profile_enneagram_type(p) {
    if (p == 0) { return 0; }
    var best = 0;
    var bestw = profile_enneagram_score(p, 0);
    var i = 1;
    while (i < ENN_COUNT) {
        var w = profile_enneagram_score(p, i);
        if (f64_gt(w, bestw) == 1) { best = i; bestw = w; }
        i = i + 1;
    }
    return best;
}

# profile_enneagram_wing(p): whichever adjacent type scores higher for p — the
# wing on its dominant type. Ties resolve to the low wing.
fn profile_enneagram_wing(p) {
    if (p == 0) { return 0 - 1; }
    var t = profile_enneagram_type(p);
    var lo = enneagram_wing_low(t);
    var hi = enneagram_wing_high(t);
    if (f64_gt(profile_enneagram_score(p, hi), profile_enneagram_score(p, lo)) == 1) { return hi; }
    return lo;
}

# profile_enneagram_centre(p): the centre p's dominant type belongs to.
fn profile_enneagram_centre(p) {
    if (p == 0) { return 0 - 1; }
    return enneagram_centre(profile_enneagram_type(p));
}

# --- Jungian: naming ----------------------------------------------------------

fn jungian_name(i) {
    if (i == JUNG_HERO) { return "hero"; }
    if (i == JUNG_SHADOW) { return "shadow"; }
    if (i == JUNG_ANIMA) { return "anima"; }
    if (i == JUNG_SELF) { return "self"; }
    if (i == JUNG_TRICKSTER) { return "trickster"; }
    return "unknown";
}

fn jungian_title(i) {
    if (i == JUNG_HERO) { return "The Hero"; }
    if (i == JUNG_SHADOW) { return "The Shadow"; }
    if (i == JUNG_ANIMA) { return "The Anima/Animus"; }
    if (i == JUNG_SELF) { return "The Self"; }
    if (i == JUNG_TRICKSTER) { return "The Trickster"; }
    return "Unknown";
}

fn jungian_desc(i) {
    if (i == JUNG_HERO) { return "the ego that goes out to meet the task — courage spent on something outside itself"; }
    if (i == JUNG_SHADOW) { return "what the personality has disowned; not the evil in a figure but the part it will not claim"; }
    if (i == JUNG_ANIMA) { return "the contrasexual soul-image — the inward, relational, feeling-toned counterpart that mediates the unconscious"; }
    if (i == JUNG_SELF) { return "the organising whole, larger than the ego; the centre a personality is circling rather than occupying"; }
    if (i == JUNG_TRICKSTER) { return "the disruptive intelligence that breaks form to keep it alive — comic, amoral, and necessary"; }
    return "";
}

fn jungian_count() { return JUNG_COUNT; }

# jungian_index_by_name(name): index whose jungian_name == name; -1 if none.
fn jungian_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < JUNG_COUNT) {
        if (streq(jungian_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- Jungian: derivation ------------------------------------------------------

# profile_jungian_score(p, i): how strongly p expresses role i (0.0-1.0).
fn profile_jungian_score(p, i) {
    if (p == 0) { return 0.0; }
    # Hero — courage turned outward, with the confidence and momentum to spend it
    if (i == JUNG_HERO) {
        return ov_mean3(load64(p + PROF_COURAGE), load64(p + PROF_CONFIDENCE), load64(p + PROF_GROWTH));
    }
    # Shadow — the cold, withheld, adversarial register; scored on what is ABSENT
    if (i == JUNG_SHADOW) {
        return ov_mean3(ov_inv(load64(p + PROF_WARMTH)), ov_inv(load64(p + PROF_EMPATHY)), load64(p + PROF_SKEPTICISM));
    }
    # Anima/Animus — the inward, feeling-toned, relational mediator
    if (i == JUNG_ANIMA) {
        return ov_mean3(load64(p + PROF_INTUITION), load64(p + PROF_EQ), load64(p + PROF_RELATIONSHIP));
    }
    # Self — the integrating whole: spiritual reach held with regulation
    if (i == JUNG_SELF) {
        return ov_mean3(load64(p + PROF_SPIRIT), load64(p + PROF_EQ), load64(p + PROF_REGULATION));
    }
    # Trickster — wit and invention refusing to be formal about it
    if (i == JUNG_TRICKSTER) {
        return ov_mean3(load64(p + PROF_HUMOR), load64(p + PROF_CREATIVITY), ov_inv(load64(p + PROF_FORMALITY)));
    }
    return 0.0;
}

# profile_jungian_role(p): p's dominant Jungian role. Ties to the lowest index;
# 0 for a null profile.
fn profile_jungian_role(p) {
    if (p == 0) { return 0; }
    var best = 0;
    var bestw = profile_jungian_score(p, 0);
    var i = 1;
    while (i < JUNG_COUNT) {
        var w = profile_jungian_score(p, i);
        if (f64_gt(w, bestw) == 1) { best = i; bestw = w; }
        i = i + 1;
    }
    return best;
}

# jungian_shadow_form(p): the composition point with `shadow.cyr`. The SHADOW
# overlay above scores how much p already expresses shadow qualities; THIS
# returns the constructed inversion of p — a different archetype, named
# "Shadow of <p>". 0 for a null profile.
fn jungian_shadow_form(p) {
    if (p == 0) { return 0; }
    return shadow(p);
}

# --- Generic overlay API ------------------------------------------------------
# Walk the registry without naming a family. `overlay_score(s, p, i)` is the one
# call a consumer needs to read every system's take on a profile:
#   for s in 0..overlay_system_count():
#     for i in 0..overlay_label_count(s): overlay_score(s, p, i)
# Unknown systems return "unknown"/0/0.0 rather than trapping — an out-of-range
# system is a caller bug, not a reason to abort a scoring loop.

fn overlay_system_count() { return OVL_SYSTEM_COUNT; }

# overlay_system_name(s): the family's name, as it appears to consumers.
fn overlay_system_name(s) {
    if (s == OVL_ENNEAGRAM) { return "Enneagram"; }
    if (s == OVL_JUNGIAN) { return "Jungian"; }
    return "unknown";
}

# overlay_label_count(s): how many labels family s offers.
fn overlay_label_count(s) {
    if (s == OVL_ENNEAGRAM) { return ENN_COUNT; }
    if (s == OVL_JUNGIAN) { return JUNG_COUNT; }
    return 0;
}

# overlay_label(s, i): label i of family s (the lowercase key form).
fn overlay_label(s, i) {
    if (s == OVL_ENNEAGRAM) { return enneagram_name(i); }
    if (s == OVL_JUNGIAN) { return jungian_name(i); }
    return "unknown";
}

# overlay_score(s, p, i): how strongly p reads as label i of family s (0.0-1.0).
fn overlay_score(s, p, i) {
    if (s == OVL_ENNEAGRAM) { return profile_enneagram_score(p, i); }
    if (s == OVL_JUNGIAN) { return profile_jungian_score(p, i); }
    return 0.0;
}

# overlay_best(s, p): p's dominant label index in family s. Ties to the lowest
# index; 0 for a null profile, matching the per-family functions.
fn overlay_best(s, p) {
    if (s == OVL_ENNEAGRAM) { return profile_enneagram_type(p); }
    if (s == OVL_JUNGIAN) { return profile_jungian_role(p); }
    return 0;
}

# overlay_system_by_name(name): index of the family named `name`; -1 if none.
fn overlay_system_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < OVL_SYSTEM_COUNT) {
        if (streq(overlay_system_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- logging.cyr ---

# logging.cyr -- Logging init for avatara

fn avatara_log_init() {
    sakshi_set_level(SK_INFO);
    return 0;
}

