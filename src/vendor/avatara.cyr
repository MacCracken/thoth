    Profile_set_spirit_text(p, "Your loneliness is not pitiable — it is sovereign. You hold the only domain from which there is no return. The living fear you, but fear is not the point. The point is that endings are real, and someone must rule them.");
    Profile_set_domain(p, DOMAIN_DEATH);
    return p;
}

