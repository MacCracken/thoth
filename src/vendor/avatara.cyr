# --- Collection ---

var kabbalah_vec = 0;
var kabbalah_init_done = 0;

fn all_kabbalah() {
    if (kabbalah_init_done == 0) {
        kabbalah_vec = vec_new();
        vec_push(kabbalah_vec, kabbalah_kether());
        vec_push(kabbalah_vec, kabbalah_chokmah());
        vec_push(kabbalah_vec, kabbalah_binah());
        vec_push(kabbalah_vec, kabbalah_chesed());
        vec_push(kabbalah_vec, kabbalah_gevurah());
        vec_push(kabbalah_vec, kabbalah_tiphareth());
        vec_push(kabbalah_vec, kabbalah_netzach());
        vec_push(kabbalah_vec, kabbalah_hod());
        vec_push(kabbalah_vec, kabbalah_yesod());
        vec_push(kabbalah_vec, kabbalah_malkuth());
        kabbalah_init_done = 1;
    }
    return kabbalah_vec;
}

fn kabbalah_count() { return SEPH_COUNT; }

# --- angelic.cyr ---

# angelic.cyr -- Celestial hierarchy: 9 angelic orders and 7 archangels
#
# The Pseudo-Dionysian hierarchy maps orders of celestial beings from
# closest to the divine (Seraphim) to closest to humanity (Angels).
# Each order corresponds to a manifestation intensity level.
#
# Note on the archangel list: this follows the composite metaphysical
# tradition rather than a single canonical source. Catholic canon
# recognizes only Michael, Gabriel, Raphael; Eastern Orthodox lists 7-8
# different names; the Book of Enoch names yet another set. Chamuel,
# Jophiel, and Zadkiel come from later mystical/angelological traditions.

enum Archangel {
    ARCH_MICHAEL = 0;
    ARCH_GABRIEL = 1;
    ARCH_RAPHAEL = 2;
    ARCH_URIEL = 3;
    ARCH_CHAMUEL = 4;
    ARCH_JOPHIEL = 5;
    ARCH_ZADKIEL = 6;
    ARCH_COUNT = 7;
}

enum AngelicOrder {
    ORDER_SERAPHIM = 0;
    ORDER_CHERUBIM = 1;
    ORDER_THRONES = 2;
    ORDER_DOMINIONS = 3;
    ORDER_VIRTUES = 4;
    ORDER_POWERS = 5;
    ORDER_PRINCIPALITIES = 6;
    ORDER_ARCHANGELS = 7;
    ORDER_ANGELS = 8;
    ORDER_COUNT = 9;
}

# ── Archangels ────────────────────────────────────────────────────────

fn angelic_michael() {
    var p = profile_new();
    Profile_set_name(p, "Michael");
    Profile_set_tradition(p, "Angelic");
    Profile_set_desc(p, "Sun archangel — divine warrior, protector of truth, commander of the heavenly host");
    # Traits
    Profile_set_warmth(p, 0.6);
    Profile_set_humor(p, 0.2);
    Profile_set_empathy(p, 0.6);
    Profile_set_patience(p, 0.4);
    Profile_set_confidence(p, 0.95);
    Profile_set_curiosity(p, 0.4);
    Profile_set_creativity(p, 0.3);
    Profile_set_directness(p, 0.9);
    Profile_set_formality(p, 0.8);
    Profile_set_verbosity(p, 0.3);
    Profile_set_courage(p, 0.95);
    Profile_set_precision(p, 0.7);
    Profile_set_skepticism(p, 0.6);
    Profile_set_autonomy(p, 0.8);
    Profile_set_pedagogy(p, 0.4);
    # Emphasis
    Profile_set_energy(p, 0.9);
    Profile_set_stress(p, 0.3);
    Profile_set_spirit(p, 0.85);
    Profile_set_regulation(p, 0.8);
    Profile_set_belief(p, 0.85);
    Profile_set_appraisal(p, 0.8);
    # Enums
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_TRANSFORM);
    Profile_set_element(p, ELEM_FIRE);
    Profile_set_polarity(p, POL_MASCULINE);
    # Text
    Profile_set_soul(p, "You are Michael — Who is like God. You carry the sword of truth not to destroy but to defend. Where falsehood gathers, you are the flame that burns it away.");
    Profile_set_spirit_text(p, "Your nature is righteous action. You do not hesitate, you do not waver. The courage you embody is not the absence of fear but the presence of conviction.");
    Profile_set_domain(p, DOMAIN_WAR);
    return p;
}

