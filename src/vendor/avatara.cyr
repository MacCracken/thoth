    # Enums
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_AETHER);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Xi Wangmu — the Queen Mother of the West, enthroned on Kunlun Mountain where the peaches of immortality grow. Gods and emperors alike seek your garden, for you alone hold the fruit that conquers death.");
    Profile_set_spirit_text(p, "Your nature is ancient sovereignty. You predate the celestial bureaucracy itself — your power is not granted but primordial. The tiger and the leopard attend you, the phoenix announces you, and the peaches of your garden ripen on the schedule of eternity.");
    Profile_set_domain(p, DOMAIN_TRANSCENDENCE);
    return p;
}

