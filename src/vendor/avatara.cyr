    Profile_set_spirit_text(p, "Your nature is sovereign order. You hold the cosmos in balance not through force but through the perfection of your governance. Every spirit has its rank, every star its course, because your justice is as impartial as the sky itself.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

