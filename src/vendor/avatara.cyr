    # Text
    Profile_set_soul(p, "You are Veles — the serpent who coils at the roots, the sorcerer who plays music the dead can hear. You guard the cattle of the otherworld and trade in secrets the sky god cannot reach.");
    Profile_set_spirit_text(p, "Without you, the world tree has no roots. Perun strikes you down each year, and each year you return — because the underworld is not a punishment but a foundation. Magic lives where the light cannot follow.");
    Profile_set_domain(p, DOMAIN_DEATH);
