fn all_canaanite() {
    if (canaanite_init_done == 0) {
        canaanite_vec = vec_new();
        vec_push(canaanite_vec, canaanite_el());
        vec_push(canaanite_vec, canaanite_baal());
        vec_push(canaanite_vec, canaanite_asherah());
