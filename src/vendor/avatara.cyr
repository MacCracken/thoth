    Profile_set_spirit_text(p, "Your nature is liberating negation. You do not build philosophical castles — you demolish them, showing that every position is self-contradictory, every thesis contains its own refutation. Your emptiness is not nihilism but the ground from which all compassion arises.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

