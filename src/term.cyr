    return n;
}
# term_con_test: run the filter on a host. `tap` takes the bytes; 0 turns it off and puts everything back.
fn term_con_test(rows, cols, tap) {
    _tc_st = 0; _tc_row = 1; _tc_col = 1; _tc_alt = 0; _tc_bg = 0; _tc_rev = 0; _tc_car_r = 0; _tc_tapn = 0; _tc_outn = 0;
    _tc_tap = tap;
    if (tap == 0) { _term_con = 0; return 0; }
    term_con_geom(rows, cols);
    if (_tc_grid != 0) { memset(_tc_grid, 0, _tc_cells); }
    _term_con = 1;
    return 0;
}
fn term_con_taken() { return _tc_tapn; }

# term_caret: the frame's last word: the cursor rests where it was just moved. A terminal with a cursor needs no telling.
fn term_caret() {
    if (_term_con == 1) { emit_raw("\x1b[?7777h"); }
    return 0;
}

# term_out_init: before the first byte. A file or a pipe on fd 1 keeps every byte as it was written.
fn term_out_init() {
    #ifdef CYRIUS_TARGET_AGNOS
    var k = sys_fd_kind(1);
    if (k == FDK_CONSOLE) {
        var rr[8];
        var cc[8];
        store64(&rr, 0); store64(&cc, 0);
        if (tty_winsize(1, &rr, &cc) == 0) { term_con_geom(load64(&rr), load64(&cc)); }
        _term_con = 1;
    }
    if (k == FDK_CHAN) { _term_on_chan = 1; }
    #endif
    return 0;
}

# term_flush_input (0.53.3, S-3): discard what a terminal holds for reading: input typed before a prompt existed is not an
# answer to it. tcflush(TCIFLUSH) on Linux, TIOCFLUSH(FREAD) on Darwin (no termios there, but the ioctl stands). A pipe is left
# alone: piped lines are scripted answers. AGNOS has CM_FLUSH for the console's line (0.55.2), and the keys in hand are drained
# the same way. Windows has neither call, and no type-ahead to speak of.
fn term_flush_input() {
    if (_term_src != TERM_SRC_NONE) { term_key_drain(); return 1; }
    #ifdef CYRIUS_TARGET_AGNOS
    if (tty_flush_input(0) == 0) { return 1; }
    #endif
    #ifdef CYRIUS_TARGET_LINUX
    if (term_isatty(0) == 1) { syscall(SYS_IOCTL, 0, 0x540B, 0); return 1; }
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    if (term_isatty(0) == 1) {
        var w[8];
        store64(&w, 1);
        syscall(SYS_IOCTL, 0, 0x80047410, &w);
        return 1;
    }
    #endif
    return 0;
}

#ifdef CYRIUS_TARGET_MACOS
# macOS: darshana has no BSD termios peer, so raw/cooked/signalfd are honestly unavailable.
#
# `term_isatty` IS answered, because the mechanism is portable and only the REQUEST CODE differs:
# `TIOCGWINSZ` is `_IOR('t', 104, struct winsize)` = 0x40087468 on BSD/Darwin against Linux's 0x5413.
# The stdlib's `SYS_IOCTL` is already arch/OS-correct (29 on Darwin, 16/29 on Linux x86_64/aarch64), so
# the only per-OS datum is the request. Without this, every macOS run answers "not a tty" and degrades
# to PT_PLAIN — colourless output on a colour terminal, which is a WRONG answer rather than an absent
# capability. A `winsize` query that succeeds is the same evidence darshana's own two peers use.
var _TERM_TIOCGWINSZ_BSD = 0x40087468;

fn term_have() { return 0; }
fn term_can_probe() { return 1; }

fn term_isatty(fd) {
    var ws[8];
    if (syscall(SYS_IOCTL, fd, _TERM_TIOCGWINSZ_BSD, &ws) < 0) { return 0; }
    return 1;
}

# Real answer available on Darwin for the same reason `term_isatty` is: TIOCGWINSZ fills a
# `struct winsize { u16 ws_row, ws_col, ws_xpixel, ws_ypixel }` — identical layout to Linux's, so the
# row/col extraction below matches darshana's Linux peer byte for byte. Contract: 0 on success
# (rows/cols written through the out-pointers), -1 on failure.
fn term_winsize(fd, out_rows, out_cols) {
    var ws[8];
    store64(&ws, 0);
    if (syscall(SYS_IOCTL, fd, _TERM_TIOCGWINSZ_BSD, &ws) < 0) { return 0 - 1; }
    store64(out_rows, load8(&ws) | (load8(&ws + 1) << 8));
    store64(out_cols, load8(&ws + 2) | (load8(&ws + 3) << 8));
    return 0;
}

# -1 == "could not enter raw mode", the contract every caller already branches on (tui_loop degrades to
# repl_loop, tui_dispatch ends the session cleanly). Identical to darshana's AGNOS peer.
fn term_raw(fd) { return 0 - 1; }
fn term_raw_nonblock(fd) { return 0 - 1; }
fn term_raw_held() { return 0; }
# Idempotent success: raw was never entered, so there is no termios state to restore. Matches both of
# darshana's peers, whose Linux `tty_cooked` is likewise a no-op when not raw.
fn term_cooked() { return 0; }
fn term_open_signalfd(sigmask) { return 0 - 1; }
fn term_close_signalfd(fd, sigmask) { return 0; }
fn term_sigmask_winch() { return 0; }
#endif

#ifdef CYRIUS_TARGET_WIN
# Windows: no termios, no signalfd, and `syscall(SYS_IOCTL, ...)` is not among the numbers the Win
# reroute routes (it returns -ENOSYS), so there is no honest tty probe either — console mode is a
# GetConsoleMode/SetConsoleMode affair the floor does not expose. Everything refuses. The Windows lane
# remains gated on its ARCHITECTURAL floor gaps (IOCP for epoll, WaitOnAddress for futex); this module
# only makes sure thoth stops contributing avoidable undefined symbols to that report.
fn term_have() { return 0; }
fn term_can_probe() { return 0; }
fn term_isatty(fd) { return 0; }
fn term_winsize(fd, out_rows, out_cols) { return 0 - 1; }
fn term_raw(fd) { return 0 - 1; }
fn term_raw_nonblock(fd) { return 0 - 1; }
fn term_raw_held() { return 0; }
fn term_cooked() { return 0; }
fn term_open_signalfd(sigmask) { return 0 - 1; }
fn term_close_signalfd(fd, sigmask) { return 0; }
fn term_sigmask_winch() { return 0; }
#endif

#ifndef CYRIUS_TARGET_MACOS
#ifndef CYRIUS_TARGET_WIN
# Linux (x86_64 + aarch64) and AGNOS: darshana ships a real peer for BOTH. On Linux these are pure
# forwarders, and the generated code is identical to the pre-0.44.3 direct calls. Both capabilities
# report 1 — terminal control and the tty probe are genuinely available.
#
# AGNOS has its own arms for raw and the window size (0.55.2): darshana's `tty_raw` answers -1 by ruling
# and leaves the keys to the consumer, and its `tty_winsize` reads the console whatever the fd. `TTY_SIGMASK_WINCH`
# uses agnos's `1 << sig` set layout rather than Linux's `1 << (sig-1)`, and `term_sigmask_winch()` is a FUNCTION,
# not a re-exported constant, so the right per-target value is carried without this module duplicating either number.
fn term_have() { return 1; }
fn term_can_probe() { return 1; }
fn term_isatty(fd) { return tty_isatty(fd); }
# term_raw_nonblock (0.54.1): raw with reads that return at once: intr.cyr's poll mode. darshana's one raw slot, so term_cooked restores it,
# and term_raw switches back. _term_raw_on says which of the two to do: darshana does not publish it.
var _term_raw_on = 0;
fn term_raw_held() { return _term_raw_on; }
#ifndef CYRIUS_TARGET_AGNOS
fn term_winsize(fd, out_rows, out_cols) { return tty_winsize(fd, out_rows, out_cols); }
fn term_raw(fd) {
    var rc = tty_raw(fd);
    if (rc == 0) { _term_raw_on = 1; }
    return rc;
}
fn term_raw_nonblock(fd) { return tty_raw_nonblock(fd); }
fn term_cooked() { _term_raw_on = 0; return tty_cooked(); }
#endif
#ifdef CYRIUS_TARGET_AGNOS
# CH_WINSZ_GET#97 on `fd`: `(cols << 16) | rows`, or at most 0 for anything that is not a terminal end with a size. Op 7 by number:
# the cyrius peer is still filed (cyrius 2026-11-04-agnos-chan-winsz-ops-peer).
fn _term_chan_size(fd) { return syscall(97, 7, fd, 0, 0); }
# term_kernel_terminal: 1 when the kernel itself says `fd` is a terminal thoth can drive, with no TERM to say so: kybernet
# seeds none, and nothing else on a bare AGNOS would.
fn term_kernel_terminal(fd) {
    var k = sys_fd_kind(fd);
    if (k == FDK_CONSOLE) { return 1; }
    if ((k == FDK_CHAN) && (_term_chan_size(fd) > 0)) { return 1; }
    return 0;
}
fn term_winsize(fd, out_rows, out_cols) {
    if (sys_fd_kind(fd) == FDK_CHAN) {
        var w = _term_chan_size(fd);
        if (w <= 0) { return 0 - 1; }
        store64(out_rows, w & 0xFFFF);
        store64(out_cols, (w >> 16) & 0xFFFF);
        return 0;
    }
    var rc = tty_winsize(fd, out_rows, out_cols);
    if ((rc == 0) && (_term_con == 1)) { term_con_geom(load64(out_rows), load64(out_cols)); }
    return rc;
}
fn term_raw(fd) {
    if (_term_src == TERM_SRC_NONE) {
        if (term_kernel_terminal(fd) == 0) { return 0 - 1; }
        if (term_kernel_terminal(1) == 0) { return 0 - 1; }
        if (sys_fd_kind(fd) == FDK_CONSOLE) { _term_src = TERM_SRC_KBD; } else { _term_src = TERM_SRC_CHAN; }
    }
    _term_raw_on = 1;
    return 0;
}
fn term_raw_nonblock(fd) { return term_raw(fd); }
fn term_cooked() { _term_raw_on = 0; return 0; }           # the keys stay in hand: prompts read them with term_line_read
#endif
fn term_open_signalfd(sigmask) { return tty_open_signalfd(sigmask); }
fn term_close_signalfd(fd, sigmask) { return tty_close_signalfd(fd, sigmask); }
fn term_sigmask_winch() { return TTY_SIGMASK_WINCH; }
#endif
#endif
