}
fn _tc_ground(b) {
    if ((b >= 32) && (b < 127)) { return _tc_cell(b); }
    if (b == 27) { _tc_st = TC_ESC; return 0; }
    if (b >= 240) { _tc_st = TC_UTF8; _tc_need = 3; _tc_cp = b & 7; return 0; }
    if (b >= 224) { _tc_st = TC_UTF8; _tc_need = 2; _tc_cp = b & 15; return 0; }
    if (b >= 192) { _tc_st = TC_UTF8; _tc_need = 1; _tc_cp = b & 31; return 0; }
    if (b == 13) { _tc_col = 1; _tc_b(13); return 0; }
    if (b == 10) {
        if ((_tc_alt == 1) && (_tc_row >= _tc_rows)) { return 0; }   # the console would scroll the whole frame
        if (_tc_row < _tc_rows) { _tc_row = _tc_row + 1; }
        _tc_col = 1;
        _tc_b(10);
        return 0;
    }
    if (b == 8) {
        if (_tc_col > 1) { _tc_col = _tc_col - 1; _tc_note(_tc_row, _tc_col, 32); _tc_b(8); }
        return 0;
    }
    if (b == 9) {
        var n = 8 - ((_tc_col - 1) % 8);
        while (n > 0) { _tc_cell(32); n = n - 1; }
    }
    return 0;
}
fn _tc_feed(b) {
    if (_tc_st == TC_GROUND) { return _tc_ground(b); }
    if (_tc_st == TC_ESC) {
        _tc_st = TC_GROUND;
        if (b == 91) { _tc_st = TC_CSI; _tc_pn = 0; }
        elif ((b == 93) || (b == 80) || (b == 95) || (b == 94) || (b == 88)) { _tc_st = TC_STR; }
        elif (b == 55) { _tc_sr = _tc_row; _tc_sc = _tc_col; }
        elif (b == 56) { _tc_goto(_tc_sr, _tc_sc); }
        return 0;
    }
    if (_tc_st == TC_CSI) {
        if ((b >= 64) && (b <= 126)) { _tc_st = TC_GROUND; _tc_csi(b); return 0; }
        if (b == 27) { _tc_st = TC_ESC; return 0; }
        if (_tc_pn < TC_P_CAP) { store8(&_tc_pb + _tc_pn, b); _tc_pn = _tc_pn + 1; }
        return 0;
    }
    if (_tc_st == TC_STR) {
        if (b == 7) { _tc_st = TC_GROUND; }
        elif (b == 27) { _tc_st = TC_STR_ESC; }
