    return 0;
}
fn _tc_csi(f) {
    _tc_parse();
    if (_tc_priv == 63) {
        if ((f != 104) && (f != 108)) { return 0; }
        var set = 0;
        if (f == 104) { set = 1; }
        var j = 0;
        while (j < _tc_nc) { _tc_mode(load64(&_tc_nv + j * 8), set); j = j + 1; }
        return 0;
    }
    if (_tc_priv != 0) { return 0; }
    if (f == 109) { return _tc_sgr(); }
    if ((f == 72) || (f == 102)) { return _tc_goto(_tc_arg(0, 1), _tc_arg(1, 1)); }
    if (f == 75) {
        if ((_tc_alt == 1) && (_tc_arg(0, 0) == 0)) { _tc_el(); }
        return 0;
    }
    if (f == 74) {
        if (_tc_arg(0, 0) == 2) { _tc_clear(); }
        return 0;
    }
    if (_tc_alt == 0) { return 0; }                           # outside a frame the tracked cursor is a guess: ofmt_int writes past the filter
    if (f == 65) { return _tc_goto(_tc_row - _tc_arg(0, 1), _tc_col); }
    if (f == 66) { return _tc_goto(_tc_row + _tc_arg(0, 1), _tc_col); }
    if (f == 67) { return _tc_goto(_tc_row, _tc_col + _tc_arg(0, 1)); }
    if (f == 68) { return _tc_goto(_tc_row, _tc_col - _tc_arg(0, 1)); }
    if (f == 71) { return _tc_goto(_tc_row, _tc_arg(0, 1)); }
