    return 0;
}
fn _tc_mode(n, set) {
    if (n == TC_CARET) {
        if (set == 1) { _tc_caret(); }
        return 0;
    }
    if ((n != 1049) || (set == _tc_alt)) { return 0; }
    _tc_alt = set;
    _tc_s("\x1b[0m");
    _tc_bg = 0;
    _tc_rev = 0;
    _tc_row = 1;
    _tc_col = 1;
    return _tc_clear();
}
# _tc_sgr: the sequence goes through, and the kernel takes what it knows. Only reverse needs help, and the bookkeeping for EL.
fn _tc_sgr() {
    var rev = _tc_rev;
    var zero = 0;
    var i = 0;
    while (i < _tc_nc) {
        var p = load64(&_tc_nv + i * 8);
        if (p <= 0) { _tc_bg = 0; rev = 0; zero = 1; }
        elif ((p == 38) || (p == 48)) {
            if (p == 48) { _tc_bg = 1; }
            if (_tc_arg(i + 1, 0) == 5) { i = i + 2; }
            elif (_tc_arg(i + 1, 0) == 2) { i = i + 4; }
        }
        elif (p == 49) { _tc_bg = 0; }
        elif (((p >= 40) && (p <= 47)) || ((p >= 100) && (p <= 107))) { _tc_bg = 1; }
        elif (p == 7) { rev = 1; }
        elif (p == 27) { rev = 0; }
        i = i + 1;
    }
    _tc_b(27); _tc_b(91);
    i = 0;
    while (i < _tc_pn) { _tc_b(load8(&_tc_pb + i)); i = i + 1; }
    _tc_b(109);
    if (rev != _tc_rev) {
        if (rev == 1) { _tc_s(TC_INVERSE); _tc_bg = 1; }
        elif (zero == 0) { _tc_s("\x1b[39;49m"); _tc_bg = 0; }
        _tc_rev = rev;
