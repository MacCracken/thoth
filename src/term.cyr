}
fn _tc_arg(i, def) {
    if (i >= _tc_nc) { return def; }
    var v = load64(&_tc_nv + i * 8);
    if (v <= 0) { return def; }
    return v;
}
fn _tc_goto(r, c) {
    if (r < 1) { r = 1; }
    if (r > _tc_rows) { r = _tc_rows; }
    if (c < 1) { c = 1; }
    if (c > _tc_cols) { c = _tc_cols; }
    _tc_row = r;
    _tc_col = c;
    _tc_at(r, c);
    return 0;
}
fn _tc_clear() {
    _tc_s("\x1b[2J");
    if (_tc_grid != 0) { memset(_tc_grid, 0, _tc_cells); }
    _tc_car_r = 0;
    _tc_at(_tc_row, _tc_col);                                 # the kernel's clear homes its cursor, and ED does not
    return 0;
}
# _tc_el: EL as spaces, in the active background. On the default one only to the row's last inked cell: a repaint is every row.
fn _tc_el() {
    if (_tc_col > _tc_cols) { return 0; }
    var end = _tc_cols;
    if ((_tc_bg == 0) && (_tc_grid != 0)) {
        while ((end >= _tc_col) && (load8(_tc_grid_p(_tc_row, end)) == 0)) { end = end - 1; }
    }
    if (end < _tc_col) { return 0; }
    var c = _tc_col;
    while (c <= end) { _tc_note(_tc_row, c, 32); _tc_b(32); c = c + 1; }
    _tc_at(_tc_row, _tc_col);
    return 0;
}
fn _tc_caret_cell(r, c, sgr) {
    var ch = 32;
    var p = _tc_grid_p(r, c);
    if ((p != 0) && (load8(p) != 0)) { ch = load8(p); }
    _tc_at(r, c);
    _tc_s(sgr);
    _tc_b(ch);
    _tc_s("\x1b[0m");
    return 0;
}
# _tc_caret: the cursor has come to rest, so draw the one the console does not.
fn _tc_caret() {
    if (_tc_col > _tc_cols) { return 0; }
    if ((_tc_car_r != 0) && ((_tc_car_r != _tc_row) || (_tc_car_c != _tc_col))) { _tc_caret_cell(_tc_car_r, _tc_car_c, ""); }
    _tc_caret_cell(_tc_row, _tc_col, TC_INVERSE);
    _tc_car_r = _tc_row;
    _tc_car_c = _tc_col;
    _tc_bg = 0;
    _tc_rev = 0;
