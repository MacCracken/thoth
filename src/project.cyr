# thoth — project read/explore tools (0.23.0): model-invokable read_file + list_dir so the agent can SEE
# the codebase it was launched in (before this, its context was the prompt + persona + memory FACTS + tool
# results, and it could read code only via the user's @file mentions or the opt-in `shell` hammer).
#
# thoth-native SUBSTRATE (like /read, @file, the file tree, the shell tool) — NOT a spine fork; daimon MCP
# tools remain additional, never required. Advertised whenever the agentic loop is on ([hoosh].tools) and
# executed LOCALLY in src/agent.cyr's serial dispatch — never forwarded to daimon.
#
# SECURITY — the PROJECT JAIL. A *model*-invokable read is a new surface (a prompt-injection could tell the
# model to read ~/.ssh/id_rsa and leak it), unlike /read / @file where the *human* chose the path. So every
# path is jailed to the launch directory: absolute paths, a leading `~`, and any `..` path component are
# REFUSED. Reads then resolve relative to the process cwd (the project the user launched thoth in), confined
# to it + below. This is both the feature ("see THIS project") and the boundary ("can't escape to secrets").
# The jail is LEXICAL **plus** a link check: as of 0.39.0 `_project_no_symlink` (below) refuses a path any of
# whose components is a symlink. Through 0.38.6 it was lexical-only, and the symlink hole was recorded here as
# an accepted residual on the grounds that there was "no portable O_NOFOLLOW". The 0.39.0 audit measured that
# premise and found it stale — `lib/fs.cyr` ships a portable readlink-based `is_symlink` — and demonstrated
# the escape rather than arguing about it (a `-> /etc` link in the project returned /etc/hostname to the
# model). Closed on both the read and the write side.
# REMAINING RESIDUAL (documented, not faked): the separator/escape check is POSIX/AGNOS-correct ('/' + '..' +
# '~'); Windows backslash + drive-letter (`C:\`) paths would need extra handling when the `--win` lane ships
# (it is IOCP-gated and does not build today), and `is_symlink` returns 0 on Windows, so the link check is a
# no-op there — the PE lane must not be shipped without revisiting both.
#
# GRANTED READ ROOTS (0.23.1). The jail is the DEFAULT; the *user* (never the model) can widen it to additional
# absolute roots — a permission model like every other restriction. Grants come from config ([project].read_roots,
# and [project].vidya as a first-class grantable root so the agent can learn the latest Cyrius from vidya and
# return to the project) and from the `/allow <abs-path>` / `/allow vidya` command. A granted root MUST be an
# absolute path (leading '/', not just "/") — reads under it use absolute paths, so there is no relative-vs-cwd
# ambiguity. The read check (_project_read_ok) then accepts either a jailed in-project relative path OR an
# absolute path with no '..' component that sits under a granted root (prefix + '/'-boundary match). The model
# can only ever read where the *user* pointed it; it cannot grant itself a root (/allow is a slash command, not
# a tool). The 0.39.0 link check applies to granted roots too — a symlink inside a granted root is refused on
# the same footing as one inside the project.

var PROJECT_READ_CAP = 65536;    # max file bytes returned to the model (bounded, like the shell cap)
var PROJECT_LIST_CAP = 16384;    # max list_dir output bytes
var _project_read_buf = 0;
var _project_out_buf = 0;

var READ_ROOTS_MAX = 16;         # max user-granted read roots (0.23.1)
var _read_roots = 0;             # alloc(READ_ROOTS_MAX*8): array of owned cstr ptrs (absolute, trailing-'/'-stripped)
var _read_roots_n = 0;

# _project_no_dotdot: 1 if `path` has no `..` path component (start, or after a '/', followed by '/' or end);
# else 0. PURE. Reading past the NUL is safe — the byte after a NUL is 0, which ends the `..` test cleanly.
fn _project_no_dotdot(path) {
    var i = 0;
    var atstart = 1;                      # at a path-component boundary (start, or just after '/')
    while (load8(path + i) != 0) {
        if (atstart == 1) {
            if ((load8(path + i) == 46) && (load8(path + i + 1) == 46)) {   # ".."
                var after = load8(path + i + 2);
                if ((after == 0) || (after == 47)) { return 0; }            # a ".." component -> escape, refuse
            }
        }
        if (load8(path + i) == 47) { atstart = 1; } else { atstart = 0; }
        i = i + 1;
    }
    return 1;
}

# PROJECT_PATH_MAX: the longest path the symlink walk will consider. A path at or past this is REFUSED
# rather than truncated — failing closed, since a truncated prefix would test the wrong file.
var PROJECT_PATH_MAX = 4096;
var _proj_sym_buf = 0;        # reusable NUL-terminated prefix scratch for the component walk
var _proj_sym_str = 0;        # ONE reusable 16-byte Str header (data,len). `str_from` allocates a header per
                              # call and alloc is a no-free bump heap, so building one per component would
                              # leak 16 B × depth on every tool round; this is written in place instead.

# _project_no_symlink: 1 if NO path component of `path` is a symlink; else 0. NOT pure — one readlink(2)
# per component (via the stdlib's `is_symlink`, which is portable across linux/macos/agnos and returns 0
# on Windows, where the PE lane has no readlink wrapper).
#
# ⚠ THIS CLOSES THE JAIL'S LOAD-BEARING RESIDUAL. Through 0.38.6 the jail was purely LEXICAL — it refused
# `/`, `~` and `..`, and both this file and src/edit.cyr documented "a symlink INSIDE the project pointing
# outside is followed (no portable O_NOFOLLOW)" as an accepted risk. That acceptance was **measured and is
# no longer true**: `lib/fs.cyr` ships `is_symlink`, and the 0.39.0 audit demonstrated the escape rather
# than theorising it — a `_jailprobe -> /etc` symlink in the project made `read_file {"path":
# "_jailprobe/hostname"}` return the real contents of /etc/hostname, from outside the project, with the
# jail reporting the path as safe. The reachability is not exotic: the attacker does not need shell, only
# a symlink in a repository the user opens thoth in.
#
# Every component is tested, not just the last — `link/sub/file` escapes through `link` even though the
# final component is an ordinary file. The prefix is tested WITHOUT its trailing '/', because readlink on
# "link/" does not report the link itself.
#
# ⚠ 0.45.2 — THROUGH 0.45.1 ONLY THE FIRST COMPONENT WAS EVER TESTED. To test a prefix the walk writes a NUL where
# its '/' was, and it never put the '/' back — so every later prefix read as the FIRST component again. With
# `docs/link -> /etc`, `read_file docs/link/hostname` returned /etc's bytes and `search` walked through the link:
# the 0.39.0 escape, still open one directory down. Every test put its link at the first component. Found when a
# 0.45.2 break test of the granted-root skip below failed the wrong way. The '/' is restored after each test.
#
# ⚠ 0.45.2 — A GRANTED ROOT'S OWN PATH IS NOT RE-JUDGED. macOS ships /etc, /tmp and /var as symlinks into
# /private, so this walk refused everything under a granted `/etc` or `/tmp/x` as "a symlink": a grant that
# could never be used, on a supported target (found by the first native test run there). The operator named
# that path, so the components that spell it are skipped; every component BELOW the root is still tested,
# which is where a link planted in the tree would sit, and a relative in-project path is walked in full.
fn _project_no_symlink(path) {
    if (path == 0) { return 0; }
    var n = strlen(path);
    if (n == 0) { return 1; }
    if (n >= PROJECT_PATH_MAX) { return 0; }              # absurd path -> refuse, never truncate-and-test
    if (_proj_sym_buf == 0) { _proj_sym_buf = alloc(PROJECT_PATH_MAX + 1); }
    if (_proj_sym_str == 0) { _proj_sym_str = alloc(16); }
    if ((_proj_sym_buf == 0) || (_proj_sym_str == 0)) { return 0; }   # OOM -> fail CLOSED, never open
    var skip = 0;                                         # bytes of a granted root's own spelling (0 = none)
    if (load8(path) == 47) { skip = _project_granted_prefix_len(path); }
    var i = 0;
    while (i < n) {
        var c = load8(path + i);
        store8(_proj_sym_buf + i, c);
        if ((c == 47) || ((i + 1) == n)) {                # a component boundary, or the end of the path
            var plen = i + 1;
            if (c == 47) { plen = i; }                    # test "a/b", not "a/b/"
            if (plen > skip) {                            # skip the empty prefix of a leading '/', and a root's own path
                store8(_proj_sym_buf + plen, 0);
                store64(_proj_sym_str, _proj_sym_buf);
                store64(_proj_sym_str + 8, plen);
                if (is_symlink(_proj_sym_str) == 1) { return 0; }
                if (c == 47) { store8(_proj_sym_buf + plen, 47); }   # 0.45.2: put the '/' back for the next prefix
            }
        }
        i = i + 1;
    }
    return 1;
}

# _proj_comp_eq: 1 if the path component starting at `path + at` and ending at the next '/' or NUL equals
# the cstr `name`. PURE. Used by _project_sensitive to compare whole components, never substrings — a file
# called `.thothrc` or a directory `my.thoth.bak` must NOT match `.thoth`.
fn _proj_comp_eq(path, at, name) {
    var i = 0;
    while (load8(name + i) != 0) {
        if (load8(path + at + i) != load8(name + i)) { return 0; }
        i = i + 1;
    }
    var after = load8(path + at + i);                 # the component must END here
    if ((after == 0) || (after == 47)) { return 1; }
    return 0;
}

# _proj_basename: pointer to the last component of cstr `s` (past the final '/'), or 0. PURE.
fn _proj_basename(s) {
    if (s == 0) { return 0; }
    var last = s;
    var i = 0;
    while (load8(s + i) != 0) {
        if (load8(s + i) == 47) { last = s + i + 1; }
        i = i + 1;
    }
    return last;
}

# _proj_cfg_comp_eq: 1 if the component of `path` at `at` equals the BASENAME of the configured cstr
# `cfg`. A configured path may be relative (`.thoth_session`) or absolute (`/home/u/.thoth_session`), and
# the model can reach the same file by either form — a relative read from the launch cwd, or an absolute
# one under a granted read root — so the comparison is on the name, at any depth, in both forms.
fn _proj_cfg_comp_eq(path, at, cfg) {
    var bn = _proj_basename(cfg);
    if (bn == 0) { return 0; }
    if (load8(bn) == 0) { return 0; }                 # unset / trailing-slash -> never matches
    return _proj_comp_eq(path, at, bn);
}

# _project_sensitive: 1 if `path` names thoth's OWN state — its config, its `.thoth/` home, or a file the
# OPERATOR configured as thoth state — else 0. No I/O and no mutation; it does read the loaded config.
#
# ⚠ 0.43.2: THE LITERAL LIST WAS NOT THE WHOLE ANSWER. Until this release the rule was two hardcoded
# names, `.thoth` and `thoth.cyml`. But four of thoth's state files have OPERATOR-CHOSEN paths —
# `[tron].policy`, `[session].file`, `[history].file` and `[log].file` — and the committed template
# recommends project-relative values for all four (`tron-policy.toml`, `.thoth_session`,
# `.thoth_history`, `thoth-driver.log`), which put them squarely inside the model's read/write jail.
# Since `_proj_comp_eq` matches whole components by design, `.thoth_session` never matched `.thoth`.
# That is the same confused-deputy shape A-3 closed, reopened through configuration:
#   * `tron-policy.toml` — the model could read the exact allow/deny list constraining it, and with
#     `[edit].enabled` rewrite it; the operator's next `/reload` or restart makes the rewrite live.
#   * `.thoth_session` — the whole keyed conversation store in plaintext (the model's reasoning too, since
#     0.48.0). Reading it leaks other conversations; editing it injects attacker-authored turns that are
#     replayed as real history at the next launch (`sess_persist_init` in main.cyr and, since 0.48.0, gui_run),
#     i.e. an injection that survives `/reset`. A reasoning payload is cleaned again where it is read back
#     (the loader's RSN branch), since the window draws it.
#   * `.thoth_history` — may hold secrets the operator typed.
#   * `[toolpin].file` (0.51.1) — the trust record of every MCP tool definition: readable it names the
#     operator's hosts and tools, writable it re-baselines a swapped definition through thoth's own `edit`
#     (the store's digest catches a foreign editor, not the model's `edit` running as the operator). The
#     default `~/.thoth/toolpins` was covered by the `.thoth` component rule; a custom path was not.
# So the refusal is now data-driven off the same config that names the files.
#
# ⚠ THE CONFUSED-DEPUTY FIX (0.39.0, audit A-3). thoth's config lives at `.thoth/config.cyml`, and
# docs/examples tells the operator to put it at the REPO ROOT — which is exactly where thoth is launched,
# so it sat *inside* the project jail as an ordinary relative file. `read_file` carries NO t-ron gate (the
# jail is its only boundary, by design, since it is read-only and project-confined), and `[hoosh].tools`
# defaults on, so the tool is advertised by default. Net effect, DEMONSTRATED in the audit rather than
# argued: `read_file {"path":".thoth/config.cyml"}` returned `token = "…"` — thoth handing the model its
# own gateway bearer token, which a prompt-injected model can then exfiltrate through web_fetch or shell.
# The write side was worse: `.thoth/config.cyml` passed the *write* jail identically, so an `edit` could
# repoint `[hoosh].url` at an attacker host or flip `[shell].enabled`, and `/reload` makes it live —
# thoth's own security config, rewritable by the untrusted party it constrains.
#
# The rule is COMPONENT-WISE and applies at any depth, so it also covers the absolute-path form reachable
# under a user-granted read root (`/home/u/proj/.thoth/config.cyml`), not just the relative one.
#
# ⚠ THIS IS NOT A GENERAL SECRET FILTER, and must not be mistaken for one. It closes the specific
# confused-deputy hole where thoth leaks *its own* credentials. A project's other secrets (`.env`,
# `.git/config` with a tokenised remote, a private key checked into the tree) are still readable by the
# model — that is the operator's project and the jail's whole purpose is to let the agent see it.
# Redacting those is a different capability (output filtering) and is tracked as such, not faked here.
# The HUMAN is unaffected: `/read` and `@file` do not go through this jail, so the operator can still
# open their own config.
fn _project_sensitive(path) {
    if (path == 0) { return 1; }                      # unknown -> treat as sensitive (fail closed)
    var n = strlen(path);
    var at = 0;                                       # start of the current component
    var i = 0;
    while (i <= n) {
        var c = load8(path + i);
        if ((c == 47) || (c == 0)) {                  # end of a component
            if (i > at) {                             # skip empty components ("a//b", a leading '/')
                if (_proj_comp_eq(path, at, ".thoth") == 1) { return 1; }
                if (_proj_comp_eq(path, at, "thoth.cyml") == 1) { return 1; }
                if (_proj_cfg_comp_eq(path, at, config_tron_policy()) == 1) { return 1; }
                if (_proj_cfg_comp_eq(path, at, config_session_file()) == 1) { return 1; }
                if (_proj_cfg_comp_eq(path, at, config_history_file()) == 1) { return 1; }
                if (_proj_cfg_comp_eq(path, at, config_log_file()) == 1) { return 1; }
                if (_proj_cfg_comp_eq(path, at, config_toolpin_file()) == 1) { return 1; }   # 0.51.1: the pin store (the sweep's finding)
            }
            at = i + 1;
        }
        if (c == 0) { i = n + 1; } else { i = i + 1; }
    }
    return 0;
}

# _project_jail_ok: 1 if `path` is safe to read within the project — a RELATIVE path with no `..` component
# and no leading `/` or `~`; else 0. PURE (the in-project half of the read boundary).
fn _project_jail_ok(path) {
    if (path == 0) { return 0; }
    var c0 = load8(path);
    if (c0 == 0) { return 0; }            # empty
    if (c0 == 47) { return 0; }           # absolute "/..."
    if (c0 == 126) { return 0; }          # "~..." (home)
    return _project_no_dotdot(path);
}

# project_grant_root: grant read access to an absolute root `path` (from config or `/allow`). Returns 1 on
# grant, 0 if rejected — a root MUST be absolute (leading '/') and more than just "/" (granting "/" would
# defeat the jail entirely), and the table is bounded to READ_ROOTS_MAX. Trailing '/'-s are stripped; exact
# duplicates are ignored (counted as already-granted -> 1). The stored copy is owned (bump-alloc'd).
fn project_grant_root(path) {
    if (path == 0) { return 0; }
    if (load8(path) != 47) { return 0; }          # must be absolute
    var len = strlen(path);
    while ((len > 1) && (load8(path + len - 1) == 47)) { len = len - 1; }   # strip trailing '/'
    if (len < 2) { return 0; }                    # reject "" and "/" (too broad)
    if (_read_roots == 0) { _read_roots = alloc(READ_ROOTS_MAX * 8); }
    var i = 0;                                     # dedup: same stripped prefix already granted?
    while (i < _read_roots_n) {
        var r = load64(_read_roots + i * 8);
        if ((strlen(r) == len) && (_project_prefix_eq(r, path, len) == 1)) { return 1; }
        i = i + 1;
    }
    if (_read_roots_n >= READ_ROOTS_MAX) { return 0; }
    var buf = alloc(len + 1);
    var k = 0;
    while (k < len) { store8(buf + k, load8(path + k)); k = k + 1; }
    store8(buf + len, 0);
    store64(_read_roots + _read_roots_n * 8, buf);
    _read_roots_n = _read_roots_n + 1;
    return 1;
}

# _project_prefix_eq: 1 if the first `n` bytes of `a` and `b` are equal; else 0. PURE.
fn _project_prefix_eq(a, b, n) {
    var k = 0;
    while (k < n) {
        if (load8(a + k) != load8(b + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# _project_under_root: 1 if absolute `path` sits under a granted root — path == root, or path begins with
# root followed by a '/' boundary (so "/a/b" is under "/a" but "/ab" is not). PURE.
fn _project_under_root(path) {
    var i = 0;
    while (i < _read_roots_n) {
        var r = load64(_read_roots + i * 8);
        var rl = strlen(r);
        if (_project_prefix_eq(path, r, rl) == 1) {
            var b = load8(path + rl);
            if ((b == 0) || (b == 47)) { return 1; }     # exact match, or a '/'-boundary below the root
        }
        i = i + 1;
    }
    return 0;
}

# _project_granted_prefix_len (0.45.2): the byte length of the LONGEST granted root that absolute `path` sits under
# (path == root, or root then a '/'), else 0. PURE. The symlink walk skips that many bytes of components.
fn _project_granted_prefix_len(path) {
    var best = 0;
    var i = 0;
    while (i < _read_roots_n) {
        var r = load64(_read_roots + i * 8);
        var rl = strlen(r);
        if ((rl > best) && (_project_prefix_eq(path, r, rl) == 1)) {
            var b = load8(path + rl);
            if ((b == 0) || (b == 47)) { best = rl; }
        }
        i = i + 1;
    }
    return best;
}

# _project_read_ok: the read boundary for read_file / list_dir. 1 if `path` is either a jailed in-project
# relative path, OR an absolute path with no `..` component that sits under a user-granted root; else 0. PURE.
fn _project_read_ok(path) {
    if (path == 0) { return 0; }
    if (load8(path) == 0) { return 0; }
    if (_project_jail_ok(path) == 1) { return 1; }       # in-project relative (no /, ~, ..)
    if (load8(path) != 47) { return 0; }                 # not absolute (e.g. "~...") -> never a granted root
    if (_project_no_dotdot(path) == 0) { return 0; }     # no traversal, even under a granted root
    return _project_under_root(path);
}

# project_read_roots_count / project_read_root_at: surface the granted roots (for /allow, /state). PURE.
fn project_read_roots_count() { return _read_roots_n; }
fn project_read_root_at(i) {
    if (i < 0) { return 0; }
    if (i >= _read_roots_n) { return 0; }
    return load64(_read_roots + i * 8);
}

# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# WHERE AM I? — the launch directory, as a STRING FOR THE MODEL (0.44.1)
# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Through 0.44.0 the agent was handed file tools rooted at the launch cwd and was never TOLD what that
# directory was. That is not cosmetic. A session wired to a daimon that ALSO hosts a filesystem tool
# (bote's fs_read/fs_write, rooted at its own BOTE_FS_ROOT) is offered TWO read tools whose descriptions
# both say "the project root" and which resolve the SAME relative path in DIFFERENT trees. With nothing
# in the system prompt naming the actual directory, the model picks by advertisement order — daimon's
# registry is serialized first — and reads `src/tasks/health.js` out of the tool host's workspace rather
# than out of the project the operator launched thoth in. That was observed live against the dev stack:
# `fs_read {"path":"src/tasks/health.js"}` answered `cannot read
# /home/macro/.agnos-stack/workspace/src/tasks/health.js` while the file sat in the launch directory the
# whole time. thoth cannot re-root someone else's tool host, but it can say where IT is and which tools
# reach here — so it does, in the system prompt (project_prompt_clause) and in its own refusals
# (project_refuse_outside).
#
# ⚠ THIS IS DISPLAY STATE, NOT A JAIL INPUT. The value comes from $PWD, which the launching shell sets
# and which nothing here verifies against the real cwd. Every authorization decision stays with
# _project_jail_ok / _project_under_root, which are lexical relative-vs-absolute tests and never consult
# this value. A wrong or absent $PWD therefore mislabels a sentence; it can NEVER widen the jail. Do not
# "improve" this by feeding it into _project_read_ok — that would promote an environment variable the
# jail deliberately does not trust into a security boundary.

var _proj_root_disp = 0;         # cached cstr: the launch directory, or 0 when $PWD is unusable

# project_root_display: the launch directory as an absolute cstr, or 0. DISPLAY/PROMPT ONLY (see above).
fn project_root_display() {
    if (_proj_root_disp != 0) { return _proj_root_disp; }
    var p = getenv("PWD");
    if (p == 0) { return 0; }
    if (load8(p) != 47) { return 0; }        # not absolute -> not a usable label; say nothing rather than guess
    _proj_root_disp = p;
    return _proj_root_disp;
}

# _proj_dir_label: write the last component of the ABSOLUTE path `path` into dst (bounded by cap, NUL-terminated)
# and return its length — 0 for no label: a null or relative path, the root "/" itself, or a path ending in '/'
# (a trailing slash names no component; say nothing rather than guess). PURE.
#
# ⚠ SANITISED (safe_label_copy) because a directory name is untrusted bytes about to be drawn as chrome: the TUI
# status bar writes it straight to the terminal, and an archive can unpack a directory whose name carries an escape.
fn _proj_dir_label(dst, cap, path) {
    store8(dst, 0);
    if (path == 0) { return 0; }
    if (load8(path) != 47) { return 0; }
    var bn = _proj_basename(path);
    if (bn == 0) { return 0; }
    if (load8(bn) == 0) { return 0; }
    return safe_label_copy(dst, cap, bn);
}

# project_dir_name (0.45.0): the launch directory's name — the status bar's lead, beside the git branch. DISPLAY
# ONLY: it derives from project_root_display, so that function's $PWD warning applies verbatim (a wrong $PWD
# mislabels the bar; nothing may ever feed this into a jail decision). 0 when there is no usable label, and the bar
# then omits the field (ADR-0010). Resolved ONCE — thoth never leaves its launch directory, and the bar asks on
# every paint, so an unusable $PWD must not cost a fresh buffer each time.
var PROJ_DIR_NAME_CAP = 256;
var _proj_dir_name = 0;
var _proj_dir_name_done = 0;
fn project_dir_name() {
    if (_proj_dir_name_done == 0) {
        _proj_dir_name_done = 1;
        var buf = alloc(PROJ_DIR_NAME_CAP);
        if (_proj_dir_label(buf, PROJ_DIR_NAME_CAP, project_root_display()) > 0) { _proj_dir_name = buf; }
    }
    return _proj_dir_name;
}

# _proj_is_project_abs: 1 when `path` is an ABSOLUTE path naming the launch directory or something below
# it. Used ONLY to WORD a refusal — never to grant one. See the warning above.
fn _proj_is_project_abs(path) {
    if (path == 0) { return 0; }
    if (load8(path) != 47) { return 0; }
    var r = project_root_display();
    if (r == 0) { return 0; }
    var rl = strlen(r);
    if (rl == 0) { return 0; }
    if (_project_prefix_eq(path, r, rl) == 0) { return 0; }
    var b = load8(path + rl);
    if ((b == 0) || (b == 47)) { return 1; }
    return 0;
}

var PROJ_MSG_CAP = 1024;
var _proj_msg_buf = 0;

# project_refuse_outside: the "outside the jail" refusal for read_file / list_dir / search, worded so the
# model can FIX the call on its next round instead of repeating it. The old message said only "path is
# outside the project", which is actively MISLEADING for the most common mistake — an absolute path
# naming a file that is in this very project (the jail takes project paths relative and absolute ones
# only under a /allow-granted root, so the correct absolute spelling of an in-project file is refused).
# A model told "outside the project" about a file it can see in a listing has no move left; a model told
# the relative path to retry with does. The suggestion is derived from the same lexical prefix test, and
# grants nothing — the retried call is re-checked from scratch.
fn project_refuse_outside(tool, path) {
    if (_proj_msg_buf == 0) { _proj_msg_buf = alloc(PROJ_MSG_CAP); }
    var cap = PROJ_MSG_CAP;
    var off = 0;
    off = _append_cstr_cap(_proj_msg_buf, off, cap, "(");
    off = _append_cstr_cap(_proj_msg_buf, off, cap, tool);
    off = _append_cstr_cap(_proj_msg_buf, off, cap, ": refused - ");
    if (_proj_is_project_abs(path) == 1) {
        var rest = path + strlen(project_root_display());
        if (load8(rest) == 47) { rest = rest + 1; }
        if (load8(rest) == 0) { rest = "."; }             # the root itself -> the relative spelling is "."
        off = _append_cstr_cap(_proj_msg_buf, off, cap, "that path IS inside this project, but this tool takes a path RELATIVE to the project root. Retry with path=\"");
        off = _append_cstr_cap(_proj_msg_buf, off, cap, rest);
        off = _append_cstr_cap(_proj_msg_buf, off, cap, "\")");
    } else {
        off = _append_cstr_cap(_proj_msg_buf, off, cap, "path is outside the project and any user-granted read root. Give a path RELATIVE to the project root, with no leading '/', no '~' and no '..')");
    }
    store8(_proj_msg_buf + off, 0);
    return _proj_msg_buf;
}

var PROJ_CLAUSE_CAP = 1024;
var _proj_clause = 0;

# project_prompt_clause: the WORKSPACE clause of the system prompt — where this session is rooted, which
# tools reach it, and what shape their paths take. Folded into persona_system_prompt (session.cyr), the
# one place thoth's operating clause is assembled, so the CHILD context (src/subagent.cyr, which reuses
# that prompt verbatim) inherits it too rather than being the one agent that does not know where it is.
#
# The last sentence is the load-bearing one and it is deliberately hedged: thoth advertises whatever the
# tool host registers, and it does NOT know where someone else's fs_* tool is rooted. It knows only that
# such a tool is NOT the one jailed to this project, so the honest instruction is "prefer the tools that
# are", not a claim about a directory thoth cannot see.
fn project_prompt_clause() {
    if (_proj_clause != 0) { return _proj_clause; }
    _proj_clause = alloc(PROJ_CLAUSE_CAP);
    var cap = PROJ_CLAUSE_CAP;
    var off = 0;
    off = _append_cstr_cap(_proj_clause, off, cap, " You are working in ONE project");
    var r = project_root_display();
    if (r != 0) {
        off = _append_cstr_cap(_proj_clause, off, cap, ", rooted at ");
        off = _append_cstr_cap(_proj_clause, off, cap, r);
    }
    off = _append_cstr_cap(_proj_clause, off, cap, ". Read its files with read_file, list its directories with list_dir, and locate code in it with search - reach for search FIRST, it is far cheaper than walking directories one level at a time. Their 'path' argument is always RELATIVE to that root (\"src/tasks/health.js\"), never absolute, never starting with '~' or '..'. If the tool host also offers generic file tools (fs_read, fs_write and the like), they are rooted somewhere else and will quietly read or write the WRONG tree - use read_file/list_dir/search for anything belonging to this project.");
    store8(_proj_clause + off, 0);
    return _proj_clause;
}

# --- the project map (0.50.0, F5) -----------------------------------------------------------------------------
# A lightweight directory overview for the system prompt, so the agent knows the shape of the tree it stands in
# without spending a round on list_dir: the top two levels of the launch root — every top-level entry (dirs first,
# byte order, `/`-suffixed), each top-level directory with up to PMAP_DIR_NAMES of its children and "+N more" —
# into its own bounded buffer, NUL-terminated, with an explicit marker when the cap bites (every other bound in
# this file announces itself). Directories the search tool never walks (_search_skip_dir: .git, build,
# node_modules, target, …) and dot-directories are NAMED but not walked ("(not walked)"), so the agent knows
# `target/` exists without 3000 lines of it; thoth's own files (_project_sensitive: `.thoth`, the session /
# history / policy / log files) are omitted, as the tools refuse them. Names ride RAW — the JSON emitter escapes
# control bytes on the wire — and nothing here is drawn as chrome (/state prints only the counts).
#
# Built PER TURN at the three turn sites (hoosh_send, agent_turn, cmd_dry — project_map_refresh) so a file the
# agent created last turn is on the map this turn, never mid-turn (the delegated child reuses the parent's map
# — a tool round must not rewrite what the request builders read; the subagent swap-set rule). The walk is
# alloc-free: dir_list_into into caller-owned buffers, ONE reusable Str header for every path handed to the
# stdlib (str_from allocates a header per call), a stack path scratch — a per-turn walk must not grow the
# never-freeing heap. Entries are probed with _pmap_is_dir (an O_NONBLOCK open + getdents), never is_dir's
# blocking open: a FIFO in the tree would otherwise hang every turn before its request left. The walk stops
# the moment the cap bites (nothing is probed for a map that cannot hold it), and a name goes in whole or not
# at all (never a cut inside a multi-byte name); control bytes in a name read as '?' (a checked-in name with a
# newline must not forge a map line in a SYSTEM message). The builders read project_map_current(), which is 0
# until a turn site refreshed it — the request goldens stay byte-identical in the suite, and [project].map =
# false leaves every request as it was (ADR-0010). The caps are constants in practice: every buffer is sized
# once at first use (a test may LOWER PROJ_MAP_CAP; raising any cap after the first build would overrun).
var PROJ_MAP_CAP = 2048;          # bytes of map text (NUL-terminated; a marker when it bites)
var PMAP_MAX_ENTRIES = 256;       # entries read per directory listing (a bigger one is cut: "+N more" cannot count past it)
var PMAP_NAMES_CAP = 8192;        # packed names per listing
var PMAP_DIR_NAMES = 12;          # children shown per top-level directory before "+N more"
var _pmap_buf = 0;                # alloc(PROJ_MAP_CAP): the map text
var _pmap_ctx = 0;                # what the builders emit: _pmap_buf after a refresh that produced a map, else 0
var _pmap_root = 0;               # TEST SEAM: the walk root; 0 = "." (the launch directory, like list_dir)
var _pmap_scratch = 0;            # alloc(4096): the getdents batch
var _pmap_names = 0; var _pmap_offs = 0;      # the top-level listing
var _pmap_names2 = 0; var _pmap_offs2 = 0;    # a child listing
var _pmap_order = 0; var _pmap_order2 = 0;   # alloc(PMAP_MAX_ENTRIES * 8) each: sort indices, top level / child
var _pmap_entries = 0;            # entries named on the last map (the /state count — only what reached the map)
var _pmap_truncated = 0;          # 1 when the last map hit PROJ_MAP_CAP
var _pmap_unmappable = 0;         # 1 when the last build could not list the root (the map is a notice)
var _pmap_bytes = 0;              # the last map's byte length
var _pmap_str = 0;                # ONE reusable 16-byte Str header for the stdlib calls (data, len)
var _pmap_pathbuf = 0;            # alloc(4096): "<root>/<name>" scratch
var _pmap_subbuf = 0;             # alloc(4096): the top-level dir being walked (the path scratch is reused by its sort)
var _pmap_flags = 0; var _pmap_cflags = 0;   # alloc(PMAP_MAX_ENTRIES) each: is_dir per entry, top level / child

fn _pmap_ensure() {
    if (_pmap_buf == 0) { _pmap_buf = alloc(PROJ_MAP_CAP); }
    if (_pmap_scratch == 0) { _pmap_scratch = alloc(4096); }
    if (_pmap_names == 0) { _pmap_names = alloc(PMAP_NAMES_CAP); _pmap_offs = alloc(PMAP_MAX_ENTRIES * 8); }
    if (_pmap_names2 == 0) { _pmap_names2 = alloc(PMAP_NAMES_CAP); _pmap_offs2 = alloc(PMAP_MAX_ENTRIES * 8); }
    if (_pmap_order == 0) { _pmap_order = alloc(PMAP_MAX_ENTRIES * 8); _pmap_order2 = alloc(PMAP_MAX_ENTRIES * 8); }
    if (_pmap_pathbuf == 0) { _pmap_pathbuf = alloc(4096); }
    if (_pmap_subbuf == 0) { _pmap_subbuf = alloc(4096); }
    if (_pmap_flags == 0) { _pmap_flags = alloc(PMAP_MAX_ENTRIES); _pmap_cflags = alloc(PMAP_MAX_ENTRIES); }
    if (_pmap_str == 0) { _pmap_str = alloc(16); }
    return 0;
}
# _pmap_s: the reusable Str header over a NUL-terminated cstr (the stdlib takes Str; str_from would alloc one
# header per call, per entry, per turn).
fn _pmap_s(cstr) { store64(_pmap_str, cstr); store64(_pmap_str + 8, strlen(cstr)); return _pmap_str; }
# _pmap_is_dir: 1 when `path` is a directory — an O_NONBLOCK open (a FIFO opens at once instead of blocking for
# a writer; a regular file opens too) and a getdents that only a directory answers. Mirrors lib/fs.cyr's
# is_dir minus the blocking open. AGNOS's open is the directory test itself (AO_DIRECTORY) and has no FIFOs.
# 0.50.1: the PE lane has no O_NONBLOCK (the map is absent there anyway — project_map_refresh clears it), so it
# keeps is_dir too: a raw O_* name is a portability claim, and this one turned the lane's tripwire red at 0.50.0.
fn _pmap_is_dir(cstr) {
    #ifdef CYRIUS_TARGET_AGNOS
    return is_dir(_pmap_s(cstr));
    #endif
    #ifdef CYRIUS_TARGET_WIN
    return is_dir(_pmap_s(cstr));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_WIN
    var fd = sys_open(cstr, O_RDONLY | O_NONBLOCK, 0);
    if (fd < 0) { return 0; }
    var sbuf[4096];
    var sbasep[8];
    store64(&sbasep, 0);
    var n = syscall(FSYS_GETDENTS64, fd, &sbuf, 4096, &sbasep);
    sys_close(fd);
    if (n >= 0) { return 1; }
    return 0;
    #endif
    #endif
}
fn _pmap_root_cstr() { if (_pmap_root != 0) { return _pmap_root; } return "."; }
# _pmap_path: "<dir>/<name>" into the scratch (bounded), returns the scratch. A dir of "." yields "./name".
fn _pmap_path(dir, name) {
    var off = _append_cstr_cap(_pmap_pathbuf, 0, 4096, dir);
    off = _append_cstr_cap(_pmap_pathbuf, off, 4096, "/");
    off = _append_cstr_cap(_pmap_pathbuf, off, 4096, name);
    store8(_pmap_pathbuf + off, 0);
    return _pmap_pathbuf;
}
# _pmap_list: list `dir` into (names, offs); returns the entry count (0 for an empty directory), -1 when the
# directory could not be opened, or -2 when it holds more than the listing caps (dir_list_into refuses a short
# read: never a confident partial picture) — the map names each case for what it is.
fn _pmap_list(dir, names, offs) {
    var n = dir_list_into(_pmap_s(dir), _pmap_scratch, 4096, names, PMAP_NAMES_CAP, offs, PMAP_MAX_ENTRIES);
    if (n == (0 - 1)) { return 0 - 1; }
    if (n < 0) { return 0 - 2; }
    return n;
}
# _pmap_sort: order[0..n) = indices into (names, offs), directories first, then byte order within each half —
# an insertion sort (n <= PMAP_MAX_ENTRIES) over a precomputed is_dir flag (one is_dir per entry, cached).
# `dir` is the listed directory (for the is_dir probe). Returns n.
fn _pmap_sort(dir, names, offs, n, flags, order) {
    var i = 0;
    while (i < n) {
        store8(flags + i, _pmap_is_dir(_pmap_path(dir, names + load64(offs + i * 8))));
        store64(order + i * 8, i);
        i = i + 1;
    }
    i = 1;
    while (i < n) {
        var cur = load64(order + i * 8);
        var j = i - 1;
        var go = 1;
        while ((j >= 0) && (go == 1)) {
            var prev = load64(order + j * 8);
            var before = 0;                                   # 1 when cur sorts before prev
            var dc = load8(flags + cur); var dp = load8(flags + prev);
            if (dc != dp) { if (dc == 1) { before = 1; } }
            else { if (strcmp_cstr(names + load64(offs + cur * 8), names + load64(offs + prev * 8)) < 0) { before = 1; } }
            if (before == 1) { store64(order + (j + 1) * 8, prev); j = j - 1; }
            else { go = 0; }
        }
        store64(order + (j + 1) * 8, cur);
        i = i + 1;
    }
    return n;
}
# _pmap_hidden: a dot-entry (a `.github/`, a `.env`) — named, never walked.
fn _pmap_hidden(name) { if (load8(name) == 46) { return 1; } return 0; }
# _pmap_put: append a cstr into the map WHOLE, or not at all — a cut inside a name would leave a partial entry
# (or half a multi-byte character) on the wire; when it does not fit, the truncation flag is set and the walk
# stops. 48 bytes stay reserved for the marker. Returns the new off. `clean` = 1 for a NAME from the disk:
# control bytes and DEL read as '?' — a name is a line of a SYSTEM message, and a checked-in name carrying a
# newline must not forge one (the map's own layout text goes in as written).
fn _pmap_put_n(off, s, clean) {
    if (_pmap_truncated == 1) { return off; }
    var n = strlen(s);
    if ((off + n) >= (PROJ_MAP_CAP - 48)) { _pmap_truncated = 1; return off; }
    var i = 0;
    while (i < n) {
        var b = load8(s + i);
        if (clean == 1) { if ((b < 32) || (b == 127)) { b = 63; } }
        store8(_pmap_buf + off + i, b);
        i = i + 1;
    }
    return off + n;
}
fn _pmap_put(off, s) { return _pmap_put_n(off, s, 0); }
fn _pmap_put_name(off, s) { return _pmap_put_n(off, s, 1); }
fn _pmap_put_int(off, n) {
    var b[24];
    var len = fmt_int_buf(n, &b);
    store8(&b + len, 0);
    return _pmap_put(off, &b);
}
# project_map_build: the map of `root` into _pmap_buf; returns its byte length, or 0 when the root lists
# nothing (no map — the builders then omit the message). PURE over the tree; I/O = the listings.
fn project_map_build(root) {
    _pmap_ensure();
    _pmap_entries = 0; _pmap_truncated = 0; _pmap_unmappable = 0; _pmap_bytes = 0;
    var n = _pmap_list(root, _pmap_names, _pmap_offs);
    if (n < 0) {                                                 # a bound that announces itself, never silence
        var eoff = 0;
        if (n == (0 - 1)) { eoff = _pmap_put(0, "Project map: the project root could not be listed - use list_dir and search.\n"); }
        else {
            eoff = _pmap_put(0, "Project map: the project root holds more entries than the map lists (past ");
            eoff = _pmap_put_int(eoff, PMAP_MAX_ENTRIES);
            eoff = _pmap_put(eoff, ") - use list_dir and search.\n");
        }
        store8(_pmap_buf + eoff, 0);
        _pmap_bytes = eoff; _pmap_unmappable = 1;
        return eoff;
    }
    if (n == 0) { store8(_pmap_buf, 0); return 0; }              # an empty root: nothing to map, no message
    var flags = _pmap_flags;
    var order_n = _pmap_sort(root, _pmap_names, _pmap_offs, n, flags, _pmap_order);
    var off = 0;
    if (config_hoosh_tools() == 1) { off = _pmap_put(0, "Project map (the top two levels of the project root; a name ending in / is a directory; use list_dir or search for the rest):\n"); }
    else { off = _pmap_put(0, "Project map (the top two levels of the project root; a name ending in / is a directory):\n"); }
    var files_started = 0;
    var k = 0;
    while ((k < order_n) && (_pmap_truncated == 0)) {           # the walk stops the moment the cap bites
        var idx = load64(_pmap_order + k * 8);
        var name = _pmap_names + load64(_pmap_offs + idx * 8);
        if (_project_sensitive(name) == 0) {                     # thoth's own files: not on the map, as the tools refuse them
            var line_start = off;                                # the entry lands whole or the line is rolled back
            var line_entries = _pmap_entries;
            if (load8(flags + idx) == 1) {
                off = _pmap_put_name(off, name); off = _pmap_put(off, "/");
                _pmap_entries = _pmap_entries + 1;
                if ((_search_skip_dir(name) == 1) || (_pmap_hidden(name) == 1)) { off = _pmap_put(off, "  (not walked)\n"); }
                elif (_project_no_symlink(_pmap_path(root, name)) == 0) { off = _pmap_put(off, "  (a symlink — not walked)\n"); }   # the jail never follows a link out of the project; neither does the map
                else {
                    var sub = _pmap_path(root, name);
                    var subcopy = _pmap_subbuf;                # _pmap_path's scratch is reused by the child sort
                    memcpy(subcopy, sub, strlen(sub) + 1);
                    var cn = _pmap_list(subcopy, _pmap_names2, _pmap_offs2);
                    if (cn == (0 - 1)) { off = _pmap_put(off, "  (could not be listed)\n"); }
                    elif (cn == (0 - 2)) { off = _pmap_put(off, "  (more entries than the map lists - list_dir)\n"); }
                    elif (cn == 0) { off = _pmap_put(off, "  (empty)\n"); }
                    else {
                        var cflags = _pmap_cflags;
                        var cn2 = _pmap_sort(subcopy, _pmap_names2, _pmap_offs2, cn, cflags, _pmap_order2);
                        off = _pmap_put(off, " ");
                        var c = 0;
                        var shown = 0;
                        while ((c < cn2) && (shown < PMAP_DIR_NAMES) && (_pmap_truncated == 0)) {
                            var cidx = load64(_pmap_order2 + c * 8);
                            var cname = _pmap_names2 + load64(_pmap_offs2 + cidx * 8);
                            if (_project_sensitive(cname) == 0) {
                                off = _pmap_put(off, " "); off = _pmap_put_name(off, cname);
                                if (load8(cflags + cidx) == 1) { off = _pmap_put(off, "/"); }
                                _pmap_entries = _pmap_entries + 1;
                                shown = shown + 1;
                            }
                            c = c + 1;
                        }
                        if (c < cn2) { off = _pmap_put(off, "  +"); off = _pmap_put_int(off, cn2 - c); off = _pmap_put(off, " more"); }
                        off = _pmap_put(off, "\n");
                    }
                }
            } else {
                if (files_started == 0) { files_started = 1; } else { off = _pmap_put(off, "  "); }
                off = _pmap_put_name(off, name);
                _pmap_entries = _pmap_entries + 1;
            }
            if (_pmap_truncated == 1) { off = line_start; _pmap_entries = line_entries; }   # a line that did not fit whole is not on the map
        }
        k = k + 1;
    }
    if ((files_started == 1) && (_pmap_truncated == 0)) { off = _pmap_put(off, "\n"); }
    if (_pmap_truncated == 1) {
        if (off > 0) { if (load8(_pmap_buf + off - 1) != 10) { store8(_pmap_buf + off, 10); off = off + 1; } }   # the marker on its own line
        off = _append_cstr_cap(_pmap_buf, off, PROJ_MAP_CAP, "... (map truncated at ");
        off = _append_int_cap(_pmap_buf, off, PROJ_MAP_CAP, PROJ_MAP_CAP);
        off = _append_cstr_cap(_pmap_buf, off, PROJ_MAP_CAP, " bytes)\n");
    }
    store8(_pmap_buf + off, 0);
    _pmap_bytes = off;
    return off;
}
# project_map_refresh: rebuild the map for this turn — or drop it when [project].map is off. Called at the turn
# sites; the builders read project_map_current() after it.
fn project_map_refresh() {
    #ifdef CYRIUS_TARGET_WIN
    project_map_clear(); return 0;                               # dir_list_into has no Windows arm: no map, no notice
    #endif
    if (config_project_map() == 0) { project_map_clear(); return 0; }
    if (project_map_build(_pmap_root_cstr()) > 0) { _pmap_ctx = _pmap_buf; } else { project_map_clear(); }
    return 0;
}
fn project_map_current() { return _pmap_ctx; }
fn project_map_entries() { return _pmap_entries; }
fn project_map_bytes() { return _pmap_bytes; }
fn project_map_truncated() { return _pmap_truncated; }
fn project_map_unmappable() { return _pmap_unmappable; }
fn project_map_clear() { _pmap_ctx = 0; _pmap_entries = 0; _pmap_bytes = 0; _pmap_truncated = 0; _pmap_unmappable = 0; return 0; }

# _proj_apc: append NUL-terminated cstr `s` into _project_out_buf at off, bounded. Returns the new off.
fn _proj_apc(off, s) {
    var i = 0;
    while ((load8(s + i) != 0) && (off < (PROJECT_LIST_CAP - 1))) { store8(_project_out_buf + off, load8(s + i)); off = off + 1; i = i + 1; }
    return off;
}

# read_file_tool: the agentic-loop tool (0.23.0). Extracts "path" from {"path":"..."}, jail-checks it,
# and returns the file's contents (bounded to PROJECT_READ_CAP) as a plain string for the model — or an
# honest error/refusal string. Rides /read's substrate (file_exists + file_read_all). No t-ron gate: the
# jail is the safety boundary (read-only, project-confined). Dispatched LOCALLY in src/agent.cyr.
fn read_file_tool(args_cstr) {
    if (args_cstr == 0) { return "(read_file: missing arguments)"; }
    var v = bayan_json_v_parse_buf(args_cstr, strlen(args_cstr));
    if (v == 0) { return "(read_file: arguments are not valid JSON)"; }
    var pv = bayan_json_v_obj_get(v, "path");
    if (pv == 0) { return "(read_file: missing required 'path' argument)"; }
    var ps = bayan_json_v_str(pv);
    if (ps == 0) { return "(read_file: 'path' must be a string)"; }
    var path = str_cstr(ps);
    if (_project_read_ok(path) == 0) { return project_refuse_outside("read_file", path); }
    if (_project_no_symlink(path) == 0) { return "(read_file: refused - a path component is a symlink; the jail does not follow links out of the project)"; }
    if (_project_sensitive(path) == 1) { return "(read_file: refused - that is thoth's own config/state, not project source)"; }
    if (is_dir(str_from(path)) == 1) { return "(read_file: that path is a directory - use list_dir)"; }
    if (file_exists(path) == 0) { return "(read_file: no such file)"; }
    if (_project_read_buf == 0) { _project_read_buf = alloc(PROJECT_READ_CAP + 1); }
    var n = file_read_all(path, _project_read_buf, PROJECT_READ_CAP);
    if (n < 0) { return "(read_file: could not read the file)"; }
    store8(_project_read_buf + n, 0);
    # ⚠ 0.44.3 — SAY WHEN IT IS A PREFIX. A file at or over the cap came back as an unmarked prefix, and
    # the model was told that WAS the file: it then reasons about a function it cannot see the end of,
    # reports a symbol as absent when it is on line 3000, or edits against a truncated view. Every other
    # bound in this tree announces itself when it bites (`search`, `shell`, the working set); this one
    # did not. Appending the marker is safe — the buffer is allocated at CAP+1 and the marker replaces
    # the tail of the content, so the note can never itself overflow.
    if (n >= PROJECT_READ_CAP) {
        var mk = "\n[... read_file: TRUNCATED — this is only the first ";
        var mo = PROJECT_READ_CAP - 96;
        if (mo < 0) { mo = 0; }
        mo = _append_cstr_cap(_project_read_buf, mo, PROJECT_READ_CAP, mk);
        mo = _append_int_cap(_project_read_buf, mo, PROJECT_READ_CAP, PROJECT_READ_CAP);
        mo = _append_cstr_cap(_project_read_buf, mo, PROJECT_READ_CAP, " bytes of a larger file]");
        store8(_project_read_buf + mo, 0);
    }
    return _project_read_buf;
}

# list_dir_tool: the agentic-loop tool (0.23.0). Extracts an optional "path" (default the project root),
# jail-checks it, and returns the directory's entries (one per line, "/"-suffixed for subdirectories),
# bounded to PROJECT_LIST_CAP. Rides the file tree's dir_list. No t-ron gate (jailed, read-only). LOCAL.
fn list_dir_tool(args_cstr) {
    var path = ".";
    if (args_cstr != 0) {
        var v = bayan_json_v_parse_buf(args_cstr, strlen(args_cstr));
        if (v != 0) {
            var pv = bayan_json_v_obj_get(v, "path");
            if (pv != 0) {
                var ps = bayan_json_v_str(pv);
                if (ps != 0) {
                    var pc = str_cstr(ps);
                    if (load8(pc) != 0) { path = pc; }    # non-empty override; else keep "."
                }
            }
        }
    }
    if (_project_read_ok(path) == 0) { return project_refuse_outside("list_dir", path); }
    if (_project_no_symlink(path) == 0) { return "(list_dir: refused - a path component is a symlink; the jail does not follow links out of the project)"; }
    if (_project_sensitive(path) == 1) { return "(list_dir: refused - that is thoth's own config/state, not project source)"; }
    var dirstr = str_from(path);
    if (is_dir(dirstr) == 0) { return "(list_dir: no such directory)"; }
    if (_project_out_buf == 0) { _project_out_buf = alloc(PROJECT_LIST_CAP); }
    var vv = dir_list(dirstr);
    var n = vec_len(vv);
    var off = 0;
    off = _proj_apc(off, path); off = _proj_apc(off, ":\n");
    var i = 0;
    while ((i < n) && (off < (PROJECT_LIST_CAP - 320))) {
        var e = vec_get(vv, i);
        off = _proj_apc(off, str_data(e));
        if (is_dir(path_join(dirstr, e)) == 1) { off = _proj_apc(off, "/"); }
        off = _proj_apc(off, "\n");
        i = i + 1;
    }
    if (i < n) { off = _proj_apc(off, "... (truncated)\n"); }
    store8(_project_out_buf + off, 0);
    return _project_out_buf;
}
