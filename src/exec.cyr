# thoth — local shell-escape substrate for /run.
#
# This is the driver's OWN local hands (a shell escape), NOT the daimon MCP
# tool-execution spine (which is an absent seam). It is ALWAYS invoked behind
# the t-ron-absent fail-closed confirm gate in cmd_run.
#
# run_shell executes `/bin/sh -c <cmdline>` via the PORTABLE process.cyr surface
# (process.cyr #ifdefs to the agnos sys_spawn and Windows CreateProcessW
# variants; POSIX fork/exec here). The child INHERITS thoth's stdout/stderr, so
# output streams live to the terminal and we return the REAL exit code (or
# (0 - 1) on spawn failure) — honest on every target, no capture-vs-empty
# ambiguity. Explicit argv (exec_vec form) per the CLAUDE.md "exec_vec, not
# sys_system" rule: the cmdline is the user's own, authorized this turn.
fn run_shell(cmdline) {
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, cmdline);
    var rc = exec_vec(args);
    exec_child_done();   # 0.44.2: the child owned the terminal — let the front end re-assert its modes
    return rc;
}

# --- the wait-loop tick seam (0.44.2) -----------------------------------------------------------------
# exec.cyr is SUBSTRATE and knows nothing about presentation. But its waitpid poll loop is the only place
# a running shell command hands the main thread back, so it is the only place the TUI's working indicator
# can advance while a command runs. Rather than reach up into the TUI (the layering the seams in
# src/seams.cyr exist to prevent), the loop calls an optional hook that main.cyr binds to spin_tick.
# Unbound — line REPL, one-shot, the GUI, every test binary — it is a null check.
var _exec_wait_tick = 0;
fn exec_wait_tick_set(fp) { _exec_wait_tick = fp; return 0; }

# The other half of the same seam: a hook fired after a child that SHARED thoth's terminal has exited, so
# the front end can re-assert the terminal modes that child may have cleared (main.cyr binds
# tui_modes_reassert). Only run_shell needs it — every other child in this tree redirects to a file.
var _exec_child_done = 0;
fn exec_child_done_set(fp) { _exec_child_done = fp; return 0; }
fn exec_child_done() { if (_exec_child_done != 0) { fncall0(_exec_child_done); } return 0; }

# --- timed, output-capturing shell exec (0.16.0; the model's `shell` tool backend) ---
#
# The /run escape above STREAMS to the terminal and returns only an exit code — fine for a
# human watching live. The agentic `shell` tool instead needs the OUTPUT back as a string to
# feed to the model, plus a wall-clock TIMEOUT so a runaway command can't hang the loop. There
# is no such primitive in the linked stdlib (lib/process.cyr's exec_capture has no timeout, and
# lib/regression.cyr's timed helpers are NOT in thoth's [deps].stdlib so they can't be called).
# So this COPIES regression.cyr's two proven patterns into thoth's own substrate module: a
# child-stdout/err -> TEMP-FILE redirect (avoids the pipe-fill deadlock a blocking read would
# hit, and PRESERVES partial output when the child is SIGKILLed) combined with a WNOHANG-poll-
# with-deadline + SIGKILL reap. This is raw substrate (shell exec owned by no AGNOS domain), so
# it lives here, not in lib/ (which is vendored) — "port the floor, never fork the spine".
#
# POSIX-only (fork/dup2/execve/waitpid-WNOHANG/kill + a per-arity sys_open/sys_unlink). AGNOS has
# no /bin/sh -c (sys_spawn takes a program path only) and no WNOHANG waitpid; Windows has no
# fork/exec — so the whole body is compiled out on those targets (exactly as lib/process.cyr
# guards its POSIX block) and shell_supported() reports 0 there so the tool is never advertised.

var _shell_tmp_ctr = 0;    # per-process monotonic counter — pid alone collides in a long-lived TUI
var _shell_tmp_buf = 0;    # lazily-allocated scratch for the temp path
var _shell_wbuf = 0;       # Windows-only: lazily-allocated 16 KiB UTF-16LE cmdline scratch, reused per call
                           # (a fresh alloc() per call would leak — alloc is a no-free bump heap; POSIX uses none)

# _exec_append_cstr: raw-copy NUL-terminated s into dst at off; return new off. Pure.
fn _exec_append_cstr(dst, off, s) {
    var i = 0;
    while (load8(s + i) != 0) { store8(dst + off, load8(s + i)); off = off + 1; i = i + 1; }
    return off;
}

# _shell_tmp_path: build a fresh /tmp/thoth_sh_<pid>_<counter> path (NUL-terminated) into the
# shared scratch and bump the counter. pid+counter is bounded and collision-resistant within one
# session (two shell calls share a pid). No RNG needed / available. Residual (documented, not
# faked): /tmp is world-writable and the frozen open ABI has no O_NOFOLLOW, so a pre-planted
# symlink at the path is a TOCTOU vector — mitigated best-effort by O_EXCL on create below.
fn _shell_tmp_path() {
    if (_shell_tmp_buf == 0) { _shell_tmp_buf = alloc(64); }
    var off = 0;
    off = _exec_append_cstr(_shell_tmp_buf, off, "/tmp/thoth_sh_");
    off = _append_int(_shell_tmp_buf, off, sys_getpid());
    store8(_shell_tmp_buf + off, 95); off = off + 1;         # '_'
    off = _append_int(_shell_tmp_buf, off, _shell_tmp_ctr);
    _shell_tmp_ctr = _shell_tmp_ctr + 1;
    store8(_shell_tmp_buf + off, 0);
    return _shell_tmp_buf;
}

#ifdef CYRIUS_TARGET_AGNOS
# AGNOS: no /bin/sh, no fork/exec/dup2, no WNOHANG waitpid, different sys_open/sys_unlink arity —
# so a capturing shell is architecturally impossible (the deferred-clipboard precedent). Announce,
# never fake: report unsupported (-3) and 0 bytes; shell_supported() returns 0 so it is unadvertised.
fn exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out) {
    store64(status_out, 0 - 3); store64(status_out + 8, 0); return 0;
}
fn shell_supported() { return 0; }
#endif
#ifdef CYRIUS_TARGET_WIN
# Windows (0.20.2): no fork/exec, but Cyrius 6.4.26 wired the timeout-kill primitive (TerminateProcess,
# syscall 0xF01D) behind lib/process_win.cyr's _win_create_process + _win_wait_timeout, so the model's
# `shell` tool now works on Windows via the SAME temp-file design as the POSIX path below — a FILE, never a
# pipe. A file has no writer backpressure, so the child runs to GENUINE completion (clean over-cap
# truncation) or a GENUINE hang (real deadline kill); the pipe path would deadlock/false-timeout any command
# whose output exceeds the ~4 KiB CreatePipe buffer, since the PE surface has no PeekNamedPipe / overlapped
# I/O / threads for concurrent draining (empirically confirmed on a real Windows host). Verified end-to-end
# on cass (2026-07-08): capture, merged stdout+stderr, exit codes, clean over-cap truncation, deadline
# TerminateProcess with the -2 sentinel, and partial-output-on-kill all correct.
#
# Divergences from POSIX + residuals (documented, never faked):
#   - Runs `cmd /s /c "<cmdline>"` with the environment INHERITED (wenv=0) so PATH reaches cmd.exe — unlike
#     the POSIX empty-envp, matching lib/process_win.cyr's exec_cmd convention; the UTF-16LE cmdline buffer
#     is a fixed 16 KiB, so a command exceeding ~8179 bytes is REJECTED fail-closed ({-1,0}, no spawn) rather
#     than overrunning the buffer (NOT silently truncated — _w_append_cstr has no cap).
#   - The temp file lives in the CURRENT WORKING DIRECTORY (the PE surface has no GetTempPathW), not /tmp; a
#     read-only CWD fails the create and degrades fail-CLOSED to {-1,0} (never a faked success). The open is
#     OPEN_ALWAYS without O_TRUNC (the reroute ignores it), so the best-effort pre-delete is the only stale-
#     content guard: in the extremely narrow case where a lingering file (below) is reconstructed by a later
#     run (pid reuse + the counter reset to 0) whose pre-delete ALSO fails on the still-live grandchild
#     handle, a shorter new capture could read new-front + stale-tail. Not reachable without that exact combo.
#   - No O_EXCL/O_NOFOLLOW (the CreateFileW reroute ignores them): collision resistance is getpid()+counter
#     name-uniqueness plus a best-effort pre-delete; a pre-planted name is a TOCTOU residual (lower risk than
#     /tmp — the CWD is the user's own project dir).
#   - No process-group kill (Win32 has no POSIX pgid on this surface; a Job Object is not wired): a timeout
#     TerminateProcess-es only the cmd.exe, so a detached grandchild (`start foo`, a backgrounded process)
#     can survive AND — holding the inherited temp-file handle — makes the post-kill DeleteFileW fail
#     (Windows can't delete a file with a live handle, unlike POSIX unlink), so that ONE temp file may linger
#     in the CWD until the grandchild exits. Best-effort cleanup; parallels the pre-0.20.1 POSIX single-child
#     behavior (the 0.20.1 kill(-pgid) group-kill has no Win32 equivalent on this surface).
#   - The reported exit code is the child's true UNSIGNED 32-bit Win32 exit code (masked to 32 bits), not the
#     POSIX 0..127 / 128+signal shape; -1 (spawn/open) and -2 (timeout) remain thoth's own sentinels.
#   - stdin is not redirected to a NUL device (_win_create_process wires only stdout+stderr): a command that
#     reads stdin may block until the deadline and be reported as an HONEST -2 timeout (never a wrong answer).
#
# The full thoth --win binary is still gated on the async/epoll->IOCP transport (lib/async.cyr); this
# capturing shell is proven via a minimal exec-only --win harness on cass and ships with the Windows binary
# the moment that gate lifts.

# _shell_tmp_path_win: a CWD-relative thoth_sh_<pid>_<counter>.tmp (no /tmp, no GetTempPathW). getpid() is
# lib/process_win.cyr's Windows self-pid (syscall 0xF01C) — NOT sys_getpid (POSIX-only). Reuses the shared
# _shell_tmp_buf/_shell_tmp_ctr + _exec_append_cstr/_append_int defined above the target #ifdefs.
fn _shell_tmp_path_win() {
    if (_shell_tmp_buf == 0) { _shell_tmp_buf = alloc(64); }
    var off = 0;
    off = _exec_append_cstr(_shell_tmp_buf, off, "thoth_sh_");
    off = _append_int(_shell_tmp_buf, off, getpid());
    store8(_shell_tmp_buf + off, 95); off = off + 1;              # '_'
    off = _append_int(_shell_tmp_buf, off, _shell_tmp_ctr);
    _shell_tmp_ctr = _shell_tmp_ctr + 1;
    off = _exec_append_cstr(_shell_tmp_buf, off, ".tmp");
    store8(_shell_tmp_buf + off, 0);
    return _shell_tmp_buf;
}

fn exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out) {
    store64(status_out, 0 - 1); store64(status_out + 8, 0);       # fail-closed default {-1, 0}
    var path = _shell_tmp_path_win();
    sys_unlink(path);                                            # best-effort pre-delete (reroute has no O_TRUNC)
    var out_fd = sys_open(path, 65, 0);                          # O_WRONLY|O_CREAT (1|64) -> CreateFileW OPEN_ALWAYS
    if (out_fd < 0) { return 0; }                               # status stays {-1, 0}
    var sh = syscall(0xF003, out_fd, 1, 1);                      # SetHandleInformation(h, HANDLE_FLAG_INHERIT, 1)
    if (sh == 0) { sys_close(out_fd); sys_unlink(path); return 0; }   # non-inheritable -> empty capture; fail closed
    # Bound the copy to the 16 KiB wbuf before writing: _w_append_cstr writes 2 bytes/char with NO cap, and the
    # `command` is model-supplied and only blob-bounded upstream. Static framing is 26 bytes (`cmd /s /c "` 22 +
    # `"` 2 + wide-NUL 2), so reject fail-closed ({-1,0}, no spawn) at >8179 cmdline bytes rather than OVERRUN
    # the buffer (heap corruption on the bump allocator). Caught by the 0.20.4 pre-cut adversarial review.
    if (((strlen(cmdline) * 2) + 26) > 16384) { sys_close(out_fd); sys_unlink(path); return 0; }
    if (_shell_wbuf == 0) { _shell_wbuf = alloc(16384); }        # reused per call (see the global; no per-call leak)
    var wbuf = _shell_wbuf;                                      # writable UTF-16LE `cmd /s /c "<cmdline>"`
    var wo = 0;
    wo = _w_append_cstr(wbuf, wo, "cmd /s /c \"");
    wo = _w_append_cstr(wbuf, wo, cmdline);
    wo = _w_append_cstr(wbuf, wo, "\"");
    _w_terminate(wbuf, wo);
    var pi[24];
    var ok = _win_create_process(wbuf, out_fd, 0, &pi);          # hStdOut=out_fd -> stdout+stderr; wenv=0 inherits env
    sys_close(out_fd);                                           # drop the parent copy AFTER CreateProcessW duped it
    if (ok == 0) { sys_unlink(path); return 0; }               # spawn fail -> {-1, 0}, remove the created file
    var killed[8];
    store64(&killed, 0);
    var ec = _win_wait_timeout(&pi, timeout_ms, &killed);        # deadline + TerminateProcess + reap + close handles
    if (load64(&killed) == 1) {
        store64(status_out, 0 - 2);                             # timeout-kill sentinel (matches POSIX -2)
        store64(status_out + 8, 1);
    } else {
        store64(status_out, ec & 0xFFFFFFFF);                   # true unsigned 32-bit Win32 exit code
        store64(status_out + 8, 0);
    }
    var total = file_read_all(path, buf, buflen);               # fresh O_RDONLY reopen; child exited & flushed
    sys_unlink(path);                                            # DeleteFileW (best-effort: fails if a grandchild holds it)
    if (total < 0) { total = 0; }
    return total;
}
fn shell_supported() { return 1; }
#endif

#ifndef CYRIUS_TARGET_AGNOS
#ifndef CYRIUS_TARGET_WIN
# exec_shell_capture: run `/bin/sh -c cmdline`, capturing merged stdout+stderr into buf[0..buflen)
# (a temp file under the hood), enforcing a wall-clock timeout. status_out points to TWO i64 slots:
#   [0] = exit code: 0..127 normal, 128+sig on a signal, -1 on spawn/open failure, -2 on timeout-kill
#   [1] = 1 if the command was SIGKILLed by the deadline, else 0
# Returns the number of bytes captured (>= 0; may be partial on timeout). The child runs with an
# EMPTY environment (the shell's compiled-in default PATH), matching /run's exec_vec convention;
# stdin is /dev/null so a command that reads input gets EOF instead of hanging until the timeout.
# The caller owns NUL-termination of buf at the returned count (buf must be >= buflen+1).
fn exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out) {
    # Open a fresh temp file with O_CREAT|O_EXCL|O_WRONLY (193), 0600 (384). O_EXCL fails on a
    # pre-planted file/symlink; bump the counter and retry a few times before giving up closed.
    #
    # ⚠ 0.39.0 (audit A-2): the mode was 0644 (420) — WORLD-READABLE, in world-writable /tmp, for a file
    # that holds the FULL merged stdout+stderr of a command the MODEL chose to run. On a multi-user host
    # any local user could read whatever that command printed (`env`, `cat ~/.aws/credentials`, a token in
    # a build log) for the lifetime of the capture. 0600 costs nothing here: thoth opens the fd itself and
    # dup2s it into the child, so nothing outside this process ever needs to open the path by name — the
    # extra bits bought no capability. Narrow (a local attacker, a shared box, a race) but free to close.
    var out_fd = 0 - 1;
    var path = 0;
    var tries = 0;
    while ((tries < 8) && (out_fd < 0)) {
        path = _shell_tmp_path();
        out_fd = sys_open(path, 193, 384);
        tries = tries + 1;
    }
    if (out_fd < 0) { store64(status_out, 0 - 1); store64(status_out + 8, 0); return 0; }

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(out_fd); sys_unlink(path);
        store64(status_out, 0 - 1); store64(status_out + 8, 0); return 0;
    }
    if (pid == 0) {
        # 0.20.1: put the shell in its OWN process group (leader pgid == child pid) BEFORE execve, so a
        # timeout can SIGKILL the whole group — the shell AND any backgrounded grandchild (`cmd &`) — via
        # kill(-pgid). Essential for the group-kill to be correct: without it the shell stays in thoth's
        # group and kill(-child_pid) would target a non-existent group (harmless) while a grandchild leaks.
        # setpgid(0,0) — Linux x86_64 syscall #109. DECLARED x86_64-ONLY: this whole POSIX path already uses
        # a raw x86_64 poll(#7) below, and the aarch64 lane ships size-gapped, so it never runs there. If the
        # aarch64 lane is ever un-gapped, BOTH numbers must become arch-conditional (aarch64 setpgid is #154,
        # #109 there is rseq; aarch64 has no poll(#7), only ppoll) — else the group-kill silently degrades to
        # the single-child kill and a backgrounded grandchild leaks.
        syscall(109, 0, 0);
        sys_dup2(out_fd, 1);            # stdout -> temp file
        sys_dup2(out_fd, 2);            # stderr -> same file (merged, as a terminal shows it)
        sys_close(out_fd);
        var dn = sys_open("/dev/null", 0, 0);   # 0 = O_RDONLY
        if (dn >= 0) { sys_dup2(dn, 0); sys_close(dn); }   # stdin <- /dev/null (no hang on read)
        var argv[40];                  # N BYTES: 4 ptrs (/bin/sh, -c, cmdline, NUL) = 32 B, headroom to 40
        store64(&argv,      "/bin/sh");
        store64(&argv + 8,  "-c");
        store64(&argv + 16, cmdline);  # the model's command flows as ONE argv element (no double-shell)
        store64(&argv + 24, 0);
        var envp[16];
        store64(&envp, 0);
        sys_execve("/bin/sh", &argv, &envp);
        sys_exit(127);
    }
    sys_close(out_fd);                  # parent's write copy; the child holds its own duped fds
    syscall(109, pid, pid);             # 0.20.1: parent-side setpgid(pid,pid) — closes the fork/setpgid race
                                        # (benign EACCES if the child already exec'd, since it self-set the group)

    var stbuf[4];                       # N BYTES: waitpid's status out-param is one 4-byte int (was [1];
                                        # both round to the 8B minimum frame slot so [1] was benign, but
                                        # [4] states the intent — matches lib/process.cyr's status_buf[4])
    var elapsed = 0;
    var reaped = 0;
    var code = 0;
    while ((elapsed < timeout_ms) && (reaped == 0)) {
        var w = sys_waitpid(pid, &stbuf, 1);          # 1 = WNOHANG
        if (w == pid) {
            var st = load32(&stbuf);
            if (WIFEXITED(st) == 1) { code = WEXITSTATUS(st); }
            elif (WIFSIGNALED(st) == 1) { code = 128 + WTERMSIG(st); }
            else { code = 0 - 1; }
            reaped = 1;
        } else {
            syscall(7, 0, 0, 100);                    # poll(NULL,0,100ms) — portable 100ms sleep
            elapsed = elapsed + 100;
            # 0.44.2: this loop is the ONE place a running shell command hands the main thread back, so it
            # is where the working indicator gets to move. Through the seam — exec.cyr is substrate and
            # must not reach into the TUI; main.cyr binds spin_tick. Unbound (line REPL, one-shot, GUI,
            # tests) it is a null check, so the floor is unchanged.
            if (_exec_wait_tick != 0) { fncall0(_exec_wait_tick); }
        }
    }
    var timed = 0;
    if (reaped == 0) {
        # 0.20.1: SIGKILL the whole PROCESS GROUP (negative pid), so a backgrounded grandchild dies with the
        # shell — then the shell DIRECTLY as a belt-and-suspenders (harmless ESRCH if the group kill already
        # reaped it, and it guarantees the shell dies even in the unlikely case setpgid did not take, so the
        # blocking reap below never hangs). The direct child is reaped here; grandchildren reparent to init.
        sys_kill(0 - pid, 9);                         # SIGKILL the process group (shell + grandchildren)
        sys_kill(pid, 9);                             # + the shell directly (defensive)
        sys_waitpid(pid, &stbuf, 0);                  # BLOCKING reap — no zombie
        timed = 1;
        code = 0 - 2;
    }
    store64(status_out, code);
    store64(status_out + 8, timed);

    var total = file_read_all(path, buf, buflen);     # whatever landed (partial on kill)
    sys_unlink(path);
    if (total < 0) { total = 0; }
    return total;
}
fn shell_supported() { return 1; }
#endif
#endif
