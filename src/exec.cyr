# thoth — local shell-escape substrate for /run.
#
# This is the driver's OWN local hands (a shell escape), NOT the daimon MCP
# tool-execution spine (which is an absent seam). It is ALWAYS invoked behind
# the t-ron-absent fail-closed confirm gate in cmd_run.

# exec_signals_init (0.52.9): SIGCHLD back to SIG_DFL, once, at startup. An ignored SIGCHLD survives execve, and under it
# the kernel reaps every child itself, so a wait finds nothing: a launcher that ignores it (`trap '' CHLD`) cost thoth
# every exit status. Since cyrius 6.6.7 the floor's `exec_*` answers -1 for that, so `/run` said "failed to spawn" over a
# command that had run; and the capture's wait, which only tests for its own pid, sat out its whole timeout. thoth keeps
# no handler of its own, so the default is simply correct. Linux and macOS: the other floors have no such state.
fn exec_signals_init() {
    #ifdef CYRIUS_TARGET_LINUX
    signal_default(SIGCHLD);
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    signal_default(SIGCHLD);
    #endif
    return 0;
}

# run_shell executes `/bin/sh -c <cmdline>` via the PORTABLE process.cyr surface
# (process.cyr #ifdefs to the agnos sys_spawn and Windows CreateProcessW
# variants; POSIX fork/exec here). The child INHERITS thoth's stdout/stderr, so
# output streams live to the terminal and we return the REAL exit code (or
# (0 - 1) on spawn failure) — honest on every target, no capture-vs-empty
# ambiguity. Explicit argv (exec_vec form) per the CLAUDE.md "exec_vec, not
# sys_system" rule: the cmdline is the user's own, authorized this turn.
fn run_shell(cmdline) {
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, cmdline);
    var rc = exec_vec(args);
    exec_child_done();   # 0.44.2: the child owned the terminal — let the front end re-assert its modes
    return rc;
}

# --- the wait-loop poll seam (0.44.2 a tick; 0.52.0 a poll, F7) ---------------------------------------
# exec.cyr is SUBSTRATE and knows nothing about presentation. But its waitpid poll loop is the only place
# a running command hands the main thread back, so it is the only place a front end can stay alive while
# one runs. Rather than reach up into a front end (the layering the seams in src/seams.cyr exist to
# prevent), the loop calls an optional hook the front end binds.
#
# Through 0.51 that hook was a void TICK bound to the TUI spinner, and nothing else ran: the window serviced
# no Wayland event for the length of a `shell` call, a hook, a [verify] check or a /run — no repaint, Esc
# ignored, the compositor's close ignored, a hung hook freezing the window until its timeout — and on
# neither surface could Esc stop the command. 0.52.0 makes it a surface-owned POLL: main.cyr binds the
# TUI's (tui_wait_poll: the spinner, and the tool phase's Esc drain), gui_run the window's (_gwait_poll:
# the Wayland pump, the repaint, Esc and close). The poll RETURNS the surface's stop generation (intr_seq —
# a number that moves when the operator asks to stop). The loop reads it as the child starts and, when it
# moves, kills the child's group exactly as the deadline does and reports -4 with the partial output.
# An EDGE, not the turn's level flag: a stop asked for before this command began does not cancel it.
# Unbound — every test binary that binds none — it is a null check; on a surface with no stop to offer
# the generation never moves, so the line REPL and one-shot are byte-identical.
var _exec_wait_poll = 0;
fn exec_wait_poll_set(fp) { _exec_wait_poll = fp; return 0; }

# The other half of the same seam: a hook fired after a child that SHARED thoth's terminal has exited, so
# the front end can re-assert the terminal modes that child may have cleared (main.cyr binds
# tui_modes_reassert). Only run_shell needs it — every other child in this tree has its output captured, away from the terminal.
var _exec_child_done = 0;
fn exec_child_done_set(fp) { _exec_child_done = fp; return 0; }
fn exec_child_done() { if (_exec_child_done != 0) { fncall0(_exec_child_done); } return 0; }

# --- timed, output-capturing shell exec (0.16.0; the model's `shell` tool backend) ---
#
# The /run escape above STREAMS to the terminal and returns only an exit code — fine for a
# human watching live. The agentic `shell` tool instead needs the OUTPUT back as a string to
# feed to the model, plus a wall-clock TIMEOUT so a runaway command can't hang the loop. There
# is no such primitive in the linked stdlib (lib/process.cyr's exec_capture has no timeout, and
# lib/regression.cyr's timed helpers are NOT in thoth's [deps].stdlib so they can't be called).
# So this builds its own, from regression.cyr's WNOHANG-poll-with-deadline + SIGKILL reap. 0.53.3: stdout+stderr
# come back down a PIPE that thoth drains as it polls, past the cap so the child never blocks on a full pipe. It was
# a temp file by name, which a FIFO at that name hung past the deadline, and which grew on disk without limit behind
# the cap. Partial output survives a kill, as it did. This is raw substrate (shell exec owned by no AGNOS domain), so
# it lives here, not in lib/ (which is vendored) — "port the floor, never fork the spine".
#
# POSIX-only (fork/dup2/execve/waitpid-WNOHANG/kill + a per-arity sys_open/sys_unlink). AGNOS has
# no /bin/sh -c (sys_spawn takes a program path only) and no WNOHANG waitpid; Windows has no
# fork/exec — so the whole body is compiled out on those targets (exactly as lib/process.cyr
# guards its POSIX block) and shell_supported() reports 0 there so the tool is never advertised.

var _shell_tmp_buf = 0;    # Windows-only: lazily-allocated scratch for the temp path
var _shell_tmp_ctr = 0;    # Windows-only: per-process monotonic counter — pid alone collides in a long-lived TUI
var _shell_wbuf = 0;       # Windows-only: lazily-allocated 16 KiB UTF-16LE cmdline scratch, reused per call
# (a fresh alloc() per call would leak — alloc is a no-free bump heap; POSIX uses none)

# _exec_append_cstr: raw-copy NUL-terminated s into dst at off; return new off. Pure.
fn _exec_append_cstr(dst, off, s) {
    var i = 0;
    while (load8(s + i) != 0) { store8(dst + off, load8(s + i)); off = off + 1; i = i + 1; }
    return off;
}

# exec_fd_cloexec (0.53.3, P-11): a descriptor thoth holds is not a command's: the session log reached every `/run` child.
fn exec_fd_cloexec(fd) {
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    if (fd >= 0) { syscall(SYS_FCNTL, fd, 2, 1); }
    #endif
    #endif
    return 0;
}
# exec_sigpipe_ignored: the window ignores SIGPIPE for its life (gui_run); a write here must not undo that.
var _exec_pipe_ignored = 0;
fn exec_sigpipe_ignored(v) { _exec_pipe_ignored = v; return 0; }

# --- what a capture kept (0.53.3) -----------------------------------------------------------------------------------
# exec_capture_total: the bytes the last capture's command wrote, kept or not. exec_shell_capture_tail: a capture that keeps
# the LAST buflen bytes instead of the first: a build names its error at the end. Windows' capture keeps the head (its
# file is read whole, after the fact), and its total is what it returned.
var _exec_cap_total = 0;
var _exec_cap_tail = 0;
fn exec_capture_total() { return _exec_cap_total; }
fn exec_shell_capture_tail(cmdline, buf, buflen, timeout_ms, status_out) {
    _exec_cap_tail = 1;
    var n = exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out);
    _exec_cap_tail = 0;
    return n;
}

#ifdef CYRIUS_TARGET_AGNOS
# AGNOS: no /bin/sh, no fork/exec/dup2, no WNOHANG waitpid, different sys_open/sys_unlink arity —
# so a capturing shell is architecturally impossible (the deferred-clipboard precedent). Announce,
# never fake: report unsupported (-3) and 0 bytes; shell_supported() returns 0 so it is unadvertised.
fn exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out) {
    store64(status_out, 0 - 3); store64(status_out + 8, 0); return 0;
}
fn exec_shell_capture_env(cmdline, buf, buflen, timeout_ms, status_out, envp) {
    store64(status_out, 0 - 3); store64(status_out + 8, 0); return 0;
}
fn shell_supported() { return 0; }
#endif
#ifdef CYRIUS_TARGET_WIN
# Windows (0.20.2): no fork/exec, but Cyrius 6.4.26 wired the timeout-kill primitive (TerminateProcess,
# syscall 0xF01D) behind lib/process_win.cyr's _win_create_process + _win_wait_timeout, so the model's
# `shell` tool now works on Windows through a temp file (the POSIX path used one too, until 0.53.3) — a FILE, never a
# pipe. A file has no writer backpressure, so the child runs to GENUINE completion (clean over-cap
# truncation) or a GENUINE hang (real deadline kill); the pipe path would deadlock/false-timeout any command
# whose output exceeds the ~4 KiB CreatePipe buffer, since the PE surface has no PeekNamedPipe / overlapped
# I/O / threads for concurrent draining (empirically confirmed on a real Windows host). Verified end-to-end
# on cass (2026-07-08): capture, merged stdout+stderr, exit codes, clean over-cap truncation, deadline
# TerminateProcess with the -2 sentinel, and partial-output-on-kill all correct.
#
# Divergences from POSIX + residuals (documented, never faked):
#   - Runs `cmd /s /c "<cmdline>"` with the environment INHERITED (wenv=0) so PATH reaches cmd.exe — unlike
#     the POSIX empty-envp, matching lib/process_win.cyr's exec_cmd convention; the UTF-16LE cmdline buffer
#     is a fixed 16 KiB, so a command exceeding ~8179 bytes is REJECTED fail-closed ({-1,0}, no spawn) rather
#     than overrunning the buffer (NOT silently truncated — _w_append_cstr has no cap).
#   - The temp file lives in the CURRENT WORKING DIRECTORY (the PE surface has no GetTempPathW), not /tmp; a
#     read-only CWD fails the create and degrades fail-CLOSED to {-1,0} (never a faked success). 0.45.6: the
#     open is an EXCLUSIVE create (CREATE_NEW) with the POSIX retry loop, so the file is always fresh — the
#     stale-tail case below is history. (Through 0.45.5 the open was OPEN_ALWAYS without O_TRUNC, the reroute
#     ignoring it, so a best-effort pre-delete was the only stale-content guard: in the narrow case where a
#     lingering file (below) was reconstructed by a later
#     run (pid reuse + the counter reset to 0) whose pre-delete ALSO fails on the still-live grandchild
#     handle, a shorter new capture could read new-front + stale-tail — not reachable without that exact combo,
#     and not reachable at all now that every capture file is created fresh.)
#   - The create is exclusive: a pre-planted name fails it and the counter moves on, as on POSIX, a dangling
#     symlink included (the TOCTOU residual 0.45.2 named is gone). The CWD is the user's own project dir, a
#     lower-risk place than /tmp to begin with.
#   - No process-group kill (Win32 has no POSIX pgid on this surface; a Job Object is not wired): a timeout
#     TerminateProcess-es only the cmd.exe, so a detached grandchild (`start foo`, a backgrounded process)
#     can survive AND — holding the inherited temp-file handle — makes the post-kill DeleteFileW fail
#     (Windows can't delete a file with a live handle, unlike POSIX unlink), so that ONE temp file may linger
#     in the CWD until the grandchild exits. Best-effort cleanup; parallels the pre-0.20.1 POSIX single-child
#     behavior (the 0.20.1 kill(-pgid) group-kill has no Win32 equivalent on this surface).
#   - The reported exit code is the child's true UNSIGNED 32-bit Win32 exit code (masked to 32 bits), not the
#     POSIX 0..127 / 128+signal shape; -1 (spawn/open) and -2 (timeout) remain thoth's own sentinels.
#   - stdin is not redirected to a NUL device (_win_create_process wires only stdout+stderr): a command that
#     reads stdin may block until the deadline and be reported as an HONEST -2 timeout (never a wrong answer).
#   - No stop (0.52.0): _win_wait_timeout is ONE blocking wait inside lib/process_win.cyr, so the surface's wait
#     poll is never called here — no Esc can end a Windows capture early (it still ends at its deadline), and a
#     front end would not be pumped during it. A poll needs a waiter that returns between checks.
#
# The full thoth --win binary is still gated on the async/epoll->IOCP transport (lib/async.cyr); this
# capturing shell is proven via a minimal exec-only --win harness on cass and ships with the Windows binary
# the moment that gate lifts.

# _shell_tmp_path_win: a CWD-relative thoth_sh_<pid>_<counter>.tmp (no /tmp, no GetTempPathW). getpid() is
# lib/process_win.cyr's Windows self-pid (syscall 0xF01C) — NOT sys_getpid (POSIX-only). Reuses the shared
# _shell_tmp_buf/_shell_tmp_ctr + _exec_append_cstr/_append_int defined above the target #ifdefs.
fn _shell_tmp_path_win() {
    if (_shell_tmp_buf == 0) { _shell_tmp_buf = alloc(64); }
    var off = 0;
    off = _exec_append_cstr(_shell_tmp_buf, off, "thoth_sh_");
    off = _append_int(_shell_tmp_buf, off, getpid());
    store8(_shell_tmp_buf + off, 95); off = off + 1;              # '_'
    off = _append_int(_shell_tmp_buf, off, _shell_tmp_ctr);
    _shell_tmp_ctr = _shell_tmp_ctr + 1;
    off = _exec_append_cstr(_shell_tmp_buf, off, ".tmp");
    store8(_shell_tmp_buf + off, 0);
    return _shell_tmp_buf;
}

fn exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out) {
    store64(status_out, 0 - 1); store64(status_out + 8, 0);       # fail-closed default {-1, 0}
    # 0.45.6: the EXCLUSIVE create, as on POSIX — O_WRONLY|O_CREAT|O_EXCL, which the CreateFileW reroute maps to
    # CREATE_NEW since cyrius 6.4.58: a pre-planted name (or a file a grandchild still holds from an earlier run)
    # fails the create and the counter moves on to the next name, up to 8 tries, then fail closed. The file is
    # therefore always FRESH, which also retires the OPEN_ALWAYS-without-O_TRUNC stale-tail case the pre-delete
    # used to guard. Verified on cass (the Windows host) by pre-planting the first candidate name.
    var out_fd = 0 - 1;
    var path = 0;
    var tries = 0;
    while ((tries < 8) && (out_fd < 0)) {
        path = _shell_tmp_path_win();
        out_fd = sys_open(path, O_WRONLY | O_CREAT | O_EXCL, 384);
        tries = tries + 1;
    }
    if (out_fd < 0) { return 0; }                               # status stays {-1, 0}
    var sh = syscall(0xF003, out_fd, 1, 1);                      # SetHandleInformation(h, HANDLE_FLAG_INHERIT, 1)
    if (sh == 0) { sys_close(out_fd); sys_unlink(path); return 0; }   # non-inheritable -> empty capture; fail closed
    # Bound the copy to the 16 KiB wbuf before writing: _w_append_cstr writes 2 bytes/char with NO cap, and the
    # `command` is model-supplied and only blob-bounded upstream. Static framing is 26 bytes (`cmd /s /c "` 22 +
    # `"` 2 + wide-NUL 2), so reject fail-closed ({-1,0}, no spawn) at >8179 cmdline bytes rather than OVERRUN
    # the buffer (heap corruption on the bump allocator). Caught by the 0.20.4 pre-cut adversarial review.
    if (((strlen(cmdline) * 2) + 26) > 16384) { sys_close(out_fd); sys_unlink(path); return 0; }
    if (_shell_wbuf == 0) { _shell_wbuf = alloc(16384); }        # reused per call (see the global; no per-call leak)
    var wbuf = _shell_wbuf;                                      # writable UTF-16LE `cmd /s /c "<cmdline>"`
    var wo = 0;
    wo = _w_append_cstr(wbuf, wo, "cmd /s /c \"");
    wo = _w_append_cstr(wbuf, wo, cmdline);
    wo = _w_append_cstr(wbuf, wo, "\"");
    _w_terminate(wbuf, wo);
    var pi[24];
    var ok = _win_create_process(wbuf, out_fd, 0, &pi);          # hStdOut=out_fd -> stdout+stderr; wenv=0 inherits env
    sys_close(out_fd);                                           # drop the parent copy AFTER CreateProcessW duped it
    if (ok == 0) { sys_unlink(path); return 0; }               # spawn fail -> {-1, 0}, remove the created file
    var killed[8];
    store64(&killed, 0);
    var ec = _win_wait_timeout(&pi, timeout_ms, &killed);        # deadline + TerminateProcess + reap + close handles
    if (load64(&killed) == 1) {
        store64(status_out, 0 - 2);                             # timeout-kill sentinel (matches POSIX -2)
        store64(status_out + 8, 1);
    } else {
        store64(status_out, ec & 0xFFFFFFFF);                   # true unsigned 32-bit Win32 exit code
        store64(status_out + 8, 0);
    }
    var total = file_read_all(path, buf, buflen);               # fresh O_RDONLY reopen; child exited & flushed
    sys_unlink(path);                                            # DeleteFileW (best-effort: fails if a grandchild holds it)
    if (total < 0) { total = 0; }
    return total;
}
# exec_shell_capture_env (0.45.6): the environment-carrying form. The PE capture INHERITS thoth's environment
# (wenv=0, so PATH reaches cmd.exe) and lib/process_win.cyr has no channel for a built block, so a caller that
# needs its facts in the child's environment cannot be served here: with a non-empty `envp` this reports
# "could not run" ({-1, 0}, no spawn) — announced by the caller, never a hook that ran without its facts and
# passed. An empty `envp` is the plain capture.
fn exec_shell_capture_env(cmdline, buf, buflen, timeout_ms, status_out, envp) {
    if (envp != 0) { if (load64(envp) != 0) { store64(status_out, 0 - 1); store64(status_out + 8, 0); return 0; } }
    return exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out);
}
fn shell_supported() { return 1; }
#endif

#ifndef CYRIUS_TARGET_AGNOS
#ifndef CYRIUS_TARGET_WIN
# --- the capture's SUPERVISOR (0.52.8, batch 12: audit E1 / ruling R4, E4, E10) ---------------------------------------
#
# ⚠ THROUGH 0.52.7 A KILLED THOTH LEFT A CAPTURE'S CHILDREN RUNNING. The capture child was the shell itself, under the
# floor's parent-death signal (0.52.6) — and PR_SET_PDEATHSIG is per-process and cleared on fork, so it reached the shell
# and nothing the shell started. `/run sleep 46; true` (a list: the shell forks the sleep instead of exec'ing it), a make,
# a dev server: SIGKILL thoth and the shell died while its children were reparented to init and ran on (measured: the
# sleep at ppid 1). macOS had not even that much — prctl does not exist there (E10).
#
# So the capture child is now a small SUPERVISOR, and the command is ITS child:
#
#   thoth ─fork─▶ supervisor   setsid: a new session AND process group, pgid == its pid — exec's kill(-pid) target, as
#                  │            the shell was; stdin /dev/null, stdout+stderr the capture pipe; it keeps ONLY the death
#                  │            pipe's read end (every other descriptor it inherited is closed)
#                  └─fork─▶ /bin/sh -c <cmd>   the same group, writing straight into the capture pipe; on Linux it
#                               │             carries the parent-death signal (it fires if the supervisor dies)
#                               └─ everything the command starts — the same group, unless it makes one of its own
#
# The supervisor waits for two things: the shell's exit, and thoth's death. Thoth's death is the DEATH PIPE: thoth makes
# it, the supervisor keeps the read end, only thoth keeps the write end. When thoth dies — SIGKILL included, which runs
# no cleanup at all — the kernel closes its descriptors, the read end reports a hang-up, and the supervisor SIGKILLs its
# whole group, itself included. A getppid check on every wakeup is
# the second witness: a write end leaked into some other process could hold the hang-up off, never the reparenting.
# A parent-death SIGKILL on the SUPERVISOR would be wrong — it would kill the supervisor before it could kill the group.
# The backstop goes one level down, on the shell, where it helps: if the supervisor itself is killed, the shell dies
# rather than run on unsupervised.
#
# The status thoth reads is the supervisor's, and it is the shell's: exit N is exit N, and a shell killed by signal S is
# exit 128+S — the very number exec's mapping (below) gives a signal death, so /run's card, the shell tool's result, a
# hook's verdict and [verify] read what they read before. exec's kills — the deadline, the operator's stop (Esc, the
# window closing, the parallel executor's phase-1 stop through the same wait) — already aimed at the group (kill(-pid)),
# and pid is now the supervisor, its leader: they reach the whole tree, as they reached the shell's.
#
# What each lane gets (E10):
#   Linux x86_64 / aarch64  the supervisor, the death pipe, the getppid witness, and the shell's parent-death signal
#   macOS arm64             the supervisor, the death pipe and the getppid witness — the mechanism that works there; no
#                           parent-death signal (prctl is Linux-only: _proc_child_guard compiles to nothing)
#   AGNOS / Windows         no capture child of this shape (above): AGNOS has none, Windows its own residuals
# The line REPL's /run (run_shell -> the floor's exec_vec) is NOT supervised: it shares thoth's terminal and process
# group (job control, a password prompt), so it cannot leave the session as this child does; it keeps the floor's
# parent-death signal, on the shell only.
#
# EXEC_SV_FD_SCAN: the supervisor closes descriptors 3..EXEC_SV_FD_SCAN-1 (the floor has no close_range/closefrom).
# 1024 is the default soft RLIMIT_NOFILE on Linux; macOS's is 256. Thoth holds a few dozen.
var EXEC_SV_FD_SCAN = 1024;
# _exec_sv_ppid_witness is a variable for one reason: a test turns the getppid witness off, to prove that the death pipe
# alone kills the group (the witness would otherwise mask a broken pipe path within one slice).
var _exec_sv_ppid_witness = 1;

# _exec_child_signals_reset (0.52.8, audit E4): the signal state a command starts with. A signal MASK and an IGNORED
# disposition both survive fork and execve, so every captured command inherited thoth's: the TUI's signalfd blocks
# SIGINT and SIGWINCH (src/tui.cyr), and a launcher that ignores SIGPIPE and SIGXFSZ for itself (Python and Node both
# do) hands that to thoth. Measured in a TUI child: SigBlk 0x8000002, SigIgn 0x1001000; `grep -rn "" /usr/include |
# head -1` printed "write error: Broken pipe" instead of ending quietly, and `timeout -s INT 1 sleep 3` took 3 s. The
# mask is cleared whole; SIGPIPE and SIGXFSZ go back to SIG_DFL (the pair Python's subprocess restores). Nothing else:
# a SIGHUP that `nohup thoth` ignored is the operator's choice and stays theirs.
# macOS: thoth blocks nothing on that lane — the signalfd is the Linux TUI's — so the mask half clears only what a
# launcher set; signal_default reaches BSD sigaction. SIGXFSZ is 25 on Linux and Darwin alike.
fn _exec_child_signals_reset() {
    var none[16];                                     # N BYTES: a kernel sigset is 8 (rt_sigprocmask's sigsetsize)
    store64(&none, 0);
    store64(&none + 8, 0);
    sys_sigprocmask(SIG_SETMASK, &none, 0);
    signal_default(SIGPIPE);
    signal_default(25);                               # SIGXFSZ — the floor's Signal enum has no name for it
    return 0;
}

# _exec_fd_above_stdio(fd): fd when it is above 2, else a duplicate at the lowest free descriptor >= 3 (fcntl F_DUPFD,
# 0 on Linux and Darwin) with the original closed; -1 when that fails. The supervisor makes 0, 1 and 2 its stdio, so a
# pipe end that landed there (a thoth started with its own stdio closed) would be overwritten by those dup2s: the
# supervisor would poll its own stdout for thoth's death, and kill every command it started.
fn _exec_fd_above_stdio(fd) {
    if (fd > 2) { return fd; }
    var hi = syscall(SYS_FCNTL, fd, 0, 3);
    sys_close(fd);
    return hi;
}

# _exec_sv_kill_group: the supervisor's end when thoth is gone, or when the shell can no longer be waited for — the whole
# group SIGKILLed, this process with it (so the exit after it is never reached). `0 - getpid()` names the group this
# supervisor leads; never thoth's.
fn _exec_sv_kill_group() {
    sys_kill(0 - sys_getpid(), 9);
    sys_exit(137);
    return 0;
}

# _exec_supervise(sh, drd, tpid): the supervisor's wait; it returns only by exiting. The poll on the death pipe is
# also the sleep between looks at the shell, and a hang-up ends it at once, whatever the slice. The slice is short
# because the shell's end reaches thoth only when this process exits: 1 ms for the first 50 ms (the common quick hook
# or `shell` call), then 10 ms — a tenth of exec's own 100 ms tick.
fn _exec_supervise(sh, drd, tpid) {
    var st[4];                                        # N BYTES: wait4's status is one 4-byte int
    var slice = 1;
    var waited = 0;
    while (1 == 1) {
        var w = sys_waitpid(sh, &st, 1);              # 1 = WNOHANG
        if (w == sh) {
            var s = load32(&st);
            if (WIFEXITED(s) == 1) { sys_exit(WEXITSTATUS(s)); }
            if (WIFSIGNALED(s) == 1) { sys_exit(128 + WTERMSIG(s)); }   # the number exec's mapping gives a signal death
        }
        if (w < 0) { _exec_sv_kill_group(); }        # the shell cannot be waited for: never leave its group unwatched
        var r = _proc_poll_in(drd, slice);            # > 0 only once every write end is closed (thoth never writes)
        if (r > 0) { _exec_sv_kill_group(); }
        if ((_exec_sv_ppid_witness == 1) && (sys_getppid() != tpid)) { _exec_sv_kill_group(); }   # reparented: thoth is gone, whoever holds a write end
        if (r < 0) { sleep_ms(slice); }               # a poll error: never spin
        waited = waited + slice;
        if (waited >= 50) { slice = 10; }
    }
    return 0;
}

# _exec_supervisor: the capture child (above). Never returns. `tpid` is thoth's pid; `drd` / `dwr` the death pipe's ends.
fn _exec_supervisor(cmdline, envp, out_fd, drd, dwr, tpid) {
    # 0.20.1 / 0.45.2: a new session, which makes this fresh child (never a group leader) the leader of a new process
    # group with pgid == pid — exec's kill(-pid) target. The floor has no setpgid wrapper; setsid is routed on every POSIX
    # target (the raw `syscall(109, 0, 0)` it replaced was setpgid in x86_64 numbering only, so on aarch64 and macOS the
    # group never formed). Leaving the controlling terminal suits a captured command: its stdin is /dev/null, its output
    # a file, and a hang-up of thoth's terminal is not its signal — thoth's death is (the pipe).
    sys_setsid();
    sys_dup2(out_fd, 1);                              # stdout -> the capture pipe
    sys_dup2(out_fd, 2);                              # stderr -> the same pipe (merged, as a terminal shows it)
    var dn = sys_open("/dev/null", 0, 0);             # 0 = O_RDONLY
    if (dn > 0) { sys_dup2(dn, 0); }                  # stdin <- /dev/null (no hang on read; a dn of 0 already is stdin)
    # Every other descriptor goes: the capture pipe's and /dev/null's originals, the death pipe's write end, and all of
    # thoth's own — its sockets, the window's Wayland connection, another capture's pipe. None outlives thoth in here.
    sys_close(dwr);
    var fd = 3;
    while (fd < EXEC_SV_FD_SCAN) {
        if (fd != drd) { sys_close(fd); }
        fd = fd + 1;
    }
    _exec_child_signals_reset();                      # E4: the shell, and everything it starts, inherits this
    var argv[40];                                     # N BYTES: 4 ptrs (/bin/sh, -c, cmdline, NUL) = 32 B, headroom to 40
    store64(&argv,      "/bin/sh");
    store64(&argv + 8,  "-c");
    store64(&argv + 16, cmdline);                     # the command flows as ONE argv element (no double-shell)
    store64(&argv + 24, 0);
    var env0[16];                                     # the empty environment (the plain capture) — the shell's own default PATH
    store64(&env0, 0);
    var ep = envp;
    if (ep == 0) { ep = &env0; }
    var me = sys_getpid();
    var sh = sys_fork();
    if (sh == 0) {
        _proc_child_guard(me);                        # Linux: SIGKILL when the supervisor dies (its getppid re-check closes the race)
        sys_execve("/bin/sh", &argv, ep);             # the death pipe's read end is close-on-exec: the command never holds it
        sys_exit(127);
    }
    if (sh < 0) {
        # No second process to be had (RLIMIT_NPROC, memory): run the command HERE, unsupervised — the 0.52.6 shape, with
        # the floor's parent-death signal on the shell — rather than fail a command that can still run.
        _proc_child_guard(tpid);
        sys_execve("/bin/sh", &argv, ep);
        sys_exit(127);
    }
    _exec_supervise(sh, drd, tpid);
    sys_exit(127);
    return 0;
}

# _exec_kill_group: SIGKILL a capture child's whole PROCESS GROUP and reap it — the deadline's kill (0.20.1), shared
# since 0.52.0 with the operator's stop. The group first (negative pid): since 0.52.8 pid is the SUPERVISOR, the group's
# leader, so this takes it, the shell and everything the shell started (a backgrounded grandchild included); then the
# supervisor directly as a belt-and-suspenders (harmless ESRCH if the group kill already reached it, and it guarantees
# the child dies even if its setsid did not take, so the blocking reap never hangs). The shell, now an orphaned
# zombie, is reaped by init; the direct child is reaped here — no zombie of thoth's.
fn _exec_kill_group(pid, stbuf) {
    sys_kill(0 - pid, 9);                             # SIGKILL the process group (supervisor + shell + its children)
    sys_kill(pid, 9);                                 # + the supervisor directly (defensive)
    sys_waitpid(pid, stbuf, 0);                       # BLOCKING reap
    return 0;
}

# --- the capture's PIPE (0.53.3) ---------------------------------------------------------------------------------------
# ⚠ THROUGH 0.53.2 THE CAPTURE WAS A TEMP FILE, read by name after the command ended, and four defects came with it. A FIFO
# swapped in at that name blocked thoth in open(2), past its deadline, with Esc dead. Nothing bounded the file: `yes` put
# 2.5 GB in a tmpfs in a second, RAM pinned, and a job left running kept writing to it unlinked, where nothing could see
# it. And [verify]'s "keep the tail" tailed the first 8 KiB. A pipe has none of these: thoth reads as the command writes,
# keeps what it was asked to and discards the rest, so the capture holds no disk, has no name to swap and knows its total.
# Reading promptly matters only for speed: a writer past the pipe's 64 KiB waits for this loop, a few ms at worst.
# What reads differently: a job the command leaves running still holding stdout gets SIGPIPE at its next write (the read
# end closes with the capture). Redirect one that must live on. Nothing else changes: the shell's exit ends the capture, as
# it did, with or without a job holding the pipe open.
var EXEC_DRAIN_CHUNK = 65536;
var EXEC_DRAIN_LAST = 16;          # chunks read once the shell is gone: what it wrote fits, and a job left writing cannot hold the capture open
var EXEC_WAIT_MS = 25;             # the wait's longest sleep; data and the pipe's hang-up end it at once
var EXEC_TICK_MS = 100;            # how often the surface's poll runs
var _exec_drain_buf = 0;           # alloc(EXEC_DRAIN_CHUNK), lazy
var _exec_cap_refuse = 0;          # a test sets it, to make a capture fail for real where a pipe or a fork would

# _exec_cap_take: `got` new bytes in `s`: the head fills buf and the rest is counted, or (tail mode) buf is a ring.
fn _exec_cap_take(buf, buflen, s, got) {
    if (_exec_cap_tail == 1) {
        var i = 0;
        while (i < got) {
            var at = (_exec_cap_total + i) % buflen;
            var n = buflen - at;
            if (n > (got - i)) { n = got - i; }
            memcpy(buf + at, s + i, n);
            i = i + n;
        }
    } else {
        var room = buflen - _exec_cap_total;
        if (room > got) { room = got; }
        if (room > 0) { memcpy(buf + _exec_cap_total, s, room); }
    }
    _exec_cap_total = _exec_cap_total + got;
    return 0;
}
# _exec_cap_drain: one read of the pipe, waiting up to wait_ms for it. Returns the bytes read, 0 when there were none yet,
# -1 at end of file (every write end closed).
fn _exec_cap_drain(crd, buf, buflen, wait_ms) {
    if (_proc_poll_in(crd, wait_ms) <= 0) { return 0; }
    var got = file_read(crd, _exec_drain_buf, EXEC_DRAIN_CHUNK);
    if (got == (0 - 4)) { return 0; }                 # interrupted: look again
    if (got <= 0) { return 0 - 1; }
    _exec_cap_take(buf, buflen, _exec_drain_buf, got);
    return got;
}
fn _exec_rev(b, i, j) {
    while (i < j) {
        var c = load8(b + i);
        store8(b + i, load8(b + j));
        store8(b + j, c);
        i = i + 1;
        j = j - 1;
    }
    return 0;
}
# _exec_cap_settle: the bytes buf holds, with a ring turned so they read in order.
fn _exec_cap_settle(buf, buflen) {
    if (_exec_cap_total <= buflen) { return _exec_cap_total; }
    if (_exec_cap_tail == 1) {
        var at = _exec_cap_total % buflen;
        if (at != 0) {
            _exec_rev(buf, 0, at - 1);
            _exec_rev(buf, at, buflen - 1);
            _exec_rev(buf, 0, buflen - 1);
        }
    }
    return buflen;
}

# --- a job the command leaves running (0.53.3) ---------------------------------------------------------------------------
# A clean exit kills nothing: a dev server started by one call is there for the next. But the supervisor exits with the
# shell, so through 0.53.2 nothing watched such a group, and ADR-0014 and ruling R4 said something did: a SIGKILLed thoth left
# it at ppid 1. Thoth now counts the group after the reap (kill(-pid, 0)) and, for one that lives on, tells a single WATCHER,
# forked on the first such job: its own session, every descriptor gone but one pipe from thoth. When that pipe hangs up,
# however thoth went, the watcher SIGKILLs every group it was told about and exits. A job that must outlive thoth starts a
# session of its own (`setsid`), which leaves the group and is the documented way out.
var EXEC_BG_MAX = 64;
var _exec_bg_wr = 0 - 1;           # the watcher's pipe, write end (close-on-exec; thoth holds it for life)
var _exec_bg_pid = 0;

fn _exec_bg_kill_all(g, n) {
    var i = 0;
    while (i < n) { sys_kill(0 - load64(g + i * 8), 9); i = i + 1; }
    return 0;
}
# _exec_bg_prune: drop the groups that have ended, so a pid reused later is never killed for them. Returns the new count.
fn _exec_bg_prune(g, n) {
    var o = 0;
    var i = 0;
    while (i < n) {
        var p = load64(g + i * 8);
        if (sys_kill(0 - p, 0) == 0) { store64(g + o * 8, p); o = o + 1; }
        i = i + 1;
    }
    return o;
}
# _exec_bg_watch: the watcher. Never returns.
fn _exec_bg_watch(rd, tpid) {
    sys_setsid();
    var fd = 0;
    while (fd < EXEC_SV_FD_SCAN) {
        if (fd != rd) { sys_close(fd); }
        fd = fd + 1;
    }
    var g[512];                                       # N BYTES: EXEC_BG_MAX pgids
    var n = 0;
    while (1 == 1) {
        var r = _proc_poll_in(rd, 1000);
        if (r > 0) {
            var rec[8];
            var got = sys_read(rd, &rec, 8);
            if (got == 8) {
                if (n >= EXEC_BG_MAX) { n = _exec_bg_prune(&g, n); }
                if (n < EXEC_BG_MAX) { store64(&g + n * 8, load64(&rec)); n = n + 1; }
            } elif (got != (0 - 4)) {                 # end of file: thoth is gone
                _exec_bg_kill_all(&g, n);
                sys_exit(0);
            }
        } else { n = _exec_bg_prune(&g, n); }
        if (sys_getppid() != tpid) {                  # the second witness, as the supervisor's
            _exec_bg_kill_all(&g, n);
            sys_exit(0);
        }
    }
    return 0;
}
# _exec_bg_note: hand group `pgid` to the watcher, starting it on the first. A watcher that cannot be started leaves the job
# as it was before 0.53.3, unwatched. thoth ignores SIGPIPE for this one write: a watcher someone killed must not take thoth.
fn _exec_bg_note(pgid) {
    if (_exec_bg_wr < 0) {
        var bp[16];
        store64(&bp, 0);
        if (sys_pipe(&bp) < 0) { return 0; }
        var brd = _exec_fd_above_stdio(load32(&bp));
        var bwr = _exec_fd_above_stdio(load32(&bp + 4));
        if ((brd < 0) || (bwr < 0)) {
            if (brd >= 0) { sys_close(brd); }
            if (bwr >= 0) { sys_close(bwr); }
            return 0;
        }
        syscall(SYS_FCNTL, brd, 2, 1);
        syscall(SYS_FCNTL, bwr, 2, 1);
        var tpid = sys_getpid();
        var w = sys_fork();
        if (w < 0) { sys_close(brd); sys_close(bwr); return 0; }
        if (w == 0) { _exec_bg_watch(brd, tpid); }
        sys_close(brd);
        _exec_bg_wr = bwr;
        _exec_bg_pid = w;
    }
    var rec[8];
    store64(&rec, pgid);
    signal_ignore(SIGPIPE);
    var wrote = sys_write(_exec_bg_wr, &rec, 8);
    if (_exec_pipe_ignored == 0) { signal_default(SIGPIPE); }
    if (wrote != 8) {                                 # the watcher is gone: start another for the next job
        sys_close(_exec_bg_wr);
        _exec_bg_wr = 0 - 1;
        sys_waitpid(_exec_bg_pid, &rec, 1);
    }
    return 0;
}

# exec_shell_capture: run `/bin/sh -c cmdline`, capturing merged stdout+stderr into buf[0..buflen)
# (a pipe, 0.53.3), enforcing a wall-clock timeout. status_out points to TWO i64 slots:
#   [0] = exit code: 0..127 normal, 128+sig on a signal, -1 on spawn/open failure, -2 on timeout-kill,
#         -4 when the operator STOPPED it (0.52.0: the surface's wait poll moved its generation — Esc, or the
#         window closing; the group is killed as the deadline kills it, the partial output kept)
#   [1] = 1 if the command was SIGKILLed by the deadline, else 0 (a stop is not a deadline: 0 with -4)
# Returns the number of bytes kept (<= buflen; may be partial on timeout), exec_capture_total the number written. The child
# runs with an EMPTY environment (the shell's compiled-in default PATH), matching /run's exec_vec convention;
# stdin is /dev/null so a command that reads input gets EOF instead of hanging until the timeout.
# The caller owns NUL-termination of buf at the returned count (buf must be >= buflen+1).
# 0.52.8: the command runs under the supervisor above (it kills the command's whole tree when thoth dies), with an
# empty signal mask and SIGPIPE / SIGXFSZ at their defaults; a signal death reaches this loop as the supervisor's exit
# 128+sig — the same number the WIFSIGNALED arm gives, so [0] reads exactly as it did.
#
# exec_shell_capture_env (0.45.6): the same capture with `envp` — a NUL-terminated array of `KEY=value`
# cstr pointers — as the child's WHOLE environment (0 = empty, the plain form). This is how [hooks] hands a
# hook its event facts: an environment block is the process's own (`/proc/<pid>/environ` is owner-readable),
# where the old `export K='v'; ` prefix rode in argv — world-readable through `/proc/<pid>/cmdline` for the
# hook's life. No shell quoting is involved: a value goes to the child byte for byte.
fn exec_shell_capture(cmdline, buf, buflen, timeout_ms, status_out) {
    return exec_shell_capture_env(cmdline, buf, buflen, timeout_ms, status_out, 0);
}
# _exec_cap_fail: the -1 every capture that could not start reports. Closes the descriptors it is given (-1 for none).
fn _exec_cap_fail(status_out, a, b, c, d) {
    if (a >= 0) { sys_close(a); }
    if (b >= 0) { sys_close(b); }
    if (c >= 0) { sys_close(c); }
    if (d >= 0) { sys_close(d); }
    store64(status_out, 0 - 1);
    store64(status_out + 8, 0);
    return 0;
}
fn exec_shell_capture_env(cmdline, buf, buflen, timeout_ms, status_out, envp) {
    _exec_cap_total = 0;
    if (_exec_drain_buf == 0) { _exec_drain_buf = alloc(EXEC_DRAIN_CHUNK); }
    if ((_exec_drain_buf == 0) || (_exec_cap_refuse == 1)) { return _exec_cap_fail(status_out, 0 - 1, 0 - 1, 0 - 1, 0 - 1); }

    # The capture pipe. Both ends close-on-exec, as the death pipe's are (fcntl F_SETFD FD_CLOEXEC, 2 and 1 on Linux and
    # Darwin; Darwin's pipe takes no flags word): the supervisor's dup2 onto 1 and 2 is what the command gets, and clears it.
    var cp[16];                                       # N BYTES: pipe writes two 4-byte fds
    store64(&cp, 0);
    if (sys_pipe(&cp) < 0) { return _exec_cap_fail(status_out, 0 - 1, 0 - 1, 0 - 1, 0 - 1); }
    var crd = _exec_fd_above_stdio(load32(&cp));
    var out_fd = _exec_fd_above_stdio(load32(&cp + 4));
    if ((crd < 0) || (out_fd < 0)) { return _exec_cap_fail(status_out, crd, out_fd, 0 - 1, 0 - 1); }
    syscall(SYS_FCNTL, crd, 2, 1);
    syscall(SYS_FCNTL, out_fd, 2, 1);

    # 0.52.8 (E1): the DEATH PIPE (the supervisor, above). Thoth keeps only the write end, and never writes to it. A pipe
    # that cannot be made fails the capture closed.
    var dp[16];                                       # N BYTES: pipe writes two 4-byte fds
    store64(&dp, 0);
    if (sys_pipe(&dp) < 0) { return _exec_cap_fail(status_out, crd, out_fd, 0 - 1, 0 - 1); }
    var drd = _exec_fd_above_stdio(load32(&dp));
    var dwr = _exec_fd_above_stdio(load32(&dp + 4));
    if ((drd < 0) || (dwr < 0)) { return _exec_cap_fail(status_out, crd, out_fd, drd, dwr); }
    syscall(SYS_FCNTL, drd, 2, 1);
    syscall(SYS_FCNTL, dwr, 2, 1);

    var ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return _exec_cap_fail(status_out, crd, out_fd, drd, dwr); }
    # 0.52.6 (audit F4) gave this child the parent-death signal, the floor's own since 6.6.6 (lib/process.cyr: "a
    # SIGKILLed parent runs no cleanup … the kernel has to do it") — it reached the shell and none of its children. Since
    # 0.52.8 the child is the supervisor, and the signal sits on the shell beneath it (above).
    if (pid == 0) { _exec_supervisor(cmdline, envp, out_fd, drd, dwr, ppid); }
    sys_close(out_fd);                  # parent's write copy: the pipe's hang-up then means every writer has gone
    sys_close(drd);                     # the supervisor's end. Thoth holds the write end until the reap below
    # (0.20.1 also ran setpgid(pid, pid) here, to close the fork/setpgid race. setsid cannot be called on another
    # process, and the race needs no closing: the group is only the kills' target, no grandchild can exist before the
    # supervisor's own setsid (it precedes the shell's fork), and the direct kill(pid) below covers a supervisor that
    # has not reached it yet.)

    var stbuf[4];                       # N BYTES: waitpid's status out-param is one 4-byte int (was [1];
    # both round to the 8B minimum frame slot so [1] was benign, but
    # [4] states the intent — matches lib/process.cyr's status_buf[4])
    var elapsed = 0;
    var reaped = 0;
    var code = 0;
    # 0.52.0 (F7): the surface's stop generation as the child starts — read BEFORE the first sleep, so a stop asked
    # for during the first tick is a move, not the baseline. `stop` is 1 once it has moved, 2 once one more look
    # found the child still running: a child that exited on its own in the tick the stop arrived in keeps its REAL
    # exit code (a pre_tool hook that had already answered keeps its verdict) instead of being reported stopped.
    var gen0 = 0;
    var stop = 0;
    # 0.52.0: the deadline is WALL-clock, measured from here. It used to count the 100 ms sleeps, which was near enough
    # while the tick was a spinner glyph; the window's pump now repaints inside the tick (a full CPU raster on a large
    # window is tens of ms), and a sleep-count would let a 30 s [shell].timeout_ms run for a minute.
    var t_start = clock_now_ms();
    var t_poll = t_start;
    var eof = 0;
    if (_exec_wait_poll != 0) { gen0 = fncall0(_exec_wait_poll); }
    while ((elapsed < timeout_ms) && (reaped == 0) && (stop < 2)) {
        var w = sys_waitpid(pid, &stbuf, 1);          # 1 = WNOHANG
        if (w == pid) {
            var st = load32(&stbuf);
            if (WIFEXITED(st) == 1) { code = WEXITSTATUS(st); }
            elif (WIFSIGNALED(st) == 1) { code = 128 + WTERMSIG(st); }
            else { code = 0 - 1; }
            reaped = 1;
        } elif (stop == 1) {
            stop = 2;                                 # asked to stop, and still running after the last look: kill it below
        } else {
            # The pipe is the sleep: output and the hang-up at the command's end both wake this at once. After the
            # hang-up only the supervisor's exit is left, a few ms away.
            if (eof == 0) { if (_exec_cap_drain(crd, buf, buflen, EXEC_WAIT_MS) < 0) { eof = 1; } }
            else { sleep_ms(1); }
            # 0.44.2: this loop is the ONE place a running command hands the main thread back, so it is where a
            # front end gets to live. Through the seam — exec.cyr is substrate and must not reach into a front end.
            # 0.52.0: the surface's poll (the TUI's spinner + Esc drain, the window's pump) returns its generation.
            if ((_exec_wait_poll != 0) && ((clock_now_ms() - t_poll) >= EXEC_TICK_MS)) {
                t_poll = clock_now_ms();
                if (fncall0(_exec_wait_poll) != gen0) { stop = 1; }
            }
            elapsed = clock_now_ms() - t_start;       # after the poll: its repaint is the operator's time too
        }
    }
    var timed = 0;
    if (reaped == 0) {
        _exec_kill_group(pid, &stbuf);                # 0.20.1: the whole PROCESS GROUP, then the supervisor, then the reap
        if (stop > 0) { code = 0 - 4; }               # 0.52.0: the operator stopped it — never reported as a deadline
        else {
            timed = 1;
            code = 0 - 2;
        }
    }
    sys_close(dwr);                                   # 0.52.8: the supervisor is reaped — nothing is left to watch for thoth's death
    store64(status_out, code);
    store64(status_out + 8, timed);

    var last = 0;                                     # whatever the shell wrote and this loop had not reached
    while (last < EXEC_DRAIN_LAST) {
        if (_exec_cap_drain(crd, buf, buflen, 0) <= 0) { last = EXEC_DRAIN_LAST; }
        last = last + 1;
    }
    sys_close(crd);
    if ((reaped == 1) && (sys_kill(0 - pid, 0) == 0)) { _exec_bg_note(pid); }   # 0.53.3: a job left running, watched from here on
    return _exec_cap_settle(buf, buflen);
}
fn shell_supported() { return 1; }
#endif
#endif
