# thoth — composer input-history recall (0.11.1; the SecureYeoman-TUI-review backlog,
# top-ranked pure-substrate win on the 0.11.x terminal-citizen line).
#
# An in-memory ring of SUBMITTED composer lines, recalled with Up/Down in the T2
# raw-mode composer. This is DISTINCT from the multi-turn CONVERSATION history
# (session_history_*, 0.5.1): conversation history is the model's memory of the
# exchange; THIS is the user's own keystrokes — the lines they typed — kept so they
# can be navigated back to, re-edited, and re-sent.
#
# TUI-ONLY by construction: recall needs the raw-mode composer's per-keystroke
# editing. The line-mode REPL reads through the kernel's COOKED line discipline
# (read_line), which thoth does not replace — so the REPL / piped / CI floor is
# byte-identical (this module is never reached off the PT_RICH TUI path).
#
# DESIGN SPLIT (mirrors src/feed.cyr, src/ftree.cyr): the ring + the navigation
# cursor here are PURE and unit-tested (test_inhist). The draft-stash + loading a
# recalled line INTO the composer is TUI glue in src/tui.cyr (_tui_recall_*), which
# manipulates the led_* editor state.
#
# Persistence (opt-in history file, 0600 on disk) is the NEXT slice (0.11.2): this
# cut is session-local memory ONLY, so there is no on-disk footprint and nothing to
# secure yet — the DEFAULT experience (no persistence) is delivered in full here.

var INHIST_CAP = 128;          # ring slots — submitted lines retained for recall
var INHIST_LINE_CAP = 4096;    # bytes per slot (== COMPOSER_CAP, so any line round-trips)

var _inhist_buf = 0;           # alloc(INHIST_CAP * INHIST_LINE_CAP): the slot bytes
var _inhist_lens = 0;          # alloc(INHIST_CAP * 8): stored byte length per slot
var _inhist_count = 0;         # logical entries stored (0..INHIST_CAP)
var _inhist_head = 0;          # physical slot of the OLDEST entry (ring base)
var _inhist_cur = 0;           # nav cursor in [0.._inhist_count]; == count means "the live draft"

# inhist_init: allocate the ring (idempotent) and reset to empty. Called once at TUI
# startup (alongside feed_init); each unit test calls it for a clean slate. The push
# path also lazily allocates, so a stray call before init is safe.
fn inhist_init() {
    if (_inhist_buf == 0) {
        _inhist_buf = alloc(INHIST_CAP * INHIST_LINE_CAP);
        _inhist_lens = alloc(INHIST_CAP * 8);
    }
    _inhist_count = 0;
    _inhist_head = 0;
    _inhist_cur = 0;
    return 0;
}

# _inhist_phys: physical slot index for logical entry i (0 = oldest .. count-1 = newest).
fn _inhist_phys(i) { return (_inhist_head + i) % INHIST_CAP; }

fn inhist_count() { return _inhist_count; }
fn inhist_entry_ptr(i) { return _inhist_buf + _inhist_phys(i) * INHIST_LINE_CAP; }
fn inhist_entry_len(i) { return load64(_inhist_lens + _inhist_phys(i) * 8); }

# _inhist_eq: byte-equality of (a,alen) and (b,blen) — the ignoredups compare.
fn _inhist_eq(a, alen, b, blen) {
    if (alen != blen) { return 0; }
    var i = 0;
    while (i < alen) { if (load8(a + i) != load8(b + i)) { return 0; } i = i + 1; }
    return 1;
}

# inhist_push: record a submitted line (ptr,len) as the new NEWEST entry. Skips an
# empty line and a line identical to the current newest (ignoredups), so Enter on a
# blank composer and re-sending the same command don't clutter recall. Truncates a
# line longer than the slot (the composer caps at COMPOSER_CAP-1 == INHIST_LINE_CAP-1,
# so this never fires in practice — defensive). Evicts the oldest in O(1) when full
# (the same ring shape as src/feed.cyr). Returns 1 if stored, 0 if skipped.
fn inhist_push(ptr, len) {
    if (_inhist_buf == 0) { inhist_init(); }
    if (len <= 0) { return 0; }
    if (len > (INHIST_LINE_CAP - 1)) { len = INHIST_LINE_CAP - 1; }
    if (_inhist_count > 0) {
        var ni = _inhist_count - 1;
        if (_inhist_eq(inhist_entry_ptr(ni), inhist_entry_len(ni), ptr, len) == 1) { return 0; }
    }
    var phys = 0;
    if (_inhist_count < INHIST_CAP) {
        phys = (_inhist_head + _inhist_count) % INHIST_CAP;
        _inhist_count = _inhist_count + 1;
    } else {
        phys = _inhist_head;                                # full -> overwrite the oldest...
        _inhist_head = (_inhist_head + 1) % INHIST_CAP;     # ...and advance the ring base
    }
    var dst = _inhist_buf + phys * INHIST_LINE_CAP;
    var i = 0;
    while (i < len) { store8(dst + i, load8(ptr + i)); i = i + 1; }
    store8(dst + len, 0);
    store64(_inhist_lens + phys * 8, len);
    return 1;
}

# --- the navigation cursor (Up = older, Down = newer) ---------------------
# _inhist_cur in [0, count]: count == "the live draft" (one past the newest entry);
# count-1 == newest; 0 == oldest. The TUI stashes the draft on the transition OUT of
# the draft position (first Up) and restores it on the transition back (Down past
# the newest).

# inhist_nav_reset: return the cursor to the live draft. Called after each submit so
# the next Up starts from the newest again.
fn inhist_nav_reset() { _inhist_cur = _inhist_count; return 0; }

# inhist_nav_at_draft: 1 if the cursor is on the live draft (not showing history).
fn inhist_nav_at_draft() { if (_inhist_cur >= _inhist_count) { return 1; } return 0; }

fn inhist_nav_pos() { return _inhist_cur; }

# inhist_nav_up: move toward an OLDER entry. Returns the logical entry index now shown
# (>= 0), or -1 when there is no history at all. Clamps at the oldest (reloading it is
# idempotent). The caller stashes the draft first iff it was at_draft.
fn inhist_nav_up() {
    if (_inhist_count == 0) { return 0 - 1; }
    if (_inhist_cur > 0) { _inhist_cur = _inhist_cur - 1; }
    return _inhist_cur;
}

# inhist_nav_down: move toward a NEWER entry. Returns the logical entry index now shown
# (>= 0), or -1 meaning "restore the live draft" (the cursor stepped past the newest).
fn inhist_nav_down() {
    if (_inhist_cur < _inhist_count) { _inhist_cur = _inhist_cur + 1; }
    if (_inhist_cur >= _inhist_count) { return 0 - 1; }
    return _inhist_cur;
}

# --- I/O: OPT-IN on-disk persistence (0.11.2) -----------------------------
# OFF by default: only when `[history].file` is configured (the TUI passes that path
# in — this module never forward-references config). The file holds the user's typed
# composer lines, so it MAY contain secrets they typed; we create it with mode 0x180
# (0600, `rw-------`) so a freshly-created file is owner-only on POSIX targets. The
# doctrine is degrade-closed + HONEST: a path that cannot be written is announced and
# persistence stays OFF, never silently faked.
#
# SECURITY HONESTY — the 0600 guarantee is BEST-EFFORT, not asserted as fact (the
# runtime banner never prints a mode it cannot universally verify):
#   - The mode is applied by the kernel only on CREATE. If `[history].file` points at a
#     PRE-EXISTING file with looser perms, O_TRUNC keeps those perms — we do NOT silently
#     re-tighten (no portable fchmod: sys_chmod is absent on Windows + a frozen-ABI no-op
#     on AGNOS, so calling it would fork the floor / break the --win lane). Keep the file
#     in an owner-only directory and don't point it at a world-readable file.
#   - On AGNOS the create-mode is dropped by the frozen-ABI open bridge (a documented
#     substrate gap), so the file lands at the kernel default there.
#   - The path is opened FOLLOWING symlinks (no portable O_NOFOLLOW), so a hostile
#     directory could redirect it — put it somewhere only you can write.
# These residuals are DOCUMENTED here + in .thoth/config.cyml.example rather than asserted away.
#
# Model: rewrite-the-ring (not append). On load we stream the file in and push each
# line through `inhist_push` (ring keeps the most-recent INHIST_CAP, deduped). Init is
# NON-DESTRUCTIVE — it only probes writability (create-if-absent without truncating), so
# merely starting thoth never rewrites/trims the user's file; the rewrite happens on the
# first stored submit (`inhist_persist_save` truncates + rewrites FROM the ring), keeping
# the file bounded at <= INHIST_CAP lines. Not atomic and not locked: a hard kill
# mid-rewrite or two concurrent thoths sharing one file is last-writer-wins (known limit).
#
# Uses the PORTABLE lib/io.cyr wrappers (`file_open`/`file_read`/`file_write`/
# `file_close`) which bridge the AGNOS `AO_*`/namelen open ABI — never a raw sys_open.

var _inhist_path = 0;          # the active history-file path (cstr), or 0 == persistence OFF
var _inhist_broke = 0;         # 1 if a save failed mid-session (persistence auto-disabled)
var INHIST_MODE = 0x180;       # 0600 rw------- — the CREATE mode (owner-only; best-effort)
var INHIST_CHUNK = 4096;       # read-buffer size for streaming the file in on load
var _inhist_chunk = 0;         # alloc(INHIST_CHUNK), lazy — load read buffer
var _inhist_line = 0;          # alloc(INHIST_LINE_CAP), lazy — load line accumulator
var _inhist_esc = 0;           # alloc(INHIST_LINE_CAP*2), lazy — save escape scratch (worst-case 2x)

# --- newline escaping (0.11.9) --------------------------------------------
# The composer is multi-line now (Shift/Alt-Enter), so a STORED entry may contain '\n'.
# The file is line-oriented (one entry per physical line), so embedded newlines are
# escaped on write and decoded on read; the raw '\n' stays the entry terminator. Encoding:
# '\' -> '\\', newline -> '\' 'n'. The decoder is BACKWARD-COMPATIBLE with pre-0.11.9
# files: only '\n' and '\\' are recognized escapes; a stray '\X' (e.g. a Windows path
# typed before 0.11.9) is preserved verbatim (the backslash is NOT eaten). The one
# residual: a pre-0.11.9 entry that literally held the two chars '\' 'n' decodes to a
# newline on its first load — it self-heals on the next save (re-escaped as '\\n').

# _inhist_escape_into: write the escaped form of (src,srclen) into dst (cap dstcap),
# returning the encoded byte length. '\' and newline are 2-byte escapes; all else passes
# through. Bounded by dstcap-1 per store (no overrun); dst sized INHIST_LINE_CAP*2 never
# truncates a <= INHIST_LINE_CAP-1 entry.
fn _inhist_escape_into(dst, dstcap, src, srclen) {
    var o = 0;
    var i = 0;
    while (i < srclen) {
        var b = load8(src + i);
        if (b == 92) {                                       # '\' -> '\\'
            if (o < (dstcap - 1)) { store8(dst + o, 92); o = o + 1; }
            if (o < (dstcap - 1)) { store8(dst + o, 92); o = o + 1; }
        } elif (b == 10) {                                   # newline -> '\' 'n'
            if (o < (dstcap - 1)) { store8(dst + o, 92); o = o + 1; }
            if (o < (dstcap - 1)) { store8(dst + o, 110); o = o + 1; }
        } else {
            if (o < (dstcap - 1)) { store8(dst + o, b); o = o + 1; }
        }
        i = i + 1;
    }
    return o;
}

# _inhist_load_file: stream `path` in, splitting on '\n', pushing each line through the
# ring (ignoredups/skip-empty/evict apply, so the ring keeps the most-recent CAP). A
# missing/unreadable file is a no-op (no history yet). Bounded buffers — an overlong
# line (we never write one) drops its overflow tail rather than overrun.
fn _inhist_load_file(path) {
    var fd = file_open(path, 0, 0);          # O_RDONLY (0); <0 if absent -> nothing to load
    if (fd < 0) { return 0; }
    if (_inhist_chunk == 0) { _inhist_chunk = alloc(INHIST_CHUNK); }
    if (_inhist_line == 0) { _inhist_line = alloc(INHIST_LINE_CAP); }
    var llen = 0;
    var esc = 0;                                 # 1 if the previous byte was an unconsumed '\' (spans chunks)
    var go = 1;
    while (go == 1) {
        var n = file_read(fd, _inhist_chunk, INHIST_CHUNK);
        if (n <= 0) { go = 0; }
        else {
            var i = 0;
            while (i < n) {
                var b = load8(_inhist_chunk + i);
                if (esc == 1) {                                  # resolve the pending '\' escape
                    esc = 0;
                    if (b == 110) {                              # '\n' -> embedded newline
                        if (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, 10); llen = llen + 1; }
                    } elif (b == 92) {                           # '\\' -> literal backslash
                        if (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, 92); llen = llen + 1; }
                    } elif (b == 10) {                           # '\' at line end (foreign) -> literal '\', then terminate
                        if (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, 92); llen = llen + 1; }
                        inhist_push(_inhist_line, llen); llen = 0;
                    } else {                                     # stray '\X' (pre-0.11.9) -> preserve both bytes
                        if (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, 92); llen = llen + 1; }
                        if (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, b); llen = llen + 1; }
                    }
                } elif (b == 92) { esc = 1; }                    # '\' -> begin an escape
                elif (b == 10) { inhist_push(_inhist_line, llen); llen = 0; }   # raw newline -> end of entry
                elif (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, b); llen = llen + 1; }
                i = i + 1;
            }
        }
    }
    if (esc == 1) {                              # dangling '\' at EOF -> literal backslash
        if (llen < (INHIST_LINE_CAP - 1)) { store8(_inhist_line + llen, 92); llen = llen + 1; }
    }
    if (llen > 0) { inhist_push(_inhist_line, llen); }   # a trailing line with no newline
    file_close(fd);
    return 0;
}

# _inhist_probe_writable: NON-DESTRUCTIVE writability check — create the file at 0600 if
# absent (O_CREAT, NO O_TRUNC), or open an existing one WITHOUT touching its content, then
# close. Returns 0 if writable, -1 otherwise. So binding persistence never mutates/trims
# the user's file on mere startup.
fn _inhist_probe_writable(path) {
    var fd = file_open(path, O_WRONLY | O_CREAT, INHIST_MODE);   # no O_TRUNC -> content preserved
    if (fd < 0) { return 0 - 1; }
    file_close(fd);
    return 0;
}

# _inhist_write_file: truncate + rewrite `path` from the ring (oldest->newest, one ESCAPED
# line each + a raw '\n' terminator — embedded newlines from the multi-line composer are
# escaped, see _inhist_escape_into). Returns 0 on success, -1 if the file cannot be opened
# OR a write short-writes (so the caller degrades closed rather than silently leaving a
# truncated file). Created 0600 if absent (best-effort — see the header note on perms).
fn _inhist_write_file(path) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, INHIST_MODE);
    if (fd < 0) { return 0 - 1; }
    if (_inhist_esc == 0) { _inhist_esc = alloc(INHIST_LINE_CAP * 2); }
    var ok = 0;
    var i = 0;
    while (i < _inhist_count) {
        var enc = _inhist_escape_into(_inhist_esc, INHIST_LINE_CAP * 2, inhist_entry_ptr(i), inhist_entry_len(i));
        if (file_write(fd, _inhist_esc, enc) != enc) { ok = 0 - 1; }   # short/failed write
        if (file_write(fd, "\n", 1) != 1) { ok = 0 - 1; }
        i = i + 1;
    }
    file_close(fd);
    return ok;
}

# inhist_persist_init: bind persistence to `path` (0 -> OFF). Loads any existing file into
# the ring, resets the nav cursor to the draft past the loaded entries, then NON-
# DESTRUCTIVELY probes writability (create-if-absent at 0600, no truncate). Returns the
# number of entries recalled (>=0) on success, or -1 if the path is set but unwritable
# (persistence stays OFF; the ring is still usable in-memory).
fn inhist_persist_init(path) {
    _inhist_path = 0;
    _inhist_broke = 0;
    if (path == 0) { return 0; }                 # not configured -> persistence OFF
    _inhist_load_file(path);
    inhist_nav_reset();                          # cursor -> draft, past the loaded entries
    if (_inhist_probe_writable(path) < 0) { return 0 - 1; }   # unwritable -> announce + stay OFF
    _inhist_path = path;                         # persistence ACTIVE
    return inhist_count();
}

# inhist_persist_active: 1 if persistence is bound to a writable file.
fn inhist_persist_active() { if (_inhist_path != 0) { return 1; } return 0; }

# inhist_persist_broke / _ack: 1 if a save FAILED mid-session (persistence was auto-
# disabled); the TUI reads + acks it to announce the degrade ONCE, never silently faked.
fn inhist_persist_broke() { return _inhist_broke; }
fn inhist_persist_broke_ack() { _inhist_broke = 0; return 0; }

# inhist_persist_save: rewrite the history file from the ring, if persistence is active
# (else a no-op). Called by the TUI after each line is STORED in the ring on submit. On a
# write FAILURE it degrades closed — disables persistence + raises the broke flag — so the
# user is told it stopped, rather than believing their history is still being saved.
fn inhist_persist_save() {
    if (_inhist_path == 0) { return 0; }
    if (_inhist_write_file(_inhist_path) < 0) {
        _inhist_path = 0;            # stop trying (degrade closed)
        _inhist_broke = 1;          # the TUI announces this once
    }
    return 0;
}
