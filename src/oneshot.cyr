# thoth — one-shot / argv front-door (0.11.0).
#
# thoth's primary surface is the interactive TUI / line-REPL. This module adds a
# NON-interactive one-shot mode so thoth is a first-class shell citizen for the
# coding workflow:
#
#   thoth 'review this diff'              # run one task, print the answer, exit
#   git diff | thoth 'review this'        # piped stdin is APPENDED to the task
#   cat err.log | thoth 'explain'         # ditto
#   thoth -p < prompt.txt                 # piped stdin IS the whole task
#   thoth 'summarize' | thoth 'critique'  # chains cleanly (stdout = answer only)
#   thoth --version | thoth --help
#
# It owns NO new spine path: a one-shot turn runs through the EXISTING
# cmd_task -> hoosh_send / agent_turn seam. It only adds a new INPUT SOURCE (argv +
# slurped stdin) and a clean OUTPUT contract.
#
# Mode selection is gated on EXPLICIT argv intent, NOT on `isTTY == false`: piped
# stdin already has meaning (the line-by-line REPL), so silently slurping it would
# change existing behavior. With no argv task thoth falls through to the TUI/REPL
# unchanged — the piped/CI floor is byte-identical. See ADR-0011.
#
# Clean stdout: the turn runs with output DISCARDED (OUT_NULL) so none of the
# human-progress chrome leaks; one_shot_run then prints ONLY the final answer (the
# hoosh reply accumulator) to fd 1. Diagnostics go to stderr (fd 2). The exit code
# is 0 on a real answer, nonzero otherwise (degrade closed).

var ONESHOT_NONE = 0;       # no argv task -> fall through to the TUI / REPL
var ONESHOT_RUN = 1;        # run one-shot with the parsed task
var ONESHOT_VERSION = 2;    # print the version and exit
var ONESHOT_HELP = 3;       # print usage and exit
var ONESHOT_COMPLETION = 4; # print a shell-completion script and exit (0.11.8)

# --completion <shell> (0.11.8): a print-and-exit mode (like --version/--help) that emits a
# bash or zsh completion script for thoth's argv flags + an -o filename to stdout. The shell
# name is the NEXT argv token (optional -> defaults to bash). The script is static text thoth
# EMITS (the shell runs it; thoth never executes it) — no spine path, no security surface.
var _oneshot_compl_shell = 0;   # the shell-name cstr captured from argv, or 0 (-> bash)

# --json / -j (0.11.6): a MODIFIER flag (orthogonal to the mode) — set by the parser, read by
# one_shot_run to print a single JSON envelope instead of the plain reply. It does NOT force a
# run on its own (a positional task or -p is still the run intent); `thoth --json` alone falls
# through to the TUI like any no-task invocation.
var _oneshot_json = 0;

# -o / --out <file> (0.11.7): a MODIFIER flag that TEES the answer (plain reply or the --json
# envelope) to <file> as well as stdout. The flag CONSUMES the next argv token as the path
# (verbatim). It is the user's OWN redirection (like shell `>`) — NOT t-ron-gated (t-ron gates
# the MODEL writing files via /write; choosing where thoth's own output goes is not a model
# action; the path is fixed from argv before the turn runs, so the model can't influence it).
var _oneshot_out_path = 0;   # cstr ptr into the argv snapshot, or 0

# --tier <mode> (0.11.10): a global MODIFIER flag selecting the presentation tier — auto
# (default) / rich (TUI) / simple (line). NOT a one-shot mode and NOT a run-forcer: it applies to
# the interactive TUI/REPL selection (and is harmless in one-shot). Parsed here (before
# ui_detect_tier runs in main); the parser stays PURE — it only sets these globals (unit-tested),
# and src/main.cyr applies them via ui_set_tier_pref + reports a bad value to stderr. Replaces the
# old THOTH_TIER env-var (dropped in 0.11.10). Accepts `--tier=<mode>` and `--tier <mode>`.
var _oneshot_tier = 0;       # the parsed TIER_* preference (default TIER_AUTO == 0)
var _oneshot_tier_bad = 0;   # 1 if --tier was given an unknown value (main warns; falls back to auto)
fn oneshot_tier() { return _oneshot_tier; }
fn oneshot_tier_bad() { return _oneshot_tier_bad; }

# The JSON envelope buffer (lazy). Sized for a worst-case 6x-escaped max reply (HOOSH_ACC_CAP)
# + a 6x-escaped model id (MODEL_BUF_CAP — a session /model id; a normal [hoosh].model id is
# far shorter) + the fixed framing/ints, with headroom — so the escape core's cap-stop never
# triggers and the object is always complete, valid JSON. Memory-safe regardless (every
# append/escape is cap-bounded); only a pathological multi-KB config `model` value could clip
# the field — the same accepted bound the hoosh request builders already carry.
var ONESHOT_JSON_CAP = 0;   # computed at first use (HOOSH_ACC_CAP*6 + MODEL_BUF_CAP*6 + 256)
var _oneshot_json_buf = 0;

# The assembled task (argv positionals joined by spaces, then the stdin payload).
# Lazily heap-allocated so the .bss stays small; bounded — overflow truncates (long
# content belongs on stdin, but the cap is a hard safety bound either way).
var ONESHOT_TASK_CAP = 65536;
var _oneshot_task = 0;
var _oneshot_task_len = 0;

# A snapshot of argv (cstr ptrs) so the per-arg classifier is a PURE function the
# test suite can drive with a hand-built array (argc/argv read /proc/self/cmdline).
var ONESHOT_ARGV_MAX = 64;
var _oneshot_argv[512];     # ONESHOT_ARGV_MAX * 8 bytes

fn _oneshot_task_reset() {
    if (_oneshot_task == 0) { _oneshot_task = alloc(ONESHOT_TASK_CAP); }
    _oneshot_task_len = 0;
    store8(_oneshot_task, 0);
    return 0;
}

# _oneshot_task_append: append n bytes, clamped to the cap (one byte reserved for the
# NUL). Returns the bytes actually appended.
fn _oneshot_task_append(ptr, n) {
    if (_oneshot_task == 0) { _oneshot_task_reset(); }
    var room = ONESHOT_TASK_CAP - 1 - _oneshot_task_len;
    if (n > room) { n = room; }
    if (n <= 0) { return 0; }
    memcpy(_oneshot_task + _oneshot_task_len, ptr, n);
    _oneshot_task_len = _oneshot_task_len + n;
    store8(_oneshot_task + _oneshot_task_len, 0);
    return n;
}
fn _oneshot_task_append_cstr(s) { return _oneshot_task_append(s, strlen(s)); }

# _oneshot_parse: classify a snapshot of argv (args = ptr to an array of n cstr ptrs,
# args[0] = program name) into a mode, assembling the task from positional (non-flag)
# args joined by single spaces. PURE (no I/O) — unit-tested. `-v`/`--version` and
# `-h`/`--help` short-circuit; `-p`/`--print` forces one-shot (task may then come
# wholly from stdin). A positional arg is the explicit one-shot intent.
# _oneshot_set_tier: map a --tier value to the TIER_* pref (src/ui.cyr) and record it, or flag an
# unknown value. No I/O — main reports the bad flag (keeps the parser pure/testable).
fn _oneshot_set_tier(v) {
    var p = ui_tier_pref_from_name(v);
    if (p >= 0) { _oneshot_tier = p; } else { _oneshot_tier_bad = 1; }
    return 0;
}

fn _oneshot_parse(args, n) {
    _oneshot_json = 0;                          # reset BEFORE the early return (no stale flag)
    _oneshot_out_path = 0;
    _oneshot_compl_shell = 0;
    _oneshot_tier = 0;                          # default TIER_AUTO
    _oneshot_tier_bad = 0;
    if (n <= 1) { return ONESHOT_NONE; }
    _oneshot_task_reset();
    var positional = 0;
    var force = 0;
    var i = 1;
    while (i < n) {
        var a = load64(args + i * 8);
        if ((streq(a, "--version") == 1) || (streq(a, "-v") == 1)) { return ONESHOT_VERSION; }
        if ((streq(a, "--help") == 1) || (streq(a, "-h") == 1)) { return ONESHOT_HELP; }
        if ((streq(a, "--completion") == 1) || (streq(a, "--completions") == 1)) {
            # capture the shell (the next token, optional) and short-circuit, like --version
            if ((i + 1) < n) { _oneshot_compl_shell = load64(args + (i + 1) * 8); }
            return ONESHOT_COMPLETION;
        }
        if ((streq(a, "-p") == 1) || (streq(a, "--print") == 1)) { force = 1; }
        elif ((streq(a, "--json") == 1) || (streq(a, "-j") == 1)) { _oneshot_json = 1; }
        elif ((streq(a, "-o") == 1) || (streq(a, "--out") == 1)) {
            # consume the NEXT token as the output path (verbatim). A dangling -o at the end
            # has no path -> ignored (path stays 0). Like --json, -o does not force a run.
            if ((i + 1) < n) { _oneshot_out_path = load64(args + (i + 1) * 8); i = i + 1; }
        }
        elif (cstr_starts_with(a, "--tier=") == 1) { _oneshot_set_tier(a + 7); }   # --tier=<mode>
        elif (streq(a, "--tier") == 1) {
            # --tier <mode>: consume the NEXT token as the value — but ONLY a real value, never a
            # following flag (tier names never start with '-'). So `--tier --version` does NOT eat
            # `--version` (it's processed normally); a dangling `--tier` is ignored (stays auto).
            # Does not force a run / is not a positional (like -o/--json).
            if ((i + 1) < n) {
                var nxt = load64(args + (i + 1) * 8);
                if (load8(nxt) != 45) { _oneshot_set_tier(nxt); i = i + 1; }   # 45 == '-'
            }
        }
        else {
            if (positional > 0) { _oneshot_task_append_cstr(" "); }
            _oneshot_task_append_cstr(a);
            positional = positional + 1;
        }
        i = i + 1;
    }
    if ((positional > 0) || (force == 1)) { return ONESHOT_RUN; }
    return ONESHOT_NONE;
}

# oneshot_mode: snapshot argc/argv and classify. Reads the command line via the
# portable args API (argc/argv over /proc/self/cmdline on Linux, the captured rsp on
# AGNOS — capped at 8 there, so long tasks belong on stdin).
fn oneshot_mode() {
    var n = argc();
    if (n > ONESHOT_ARGV_MAX) { n = ONESHOT_ARGV_MAX; }
    var i = 0;
    while (i < n) {
        store64(&_oneshot_argv + i * 8, argv(i));
        i = i + 1;
    }
    return _oneshot_parse(&_oneshot_argv, n);
}

# _oneshot_append_stdin: slurp ALL of stdin and append it to the task as the payload
# (a blank-line separator first if an argv task is already present). Only called when
# stdin is NOT a tty (a real pipe/redirect) — never blocks an interactive terminal.
fn _oneshot_append_stdin() {
    var chunk[4096];
    var first = 1;
    var rd = 1;
    while (rd > 0) {
        rd = syscall(SYS_READ, 0, &chunk, 4096);
        if (rd > 0) {
            if (first == 1) {
                if (_oneshot_task_len > 0) { _oneshot_task_append("\n\n", 2); }
                first = 0;
            }
            _oneshot_task_append(&chunk, rd);
        }
    }
    return 0;
}

# emit_err_int: write a non-negative int to stderr (fd 2). For the HTTP-status error.
fn emit_err_int(v) {
    var b[24];
    var ln = fmt_int_buf(v, &b);
    emit_err_n(&b, ln);
    return 0;
}

# oneshot_print_version / oneshot_print_help: the --version / --help output. These ARE
# the requested output, so they go to stdout (emit_raw, mode-blind).
fn oneshot_print_version() {
    emit_raw("thoth "); emit_raw(thoth_version()); emit_raw("\n");
    return 0;
}
fn oneshot_print_help() {
    emit_raw("thoth — sovereign agentic coding TUI\n\n");
    emit_raw("Usage:\n");
    emit_raw("  thoth                     start the interactive TUI / REPL\n");
    emit_raw("  thoth <task>...           run one task through the model, print the answer, exit\n");
    emit_raw("  cmd | thoth <task>...     append piped stdin to the task (e.g. git diff | thoth 'review')\n");
    emit_raw("  cmd | thoth -p            use piped stdin as the whole task\n");
    emit_raw("  thoth --json <task>...    emit one JSON object per turn (for jq/CI)\n");
    emit_raw("  thoth -o <file> <task>... also write the answer to <file> (your redirect)\n");
    emit_raw("  thoth -v, --version       print the version\n");
    emit_raw("  thoth -h, --help          show this help\n");
    emit_raw("  thoth --completion <sh>   print a bash|zsh completion script (source it)\n");
    emit_raw("  thoth --tier <mode>       presentation tier: auto (default) | rich (TUI) | simple (line)\n\n");
    emit_raw("One-shot mode is non-interactive: only the answer goes to stdout (so it pipes\n");
    emit_raw("cleanly); progress is suppressed and an action needing authorization is denied\n");
    emit_raw("(configure [tron].policy or run interactively). Config: thoth.cyml.\n\n");
    emit_raw("--json (or -j) prints {response, model, turns, tokens?, cost?, elapsed_ms} per\n");
    emit_raw("turn instead of the plain answer; tokens/cost appear only once reported. On any\n");
    emit_raw("failure nothing goes to stdout (diagnostic on stderr, nonzero exit).\n\n");
    emit_raw("-o / --out <file> tees the answer to <file> as well as stdout (it is your own\n");
    emit_raw("redirection, like `>`, NOT security-gated). The file is created at `>`-like\n");
    emit_raw("default perms (umask-respecting; on AGNOS the mode is dropped) — keep secret-\n");
    emit_raw("bearing output in an owner-only directory. A write failure exits nonzero.\n\n");
    emit_raw("--completion (or --completions) <sh> prints a bash or zsh script; source it to\n");
    emit_raw("tab-complete thoth's flags and -o files (default shell: bash). e.g.\n");
    emit_raw("  source <(thoth --completion bash)\n");
    return 0;
}

# oneshot_print_completion: emit the bash or zsh completion script for `_oneshot_compl_shell`
# (default bash) to stdout (emit_raw, mode-blind). Returns 0, or 1 for an unsupported shell
# (announced on stderr — degrade closed, nothing to stdout). The scripts are STATIC TEXT thoth
# emits; the shell runs them, thoth never executes them (no spine path, no security surface).
fn oneshot_print_completion() {
    var sh = _oneshot_compl_shell;
    if (sh == 0) { sh = "bash"; }
    if (streq(sh, "bash") == 1) { _completion_bash(); return 0; }
    if (streq(sh, "zsh") == 1) { _completion_zsh(); return 0; }
    emit_err("thoth: unsupported shell for --completion: ");
    emit_err(sh);
    emit_err(" (try: bash, zsh)\n");
    return 1;
}

# _completion_bash: the bash completion script (one emit_raw per line). The flag list MIRRORS
# _oneshot_parse (the source of truth) — keep in sync. Cyrius literals: `$` is literal; an inner
# `"` is `\"`; the flag list uses single quotes (literal) to minimize escaping.
fn _completion_bash() {
    emit_raw("# thoth bash completion. Source it:  source <(thoth --completion bash)\n");
    emit_raw("# (flags mirror _oneshot_parse in src/oneshot.cyr; keep in sync)\n");
    emit_raw("_thoth_complete() {\n");
    emit_raw("    local cur prev\n");
    emit_raw("    cur=\"${COMP_WORDS[COMP_CWORD]}\"\n");
    emit_raw("    prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n");
    emit_raw("    case \"$prev\" in\n");
    emit_raw("        -o|--out)\n");
    emit_raw("            COMPREPLY=( $(compgen -f -- \"$cur\") )\n");
    emit_raw("            return 0\n");
    emit_raw("            ;;\n");
    emit_raw("        --completion|--completions)\n");
    emit_raw("            COMPREPLY=( $(compgen -W 'bash zsh' -- \"$cur\") )\n");
    emit_raw("            return 0\n");
    emit_raw("            ;;\n");
    emit_raw("        --tier)\n");
    emit_raw("            COMPREPLY=( $(compgen -W 'auto rich simple' -- \"$cur\") )\n");
    emit_raw("            return 0\n");
    emit_raw("            ;;\n");
    emit_raw("    esac\n");
    emit_raw("    if [[ \"$cur\" == -* ]]; then\n");
    emit_raw("        COMPREPLY=( $(compgen -W '-p --print --json -j -o --out --tier -v --version -h --help --completion --completions' -- \"$cur\") )\n");
    emit_raw("    else\n");
    emit_raw("        COMPREPLY=( $(compgen -f -- \"$cur\") )\n");
    emit_raw("    fi\n");
    emit_raw("}\n");
    emit_raw("complete -F _thoth_complete thoth\n");
    return 0;
}

# _completion_zsh: the zsh completion script (source-style — ends with `compdef _thoth thoth`;
# fpath users prepend a #compdef line, noted in the script). The flag list MIRRORS _oneshot_parse
# — keep in sync. Cyrius literals: single quotes are literal; the only escape is a trailing
# line-continuation `\` (written `\\`); the script has no `$` and no inner `"`.
fn _completion_zsh() {
    emit_raw("# thoth zsh completion. Source it:  source <(thoth --completion zsh)\n");
    emit_raw("# (fpath users: prepend a #compdef thoth line and save this as _thoth on your fpath.)\n");
    emit_raw("# (flags mirror _oneshot_parse in src/oneshot.cyr; keep in sync)\n");
    emit_raw("_thoth() {\n");
    emit_raw("    _arguments -s \\\n");
    emit_raw("        '(-p --print)'{-p,--print}'[use piped stdin as the whole task]' \\\n");
    emit_raw("        '(--json -j)'{--json,-j}'[emit one JSON object per turn (jq/CI)]' \\\n");
    emit_raw("        '(-o --out)'{-o,--out}'[tee the answer to a file]:output file:_files' \\\n");
    emit_raw("        '(-v --version)'{-v,--version}'[print the version]' \\\n");
    emit_raw("        '(-h --help)'{-h,--help}'[show this help]' \\\n");
    emit_raw("        '(--completion --completions)'{--completion,--completions}'[print a shell completion script]:shell:(bash zsh)' \\\n");
    emit_raw("        '--tier[presentation tier]:tier:(auto rich simple)' \\\n");
    emit_raw("        '*::task:_files'\n");
    emit_raw("}\n");
    emit_raw("compdef _thoth thoth\n");
    return 0;
}

# _oneshot_report_error: a concise stderr diagnostic when a one-shot turn produced no
# answer. Derived from the seam status + the turn's return code (the verbose gateway
# body went to the discarded sink; run interactively or with [hoosh].stream=false for it).
fn _oneshot_report_error(rc) {
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        emit_err("thoth: no model backend wired — set [hoosh].url in thoth.cyml (degraded, not faked)\n");
        return 0;
    }
    if (rc < 0) { emit_err("thoth: hoosh gateway unreachable (transport error) — is it up?\n"); return 0; }
    if (rc > 0) {
        emit_err("thoth: hoosh returned HTTP "); emit_err_int(rc);
        emit_err(" (run interactively or set [hoosh].stream=false to see the body)\n");
        return 0;
    }
    emit_err("thoth: no completion returned\n");
    return 0;
}

# oneshot_json_envelope: serialize one turn's result as a single JSON object into dst (cap
# bounded, NUL-terminated), returning the byte length:
#   {"response":<reply>,"model":<id>,"turns":N[,"tokens":N][,"cost":"$d.cc"],"elapsed_ms":N}
# `reply`/`reply_len` is the model's text (held BY LENGTH — escaped with the length-bounded
# escaper so an embedded NUL survives). `tokens`/`cost` follow ADR-0010 omit-until-present
# (shown only once hoosh reports usage / a [pricing] rate prices it — never a faked 0/$0).
# `elapsed_ms` is passed in (one_shot_run measures it) so this stays a pure, testable function.
fn oneshot_json_envelope(dst, cap, reply, reply_len, elapsed_ms) {
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "{\"response\":\"");
    off = _json_escape_n_into_cap(dst, off, cap, reply, reply_len);
    off = _append_cstr_cap(dst, off, cap, "\",\"model\":\"");
    off = _json_escape_into_cap(dst, off, cap, hoosh_model_cur());
    off = _append_cstr_cap(dst, off, cap, "\",\"turns\":");
    off = _append_int(dst, off, session_turns());
    if (session_tokens_seen() == 1) {
        off = _append_cstr_cap(dst, off, cap, ",\"tokens\":");
        off = _append_int(dst, off, session_tokens());
    }
    if (session_cost_seen() == 1) {
        var cb[24];
        cost_fmt(&cb, session_cost_micro());
        off = _append_cstr_cap(dst, off, cap, ",\"cost\":\"");
        off = _json_escape_into_cap(dst, off, cap, &cb);
        off = _append_cstr_cap(dst, off, cap, "\"");
    }
    off = _append_cstr_cap(dst, off, cap, ",\"elapsed_ms\":");
    off = _append_int(dst, off, elapsed_ms);
    off = _append_cstr_cap(dst, off, cap, "}");
    store8(dst + off, 0);
    return off;
}

# _oneshot_write_out: TEE the answer to `path` for the `-o` flag — write `buf[0..len)` plus a
# trailing newline (if absent) so the file matches stdout byte-for-byte. Create + truncate at
# 0644 (the `>`-like default; the user's OWN argv-named redirection — NOT t-ron-gated, since the
# path is fixed from argv before the turn and the model can't influence it). Portable via the
# lib/io.cyr wrappers (the AGNOS `AO_*` open bridge — never a raw `sys_open`). Returns 0 on
# success, -1 on any open / short / newline write failure (so one_shot_run degrades closed).
fn _oneshot_write_out(path, buf, len) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);   # 0x1A4 = 0644
    if (fd < 0) { return 0 - 1; }
    var w = file_write(fd, buf, len);
    if (w == len) {
        if ((len == 0) || (load8(buf + len - 1) != 10)) {
            if (file_write(fd, "\n", 1) != 1) { w = 0 - 1; }   # drop into the w != len failure
        }
    }
    file_close(fd);
    if (w != len) { return 0 - 1; }
    return 0;
}

# one_shot_run: execute the assembled one-shot task and print only the clean answer to
# stdout (and tee it to the `-o` file when requested). Returns the process exit code (0 = a
# real answer + any -o write succeeded, 1 = any failure). Assumes oneshot_mode() filled
# _oneshot_task. I/O — the orchestrator for one-shot.
fn one_shot_run() {
    # Append piped stdin as the payload (never read an interactive tty here).
    if (tty_isatty(0) == 0) { _oneshot_append_stdin(); }
    if (_oneshot_task_len == 0) {
        emit_err("thoth: no task given (provide it on argv, or pipe it in with -p)\n");
        return 1;
    }
    # Run the turn through the existing seam with output discarded, then print only the
    # accumulated reply to fd 1 — so stdout is exactly the answer (clean for piping).
    var t0 = clock_now_ms();
    out_mode_set(OUT_NULL);
    var rc = cmd_task(_oneshot_task);
    out_mode_set(OUT_FD1);
    var elapsed = clock_now_ms() - t0;
    if (elapsed < 0) { elapsed = 0; }            # guard a non-monotonic clock step
    if ((rc == 0) && (hoosh_last_reply_len() > 0)) {
        # Compute the output bytes ONCE — the plain reply, or the JSON envelope.
        var obuf = hoosh_last_reply();
        var olen = hoosh_last_reply_len();
        if (_oneshot_json == 1) {
            # one JSON object (clean for jq/CI); honest fields (tokens/cost omit-until-present),
            # the buffer sized so it never truncates.
            if (_oneshot_json_buf == 0) {
                ONESHOT_JSON_CAP = HOOSH_ACC_CAP * 6 + MODEL_BUF_CAP * 6 + 256;
                _oneshot_json_buf = alloc(ONESHOT_JSON_CAP);
            }
            olen = oneshot_json_envelope(_oneshot_json_buf, ONESHOT_JSON_CAP, obuf, olen, elapsed);
            obuf = _oneshot_json_buf;
        }
        # TEE the SAME bytes to the -o file (the user's own redirection) and to stdout, each
        # with a trailing newline if absent — identical bytes to both sinks.
        var orc = 0;
        if (_oneshot_out_path != 0) { orc = _oneshot_write_out(_oneshot_out_path, obuf, olen); }
        emit_raw_n(obuf, olen);
        if ((olen == 0) || (load8(obuf + olen - 1) != 10)) { emit_raw("\n"); }
        if (orc < 0) {
            # the user asked for a file and we couldn't deliver it -> degrade closed (the
            # answer still reached stdout; the failure is announced + a nonzero exit).
            emit_err("thoth: could not write -o file ("); emit_err(_oneshot_out_path); emit_err(")\n");
            return 1;
        }
        return 0;
    }
    # Failure: nothing to stdout in EITHER mode (no partial/invalid JSON) — a concise
    # diagnostic to stderr and a nonzero exit; the jq/CI consumer checks the exit code.
    _oneshot_report_error(rc);
    return 1;
}
