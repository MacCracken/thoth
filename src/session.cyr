# thoth — session state + the avatara persona overlay.
#
# Session state is plain globals: one interactive session per process. The
# avatara seam is NATIVE (M5): the Thoth/Librarian persona is SOURCED from the
# vendored avatara archetype bundle (egyptian_thoth() + the prof_* accessors),
# in-process — thoth READS the emitted profile and authors only profile->string
# glue, NOT a reimplementation of avatara (ADR-0003). The "the Librarian" role
# and the THOTH backronym tagline are thoth's own overlay framing over avatara's
# Egyptian wisdom-scribe archetype. No top-level execution; included by main and
# by the test suite.

var _sess_turns = 0;
var _sess_model = 0;     # 0 = none; else a cstring model id

# Token accounting (0.10.2): the running sum of hoosh-reported usage.total_tokens
# across this session, and whether ANY usage has been reported. The pair is the
# honest-omit contract (ADR-0010): _sess_tokens_seen distinguishes "0 tokens" from
# "no usage yet" so the status field omits until hoosh actually returns usage and
# is never faked with a placeholder. hoosh owns the count; thoth only sums what it
# is told. Streaming carries usage only when stream_options:{include_usage} is sent.
var _sess_tokens = 0;
var _sess_tokens_seen = 0;

# Cost accounting (0.10.3): the running session spend in integer micro-USD (1e-6
# USD), priced AT ACCUMULATE — each turn's prompt/completion tokens are multiplied
# by the ACTIVE model's [pricing.<model>] rate when the usage arrives and summed, so
# a mid-session /model switch prices each turn at the right rate (a single end-of-
# session multiply would be wrong across switches). _sess_cost_seen distinguishes
# "$0.00 priced" from "nothing priced yet" (honest-omit, ADR-0010); _sess_cost_unpriced
# counts responses whose usage arrived but whose model had no [pricing] entry, so
# /state can honestly note they were excluded rather than silently under-report.
var _sess_cost_micro = 0;
var _sess_cost_seen = 0;
var _sess_cost_unpriced = 0;

# Conversation history (0.5.1, multi-turn): a vec of message structs so the
# backing model sees prior turns. Each message is alloc(32): +0 role (a stable
# string literal "user"/"assistant"), +8 content (a STABLE COPY — the prompt
# aliases the reused input line and the streamed reply lives in a scratch buffer,
# so both must be copied), +16 turn (session_turns() at append time — 0.30.19, so the GUI feed can render each
# turn's tool cards above ITS reply; in-memory only, NOT persisted — a resumed message gets turn 0 = no cards,
# +24 model (0.33.3 — a STABLE COPY of the model id that produced an assistant reply, or 0; persisted, so a resumed
# conversation remembers which model said what — NOT the shared session._model_buf, which a mid-session switch would
# overwrite retroactively), +32 citations (0.33.4 — a lazily-alloc'd citation set: the recalled-source TITLES a reply
# cited, or 0; persisted as trailing CITE frames, so a resumed conversation keeps its cited sources), +40 tool calls
# (0.33.5 — a lazily-alloc'd set of {kind, ok, name, args} the reply produced, or 0; persisted as trailing TOOL
# frames, so a resumed conversation keeps its tool cards),
# which is honest since its rounds belong to a prior session's roundlog). Capped at SESS_HIST_MAX messages (oldest dropped) to
# bound the never-freeing bump heap; the request builder byte-budgets what it
# actually sends (see hoosh.cyr). thoth owns only this transport-side context
# window — hoosh owns the inference.
# --- multi-conversation store (0.33.0) -----------------------------------------------------------------------
# thoth holds a KEYED store of named conversations (id, title, timestamps, message list) rather than one linear
# thread. There is always an ACTIVE conversation; the session_history_* ops below operate on it, so every consumer
# (agent / hoosh / persistence / GUI) is unchanged. The switching COMMANDS + multi-conversation persistence land in
# 0.33.1 — today one conversation is active and persists as before (the store is the foundation). A conversation
# (40): [id@0, title@8 (cstr, 0 = untitled), created@16 (epoch s), updated@24 (epoch s), msgs@32 (vec of msg ptrs)].
var _conv_store = 0;         # vec of conversation ptrs, lazily created
var _conv_active = 0;        # index of the active conversation
var _sess_rewind_snap = 0;   # 0.34.0: /retry-/edit rewind snapshot (removed message ptrs) for a possible restore
var _sess_rewind_title = 0;  # 0.34.0: the active conversation's title at rewind time, reverted on a restore
var _conv_next_id = 1;       # monotonic conversation id
var SESS_HIST_MAX = 40;      # max messages kept per conversation (oldest dropped)

fn _conv_alloc(title) {
    var c = alloc(64);
    store64(c, _conv_next_id); _conv_next_id = _conv_next_id + 1;
    store64(c + 8, title);
    var now = clock_epoch_secs();
    store64(c + 16, now);
    store64(c + 24, now);
    store64(c + 32, vec_new());
    store64(c + 40, 0);          # 0.36.4: messages DROPPED from this conversation by the SESS_HIST_MAX cap
    store64(c + 48, 0);          # 0.36.4: overflow recap text (cstr, 0 = none yet)
    store64(c + 56, 0);          # 0.36.4: how many oldest messages that recap covers ([0, k))
    return c;
}
# _conv_ensure: guarantee the default active conversation exists. Called by any op that needs a conversation.
fn _conv_ensure() {
    if (_conv_store == 0) { _conv_store = vec_new(); }
    if (vec_len(_conv_store) == 0) { vec_push(_conv_store, _conv_alloc(0)); _conv_active = 0; }
    return 0;
}
# _conv_at: the conversation struct at store index `i`, CLAMPED to a valid range so no accessor built on it can
# ever hit vec_get's abort-on-OOB. After _conv_ensure the store has >= 1 entry, so the clamp always resolves. The
# 0.33.1 commands still validate a user-supplied index for UX (an error, not a silent wrong pick) — this is the
# crash-safe floor beneath them.
fn _conv_at(i) {
    _conv_ensure();
    var n = vec_len(_conv_store);
    if (i < 0) { i = 0; }
    if (i >= n) { i = n - 1; }
    return vec_get(_conv_store, i);
}

# conv_* : the store API (wired to /conversations, /new, /switch, /rename in 0.33.1). i is a store index.
fn conv_count() { if (_conv_store == 0) { return 0; } return vec_len(_conv_store); }
fn conv_active() { return _conv_active; }
fn conv_id(i) { return load64(_conv_at(i)); }
fn conv_title(i) { return load64(_conv_at(i) + 8); }          # a cstr, or 0 when untitled
fn conv_created(i) { return load64(_conv_at(i) + 16); }
fn conv_updated(i) { return load64(_conv_at(i) + 24); }
fn conv_msgs(i) { return load64(_conv_at(i) + 32); }
fn conv_set_title(i, title) { store64(_conv_at(i) + 8, title); return 0; }
fn conv_touch(i) { store64(_conv_at(i) + 24, clock_epoch_secs()); return 0; }
# 0.36.4: conv_dropped — messages this conversation LOST to the SESS_HIST_MAX cap (destructive, unrecoverable).
# Distinct from the framer's byte-budget skip (hoosh_ctx_evicted), which loses nothing.
fn conv_dropped(i) { return load64(_conv_at(i) + 40); }
# _conv_note_dropped: one message was destroyed by the cap. The recap counts messages by INDEX from the front, and
# a drop SHIFTS every index down by one — so its coverage must shrink with them, or it would claim to cover messages
# that are no longer the ones it summarized (live-caught: "4 recapped" against a 3-message skip, which then failed
# the covers==start guard and re-derived, wasting the call). Shrinking keeps the recap a SUPERSET of the skipped
# range — it still describes the messages the cap destroyed, which is exactly the fidelity we want.
fn _conv_note_dropped(i) {
    store64(_conv_at(i) + 40, load64(_conv_at(i) + 40) + 1);
    var cov = load64(_conv_at(i) + 56);
    if (cov > 0) { store64(_conv_at(i) + 56, cov - 1); }
    return 0;
}
# session_history_dropped: the ACTIVE conversation's destructive-drop count (0 = the record is complete).
fn session_history_dropped() { _conv_ensure(); return conv_dropped(_conv_active); }

# 0.36.4: the per-conversation OVERFLOW RECAP — a short text standing in for the oldest messages the request framer
# can no longer fit, and `covers` = how many of them it accounts for ([0, covers)). Derived state, never persisted:
# a resumed conversation simply re-derives it on the next overflow. Cleared by /reset and by a rewind (the recap
# would describe messages the rewind un-said).
fn conv_recap(i) { return load64(_conv_at(i) + 48); }
fn conv_recap_covers(i) { return load64(_conv_at(i) + 56); }
fn conv_set_recap(i, text, covers) { store64(_conv_at(i) + 48, text); store64(_conv_at(i) + 56, covers); return 0; }
fn session_recap() { _conv_ensure(); return conv_recap(_conv_active); }
fn session_recap_covers() { _conv_ensure(); return conv_recap_covers(_conv_active); }
fn session_set_recap(text, covers) { _conv_ensure(); return conv_set_recap(_conv_active, text, covers); }
fn session_recap_clear() { _conv_ensure(); return conv_set_recap(_conv_active, 0, 0); }
# conv_new: start a fresh conversation and make it active; returns its index.
fn conv_new() { _conv_ensure(); vec_push(_conv_store, _conv_alloc(0)); _conv_active = vec_len(_conv_store) - 1; return _conv_active; }
# conv_switch: make conversation `i` active (bounds-checked); returns the active index.
fn conv_switch(i) { if (i >= 0) { if (i < conv_count()) { _conv_active = i; } } return _conv_active; }
# conv_delete: remove conversation `i` (never the last — always keep one). Fixes up _conv_active so it still
# points at a valid, sensible conversation. Returns 1 if removed, 0 if refused (last one / out of range).
fn conv_delete(i) {
    if (conv_count() <= 1) { return 0; }
    if (i < 0) { return 0; }
    if (i >= conv_count()) { return 0; }
    vec_remove(_conv_store, i);
    if (_conv_active > i) { _conv_active = _conv_active - 1; }        # the active shifted left
    if (_conv_active >= conv_count()) { _conv_active = conv_count() - 1; }   # was pointing past the end
    return 1;
}

# _conv_autotitle: a title cstr from a message's first line (<= CONV_TITLE_MAX bytes, "..." if truncated). Used to
# name a conversation from its first user message. Copies to stable storage.
var CONV_TITLE_MAX = 48;
fn _conv_autotitle(content, clen) {
    var t = alloc(CONV_TITLE_MAX + 4);
    var cap = clen;
    if (cap > CONV_TITLE_MAX) { cap = CONV_TITLE_MAX; }
    var i = 0;
    var done = 0;
    while ((done == 0) && (i < cap)) {
        var ch = load8(content + i);
        if (ch == 10) { done = 1; }              # stop at the first newline
        else { store8(t + i, ch); i = i + 1; }
    }
    # An empty first line (e.g. a newline-leading message) derives no title: return 0 (leave untitled, defer to a
    # later user message) rather than a blank "" title. A "" title would persist as CONV tlen-0 — indistinguishable
    # from untitled on reload, so it would re-derive from a different surviving message (0.33.2 round-trip fidelity).
    if (i == 0) { return 0; }
    if (done == 0) { if (clen > CONV_TITLE_MAX) {   # truncated mid-content -> ellipsis
        store8(t + i, 46); store8(t + i + 1, 46); store8(t + i + 2, 46); i = i + 3;
    } }
    store8(t + i, 0);
    return t;
}

# conv_dup_title: a stable, length-capped copy of a title cstr — for /new + /rename, whose arg points into the
# transient input line and must be copied before conv_set_title stores it. Caps at CONV_TITLE_STORE_MAX bytes.
var CONV_TITLE_STORE_MAX = 128;
fn conv_dup_title(s) {
    var n = strlen(s);
    if (n > CONV_TITLE_STORE_MAX) { n = CONV_TITLE_STORE_MAX; }
    var d = alloc(n + 1);
    var i = 0;
    while (i < n) { store8(d + i, load8(s + i)); i = i + 1; }
    store8(d + n, 0);
    return d;
}

# --- multi-conversation persistence support (0.33.2) --------------------------------------------------------
# conv_load_begin: start a CLEAN store for a load (no lazily-created default — the file's CONV records supply the
# conversations). conv_load_add: append a conversation with a copied title, make it the current load target, and
# return its index; created/updated are set to now (timestamps are not persisted this cut). session_total_messages:
# the message count across ALL conversations, for the honest resume greeting.
fn conv_load_begin() { _conv_store = vec_new(); _conv_active = 0; _conv_next_id = 1; return 0; }
fn conv_load_add(title) {
    if (_conv_store == 0) { _conv_store = vec_new(); }
    var c = alloc(64);           # 0.36.4: MUST match _conv_alloc — a loaded conv is read by the same accessors
    store64(c, _conv_next_id); _conv_next_id = _conv_next_id + 1;
    store64(c + 8, title);
    var now = clock_epoch_secs();
    store64(c + 16, now);
    store64(c + 24, now);
    store64(c + 32, vec_new());
    store64(c + 40, 0);          # 0.36.4: dropped-message count (a resumed conv starts with a clean record)
    store64(c + 48, 0);          # 0.36.4: overflow recap (not persisted — re-derived on demand)
    store64(c + 56, 0);
    vec_push(_conv_store, c);
    _conv_active = vec_len(_conv_store) - 1;
    return _conv_active;
}
fn session_total_messages() {
    if (_conv_store == 0) { return 0; }
    var n = vec_len(_conv_store);
    var i = 0;
    var t = 0;
    while (i < n) { t = t + vec_len(conv_msgs(i)); i = i + 1; }
    return t;
}

fn session_reset() {
    _sess_turns = 0;
    _sess_model = 0;
    _conv_store = 0;         # drop ALL conversations (a fresh default one is created on next use)
    _conv_active = 0;
    _conv_next_id = 1;
    _sess_rewind_snap = 0;   # 0.34.0: drop any pending /retry-/edit rewind snapshot
    _sess_tokens = 0;
    _sess_tokens_seen = 0;
    _sess_cost_micro = 0;
    _sess_cost_seen = 0;
    _sess_cost_unpriced = 0;
    return 0;
}

# session_tokens / _seen / session_add_tokens (0.10.2): the session token tally.
# session_add_tokens is called only with a real usage figure (>= 0) — a negative
# (absent) value is ignored, so _sess_tokens_seen flips only when hoosh actually
# reports usage. The status surface reads _seen to decide whether to show the field.
fn session_tokens() { return _sess_tokens; }
fn session_tokens_seen() { return _sess_tokens_seen; }
fn session_add_tokens(n) {
    if (n < 0) { return 0; }
    _sess_tokens = _sess_tokens + n;
    _sess_tokens_seen = 1;
    return 0;
}

# session_cost_micro / _seen / _unpriced_count + add/note (0.10.3): the session cost
# tally in integer micro-USD. session_add_cost folds one priced response's micro-USD
# in and flips _seen; session_note_unpriced records a response whose usage arrived but
# whose model was unpriced (so the surface can say so honestly, never fake a $0).
fn session_cost_micro() { return _sess_cost_micro; }
fn session_cost_seen() { return _sess_cost_seen; }
fn session_cost_unpriced_count() { return _sess_cost_unpriced; }
fn session_add_cost(micro) {
    if (micro < 0) { return 0; }
    _sess_cost_micro = _sess_cost_micro + micro;
    _sess_cost_seen = 1;
    return 0;
}
fn session_note_unpriced() { _sess_cost_unpriced = _sess_cost_unpriced + 1; return 0; }

# cost_fmt: render integer micro-USD as a "$d.cc" cstring into dst (caller sizes it,
# >= 24 B), returning the byte length. Truncates to whole cents (1 cent = 10000
# micro-USD) — the displayed value rounds DOWN, never up, so cost is never overstated.
# Pure — unit-tested. Used by both the TUI status bar and /state.
fn cost_fmt(dst, micro) {
    var cents_total = micro / 10000;          # 1 cent = 10000 micro-USD
    var dollars = cents_total / 100;
    var cents = cents_total - dollars * 100;
    var off = 0;
    store8(dst + off, 36); off = off + 1;     # '$'
    off = _append_int(dst, off, dollars);
    store8(dst + off, 46); off = off + 1;     # '.'
    store8(dst + off, 48 + (cents / 10)); off = off + 1;
    store8(dst + off, 48 + (cents - (cents / 10) * 10)); off = off + 1;
    store8(dst + off, 0);
    return off;
}

# _sess_hist_vec: the ACTIVE conversation's message vec (0.33.0) — the single point every history op goes through.
fn _sess_hist_vec() { _conv_ensure(); return conv_msgs(_conv_active); }

# session_history_len / _role / _content: read the active conversation. role and content are NUL-terminated
# cstrings (role a literal, content the stored copy). len is side-effect-free (no conversation is created just to
# report 0).
fn session_history_len() {
    if (_conv_store == 0) { return 0; }
    if (vec_len(_conv_store) == 0) { return 0; }
    return vec_len(conv_msgs(_conv_active));
}
fn session_history_role(i)    { return load64(vec_get(_sess_hist_vec(), i)); }
fn session_history_content(i) { return load64(vec_get(_sess_hist_vec(), i) + 8); }
# session_history_turn(i): the session turn this message belongs to (0.30.19). Matches roundlog_round_turn so the
# GUI feed renders a turn's tool cards above ITS reply. 0 for a resumed/pre-session message (no roundlog rounds).
fn session_history_turn(i)    { return load64(vec_get(_sess_hist_vec(), i) + 16); }
# session_history_model(i): the model id that produced message i (0.33.3), a stable cstr, or 0 (user/system
# messages, a pre-0.33.3 resumed message, or no model set). Persisted, so a resumed conversation keeps its
# per-reply model attribution.
fn session_history_model(i)   { return load64(vec_get(_sess_hist_vec(), i) + 24); }

# --- per-message citations (0.33.4): the recalled-source TITLES a reply cited -------------------------------
# The citation set is a lazily-alloc'd arena on the message at +32: count@0, then MSG_CITE_MAX title cstrs at
# 8+j*8. Live capture (agent/hoosh, reading memory.cyr's citations_*) and the file loader BOTH funnel through
# session_history_cite_last_add, so the stored / persisted / reloaded titles cap and sanitize identically. Only
# the title is persisted — the path is captured but never surfaced (memlog/emit/grounding all use the title).
var MSG_CITE_MAX = 5;
# _msg_cite_title_dup: a stable capped copy of a title cstr, tabs/newlines flattened to spaces (single-line
# display, and so a title can never break the CITE frame). Cap matches CONV_TITLE_STORE_MAX (ample for a note title).
fn _msg_cite_title_dup(s) {
    var n = strlen(s);
    if (n > CONV_TITLE_STORE_MAX) { n = CONV_TITLE_STORE_MAX; }
    var d = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var b = load8(s + i);
        if ((b == 9) || (b == 10)) { b = 32; }
        store8(d + i, b); i = i + 1;
    }
    store8(d + n, 0);
    return d;
}
fn _msg_cite_last() {                                    # the most-recently-appended message of the active conv, or 0
    if (conv_count() == 0) { return 0; }                 # no conversation yet -> nothing to cite (and don't let
                                                         # _sess_hist_vec's _conv_ensure spawn a spurious conv on a
                                                         # corrupt CITE-before-any-record file)
    var v = _sess_hist_vec();
    var n = vec_len(v);
    if (n == 0) { return 0; }
    return vec_get(v, n - 1);
}
fn session_history_cite_last_clear() {                   # reset the last message's citation set (idempotent re-attach)
    var m = _msg_cite_last();
    if (m == 0) { return 0; }
    var cs = load64(m + 32);
    if (cs != 0) { store64(cs, 0); }
    return 0;
}
fn session_history_cite_last_add(title) {                # attach one cited title to the last message (copied, capped)
    var m = _msg_cite_last();
    if (m == 0) { return 0; }
    if (title == 0) { return 0; }
    var cs = load64(m + 32);
    if (cs == 0) { cs = alloc(8 + MSG_CITE_MAX * 8); store64(cs, 0); store64(m + 32, cs); }
    var cn = load64(cs);
    if (cn >= MSG_CITE_MAX) { return 0; }
    store64(cs + 8 + cn * 8, _msg_cite_title_dup(title));
    store64(cs, cn + 1);
    return 0;
}
fn session_history_citation_count(i) {
    var cs = load64(vec_get(_sess_hist_vec(), i) + 32);
    if (cs == 0) { return 0; }
    return load64(cs);
}
fn session_history_citation_title(i, j) {
    if (j < 0) { return 0; }
    var cs = load64(vec_get(_sess_hist_vec(), i) + 32);
    if (cs == 0) { return 0; }
    if (j >= load64(cs)) { return 0; }
    return load64(cs + 8 + j * 8);
}

# --- per-message tool calls (0.33.5): the tool-round trace a reply produced -------------------------------
# The last piece of the richer persisted message schema: a reply's tool calls (name + arg summary + gate kind +
# ok/error) are snapshotted from the roundlog onto the message at +40 (a lazily-alloc'd set), persisted as trailing
# TOOL frames, so a resumed conversation keeps its tool cards. Live capture funnels through roundlog.cyr's
# roundlog_attach_calls_to_last; the loader funnels through the same _add, so both cap + sanitize identically. The
# store carries no roundlog.cyr dependency. Set: count@0, then MSG_TOOL_MAX entries {kind@0, ok@8, name@16, args@24}.
var MSG_TOOL_MAX = 8;
fn _msg_tool_last() {
    if (conv_count() == 0) { return 0; }
    var v = _sess_hist_vec();
    var n = vec_len(v);
    if (n == 0) { return 0; }
    return vec_get(v, n - 1);
}
fn session_history_tool_last_clear() {                    # reset the last message's tool set (idempotent re-attach)
    var m = _msg_tool_last();
    if (m == 0) { return 0; }
    var ts = load64(m + 40);
    if (ts != 0) { store64(ts, 0); }
    return 0;
}
fn session_history_tool_last_add(kind, ok, name, args) {  # attach one tool call to the last message (copied, capped)
    var m = _msg_tool_last();
    if (m == 0) { return 0; }
    var ts = load64(m + 40);
    if (ts == 0) { ts = alloc(8 + MSG_TOOL_MAX * 32); store64(ts, 0); store64(m + 40, ts); }
    var tn = load64(ts);
    if (tn >= MSG_TOOL_MAX) { return 0; }
    var e = ts + 8 + tn * 32;
    store64(e, kind);
    store64(e + 8, ok);
    var nm = 0;
    if (name != 0) { nm = _msg_cite_title_dup(name); }   # sanitized (tab/newline flattened) + capped copy — so a
    store64(e + 16, nm);                                 # name/args can never break the tab-delimited TOOL payload
    var ag = 0;
    if (args != 0) { ag = _msg_cite_title_dup(args); }
    store64(e + 24, ag);
    store64(ts, tn + 1);
    return 0;
}
fn session_history_tool_count(i) {
    var ts = load64(vec_get(_sess_hist_vec(), i) + 40);
    if (ts == 0) { return 0; }
    return load64(ts);
}
fn _sess_tool_entry(i, j) {
    if (j < 0) { return 0; }
    var ts = load64(vec_get(_sess_hist_vec(), i) + 40);
    if (ts == 0) { return 0; }
    if (j >= load64(ts)) { return 0; }
    return ts + 8 + j * 32;
}
fn session_history_tool_kind(i, j) { var e = _sess_tool_entry(i, j); if (e == 0) { return 0; } return load64(e); }
fn session_history_tool_ok(i, j)   { var e = _sess_tool_entry(i, j); if (e == 0) { return 0; } return load64(e + 8); }
fn session_history_tool_name(i, j) { var e = _sess_tool_entry(i, j); if (e == 0) { return 0; } return load64(e + 16); }
fn session_history_tool_args(i, j) { var e = _sess_tool_entry(i, j); if (e == 0) { return 0; } return load64(e + 24); }

# session_history_append: record (role, content[0..clen)) as a turn, copying the content to stable storage. An
# ASSISTANT reply is auto-tagged with the CURRENT session model (the one that produced it); user/system messages
# carry no model. The loader calls _session_history_append_ex directly with the model parsed from the file (which
# is the model at save time, not the live one). Drops the oldest message past SESS_HIST_MAX.
fn session_history_append(role, content, clen) {
    var model = 0;
    if (streq(role, "assistant") == 1) { model = session_model(); }   # attribute the reply to its producing model
    return _session_history_append_ex(role, content, clen, model);
}

# _session_history_append_ex: the append worker. `model` (a cstr, or 0) is COPIED to stable per-message storage —
# never aliased, because session._model_buf (what session_model() returns) is one shared buffer a mid-session
# switch overwrites; a raw alias would retroactively rewrite every earlier reply's model.
fn _session_history_append_ex(role, content, clen, model) {
    var m = alloc(48);
    store64(m, role);
    var c = alloc(clen + 1);
    if (clen > 0) { memcpy(c, content, clen); }
    store8(c + clen, 0);
    store64(m + 8, c);
    store64(m + 16, session_turns());       # 0.30.19: tag the message with the current turn (for per-turn tool cards)
    var mv = 0;
    if (model != 0) { if (strlen(model) > 0) { mv = _sess_dup_bytes(model, strlen(model)); } }   # stable capped copy
    store64(m + 24, mv);                     # 0.33.3: per-message model id (or 0)
    store64(m + 32, 0);                      # 0.33.4: citation set (lazily alloc'd when a cited title is attached)
    store64(m + 40, 0);                      # 0.33.5: tool-call set (lazily alloc'd when a tool call is attached)
    var v = _sess_hist_vec();
    vec_push(v, m);
    # 0.36.4: the cap is DESTRUCTIVE — the oldest message is freed from the conversation for good (gone from the
    # feed, /save, everything), unlike the request framer's byte budget which only SKIPS messages it still holds.
    # It used to do this silently and unmetered, while the visible "N oldest evicted" meter reported the harmless
    # one. Count the real losses so /state can say so honestly.
    while (vec_len(v) > SESS_HIST_MAX) { vec_remove(v, 0); _conv_note_dropped(_conv_active); }
    # 0.33.1: auto-title an untitled conversation from its first USER message.
    if (conv_title(_conv_active) == 0) { if (streq(role, "user") == 1) { conv_set_title(_conv_active, _conv_autotitle(content, clen)); } }
    conv_touch(_conv_active);                # 0.33.0: bump the active conversation's updated-at
    return 0;
}

# session_history_pop_last: drop the most recent message — used to roll back the
# just-appended user turn when the gateway call fails, so history stays a clean
# sequence of completed exchanges.
fn session_history_pop_last() {
    if (session_history_len() == 0) { return 0; }
    var v = _sess_hist_vec();
    vec_remove(v, vec_len(v) - 1);
    return 0;
}

# session_last_assistant_content: the content cstr of the most recent "assistant" reply in the active conversation,
# or 0 if there is none. Used by /bookmark (0.34.4) to save the last reply into mneme.
fn session_last_assistant_content() {
    var v = _sess_hist_vec();
    var i = vec_len(v) - 1;
    while (i >= 0) {
        if (streq(load64(vec_get(v, i)), "assistant") == 1) { return load64(vec_get(v, i) + 8); }
        i = i - 1;
    }
    return 0;
}

# session_last_user_index: the index (into the active conversation) of the most recent "user" message, or -1 if
# there is none. Used by /retry (regenerate-last) and /edit (edit-last, 0.34.0) to locate the turn to rewind.
fn session_last_user_index() {
    var v = _sess_hist_vec();
    var i = vec_len(v) - 1;
    while (i >= 0) {
        if (streq(load64(vec_get(v, i)), "user") == 1) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

# session_rewind_to_last_user (0.34.0): drop the most recent "user" message and every message after it (its
# assistant reply, if any) from the active conversation, so a completed turn can be RE-RUN cleanly — agent_turn /
# hoosh_send re-append the user message themselves, so the caller must first clear it. Returns that user message's
# CONTENT cstr — a STABLE, never-freed copy (the session bump-heap never frees, so the dropped message's content
# pointer stays valid) — so /retry can re-run the EXACT prompt the model saw (already @mention-expanded;
# re-expanding it would double-inject the file blocks, see mention.cyr). Returns 0 when there is no user message.
#
# NON-DESTRUCTIVE: the removed messages (exact struct ptrs) are SNAPSHOTTED into _sess_rewind_snap so a re-run that
# produces no fresh reply — a transport/HTTP failure, an empty completion, or a stateless non-recording turn — can
# be UNDONE with session_rewind_settle(), restoring the prior exchange byte-for-byte. So a rewind is only committed
# when the new turn actually records a replacement (agent_turn / multi-turn hoosh_send); otherwise nothing is lost.
# (_sess_rewind_snap is declared with the conversation-store globals above.)
fn session_rewind_to_last_user() {
    _sess_rewind_snap = 0;
    var idx = session_last_user_index();
    if (idx < 0) { return 0; }
    var v = _sess_hist_vec();
    var content = load64(vec_get(v, idx) + 8);
    var snap = vec_new();
    var j = idx;
    while (j < vec_len(v)) { vec_push(snap, vec_get(v, j)); j = j + 1; }   # capture the removed structs in order
    while (vec_len(v) > idx) { vec_remove(v, vec_len(v) - 1); }
    _sess_rewind_snap = snap;
    _sess_rewind_title = conv_title(_conv_active);   # snapshot the title too — a failed re-run's append could auto-title an untitled conv; restore reverts it
    session_recap_clear();                   # 0.36.4: the recap may describe messages this rewind just un-said
    conv_touch(_conv_active);                # the active conversation mutated — bump its updated-at
    return content;
}

# session_history_last_is_reply_for (0.34.0): 1 if the most recent message in the active conversation is an
# "assistant" reply tagged with `turn` — i.e. a FRESH reply landed for that turn (length-independent, so it stays
# correct at the SESS_HIST_MAX eviction cap where a net-growth check would false-fire). A resumed message carries
# turn 0 and a bumped turn is >= 1, so a resumed reply never false-matches.
fn session_history_last_is_reply_for(turn) {
    var n = session_history_len();
    if (n == 0) { return 0; }
    var i = n - 1;
    if (streq(session_history_role(i), "assistant") == 0) { return 0; }
    if (session_history_turn(i) != turn) { return 0; }
    return 1;
}

# session_rewind_restore (0.34.0): re-append the messages captured by the last session_rewind_to_last_user() (exact
# struct ptrs, so role/content/turn/model/citations/tools are all preserved) and drop the snapshot. Returns 1 if it
# restored anything, 0 if there was no snapshot.
fn session_rewind_restore() {
    if (_sess_rewind_snap == 0) { return 0; }
    var v = _sess_hist_vec();
    var i = 0;
    while (i < vec_len(_sess_rewind_snap)) { vec_push(v, vec_get(_sess_rewind_snap, i)); i = i + 1; }
    conv_set_title(_conv_active, _sess_rewind_title);   # revert any title the failed re-run's append may have set
    _sess_rewind_snap = 0;
    conv_touch(_conv_active);
    return 1;
}

# session_rewind_settle (0.34.0): call after a rewound turn re-runs. If a fresh assistant reply landed for `turn`,
# the re-run recorded a replacement exchange -> COMMIT the rewind (drop the snapshot). Otherwise RESTORE the
# snapshotted prior exchange (messages AND title) so nothing is lost. Returns 1 if it restored.
fn session_rewind_settle(turn) {
    if (session_history_last_is_reply_for(turn) == 1) { _sess_rewind_snap = 0; return 0; }
    return session_rewind_restore();
}

# session_history_clear: drop the ACTIVE conversation's context window (the /clear command). Keeps the model, the
# turn counter, and the conversation itself (id/title); only its messages are dropped.
fn session_history_clear() {
    _conv_ensure();
    store64(_conv_at(_conv_active) + 32, vec_new());
    session_recap_clear();   # 0.36.4: the recap described messages that no longer exist
    return 0;
}

# --- conversation resume: persist the message history to [session].file (0.24.2) -----------------------
# Opt-in persistence of the CONVERSATION history (role + content per message) so a restart resumes where you
# left off. DISTINCT from [history].file (composer keystrokes, 0.11.2) and the memory seam (durable facts).
# INTERACTIVE-ONLY (main.cyr binds it after the one-shot dispatch returns; one-shot never persists). Mirrors
# 0.11.2's secrets posture: OFF by default, best-effort 0600 on fresh create, degrade-closed (a failure is
# announced once, never faked). Uses the PORTABLE lib/io.cyr wrappers (the AGNOS open bridge — never raw
# sys_open).
#
# SECURITY — this writes the CONVERSATION CONTENT (your prompts + the model's replies) in PLAINTEXT on disk,
# more sensitive than input-history keystrokes. Opt-in only. RESIDUALS (documented, not faked, same class as
# 0.11.2): a fresh file is created 0600 on POSIX, but (1) a PRE-EXISTING looser file is left as-is (O_TRUNC
# keeps its perms; no portable chmod to tighten — sys_chmod is absent on Windows + a no-op on AGNOS), (2)
# AGNOS's frozen-ABI open drops the create mode, (3) no O_NOFOLLOW (a symlink at the path is followed). We
# never assert a mode we cannot enforce.
#
# FORMAT (framed, length-prefixed so multi-line content needs no escaping):
#   line 1:  THOTH-SESSION-1\n           version marker; a foreign/corrupt first line -> load skipped
#   record:  <role>\t<clen>\n            role = "user"|"assistant"; clen = decimal content byte length
#            <clen content bytes>\n      the content, verbatim; the trailing \n is a separator / sanity check
# Content is the message text as the session subsystem holds it — a NUL-TERMINATED cstring (see
# session_history_* above). We persist strlen(content) bytes, so an interior NUL byte terminates content, as
# it already does everywhere else in the history path (and as it MUST: a raw NUL cannot be re-sent to hoosh —
# a 0x00 inside a JSON string is invalid). Newlines, tabs, and all other bytes round-trip exactly.
var SESS_FILE_MAGIC = "THOTH-SESSION-1";     # v1 (legacy, single linear thread) — still LOADED for back-compat
var SESS_FILE_MAGIC_V2 = "THOTH-SESSION-2";  # v2 (0.33.2) — all conversations, framed with CONV headers
var SESS_MODE = 0x180;         # 0600 rw------- — best-effort CREATE mode (see the header note on perms)
var SESS_READ_CAP = 3145728;   # 3 MiB load buffer (>= SESS_HIST_MAX * HOOSH_ACC_CAP); a larger file loads its leading records only
var _sess_path = 0;            # bound file path (0 = persistence OFF)
var _sess_broke = 0;           # 1 if a save FAILED mid-session (persistence auto-disabled; announce once)
var _sess_init_failed = 0;     # 1 if [session].file was set but unwritable at startup (announce once)
var _sess_resumed = 0;         # count of messages loaded at startup (for the greeting)
var _sess_read_buf = 0;        # alloc(SESS_READ_CAP), lazy — whole-file load buffer
var _sess_hdr_buf = 0;         # alloc(64), lazy — the "<role>\t<clen>\n" record header scratch on save

# _sess_eqn: 1 if the first `n` bytes of `a` and `b` are equal; else 0. PURE.
fn _sess_eqn(a, b, n) {
    var k = 0;
    while (k < n) { if (load8(a + k) != load8(b + k)) { return 0; } k = k + 1; }
    return 1;
}

# _sess_role_literal: map a parsed role name to a STABLE literal. session_history_append stores the role
# POINTER without copying (see its body), so it MUST outlive the call — never a temp/parse buffer. Unknown
# roles default to "user" (a benign, honest fallback).
fn _sess_role_literal(s, slen) {
    if ((slen == 9) && (_sess_eqn(s, "assistant", 9) == 1)) { return "assistant"; }
    if ((slen == 4) && (_sess_eqn(s, "user", 4) == 1)) { return "user"; }
    return "user";
}

# _sess_uint_into: write the decimal digits of n (>= 0) into buf at off; returns the new off. PURE.
fn _sess_uint_into(buf, off, n) {
    if (n == 0) { store8(buf + off, 48); return off + 1; }
    var d = 1;
    var t = n;
    while (t >= 10) { d = d * 10; t = t / 10; }
    while (d > 0) {
        store8(buf + off, 48 + ((n / d) % 10)); off = off + 1;
        d = d / 10;
    }
    return off;
}

# _sess_write_file: truncate + rewrite `path` from the in-memory history (oldest->newest), framed. Returns 0
# on success, -1 if the file cannot be opened OR any write short-writes (so the caller degrades closed rather
# than leave a truncated file). Created 0600 if absent (best-effort — see the header note on perms).
# _sess_write_rec: write one "<role>\t<clen>\n<content>\n" record to fd through the scratch header. Returns 0 ok, -1 short-write.
fn _sess_write_rec(fd, role, content, model) {
    var clen = strlen(content);
    var ho = 0;
    var rl = strlen(role);
    var k = 0;
    while (k < rl) { store8(_sess_hdr_buf + ho, load8(role + k)); ho = ho + 1; k = k + 1; }
    store8(_sess_hdr_buf + ho, 9); ho = ho + 1;            # '\t'
    ho = _sess_uint_into(_sess_hdr_buf, ho, clen);
    var ok = 0;
    var mlen = 0;
    if (model != 0) { mlen = strlen(model); }
    # Frame: "<role>\t<len>\n<content>\n"  OR (with a model) "<role>\t<len>\t<model>\n<content>\n". The model is
    # written DIRECTLY to fd, never through the 64-byte _sess_hdr_buf (a model id can be up to 128 bytes).
    if (mlen > 0) {
        store8(_sess_hdr_buf + ho, 9); ho = ho + 1;        # '\t' -> a model field follows the length
        if (file_write(fd, _sess_hdr_buf, ho) != ho) { ok = 0 - 1; }
        if (file_write(fd, model, mlen) != mlen) { ok = 0 - 1; }
        if (file_write(fd, "\n", 1) != 1) { ok = 0 - 1; }
    } else {
        store8(_sess_hdr_buf + ho, 10); ho = ho + 1;       # '\n' -> no model field
        if (file_write(fd, _sess_hdr_buf, ho) != ho) { ok = 0 - 1; }
    }
    if (clen > 0) { if (file_write(fd, content, clen) != clen) { ok = 0 - 1; } }
    if (file_write(fd, "\n", 1) != 1) { ok = 0 - 1; }
    return ok;
}

# _sess_write_cite: a trailing "CITE\t<title_len>\n<title>\n" frame (0.33.4) — shares the unified frame with CONV
# and message records, so the loader dispatches it by token. Emitted right after the assistant record it belongs
# to, so on load it attaches to the just-appended message. The title is written directly to fd (may exceed 64).
fn _sess_write_cite(fd, title) {
    var tlen = strlen(title);
    var h = 0;
    store8(_sess_hdr_buf, 67); store8(_sess_hdr_buf + 1, 73); store8(_sess_hdr_buf + 2, 84); store8(_sess_hdr_buf + 3, 69); h = 4;   # "CITE"
    store8(_sess_hdr_buf + h, 9); h = h + 1;               # '\t'
    h = _sess_uint_into(_sess_hdr_buf, h, tlen);
    store8(_sess_hdr_buf + h, 10); h = h + 1;              # '\n'
    var ok = 0;
    if (file_write(fd, _sess_hdr_buf, h) != h) { ok = 0 - 1; }
    if (tlen > 0) { if (file_write(fd, title, tlen) != tlen) { ok = 0 - 1; } }
    if (file_write(fd, "\n", 1) != 1) { ok = 0 - 1; }
    return ok;
}

# _sess_copy_bounded: append cstr `src` into `dst` at offset `off`, stopping at `cap`; returns the new offset.
fn _sess_copy_bounded(dst, off, src, cap) {
    if (src == 0) { return off; }
    var i = 0;
    while ((load8(src + i) != 0) && (off < cap)) { store8(dst + off, load8(src + i)); i = i + 1; off = off + 1; }
    return off;
}

# _sess_write_tool: a trailing "TOOL\t<len>\n<kind>\t<ok>\t<name>\t<args>\n" frame (0.33.5). The payload packs the
# four fields tab-delimited (kind/ok are small ints; name/args are stored pre-sanitized of tabs/newlines, so the
# split is unambiguous); it is built in a scratch buffer to compute the length, then written after the "TOOL\t<len>"
# header. Shares the unified frame, dispatched by token, and attaches to the just-appended reply on load.
var SESS_TOOL_BUF = 512;
var _sess_tool_buf = 0;
fn _sess_write_tool(fd, kind, ok, name, args) {
    if (_sess_tool_buf == 0) { _sess_tool_buf = alloc(SESS_TOOL_BUF); }
    var o = 0;
    o = _sess_uint_into(_sess_tool_buf, o, kind);
    store8(_sess_tool_buf + o, 9); o = o + 1;              # '\t'
    o = _sess_uint_into(_sess_tool_buf, o, ok);
    store8(_sess_tool_buf + o, 9); o = o + 1;              # '\t'
    o = _sess_copy_bounded(_sess_tool_buf, o, name, SESS_TOOL_BUF - 2);   # room for a '\t' + at least the args start
    store8(_sess_tool_buf + o, 9); o = o + 1;              # '\t'
    o = _sess_copy_bounded(_sess_tool_buf, o, args, SESS_TOOL_BUF - 1);
    var h = 0;
    store8(_sess_hdr_buf, 84); store8(_sess_hdr_buf + 1, 79); store8(_sess_hdr_buf + 2, 79); store8(_sess_hdr_buf + 3, 76); h = 4;   # "TOOL"
    store8(_sess_hdr_buf + h, 9); h = h + 1;               # '\t'
    h = _sess_uint_into(_sess_hdr_buf, h, o);
    store8(_sess_hdr_buf + h, 10); h = h + 1;              # '\n'
    var okw = 0;
    if (file_write(fd, _sess_hdr_buf, h) != h) { okw = 0 - 1; }
    if (o > 0) { if (file_write(fd, _sess_tool_buf, o) != o) { okw = 0 - 1; } }
    if (file_write(fd, "\n", 1) != 1) { okw = 0 - 1; }
    return okw;
}

# _sess_write_file: truncate + rewrite `path` in the v2 (all-conversations) format. Magic line carries the active
# index; then per conversation a "CONV\t<title_len>\n<title>\n" header followed by that conversation's records.
# Returns 0 on success, -1 on open/short-write failure (caller degrades closed).
fn _sess_write_file(path) {
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, SESS_MODE);
    if (fd < 0) { return 0 - 1; }
    if (_sess_hdr_buf == 0) { _sess_hdr_buf = alloc(64); }
    var ok = 0;
    var ml = strlen(SESS_FILE_MAGIC_V2);
    if (file_write(fd, SESS_FILE_MAGIC_V2, ml) != ml) { ok = 0 - 1; }
    var ho = 0;                                           # "\t<active>\n"
    store8(_sess_hdr_buf, 9); ho = 1;
    ho = _sess_uint_into(_sess_hdr_buf, ho, conv_active());
    store8(_sess_hdr_buf + ho, 10); ho = ho + 1;
    if (file_write(fd, _sess_hdr_buf, ho) != ho) { ok = 0 - 1; }
    var nc = conv_count();
    var ci = 0;
    while (ci < nc) {
        var title = conv_title(ci);
        var tlen = 0;
        if (title != 0) { tlen = strlen(title); }
        var h2 = 0;                                       # "CONV\t<tlen>\n"
        store8(_sess_hdr_buf, 67); store8(_sess_hdr_buf + 1, 79); store8(_sess_hdr_buf + 2, 78); store8(_sess_hdr_buf + 3, 86); h2 = 4;   # "CONV"
        store8(_sess_hdr_buf + h2, 9); h2 = h2 + 1;
        h2 = _sess_uint_into(_sess_hdr_buf, h2, tlen);
        store8(_sess_hdr_buf + h2, 10); h2 = h2 + 1;
        if (file_write(fd, _sess_hdr_buf, h2) != h2) { ok = 0 - 1; }
        if (tlen > 0) { if (file_write(fd, title, tlen) != tlen) { ok = 0 - 1; } }
        if (file_write(fd, "\n", 1) != 1) { ok = 0 - 1; }
        var msgs = conv_msgs(ci);
        var mn = vec_len(msgs);
        var mi = 0;
        while (mi < mn) {
            var m = vec_get(msgs, mi);
            if (_sess_write_rec(fd, load64(m), load64(m + 8), load64(m + 24)) < 0) { ok = 0 - 1; }
            var cs = load64(m + 32);                  # 0.33.4: trailing CITE frames for this reply's cited sources
            if (cs != 0) {
                var cn = load64(cs);
                var cj = 0;
                while (cj < cn) { if (_sess_write_cite(fd, load64(cs + 8 + cj * 8)) < 0) { ok = 0 - 1; } cj = cj + 1; }
            }
            var ts = load64(m + 40);                  # 0.33.5: trailing TOOL frames for this reply's tool calls
            if (ts != 0) {
                var tn = load64(ts);
                var tj = 0;
                while (tj < tn) {
                    var te = ts + 8 + tj * 32;
                    if (_sess_write_tool(fd, load64(te), load64(te + 8), load64(te + 16), load64(te + 24)) < 0) { ok = 0 - 1; }
                    tj = tj + 1;
                }
            }
            mi = mi + 1;
        }
        ci = ci + 1;
    }
    file_close(fd);
    return ok;
}

# _sess_load_file: read `path`, verify the magic line, and replay each record through session_history_append
# (which applies the SESS_HIST_MAX cap, keeping the most-recent). Returns the count loaded. A missing file,
# a foreign/corrupt first line, or a malformed/truncated record is handled gracefully (load what parsed, then
# stop) — never a crash. Reads up to SESS_READ_CAP; a larger file loads its leading complete records only.
fn _sess_load_file(path) {
    var fd = file_open(path, 0, 0);                       # O_RDONLY; <0 -> absent, nothing to resume
    if (fd < 0) { return 0; }
    if (_sess_read_buf == 0) { _sess_read_buf = alloc(SESS_READ_CAP); }
    var total = 0;
    var go = 1;
    while (go == 1) {
        var got = file_read(fd, _sess_read_buf + total, SESS_READ_CAP - total);
        if (got <= 0) { go = 0; }
        else { total = total + got; if (total >= SESS_READ_CAP) { go = 0; } }
    }
    file_close(fd);
    # v2 (0.33.2, all conversations): "THOTH-SESSION-2\t<active>\n" ...
    var mlv2 = strlen(SESS_FILE_MAGIC_V2);
    if (total >= (mlv2 + 1)) { if (_sess_eqn(_sess_read_buf, SESS_FILE_MAGIC_V2, mlv2) == 1) { if (load8(_sess_read_buf + mlv2) == 9) {
        return _sess_load_v2(mlv2, total);
    } } }
    # v1 (legacy single thread): "THOTH-SESSION-1\n" ...
    var ml = strlen(SESS_FILE_MAGIC);
    if (total >= (ml + 1)) { if (_sess_eqn(_sess_read_buf, SESS_FILE_MAGIC, ml) == 1) { if (load8(_sess_read_buf + ml) == 10) {
        return _sess_load_v1(ml + 1, total);
    } } }
    return 0;                                             # not our file / too short -> skip
}

# _sess_load_v1: the legacy single-thread parser — replays each "<role>\t<clen>\n<content>\n" record through
# session_history_append (into the default conversation). `p` starts past the magic line. Returns the count.
fn _sess_load_v1(p, total) {
    var loaded = 0;
    var parsing = 1;
    while (parsing == 1) {
        if (p >= total) { parsing = 0; }
        else {
            var rstart = p;                              # role token: up to '\t'
            while ((p < total) && (load8(_sess_read_buf + p) != 9) && (load8(_sess_read_buf + p) != 10)) { p = p + 1; }
            if ((p >= total) || (load8(_sess_read_buf + p) != 9)) { parsing = 0; }
            else {
                var rlen = p - rstart;
                p = p + 1;                               # skip '\t'
                var clen = 0;
                var digits = 0;
                while ((p < total) && (load8(_sess_read_buf + p) >= 48) && (load8(_sess_read_buf + p) <= 57)) {
                    clen = clen * 10 + (load8(_sess_read_buf + p) - 48);
                    p = p + 1; digits = digits + 1;
                }
                if ((digits == 0) || (clen < 0) || (clen > total) || (p >= total) || (load8(_sess_read_buf + p) != 10)) { parsing = 0; }
                else {
                    p = p + 1;                           # skip '\n' after clen
                    if (clen > (total - p)) { parsing = 0; }
                    else {
                        session_history_append(_sess_role_literal(_sess_read_buf + rstart, rlen), _sess_read_buf + p, clen);
                        loaded = loaded + 1;
                        p = p + clen;
                        if ((p < total) && (load8(_sess_read_buf + p) == 10)) { p = p + 1; }
                    }
                }
            }
        }
    }
    return loaded;
}

# _sess_dup_bytes: a NUL-terminated capped copy of `len` bytes from a buffer slice — the stable-storage helper for
# both conversation titles and per-message model ids (the parse buffer is reused, and both are short, so the
# CONV_TITLE_STORE_MAX cap covers both).
fn _sess_dup_bytes(ptr, len) {
    if (len > CONV_TITLE_STORE_MAX) { len = CONV_TITLE_STORE_MAX; }
    var d = alloc(len + 1);
    var i = 0;
    while (i < len) { store8(d + i, load8(ptr + i)); i = i + 1; }
    store8(d + len, 0);
    return d;
}

# _sess_load_tool: parse a TOOL frame's payload (_sess_read_buf[p .. p+num)) — "<kind>\t<ok>\t<name>\t<args>" —
# and attach the tool call to the just-appended message. Every read is bounded by `end`; a malformed payload (a
# missing delimiter) is a clean no-op. name/args were written pre-sanitized of tabs, so the first three tabs split
# the fields unambiguously and the args field (the remainder) can be taken whole.
fn _sess_load_tool(p, num) {
    var end = p + num;
    var q = p;
    var kind = 0;
    var kd = 0;
    while ((q < end) && (load8(_sess_read_buf + q) >= 48) && (load8(_sess_read_buf + q) <= 57)) { kind = kind * 10 + (load8(_sess_read_buf + q) - 48); q = q + 1; kd = kd + 1; }
    if ((kd == 0) || (q >= end) || (load8(_sess_read_buf + q) != 9)) { return 0; }
    q = q + 1;
    var okv = 0;
    var od = 0;
    while ((q < end) && (load8(_sess_read_buf + q) >= 48) && (load8(_sess_read_buf + q) <= 57)) { okv = okv * 10 + (load8(_sess_read_buf + q) - 48); q = q + 1; od = od + 1; }
    if ((od == 0) || (q >= end) || (load8(_sess_read_buf + q) != 9)) { return 0; }
    q = q + 1;
    var nstart = q;                                      # name up to the third '\t'
    while ((q < end) && (load8(_sess_read_buf + q) != 9)) { q = q + 1; }
    if (q >= end) { return 0; }                          # no third '\t' -> malformed
    var name = _sess_dup_bytes(_sess_read_buf + nstart, q - nstart);
    q = q + 1;                                           # skip '\t'
    var args = _sess_dup_bytes(_sess_read_buf + q, end - q);   # args = the remainder
    session_history_tool_last_add(kind, okv, name, args);
    return 0;
}

# _sess_load_v2: the multi-conversation parser. `mend` = the '\t' offset after the magic. Both a CONV header and a
# message record share the "<token>\t<num>\n<payload>\n" frame (token=="CONV": num=title_len, payload=title; else
# token=role: num=clen, payload=content), so one loop + one bounds check handles both. Rebuilds the store from
# scratch, restores the active conversation, and never OOBs on a corrupt file. Returns the message records loaded.
fn _sess_load_v2(mend, total) {
    var p = mend + 1;                                    # past "...-2\t"
    var active_idx = 0;
    var ad = 0;
    while ((p < total) && (load8(_sess_read_buf + p) >= 48) && (load8(_sess_read_buf + p) <= 57)) { active_idx = active_idx * 10 + (load8(_sess_read_buf + p) - 48); p = p + 1; ad = ad + 1; }
    if ((ad == 0) || (p >= total) || (load8(_sess_read_buf + p) != 10)) { return 0; }   # malformed magic line
    p = p + 1;
    conv_load_begin();
    var loaded = 0;
    var parsing = 1;
    while (parsing == 1) {
        if (p >= total) { parsing = 0; }
        else {
            var tstart = p;                              # token up to '\t'
            while ((p < total) && (load8(_sess_read_buf + p) != 9) && (load8(_sess_read_buf + p) != 10)) { p = p + 1; }
            if ((p >= total) || (load8(_sess_read_buf + p) != 9)) { parsing = 0; }
            else {
                var tlen = p - tstart;
                p = p + 1;                               # skip '\t'
                var num = 0;
                var nd = 0;
                while ((p < total) && (load8(_sess_read_buf + p) >= 48) && (load8(_sess_read_buf + p) <= 57)) { num = num * 10 + (load8(_sess_read_buf + p) - 48); p = p + 1; nd = nd + 1; }
                if ((nd == 0) || (num < 0) || (num > total) || (p >= total)) { parsing = 0; }
                else {
                    # After the length, the separator is '\t' (an optional model field, records only, precedes the
                    # '\n') or '\n' (no model field). A model token on a CONV header, if any, is parsed and ignored.
                    var model_ptr = 0;
                    var sep = load8(_sess_read_buf + p);
                    if (sep == 9) {
                        p = p + 1;                       # skip '\t'
                        var mstart = p;                  # model token up to '\n'
                        while ((p < total) && (load8(_sess_read_buf + p) != 10) && (load8(_sess_read_buf + p) != 9)) { p = p + 1; }
                        if ((p >= total) || (load8(_sess_read_buf + p) != 10)) { parsing = 0; }
                        else { var mlen = p - mstart; if (mlen > 0) { model_ptr = _sess_dup_bytes(_sess_read_buf + mstart, mlen); } }
                    } else { if (sep != 10) { parsing = 0; } }   # neither '\t' nor '\n' -> malformed
                    if (parsing == 1) {
                        p = p + 1;                       # skip '\n' before the payload
                        if (num > (total - p)) { parsing = 0; }   # payload doesn't fit -> stop
                        else {
                            if ((tlen == 4) && (_sess_eqn(_sess_read_buf + tstart, "CONV", 4) == 1)) {
                                var title = 0;
                                if (num > 0) { title = _sess_dup_bytes(_sess_read_buf + p, num); }
                                conv_load_add(title);    # new conversation, becomes the append target
                            } else { if ((tlen == 4) && (_sess_eqn(_sess_read_buf + tstart, "CITE", 4) == 1)) {
                                # 0.33.4: a cited-source title for the just-appended message
                                if (num > 0) { session_history_cite_last_add(_sess_dup_bytes(_sess_read_buf + p, num)); }
                            } else { if ((tlen == 4) && (_sess_eqn(_sess_read_buf + tstart, "TOOL", 4) == 1)) {
                                # 0.33.5: a tool call for the just-appended message
                                if (num > 0) { _sess_load_tool(p, num); }
                            } else {
                                if (conv_count() == 0) { conv_load_add(0); }   # a record before any CONV -> default conv
                                _session_history_append_ex(_sess_role_literal(_sess_read_buf + tstart, tlen), _sess_read_buf + p, num, model_ptr);
                                loaded = loaded + 1;
                            } } }
                            p = p + num;
                            if ((p < total) && (load8(_sess_read_buf + p) == 10)) { p = p + 1; }   # skip payload separator
                        }
                    }
                }
            }
        }
    }
    conv_switch(active_idx);                             # restore the active conversation (clamped)
    return loaded;
}

# _sess_probe_writable: NON-DESTRUCTIVE writability check — create at 0600 if absent (O_CREAT, NO O_TRUNC)
# or open an existing file without touching it, then close. Returns 0 if writable, -1 otherwise (so binding
# never trims the user's file on mere startup).
fn _sess_probe_writable(path) {
    var fd = file_open(path, O_WRONLY | O_CREAT, SESS_MODE);   # no O_TRUNC -> content preserved
    if (fd < 0) { return 0 - 1; }
    file_close(fd);
    return 0;
}

# sess_persist_init: bind conversation persistence to `path` (0 -> OFF). Loads any existing conversation into
# the history, then NON-DESTRUCTIVELY probes writability. Returns the number of messages resumed (>=0), or -1
# if the path is set but unwritable (resume stays OFF; the session still works in-memory). Interactive-only.
fn sess_persist_init(path) {
    _sess_path = 0;
    _sess_broke = 0;
    _sess_init_failed = 0;
    _sess_resumed = 0;
    if (path == 0) { return 0; }                         # not configured -> OFF
    _sess_load_file(path);
    _sess_resumed = session_total_messages();            # the ACTUAL resumed count across ALL conversations (post SESS_HIST_MAX per-conv eviction) — a >40-record conv parses more than it keeps; report what's really in context, never the raw parse count
    if (_sess_probe_writable(path) < 0) { _sess_init_failed = 1; return 0 - 1; }   # unwritable -> announce + OFF
    _sess_path = path;                                   # ACTIVE
    return _sess_resumed;
}

# sess_persist_save: rewrite the session file from the in-memory history, if active (else a no-op — so it is
# safe to call from every turn path, including one-shot where persistence was never bound). On a write
# FAILURE it degrades closed: disables persistence + raises the broke flag (announced once), never faked.
fn sess_persist_save() {
    if (_sess_path == 0) { return 0; }
    if (_sess_write_file(_sess_path) < 0) { _sess_path = 0; _sess_broke = 1; }
    return 0;
}

fn sess_persist_active() { if (_sess_path != 0) { return 1; } return 0; }
fn sess_persist_broke() { return _sess_broke; }
fn sess_persist_broke_ack() { _sess_broke = 0; return 0; }
fn sess_persist_resumed() { return _sess_resumed; }

# sess_persist_greeting: emit the one-line resume note for the interactive greeting (REPL banner + TUI feed).
# Sink-aware (emit/oprintln). Honest: resumed N when messages were loaded, an unwritable note when the file
# was set but could not be bound, nothing otherwise.
fn sess_persist_greeting() {
    if (_sess_init_failed == 1) {
        emit("  "); ui_emit(ROLE_RED, "session file not writable"); ui_emit(ROLE_FAINT, " — resume disabled"); oprintln("");
        return 0;
    }
    if ((_sess_path != 0) && (_sess_resumed > 0)) {
        emit("  "); emit(ui_sgr(ROLE_FAINT)); emit("resumed "); ofmt_int(_sess_resumed); emit(" messages from "); emit(_sess_path); emit(ui_reset()); oprintln("");
    }
    return 0;
}

fn session_turns() { return _sess_turns; }
fn session_bump_turn() { _sess_turns = _sess_turns + 1; return _sess_turns; }
fn session_model() { return _sess_model; }
fn session_set_model(m) { _sess_model = m; return 0; }

# session_set_model_copy: store a COPY of cstring m as the session model. The
# /model arg points into the reused input-line buffer, which the next read
# overwrites — so a mid-session switch must copy, not alias. Reuses one static
# buffer (model ids are short; avoids accreting in the never-freeing bump heap).
var _model_buf = 0;
var MODEL_BUF_CAP = 256;
fn session_set_model_copy(m) {
    if (_model_buf == 0) { _model_buf = alloc(MODEL_BUF_CAP); }
    var i = 0;
    while ((load8(m + i) != 0) && (i < (MODEL_BUF_CAP - 1))) {
        store8(_model_buf + i, load8(m + i));
        i = i + 1;
    }
    store8(_model_buf + i, 0);
    _sess_model = _model_buf;
    return 0;
}

# The avatara archetype profile, built once (egyptian_thoth allocs from the
# bump heap, so the pointer is stable for the process). Lazy: the first persona
# query after alloc_init() constructs it. This is the M5 seam binding — the
# persona is READ from avatara, never reimplemented (ADR-0003).
var _persona_profile = 0;
var _persona_sys_dirty = 0;    # 1 after a persona_set -> persona_system_prompt rebuilds in place (0.22.0)
# Role modality (0.24.5): the active persona's ROLE is a facet (aspect) of its personality — sourced from
# avatara's trait-derived aspects (aspect_role/profile_dominant_aspect). _persona_aspect selects one (-1 =
# the archetype's dominant aspect, its default role); _persona_role_override is a USER label (/role <text>)
# that trumps the aspect — thoth's own overlay, not archetype semantics. Both reset on a persona switch.
var _persona_aspect = 0 - 1;   # selected aspect index into avatara's set, or -1 = dominant/default
var _persona_role_override = 0; # user custom role cstr (/role <text>), or 0 = none
fn persona_profile() {
    if (_persona_profile == 0) {
        # Startup default (0.22.0): [persona].name in thoth.cyml resolves through avatara's
        # find_and_validate; absent OR unknown -> egyptian_thoth (today's behavior, byte-identical
        # floor when unset). An unknown configured name falls back to the default and is surfaced by
        # the active-persona display (banner/status/state) rather than faked.
        var pn = config_persona();
        if (pn != 0) {
            var r = find_and_validate(pn);
            if (is_err_result(r) == 0) { _persona_profile = result_unwrap(r); return _persona_profile; }
        }
        _persona_profile = egyptian_thoth();
    }
    return _persona_profile;
}

# persona_set: swap the active avatara profile and mark the cached system prompt DIRTY so the next turn
# rebuilds the persona from the new archetype (the memory_invalidate shape). Marks dirty rather than
# zeroing the pointer, so persona_system_prompt rebuilds IN PLACE (no per-switch heap leak on the
# never-freeing bump allocator). 0.22.0.
fn persona_set(p) {
    _persona_profile = p;
    _persona_sys_dirty = 1;
    _persona_aspect = 0 - 1;       # 0.24.5: a new archetype resets to its own dominant aspect (default role)
    _persona_role_override = 0;    # and drops any prior user role override
    return 0;
}

# persona_switch: resolve `name` through avatara's find_and_validate and make it the active persona.
# Returns 1 on success, 0 if the name is not a known/valid archetype (caller gives an honest refusal).
# Pure consumption — avatara owns lookup + validation; thoth only selects. 0.22.0.
fn persona_switch(name) {
    var r = find_and_validate(name);
    if (is_err_result(r) == 1) { return 0; }
    persona_set(result_unwrap(r));
    return 1;
}

# persona_shadow (0.22.2): make the SHADOW of `base` (or the active persona when base==0) the active
# persona — avatara's shadow() inverts the traits and emits its own shadow prose (name/desc/soul/spirit),
# so it is a full, usable persona. Pure consumption. Returns 1, or 0 if shadow() rejects a null base.
fn persona_shadow(base) {
    if (base == 0) { base = persona_profile(); }
    var sh = shadow(base);
    if (sh == 0) { return 0; }
    persona_set(sh);
    return 1;
}

# persona_blend (0.22.2): make a weighted multi-archetype BLEND the active persona. `wv` is a vec of
# avatara weighted_new(profile, weight) entries (built + validated by the caller). avatara's compose()
# blends the traits and carries the DOMINANT (highest-weight) archetype's name/soul/spirit prose + a
# "A + B" composite name, so the result is a usable persona. Returns 1, or 0 if compose rejects the inputs.
fn persona_blend(wv) {
    var r = compose(wv);
    if (is_err_result(r) == 1) { return 0; }
    persona_set(result_unwrap(r));
    return 1;
}

# Identity sourced from the avatara archetype.
fn persona_name() { return prof_name(persona_profile()); }
fn persona_tradition() { return prof_tradition(persona_profile()); }
# soul + spirit are avatara's emitted persona prose — they feed the hoosh system
# prompt so the archetype actually steers the turn (see hoosh.cyr, M5 step 2).
fn persona_soul() { return prof_soul(persona_profile()); }
fn persona_spirit() { return prof_spirit(persona_profile()); }
fn persona_desc() { return prof_desc(persona_profile()); }

# persona_role: the active role — a FACET (aspect) of the personality. Precedence (0.24.5 role modality):
#   1. a USER override (/role <text>) — thoth's own overlay, wins outright;
#   2. the SELECTED aspect's role (/role <aspect>) — sourced from avatara;
#   3. the archetype's DEFAULT — "the Librarian" for the signature Thoth (0.22.0 identity split), else the
#      DOMINANT trait-derived aspect (avatara's profile_dominant_aspect → aspect_role) — never thoth-authored
#      per-archetype role prose (that stays avatara's domain).
fn persona_role() {
    if (_persona_role_override != 0) { return _persona_role_override; }
    if (_persona_aspect >= 0) { return aspect_role(_persona_aspect); }
    if (streq(persona_name(), "Thoth") == 1) { return "the Librarian"; }
    return aspect_role(profile_dominant_aspect(persona_profile()));
}

# --- role modality mutators + accessors (0.24.5) ---------------------------
# persona_aspect: the ACTIVE aspect index — the selection, or the archetype's dominant aspect when none is
# selected. For the /role display (which aspect is live).
fn persona_aspect() {
    if (_persona_aspect >= 0) { return _persona_aspect; }
    return profile_dominant_aspect(persona_profile());
}
# persona_role_is_override: 1 if a user custom role label is active (so /role can show it honestly).
fn persona_role_is_override() { if (_persona_role_override != 0) { return 1; } return 0; }

# persona_role_select_aspect: lean the active persona into aspect `i` (its role follows). Clears any user
# override. Marks the system prompt dirty so the model adopts the new role next turn. Returns 1, 0 if OOB.
fn persona_role_select_aspect(i) {
    if (i < 0) { return 0; }
    if (i >= aspect_count()) { return 0; }
    _persona_aspect = i;
    _persona_role_override = 0;
    _persona_sys_dirty = 1;
    return 1;
}
# persona_role_override_set: set a USER role label `s` (any text), copied to stable storage; it trumps the
# aspect. Marks the system prompt dirty. Returns 1, 0 for a null arg.
fn persona_role_override_set(s) {
    if (s == 0) { return 0; }
    var n = strlen(s);
    var c = alloc(n + 1);
    if (n > 0) { memcpy(c, s, n); }
    store8(c + n, 0);
    _persona_role_override = c;
    _persona_sys_dirty = 1;
    return 1;
}
# persona_role_reset: back to the archetype's default role (dominant aspect / "the Librarian"). Marks dirty.
fn persona_role_reset() {
    _persona_aspect = 0 - 1;
    _persona_role_override = 0;
    _persona_sys_dirty = 1;
    return 0;
}
# The THOTH backronym is the APPLICATION's naming — a fixed statement of what the tool does — never the
# active archetype's attribute. It stays constant across persona switches (identity split, 0.22.0).
fn persona_tagline() { return "Thinks, Handles, Orchestrates, Transforms, Heals"; }

# persona_system_prompt: the hoosh system message that makes the backing model
# wear the Thoth/Librarian persona (M5 step 2). Built ONCE from avatara's emitted
# soul + spirit prose (the archetype's own voice) plus thoth's operating clause
# (how the overlay applies to coding — thoth's framing, not avatara logic).
# Cached in the never-freeing bump heap. This is what stops the persona being
# banner-only: it actually steers the turn (see hoosh_send).
var _persona_sys = 0;
var PERSONA_SYS_CAP = 2048;    # 0.22.0: raised from 1 KB — arbitrary switched archetypes' soul+spirit prose
                               # can exceed 1 KB; _append_cstr_cap still clamps (never overruns) if a profile
                               # is longer still. The buffer is allocated ONCE and rebuilt in place per switch.
# Built from avatara's emitted soul + spirit prose, which is fixed-but-not-length-
# bounded — if the archetype's prose ever grows past PERSONA_SYS_CAP the writes must
# clamp, not overrun the buffer. Reuses the shared bounded helper (hoosh.cyr).
fn persona_system_prompt() {
    if ((_persona_sys != 0) && (_persona_sys_dirty == 0)) { return _persona_sys; }
    if (_persona_sys == 0) { _persona_sys = alloc(PERSONA_SYS_CAP); }
    _persona_sys_dirty = 0;
    var cap = PERSONA_SYS_CAP;
    var off = 0;
    off = _append_cstr_cap(_persona_sys, off, cap, persona_soul());
    off = _append_cstr_cap(_persona_sys, off, cap, " ");
    off = _append_cstr_cap(_persona_sys, off, cap, persona_spirit());
    off = _append_cstr_cap(_persona_sys, off, cap, " You are thoth, a sovereign agentic coding scribe: weigh each change, measure twice, edit precisely, and record your reasoning.");
    # 0.24.5 role modality: state the active role (an aspect of this persona, or the user's /role label) so
    # the model leans into it — this is what makes switching a role actually steer the turn, not just relabel.
    off = _append_cstr_cap(_persona_sys, off, cap, " In this session you take the role of ");
    off = _append_cstr_cap(_persona_sys, off, cap, persona_role());
    off = _append_cstr_cap(_persona_sys, off, cap, ".");
    store8(_persona_sys + off, 0);
    return _persona_sys;
}

# print_banner: the scribe greeting (sourced from the avatara persona). I/O.
fn print_banner() {
    oprintln("");
    emit("  ");
    ui_emit(ROLE_ACCENT, persona_name()); emit(", "); ui_emit(ROLE_ACCENT_DIM, persona_role());
    emit(" - "); emit(ui_sgr(ROLE_ACCENT)); emit("thoth "); emit(thoth_version()); emit(ui_reset()); oprintln("");
    emit("  "); ui_emit(ROLE_MUTED, persona_tagline()); oprintln("");
    emit("  "); ui_emit(ROLE_FAINT, "a sovereign agentic coding TUI (fermenting). /help for commands."); oprintln("");
    sess_persist_greeting();      # 0.24.2: "  resumed N messages …" when [session].file restored a conversation (self-indents; silent otherwise)
    oprintln("");
    return 0;
}
