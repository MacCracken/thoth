# thoth — the interactive driver loop.
#
# read a line -> dispatch -> iterate. EOF (Ctrl-D) ends the session. This is
# the platform-neutral core (M2): it reads through the portable substrate
# (read_line) and dispatches to driver commands. No spine bindings.
fn repl_loop() {
    var line[4096];
    var running = 1;
    while (running == 1) {
        emit(ui_sgr(ROLE_ACCENT)); emit("{(o> "); emit(ui_reset());
        var n = read_line(&line, 4096);
        if (n == (0 - 1)) {
            running = 0;
            println("");
        } else {
            if (n > 0) {
                if (dispatch(&line) == 0) { running = 0; }
                if (sess_persist_broke() == 1) {   # 0.24.2: a conversation-file save failed mid-session -> announce ONCE
                    sess_persist_broke_ack();
                    ui_emit(ROLE_FAINT, "session file: write failed — resume disabled for this session"); println("");
                }
            }
        }
    }
    return 0;
}
