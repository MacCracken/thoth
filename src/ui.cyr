# thoth — presentation capability surface (M7 / ADR-0009).
#
# The render surface's FOUNDATION. Presentation is a third capability axis
# alongside the spine seams (src/seams.cyr, docs/architecture/002): a tier
# resolved once at startup — T0 plain -> T1 ANSI -> T2 rich-TUI -> T3 desktop —
# plus a SEMANTIC color-role API the rest of the codebase emits through, so
# feature code never hardcodes an escape. This is Phase 0: at T0 every role
# resolves to the EMPTY STRING, so output is byte-identical to the pre-surface
# binary (pipes / CI / dumb terminals stay exactly as before, the {(o> prompt
# included). T1+ call-site wiring and the T2 raw-mode renderer land in later
# phases. Degrade CLOSED, announce (see /state), never fake.

# Presentation tiers.
var PT_PLAIN = 0;     # T0: line-oriented, no escapes (the floor; today's binary)
var PT_ANSI = 1;      # T1: SGR color + cursor (most terminals)
var PT_RICH = 2;      # T2: raw-mode, alt-screen, panes (reserved — renderer not built yet)
var PT_DESKTOP = 3;   # T3: graphics/desktop host via puka (reserved)

# Color depth within an ANSI-capable tier.
var CD_NONE = 0;
var CD_16 = 1;
var CD_256 = 2;
var CD_TRUE = 3;

# Semantic color roles (named slots — the design's CSS custom properties). Feature
# code asks for a ROLE, never a hex/ANSI code; the active tier+depth resolves it.
var ROLE_ACCENT = 0;       # #e6ab5c amber — the signature accent
var ROLE_ACCENT_DIM = 1;   # #b9863f
var ROLE_FG = 2;           # #ece5d3 warm foreground
var ROLE_MUTED = 3;        # #9b927d
var ROLE_FAINT = 4;        # #6d6553
var ROLE_GREEN = 5;        # #94b87c diff-add / ok
var ROLE_RED = 6;          # #d28a78 diff-del / error
var ROLE_BLUE = 7;         # #82a9c6 paths
var UI_ROLE_COUNT = 8;

# Theme axis (0.10.0): a theme sits IN FRONT of the role axis — the three color
# dispatchers (_ui_rgb/_ui_idx256/_ui_code16) branch on _ui_theme. dark is today's
# amber (the byte-identical default); light is the mockup's warm-light palette. The
# cached SGR table is rebuilt on a /theme switch (ui_set_theme). rainbow is DEFERRED
# (a per-grapheme HSV render mode, not a role table — it needs anuenue vendored).
var THEME_DARK = 0;
var THEME_LIGHT = 1;
var UI_THEME_COUNT = 2;
var _ui_theme = 0;         # default dark -> byte-identical to pre-0.10.0

var _ui_tier = 0;          # active tier (PT_*)
var _ui_depth = 0;         # active color depth (CD_*)
var _ui_detected = 0;      # 1 once detection/override ran
var _ui_role_ptr = 0;      # alloc: UI_ROLE_COUNT i64 cstr pointers (the per-role SGR prefix)
var _ui_reset_ptr = 0;     # the "ESC[0m" reset cstr
var _ui_addbg_ptr = 0;     # diff add-row background tint (48;..), or 0 below 256-color
var _ui_delbg_ptr = 0;     # diff del-row background tint
var _ui_eol_ptr = 0;       # "ESC[K" — fill the rest of the row with the active bg
var _ui_fgreset_ptr = 0;   # "ESC[39m" — reset fg ONLY (keep bg across colored spans)
var UI_SGR_BUF_CAP = 320;

# Linux x86_64: ioctl(fd, TCGETS) returns 0 iff fd is a terminal. (Not in the
# vendored syscall constants; the well-known Linux value.)
var UI_TCGETS = 0x5401;

# ui_isatty: 1 if fd is a tty, else 0 — ioctl(TCGETS) into a throwaway termios buf.
fn ui_isatty(fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no ioctl(TCGETS) tty probe — and Linux syscall 16 (SYS_IOCTL)
    # is `kill` on agnos, so the raw call would be actively wrong, not merely
    # undefined. The agnos fb console interprets ANSI/SGR, so treat any fd as
    # an interactive terminal and let thoth emit its colored TUI.
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var tbuf[64];
    if (syscall(SYS_IOCTL, fd, UI_TCGETS, &tbuf) == 0) { return 1; }
    return 0;
    #endif
}

# _ui_dec: write non-negative n as decimal into buf at off; return new off.
fn _ui_dec(buf, off, n) {
    if (n == 0) { store8(buf + off, 48); return off + 1; }
    var tmp[12];
    var ti = 0;
    while (n > 0) { store8(&tmp + ti, 48 + (n - (n / 10) * 10)); ti = ti + 1; n = n / 10; }
    while (ti > 0) { ti = ti - 1; store8(buf + off, load8(&tmp + ti)); off = off + 1; }
    return off;
}

# _ui_contains: 1 if NUL-terminated s contains NUL-terminated sub. (Used for TERM
# detection — "*-256color" — and reusable.)
fn _ui_contains(s, sub) {
    var i = 0;
    var ret = 0;
    var done = 0;
    while ((load8(s + i) != 0) && (done == 0)) {
        var j = 0;
        var same = 1;
        while ((load8(sub + j) != 0) && (same == 1)) {
            if (load8(s + i + j) != load8(sub + j)) { same = 0; }
            else { j = j + 1; }
        }
        if (same == 1) { ret = 1; done = 1; }
        else { i = i + 1; }
    }
    return ret;
}

fn _ui_env_has(name) {
    var v = getenv(name);
    if (v == 0) { return 0; }
    if (load8(v) == 0) { return 0; }
    return 1;
}

# Per-role color data, theme-dispatched. RGB packed as r*65536 + g*256 + b; the
# 256-color and 16-color fallbacks are the nearest readable approximations. Each
# public dispatcher branches on _ui_theme; the _dark leaves are the pre-0.10.0
# values verbatim (so dark output is bit-for-bit unchanged).
fn _ui_rgb(role) { if (_ui_theme == THEME_LIGHT) { return _ui_rgb_light(role); } return _ui_rgb_dark(role); }
fn _ui_rgb_dark(role) {
    if (role == ROLE_ACCENT) { return 230 * 65536 + 171 * 256 + 92; }
    if (role == ROLE_ACCENT_DIM) { return 185 * 65536 + 134 * 256 + 63; }
    if (role == ROLE_FG) { return 236 * 65536 + 229 * 256 + 211; }
    if (role == ROLE_MUTED) { return 155 * 65536 + 146 * 256 + 125; }
    if (role == ROLE_FAINT) { return 109 * 65536 + 101 * 256 + 83; }
    if (role == ROLE_GREEN) { return 148 * 65536 + 184 * 256 + 124; }
    if (role == ROLE_RED) { return 210 * 65536 + 138 * 256 + 120; }
    if (role == ROLE_BLUE) { return 130 * 65536 + 169 * 256 + 198; }
    return 236 * 65536 + 229 * 256 + 211;
}
# Light: the mockup's warm-light palette — a dark warm-amber accent on light paper,
# dark ink fg, the diff/path hues darkened for contrast on a light background.
fn _ui_rgb_light(role) {
    if (role == ROLE_ACCENT) { return 176 * 65536 + 122 * 256 + 37; }
    if (role == ROLE_ACCENT_DIM) { return 148 * 65536 + 100 * 256 + 35; }
    if (role == ROLE_FG) { return 44 * 65536 + 40 * 256 + 32; }
    if (role == ROLE_MUTED) { return 118 * 65536 + 108 * 256 + 88; }
    if (role == ROLE_FAINT) { return 154 * 65536 + 144 * 256 + 121; }
    if (role == ROLE_GREEN) { return 93 * 65536 + 122 * 256 + 69; }
    if (role == ROLE_RED) { return 177 * 65536 + 87 * 256 + 64; }
    if (role == ROLE_BLUE) { return 67 * 65536 + 106 * 256 + 134; }
    return 44 * 65536 + 40 * 256 + 32;
}
fn _ui_idx256(role) { if (_ui_theme == THEME_LIGHT) { return _ui_idx256_light(role); } return _ui_idx256_dark(role); }
fn _ui_idx256_dark(role) {
    if (role == ROLE_ACCENT) { return 179; }
    if (role == ROLE_ACCENT_DIM) { return 137; }
    if (role == ROLE_FG) { return 223; }
    if (role == ROLE_MUTED) { return 144; }
    if (role == ROLE_FAINT) { return 242; }
    if (role == ROLE_GREEN) { return 108; }
    if (role == ROLE_RED) { return 174; }
    if (role == ROLE_BLUE) { return 110; }
    return 223;
}
fn _ui_idx256_light(role) {
    if (role == ROLE_ACCENT) { return 136; }
    if (role == ROLE_ACCENT_DIM) { return 94; }
    if (role == ROLE_FG) { return 235; }
    if (role == ROLE_MUTED) { return 242; }
    if (role == ROLE_FAINT) { return 245; }
    if (role == ROLE_GREEN) { return 65; }
    if (role == ROLE_RED) { return 131; }
    if (role == ROLE_BLUE) { return 60; }
    return 235;
}
fn _ui_code16(role) { if (_ui_theme == THEME_LIGHT) { return _ui_code16_light(role); } return _ui_code16_dark(role); }
fn _ui_code16_dark(role) {
    if (role == ROLE_ACCENT) { return 33; }       # yellow
    if (role == ROLE_ACCENT_DIM) { return 33; }
    if (role == ROLE_FG) { return 39; }            # default fg
    if (role == ROLE_MUTED) { return 90; }         # bright black (gray)
    if (role == ROLE_FAINT) { return 90; }
    if (role == ROLE_GREEN) { return 32; }
    if (role == ROLE_RED) { return 31; }
    if (role == ROLE_BLUE) { return 34; }
    return 39;
}
# 16-color: the named-color floor genuinely can't render warm-light hues, so light
# shares the dark codes (honest — at CD_16 'light' just isn't visually light).
fn _ui_code16_light(role) { return _ui_code16_dark(role); }

# _ui_bg_escape: write a background SGR (48;2;R;G;B truecolor, or 48;5;idx256) into
# buf at off; return new off. The diff-row tints.
fn _ui_bg_escape(buf, off, r, g, b, idx256) {
    store8(buf + off, 27); off = off + 1;
    store8(buf + off, 91); off = off + 1;
    if (_ui_depth == CD_TRUE) {
        off = _ui_dec(buf, off, 48);
        store8(buf + off, 59); off = off + 1;
        store8(buf + off, 50); off = off + 1;        # 2
        store8(buf + off, 59); off = off + 1;
        off = _ui_dec(buf, off, r);
        store8(buf + off, 59); off = off + 1;
        off = _ui_dec(buf, off, g);
        store8(buf + off, 59); off = off + 1;
        off = _ui_dec(buf, off, b);
    } else {
        off = _ui_dec(buf, off, 48);
        store8(buf + off, 59); off = off + 1;
        store8(buf + off, 53); off = off + 1;        # 5
        store8(buf + off, 59); off = off + 1;
        off = _ui_dec(buf, off, idx256);
    }
    store8(buf + off, 109); off = off + 1;           # m
    store8(buf + off, 0); off = off + 1;             # NUL
    return off;
}

# Build the per-role SGR prefix table + reset for the active depth, ONCE. Each
# role's escape is a stable NUL-terminated cstr in a bump-heap buffer.
fn _ui_build_palette() {
    _ui_role_ptr = alloc(UI_ROLE_COUNT * 8);
    var buf = alloc(UI_SGR_BUF_CAP);
    var off = 0;
    var role = 0;
    while (role < UI_ROLE_COUNT) {
        store64(_ui_role_ptr + role * 8, buf + off);
        store8(buf + off, 27); off = off + 1;       # ESC
        store8(buf + off, 91); off = off + 1;        # [
        if (_ui_depth == CD_TRUE) {
            var rgb = _ui_rgb(role);
            var r = rgb / 65536;
            var rem = rgb - r * 65536;
            var g = rem / 256;
            var b = rem - g * 256;
            off = _ui_dec(buf, off, 38);
            store8(buf + off, 59); off = off + 1;
            store8(buf + off, 50); off = off + 1;    # 2
            store8(buf + off, 59); off = off + 1;
            off = _ui_dec(buf, off, r);
            store8(buf + off, 59); off = off + 1;
            off = _ui_dec(buf, off, g);
            store8(buf + off, 59); off = off + 1;
            off = _ui_dec(buf, off, b);
        } elif (_ui_depth == CD_256) {
            off = _ui_dec(buf, off, 38);
            store8(buf + off, 59); off = off + 1;
            store8(buf + off, 53); off = off + 1;    # 5
            store8(buf + off, 59); off = off + 1;
            off = _ui_dec(buf, off, _ui_idx256(role));
        } else {
            off = _ui_dec(buf, off, _ui_code16(role));
        }
        store8(buf + off, 109); off = off + 1;       # m
        store8(buf + off, 0); off = off + 1;          # NUL
        role = role + 1;
    }
    _ui_reset_ptr = buf + off;
    store8(buf + off, 27); off = off + 1;
    store8(buf + off, 91); off = off + 1;
    store8(buf + off, 48); off = off + 1;            # 0
    store8(buf + off, 109); off = off + 1;           # m
    store8(buf + off, 0); off = off + 1;
    # diff-row background tints (subtle; only at >=256 color), + ESC[K row-fill and
    # ESC[39m fg-only reset (so the bg survives the colored spans on a tinted row).
    _ui_addbg_ptr = 0;
    _ui_delbg_ptr = 0;
    if ((_ui_depth == CD_256) || (_ui_depth == CD_TRUE)) {
        _ui_addbg_ptr = buf + off;
        off = _ui_bg_escape(buf, off, 34, 35, 24, 22);
        _ui_delbg_ptr = buf + off;
        off = _ui_bg_escape(buf, off, 40, 30, 24, 52);
    }
    _ui_eol_ptr = buf + off;
    store8(buf + off, 27); off = off + 1; store8(buf + off, 91); off = off + 1;
    store8(buf + off, 75); off = off + 1; store8(buf + off, 0); off = off + 1;    # ESC[K
    _ui_fgreset_ptr = buf + off;
    store8(buf + off, 27); off = off + 1; store8(buf + off, 91); off = off + 1;
    store8(buf + off, 51); off = off + 1; store8(buf + off, 57); off = off + 1;   # 3 9
    store8(buf + off, 109); off = off + 1; store8(buf + off, 0); off = off + 1;   # m NUL
    return 0;
}

# _ui_apply: set the active tier+depth and (for a color tier) build the palette.
fn _ui_apply(tier, depth) {
    _ui_tier = tier;
    _ui_depth = depth;
    _ui_detected = 1;
    if (tier != PT_PLAIN) { _ui_build_palette(); }
    return 0;
}

# --- theme switch (0.10.0) ---
# ui_set_theme: select a theme and REBUILD the cached SGR table under it, KEEPING the
# detected tier/depth (so we don't re-run detection). _ui_build_palette alloc()s a
# fresh role table each call and re-reads the (now theme-branching) color fns, so this
# cleanly re-colors every cached prefix. The old buffer leaks ~390 B into the
# never-freeing bump heap — bounded + idiomatic (theme switches are rare interactive
# actions; NEVER call this from a paint loop). At PT_PLAIN it only records the theme
# (every role stays "" — the floor is byte-identical regardless of theme).
fn ui_set_theme(t) {
    _ui_theme = t;
    if (_ui_tier != PT_PLAIN) { _ui_build_palette(); }
    return 0;
}
fn ui_theme() { return _ui_theme; }
fn ui_theme_name() { if (_ui_theme == THEME_LIGHT) { return "light"; } return "dark"; }
# ui_theme_from_name: theme id for a name, or -1 if unknown (rainbow is deferred, so
# it resolves to -1 too — the /theme command announces it, never fakes a cycle).
fn ui_theme_from_name(s) {
    if (streq(s, "dark") == 1) { return THEME_DARK; }
    if (streq(s, "light") == 1) { return THEME_LIGHT; }
    return 0 - 1;
}

# _ui_detect_depth: truecolor (COLORTERM) -> 256 (TERM *-256color) -> 16.
fn _ui_detect_depth() {
    var ct = getenv("COLORTERM");
    if (ct != 0) {
        if (streq(ct, "truecolor") == 1) { return CD_TRUE; }
        if (streq(ct, "24bit") == 1) { return CD_TRUE; }
    }
    var term = getenv("TERM");
    if (term != 0) { if (_ui_contains(term, "256color") == 1) { return CD_256; } }
    return CD_16;
}

# --- presentation-tier preference (0.11.10: the --tier flag) ---
# The user's requested tier, set from `--tier=<mode>` (src/oneshot.cyr parses it; src/main.cyr
# applies it via ui_set_tier_pref BEFORE ui_detect_tier). AUTO is the default — no flag means
# auto. This REPLACES the old THOTH_TIER env-var (dropped in 0.11.10; the flag is the only control).
var TIER_AUTO = 0;     # detect the best tier the terminal supports (rich TUI when capable)
var TIER_SIMPLE = 1;   # line mode — ANSI color when provable, else plain; never the TUI
var TIER_RICH = 2;     # force the rich TUI when usable; degrade to the line tier otherwise
var _ui_tier_pref = 0; # default TIER_AUTO

fn ui_set_tier_pref(p) { _ui_tier_pref = p; return 0; }
fn ui_tier_pref() { return _ui_tier_pref; }
# ui_tier_pref_from_name: map a --tier value to a TIER_* preference, or -1 if unknown. Pure.
fn ui_tier_pref_from_name(s) {
    if (streq(s, "auto") == 1) { return TIER_AUTO; }
    if (streq(s, "simple") == 1) { return TIER_SIMPLE; }
    if (streq(s, "rich") == 1) { return TIER_RICH; }
    return 0 - 1;
}

# _ui_color_capable: 1 iff color can be PROVEN — NO_COLOR unset, stdout is a tty, TERM
# set/non-empty/non-dumb. The degrade-closed gate for any colored tier (ANSI or rich). Pure-ish
# (reads env + isatty); factored out of the old ui_detect_tier so SIMPLE/RICH/AUTO share it.
fn _ui_color_capable() {
    if (_ui_env_has("NO_COLOR") == 1) { return 0; }
    if (ui_isatty(1) == 0) { return 0; }
    var term = getenv("TERM");
    if (term == 0) { return 0; }
    if (load8(term) == 0) { return 0; }
    if (streq(term, "dumb") == 1) { return 0; }
    return 1;
}

# ui_detect_tier: resolve the active presentation tier ONCE at startup, from the --tier
# preference (default AUTO). The rich TUI renders in color, so PT_RICH requires BOTH a real tty
# (stdin+stdout) AND color-capability — NO_COLOR / dumb / piped degrade CLOSED to the line tier
# (ANSI when color is provable, else plain). _ui_detect_depth never returns CD_NONE, so PT_RICH /
# PT_ANSI always carry a real depth.
fn ui_detect_tier() {
    var pref = _ui_tier_pref;
    var capable = _ui_color_capable();
    # SIMPLE: line mode only — color when provable, else plain.
    if (pref == TIER_SIMPLE) {
        if (capable == 1) { _ui_apply(PT_ANSI, _ui_detect_depth()); return 0; }
        _ui_apply(PT_PLAIN, CD_NONE);
        return 0;
    }
    # RICH / AUTO: the rich TUI when interactive + color-capable; else the SIMPLE fallback. (A
    # requested-but-unusable `rich` degrades, never errors — same posture the old THOTH_TIER=rich
    # had, plus the color check. tui_active + tui_loop are the further safety nets.)
    if ((ui_isatty(0) == 1) && (ui_isatty(1) == 1) && (capable == 1)) {
        _ui_apply(PT_RICH, _ui_detect_depth());
        return 0;
    }
    if (capable == 1) { _ui_apply(PT_ANSI, _ui_detect_depth()); return 0; }
    _ui_apply(PT_PLAIN, CD_NONE);
    return 0;
}

# ui_force: explicit tier+depth override — test hook and the future --tier flag.
fn ui_force(tier, depth) { _ui_apply(tier, depth); return 0; }

# --- the surface API feature code calls ---

# ui_sgr: the SGR prefix cstr for a semantic role at the active tier, or "" at T0
# (so `emit(ui_sgr(r)); emit(s); emit(ui_reset())` is byte-identical to `emit(s)`
# on the plain floor). The returned pointer is stable for the session.
fn ui_sgr(role) {
    if (_ui_tier == PT_PLAIN) { return ""; }
    if (_ui_role_ptr == 0) { return ""; }
    if (role < 0) { return ""; }
    if (role >= UI_ROLE_COUNT) { return ""; }
    return load64(_ui_role_ptr + role * 8);
}
# ui_reset: the SGR reset cstr, or "" at T0.
fn ui_reset() {
    if (_ui_tier == PT_PLAIN) { return ""; }
    if (_ui_reset_ptr == 0) { return ""; }
    return _ui_reset_ptr;
}

# UI_SGR_RESET: the sentinel ui_role_of_sgr returns for the reset cstr (distinct from a role 0..7).
var UI_SGR_RESET = 100;

# _ui_cstr_eq_n: 1 iff the NUL-terminated cstr `a` is EXACTLY `n` bytes long and equals b[0..n).
fn _ui_cstr_eq_n(a, b, n) {
    var j = 0;
    while (j < n) { if (load8(a + j) != load8(b + j)) { return 0; } j = j + 1; }
    if (load8(a + n) != 0) { return 0; }              # `a` must end exactly at n (no longer)
    return 1;
}

# ui_role_of_sgr: reverse-map an SGR escape at src[i..i+sl) to the semantic ROLE that produced it — a
# role 0..7, UI_SGR_RESET for the reset cstr, or -1 for anything else. EXACT whole-string byte match
# against the cached per-role SGR prefixes + the reset (so ui_reset_fg `ESC[39m`, ui_bg `ESC[48;..m` and
# ui_eol `ESC[K` are NEVER matched — they stay verbatim, keeping diff-row output byte-identical). Backs
# the feed's seal-time reverse-map (0.18.0): the ring stores a compact role MARKER instead of the
# theme-concrete SGR, so a later `/theme` switch can re-resolve it. Requires a real `ESC [ ... m` CSI.
fn ui_role_of_sgr(src, i, sl) {
    if (sl < 3) { return 0 - 1; }                     # need at least ESC [ m
    if (load8(src + i + 1) != 91) { return 0 - 1; }   # not a CSI ('[')
    if (load8(src + i + sl - 1) != 109) { return 0 - 1; }   # does not end in 'm' (SGR)
    if (_ui_reset_ptr != 0) {
        if (_ui_cstr_eq_n(_ui_reset_ptr, src + i, sl) == 1) { return UI_SGR_RESET; }
    }
    if (_ui_role_ptr == 0) { return 0 - 1; }
    var r = 0;
    while (r < UI_ROLE_COUNT) {
        var p = load64(_ui_role_ptr + r * 8);
        if (p != 0) { if (_ui_cstr_eq_n(p, src + i, sl) == 1) { return r; } }
        r = r + 1;
    }
    return 0 - 1;
}

# ui_bg: the background-tint escape for a diff row (which 0=add, 1=del), or "" at the
# plain tier / below 256-color (row tints aren't drawn there). Stable for the session.
fn ui_bg(which) {
    if (_ui_tier == PT_PLAIN) { return ""; }
    if (which == 0) { if (_ui_addbg_ptr == 0) { return ""; } return _ui_addbg_ptr; }
    if (_ui_delbg_ptr == 0) { return ""; }
    return _ui_delbg_ptr;
}
# ui_eol: ESC[K — fill the rest of the current row with the active bg (or "" at T0).
fn ui_eol() {
    if (_ui_tier == PT_PLAIN) { return ""; }
    if (_ui_eol_ptr == 0) { return ""; }
    return _ui_eol_ptr;
}
# ui_reset_fg: ESC[39m — reset FG only, keeping the active bg (or "" at T0).
fn ui_reset_fg() {
    if (_ui_tier == PT_PLAIN) { return ""; }
    if (_ui_fgreset_ptr == 0) { return ""; }
    return _ui_fgreset_ptr;
}

# ui_emit: write s wrapped in the role's color (just s at T0 — byte-identical on
# the floor). The common "one colored span" case over the ui_sgr/ui_reset pair.
fn ui_emit(role, s) {
    emit(ui_sgr(role));
    emit(s);
    emit(ui_reset());
    return 0;
}
# ui_label: a dim label span (faint role) — sugar for "  key : " prefixes.
fn ui_label(s) { return ui_emit(ROLE_FAINT, s); }
# ui_emit_n: like ui_emit but for (ptr,len) Str data that isn't a NUL-terminated
# cstr (model ids, tool names). Just the bytes at T0.
fn ui_emit_n(role, ptr, n) {
    emit(ui_sgr(role));
    emit_n(ptr, n);
    emit(ui_reset());
    return 0;
}

# ui_match_on: the feed-search match highlight SGR — reverse video for a match, reverse+underline for the
# CURRENT match (cur==1), or "" at the plain tier (floor: a highlight adds zero bytes). Theme- and
# depth-independent (reverse/underline render at CD_16+ and even monochrome), so these are static literals,
# not cached theme SGR. The matching OFF is emitted by fsearch_render as a reset marker + role restore (it
# collapses feed_clip_seg's wrap carry and clears reverse+underline in one shot), so there is no ui_match_off.
fn ui_match_on(cur) {
    if (_ui_tier == PT_PLAIN) { return ""; }
    if (cur == 1) { return "\x1b[7;4m"; }      # current match: reverse + underline
    return "\x1b[7m";                            # other matches: reverse video
}

# Introspection (announced in /state; future /seams presentation row).
fn ui_tier() { return _ui_tier; }
fn ui_color_depth() { return _ui_depth; }
fn ui_tier_name() {
    if (_ui_tier == PT_ANSI) { return "T1 ansi"; }
    if (_ui_tier == PT_RICH) { return "T2 rich-tui"; }
    if (_ui_tier == PT_DESKTOP) { return "T3 desktop"; }
    return "T0 plain";
}
fn ui_color_depth_name() {
    if (_ui_depth == CD_TRUE) { return "truecolor"; }
    if (_ui_depth == CD_256) { return "256-color"; }
    if (_ui_depth == CD_16) { return "16-color"; }
    return "no color";
}
