# thoth — small target-neutral I/O + text utilities.
#
# These are SUBSTRATE helpers: they write through the portable syscall
# interface and never touch the capability spine. Both src/main.cyr and the
# test suite include this module; keep it free of top-level execution.

# Buffered stdin line reader state. The carry buffer lets one read() satisfy
# many lines (Linux pipes deliver multi-line blobs) while still returning
# exactly one line per call (agnos line-discipline delivers one).
var _rl_buf[4096];
var _rl_len = 0;
var _rl_pos = 0;

# --- the feed-capture output sink (M7 / 0.9.1) -------------------------------
# The T2 feed is SELF-MANAGED (src/feed.cyr): dispatch output is captured into a
# line ring instead of scrolling the terminal natively, so it can be repainted at
# a new size (instant SIGWINCH, 0.9.2) or in a narrowed column (the file-tree
# pane, 0.9.3). Capture is a module-global mode the TUI arms ONLY around the
# dispatch() window:
#   OUT_FD1  (default) — write straight to stdout: the REPL / piped / CI floor,
#            byte-identical to the pre-0.9.1 binary (capture is NEVER armed here);
#   OUT_RING — route writes through the registered ring sink (&feed_write, wired at
#            startup) inside the PT_RICH dispatch window — util never names the feed.
# Three writer classes reach fd 1: emit/emit_n here (ui_emit funnels through
# them); the stdlib bypass println/fmt_int (shadowed as oprintln/ofmt_int below);
# and the renderer's OWN chrome — which must NEVER be captured, so it writes
# through emit_raw/emit_raw_n (always fd 1, blind to the mode).
var OUT_FD1 = 0;
var OUT_RING = 1;
# OUT_NULL (0.11.0) — DISCARD all emit output. One-shot/argv mode arms this around
# the dispatch window so the turn's human-progress chrome (banner, the "-> hoosh"
# line, agent tool-call/result lines, the streamed-or-blocking answer copy) is
# suppressed; one_shot_run then prints ONLY the final answer (from the reply
# accumulator) to fd 1, so a piped/redirected one-shot stdout is the clean answer.
var OUT_NULL = 2;
var _out_mode = 0;          # OUT_FD1 until the TUI arms capture / one-shot arms discard

fn out_mode() { return _out_mode; }
fn out_mode_set(m) { _out_mode = m; return 0; }

# The OUT_RING sink (TUI-decoupling refactor): under OUT_RING, emit/emit_n/oprintln/ofmt_int route their bytes
# through this registered function pointer instead of calling feed_write directly — so util (substrate) no
# longer references the TUI feed. The renderer registers &feed_write once at startup; a build that never wires
# a feed (a curated test that omits feed.cyr) leaves it 0 and never arms OUT_RING, so writes just no-op.
var _ring_sink = 0;
fn out_ring_sink_set(fp) { _ring_sink = fp; return 0; }
fn _ring_emit(ptr, n) { if (_ring_sink != 0) { fncall2(_ring_sink, ptr, n); } return 0; }

# emit_err / emit_err_n: ALWAYS write to stderr (fd 2), ignoring _out_mode. One-shot
# diagnostics (a transport/HTTP error, a denied authorization, an empty reply) go
# here so stdout stays the clean answer channel for piping/`thoth | thoth` chaining.
fn emit_err(s) { syscall(SYS_WRITE, 2, s, strlen(s)); return 0; }
fn emit_err_n(ptr, n) { syscall(SYS_WRITE, 2, ptr, n); return 0; }

# _one_shot (0.11.0): set while a one-shot/argv turn runs. The t-ron confirm gate
# reads it to DENY (fail-closed) instead of blocking on an unanswerable prompt — a
# non-interactive invocation can't safely authorize, so it degrades closed.
var _one_shot = 0;
fn one_shot_active() { return _one_shot; }
fn one_shot_set(v) { _one_shot = v; return 0; }

# emit_raw / emit_raw_n: ALWAYS write to stdout, ignoring _out_mode. The TUI
# chrome (status bar, composer, hint, feed paint, the tree) draws the terminal
# directly and MUST bypass the capture branch — else feed paint would feed its
# own bytes back into the ring (self-recursion) and the chrome would be captured
# rather than shown.
fn emit_raw(s) { syscall(SYS_WRITE, 1, s, strlen(s)); return 0; }
fn emit_raw_n(ptr, n) { syscall(SYS_WRITE, 1, ptr, n); return 0; }

# emit: write a NUL-terminated string to stdout (or the feed ring when capture is
# armed), no trailing newline.
fn emit(s) {
    if (_out_mode == OUT_RING) { _ring_emit(s, strlen(s)); return 0; }
    if (_out_mode == OUT_NULL) { return 0; }
    syscall(SYS_WRITE, 1, s, strlen(s));
    return 0;
}

# emit_n: write n bytes from ptr to stdout (or the feed ring when capture is armed).
fn emit_n(ptr, n) {
    if (_out_mode == OUT_RING) { _ring_emit(ptr, n); return 0; }
    if (_out_mode == OUT_NULL) { return 0; }
    syscall(SYS_WRITE, 1, ptr, n);
    return 0;
}

# oprintln / ofmt_int: mode-aware shadows of stdlib println / fmt_int, which write
# fd 1 DIRECTLY (bypassing emit). The dispatch tree calls these instead of the
# stdlib twins so its output is captured under OUT_RING; under OUT_FD1 each is
# byte-identical to its twin (oprintln -> println, ofmt_int -> fmt_int), so the
# piped/CI floor is unchanged. Under OUT_RING they route through _ring_emit (the
# registered sink), so util holds no reference to feed.cyr.
fn oprintln(s) {
    if (_out_mode == OUT_RING) { _ring_emit(s, strlen(s)); _ring_emit("\n", 1); return 0; }
    if (_out_mode == OUT_NULL) { return 0; }
    return println(s);
}
fn ofmt_int(n) {
    if (_out_mode == OUT_RING) {
        var b[24];
        var len = fmt_int_buf(n, &b);
        _ring_emit(&b, len);
        return 0;
    }
    if (_out_mode == OUT_NULL) { return 0; }
    return fmt_int(n);
}

# read_line: read one line from stdin into buf (NUL-terminated, newline
# stripped). Returns the line length (>= 0), or (0 - 1) on EOF with no input.
# Avoids `break` inside a var-bearing loop per the Cyrius break caveat — uses
# a sentinel (ret) and an inner stop flag instead.
fn read_line(buf, maxlen) {
    var i = 0;
    var ret = 0 - 2;
    while (ret == (0 - 2)) {
        if (_rl_pos >= _rl_len) {
            _rl_pos = 0;
            _rl_len = syscall(SYS_READ, 0, &_rl_buf, 4095);
            # A read error (negative) is treated as EOF intentionally: with no
            # buffered input there is nothing to recover, so we end the line /
            # session rather than spin re-reading a persistently failing fd.
            if (_rl_len <= 0) {
                if (i == 0) { ret = 0 - 1; }
                else { store8(buf + i, 0); ret = i; }
            }
        }
        if (ret == (0 - 2)) {
            var stop = 0;
            while (_rl_pos < _rl_len && stop == 0) {
                var ch = load8(&_rl_buf + _rl_pos);
                _rl_pos = _rl_pos + 1;
                if (ch == 10) {
                    store8(buf + i, 0);
                    ret = i;
                    stop = 1;
                } else {
                    if (i < (maxlen - 1)) {
                        store8(buf + i, ch);
                        i = i + 1;
                    }
                }
            }
        }
    }
    return ret;
}

# cstr_starts_with: 1 if NUL-terminated s begins with NUL-terminated prefix.
fn cstr_starts_with(s, prefix) {
    var i = 0;
    var ret = 0 - 2;
    while (ret == (0 - 2)) {
        var pc = load8(prefix + i);
        if (pc == 0) { ret = 1; }
        else {
            var sc = load8(s + i);
            if (sc != pc) { ret = 0; }
            else { i = i + 1; }
        }
    }
    return ret;
}
