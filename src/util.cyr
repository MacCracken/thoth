# thoth — small target-neutral I/O + text utilities.
#
# These are SUBSTRATE helpers: they write through the portable syscall
# interface and never touch the capability spine. Both src/main.cyr and the
# test suite include this module; keep it free of top-level execution.

# Buffered stdin line reader state. The carry buffer lets one read() satisfy
# many lines (Linux pipes deliver multi-line blobs) while still returning
# exactly one line per call (agnos line-discipline delivers one).
var _rl_buf[4096];
var _rl_len = 0;
var _rl_pos = 0;

# --- the feed-capture output sink (M7 / 0.9.1) -------------------------------
# The T2 feed is SELF-MANAGED (src/feed.cyr): dispatch output is captured into a
# line ring instead of scrolling the terminal natively, so it can be repainted at
# a new size (instant SIGWINCH, 0.9.2) or in a narrowed column (the file-tree
# pane, 0.9.3). Capture is a module-global mode the TUI arms ONLY around the
# dispatch() window:
#   OUT_FD1  (default) — write straight to stdout: the REPL / piped / CI floor,
#            byte-identical to the pre-0.9.1 binary (capture is NEVER armed here);
#   OUT_RING — route writes through the registered ring sink (&feed_write, wired at
#            startup) inside the PT_RICH dispatch window — util never names the feed.
# Three writer classes reach fd 1: emit/emit_n here (ui_emit funnels through
# them); the stdlib bypass println/fmt_int (shadowed as oprintln/ofmt_int below);
# and the renderer's OWN chrome — which must NEVER be captured, so it writes
# through emit_raw/emit_raw_n (always fd 1, blind to the mode).
var OUT_FD1 = 0;
var OUT_RING = 1;
# OUT_NULL (0.11.0) — DISCARD all emit output. One-shot/argv mode arms this around
# the dispatch window so the turn's human-progress chrome (banner, the "-> hoosh"
# line, agent tool-call/result lines, the streamed-or-blocking answer copy) is
# suppressed; one_shot_run then prints ONLY the final answer (from the reply
# accumulator) to fd 1, so a piped/redirected one-shot stdout is the clean answer.
var OUT_NULL = 2;
var _out_mode = 0;          # OUT_FD1 until the TUI arms capture / one-shot arms discard

fn out_mode() { return _out_mode; }
fn out_mode_set(m) { _out_mode = m; return 0; }

# The OUT_RING sink (TUI-decoupling refactor): under OUT_RING, emit/emit_n/oprintln/ofmt_int route their bytes
# through this registered function pointer instead of calling feed_write directly — so util (substrate) no
# longer references the TUI feed. The renderer registers &feed_write once at startup; a build that never wires
# a feed (a curated test that omits feed.cyr) leaves it 0 and never arms OUT_RING, so writes just no-op.
var _ring_sink = 0;
fn out_ring_sink_set(fp) { _ring_sink = fp; return 0; }
fn _ring_emit(ptr, n) { if (_ring_sink != 0) { fncall2(_ring_sink, ptr, n); } return 0; }

# emit_err / emit_err_n: ALWAYS write to stderr (fd 2), ignoring _out_mode. One-shot
# diagnostics (a transport/HTTP error, a denied authorization, an empty reply) go
# here so stdout stays the clean answer channel for piping/`thoth | thoth` chaining.
fn emit_err(s) { syscall(SYS_WRITE, 2, s, strlen(s)); return 0; }

# --- notices that must land on EVERY surface (0.44.2) --------------------------------------------------
#
# ⚠ `emit` / `oprintln` / `ui_emit` all return immediately under OUT_NULL — and OUT_NULL is what one-shot
# and the T3 GUI run their turns under, because stdout there is the answer (or nothing at all). That is
# right for narration and wrong for a SECURITY notice: a tool withheld because its MCP definition changed
# under the session, a prompt-injection flag on a tool result, a redaction, a hook that blocked a call —
# each of those was announced with exactly those calls, so on two of thoth's three surfaces they were
# announced to nobody. The operator saw an agent that had quietly stopped using a tool.
#
# These route to STDERR when the normal channel is a discard. stderr is not swallowed in one-shot (it is
# where every other honest diagnostic already goes) and in the GUI it reaches the launching terminal.
fn note_emit(s) {
    if (out_mode() == OUT_NULL) { return emit_err(s); }
    return emit(s);
}
fn note_println(s) {
    if (out_mode() == OUT_NULL) { emit_err(s); emit_err("\n"); return 0; }
    emit(s);
    return oprintln("");
}
fn emit_err_n(ptr, n) { syscall(SYS_WRITE, 2, ptr, n); return 0; }

# note_emit_label (0.45.2): note_emit for an untrusted LABEL — a model-chosen tool name, an MCP server's tool name.
# emit_clean_line writes through emit, which is a discard on exactly the surfaces note_* exists for, so the label is
# copied through the house sanitiser below (bounded at NOTE_LABEL_CAP) and then noted like any other notice.
var NOTE_LABEL_CAP = 512;
var _note_label_buf = 0;
fn note_emit_label(s) {
    if (_note_label_buf == 0) { _note_label_buf = alloc(NOTE_LABEL_CAP); }
    if (_note_label_buf == 0) { return 0; }
    safe_label_copy(_note_label_buf, NOTE_LABEL_CAP, s);
    return note_emit(_note_label_buf);
}

# safe_label_copy: copy `src` into `dst` (bounded by `cap`, NUL-terminated), substituting every C0
# control byte and DEL with '?'. Returns the bytes written.
#
# ⚠ THIS IS THE HOUSE SANITISER FOR UNTRUSTED BYTES ABOUT TO BE DRAWN AS CHROME, and it lives here — in
# the module everything includes — precisely because the 0.39.0 audit's lesson (findings A-7/A-8) was
# that thoth kept writing a NEW filter at each sink instead of putting the existing one where the bytes
# enter. `led_paste` had the right policy in 0.17.0; two sibling paths into the same composer and the
# same terminal never adopted it. 0.44.3 found the next sibling: the fail-closed `confirm` prompt in
# src/gate.cyr printed the model's own tool name / shell command raw, one line above the y/N the
# operator answers — a security decision whose text the party being decided about controls.
#
# SUBSTITUTE rather than drop: '?' preserves the byte count, so every width and column calculation
# downstream stays correct. Newlines go too, because a '\n' in a label is a free extra screen row the
# untrusted side controls, which is layout forgery on any surface whose shape carries meaning.
# emit_clean_line / emit_clean_text: write untrusted bytes to the active sink with terminal-escape
# sequences neutralised, in bounded chunks and with NO cap on the total — so a long tool result is still
# shown in full, which a copy-into-a-fixed-buffer approach could not do.
#
# TWO POLICIES, because the two kinds of untrusted string differ in what a newline MEANS:
#
#   emit_clean_line — a LABEL: a tool name, a tool's `arguments`. These occupy one line of chrome that
#     thoth composed, so a `\n` is a free extra row the untrusted side controls (forging a whole feed
#     line, e.g. a fake "result: ok"). Every C0 and DEL becomes '?'.
#   emit_clean_text — a RESULT: a file listing, a diff, a compiler's output. Newlines and tabs are the
#     content's own structure and mangling them would make the feature useless, so those two survive
#     and everything else in C0 (ESC above all) plus DEL becomes '?'.
#
# ⚠ WHY THIS EXISTS. `feed_clip` copies an unrecognised escape VERBATIM — it must, because thoth's own
# role markers ride the same channel — so an ESC inside a model-chosen tool name or a third-party MCP
# server's result text reaches the terminal and is executed by it. Substitute rather than drop, for the
# reason the whole house rule gives: '?' preserves the byte count, so column maths stays correct.
#
# emit_clean_line_n / emit_clean_text_n (0.45.0): the same two policies over exactly `n` bytes, for a Str taken
# straight out of a parsed response (ptr + len). Not a convenience: a JSON escape for NUL (backslash, u, 0000)
# decodes to a real NUL byte, and the cstring forms stop there, silently dropping the rest of an error message.
# Here a NUL is a C0 byte like any other and becomes '?'. ONE loop behind all four forms; a second copy of the
# policy is how A-7/A-8 happened.
#
# _clean_byte (0.45.0): that policy for ONE byte. The emit loop below and the in-place clean_text_n both call it, so
# the two ways of cleaning (write the bytes out, or fix them where they lie) cannot drift apart.
fn _clean_byte(b, keep_ws) {
    if (keep_ws == 1) {
        if (b == 10) { return b; }
        if (b == 9) { return b; }
    }
    if (b < 32) { return 63; }
    if (b == 127) { return 63; }
    return b;
}
fn _emit_clean_n(p, n, keep_ws) {
    if (p == 0) { return 0; }
    var buf[264];
    var o = 0;
    var i = 0;
    while (i < n) {
        store8(&buf + o, _clean_byte(load8(p + i) & 255, keep_ws));
        o = o + 1;
        if (o >= 255) { store8(&buf + o, 0); emit(&buf); o = 0; }
        i = i + 1;
    }
    store8(&buf + o, 0);
    if (o > 0) { emit(&buf); }
    return 0;
}
fn _emit_clean(s, keep_ws) {
    if (s == 0) { return 0; }
    return _emit_clean_n(s, strlen(s), keep_ws);
}
fn emit_clean_line(s) { return _emit_clean(s, 0); }
fn emit_clean_text(s) { return _emit_clean(s, 1); }
fn emit_clean_line_n(p, n) { return _emit_clean_n(p, n, 0); }
fn emit_clean_text_n(p, n) { return _emit_clean_n(p, n, 1); }

# clean_text_n (0.45.0): the TEXT policy applied IN PLACE to exactly `n` bytes; returns how many bytes it changed.
# For untrusted prose that thoth KEEPS as well as draws — the model's reply, whose bytes go to the terminal, the
# reply accumulator, history, the session file and one-shot stdout. Cleaning them once where they are decoded gives
# every one of those the same clean copy; an emit-time form would have to be repeated at each. Same length out as
# in, so a Str's length stays true.
#
# clean_line_n (0.45.0): the LABEL policy in place — for a value thoth STORES and then draws as one line of chrome, so
# every later display reads the one clean copy: a conversation title, a custom /role label. One loop behind both forms.
fn _clean_in_place_n(p, n, keep_ws) {
    if (p == 0) { return 0; }
    var changed = 0;
    var i = 0;
    while (i < n) {
        var b = load8(p + i) & 255;
        var nb = _clean_byte(b, keep_ws);
        if (nb != b) { store8(p + i, nb); changed = changed + 1; }
        i = i + 1;
    }
    return changed;
}
fn clean_text_n(p, n) { return _clean_in_place_n(p, n, 1); }
fn clean_line_n(p, n) { return _clean_in_place_n(p, n, 0); }

fn safe_label_copy(dst, cap, src) {
    if (dst == 0) { return 0; }
    if (src == 0) { store8(dst, 0); return 0; }
    var i = 0;
    while ((load8(src + i) != 0) && (i < (cap - 1))) {
        var b = load8(src + i) & 255;
        if (b < 32) { b = 63; }
        if (b == 127) { b = 63; }
        store8(dst + i, b);
        i = i + 1;
    }
    store8(dst + i, 0);
    return i;
}

# _one_shot (0.11.0): set while a one-shot/argv turn runs. The t-ron confirm gate
# reads it to DENY (fail-closed) instead of blocking on an unanswerable prompt — a
# non-interactive invocation can't safely authorize, so it degrades closed.
var _one_shot = 0;
fn one_shot_active() { return _one_shot; }
fn one_shot_set(v) { _one_shot = v; return 0; }

# emit_raw / emit_raw_n: ALWAYS write to stdout, ignoring _out_mode. The TUI
# chrome (status bar, composer, hint, feed paint, the tree) draws the terminal
# directly and MUST bypass the capture branch — else feed paint would feed its
# own bytes back into the ring (self-recursion) and the chrome would be captured
# rather than shown.
fn emit_raw(s) { syscall(SYS_WRITE, 1, s, strlen(s)); return 0; }
fn emit_raw_n(ptr, n) { syscall(SYS_WRITE, 1, ptr, n); return 0; }

# emit: write a NUL-terminated string to stdout (or the feed ring when capture is
# armed), no trailing newline.
fn emit(s) {
    if (_out_mode == OUT_RING) { _ring_emit(s, strlen(s)); return 0; }
    if (_out_mode == OUT_NULL) { return 0; }
    syscall(SYS_WRITE, 1, s, strlen(s));
    return 0;
}

# emit_n: write n bytes from ptr to stdout (or the feed ring when capture is armed).
fn emit_n(ptr, n) {
    if (_out_mode == OUT_RING) { _ring_emit(ptr, n); return 0; }
    if (_out_mode == OUT_NULL) { return 0; }
    syscall(SYS_WRITE, 1, ptr, n);
    return 0;
}

# oprintln / ofmt_int: mode-aware shadows of stdlib println / fmt_int, which write
# fd 1 DIRECTLY (bypassing emit). The dispatch tree calls these instead of the
# stdlib twins so its output is captured under OUT_RING; under OUT_FD1 each is
# byte-identical to its twin (oprintln -> println, ofmt_int -> fmt_int), so the
# piped/CI floor is unchanged. Under OUT_RING they route through _ring_emit (the
# registered sink), so util holds no reference to feed.cyr.
fn oprintln(s) {
    if (_out_mode == OUT_RING) { _ring_emit(s, strlen(s)); _ring_emit("\n", 1); return 0; }
    if (_out_mode == OUT_NULL) { return 0; }
    return println(s);
}
fn ofmt_int(n) {
    if (_out_mode == OUT_RING) {
        var b[24];
        var len = fmt_int_buf(n, &b);
        _ring_emit(&b, len);
        return 0;
    }
    if (_out_mode == OUT_NULL) { return 0; }
    return fmt_int(n);
}

# read_line: read one line from stdin into buf (NUL-terminated, newline
# stripped). Returns the line length (>= 0), or (0 - 1) on EOF with no input.
# Avoids `break` inside a var-bearing loop per the Cyrius break caveat — uses
# a sentinel (ret) and an inner stop flag instead.
fn read_line(buf, maxlen) {
    var i = 0;
    var ret = 0 - 2;
    while (ret == (0 - 2)) {
        if (_rl_pos >= _rl_len) {
            _rl_pos = 0;
            _rl_len = syscall(SYS_READ, 0, &_rl_buf, 4095);
            # A read error (negative) is treated as EOF intentionally: with no
            # buffered input there is nothing to recover, so we end the line /
            # session rather than spin re-reading a persistently failing fd.
            if (_rl_len <= 0) {
                if (i == 0) { ret = 0 - 1; }
                else { store8(buf + i, 0); ret = i; }
            }
        }
        if (ret == (0 - 2)) {
            var stop = 0;
            while (_rl_pos < _rl_len && stop == 0) {
                var ch = load8(&_rl_buf + _rl_pos);
                _rl_pos = _rl_pos + 1;
                if (ch == 10) {
                    store8(buf + i, 0);
                    ret = i;
                    stop = 1;
                } else {
                    if (i < (maxlen - 1)) {
                        store8(buf + i, ch);
                        i = i + 1;
                    }
                }
            }
        }
    }
    return ret;
}

# cstr_starts_with: 1 if NUL-terminated s begins with NUL-terminated prefix.
fn cstr_starts_with(s, prefix) {
    var i = 0;
    var ret = 0 - 2;
    while (ret == (0 - 2)) {
        var pc = load8(prefix + i);
        if (pc == 0) { ret = 1; }
        else {
            var sc = load8(s + i);
            if (sc != pc) { ret = 0; }
            else { i = i + 1; }
        }
    }
    return ret;
}
