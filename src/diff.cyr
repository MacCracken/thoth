# thoth — line-level diff producer + colored renderer (M7 / 0.8.3).
#
# The mockup's tool-call cards show syntax-colored +/- diffs. That presumes diff
# DATA thoth did not have: /write overwrote a file without ever reading the old
# one. This module is the producer — a bounded LCS line diff of old vs new bytes —
# plus a renderer that emits green-add / red-del / faint-context hunks with line
# numbers through the presentation surface (src/ui.cyr): colored at T1, plain bytes
# at T0. Syntax-highlighting the line bodies (vyakarana) is a later layer on top.
#
# Pure core (_diff_run with render=0 returns the add/del counts) is unit-tested;
# the renderer is the same walk with render=1. Bounded: at most DIFF_MAX_LINES per
# side; a larger file falls back to a byte-count summary, announced (never a fake
# or a runaway allocation). Reused static buffers — no per-call accretion.

var DIFF_MAX_LINES = 256;          # cap per side; beyond it, summarize honestly
var _diff_ol = 0;                  # old line table: DIFF_MAX_LINES * {off(8), len(8)}
var _diff_nl = 0;                  # new line table
var _diff_dp = 0;                  # LCS DP: (MAX+1)*(MAX+1) i64
var _diff_ready = 0;

fn _diff_alloc() {
    if (_diff_ready == 1) { return 0; }
    _diff_ol = alloc(DIFF_MAX_LINES * 16);
    _diff_nl = alloc(DIFF_MAX_LINES * 16);
    _diff_dp = alloc((DIFF_MAX_LINES + 1) * (DIFF_MAX_LINES + 1) * 8);
    _diff_ready = 1;
    return 0;
}

# _diff_split: index buf[0..len) into `out` as up to `cap` line records {off,len}
# (len EXCLUDES the newline). A trailing unterminated line counts. Returns the
# line count (<= cap; == cap signals "hit the cap", caller treats as too-big).
fn _diff_split(buf, len, out, cap) {
    var n = 0;
    var i = 0;
    var start = 0;
    while ((i < len) && (n < cap)) {
        if (load8(buf + i) == 10) {
            store64(out + n * 16, start);
            store64(out + n * 16 + 8, i - start + 1);   # INCLUDE the \n: a terminated
            n = n + 1;                                   # line differs from an unterminated
            start = i + 1;                               # one (newline-aware identity)
        }
        i = i + 1;
    }
    if ((start < len) && (n < cap)) {
        store64(out + n * 16, start);
        store64(out + n * 16 + 8, len - start);
        n = n + 1;
    }
    return n;
}

# _diff_line_eq: 1 if old line ai equals new line bi (same bytes). Pure.
fn _diff_line_eq(ob, ol, ai, nb, nl, bi) {
    var ao = load64(ol + ai * 16);
    var al = load64(ol + ai * 16 + 8);
    var bo = load64(nl + bi * 16);
    var bl = load64(nl + bi * 16 + 8);
    if (al != bl) { return 0; }
    var k = 0;
    while (k < al) {
        if (load8(ob + ao + k) != load8(nb + bo + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# _tok_role: a vyakarana token kind -> a semantic color role, or -1 to leave
# uncolored (idents / punctuation / whitespace / error -> terminal default).
fn _tok_role(kind) {
    if (kind == TK_KEYWORD) { return ROLE_ACCENT; }
    if (kind == TK_STRING) { return ROLE_GREEN; }
    if (kind == TK_NUMBER) { return ROLE_BLUE; }
    if (kind == TK_COMMENT) { return ROLE_FAINT; }
    if (kind == TK_PREPROCESSOR) { return ROLE_BLUE; }
    if (kind == TK_OPERATOR) { return ROLE_MUTED; }
    return 0 - 1;
}

# _hl_span: syntax-color buf[0..n) via vyakarana grammar `lang`, emitting each token
# in its role color (fg + reset per token). The SHARED highlighter for /read and
# diff bodies. CRITICAL honesty guard: it tracks the cursor and emits any uncovered
# gap + trailing bytes VERBATIM, so highlighting never drops or reorders a byte. If
# the stream can't open it emits the whole span verbatim. Returns 1.
fn _hl_span(lang, buf, n, reset_str) {
    var s = tokenize_stream_new(lang);
    if (s == 0) { emit_n(buf, n); return 1; }
    tokenize_stream_feed(s, buf, n);
    var tb = tokenbuf_new();
    tokenize_stream_drain(s, tb);
    tokenize_stream_finish(s, tb);
    var count = tokenbuf_count(tb);
    var pos = 0;
    var i = 0;
    while (i < count) {
        var start = tokenbuf_start(tb, i);
        var len = tokenbuf_len(tb, i);
        if (start > pos) { emit_n(buf + pos, start - pos); }
        if ((start + len) <= n) {
            var role = _tok_role(tokenbuf_kind(tb, i));
            if (role < 0) { emit_n(buf + start, len); }
            else { emit(ui_sgr(role)); emit_n(buf + start, len); emit(reset_str); }
            pos = start + len;
        }
        i = i + 1;
    }
    if (pos < n) { emit_n(buf + pos, n - pos); }
    tokenize_stream_free(s);
    return 1;
}

# _diff_emit_line: render one hunk line — line-number gutter (faint), a colored
# +/-/space gutter, then the line body: syntax-highlighted via `lang` (or emitted in
# the gutter `role` when lang==0 / plain tier). kind 0=context 1=del 2=add. I/O.
fn _diff_emit_line(role, gutter, lineno, body_buf, off, len, lang) {
    var plain = 0;
    if (ui_tier() == PT_PLAIN) { plain = 1; }
    # add/del rows get a subtle background tint (>=256 color). On a tinted row the
    # colored spans use a fg-only reset (rst = ESC[39m) so the bg persists, and the
    # row is filled to its end (ESC[K) before a final full reset. Plain tier / <256
    # color / context rows: rst is the full reset and no tint is drawn.
    var bg = "";
    var rst = ui_reset();
    if (plain == 0) {
        if (role == ROLE_GREEN) { bg = ui_bg(0); }
        elif (role == ROLE_RED) { bg = ui_bg(1); }
    }
    var has_bg = 0;
    if (load8(bg) != 0) { has_bg = 1; rst = ui_reset_fg(); }
    emit(bg);
    if (lineno > 0) {
        # right-aligned 4-col line number, faint
        var pad = 0;
        if (lineno < 1000) { pad = pad + 1; }
        if (lineno < 100) { pad = pad + 1; }
        if (lineno < 10) { pad = pad + 1; }
        emit(ui_sgr(ROLE_FAINT));
        while (pad > 0) { emit(" "); pad = pad - 1; }
        ofmt_int(lineno);
        emit(rst);
    } else {
        emit(ui_sgr(ROLE_FAINT)); emit("    "); emit(rst);
    }
    emit(" ");
    emit(ui_sgr(role)); emit(gutter); emit(rst);
    # the line span includes its trailing \n (newline-aware identity); don't emit it
    # — println supplies the break.
    var rl = len;
    if (rl > 0) { if (load8(body_buf + off + rl - 1) == 10) { rl = rl - 1; } }
    if ((lang != 0) && (plain == 0)) { _hl_span(lang, body_buf + off, rl, rst); }
    elif (plain == 0) { emit(ui_sgr(role)); emit_n(body_buf + off, rl); emit(rst); }
    else { emit_n(body_buf + off, rl); }
    if (has_bg == 1) { emit(ui_eol()); emit(ui_reset()); }
    oprintln("");
    return 0;
}

# _diff_run: LCS line-diff of old vs new. render=1 prints a colored hunk; render=0
# only counts. Returns adds*1000000 + dels (packed, both < DIFF_MAX_LINES). A side
# at the line cap returns 0 - 1 (too big) and, if rendering, prints a summary.
fn _diff_run(path, ob, ol_bytes, nb, nl_bytes, render, lang) {
    _diff_alloc();
    var on = _diff_split(ob, ol_bytes, _diff_ol, DIFF_MAX_LINES);
    var nn = _diff_split(nb, nl_bytes, _diff_nl, DIFF_MAX_LINES);
    if ((on >= DIFF_MAX_LINES) || (nn >= DIFF_MAX_LINES)) {
        if (render == 1) {
            emit("  "); ui_emit(ROLE_FAINT, "(diff omitted: over "); ofmt_int(DIFF_MAX_LINES);
            ui_emit(ROLE_FAINT, " lines)"); oprintln("");
        }
        return 0 - 1;
    }
    var stride = nn + 1;
    # DP: dp[i*stride+j] = LCS(old[i..on), new[j..nn)). Fill bottom-up.
    var i = on;
    while (i >= 0) {
        var j = nn;
        while (j >= 0) {
            var v = 0;
            if ((i < on) && (j < nn)) {
                if (_diff_line_eq(ob, _diff_ol, i, nb, _diff_nl, j) == 1) {
                    v = load64(_diff_dp + ((i + 1) * stride + (j + 1)) * 8) + 1;
                } else {
                    var down = load64(_diff_dp + ((i + 1) * stride + j) * 8);
                    var right = load64(_diff_dp + (i * stride + (j + 1)) * 8);
                    if (down >= right) { v = down; } else { v = right; }
                }
            }
            store64(_diff_dp + (i * stride + j) * 8, v);
            j = j - 1;
        }
        i = i - 1;
    }
    # Backtrace from (0,0), emitting/counting ops in order.
    var adds = 0;
    var dels = 0;
    i = 0;
    var j = 0;
    while ((i < on) || (j < nn)) {
        if ((i < on) && (j < nn) && (_diff_line_eq(ob, _diff_ol, i, nb, _diff_nl, j) == 1)) {
            if (render == 1) {
                _diff_emit_line(ROLE_FAINT, " ", j + 1, nb, load64(_diff_nl + j * 16), load64(_diff_nl + j * 16 + 8), lang);
            }
            i = i + 1; j = j + 1;
        } else {
            var take_add = 0;
            if (j < nn) {
                if (i >= on) { take_add = 1; }
                else {
                    var d = load64(_diff_dp + ((i + 1) * stride + j) * 8);
                    var r = load64(_diff_dp + (i * stride + (j + 1)) * 8);
                    if (r >= d) { take_add = 1; }
                }
            }
            if (take_add == 1) {
                if (render == 1) {
                    _diff_emit_line(ROLE_GREEN, "+", j + 1, nb, load64(_diff_nl + j * 16), load64(_diff_nl + j * 16 + 8), lang);
                }
                adds = adds + 1; j = j + 1;
            } else {
                if (render == 1) {
                    _diff_emit_line(ROLE_RED, "-", i + 1, ob, load64(_diff_ol + i * 16), load64(_diff_ol + i * 16 + 8), lang);
                }
                dels = dels + 1; i = i + 1;
            }
        }
    }
    return adds * 1000000 + dels;
}

# diff_render: print a colored diff card for path (old `ob` -> new `nb`). The path
# header (blue) + a +A -D count line (green/red) + the hunk. I/O.
fn diff_render(path, ob, ol_bytes, nb, nl_bytes) {
    var lang = 0;                                                  # grammar for body highlighting
    if (ui_tier() != PT_PLAIN) { lang = detect_language(path); }   # 0 if unknown -> plain bodies
    emit("  "); ui_emit(ROLE_BLUE, path); oprintln("");
    var packed = _diff_run(path, ob, ol_bytes, nb, nl_bytes, 0, lang);   # count first for the header
    if (packed == (0 - 1)) {
        _diff_run(path, ob, ol_bytes, nb, nl_bytes, 1, lang);           # prints the "too big" note
        return 0;
    }
    var adds = packed / 1000000;
    var dels = packed - adds * 1000000;
    emit("  ");
    emit(ui_sgr(ROLE_GREEN)); emit("+"); ofmt_int(adds); emit(ui_reset());
    emit(" ");
    emit(ui_sgr(ROLE_RED)); emit("-"); ofmt_int(dels); emit(ui_reset());
    oprintln("");
    _diff_run(path, ob, ol_bytes, nb, nl_bytes, 1, lang);
    return 0;
}

# diff_stats: the pure add/del result (packed adds*1000000+dels), or -1 if a side
# exceeds the line cap. No I/O — the unit-test entry point.
fn diff_stats(ob, ol_bytes, nb, nl_bytes) {
    return _diff_run(0, ob, ol_bytes, nb, nl_bytes, 0, 0);   # lang 0 -> count only, no highlight
}
