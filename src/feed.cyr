# thoth — the self-managed feed buffer (M7 / 0.9.1).
#
# 0.9.0's T2 TUI scrolled command output natively inside a DECSTBM scroll region
# (the "terminal-scroll trick"). DECSTBM sets only TOP/BOTTOM margins, so that
# scroll always spans the FULL terminal width — which makes a left-column pane
# (the file-tree, 0.9.3) physically impossible and leaves resize at the mercy of
# the terminal. 0.9.1 replaces it: thoth OWNS the feed. Dispatch output is
# captured into a ring of lines here (via feed_write, the OUT_RING sink target —
# see src/util.cyr), and the visible window is PAINTED each frame (feed_clip).
# A self-managed feed makes instant SIGWINCH a pure recompute+repaint (0.9.2) and
# lets a narrower right-column feed coexist with a tree pane (0.9.3).
#
# DESIGN SPLIT (mirrors src/tui.cyr): the ring state machine and the escape-aware
# clip are PURE and unit-tested (test_feed / test_feed_ring). The capture wiring
# (emit -> feed_write) and the painter are I/O, verified on a live TTY.
#
# Stored lines keep their ANSI color escapes VERBATIM — the bytes stored are the
# bytes that were emitted, so the floor invariant (piped output byte-identical)
# is trivial: capture is only ever armed inside the PT_RICH dispatch window.
# Painting a stored line into a width-W column needs ESCAPE-AWARE clipping:
# escapes are zero-width and must never be severed mid-sequence, and ESC[K (erase
# to physical EOL) must be SUPPRESSED so it can't scribble a neighbour column.
#
# This module is included AFTER src/ui.cyr (feed_clip's defensive close calls
# ui_reset) and feeds OUT_RING from src/util.cyr (emit's sink branch calls
# feed_write — a forward reference Cyrius resolves whole-unit).

# --- ring storage -----------------------------------------------------------
# A ring of FEED_ROWS fixed-width slots in one bump-heap block (alloc sidesteps
# the literal-array-dim limit: slot i lives at _feed_base + i*FEED_LINE_CAP).
# FEED_LINE_CAP is generous: a truecolor syntax-highlighted /read line spends
# ~19 bytes per token on the SGR escape alone, so a wide colored row blows past
# 1 KiB of escapes+text — 2 KiB leaves headroom before the (escape-boundary-aware)
# store truncation kicks in. 2048 rows x 2 KiB = a 4 MiB one-time scrollback.
var FEED_ROWS = 2048;
var FEED_LINE_CAP = 2048;

# Role MARKERS (0.18.0 re-renderable feed): instead of baking a theme's concrete SGR into a stored slot
# (which is why /theme couldn't recolor scrollback), the seal-time packer (_feed_pack) rewrites each
# recognized role/reset SGR to a compact 2-byte MARKER — `ESC` (27) + a private byte — and the painter
# (feed_clip/_seg) EXPANDS a marker back to the CURRENT theme's SGR. A marker is a 2-byte escape to the
# scanner (_feed_esc_len returns 2 for ESC + non-'['), so it is zero visible width, copied whole, and
# never severed — no scanner change. role marker = ESC + (FEED_MARK_ROLE0 + role) for role 0..7
# (0xB0..0xB7); reset marker = ESC + FEED_MARK_RESET (0xBF). 0xB8..0xBE are reserved (never produced).
# The packer SANITIZES any raw `ESC` + 0xB0..0xBF in untrusted captured output (it drops that ESC), so
# no stored content can be mis-read back as a marker — the marker space is unforgeable.
var FEED_MARK_ROLE0 = 176;   # 0xB0
var FEED_MARK_RESET = 191;   # 0xBF

var _feed_base = 0;        # alloc(FEED_ROWS*FEED_LINE_CAP), lazy — the slot bytes
var _feed_len = 0;         # alloc(FEED_ROWS*8): stored byte length per slot
var _feed_vis = 0;         # alloc(FEED_ROWS*8): cached visible cols per slot
var _feed_head = 0;        # ring index of the OLDEST live line
var _feed_count = 0;       # live line count (<= FEED_ROWS)
var _feed_scroll = 0;      # PHYSICAL rows scrolled back from the newest (0 = pinned bottom).
                           # 0.11.3: physical (soft-wrapped) rows, not logical lines.

# The in-progress (un-newlined) line. LITERAL size — MUST equal FEED_LINE_CAP
# (Cyrius array dims can't be a `var` constant); if FEED_LINE_CAP moves, move this.
var _feed_pending[2048];
var _feed_pending_len = 0;

# feed_init_ensure: lazily allocate the ring (idempotent). Separated from
# feed_init so the sink path can allocate on first write without resetting state.
fn feed_init_ensure() {
    if (_feed_base == 0) {
        _feed_base = alloc(FEED_ROWS * FEED_LINE_CAP);
        _feed_len = alloc(FEED_ROWS * 8);
        _feed_vis = alloc(FEED_ROWS * 8);
    }
    return 0;
}

# feed_clear: empty the ring (head/count/scroll/pending) WITHOUT freeing the backing
# store. Backs the /clear command and the per-session reset.
fn feed_clear() {
    _feed_head = 0;
    _feed_count = 0;
    _feed_scroll = 0;
    _feed_pending_len = 0;
    return 0;
}

# feed_init: allocate (if needed) AND reset the ring to empty. Called once at TUI
# start; called by each unit test for a clean slate.
fn feed_init() {
    feed_init_ensure();
    feed_clear();
    return 0;
}

# --- the escape / UTF-8 scanner (shared by clip, visible-cols, safe-copy) ----

# _is_csi_final: 1 if b is a CSI final byte (0x40..0x7e inclusive — '@'..'~').
fn _is_csi_final(b) { if (b >= 64) { if (b <= 126) { return 1; } } return 0; }

# _feed_esc_len: byte length of the escape sequence starting at src[i] (== 0x1b).
# CSI (ESC '[') runs to its final byte; the 2-byte form is ESC + one byte; a lone
# or unterminated ESC reports the bytes present (to src_len). Never reads past
# src_len.
fn _feed_esc_len(src, i, src_len) {
    if ((i + 1) >= src_len) { return 1; }            # lone ESC at the boundary
    if (load8(src + i + 1) != 91) { return 2; }      # ESC + single byte (2-byte form)
    var j = i + 2;
    while (j < src_len) {
        if (_is_csi_final(load8(src + j)) == 1) { return j - i + 1; }
        j = j + 1;
    }
    return src_len - i;                               # unterminated CSI -> to end
}

# _feed_esc_terminated: 1 if the escape at src[i] is FULLY present in [i,src_len)
# (has its final byte). Used at store time to drop a severed trailing escape so a
# stored slot never ends mid-CSI.
fn _feed_esc_terminated(src, i, src_len) {
    if ((i + 1) >= src_len) { return 0; }            # lone ESC -> severed
    if (load8(src + i + 1) != 91) { return 1; }      # complete 2-byte form
    var j = i + 2;
    while (j < src_len) {
        if (_is_csi_final(load8(src + j)) == 1) { return 1; }
        j = j + 1;
    }
    return 0;                                         # ran off end, no final byte
}

# _feed_glyph_len: byte length of the glyph starting at src[i]. ASCII = 1; a
# UTF-8 lead is followed by its 0x80..0xBF continuations (greedy, bounded by
# src_len so a lead at the boundary never over-reads).
fn _feed_glyph_len(src, i, src_len) {
    if (load8(src + i) < 128) { return 1; }
    var j = i + 1;
    while (j < src_len) {
        var c = load8(src + j);
        if (c >= 128) { if (c < 192) { j = j + 1; } else { return j - i; } }
        else { return j - i; }
    }
    return j - i;
}

# _feed_is_reset: 1 if the SGR sequence at src[i] of length sl is a FULL reset
# (ESC[m or ESC[0m). Anything else that ends in 'm' is treated as opening color.
fn _feed_is_reset(src, i, sl) {
    if (sl == 3) { return 1; }                        # ESC [ m
    if (sl == 4) { if (load8(src + i + 2) == 48) { return 1; } }   # ESC [ 0 m
    return 0;
}

# --- the clip: paint a stored line into a width-W column (PURE) --------------
# feed_clip(dst, dst_cap, src, src_len, max_cols) -> bytes written.
# Single left-to-right pass. Copies up to max_cols VISIBLE glyphs, passing color
# escapes through verbatim (zero width) so the row stays colored. Guarantees:
#   - never writes past dst[dst_cap-1] (every copy is capacity-checked);
#   - never severs a CSI / a UTF-8 glyph (whole units only);
#   - SUPPRESSES ESC[K (the painter issues its own column-bounded clear-to-eol —
#     an in-line ES[K would erase to the terminal's PHYSICAL eol, scribbling the
#     pane to the right);
#   - if a color span is left open at the clip point, appends ui_reset() (room
#     permitting) so color can't bleed past the column.
fn feed_clip(dst, dst_cap, src, src_len, max_cols) {
    var cols = 0;
    var i = 0;
    var wrote = 0;
    var sgr_open = 0;
    while (i < src_len) {
        var b = load8(src + i);
        if (b == 27) {
            var sl = _feed_esc_len(src, i, src_len);
            var lastb = load8(src + i + sl - 1);
            var b1m = 0; if (sl >= 2) { b1m = load8(src + i + 1); }
            # 0.18.0: a role/reset MARKER (ESC + 0xB0..0xB7 / 0xBF) expands to the CURRENT theme's
            # concrete SGR — the capacity check uses the EXPANDED length, and only the expanded bytes are
            # copied (never the 2 marker bytes). Then: suppress a real CSI erase-line (ESC[...K, sl>=3
            # implies the '[' was found by _feed_esc_len; a 2-byte ESC-K in untrusted output is not a
            # CSI and is copied verbatim); else copy the escape verbatim.
            if ((sl == 2) && (((b1m >= FEED_MARK_ROLE0) && (b1m <= (FEED_MARK_ROLE0 + 7))) || (b1m == FEED_MARK_RESET))) {
                var em = ui_reset();
                if (b1m != FEED_MARK_RESET) { em = ui_sgr(b1m - FEED_MARK_ROLE0); }
                var eml = strlen(em);
                if ((wrote + eml) <= dst_cap) {
                    var km = 0;
                    while (km < eml) { store8(dst + wrote + km, load8(em + km)); km = km + 1; }
                    wrote = wrote + eml;
                    if (b1m == FEED_MARK_RESET) { sgr_open = 0; } else { sgr_open = 1; }
                }
                i = i + sl;
            } elif ((sl >= 3) && (lastb == 75)) {
                i = i + sl;                           # ESC[...K -> suppress
            } else {
                if ((wrote + sl) <= dst_cap) {
                    var k = 0;
                    while (k < sl) { store8(dst + wrote + k, load8(src + i + k)); k = k + 1; }
                    wrote = wrote + sl;
                    if (lastb == 109) {
                        if (_feed_is_reset(src, i, sl) == 1) { sgr_open = 0; } else { sgr_open = 1; }
                    }
                }
                i = i + sl;
            }
        } else {
            var gl = _feed_glyph_len(src, i, src_len);
            if (cols < max_cols) {
                if ((wrote + gl) <= dst_cap) {
                    var k2 = 0;
                    while (k2 < gl) { store8(dst + wrote + k2, load8(src + i + k2)); k2 = k2 + 1; }
                    wrote = wrote + gl;
                    cols = cols + 1;
                }
            }
            # at/over max_cols: stop copying glyphs but keep scanning to drain
            # trailing color resets (so the row closes cleanly).
            i = i + gl;
        }
    }
    if (sgr_open == 1) {
        var rst = ui_reset();
        var rl = strlen(rst);
        if ((wrote + rl) <= dst_cap) {
            var kr = 0;
            while (kr < rl) { store8(dst + wrote + kr, load8(rst + kr)); kr = kr + 1; }
            wrote = wrote + rl;
        }
    }
    return wrote;
}

# --- the segmented clip: paint a visible-column WINDOW of a line (PURE) -------
# feed_clip_seg(dst, dst_cap, src, src_len, skip_cols, max_cols) -> bytes written.
# Soft-wrap's load-bearing primitive (0.11.3). Where feed_clip paints the FIRST
# max_cols glyphs (truncating a wide line), this paints the WINDOW of visible
# columns [skip_cols, skip_cols+max_cols) — segment N of a reflowed line is
# feed_clip_seg(.., N*width, width). feed_clip is UNCHANGED (still drives the
# fixed-width tree column, which truncates by design).
#
# Single left-to-right pass, phased by a running visible-glyph counter `cols`:
#   - SKIP (cols < skip_cols): glyphs are NOT emitted (just counted). SGR color
#     state is tracked into _feed_carry so color CONTINUES across the wrap
#     boundary — a full reset (ESC[m / ESC[0m) clears the carry; any other SGR is
#     appended WHOLE (never a partial/severed escape). ESC[...K is suppressed;
#     non-SGR escapes (OSC/cursor) in the skip region are dropped — state, not
#     position, so they can't be re-applied mid-line (declared limitation).
#   - BOUNDARY (cols first reaches skip_cols): the carry is flushed to dst before
#     the first in-window byte (glyph OR escape), so a color opened off-segment
#     paints from the segment's first column.
#   - PAINT (skip_cols <= cols < skip_cols+max_cols): glyphs + escapes pass
#     through verbatim (ESC[...K suppressed), tracking sgr_open.
#   - STOP at the window end: unlike feed_clip it does NOT drain trailing escapes;
#     an open color span is closed with ui_reset() (room permitting).
# Same hard guarantees as feed_clip: never writes past dst[dst_cap-1]; never
# severs a CSI / a UTF-8 glyph; suppresses ESC[...K; closes an open span (room
# permitting — an exhausted dst leaves it open, exactly as feed_clip does).
# For a line that FITS (vis <= width) feed_clip_seg(.., 0, width) is
# byte-identical to feed_clip; they diverge only for WIDER lines, and never share
# a call site — and feed_repaint is TUI-only, so the floor is untouched either way.
var FEED_CARRY_CAP = 64;     # SGR-since-last-reset carried across a wrap boundary
var _feed_carry[64];         # LITERAL size — MUST equal FEED_CARRY_CAP
var _feed_carry_len = 0;

# _feed_carry_append: append the WHOLE escape src[i..i+sl) to the carry, but only
# if it fits — an over-cap sequence is DROPPED entire (never a partial/severed
# escape), so emitting the carry can never produce a malformed CSI. A drop is a
# bounded cosmetic glitch across a wrap on pathological cumulative-SGR captured
# output; thoth's own output is single-span-then-reset, so it never overflows.
fn _feed_carry_append(src, i, sl) {
    if ((_feed_carry_len + sl) > FEED_CARRY_CAP) { return 0; }
    var k = 0;
    while (k < sl) { store8(&_feed_carry + _feed_carry_len + k, load8(src + i + k)); k = k + 1; }
    _feed_carry_len = _feed_carry_len + sl;
    return 0;
}

fn feed_clip_seg(dst, dst_cap, src, src_len, skip_cols, max_cols) {
    _feed_carry_len = 0;
    var cols = 0;
    var i = 0;
    var wrote = 0;
    var sgr_open = 0;
    var emitted = 0;                                  # 0 = SKIP phase, 1 = past the boundary
    var winend = skip_cols + max_cols;
    while (i < src_len) {
        if ((emitted == 1) && (cols >= winend)) {
            i = src_len;                              # window full -> stop (no draining)
        } else {
            if ((emitted == 0) && (cols >= skip_cols) && (cols < winend)) {   # cross into the window: flush carry
                # flush the carry WHOLE-or-drop — never a partial/severed CSI (matches
                # feed_clip's whole-unit copy). At the real call site wrote==0 here (the
                # SKIP phase emits nothing), so a <=64 B carry always lands; the guard only
                # bites a pathologically tiny dst_cap, where dropping whole is correct.
                if ((_feed_carry_len > 0) && ((wrote + _feed_carry_len) <= dst_cap)) {
                    var ci = 0;
                    while (ci < _feed_carry_len) { store8(dst + wrote + ci, load8(&_feed_carry + ci)); ci = ci + 1; }
                    wrote = wrote + _feed_carry_len;
                    sgr_open = 1;                          # span open only if the carry actually landed
                }
                emitted = 1;
            }
            var b = load8(src + i);
            if (b == 27) {
                var sl = _feed_esc_len(src, i, src_len);
                var lastb = load8(src + i + sl - 1);
                var b1m = 0; if (sl >= 2) { b1m = load8(src + i + 1); }
                var ismark = 0;                                  # 0.18.0: a role/reset MARKER?
                if ((sl == 2) && (((b1m >= FEED_MARK_ROLE0) && (b1m <= (FEED_MARK_ROLE0 + 7))) || (b1m == FEED_MARK_RESET))) { ismark = 1; }
                var isk = 0;
                if ((sl >= 3) && (lastb == 75)) { isk = 1; }     # a real CSI ESC[...K
                if (emitted == 0) {                              # SKIP: track SGR into carry, drop the escape
                    if (ismark == 1) {                           # 0.18.0: carry the marker's EXPANDED SGR
                        if (b1m == FEED_MARK_RESET) { _feed_carry_len = 0; }
                        else { var es = ui_sgr(b1m - FEED_MARK_ROLE0); _feed_carry_append(es, 0, strlen(es)); }
                    } elif (isk == 0) {
                        if (lastb == 109) {                      # a verbatim SGR (ends 'm')
                            if (_feed_is_reset(src, i, sl) == 1) { _feed_carry_len = 0; }
                            else { _feed_carry_append(src, i, sl); }
                        }
                    }
                    i = i + sl;
                } else {                                         # PAINT: pass through (suppress ESC[...K)
                    if (ismark == 1) {                           # 0.18.0: expand the marker to concrete SGR
                        var em = ui_reset();
                        if (b1m != FEED_MARK_RESET) { em = ui_sgr(b1m - FEED_MARK_ROLE0); }
                        var eml = strlen(em);
                        if ((wrote + eml) <= dst_cap) {
                            var km = 0;
                            while (km < eml) { store8(dst + wrote + km, load8(em + km)); km = km + 1; }
                            wrote = wrote + eml;
                            if (b1m == FEED_MARK_RESET) { sgr_open = 0; } else { sgr_open = 1; }
                        }
                        i = i + sl;
                    } elif (isk == 1) {
                        i = i + sl;
                    } else {
                        if ((wrote + sl) <= dst_cap) {
                            var k = 0;
                            while (k < sl) { store8(dst + wrote + k, load8(src + i + k)); k = k + 1; }
                            wrote = wrote + sl;
                            if (lastb == 109) {
                                if (_feed_is_reset(src, i, sl) == 1) { sgr_open = 0; } else { sgr_open = 1; }
                            }
                        }
                        i = i + sl;
                    }
                }
            } else {
                var gl = _feed_glyph_len(src, i, src_len);
                if (emitted == 1) {                              # PAINT: emit the glyph (always in-window here)
                    if ((wrote + gl) <= dst_cap) {
                        var k2 = 0;
                        while (k2 < gl) { store8(dst + wrote + k2, load8(src + i + k2)); k2 = k2 + 1; }
                        wrote = wrote + gl;
                    }
                }
                cols = cols + 1;                                 # count the glyph in BOTH phases
                i = i + gl;
            }
        }
    }
    if (sgr_open == 1) {
        var rst = ui_reset();
        var rl = strlen(rst);
        if ((wrote + rl) <= dst_cap) {
            var kr = 0;
            while (kr < rl) { store8(dst + wrote + kr, load8(rst + kr)); kr = kr + 1; }
            wrote = wrote + rl;
        }
    }
    return wrote;
}

# feed_rows_for: physical rows a logical line of `vis` visible columns occupies at
# column width `width` (soft-wrap, 0.11.3). A blank line (vis 0) is one row;
# otherwise ceil(vis/width). width is clamped >= 1 (div-by-zero / runaway guard).
fn feed_rows_for(vis, width) {
    if (width < 1) { width = 1; }
    if (vis <= 0) { return 1; }
    return (vis + width - 1) / width;
}

# _feed_total_phys: physical-row height of the WHOLE virtual feed document at
# column width `width` — the soft-wrapped sum of every live line plus the pending
# (un-newlined) line. The painter's scroll oracle: replaces the old logical-line
# count once a wide line spans several rows. O(feed_count) per call; the cached
# feed_vis(i) is width-independent (glyph count), so it stays valid across resize.
fn _feed_total_phys(width) {
    var t = 0;
    var n = _feed_count;
    var i = 0;
    while (i < n) {
        t = t + feed_rows_for(feed_vis(i), width);
        i = i + 1;
    }
    if (_feed_pending_len > 0) {
        t = t + feed_rows_for(feed_visible_cols(&_feed_pending, _feed_pending_len), width);
    }
    return t;
}

# feed_visible_cols: visible glyph count of src[0..src_len) — escapes are
# zero-width. The cached _feed_vis value; also the painter's width oracle.
fn feed_visible_cols(src, src_len) {
    var cols = 0;
    var i = 0;
    while (i < src_len) {
        if (load8(src + i) == 27) { i = i + _feed_esc_len(src, i, src_len); }
        else { i = i + _feed_glyph_len(src, i, src_len); cols = cols + 1; }
    }
    return cols;
}

# _feed_safe_copy: copy src[0..src_len) into dst (cap dst_cap) one WHOLE unit
# (escape or glyph) at a time, stopping before any unit that would exceed dst_cap
# OR a severed (unterminated) trailing escape. So a truncated slot never ends
# mid-CSI / mid-glyph. Returns bytes copied. The store-time truncation primitive.
fn _feed_safe_copy(dst, dst_cap, src, src_len) {
    var i = 0;
    var wrote = 0;
    var stop = 0;
    while (i < src_len) {
        if (stop == 0) {
            var b = load8(src + i);
            if (b == 27) {
                if (_feed_esc_terminated(src, i, src_len) == 0) { stop = 1; }
                else {
                    var sl = _feed_esc_len(src, i, src_len);
                    if ((wrote + sl) > dst_cap) { stop = 1; }
                    else {
                        var k = 0;
                        while (k < sl) { store8(dst + wrote + k, load8(src + i + k)); k = k + 1; }
                        wrote = wrote + sl;
                        i = i + sl;
                    }
                }
            } else {
                var gl = _feed_glyph_len(src, i, src_len);
                if ((wrote + gl) > dst_cap) { stop = 1; }
                else {
                    var k2 = 0;
                    while (k2 < gl) { store8(dst + wrote + k2, load8(src + i + k2)); k2 = k2 + 1; }
                    wrote = wrote + gl;
                    i = i + gl;
                }
            }
        } else { i = src_len; }                       # stop -> drain the loop
    }
    return wrote;
}

# _feed_pack: the seal-time reverse-map (0.18.0). Copies src[0..src_len) into the slot one WHOLE unit at
# a time (like _feed_safe_copy: bounded by dst_cap, stopping before a unit that would overflow or a
# severed trailing escape), BUT rewrites each recognized role/reset SGR to its 2-byte MARKER (via
# ui_role_of_sgr), and SANITIZES a raw ESC + 0xB0..0xBF (drops that ESC) so captured content can never
# forge a marker. Non-role escapes (diff bg/eol/reset-fg, ESC[K, 2-byte forms) and text pass verbatim —
# so painted output is byte-identical for the current theme, and visible-cols is unchanged (a marker is
# zero-width, exactly like the SGR it replaces). Returns bytes written.
fn _feed_pack(dst, dst_cap, src, src_len) {
    var i = 0;
    var wrote = 0;
    var stop = 0;
    while (i < src_len) {
        if (stop == 0) {
            var b = load8(src + i);
            if (b == 27) {
                if (_feed_esc_terminated(src, i, src_len) == 0) { stop = 1; }
                else {
                    var sl = _feed_esc_len(src, i, src_len);
                    var role = ui_role_of_sgr(src, i, sl);
                    if ((role >= 0) && (role < UI_ROLE_COUNT)) {          # a role SGR -> role marker
                        if ((wrote + 2) > dst_cap) { stop = 1; }
                        else { store8(dst + wrote, 27); store8(dst + wrote + 1, FEED_MARK_ROLE0 + role); wrote = wrote + 2; i = i + sl; }
                    } elif (role == UI_SGR_RESET) {                       # the reset SGR -> reset marker
                        if ((wrote + 2) > dst_cap) { stop = 1; }
                        else { store8(dst + wrote, 27); store8(dst + wrote + 1, FEED_MARK_RESET); wrote = wrote + 2; i = i + sl; }
                    } else {
                        var b1 = load8(src + i + 1);
                        if ((sl == 2) && (b1 >= FEED_MARK_ROLE0) && (b1 <= FEED_MARK_RESET)) {
                            i = i + 1;                                     # SANITIZE: drop a raw ESC + marker-range byte
                        } else {                                         # a real non-role escape -> verbatim
                            if ((wrote + sl) > dst_cap) { stop = 1; }
                            else { var k = 0; while (k < sl) { store8(dst + wrote + k, load8(src + i + k)); k = k + 1; } wrote = wrote + sl; i = i + sl; }
                        }
                    }
                }
            } else {
                var gl = _feed_glyph_len(src, i, src_len);
                if ((wrote + gl) > dst_cap) { stop = 1; }
                else { var k2 = 0; while (k2 < gl) { store8(dst + wrote + k2, load8(src + i + k2)); k2 = k2 + 1; } wrote = wrote + gl; i = i + gl; }
            }
        } else { i = src_len; }
    }
    return wrote;
}

# --- the sink: accumulate dispatch output, seal a slot per newline ------------

# _feed_seal_pending: copy the pending bytes into the next ring slot (escape-
# boundary truncated to FEED_LINE_CAP), cache its length + visible cols, and
# advance the ring (evicting the oldest line in O(1) when full). Seals even an
# EMPTY pending — a bare '\n' is a real blank feed row.
fn _feed_seal_pending() {
    feed_init_ensure();
    var slot = (_feed_head + _feed_count) % FEED_ROWS;   # == _feed_head when full
    var dst = _feed_base + slot * FEED_LINE_CAP;
    var copied = _feed_pack(dst, FEED_LINE_CAP, &_feed_pending, _feed_pending_len);   # 0.18.0: role SGR -> markers
    store64(_feed_len + slot * 8, copied);
    store64(_feed_vis + slot * 8, feed_visible_cols(dst, copied));
    if (_feed_count < FEED_ROWS) { _feed_count = _feed_count + 1; }
    else { _feed_head = (_feed_head + 1) % FEED_ROWS; }   # ring full -> evict oldest
    _feed_pending_len = 0;
    return 0;
}

# feed_write: the OUT_RING sink target (src/util.cyr's emit branch routes here
# when capture is armed). Accumulates bytes into the pending line; a '\n' seals a
# slot (the newline itself is NOT stored — the painter supplies row breaks,
# mirroring println). Bytes past FEED_LINE_CAP-1 for one logical line are dropped
# (the sealed slot is re-truncated on an escape boundary by _feed_safe_copy).
fn feed_write(ptr, n) {
    feed_init_ensure();
    var i = 0;
    while (i < n) {
        var b = load8(ptr + i);
        if (b == 10) { _feed_seal_pending(); }
        else {
            if (_feed_pending_len < (FEED_LINE_CAP - 1)) {
                store8(&_feed_pending + _feed_pending_len, b);
                _feed_pending_len = _feed_pending_len + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# feed_flush_pending: seal a trailing un-newlined line (a prompt with no '\n', or
# output that didn't end in a newline) as a final feed row. Unlike the '\n' path
# it does NOT seal an empty pending (no spurious blank row). Called at dispatch
# end and before an interactive confirm repaint.
fn feed_flush_pending() {
    if (_feed_pending_len > 0) { _feed_seal_pending(); }
    return 0;
}

# feed_drop_last: remove the most-recent `n` sealed rows (0.18.3 live fenced-code card: the streamed
# interior rows are dropped, then re-emitted highlighted). Clamped to the live count; the ring slots are
# reused by the next seals. Does NOT touch the pending line (see feed_drop_pending).
fn feed_drop_last(n) {
    if (n < 0) { n = 0; }
    if (n > _feed_count) { n = _feed_count; }
    _feed_count = _feed_count - n;
    return 0;
}

# feed_drop_pending: discard the un-sealed in-progress line WITHOUT sealing it. The live fenced-code
# upgrade (0.18.3) uses this at fence close / stream finish: if the streamed interior's last line had no
# trailing newline (a truncated / interrupted block), it sits un-sealed in the pending; discarding it
# lets the highlighted re-emit be the sole source of that row (no doubled bottom line).
fn feed_drop_pending() { _feed_pending_len = 0; return 0; }

# feed_pending_len: bytes in the un-sealed line (the painter renders it as the
# in-progress bottom row so a no-newline prompt is visible before its read).
fn feed_pending_len() { return _feed_pending_len; }
fn feed_pending_ptr() { return &_feed_pending; }

# --- accessors (row 0 = OLDEST live line; documented for test determinism) ----
fn feed_count() { return _feed_count; }
fn _feed_row_slot(row) { return (_feed_head + row) % FEED_ROWS; }
fn feed_line_ptr(row) { return _feed_base + _feed_row_slot(row) * FEED_LINE_CAP; }
fn feed_line_len(row) { return load64(_feed_len + _feed_row_slot(row) * 8); }
fn feed_vis(row) { return load64(_feed_vis + _feed_row_slot(row) * 8); }
# feed_scroll: rows paged back from the newest, in PHYSICAL (soft-wrapped) rows
# since 0.11.3 — the painter and _tui_feed_scroll_by both reckon in physical rows.
fn feed_scroll() { return _feed_scroll; }
fn feed_scroll_set(off) { if (off < 0) { off = 0; } _feed_scroll = off; return 0; }

# feed_phys_before: PHYSICAL (soft-wrapped) rows occupied by logical lines [0, li) at column `width` — the
# distance from the top of the document to line li's first physical row. Used by feed search to scroll a
# match into view (0.18.4). li may be feed_count() (the pending line sits after all sealed rows). Pure.
fn feed_phys_before(li, width) {
    var t = 0;
    var i = 0;
    while ((i < li) && (i < _feed_count)) {
        t = t + feed_rows_for(feed_vis(i), width);
        i = i + 1;
    }
    return t;
}
