# thoth — secret redaction over tool results (0.40.0, T1-3).
#
# WHY, and where the harm actually is. thoth streams model output into the feed, `/save` writes it to
# disk, and the conversation store persists it — so a model that echoes an API key it found in a
# `read_file` or `shell` result gets that key written into `.thoth/` verbatim, sent back to the gateway on
# every subsequent turn, and dropped into any export the user shares. The 0.39.0 audit closed the
# confused-deputy hole for thoth's OWN credentials (`_project_sensitive`) and said plainly that a general
# secret filter was a DIFFERENT capability. This is that capability.
#
# WHERE IT SITS, and why here. At `_agent_add_result` — the single chokepoint where a tool result becomes
# a transcript message. That is upstream of every sink at once: redact here and the secret never enters
# the conversation, so it never reaches the feed, the store, an export, OR the next request to the
# gateway. Redacting at each sink instead would mean four filters, four chances to miss one, and the
# secret still leaving the machine on the next turn.
#
# thoth OWNS NONE OF THE SCANNING. The patterns, the vendor-prefix table, the PII heuristics and the
# UTF-8-safe replacement are agnosai's `[lib.guard]` profile (src/vendor/agnosai-guard.cyr). This file is
# glue: a config gate, a Str/cstr shim, and an honest announcement. Consume, never fork.
#
# ⚠ WHAT THIS IS NOT. It is pattern matching, and therefore a MITIGATION, not a boundary — precisely the
# framing `src/shell.cyr` already uses for its deny globs. It catches recognisable shapes (vendor key
# prefixes, emails, SSNs); it will not catch a secret that looks like an ordinary word, and a determined
# exfiltration path is not closed by it. Claiming otherwise would be the security theatre thoth's honest
# degradation rule exists to prevent.
#
# DEFAULT ON, unlike [shell].enabled / [edit].enabled / [hoosh].summarize — and the difference is
# principled, not inconsistent. Those three are off by default because each ADDS capability, risk, or
# cost. Redaction removes risk and costs one in-memory scan. A protection that is off by default protects
# nobody, so the burden is the other way round: `[redact].enabled = false` for the user whose legitimate
# work it interferes with.
#
# ANNOUNCED, ALWAYS. When a result is redacted thoth says so, with the count and category, because a value
# silently replaced by `[REDACTED]` is otherwise indistinguishable from a tool that returned nothing
# useful — and the user would debug the wrong thing.

# ⚠ 0.44.3 — RAISED 256 KiB -> 1.25 MiB, because the note below ("above every bounded tool result thoth
# produces") had gone stale in the one place it mattered: `[shell].max_output` is operator-set with a
# ceiling of SHELL_OUT_MAX = 1 MiB, so any value above 256 KiB silently turned redaction OFF for shell
# results — the tool most likely to print an `env` or a token-bearing build log. The cap now clears that
# ceiling with 256 KiB of headroom for the redaction's own growth (`[REDACTED]` is longer than most of
# what it replaces). It is a bound on a WORKING COPY, not on what the model sees.
var REDACT_CAP = 1310720;     # 1.25 MiB: SHELL_OUT_MAX (1 MiB) + growth headroom — see the note above
var _redact_buf = 0;
var _redact_n = 0;            # results redacted this session (for /state)

fn redact_count() { return _redact_n; }
fn redact_reset() { _redact_n = 0; return 0; }

# redact_active: 1 when redaction is on. Split out so /state and the tests can ask without duplicating
# the config default.
fn redact_active() { return config_redact_enabled(); }

# redact_tool_result: return `text` with recognisable secrets replaced, or `text` unchanged when
# redaction is off, the text is clean, or the text is too large to buffer.
#
# ⚠ The over-cap case passes the text through UNSCANNED rather than truncating it. Truncating a tool
# result to fit a scanner would corrupt the model's input to protect against a pattern that may not be
# there — trading a certain harm for a possible one. The cap is 256 KB, which is above every bounded tool
# result thoth produces (read_file caps at 64 KB, list_dir at 16 KB, search at 24 KB, shell at its
# configured max), so this is a guard against a future unbounded producer, not a live path.
# REDACT_WINDOW: the most handed to the scanner at once. _redact_is_token: 1 for a byte a secret or an address is made of.
var REDACT_WINDOW = 2048;
fn _redact_is_token(c) {
    c = c & 255;
    if (((c >= 48) && (c <= 57)) || ((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122))) { return 1; }
    if ((c == 95) || (c == 45) || (c == 46) || (c == 37) || (c == 43) || (c == 64) || (c == 47) || (c == 61) || (c >= 128)) { return 1; }
    return 0;
}
fn redact_tool_result(text) {
    if (text == 0) { return text; }
    if (redact_active() == 0) { return text; }
    var n = strlen(text);
    if (n == 0) { return text; }
    # Too big to buffer -> pass through, never truncate (see the header: truncating to fit a scanner
    # trades a certain harm for a possible one). ⚠ 0.44.3: SAY SO. This is the one path where the
    # feature does not run, and it used to be indistinguishable from "scanned, nothing found" — an
    # operator who has `[redact]` on is entitled to know when it did not look.
    if (n >= REDACT_CAP) {
        ui_emit(ROLE_RED, "  [redact] ");
        note_println("  this tool result is too large to scan — it was NOT checked for secrets");
        return text;
    }
    if (_redact_buf == 0) { _redact_buf = alloc(REDACT_CAP); }
    if (_redact_buf == 0) { return text; }

    # 0.53.3 (W-7): a window at a time. agnosai's redactor is quadratic on a run of local-part bytes and rebuilds the whole text
    # per replacement on the heap that never frees: `read_file` of 60 KB of `x` took 20 s with Esc dead, and 60 KB of `sk-a `
    # peaked at 3.4 GB. A window ends at whitespace or punctuation where it can; a hard split inside a longer unbroken run could
    # hide a secret across it, the residual named in the audit. A stop between windows withholds the result: what is unscanned
    # must not go on. (Upstream: docs/audit/2026-11-05-audit.md.)
    var on = 0;
    var changed = 0;
    var at = 0;
    while (at < n) {
        var e = at + REDACT_WINDOW;
        if (e >= n) { e = n; }
        else {
            var j = e;
            while ((j > (at + REDACT_WINDOW / 2)) && (_redact_is_token(load8(text + j - 1)) == 1)) { j = j - 1; }
            if (j > (at + REDACT_WINDOW / 2)) { e = j; }
        }
        # agnosai's redactor takes and returns a Str. It answers the ORIGINAL Str when nothing matched, so a pointer comparison is
        # not a reliable "changed?" test — compare the bytes.
        var w = e - at;
        var out = agnosai_output_redact(str_new(text + at, w));
        if (out == 0) { return text; }
        var wn = str_len(out);
        var od = str_data(out);
        if (wn != w) { changed = 1; }
        else {
            var i = 0;
            while ((i < w) && (changed == 0)) { if (load8(od + i) != load8(text + at + i)) { changed = 1; } i = i + 1; }
        }
        if ((on + wn) < REDACT_CAP) { memcpy(_redact_buf + on, od, wn); }
        on = on + wn;
        at = e;
        if ((at < n) && (intr_check() == 1)) { return "(tool result withheld: stopped before its secret scan finished)"; }
    }
    if (changed == 0) { return text; }                 # clean — hand back the caller's own pointer
    # ⚠ 0.44.3 — THIS ARM DISCARDS A SUCCESSFUL REDACTION AND RETURNS THE SECRET. By the time control
    # reaches here the scanner has already found secret-shaped values and replaced them; `out` is the
    # CLEAN text. Returning `text` hands the model, the feed, `/save` and the next gateway request the
    # ORIGINAL — the worst possible outcome of a redactor, reached silently. It is now announced in the
    # strongest terms available, and the raised cap above makes it unreachable for every producer thoth
    # actually has. Kept (rather than truncated) because a cut result is a different, certain harm — but
    # never again a quiet one.
    if (on >= REDACT_CAP) {
        ui_emit(ROLE_RED, "  [redact] ");
        note_println("  a secret was found but the redacted result no longer fits the scan buffer — the ORIGINAL text was passed through UNREDACTED");
        return text;
    }
    store8(_redact_buf + on, 0);
    _redact_n = _redact_n + 1;
    # Announced, never silent — the user must be able to tell "[REDACTED]" from "the tool found nothing".
    ui_emit(ROLE_ACCENT, "  [redacted] ");
    note_println("  a secret-shaped value in this tool result was replaced before it entered the conversation");   # 0.44.2: reaches one-shot/GUI too
    return _redact_buf;
}
