# src/intr.cyr — turn-interrupt substrate (Esc aborts a streaming turn without exiting the session).
#
# EXTRACTED from tui.cyr (0.30.8 decoupling): interrupt handling is signal/termios SUBSTRATE, not TUI
# presentation, so hoosh/agent (which poll it around a streaming turn) no longer reach UP into tui.cyr for it.
# Depends only on the portable substrate (darshana termios constants + _tty_apply_raw_flags, util out_mode /
# ui_emit / oprintln, raw syscalls) — included AFTER ui, BEFORE hoosh/agent/tui. Gated on out_mode()==OUT_RING
# (the TUI capture path) so the REPL/piped/one-shot floor never touches the terminal and stays byte-identical.

# --- turn interrupt (0.17.4): Esc aborts a streaming turn without exiting the session -------------
# A turn runs in COOKED mode (tui_run_line drops to canonical so the t-ron read_line confirm works),
# which line-buffers input — a lone Esc is not readable by an ordinary read. So each streaming read is
# bracketed by a non-canonical, non-blocking (VMIN=0/VTIME=0) poll mode: the SSE callback drains stdin
# per frame and, on Esc, sets _intr_flag and returns 0 (sandhi stops the stream cleanly). GATED on
# out_mode()==OUT_RING (the TUI capture path) so the REPL/piped/one-shot floor never touches the
# terminal and stays byte-identical. The ioctls are Linux-only (darshana's TCGETS/TCSETS are
# #ifdef CYRIUS_TARGET_LINUX); off Linux this degrades to a no-op (no interrupt), like the base termios.
var _intr_saved = 0;          # cooked termios saved by intr_arm (lazy 60B alloc)
var _intr_active = 0;         # 1 while the poll-mode termios is installed
var _intr_flag = 0;           # 1 once Esc was seen THIS turn
var _intr_seq = 0;            # 0.52.0 (F7): every raise, never reset — see intr_seq
var _intr_check_fn = 0;       # front-end interrupt-poll hook (0.34.1, below); 0 -> the built-in stdin poll (TUI/REPL)

fn intr_reset() { _intr_flag = 0; return 0; }     # call ONCE at turn start (hoosh_send / agent_turn)
fn intr_pending() { return _intr_flag; }

# intr_seq (0.52.0, F7): the interrupt GENERATION — a count of every raise (an Esc intr_poll drained, a front end's
# intr_signal), never reset. `_intr_flag` is a LEVEL scoped to a turn: it stays up from the Esc until the next turn's
# intr_reset. A running command needs an EDGE — "was a stop asked for while THIS command ran?" — or the flag an
# interrupted turn left up would kill a later /run the moment it started. exec's wait loop reads the generation as its
# child starts (through the surface's wait poll) and stops the child when it moves.
fn intr_seq() { return _intr_seq; }

# intr_arm: install the non-canonical VMIN=0/VTIME=0 poll termios around one streaming read. Saves the
# current (cooked) termios into a PRIVATE buffer so intr_disarm can restore it — it does NOT use
# darshana's tty_raw/tty_cooked (which would clobber their single saved-termios / _tty_in_raw state and
# strand the post-turn tty_raw at tui_run_line). Does NOT touch _intr_flag (that spans the whole turn).
fn intr_arm() {
    _intr_active = 0;
    if (out_mode() != OUT_RING) { return 0; }        # TUI-only -> floor byte-identical
    # 0.52.0: a front end that registered its own poll reads its OWN input (the window drains the Wayland fd), so the
    # terminal it was launched from is not the stop key's source — /run under the window's card bracket (OUT_RING)
    # must not flip that terminal into poll mode for the length of the command.
    if (_intr_check_fn != 0) { return 0; }
    #ifdef CYRIUS_TARGET_LINUX
    if (_intr_saved == 0) { _intr_saved = alloc(60); }
    if (syscall(SYS_IOCTL, 0, TCGETS, _intr_saved) < 0) { return 0; }   # not a tty -> stay disarmed
    var work[60];
    var i = 0;
    while (i < 60) { store8(&work + i, load8(_intr_saved + i)); i = i + 1; }
    _tty_apply_raw_flags(&work);                      # ICANON/ECHO/ISIG off (darshana; sets VMIN=1)
    store8(&work + TIO_CC_BASE + TIO_VMIN, 0);         # override to VMIN=0 + VTIME=0: read returns at once
    store8(&work + TIO_CC_BASE + TIO_VTIME, 0);
    if (syscall(SYS_IOCTL, 0, TCSETS, &work) < 0) { return 0; }
    _intr_parse_reset();                              # 0.52.6: a sequence cut off by the last disarm is not continued
    _intr_active = 1;
    #endif
    return 0;
}

# intr_poll: while armed, non-blockingly DRAIN pending stdin; set _intr_flag on a STOP (_intr_feed below). All
# pending bytes are consumed so mid-turn keystrokes don't leak into the next composer read. Called per SSE frame;
# between frames thoth blocks in the socket recv, so a STALLED stream (no frame arriving) is only interruptible when
# the next frame lands or sandhi's read timeout fires — a documented granularity limit. Safe off Linux: _intr_active
# is never set there.
#
# ⚠ 0.52.6 (audit F6) — NOT EVERY ESC IS A STOP. Any byte 27 used to count, which the comment here called "a mild
# edge" when a stray interrupt only ended a streaming reply. Since 0.52.0 (F7) the same poll KILLS a running command,
# and the TUI turns mouse reporting on itself: a wheel scroll during `/run`, a `shell` call or `[verify]` killed it
# (`ESC[<65;20;10M` -> "stopped by the operator"), and during a pre_tool hook it became a DENY the model was told
# the hook made. Arrows, PgUp/PgDn, bracketed paste and kitty's CSI-u chords did the same. The bytes are now parsed:
# a CSI / SS3 sequence, an X10 mouse report and a bracketed paste are consumed without counting, and a stop is a LONE
# Esc (nothing follows it in the drain) or kitty's encoding of the Esc key, `ESC[27u` (with any modifier field).
fn intr_poll() {
    if (_intr_active == 0) { return _intr_flag; }
    var c[8];
    var n = syscall(SYS_READ, 0, &c, 1);
    while (n > 0) {
        if (_intr_feed(load8(&c) & 255) == 1) { intr_signal(); }
        n = syscall(SYS_READ, 0, &c, 1);
    }
    if (_intr_feed_end() == 1) { intr_signal(); }
    return _intr_flag;
}

# --- the drain's parser (0.52.6, audit F6) ------------------------------------------------------------------------
# State spans polls (a sequence split across two reads stays a sequence): 0 ground, 1 after ESC, 2 in a CSI (params
# collected), 3 SS3 (one byte follows), 4 an X10 mouse report (three raw bytes follow), 5 inside a bracketed paste
# (everything up to `ESC[201~` is text, an ESC in it included).
var INTR_P_CAP = 16;
var _intr_st = 0;
var _intr_pn = 0;                 # CSI parameter bytes collected
var _intr_pb[16];                 # module scope: 16 i64 slots — only the first INTR_P_CAP bytes are used
var _intr_x10 = 0;                # X10 bytes still owed
var _intr_paste = 0;              # 1 inside a bracketed paste
fn _intr_parse_reset() { _intr_st = 0; _intr_pn = 0; _intr_x10 = 0; _intr_paste = 0; return 0; }

# _intr_params_are(lit): 1 when the collected CSI parameter bytes equal `lit` exactly.
fn _intr_params_are(lit) {
    var n = strlen(lit);
    if (n != _intr_pn) { return 0; }
    var i = 0;
    while (i < n) { if (load8(&_intr_pb + i) != load8(lit + i)) { return 0; } i = i + 1; }
    return 1;
}

# _intr_params_lead(lit): 1 when the collected CSI parameter bytes begin with `lit`.
fn _intr_params_lead(lit) {
    var n = strlen(lit);
    if (n > _intr_pn) { return 0; }
    var i = 0;
    while (i < n) { if (load8(&_intr_pb + i) != load8(lit + i)) { return 0; } i = i + 1; }
    return 1;
}

# _intr_feed(b): one drained byte; 1 when it completes a STOP.
fn _intr_feed(b) {
    if (_intr_st == 4) {                                   # X10 mouse: Cb Cx Cy, raw
        _intr_x10 = _intr_x10 - 1;
        if (_intr_x10 <= 0) { _intr_st = 0; }
        return 0;
    }
    if (_intr_st == 3) { _intr_st = 0; return 0; }         # SS3 final (ESC O P, arrows in application mode)
    if (_intr_st == 2) {
        if ((b >= 0x40) && (b <= 0x7E)) {                  # the CSI's final byte
            var stop = 0;
            if (_intr_paste == 0) {
                if ((b == 117) && ((_intr_params_are("27") == 1) || (_intr_params_lead("27;") == 1))) { stop = 1; }   # kitty: ESC[27u, ESC[27;<mods>u
                if ((b == 126) && (_intr_params_are("200") == 1)) { _intr_paste = 1; }
                if ((b == 77) && (_intr_pn == 0)) { _intr_st = 4; _intr_x10 = 3; _intr_pn = 0; return 0; }   # X10: ESC [ M Cb Cx Cy
            } elif ((b == 126) && (_intr_params_are("201") == 1)) { _intr_paste = 0; }
            _intr_st = 0; _intr_pn = 0;
            if (_intr_paste == 1) { _intr_st = 5; }
            return stop;
        }
        if (_intr_pn < INTR_P_CAP) { store8(&_intr_pb + _intr_pn, b); _intr_pn = _intr_pn + 1; }
        else { _intr_st = 0; _intr_pn = 0; if (_intr_paste == 1) { _intr_st = 5; } }   # a runaway sequence: back to ground, never swallowing for ever
        return 0;
    }
    if (_intr_st == 1) {
        if (b == 91) { _intr_st = 2; _intr_pn = 0; return 0; }        # CSI
        if ((b == 79) && (_intr_paste == 0)) { _intr_st = 3; return 0; }   # SS3
        if (b == 27) {                                    # ESC ESC: the first was a lone Esc (outside a paste)
            if (_intr_paste == 1) { return 0; }
            return 1;
        }
        _intr_st = 0;                                     # ESC + a key: an Alt chord, not a stop
        if (_intr_paste == 1) { _intr_st = 5; }
        return 0;
    }
    if (b == 27) { _intr_st = 1; return 0; }              # ground or paste: the start of something — decided by what follows
    return 0;
}

# _intr_feed_end: the drain found nothing more. An ESC with nothing after it is the Esc KEY — a stop (outside a
# paste). Any other partial sequence waits for the next poll.
fn _intr_feed_end() {
    if (_intr_st == 1) {
        _intr_st = 0;
        if (_intr_paste == 1) { _intr_st = 5; return 0; }
        return 1;
    }
    return 0;
}

# intr_disarm: restore the saved cooked termios (for a following read_line confirm / the next turn).
fn intr_disarm() {
    #ifdef CYRIUS_TARGET_LINUX
    if (_intr_active == 1) { syscall(SYS_IOCTL, 0, TCSETS, _intr_saved); _intr_active = 0; }
    #endif
    return 0;
}

# intr_note: land the honest "— interrupted" marker as its own feed line (NEVER appended to the reply
# text that enters history — history holds the clean partial; this is a UI annotation only).
fn intr_note() { ui_emit(ROLE_MUTED, "  — interrupted"); oprintln(""); return 0; }

# --- 0.34.1: full agentic-loop interrupt behind a front-end-agnostic seam --------------------------------------
# The agentic loop (agent.cyr) now polls intr_check() BETWEEN rounds and BETWEEN tool calls, not only per stream
# frame — so Esc cancels mid-round (during tool execution / the non-streaming block path), not just streaming.
# intr_check is FRONT-END-AGNOSTIC: for the TUI it drains stdin (the built-in poll below); a GUI (0.34.2) registers
# its own non-blocking input poll via intr_check_hook_set (which calls intr_signal on its stop key), so the SAME
# loop checkpoints serve both front-ends without agent.cyr knowing which is active.
var _intr_suspended = 0;     # 1 while intr_suspend left poll-mode for a cooked read (a confirm), pending resume
fn intr_check_hook_set(h) { _intr_check_fn = h; return 0; }
fn intr_armed() { return _intr_active; }
fn intr_signal() { _intr_flag = 1; _intr_seq = _intr_seq + 1; return 0; }   # raise the interrupt flag directly (a GUI stop key, 0.34.2 — or a test); 0.52.0: and move the generation

# intr_check: the front-end-agnostic interrupt checkpoint — refresh the flag from the registered front-end poll
# (GUI) or the built-in stdin drain (TUI, no-op if not armed), and return it. Cheap + non-blocking; hot-loop safe.
fn intr_check() {
    if (_intr_check_fn != 0) { fncall0(_intr_check_fn); return _intr_flag; }
    return intr_poll();
}

# intr_suspend / intr_resume: bracket a COOKED read (the t-ron confirm's read_line) that runs while the agentic
# tool phase has poll-mode armed — leave poll-mode so the line read echoes/works, then re-enter it. Idempotent:
# resume re-arms only if suspend actually left an armed poll. Driven from the TUI confirm hooks (OUT_RING only; off
# the TUI intr is never armed, so both are no-ops and the floor is byte-identical).
fn intr_suspend() {
    if (_intr_active == 1) { intr_disarm(); _intr_suspended = 1; }
    return 0;
}
fn intr_resume() {
    if (_intr_suspended == 1) { intr_arm(); _intr_suspended = 0; }
    return 0;
}
