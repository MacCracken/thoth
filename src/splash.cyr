fn splash_tier(ch) {
    if ((ch == 64) || (ch == 37) || (ch == 35)) { return 0; }   # @ % #
    if ((ch == 42) || (ch == 43) || (ch == 61)) { return 1; }   # * + =
    if ((ch == 45) || (ch == 58)) { return 2; }                 # - :
    if (ch == 46) { return 3; }                                 # .
    return -1;
}
