# thoth — capability-seam registry.
#
# thoth owns NO domain logic of its own (see docs/architecture/001). Every
# AGNOS-owned domain is reached through a thin capability seam with three
# binding modes. As of M5: bote + avatara bind NATIVE by construction (vendored
# in-process bundles); t-ron binds NATIVE when a policy loads; hoosh + daimon
# bind REMOTE when thoth.cyml declares an endpoint; anything else reports
# ABSENT. The seams report their status honestly; nothing is faked.
#
# Pure functions only (plus one display helper). Unit-tested in tests/.

# Binding mode of a seam.
enum SeamStatus {
    SEAM_ABSENT = 0;     # not reachable; the feature degrades honestly
    SEAM_REMOTE = 1;     # reached as a client over a portable transport
    SEAM_NATIVE = 2;     # AGNOS-native, co-resident, sandboxed (canonical)
}

# The spine seams thoth consumes (memory added 0.12.0 — ADR-0012).
enum SeamId {
    SEAM_HOOSH = 0;
    SEAM_DAIMON = 1;
    SEAM_BOTE = 2;
    SEAM_TRON = 3;
    SEAM_AVATARA = 4;
    SEAM_MEMORY = 5;    # persistent memory — owned by mneme (ADR-0012)
    SEAM_GIT = 6;       # version control — owned by sit (0.13.0; vendored read profile)
}

var SEAM_COUNT = 7;

# seam_name: crate name for a seam id.
fn seam_name(id) {
    if (id == SEAM_HOOSH) { return "hoosh"; }
    if (id == SEAM_DAIMON) { return "daimon"; }
    if (id == SEAM_BOTE) { return "bote"; }
    if (id == SEAM_TRON) { return "t-ron"; }
    if (id == SEAM_AVATARA) { return "avatara"; }
    if (id == SEAM_MEMORY) { return "mneme"; }
    if (id == SEAM_GIT) { return "sit"; }
    return "?";
}

# seam_domain: the domain the seam owns (and that thoth never reimplements).
fn seam_domain(id) {
    if (id == SEAM_HOOSH) { return "LLM inference - model routing + mid-session switch"; }
    if (id == SEAM_DAIMON) { return "agent orchestration + MCP tool execution + host registry"; }
    if (id == SEAM_BOTE) { return "MCP protocol"; }
    if (id == SEAM_TRON) { return "MCP per-tool authorization (the security gate)"; }
    if (id == SEAM_AVATARA) { return "personality / archetype overlay (Thoth / Librarian)"; }
    if (id == SEAM_MEMORY) { return "persistent memory / project note library"; }
    if (id == SEAM_GIT) { return "version control - branch / status / diff on git + .sit repos"; }
    return "?";
}

# seam_status: current binding mode.
#  - hoosh (M3) binds REMOTE when thoth.cyml declares [hoosh].url — reached as
#    a client over HTTP via sandhi. No endpoint -> absent, never faked.
#  - daimon (M4) binds REMOTE the same way, via [daimon].url (the MCP host).
#  - bote (M4) is NATIVE: the vendored bote-core bundle is the MCP protocol,
#    in-process — the same contract AGNOS serves co-resident.
#  - t-ron (M4) binds NATIVE when a [tron].policy loads (the vendored t-ron
#    bundle, in-process); otherwise absent and the built-in fail-closed
#    confirm gate stands in (announced, never silent).
#  - avatara (M5) is NATIVE by construction: the vendored avatara archetype
#    bundle supplies the Thoth/Librarian persona in-process — the off-AGNOS
#    bundled descriptor over the same contract AGNOS serves co-resident.
fn seam_status(id) {
    if (id == SEAM_HOOSH) {
        if (config_hoosh_configured() == 1) { return SEAM_REMOTE; }
    }
    if (id == SEAM_DAIMON) {
        if (config_daimon_configured() == 1) { return SEAM_REMOTE; }
    }
    if (id == SEAM_BOTE) { return SEAM_NATIVE; }
    if (id == SEAM_AVATARA) { return SEAM_NATIVE; }
    # git (0.13.0): sit is a vendored dist bundle, so the binding is NATIVE by
    # construction — the same as bote/avatara. Whether it delivers anything is the
    # capability-effect dimension (seam_cap_state): FULL at a repo, ABSENT otherwise.
    if (id == SEAM_GIT) { return SEAM_NATIVE; }
    if (id == SEAM_TRON) {
        if (gate_active() == 1) { return SEAM_NATIVE; }
    }
    # memory (0.12.0): mneme is not yet Cyrius-ported, so it is never reachable
    # today -> ABSENT at the binding layer. When its port registers with daimon,
    # discover mneme_* in the registry and return SEAM_REMOTE here; until then the
    # local .thoth/memory reader is the DEGRADED fallback (seam_cap_state; ADR-0012).
    return SEAM_ABSENT;
}

# seam_status_label: human label for a binding mode.
fn seam_status_label(st) {
    if (st == SEAM_NATIVE) { return "native"; }
    if (st == SEAM_REMOTE) { return "remote-client"; }
    return "absent";
}

# --- Capability ladder: the full / degraded / absent effect dimension (M6). ---
#
# The binding mode above (native / remote-client / absent) says HOW a seam is
# reached. This second dimension says WHAT the user actually gets — the honest
# capability ladder. The two are distinct: a seam can be ABSENT at the binding
# layer yet still DEGRADED (not absent) at the capability layer, because thoth
# stands a fail-closed fallback in its place. t-ron is exactly that case — no
# policy means the built-in confirm gate, never a silent allow. This mapping is
# derived from the LIVE binding status (seam_status), so the ladder cannot drift
# away from what the binary actually does.

# What a capability delivers, by effect.
enum CapState {
    CAP_ABSENT = 0;     # the capability is gone; announced, never faked
    CAP_DEGRADED = 1;   # a reduced, fail-closed fallback stands in; announced
    CAP_FULL = 2;       # the capability is fully present
}

# cap_state_label: human label for a capability effect.
fn cap_state_label(c) {
    if (c == CAP_FULL) { return "full"; }
    if (c == CAP_DEGRADED) { return "degraded"; }
    return "absent";
}

# seam_cap_state: the live capability effect, derived from the binding status.
#  - bote / avatara are NATIVE by construction -> always FULL.
#  - hoosh / daimon are FULL when wired (remote), else ABSENT (no fallback —
#    no inference and no tool host can be faked).
#  - t-ron is FULL when its policy loads (native), else DEGRADED: the built-in
#    fail-closed confirm gate stands in. Security degrades CLOSED, never to
#    ABSENT — there is no state in which an action is silently allowed.
fn seam_cap_state(id) {
    if (id == SEAM_TRON) {
        if (seam_status(id) == SEAM_NATIVE) { return CAP_FULL; }
        return CAP_DEGRADED;
    }
    if (id == SEAM_MEMORY) {
        if (seam_status(id) == SEAM_REMOTE) { return CAP_FULL; }   # mneme bound (future)
        if (config_memory_enabled() == 1) { return CAP_DEGRADED; }  # local .thoth/memory reader stands in
        return CAP_ABSENT;                                          # off by default -> byte-identical floor
    }
    if (id == SEAM_GIT) {
        git_ensure_probed();
        if (git_present() == 1) { return CAP_FULL; }   # a repo is present at cwd
        return CAP_ABSENT;                             # sit native, but no repo here -> nothing to report
    }
    if (seam_status(id) == SEAM_ABSENT) { return CAP_ABSENT; }
    return CAP_FULL;
}

# seam_cap_full: what the seam delivers at FULL capability.
fn seam_cap_full(id) {
    if (id == SEAM_HOOSH) { return "free-text turns route to a backing model; mid-session /model switch"; }
    if (id == SEAM_DAIMON) { return "MCP tool registry (/tools) + execution (/call); the agentic loop"; }
    if (id == SEAM_BOTE) { return "MCP protocol framing, in-process"; }
    if (id == SEAM_TRON) { return "per-tool authorization on /run, /write, /call; deny is final"; }
    if (id == SEAM_AVATARA) { return "the Thoth/Librarian archetype steers every turn"; }
    if (id == SEAM_MEMORY) { return "mneme notes: semantic + full-text recall, auto-link, knowledge graph"; }
    if (id == SEAM_GIT) { return "branch + working-tree status (+ per-file diff) via sit's read-only .git/.sit API"; }
    return "?";
}

# seam_cap_fallback: what stands in when the seam is NOT at FULL — the honest
# degraded/absent behaviour. "n/a" for the always-native vendored seams.
fn seam_cap_fallback(id) {
    if (id == SEAM_HOOSH) { return "absent: no model turns - local REPL commands only (set [hoosh].url)"; }
    if (id == SEAM_DAIMON) { return "absent: no tools - /tools, /call, the agentic loop report absent"; }
    if (id == SEAM_BOTE) { return "n/a: vendored, native by construction"; }
    if (id == SEAM_TRON) { return "degraded: built-in fail-closed confirm gate (deny/prompt); never silent allow"; }
    if (id == SEAM_AVATARA) { return "n/a: vendored, native by construction"; }
    if (id == SEAM_MEMORY) {
        if (config_memory_enabled() == 1) { return "degraded: local .thoth/memory flat-file inject (verbatim; recency + budget, no search)"; }
        return "absent: memory off - set [memory].enabled (mneme not yet Cyrius-ported)";
    }
    if (id == SEAM_GIT) { return "absent: no git/.sit repo at the working directory (sit reads at cwd; no ancestor walk)"; }
    return "?";
}

# seam_any_wired: 1 if any seam is reachable (remote or native), else 0.
fn seam_any_wired() {
    var i = 0;
    var wired = 0;
    while (i < SEAM_COUNT) {
        if (seam_status(i) != SEAM_ABSENT) { wired = 1; }
        i = i + 1;
    }
    return wired;
}

# Live-ladder palette: a capability effect / binding mode maps to a color role —
# full/wired green, degraded amber (accent), absent red/faint. (T1+; "" at T0.)
fn _cap_role(c) {
    if (c == CAP_FULL) { return ROLE_GREEN; }
    if (c == CAP_DEGRADED) { return ROLE_ACCENT; }
    return ROLE_RED;
}
fn _bind_role(st) {
    if (st == SEAM_ABSENT) { return ROLE_FAINT; }
    return ROLE_GREEN;
}

# cmd_seams: render the capability ladder — two dimensions per seam: the binding
# mode (how it's reached) and the capability effect (what you get). I/O — the
# pure accessors it composes are unit-tested; this renderer is not.
fn cmd_seams() {
    ui_emit(ROLE_ACCENT, "capability ladder - the AGNOS spine thoth drives:"); oprintln("");
    ui_emit(ROLE_FAINT, "  per seam: [binding mode] [capability effect] domain; then the live effect."); oprintln("");
    var i = 0;
    while (i < SEAM_COUNT) {
        # binding row: name, binding mode, capability effect, domain.
        emit("  ");
        ui_emit(ROLE_ACCENT, seam_name(i));
        emit("  [");
        ui_emit(_bind_role(seam_status(i)), seam_status_label(seam_status(i)));
        emit("]  [");
        ui_emit(_cap_role(seam_cap_state(i)), cap_state_label(seam_cap_state(i)));
        emit("]  ");
        ui_emit(ROLE_FAINT, seam_domain(i)); oprintln("");
        # effect row: full delivers / fallback when not full.
        if (seam_cap_state(i) == CAP_FULL) {
            ui_emit(ROLE_FAINT, "      full:     ");
            ui_emit(ROLE_GREEN, seam_cap_full(i)); oprintln("");
        } else {
            ui_emit(ROLE_FAINT, "      now:      ");
            ui_emit(ROLE_MUTED, seam_cap_fallback(i)); oprintln("");
        }
        i = i + 1;
    }
    oprintln("");
    if (seam_any_wired() == 0) {
        ui_emit(ROLE_FAINT, "  every spine seam is absent. Nothing is faked."); oprintln("");
    } else {
        ui_emit(ROLE_FAINT, "  remote seams ride sandhi; native seams are vendored dist bundles."); oprintln("");
        ui_emit(ROLE_FAINT, "  absent seams degrade honestly — never faked, never reimplemented."); oprintln("");
        ui_emit(ROLE_FAINT, "  security degrades CLOSED: absent t-ron is the fail-closed gate, never a silent allow."); oprintln("");
    }
    ui_emit(ROLE_ACCENT_DIM, "  port the floor; never fork the spine."); oprintln("");
    return 0;
}
