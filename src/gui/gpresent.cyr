# src/gui/gpresent.cyr — the T3 GUI present loop (0.30.0, Phase 2).
#
# Drives gwindow.cyr's sovereign Wayland seam: open a window, build+raster a frame (status strip + body) into
# the wl_shm buffer, present, and repaint on events (resize / key / close). Degrades HONESTLY when there is no
# compositor (the common headless case) — a stderr note + a nonzero exit, never a hang or a fake window.
#
# UNVERIFIABLE headless: the present/poll loop needs a live compositor (aethersafha on AGNOS, or Hyprland /
# wlroots on Linux). The frame ASSEMBLY (gframe_build) is pure draw-commands over the tested pipeline
# (gstatus + graster). main-only (references gwl_win_*, which is main-only).
#
# Per-repaint note: gframe_build allocs the command list on the bump heap each repaint. Repaints are
# EVENT-DRIVEN (poll blocks until the compositor sends something — resize/key/close), NOT a continuous
# animation loop, so the per-interaction leak is bounded (matches jalwa). thoth's alloc has no mark/rewind, so
# alloc_reset() (a FULL-heap rewind) is NOT usable per frame — a reused command-buffer pool is the future
# optimization if a continuous loop is ever added.

# The frame assembly (gframe_build + _gframe_bg + GFRAME_* constants) lives in gfeed.cyr — a view-builder,
# kept there so it is headless-testable (this file is main-only). This loop just rasters + presents it.

# _gpresent_poll_fd: block until the Wayland fd is readable (or timeout_ms). poll(2) = syscall 7. pfd is an
# 8-byte struct [fd:i32, events:u16, revents:u16].
fn _gpresent_poll_fd(pfd, fd, timeout_ms) {
    store32(pfd, fd);
    store16(pfd + 4, 1);          # events = POLLIN
    store16(pfd + 6, 0);          # revents
    return syscall(7, pfd, 1, timeout_ms);
}

# The frame command list is CACHED and rebuilt only when the view CHANGES (_gui_dirty) — a keystroke, resize,
# or turn. The throb (0.30.11) does NOT rebuild: it advances a colour phase and rewrites just the owl-eye cell,
# then re-rasters the cached list. So the idle animation costs ZERO per-frame allocation (only rebuilds leak a
# list, exactly as before — bounded by real interactions, not by the throb).
var _gui_cmds = 0;
var _gui_dirty = 1;
var _gui_pending = 0;   # a redraw is wanted (dirty view or a throb step) but may await gwl_win_ready()

# render one frame into the present buffer + commit. Rebuilds the cached command list only when dirty; always
# recolours the live owl eye to the current throb phase before rasterising.
fn _gpresent_frame(win) {
    var buf = gwl_win_present_begin(win);
    if (buf == 0) { return 0; }
    var sz[16];
    gwl_win_size_px(win, &sz);
    var w = load64(&sz);
    var h = load64(&sz + 8);
    if ((_gui_dirty == 1) || (_gui_cmds == 0)) { _gui_cmds = gframe_build(w, h); _gui_dirty = 0; }
    if (geye_cell() != 0) { store64(geye_cell() + GDC_COLOR, geye_color_now()); }   # live owl-eye recolour
    gr_fb_clear(buf, w, h, _gframe_bg());
    gr_raster(_gui_cmds, buf, w, h);
    gwl_win_present_commit(win, 0, 0, w, h);
    return 0;
}

# drain queued keys into the composer (gcomp_key). Returns 1 if Esc (quit), 2 if Enter (submit), else 0.
fn _gpresent_drain_keys(win) {
    var rec[24];
    var action = 0;
    while (gwl_win_next_key(win, &rec) == 1) {
        var value = load64(&rec + 8);
        if ((value == 1) || (value == 2)) {              # press / autorepeat
            var code = load64(&rec);
            var mods = load64(&rec + 16);
            var shift = 0;
            if ((mods & 1) != 0) { shift = 1; }              # MOD_SHIFT (gwl_wl__derive_mods)
            var ctrl = 0;
            if ((mods & 4) != 0) { ctrl = 1; }               # MOD_CTRL -> the pane-toggle chords (0.32.x)
            var a = gkey(code, shift, ctrl);                 # focus-aware dispatch (composer / tree nav / pane toggles)
            if (a != 0) { action = a; }
        }
    }
    return action;
}

# --- GUI stop affordance (0.34.3) — a stop key aborts a turn mid-flight -----------------------------------------
# A GUI turn runs SYNCHRONOUSLY (cmd_task under OUT_NULL, gpresent below), so the present loop is blocked for the
# turn's duration and keys pressed during it queue unread on the Wayland fd. This hook — registered as the
# front-end-agnostic interrupt seam's poll (intr_check_hook_set, 0.34.1) and called by agent_turn's intr_check() at
# each stream frame / round / tool-call boundary — NON-BLOCKINGLY drains the Wayland fd and raises the interrupt
# flag on the STOP key (Esc, evdev 1), so Esc cancels the turn. This is the minimal stop-poll subset of 0.35.0's
# full mid-turn pump: it services input only (no repaint), and any non-Esc keys pressed mid-turn are drained and
# discarded, matching the TUI's "mid-turn keystrokes don't leak into the composer" rule.
var _gstop_win = 0;
fn gstop_set_win(w) { _gstop_win = w; return 0; }
fn _gstop_poll() {
    if (_gstop_win == 0) { return 0; }
    var pfd[8];
    if (_gpresent_poll_fd(&pfd, gwl_win_fd(_gstop_win), 0) <= 0) { return 0; }   # non-blocking peek; nothing queued
    var ev = gwl_win_poll_events(_gstop_win);
    if ((ev & GWL_WIN_EV_KEY) == 0) { return 0; }
    var rec[24];
    while (gwl_win_next_key(_gstop_win, &rec) == 1) {
        if (load64(&rec + 8) == 1) {                  # value 1 = press (not autorepeat/release)
            if (load64(&rec) == 1) { intr_signal(); } # evdev keycode 1 = Esc = STOP -> raise the interrupt flag
        }
    }
    return 0;
}

# gui_run: open a window and run the event loop until close. 0 on clean exit, -1 if no compositor.
fn gui_run() {
    if (gwl_win_open("thoth", 960, 600) == 0) {
        emit_err("thoth gui: no Wayland compositor available.\n");
        emit_err("  set WAYLAND_DISPLAY and run under a live display (Hyprland/wlroots, or aethersafha on AGNOS).\n");
        return 0 - 1;
    }
    var win = 1;
    ftree_load();                                        # populate the file-tree pane (0.30.5)
    git_probe();                                         # so the tree's git badges + the status git field have data
    inhist_init();                                       # composer history recall ring (0.30.15)
    gstop_set_win(win); intr_check_hook_set(&_gstop_poll);   # 0.34.3: route the interrupt seam to the GUI stop-poll so Esc aborts a turn
    var pfd[8];
    _gpresent_frame(win);                                # first paint
    var running = 1;
    while (running == 1) {
        # poll with a THROB tick (0.30.11): wake every ~120ms even when idle so the owl eye can pulse. poll(2)
        # returns >0 when the wl fd has data (service events then), 0 on the timeout (advance the throb), <0 on
        # error. gwl_win_poll_events MUST be called only when the fd is readable (it does one read).
        var pr = _gpresent_poll_fd(&pfd, gwl_win_fd(win), 120);
        if (pr < 0) { running = 0; }
        else {
            if (pr > 0) {                                     # the wl fd is readable -> service compositor events
                var ev = gwl_win_poll_events(win);            # also clears frame-callback / buffer-release (gwl_win_ready)
                if ((ev & GWL_WIN_EV_CLOSE) != 0) { running = 0; }
                else {
                    if ((ev & GWL_WIN_EV_RESIZE) != 0) { gwl_win_resize_apply(win); _gui_dirty = 1; _gui_pending = 1; }
                    if ((ev & GWL_WIN_EV_KEY) != 0) {
                        var act = _gpresent_drain_keys(win);
                        if (act == 1) { running = 0; }                    # Esc -> quit
                        else {
                            if (act == 2) {                               # Enter -> submit the composer as a turn
                                if (gcomp_len() > 0) {
                                    gturn_begin(gcomp_cstr());            # COPY the pending text (the composer is reset next)
                                    gcomp_reset();                        # clear the composer
                                    _gui_dirty = 1;
                                    if (gwl_win_ready(win) == 1) { _gpresent_frame(win); }   # show the working state if the compositor is ready
                                    out_mode_set(OUT_NULL);               # suppress the turn's progress output (no leak to the launch tty)
                                    cmd_task(gturn_text());               # runs the turn: appends user + reply (both popped on failure)
                                    out_mode_set(OUT_FD1);
                                    # honest outcome: a turn that appended no assistant reply (unreachable hoosh, transport/http
                                    # error, empty completion) leaves no fresh assistant as the last row -> the window renders only
                                    # history, so raise a transient "didn't complete" notice instead of silence. Detect via the
                                    # turn tag (gturn_reply_landed), correct even at the SESS_HIST_MAX cap where a net-growth check
                                    # false-fires on a successful turn (0.30.19).
                                    # 0.34.3: distinguish an Esc-INTERRUPT (intr flag set by the stop-poll) from a real
                                    # failure — a stopped turn with no partial gets a neutral "stopped" notice, not the
                                    # red "is hoosh reachable?" one.
                                    if (gturn_reply_landed() == 0) {
                                        if (intr_pending() == 1) { gturn_stop(); } else { gturn_fail(); }
                                    }
                                    gturn_end();                          # drop the provisional bubble; the feed now shows history (+ any notice)
                                }
                            }
                            _gui_dirty = 1; _gui_pending = 1;             # any key redraws the view
                        }
                    }
                }
            } else {                                          # timeout -> advance the throb phase
                geye_phase_advance();
                _gui_pending = 1;
            }
            # present a pending redraw ONLY when the compositor has released the buffer + acked the last frame —
            # else a continuous throb races the scanout and the surface glitches. The release/frame events that
            # flip gwl_win_ready arrive on the fd and are consumed by gwl_win_poll_events above.
            if ((running == 1) && (_gui_pending == 1) && (gwl_win_ready(win) == 1)) {
                _gpresent_frame(win);
                _gui_pending = 0;
            }
        }
    }
    intr_check_hook_set(0); gstop_set_win(0);            # 0.34.3: unregister the GUI stop-poll before teardown
    gwl_win_close(win);
    return 0;
}
