# src/gui/gpresent.cyr — the T3 GUI present loop (0.30.0, Phase 2).
#
# Drives gwindow.cyr's sovereign Wayland seam: open a window, build+raster a frame (status strip + body) into
# the wl_shm buffer, present, and repaint on events (resize / key / click + wheel (0.49.0) / close). Degrades HONESTLY when there is no
# compositor (the common headless case) — a stderr note + a nonzero exit, never a hang or a fake window.
#
# UNVERIFIABLE headless: the present/poll loop needs a live compositor (Hyprland / wlroots on Linux — aethersafha
# refused Wayland, so the AGNOS window backend is a second implementation of the gwl_win_* seam, still to come). The frame ASSEMBLY (gframe_build) is pure draw-commands over the tested pipeline
# (gstatus + graster). main-only (references gwl_win_*, which is main-only).
#
# Per-repaint note: gframe_build allocs the command list on the bump heap each REBUILD. Rebuilds are
# EVENT-DRIVEN (a key, a click, a wheel step, a resize, a turn — the 120 ms throb tick (0.30.11) re-rasters the
# CACHED list without rebuilding, and pointer MOTION wakes the poll but neither queues nor rebuilds), so the
# per-interaction leak is bounded (matches jalwa). thoth's alloc has no mark/rewind, so alloc_reset() (a FULL-heap
# rewind) is NOT usable per frame — a reused command-buffer pool is the future optimization if a per-frame
# rebuild is ever added.

# The frame assembly (gframe_build + _gframe_bg + GFRAME_* constants) lives in gfeed.cyr — a view-builder,
# kept there so it is headless-testable (this file is main-only). This loop just rasters + presents it.

# _gpresent_poll_fd: block until the Wayland fd is readable (or timeout_ms). poll(2) = syscall 7. pfd is an
# 8-byte struct [fd:i32, events:u16, revents:u16].
fn _gpresent_poll_fd(pfd, fd, timeout_ms) {
    store32(pfd, fd);
    store16(pfd + 4, 1);          # events = POLLIN
    store16(pfd + 6, 0);          # revents
    return syscall(7, pfd, 1, timeout_ms);
}

# The frame command list is CACHED and rebuilt only when the view CHANGES (_gui_dirty) — a keystroke, resize,
# or turn. The throb (0.30.11) does NOT rebuild: it advances a colour phase and rewrites just the owl-eye cell,
# then re-rasters the cached list. So the idle animation costs ZERO per-frame allocation (only rebuilds leak a
# list, exactly as before — bounded by real interactions, not by the throb).
var _gui_cmds = 0;
var _gui_dirty = 1;
var _gui_pending = 0;   # a redraw is wanted (dirty view or a throb step) but may await gwl_win_ready()

# render one frame into the present buffer + commit. Rebuilds the cached command list only when dirty; always
# recolours the live owl eye to the current throb phase before rasterising.
fn _gpresent_frame(win) {
    var buf = gwl_win_present_begin(win);
    if (buf == 0) { return 0; }
    var sz[16];
    gwl_win_size_px(win, &sz);
    var w = load64(&sz);
    var h = load64(&sz + 8);
    if ((_gui_dirty == 1) || (_gui_cmds == 0)) { _gui_cmds = gframe_build(w, h); _gui_dirty = 0; }
    if (geye_cell() != 0) { store64(geye_cell() + GDC_COLOR, geye_color_now()); }   # live owl-eye recolour
    gr_fb_clear(buf, w, h, _gframe_bg());
    gr_raster(_gui_cmds, buf, w, h);
    gwl_win_present_commit(win, 0, 0, w, h);
    return 0;
}

# drain queued keys into the composer (gcomp_key). Returns 1 if Esc (quit), 2 if Enter (submit), else 0.
fn _gpresent_drain_keys(win) {
    var rec[24];
    var action = 0;
    while (gwl_win_next_key(win, &rec) == 1) {
        var value = load64(&rec + 8);
        if ((value == 1) || (value == 2)) {              # press / autorepeat
            var code = load64(&rec);
            var mods = load64(&rec + 16);
            var shift = 0;
            if ((mods & 1) != 0) { shift = 1; }              # MOD_SHIFT (gwl_wl__derive_mods)
            var ctrl = 0;
            if ((mods & 4) != 0) { ctrl = 1; }               # MOD_CTRL -> the pane-toggle chords (0.32.x)
            var a = gkey(code, shift, ctrl);                 # focus-aware dispatch (composer / tree nav / pane toggles)
            if (a != 0) { action = a; }
        }
    }
    return action;
}

# the pointer ring (0.49.0, F4): gpointer_pump (gfeed.cyr) is the pure drain — every click and wheel step, or a
# discard. The loop below drains only when the drawn frame is CURRENT (_gui_dirty == 0): a click resolves against
# the frame as last drawn, and a rebuild pending for any reason (a key this batch, a resize, a turn) makes that
# record stale — such records are dropped, never misplaced. The stop-poll and the modal always discard.
fn _gpresent_drop_pointer(win) { return gpointer_pump(1); }

# --- GUI mid-turn pump (0.35.0; grew out of the 0.34.3 stop-poll) -----------------------------------------------
# A GUI turn runs SYNCHRONOUSLY (cmd_task under OUT_NULL, gpresent below), so the present loop is BLOCKED for the
# turn's duration — the window would otherwise freeze on the static "working" frame while the reply streams. This
# hook — registered as the front-end-agnostic interrupt seam's poll (intr_check_hook_set, 0.34.1) and called by
# agent_turn's intr_check() at each stream frame / round / tool-call boundary (both SSE paths) — is the PUMP: on each
# call it (a) non-blockingly drains the Wayland fd, raising the interrupt flag on the STOP key (Esc, evdev 1) so Esc
# cancels the turn, then (b) THROTTLED (~30fps, reusing the TUI's tested _stream_should_paint) and READY-gated
# (gwl_win_ready — the scanout race the idle loop also guards), repaints the window so the growing streaming partial
# (gfeed reads _hoosh_acc directly) shows LIVE. Non-Esc keys are drained + discarded (the TUI "mid-turn keystrokes
# don't leak" rule). Single-buffer + single-threaded: this runs on the SSE cb's own stack, never concurrent with the
# gui_run loop. Residuals (cosmetic, accepted): each repaint rebuilds the frame's command list on the no-rewind bump
# heap (bounded by the ~30fps throttle for a turn; a reused command-buffer pool is the future optimization for very
# long streams); and because intr_check() fires at the TOP of the SSE cb (before that frame's delta is appended),
# the live partial lags the stream by ~one delta — the final delta lands with the post-turn history paint.
var _gstop_win = 0;
var _gpump_last_ms = 0;    # the pump's own last-paint clock (feed_stream_tick's is dead under OUT_NULL)
fn gstop_set_win(w) { _gstop_win = w; return 0; }
fn gstop_win() { return _gstop_win; }   # 0.44.0: gask's blocking modal pumps the same window
fn gpump_reset() { _gpump_last_ms = 0; return 0; }   # reset before a turn so the first partial paints instantly
fn _gstop_poll() {
    if (_gstop_win == 0) { return 0; }
    # (a) stop-poll: drain input for the STOP key, and keep the wl fd serviced so gwl_win_ready stays current
    var pfd[8];
    if (_gpresent_poll_fd(&pfd, gwl_win_fd(_gstop_win), 0) > 0) {   # non-blocking peek; nothing queued -> skip
        var ev = gwl_win_poll_events(_gstop_win);
        if ((ev & GWL_WIN_EV_KEY) != 0) {
            var rec[24];
            while (gwl_win_next_key(_gstop_win, &rec) == 1) {
                if (load64(&rec + 8) == 1) {                  # value 1 = press (not autorepeat/release)
                    if (load64(&rec) == 1) { intr_signal(); } # evdev keycode 1 = Esc = STOP -> raise the interrupt flag
                }
            }
        }
        if ((ev & GWL_WIN_EV_POINTER) != 0) { _gpresent_drop_pointer(_gstop_win); }   # 0.49.0: no clicks mid-turn
    }
    # (b) mid-turn repaint: throttled + ready-gated, so the live partial reply grows on screen during the turn
    var now = clock_now_ms();
    if (_stream_should_paint(now, _gpump_last_ms) == 1) {
        _gpump_last_ms = now;
        _gui_dirty = 1;                                       # the partial grew -> rebuild the frame's command list
        if (gwl_win_ready(_gstop_win) == 1) { _gpresent_frame(_gstop_win); }
    }
    return 0;
}

# gui_ask: the blocking asker registered with ask_hook_set from gui_run. Opens the modal, pumps the
# Wayland fd until the operator settles the question, closes.
#
# ⚠ THE POLL IS BLOCKING (timeout 250ms), unlike _gstop_poll's non-blocking peek. A question has no
# deadline and a busy-spin would burn a core while a human reads; the timeout exists only so the loop
# still repaints on a resize and can never wedge if the compositor goes quiet. Every iteration marks the
# frame dirty and repaints ready-gated, exactly as the mid-turn pump does.
fn gui_ask() {
    var win = gstop_win();
    if (win == 0) { ask_cancel(); return 0; }                            # no window -> nobody to ask
    # Copy ask.cyr's already-sanitised strings into the modal's own view state. gask.cyr deliberately
    # holds no seam of its own so it stays a headless-testable view-builder; this is the bridge.
    gask_open(ask_question());
    # 0.44.3: pick the modal's FIXED label from who is actually asking. `confirm` poses authorization
    # prompts through this same seam (gate.cyr), and labelling one of those "the agent is asking" tells
    # the operator the wrong thing about a security decision — the agent REQUESTED the action; thoth is
    # the one asking whether to allow it.
    if (ask_is_authz() == 1) { gask_set_label(GASK_LABEL_AUTHZ); }
    var i = 0;
    while (i < ask_option_count()) { gask_add_option(ask_option_at(i)); i = i + 1; }
    _gui_dirty = 1;
    if (gwl_win_ready(win) == 1) { _gpresent_frame(win); }
    var done = 0;
    while (done == 0) {
        var pfd[8];
        if (_gpresent_poll_fd(&pfd, gwl_win_fd(win), 250) > 0) {
            var ev = gwl_win_poll_events(win);
            if ((ev & GWL_WIN_EV_CLOSE) != 0) { ask_cancel(); done = 1; }
            if ((ev & GWL_WIN_EV_POINTER) != 0) { _gpresent_drop_pointer(win); }    # 0.49.0: the modal is keyboard-driven
            if ((ev & GWL_WIN_EV_KEY) != 0) {
                var rec[24];
                while ((gwl_win_next_key(win, &rec) == 1) && (done == 0)) {
                    if (load64(&rec + 8) == 1) {                          # value 1 = press (not autorepeat/release)
                        var mods = load64(&rec + 16);
                        var r = _gask_key(load64(&rec), mods & 1);
                        if (r == 2) { ask_cancel(); done = 1; }
                        elif (r == 1) {
                            # Typed text wins over a highlighted option — the two are one answer, and
                            # ask_resolve gives "2" the same meaning here as on the TUI and in the REPL.
                            if (gask_len() > 0) { ask_resolve(gask_text()); }
                            else { ask_pick_option(gask_sel()); }
                            done = 1;
                        }
                    }
                }
            }
        }
        _gui_dirty = 1;
        if (gwl_win_ready(win) == 1) { _gpresent_frame(win); }
    }
    gask_close();
    _gui_dirty = 1;
    if (gwl_win_ready(win) == 1) { _gpresent_frame(win); }
    return 0;
}

# gui_run: open a window and run the event loop until close. 0 on clean exit, -1 if no compositor.
# _gpresent_submit (0.46.0, F1): the composer's line, routed the way the REPL and the TUI route theirs — through
# the command hub — instead of straight to cmd_task, which sent `/theme rainbow` to the MODEL as a task and left
# `/grants` unreachable from the window. Three brackets by the line's FINAL class (classify_final resolves an
# alias first):
#   a turn (prose, or an alias that expands to prose)  -> cmd_task under OUT_NULL, the pump painting it live;
#   a command that RUNS a turn (/retry, /edit)          -> dispatch under the same bracket (the provisional bubble
#                                                          shows the typed line; the reply lands in history as usual);
#   any other command                                   -> dispatch under OUT_RING — the feed ring, the TUI's own
#                                                          capture sink, cleared first — then gcmd_record seals what
#                                                          it printed as a CARD the feed draws where it was issued.
#   /quit                                               -> the window closes (returns 0), as the TUI's loop ends.
# /clear clears the cards (the GUI's scrollback) as it clears the TUI's feed. The authorization modal works under
# every bracket (confirm_no_tty routes it to gask), and with `/grants` reachable it offers the session grant again.
# Returns 1 to keep running, 0 to close.
fn _gpresent_submit(win) {
    var cls = classify_final(gcomp_cstr());
    if (cls == CMD_QUIT) { gcomp_reset(); return 0; }
    if ((cls == CMD_TASK) || (cls == CMD_RETRY) || (cls == CMD_EDIT)) {
        gturn_begin(gcomp_cstr());            # COPY the pending text (the composer is reset next)
        gcomp_reset();                        # clear the composer
        _gui_dirty = 1;
        if (gwl_win_ready(win) == 1) { _gpresent_frame(win); }   # show the working state if the compositor is ready
        gpump_reset();                        # 0.35.0: first streaming partial paints instantly
        out_mode_set(OUT_NULL);               # suppress the turn's progress output (no leak to the launch tty)
        if (cls == CMD_TASK) { cmd_task(gturn_text()); }          # runs the turn: the pump (intr_check hook) paints the partial live; appends user + reply
        else { dispatch(gturn_text()); }                          # /retry, /edit: the hub re-runs the turn through the same path
        out_mode_set(OUT_FD1);
        # honest outcome: a turn that appended no assistant reply (unreachable hoosh, transport/http
        # error, empty completion) leaves no fresh assistant as the last row -> the window renders only
        # history, so raise a transient "didn't complete" notice instead of silence. Detect via the
        # turn tag (gturn_reply_landed), correct even at the SESS_HIST_MAX cap where a net-growth check
        # false-fires on a successful turn (0.30.19).
        # 0.34.3: distinguish an Esc-INTERRUPT (intr flag set by the stop-poll) from a real
        # failure — a stopped turn with no partial gets a neutral "stopped" notice, not the
        # red "is hoosh reachable?" one.
        if (gturn_reply_landed() == 0) {
            if (intr_pending() == 1) { gturn_stop(); } else { gturn_fail(); }
        }
        gturn_end();                          # drop the provisional bubble; the feed now shows history (+ any notice)
        git_probe();                          # 0.50.1: the turn may have changed the worktree (an agentic edit / shell) — the strip's git field + the tree's badges, as the TUI re-probes after every line; until now only a slash command did
        return 1;
    }
    return gpresent_run_command(gcomp_cstr());
}

# gpresent_run_command (0.46.0): dispatch a slash line under capture and seal its output as a card. Split out so
# the suite can drive it without a window. Returns 1 to keep running, 0 when the hub said to quit.
fn gpresent_run_command(line) {
    var cls = classify_final(line);
    if (cls == CMD_CLEAR) { gcmd_clear(); gcomp_reset(); gscroll_reset(); return 1; }   # the window's scrollback IS the cards
    var keep = gcmd_run(line, &dispatch);     # the capture bracket (gcmd.cyr): the ring as the sink, sealed as a card
    gcomp_reset();
    gscroll_reset();                          # a fresh card is the newest thing: jump the feed to it
    git_probe();                              # the command may have changed the worktree (/run, /rewind) — the strip's git field
    _gui_dirty = 1;
    return keep;
}

fn gui_run() {
    if (gwl_win_open("thoth", 960, 600) == 0) {
        emit_err("thoth gui: no Wayland compositor available.\n");
        emit_err("  set WAYLAND_DISPLAY and run under a live display (Hyprland/wlroots, or aethersafha on AGNOS).\n");
        return 0 - 1;
    }
    # 0.38.1: the GUI DECLARES its own surface. Until now nothing in the GUI path ever called ui_force /
    # ui_detect_tier, so it silently inherited whatever tier+depth was detected about the LAUNCHING TERMINAL
    # — which is the wrong subject entirely: launched from a desktop launcher (no tty, no TERM) it landed on
    # T0 plain / no-color, and from a 256-color terminal on 256-color. That left `/theme rainbow` dead in the
    # GUI except by accident (when launched from a truecolor terminal), and made the status strip MISLABEL
    # its own surface as "T2 rich-tui" / "T0 plain" (SF_SURFACE reads ui_tier_name()).
    #
    # PT_DESKTOP + CD_TRUE is honest, not a fake: graster writes real 24-bit XRGB8888 into a wl_shm buffer,
    # so this window IS a truecolor surface no matter what tty spawned it. Safe on both counts: _ui_rgb never
    # consults tier/depth (which is why the GUI renders correctly today even at T0), and gui_run writes no
    # escape to fd 1 (its only stdout path is emit_err, and the turn runs under OUT_NULL; 0.50.1: the session
    # hooks run under the card bracket / OUT_NULL, and term_title_set returns at PT_DESKTOP).
    ui_force(PT_DESKTOP, CD_TRUE);
    var win = 1;
    ftree_load();                                        # populate the file-tree pane (0.30.5)
    git_probe();                                         # so the tree's git badges + the status git field have data
    ghist_bind();                                        # composer history recall ring (0.30.15) + [history].file/.size (0.50.1: bound HERE at last — main.cyr's bind sits after the `thoth gui` return)
    # 0.45.3: the greeting block's model (the framed status box beside the ibis) — built ONCE here, at this
    # front end's startup like the ask seam below, never per frame: it snapshots config + persona state and
    # takes the hoosh probe result (a silent GET, which also seeds the status strip's health dot). The frame
    # builder (_gfeed_greeting) only lays the stored model out on the current window.
    # 0.48.0 (F3): bind conversation resume ([session].file) for THIS front end too — main.cyr binds it for the
    # REPL/TUI after `thoth gui` has already returned, so until now the window neither loaded the store nor wrote
    # it (sess_persist_save is a no-op while _sess_path is unbound, and nothing on this path ever bound it): a
    # conversation and its thinking folds died with the process. (Its tool cards are still the roundlog's — a
    # resumed reply draws its fold, not its cards; that half is F4.) Before greet_build, so the greeting's session
    # row can say what was resumed. 0.50.1: the input-history bind above sits before it for the same reason — the
    # greeting's history row (both surfaces) reads the bind's outcome.
    sess_persist_init(config_session_file());
    var _gup = 0;
    if (hoosh_health_probe() == HOOSH_HEALTH_UP) { _gup = 1; }
    greet_build(_gup);
    gstop_set_win(win); intr_check_hook_set(&_gstop_poll);
    ask_hook_set(&gui_ask);                              # 0.44.0 (T4-1): claim the ask seam for THIS front end   # 0.34.3: route the interrupt seam to the GUI stop-poll so Esc aborts a turn
    # 0.44.3: this surface owns the screen — there is no terminal to prompt on and no cooked stdin anyone
    # is typing into, so the authorization confirm must go through the modal above. Declaring it here (at
    # THIS front end's startup, like the ask hook itself) rather than letting `confirm` infer it from
    # out_mode is what makes it correct in BOTH windows: the turn runs under OUT_NULL, command dispatch
    # under OUT_RING, and neither can do a read_line.
    confirm_no_tty_set(1);
    # ...and drop the TUI's confirm bracket. main.cyr registers it unconditionally (it cannot know which
    # front end will win); left in place, a confirm raised during a GUI command dispatch would run T2
    # painters over a terminal that has no alt screen up.
    confirm_hooks_set(0, 0);
    # 0.50.1: the operator's session_start hook, fired for THIS front end too — main.cyr fires it for the REPL/TUI
    # after `thoth gui` has already returned, so a configured [hooks].session_start never ran for the window
    # (pre_tool / post_tool did, inside its turns: the lifecycle was half-wired). After every seam is claimed and
    # the stores are bound, exactly where main.cyr fires it (after config, seams and the git probe; before any
    # turn), and BEFORE the first frame so the frame carries its card when it printed. Under the card bracket:
    # the report lands in the window, never on fd 1; a silent hook (the common notify-send) records nothing and
    # the greeting stays. A slow hook delays the window's first map for its duration (up to [hooks].timeout_ms) —
    # parity with the TUI, where nothing appears until the hook returns; a frozen already-mapped window that
    # ignores close for that long would be worse.
    gcmd_capture("[hook session_start]", &hooks_session_start);
    var pfd[8];
    _gpresent_frame(win);                                # first paint
    var running = 1;
    while (running == 1) {
        # poll with a THROB tick (0.30.11): wake every ~120ms even when idle so the owl eye can pulse. poll(2)
        # returns >0 when the wl fd has data (service events then), 0 on the timeout (advance the throb), <0 on
        # error. gwl_win_poll_events MUST be called only when the fd is readable (it does one read).
        var pr = _gpresent_poll_fd(&pfd, gwl_win_fd(win), 120);
        if (pr < 0) { running = 0; }
        else {
            if (pr > 0) {                                     # the wl fd is readable -> service compositor events
                var ev = gwl_win_poll_events(win);            # also clears frame-callback / buffer-release (gwl_win_ready)
                if ((ev & GWL_WIN_EV_CLOSE) != 0) { running = 0; }
                else {
                    if ((ev & GWL_WIN_EV_RESIZE) != 0) { gwl_win_resize_apply(win); _gui_dirty = 1; _gui_pending = 1; }
                    if ((ev & GWL_WIN_EV_KEY) != 0) {
                        var act = _gpresent_drain_keys(win);
                        if (act == 1) { running = 0; }                    # Esc -> quit
                        else {
                            if (act == 2) {                               # Enter -> submit the composer (a turn, or a slash command — 0.46.0)
                                if (gcomp_len() > 0) { if (_gpresent_submit(win) == 0) { running = 0; } }
                            }
                            _gui_dirty = 1; _gui_pending = 1;             # any key redraws the view
                        }
                    }
                    if ((ev & GWL_WIN_EV_POINTER) != 0) {                 # 0.49.0 (F4): clicks + wheel steps
                        if (_gui_dirty == 1) { _gpresent_drop_pointer(win); }   # the drawn frame is stale (a key / resize this batch) -> drop
                        elif (gpointer_pump(0) == 1) { _gui_dirty = 1; _gui_pending = 1; }
                    }
                }
            } else {                                          # timeout -> advance the throb phase
                geye_phase_advance();
                _gui_pending = 1;
            }
            # present a pending redraw ONLY when the compositor has released the buffer + acked the last frame —
            # else a continuous throb races the scanout and the surface glitches. The release/frame events that
            # flip gwl_win_ready arrive on the fd and are consumed by gwl_win_poll_events above.
            if ((running == 1) && (_gui_pending == 1) && (gwl_win_ready(win) == 1)) {
                _gpresent_frame(win);
                _gui_pending = 0;
            }
        }
    }
    intr_check_hook_set(0); gstop_set_win(0);            # 0.34.3: unregister the GUI stop-poll before teardown
    gwl_win_close(win);
    # 0.50.1: the session_end hook, after the surface is gone (main.cyr fires it after tui_loop's teardown).
    # Under OUT_NULL: the hook's stdout has no surface any more (a closed terminal's case), "could not run"
    # reaches stderr through note_*, and the one outcome that would otherwise be silent — a timeout — is named
    # on stderr here. Every exit path funnels here (poll error, the compositor's close, Esc, /quit); the
    # no-compositor return above fires neither hook, as session_start never fired.
    out_mode_set(OUT_NULL);
    var hrc = hooks_session_end();
    out_mode_set(OUT_FD1);
    if (hrc == (0 - 2)) { emit_err("thoth gui: [hook session_end] timed out\n"); }
    return 0;
}
