# src/gui/ginput.cyr — GUI keyboard input: evdev keycode → ASCII + a composer text buffer (T3, 0.30.2).
#
# The window's keyboard path (gwl_win_next_key delivers raw evdev {keycode, value, mods}). This maps a
# keycode + shift to a printable ASCII char (ported from jalwa's input.cyr / puka, US QWERTY), and holds the
# composer's typed text. PURE + headless-testable — the present loop (gpresent.cyr) feeds it real key records
# and reads `gcomp_cstr()` to render + submit. No display, no producer of its own.

# _ginput_letter: evdev keycode -> lowercase ASCII letter, or 0.
fn _ginput_letter(code) {
    if (code == 30) { return 0x61; } if (code == 48) { return 0x62; } if (code == 46) { return 0x63; }
    if (code == 32) { return 0x64; } if (code == 18) { return 0x65; } if (code == 33) { return 0x66; }
    if (code == 34) { return 0x67; } if (code == 35) { return 0x68; } if (code == 23) { return 0x69; }
    if (code == 36) { return 0x6A; } if (code == 37) { return 0x6B; } if (code == 38) { return 0x6C; }
    if (code == 50) { return 0x6D; } if (code == 49) { return 0x6E; } if (code == 24) { return 0x6F; }
    if (code == 25) { return 0x70; } if (code == 16) { return 0x71; } if (code == 19) { return 0x72; }
    if (code == 31) { return 0x73; } if (code == 20) { return 0x74; } if (code == 22) { return 0x75; }
    if (code == 47) { return 0x76; } if (code == 17) { return 0x77; } if (code == 45) { return 0x78; }
    if (code == 21) { return 0x79; } if (code == 44) { return 0x7A; }
    return 0;
}

# ginput_ascii: evdev keycode + shift -> a printable ASCII char (shift picks the upper glyph), or 0 for a
# non-printable / unmapped key. Ported from jalwa's evdev_ascii (US QWERTY).
fn ginput_ascii(code, shift) {
    var lo = _ginput_letter(code);
    if (lo != 0) { if (shift != 0) { return lo - 32; } return lo; }   # letters (shift -> upper)
    if (code == 2)  { if (shift != 0) { return 0x21; } return 0x31; }   # 1 !
    if (code == 3)  { if (shift != 0) { return 0x40; } return 0x32; }   # 2 @
    if (code == 4)  { if (shift != 0) { return 0x23; } return 0x33; }   # 3 #
    if (code == 5)  { if (shift != 0) { return 0x24; } return 0x34; }   # 4 $
    if (code == 6)  { if (shift != 0) { return 0x25; } return 0x35; }   # 5 %
    if (code == 7)  { if (shift != 0) { return 0x5E; } return 0x36; }   # 6 ^
    if (code == 8)  { if (shift != 0) { return 0x26; } return 0x37; }   # 7 &
    if (code == 9)  { if (shift != 0) { return 0x2A; } return 0x38; }   # 8 *
    if (code == 10) { if (shift != 0) { return 0x28; } return 0x39; }   # 9 (
    if (code == 11) { if (shift != 0) { return 0x29; } return 0x30; }   # 0 )
    if (code == 12) { if (shift != 0) { return 0x5F; } return 0x2D; }   # - _
    if (code == 13) { if (shift != 0) { return 0x2B; } return 0x3D; }   # = +
    if (code == 26) { if (shift != 0) { return 0x7B; } return 0x5B; }   # [ {
    if (code == 27) { if (shift != 0) { return 0x7D; } return 0x5D; }   # ] }
    if (code == 39) { if (shift != 0) { return 0x3A; } return 0x3B; }   # ; :
    if (code == 40) { if (shift != 0) { return 0x22; } return 0x27; }   # ' "
    if (code == 41) { if (shift != 0) { return 0x7E; } return 0x60; }   # ` ~
    if (code == 43) { if (shift != 0) { return 0x7C; } return 0x5C; }   # \ |
    if (code == 51) { if (shift != 0) { return 0x3C; } return 0x2C; }   # , <
    if (code == 52) { if (shift != 0) { return 0x3E; } return 0x2E; }   # . >
    if (code == 53) { if (shift != 0) { return 0x3F; } return 0x2F; }   # / ?
    if (code == 57) { return 0x20; }                                   # space
    return 0;
}

# --- the composer text buffer (what the user is typing) ---
var GCOMP_CAP = 4096;
var _gcomp_buf = 0;
var _gcomp_len = 0;

fn _gcomp_ensure() { if (_gcomp_buf == 0) { _gcomp_buf = alloc(GCOMP_CAP); } return 0; }
fn gcomp_reset() { _gcomp_len = 0; return 0; }
fn gcomp_append(ch) { _gcomp_ensure(); if (_gcomp_len < GCOMP_CAP - 1) { store8(_gcomp_buf + _gcomp_len, ch); _gcomp_len = _gcomp_len + 1; } return 0; }
fn gcomp_backspace() { if (_gcomp_len > 0) { _gcomp_len = _gcomp_len - 1; } return 0; }
fn gcomp_len() { return _gcomp_len; }
# gcomp_cstr: NUL-terminate the buffer and return it (stable until the next edit). Empty -> "".
fn gcomp_cstr() { _gcomp_ensure(); store8(_gcomp_buf + _gcomp_len, 0); return _gcomp_buf; }
# gcomp_set: REPLACE the composer content with len bytes from ptr (clamped to the cap). Used by history recall.
fn gcomp_set(ptr, len) {
    _gcomp_ensure();
    if (len > GCOMP_CAP - 1) { len = GCOMP_CAP - 1; }
    var i = 0;
    while (i < len) { store8(_gcomp_buf + i, load8(ptr + i)); i = i + 1; }
    _gcomp_len = len;
    return 0;
}

# gcomp_key: feed one evdev key record into the composer. Returns 0 = handled/typed, 1 = Esc (quit), 2 = Enter
# (submit). Backspace + printables mutate the buffer; the caller repaints and, on submit, runs the turn.
fn gcomp_key(code, shift) {
    if (code == 1) { return 1; }                          # Esc -> quit
    if ((code == 28) || (code == 96)) { return 2; }       # Enter / keypad Enter -> submit
    if (code == 14) { gcomp_backspace(); return 0; }      # Backspace
    var ch = ginput_ascii(code, shift);
    if (ch != 0) { gcomp_append(ch); }
    return 0;
}

# --- the pending-turn state (0.30.4): the just-submitted message, shown while the (blocking) turn runs ---
# The GUI runs a turn SYNCHRONOUSLY (cmd_task under OUT_NULL); the event loop can't animate during it (no
# threads on this substrate). So on submit the present loop paints ONE "working" frame BEFORE the blocking
# call — the just-sent message echoed as a provisional bubble + a "thoth is working" indicator, folded into the
# bottom-anchored feed so it stays visible. Honest: an immediate pending state, NOT an animated spinner.
# gturn_begin COPIES the text (the composer is reset before the turn runs, so gcomp_cstr() is no longer it).
var GTURN_CAP = 4096;
var _gturn_buf = 0;
var _gturn_active = 0;
var _gturn_failed = 0;    # the last turn appended no assistant reply -> surface an honest notice (transient)
var _gturn_stopped = 0;   # 0.34.3: the last turn was Esc-INTERRUPTED (not a failure) -> a neutral "stopped" notice
fn gturn_active() { return _gturn_active; }
fn gturn_failed() { return _gturn_failed; }
fn gturn_stopped() { return _gturn_stopped; }
fn gturn_text() { if (_gturn_buf == 0) { return ""; } return _gturn_buf; }
fn gturn_begin(text) {
    if (_gturn_buf == 0) { _gturn_buf = alloc(GTURN_CAP); }
    var i = 0;
    while ((load8(text + i) != 0) && (i < GTURN_CAP - 1)) { store8(_gturn_buf + i, load8(text + i)); i = i + 1; }
    store8(_gturn_buf + i, 0);
    _gturn_active = 1;
    _gturn_failed = 0;    # a new submit clears any prior failure/stopped notice
    _gturn_stopped = 0;
    intr_reset();         # 0.34.3: clean interrupt flag before the turn, so the post-turn stop-vs-fail decision
                          # reads ONLY this turn's Esc (never a stale flag) even on a path that skips agent_turn's reset
    return 0;
}
fn gturn_end() { _gturn_active = 0; return 0; }
# gturn_fail: the just-run turn produced no assistant reply (unreachable hoosh, transport/http error, empty
# completion). The window renders only session_history, so error chrome never reaches it — this transient flag
# lets the feed show an honest "didn't complete" notice instead of silently swallowing the message.
fn gturn_fail() { _gturn_failed = 1; return 0; }
# gturn_stop (0.34.3): the just-run turn was Esc-INTERRUPTED with no partial reply kept — a neutral "stopped" notice
# (not the alarming "is hoosh reachable?" failure one). If a partial WAS streamed it became the reply, so no notice.
fn gturn_stop() { _gturn_stopped = 1; return 0; }

# gturn_reply_landed: did the just-run turn leave a fresh assistant reply? True iff the LAST history row is an
# assistant tagged with the CURRENT turn (0.30.19). This replaces gpresent's old net-growth check
# (`session_history_len() <= _n0`), which FALSE-FIRED at the SESS_HIST_MAX cap: once history is full, each append
# evicts the oldest so the length is pinned, and a genuinely successful turn read as "failed" — surfacing a bogus
# "didn't complete" notice AND (since 0.30.19 cards per turn) a duplicate current-turn card. The turn tag is
# length-independent, so it is correct at the cap. Pure over session state — unit-tested.
fn gturn_reply_landed() {
    var n = session_history_len();
    if (n == 0) { return 0; }
    if (streq(session_history_role(n - 1), "assistant") == 0) { return 0; }
    if (session_history_turn(n - 1) != session_turns()) { return 0; }
    return 1;
}

# --- focus + file-tree keyboard nav (0.30.10) ---------------------------------------------------------------
# The window has two focus targets, like the TUI: the COMPOSER (type + Enter runs a turn) and the file-TREE pane
# (navigate with the arrows). Tab toggles between them; when the tree is focused, ↑/↓ move the selection, →/←
# (and Enter on a dir) expand/collapse, and any printable key hands focus back to the composer and types it.
# Evdev keycodes: up=103, down=108, left=105, right=106, Tab=15, Enter=28. PURE + headless-testable; the present
# loop (gpresent.cyr) feeds real key records through gkey and reads gfocus() to draw the active pane.
var GFOCUS_COMPOSER = 0;
var GFOCUS_TREE = 1;
var GFOCUS_CONV = 2;                 # 0.33.6: the conversation sidebar
var _gfocus = 0;
fn gfocus() { return _gfocus; }
fn gfocus_set(f) { _gfocus = f; return 0; }

# --- pane visibility toggles (0.32.x) — hide/show the file-tree pane + the status strip -----------------------
# Two control chords toggle the two chrome panes, giving the conversation feed the whole window when wanted.
# Keybindings are PROVISIONAL — Ctrl+B (files) / Ctrl+S (status) mirror the TUI's Ctrl-B, but the cross-platform
# modifier chord may change (macOS/Windows conventions differ), so the mapping lives in ONE place (gkey below).
# State here (before gfeed.cyr in the include order) so gkey toggles it and gframe_build reads it for layout.
# PURE + headless-testable. Default: both visible (the pre-0.32 layout, byte-identical).
var _gtree_hidden = 0;
var _gstatus_hidden = 0;
fn gtree_hidden() { return _gtree_hidden; }
fn gstatus_hidden() { return _gstatus_hidden; }
fn gtree_toggle_hidden() {
    if (_gtree_hidden == 1) { _gtree_hidden = 0; }
    else { _gtree_hidden = 1; if (_gfocus == GFOCUS_TREE) { _gfocus = GFOCUS_COMPOSER; } }   # never leave focus on a hidden pane
    return 0;
}
fn gstatus_toggle_hidden() { if (_gstatus_hidden == 1) { _gstatus_hidden = 0; } else { _gstatus_hidden = 1; } return 0; }

# --- conversation sidebar (0.33.6) — a left pane over the conv_* store, keyboard-driven ----------------------
# Hidden by DEFAULT (the store is one conversation until /new; the pre-0.33.6 layout stays byte-identical). A Ctrl
# chord reveals it; ↑/↓ move the selection, Enter switches (conv_switch + reset the feed scroll so the switched
# conversation shows from its newest). Revealing preselects the active conversation. State here (before gconv.cyr /
# gfeed.cyr in convention), PURE + headless-testable.
var _gconv_hidden = 1;
var _gconv_sel = 0;
fn gconv_hidden() { return _gconv_hidden; }
fn gconv_sel() { return _gconv_sel; }
fn gconv_sel_clamp() {
    if (_gconv_sel < 0) { _gconv_sel = 0; }
    if (_gconv_sel >= conv_count()) { _gconv_sel = conv_count() - 1; }
    if (_gconv_sel < 0) { _gconv_sel = 0; }              # empty-store floor
    return 0;
}
fn gconv_sel_move(d) { _gconv_sel = _gconv_sel + d; gconv_sel_clamp(); return 0; }
fn gconv_toggle_hidden() {
    if (_gconv_hidden == 1) { _gconv_hidden = 0; _gconv_sel = conv_active(); gconv_sel_clamp(); }   # reveal -> preselect active
    else { _gconv_hidden = 1; if (_gfocus == GFOCUS_CONV) { _gfocus = GFOCUS_COMPOSER; } }           # never leave focus on a hidden pane
    return 0;
}
# gconv_key: handle one evdev key while the sidebar is focused. ↑/↓ move the selection; Enter switches to it and
# hands focus back to the composer. Returns 0.
fn gconv_key(code, shift) {
    if (code == 103) { gconv_sel_move(0 - 1); return 0; }    # up
    if (code == 108) { gconv_sel_move(1); return 0; }         # down
    if ((code == 28) || (code == 96)) {                       # Enter -> switch to the selected conversation
        gconv_sel_clamp();
        conv_switch(gconv_sel());
        gscroll_reset();                                      # show the switched conversation from its newest message
        _gfocus = GFOCUS_COMPOSER;
        return 0;
    }
    return 0;
}
# _gtree_focusable / _gconv_focusable: a pane can take focus only when it is VISIBLE and has content.
fn _gtree_focusable() { if ((ftree_count() > 0) && (gtree_hidden() == 0)) { return 1; } return 0; }
fn _gconv_focusable() { if ((conv_count() > 0) && (gconv_hidden() == 0)) { return 1; } return 0; }
# _gfocus_next: Tab cycles COMPOSER -> TREE -> CONV -> COMPOSER, skipping any pane that is hidden or empty.
fn _gfocus_next() {
    if (_gfocus == GFOCUS_COMPOSER) {
        if (_gtree_focusable() == 1) { return GFOCUS_TREE; }
        if (_gconv_focusable() == 1) { return GFOCUS_CONV; }
        return GFOCUS_COMPOSER;
    }
    if (_gfocus == GFOCUS_TREE) {
        if (_gconv_focusable() == 1) { return GFOCUS_CONV; }
        return GFOCUS_COMPOSER;
    }
    return GFOCUS_COMPOSER;                                   # from CONV -> back to the composer
}

# --- conversation-feed scrollback (0.30.14) -----------------------------------------------------------------
# The feed bottom-anchors to the newest message (0.30.3); after a long chat, older messages clip off the top.
# PgUp/PgDn page through them (End jumps back to the latest). State lives here (before gfeed.cyr in the include
# order, so gkey can drive it and gfeed_build can read it). `_gscroll` = px scrolled UP from the bottom (0 =
# newest visible); gfeed_build sets `_gscroll_view_h` (the feed height) + clamps `_gscroll` to the overflow each
# frame. A submitted turn resets to the bottom so the reply is seen.
var _gscroll = 0;
var _gscroll_view_h = 0;
fn gscroll() { return _gscroll; }
fn gscroll_reset() { _gscroll = 0; return 0; }
fn gscroll_by(d) { _gscroll = _gscroll + d; if (_gscroll < 0) { _gscroll = 0; } return 0; }
fn gscroll_view_h_set(hh) { _gscroll_view_h = hh; return 0; }
fn gscroll_clamp(maxv) { if (_gscroll > maxv) { _gscroll = maxv; } if (_gscroll < 0) { _gscroll = 0; } return 0; }
# a page = the feed height less one line of overlap (fallback when not yet rendered). dir +1 = older, -1 = newer.
fn gscroll_page(dir) { var p = _gscroll_view_h - 20; if (p < 60) { p = 60; } gscroll_by(dir * p); return 0; }

# --- composer history recall (0.30.15) --------------------------------------------------------------------
# Up/Down over the inhist ring (the SAME ring + optional [history].file the TUI uses), mirroring _tui_recall_key:
# Up stashes the live draft on the first step then walks OLDER; Down walks NEWER and restores the draft past the
# newest. gcomp_set swaps the composer content; a submitted turn pushes the text + resets the cursor (in gkey).
var GHIST_DRAFT_CAP = 4096;
var _ghist_draft = 0;
var _ghist_draft_len = 0;
fn _ghist_stash_draft() {
    if (_ghist_draft == 0) { _ghist_draft = alloc(GHIST_DRAFT_CAP); }
    var s = gcomp_cstr();
    var n = gcomp_len();
    if (n > GHIST_DRAFT_CAP - 1) { n = GHIST_DRAFT_CAP - 1; }
    var i = 0;
    while (i < n) { store8(_ghist_draft + i, load8(s + i)); i = i + 1; }
    _ghist_draft_len = n;
    return 0;
}
fn _ghist_restore_draft() { if (_ghist_draft != 0) { gcomp_set(_ghist_draft, _ghist_draft_len); } else { gcomp_reset(); } return 0; }
fn ghist_up() {
    if (inhist_count() == 0) { return 0; }                          # nothing to recall
    if (inhist_nav_at_draft() == 1) { _ghist_stash_draft(); }       # snapshot the live draft on the first step
    var idx = inhist_nav_up();
    if (idx >= 0) { gcomp_set(inhist_entry_ptr(idx), inhist_entry_len(idx)); }
    return 0;
}
fn ghist_down() {
    if (inhist_nav_at_draft() == 1) { return 0; }                   # already editing the live draft
    var d = inhist_nav_down();
    if (d < 0) { _ghist_restore_draft(); } else { gcomp_set(inhist_entry_ptr(d), inhist_entry_len(d)); }
    return 0;
}
# ghist_record: push a submitted line into the ring + snap the cursor back to the draft (called on submit).
fn ghist_record(ptr, len) { if (len > 0) { inhist_push(ptr, len); } inhist_nav_reset(); return 0; }

# gtree_mention: append `@<repo-relative path> ` for tree node li into the composer — rides the 0.21.0 @mention
# machinery (cmd_task expands `@path` to that file's content). The path is the absolute ftree_path minus the cwd
# prefix, exactly the derivation the git-badge lookup uses. Reused scratch buffer (no per-call heap).
var _gtree_mention_buf = 0;
fn gtree_mention(li) {
    if (_gtree_mention_buf == 0) { _gtree_mention_buf = alloc(4096); }
    ftree_path(li, _gtree_mention_buf, 4096);
    var skip = strlen(ftree_cwd());
    if (load8(_gtree_mention_buf + skip) == 47) { skip = skip + 1; }   # past the '/' after the cwd
    gcomp_append(0x40);                                                # '@'
    var i = skip;
    while (load8(_gtree_mention_buf + i) != 0) { gcomp_append(load8(_gtree_mention_buf + i)); i = i + 1; }
    gcomp_append(0x20);                                                # a trailing space
    return 0;
}

# gtree_key: handle one evdev key while the tree is focused. Moves/expands/collapses the ftree model, or on Enter
# over a FILE drops an @mention into the composer + hands focus back. Returns 0.
fn gtree_key(code, shift) {
    if (code == 103) { ftree_move(0 - 1); return 0; }        # up
    if (code == 108) { ftree_move(1); return 0; }             # down
    if (code == 106) { ftree_expand(); return 0; }            # right -> expand a collapsed dir
    if (code == 105) { ftree_collapse(); return 0; }          # left  -> collapse an expanded dir
    if ((code == 28) || (code == 96)) {                       # Enter
        var s = ftree_sel();
        if (ftree_isdir(s) == 1) {                            # a DIR toggles expand/collapse
            if (ftree_exp(s) == 1) { ftree_collapse(); } else { ftree_expand(); }
        } else {                                              # a FILE -> @mention it in the composer, focus there
            gtree_mention(s);
            _gfocus = GFOCUS_COMPOSER;
        }
        return 0;
    }
    return 0;
}

# gkey: the top-level focus-aware GUI key dispatch (replaces gcomp_key as the present loop's entry). Returns
# 0 = handled/repaint, 1 = Esc (quit), 2 = Enter (submit the composer turn). Tab toggles focus (only to the tree
# when it has rows); Esc quits from any focus. Tree-focused: a printable key returns to the composer + types it,
# else it navigates the tree. Composer-focused: delegate to gcomp_key.
fn gkey(code, shift, ctrl) {
    if (code == 1) { return 1; }                              # Esc -> quit (any focus)
    # control chords (0.32.x) — PROVISIONAL bindings; see the visibility-toggle note above. Handled BEFORE the
    # composer/tree dispatch so the chord never types its letter. Ctrl+B/S toggle the panes; any OTHER Ctrl+<char>
    # is swallowed (an unbound chord must not inject text), while Ctrl+<non-printable> (arrows/PageUp/Tab) falls
    # through to normal handling.
    if (ctrl == 1) {
        if (code == 48) { gtree_toggle_hidden(); return 0; }     # Ctrl+B -> toggle the file-tree pane
        if (code == 31) { gstatus_toggle_hidden(); return 0; }   # Ctrl+S -> toggle the status strip
        if (code == 37) { gconv_toggle_hidden(); return 0; }     # Ctrl+K -> toggle the conversation sidebar (0.33.6)
        if (ginput_ascii(code, shift) != 0) { return 0; }        # swallow other Ctrl+<printable>
    }
    if (code == 104) { gscroll_page(1); return 0; }           # PageUp   -> scroll the feed to OLDER messages
    if (code == 109) { gscroll_page(0 - 1); return 0; }       # PageDown -> scroll toward newer
    if (code == 107) { gscroll_reset(); return 0; }           # End      -> jump back to the latest
    if (code == 15) {                                         # Tab -> cycle composer -> tree -> conv (visible panes)
        _gfocus = _gfocus_next();
        return 0;
    }
    if (_gfocus == GFOCUS_TREE) {
        if (ginput_ascii(code, shift) != 0) { _gfocus = GFOCUS_COMPOSER; return gcomp_key(code, shift); }
        return gtree_key(code, shift);
    }
    if (_gfocus == GFOCUS_CONV) {                             # 0.33.6: conversation sidebar nav
        if (ginput_ascii(code, shift) != 0) { _gfocus = GFOCUS_COMPOSER; return gcomp_key(code, shift); }
        return gconv_key(code, shift);
    }
    if (code == 103) { ghist_up(); return 0; }                # composer Up   -> recall an OLDER submission
    if (code == 108) { ghist_down(); return 0; }              # composer Down -> NEWER / back to the live draft
    var a = gcomp_key(code, shift);
    if (a == 2) { ghist_record(gcomp_cstr(), gcomp_len()); gscroll_reset(); }   # record the submission; snap to the latest
    return a;
}
