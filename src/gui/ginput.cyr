# src/gui/ginput.cyr — GUI keyboard input: evdev keycode → ASCII + a composer text buffer (T3, 0.30.2).
#
# The window's keyboard path (gwl_win_next_key delivers raw evdev {keycode, value, mods}). This maps a
# keycode + shift to a printable ASCII char (ported from jalwa's input.cyr / puka, US QWERTY), and holds the
# composer's typed text. PURE + headless-testable — the present loop (gpresent.cyr) feeds it real key records
# and reads `gcomp_cstr()` to render + submit. No display, no producer of its own.

# _ginput_letter: evdev keycode -> lowercase ASCII letter, or 0.
fn _ginput_letter(code) {
    if (code == 30) { return 0x61; } if (code == 48) { return 0x62; } if (code == 46) { return 0x63; }
    if (code == 32) { return 0x64; } if (code == 18) { return 0x65; } if (code == 33) { return 0x66; }
    if (code == 34) { return 0x67; } if (code == 35) { return 0x68; } if (code == 23) { return 0x69; }
    if (code == 36) { return 0x6A; } if (code == 37) { return 0x6B; } if (code == 38) { return 0x6C; }
    if (code == 50) { return 0x6D; } if (code == 49) { return 0x6E; } if (code == 24) { return 0x6F; }
    if (code == 25) { return 0x70; } if (code == 16) { return 0x71; } if (code == 19) { return 0x72; }
    if (code == 31) { return 0x73; } if (code == 20) { return 0x74; } if (code == 22) { return 0x75; }
    if (code == 47) { return 0x76; } if (code == 17) { return 0x77; } if (code == 45) { return 0x78; }
    if (code == 21) { return 0x79; } if (code == 44) { return 0x7A; }
    return 0;
}

# ginput_ascii: evdev keycode + shift -> a printable ASCII char (shift picks the upper glyph), or 0 for a
# non-printable / unmapped key. Ported from jalwa's evdev_ascii (US QWERTY).
fn ginput_ascii(code, shift) {
    var lo = _ginput_letter(code);
    if (lo != 0) { if (shift != 0) { return lo - 32; } return lo; }   # letters (shift -> upper)
    if (code == 2)  { if (shift != 0) { return 0x21; } return 0x31; }   # 1 !
    if (code == 3)  { if (shift != 0) { return 0x40; } return 0x32; }   # 2 @
    if (code == 4)  { if (shift != 0) { return 0x23; } return 0x33; }   # 3 #
    if (code == 5)  { if (shift != 0) { return 0x24; } return 0x34; }   # 4 $
    if (code == 6)  { if (shift != 0) { return 0x25; } return 0x35; }   # 5 %
    if (code == 7)  { if (shift != 0) { return 0x5E; } return 0x36; }   # 6 ^
    if (code == 8)  { if (shift != 0) { return 0x26; } return 0x37; }   # 7 &
    if (code == 9)  { if (shift != 0) { return 0x2A; } return 0x38; }   # 8 *
    if (code == 10) { if (shift != 0) { return 0x28; } return 0x39; }   # 9 (
    if (code == 11) { if (shift != 0) { return 0x29; } return 0x30; }   # 0 )
    if (code == 12) { if (shift != 0) { return 0x5F; } return 0x2D; }   # - _
    if (code == 13) { if (shift != 0) { return 0x2B; } return 0x3D; }   # = +
    if (code == 26) { if (shift != 0) { return 0x7B; } return 0x5B; }   # [ {
    if (code == 27) { if (shift != 0) { return 0x7D; } return 0x5D; }   # ] }
    if (code == 39) { if (shift != 0) { return 0x3A; } return 0x3B; }   # ; :
    if (code == 40) { if (shift != 0) { return 0x22; } return 0x27; }   # ' "
    if (code == 41) { if (shift != 0) { return 0x7E; } return 0x60; }   # ` ~
    if (code == 43) { if (shift != 0) { return 0x7C; } return 0x5C; }   # \ |
    if (code == 51) { if (shift != 0) { return 0x3C; } return 0x2C; }   # , <
    if (code == 52) { if (shift != 0) { return 0x3E; } return 0x2E; }   # . >
    if (code == 53) { if (shift != 0) { return 0x3F; } return 0x2F; }   # / ?
    if (code == 57) { return 0x20; }                                   # space
    return 0;
}

# --- the composer text buffer (what the user is typing) ---
var GCOMP_CAP = 4096;
var _gcomp_buf = 0;
var _gcomp_len = 0;

fn _gcomp_ensure() { if (_gcomp_buf == 0) { _gcomp_buf = alloc(GCOMP_CAP); } return 0; }
fn gcomp_reset() { _gcomp_len = 0; return 0; }
fn gcomp_append(ch) { _gcomp_ensure(); if (_gcomp_len < GCOMP_CAP - 1) { store8(_gcomp_buf + _gcomp_len, ch); _gcomp_len = _gcomp_len + 1; } return 0; }
fn gcomp_backspace() { if (_gcomp_len > 0) { _gcomp_len = _gcomp_len - 1; } return 0; }
fn gcomp_len() { return _gcomp_len; }
# gcomp_cstr: NUL-terminate the buffer and return it (stable until the next edit). Empty -> "".
fn gcomp_cstr() { _gcomp_ensure(); store8(_gcomp_buf + _gcomp_len, 0); return _gcomp_buf; }

# gcomp_key: feed one evdev key record into the composer. Returns 0 = handled/typed, 1 = Esc (quit), 2 = Enter
# (submit). Backspace + printables mutate the buffer; the caller repaints and, on submit, runs the turn.
fn gcomp_key(code, shift) {
    if (code == 1) { return 1; }                          # Esc -> quit
    if ((code == 28) || (code == 96)) { return 2; }       # Enter / keypad Enter -> submit
    if (code == 14) { gcomp_backspace(); return 0; }      # Backspace
    var ch = ginput_ascii(code, shift);
    if (ch != 0) { gcomp_append(ch); }
    return 0;
}

# --- the pending-turn state (0.30.4): the just-submitted message, shown while the (blocking) turn runs ---
# The GUI runs a turn SYNCHRONOUSLY (cmd_task under OUT_NULL); the event loop can't animate during it (no
# threads on this substrate). So on submit the present loop paints ONE "working" frame BEFORE the blocking
# call — the just-sent message echoed as a provisional bubble + a "thoth is working" indicator, folded into the
# bottom-anchored feed so it stays visible. Honest: an immediate pending state, NOT an animated spinner.
# gturn_begin COPIES the text (the composer is reset before the turn runs, so gcomp_cstr() is no longer it).
var GTURN_CAP = 4096;
var _gturn_buf = 0;
var _gturn_active = 0;
var _gturn_failed = 0;    # the last turn appended no assistant reply -> surface an honest notice (transient)
fn gturn_active() { return _gturn_active; }
fn gturn_failed() { return _gturn_failed; }
fn gturn_text() { if (_gturn_buf == 0) { return ""; } return _gturn_buf; }
fn gturn_begin(text) {
    if (_gturn_buf == 0) { _gturn_buf = alloc(GTURN_CAP); }
    var i = 0;
    while ((load8(text + i) != 0) && (i < GTURN_CAP - 1)) { store8(_gturn_buf + i, load8(text + i)); i = i + 1; }
    store8(_gturn_buf + i, 0);
    _gturn_active = 1;
    _gturn_failed = 0;    # a new submit clears any prior failure notice
    return 0;
}
fn gturn_end() { _gturn_active = 0; return 0; }
# gturn_fail: the just-run turn produced no assistant reply (unreachable hoosh, transport/http error, empty
# completion). The window renders only session_history, so error chrome never reaches it — this transient flag
# lets the feed show an honest "didn't complete" notice instead of silently swallowing the message.
fn gturn_fail() { _gturn_failed = 1; return 0; }

# --- focus + file-tree keyboard nav (0.30.10) ---------------------------------------------------------------
# The window has two focus targets, like the TUI: the COMPOSER (type + Enter runs a turn) and the file-TREE pane
# (navigate with the arrows). Tab toggles between them; when the tree is focused, ↑/↓ move the selection, →/←
# (and Enter on a dir) expand/collapse, and any printable key hands focus back to the composer and types it.
# Evdev keycodes: up=103, down=108, left=105, right=106, Tab=15, Enter=28. PURE + headless-testable; the present
# loop (gpresent.cyr) feeds real key records through gkey and reads gfocus() to draw the active pane.
var GFOCUS_COMPOSER = 0;
var GFOCUS_TREE = 1;
var _gfocus = 0;
fn gfocus() { return _gfocus; }
fn gfocus_set(f) { _gfocus = f; return 0; }

# gtree_key: handle one evdev key while the tree is focused. Moves/expands/collapses the ftree model. Returns 0.
fn gtree_key(code, shift) {
    if (code == 103) { ftree_move(0 - 1); return 0; }        # up
    if (code == 108) { ftree_move(1); return 0; }             # down
    if (code == 106) { ftree_expand(); return 0; }            # right -> expand a collapsed dir
    if (code == 105) { ftree_collapse(); return 0; }          # left  -> collapse an expanded dir
    if ((code == 28) || (code == 96)) {                       # Enter -> toggle the selected dir
        var s = ftree_sel();
        if (ftree_isdir(s) == 1) {
            if (ftree_exp(s) == 1) { ftree_collapse(); } else { ftree_expand(); }
        }
        return 0;
    }
    return 0;
}

# gkey: the top-level focus-aware GUI key dispatch (replaces gcomp_key as the present loop's entry). Returns
# 0 = handled/repaint, 1 = Esc (quit), 2 = Enter (submit the composer turn). Tab toggles focus (only to the tree
# when it has rows); Esc quits from any focus. Tree-focused: a printable key returns to the composer + types it,
# else it navigates the tree. Composer-focused: delegate to gcomp_key.
fn gkey(code, shift) {
    if (code == 1) { return 1; }                              # Esc -> quit (any focus)
    if (code == 15) {                                         # Tab -> toggle composer <-> tree
        if (_gfocus == GFOCUS_TREE) { _gfocus = GFOCUS_COMPOSER; }
        elif (ftree_count() > 0) { _gfocus = GFOCUS_TREE; }   # only focus a populated tree
        return 0;
    }
    if (_gfocus == GFOCUS_TREE) {
        if (ginput_ascii(code, shift) != 0) { _gfocus = GFOCUS_COMPOSER; return gcomp_key(code, shift); }
        return gtree_key(code, shift);
    }
    return gcomp_key(code, shift);
}
