# src/gui/gfeed.cyr — the GUI conversation-feed view-builder (T3, 0.30.1).
#
# Renders the conversation (session_history_*) as word-wrapped messages in the window body — the mockup's
# (Thoth.dc.html) main region. A user message gets a `>` accent marker + its text; an agent message is plain
# body text; each wraps to the available pixel width. When there is no conversation yet, an honest greeting
# empty-state (the app's opening screen, never a faked exchange). PURE: builds draw-commands over the tested
# pipeline (gdraw + graster's codepoint-accurate text); no display, no producer of its own — it reads the
# SAME session_history the TUI feed + `/save` read. Headless-testable (build → raster → assert / PPM).

var GFEED_LH   = 20;   # line height (px) for wrapped body text
var GFEED_GAP  = 12;   # px between messages
var GFEED_PAD  = 14;   # left inset

# _gfeed_para: draw `text` word-wrapped into an `avail_px`-wide column at (x,y), line height GFEED_LH.
# Breaks at spaces (hard-breaks a word longer than the column). Draws each wrapped line as a (start,cols)
# slice via gd_push_text's max_cp cap — NO per-line copy. Codepoint-accurate (uses the graster decoder), so
# the wrap column matches the rendered width for non-ASCII too. Returns the y AFTER the last line.
# cmds == 0 => MEASURE ONLY: the wrap math runs identically but nothing is emitted, so the returned height is
# byte-for-byte the height the draw pass produces (the bottom-anchor pre-measure relies on this parity).
fn _gfeed_para(cmds, x, y, avail_px, color, text) {
    if (text == 0) { return y; }
    var maxcols = avail_px / GR_GLYPH_W;
    if (maxcols < 1) { maxcols = 1; }
    var i = 0;                  # byte scan offset
    var line_start = 0;         # byte offset where the current line begins
    var cols = 0;               # codepoints on the current line (incl. the last-processed one)
    var last_sp_byte = 0 - 1;   # byte offset of the last space seen on this line
    var last_sp_cols = 0;       # codepoints before that space
    var cy = y;
    var done = 0;
    while (done == 0) {
        if (load8(text + i) == 0) { done = 1; }
        else {
            var packed = gr__utf8_at(text, i);
            var cp = packed / 8;
            var nb = packed % 8;
            if (cp == 32) { last_sp_byte = i; last_sp_cols = cols; }   # cols = count BEFORE this space
            cols = cols + 1;
            i = i + nb;
            if (cols > maxcols) {
                if (last_sp_byte >= line_start) {
                    # skip an empty leading-space segment: last_sp_cols == 0 would pass max_cp 0 == UNCAPPED to
                    # gr_fb_text and draw the whole string on this line. Nothing to draw before the space anyway.
                    if ((cmds != 0) && (last_sp_cols > 0)) { gd_push_text(cmds, x, cy, color, text + line_start, last_sp_cols); }   # words before the space
                    cy = cy + GFEED_LH;
                    line_start = last_sp_byte + 1;                # new line begins after the space (1 byte)
                    cols = cols - last_sp_cols - 1;               # codepoints carried to the new line
                    last_sp_byte = 0 - 1;
                } else {
                    if (cmds != 0) { gd_push_text(cmds, x, cy, color, text + line_start, cols - 1); }   # hard-break a long word
                    cy = cy + GFEED_LH;
                    line_start = i - nb;                          # new line begins at the current cp
                    cols = 1;
                    last_sp_byte = 0 - 1;
                }
            }
        }
    }
    if (cols > 0) { if (cmds != 0) { gd_push_text(cmds, x, cy, color, text + line_start, cols); } cy = cy + GFEED_LH; }
    return cy;
}

# --- 0.36.0: GUI structural-markdown leaf (lowers the src/mdmodel.cyr model) --------------------------------------
# The GUI runs under OUT_NULL, so mdhl (the line/TUI markdown engine) never reaches the window — the feed re-renders
# session_history/_hoosh_acc as PLAIN paragraphs (_gfeed_para). This leaf gives GUI assistant replies structure:
# it walks the reply line-by-line, classifies each via the shared model, and draws blocks with color + layout.
# Emphasis is COLOR not weight (the GUI font is a single fixed 8px monospace cell): bold -> ROLE_FG (brighter than
# the MUTED body), inline-code -> ROLE_BLUE, headings -> ROLE_ACCENT, list markers -> ROLE_ACCENT, fenced code ->
# a ROLE_BLUE monospace block on a subtle background. Deterministic + reads only the passed text -> measure==draw.

# _md_role_color: map an inline role (from the model) to a packed RGB, given the block's base role for plain text.
fn _md_role_color(role, base_role) {
    if (role == MDI_BOLD) { return _ui_rgb(ROLE_FG); }     # no bold font -> brightness conveys emphasis
    if (role == MDI_CODE) { return _ui_rgb(ROLE_BLUE); }
    return _ui_rgb(base_role);
}

# _md_code_bg: a subtle theme-aware background for fenced-code lines (a touch off the frame bg, _gframe_bg).
fn _md_code_bg() { if (ui_theme() == THEME_LIGHT) { return 0xe9e3d4; } return 0x211d15; }

# _md_cp_count: codepoints in base[ls..le) (fixed-cell columns == codepoints). nb<1 guarded against a stuck loop.
fn _md_cp_count(base, ls, le) {
    var i = ls; var n = 0;
    while (i < le) { var packed = gr__utf8_at(base, i); var nb = packed % 8; if (nb < 1) { nb = 1; } i = i + nb; n = n + 1; }
    return n;
}

# _gfeed_md_draw: draw the physical wrapped line base[ls..le) at (x, cy) as colored segments — one gd_push_text per
# contiguous same-role run (role from md_role_at over the last md_inline_scan). Only called when cmds != 0.
fn _gfeed_md_draw(cmds, x, cy, base, ls, le, base_role) {
    var i = ls; var col = 0;
    var seg_start = ls; var seg_col = 0; var seg_cps = 0;
    var seg_role = md_role_at(ls);
    while (i < le) {
        var r = md_role_at(i);
        if (r != seg_role) {
            if (seg_cps > 0) { gd_push_text(cmds, x + seg_col * GR_GLYPH_W, cy, _md_role_color(seg_role, base_role), base + seg_start, seg_cps); }
            seg_start = i; seg_col = col; seg_cps = 0; seg_role = r;
        }
        var packed = gr__utf8_at(base, i); var nb = packed % 8; if (nb < 1) { nb = 1; }
        i = i + nb; col = col + 1; seg_cps = seg_cps + 1;
    }
    if (seg_cps > 0) { gd_push_text(cmds, x + seg_col * GR_GLYPH_W, cy, _md_role_color(seg_role, base_role), base + seg_start, seg_cps); }
    return 0;
}

# _gfeed_md_wrap: styled word-wrap of the content slice base[0..len) into an avail-wide column at (x, cy). Same
# codepoint/space-break/hard-break math as _gfeed_para, but each physical line is drawn via _gfeed_md_draw so inline
# bold/code spans switch color mid-line. Runs the inline scan once up front. Returns the y below (cy unchanged for
# empty content; the block renderers floor that to one row). measure (cmds==0) == draw: the break math ignores cmds.
fn _gfeed_md_wrap(cmds, x, cy, avail, base, len, base_role) {
    md_inline_scan(base, len);
    var maxcols = avail / GR_GLYPH_W;
    if (maxcols < 1) { maxcols = 1; }
    var i = 0;
    var line_start = 0;
    var cols = 0;
    var last_sp_byte = 0 - 1;
    var last_sp_cols = 0;
    var done = 0;
    while (done == 0) {
        if (i >= len) { done = 1; }
        else {
            var packed = gr__utf8_at(base, i);
            var cp = packed / 8;
            var nb = packed % 8;
            if (nb < 1) { nb = 1; }
            if (cp == 32) { last_sp_byte = i; last_sp_cols = cols; }
            cols = cols + 1;
            i = i + nb;
            if (cols > maxcols) {
                if (last_sp_byte >= line_start) {
                    if ((cmds != 0) && (last_sp_cols > 0)) { _gfeed_md_draw(cmds, x, cy, base, line_start, last_sp_byte, base_role); }
                    cy = cy + GFEED_LH;
                    line_start = last_sp_byte + 1;
                    cols = cols - last_sp_cols - 1;
                    last_sp_byte = 0 - 1;
                } else {
                    if (cmds != 0) { _gfeed_md_draw(cmds, x, cy, base, line_start, i - nb, base_role); }
                    cy = cy + GFEED_LH;
                    line_start = i - nb;
                    cols = 1;
                    last_sp_byte = 0 - 1;
                }
            }
        }
    }
    if (cols > 0) { if (cmds != 0) { _gfeed_md_draw(cmds, x, cy, base, line_start, len, base_role); } cy = cy + GFEED_LH; }
    return cy;
}

# _gfeed_md_code_line: one fenced-code interior line — a full-width subtle background + the code in ROLE_BLUE
# monospace, slightly inset, un-wrapped (long lines clip to the feed region). No per-token highlight yet (0.36.x).
fn _gfeed_md_code_line(cmds, x, cy, avail, base, len) {
    if (cmds != 0) {
        gd_push_rect(cmds, x, cy, avail, GFEED_LH, _md_code_bg());
        var cps = _md_cp_count(base, 0, len);
        if (cps > 0) { gd_push_text(cmds, x + GR_GLYPH_W, cy, _ui_rgb(ROLE_BLUE), base, cps); }
    }
    return cy + GFEED_LH;
}

# _gfeed_md_block: render one classified NON-fence block (base[0..len), kind from md_classify). Each block occupies
# at least one row (an empty heading/list content is floored to GFEED_LH so a drawn marker isn't overwritten).
fn _gfeed_md_block(cmds, x, cy, avail, base, len, kind) {
    if (kind == MDB_BLANK) { return cy + GFEED_LH; }
    if (kind == MDB_HEADING) {
        var co = md_content();
        var hcy = _gfeed_md_wrap(cmds, x, cy, avail, base + co, len - co, ROLE_ACCENT);
        if (hcy == cy) { hcy = cy + GFEED_LH; }
        return hcy;
    }
    if (kind == MDB_QUOTE) {
        var qo = md_content();
        var qi = 2 * GR_GLYPH_W;
        var qcy = _gfeed_md_wrap(cmds, x + qi, cy, avail - qi, base + qo, len - qo, ROLE_FAINT);
        if (qcy == cy) { qcy = cy + GFEED_LH; }
        return qcy;
    }
    if (kind == MDB_LIST) {
        var ind = md_indent() * GR_GLYPH_W;
        var mcols = md_marker_len();          # ASCII marker -> columns == bytes
        if (cmds != 0) { gd_push_text(cmds, x + ind, cy, _ui_rgb(ROLE_ACCENT), base + md_marker_start(), mcols); }
        var cx = x + ind + (mcols + 1) * GR_GLYPH_W;
        var cavail = avail - ind - (mcols + 1) * GR_GLYPH_W;
        if (cavail < GR_GLYPH_W) { cavail = GR_GLYPH_W; }
        var lo = md_content();
        var lcy = _gfeed_md_wrap(cmds, cx, cy, cavail, base + lo, len - lo, ROLE_MUTED);
        if (lcy == cy) { lcy = cy + GFEED_LH; }
        return lcy;
    }
    var pcy = _gfeed_md_wrap(cmds, x, cy, avail, base, len, ROLE_MUTED);   # MDB_PARA
    if (pcy == cy) { pcy = cy + GFEED_LH; }
    return pcy;
}

# --- 0.36.1: GUI pipe-table grid (lowers the mdmodel table parser) ------------------------------------------------
# A pipe table (header row + '|---|' delimiter + body rows) renders as an aligned monospace grid: header cells in
# ROLE_ACCENT under a faint rule, body cells in ROLE_MUTED, each column padded to its widest cell and aligned per the
# delimiter (:--:/--:). Cells are plain text (no inline styling / no wrap this cut) — an over-wide table clips to the
# feed region. Deterministic (widths + row walk are cmds-independent), so measure == draw.
var MD_TABLE_MAXCOL = 16;      # columns beyond this are dropped (a very wide table clips anyway)
var MD_TABLE_GAP = 2;          # blank cells of gutter between columns
var _gmd_colw = 0;             # per-column width in codepoints, alloc(MD_TABLE_MAXCOL * 8)
var _gmd_align = 0;            # per-column alignment (0 left / 1 center / 2 right), alloc(MD_TABLE_MAXCOL * 8)
var _gmd_table_end = 0;        # byte offset after the rendered table (the walker resumes here)
fn _gmd_colw_init() { if (_gmd_colw == 0) { _gmd_colw = alloc(MD_TABLE_MAXCOL * 8); } return 0; }
fn _gmd_align_init() { if (_gmd_align == 0) { _gmd_align = alloc(MD_TABLE_MAXCOL * 8); } return 0; }

# _gmd_has_pipe / _gmd_blank: does the line contain a '|' / is it whitespace-only. Used for table detection + extent.
fn _gmd_has_pipe(ptr, len) {
    var i = 0;
    while (i < len) { if (load8(ptr + i) == 124) { return 1; } i = i + 1; }
    return 0;
}
fn _gmd_blank(ptr, len) {
    var i = 0;
    while (i < len) { var c = load8(ptr + i); if ((c != 32) && (c != 9) && (c != 13)) { return 0; } i = i + 1; }
    return 1;
}

# _gmd_body_end: byte offset after the last table body row, scanning from `bs` — the table ends at the first blank
# or pipe-less line, or EOF. (Body rows must contain a '|', mirroring the header-has-pipe detection.)
fn _gmd_body_end(text, bs) {
    var rs = bs;
    var res = bs;
    var done = 0;
    while (done == 0) {
        if (load8(text + rs) == 0) { res = rs; done = 1; }
        else {
            var re = rs;
            while ((load8(text + re) != 0) && (load8(text + re) != 10)) { re = re + 1; }
            var rlen = re - rs;
            if ((_gmd_blank(text + rs, rlen) == 1) || (_gmd_has_pipe(text + rs, rlen) == 0)) { res = rs; done = 1; }
            elif (load8(text + re) == 0) { res = re; done = 1; }
            else { rs = re + 1; }
        }
    }
    return res;
}

# _gmd_row_widths: grow _gmd_colw[k] to fit the k-th cell's codepoint width, for each column k < ncols.
fn _gmd_row_widths(rptr, rlen, ncols) {
    md_row_split(rptr, rlen);
    var n = md_cell_count();
    var k = 0;
    while (k < ncols) {
        var w = 0;
        if (k < n) { w = _md_cp_count(rptr + md_cell_start(k), 0, md_cell_len(k)); }
        if (w > load64(_gmd_colw + k * 8)) { store64(_gmd_colw + k * 8, w); }
        k = k + 1;
    }
    return 0;
}

# _gmd_draw_row: draw one table row's cells at (x, cy) in `color`, each padded to its column width + aligned per
# _gmd_align. Splits the row (clobbers _md_cells — read immediately). Only draws when cmds != 0.
fn _gmd_draw_row(cmds, x, cy, rptr, rlen, ncols, color) {
    md_row_split(rptr, rlen);
    var n = md_cell_count();
    var k = 0;
    var prefix = 0;                    # codepoint columns consumed by columns 0..k-1 (widths + gutters)
    while (k < ncols) {
        var w = load64(_gmd_colw + k * 8);
        if (k < n) {
            var cs = md_cell_start(k);
            var cl = md_cell_len(k);
            var cw = _md_cp_count(rptr + cs, 0, cl);
            var pad = 0;
            var al = load64(_gmd_align + k * 8);
            if (al == 2) { pad = w - cw; }
            elif (al == 1) { pad = (w - cw) / 2; }
            if (pad < 0) { pad = 0; }
            if ((cmds != 0) && (cw > 0)) { gd_push_text(cmds, x + (prefix + pad) * GR_GLYPH_W, cy, color, rptr + cs, cw); }
        }
        prefix = prefix + w + MD_TABLE_GAP;
        k = k + 1;
    }
    return 0;
}

# _gfeed_md_table: render the pipe table whose header line starts at byte `hs` (the caller verified a delimiter row
# follows). Two passes over the rows: compute column widths, then draw header + faint rule + body rows. Sets
# _gmd_table_end to the byte offset the walker resumes at. Returns the y below the table.
fn _gfeed_md_table(cmds, x, cy, avail, text, hs) {
    var he = hs;
    while ((load8(text + he) != 0) && (load8(text + he) != 10)) { he = he + 1; }
    var ds = he + 1;                                   # delimiter line (there IS a next line)
    var de = ds;
    while ((load8(text + de) != 0) && (load8(text + de) != 10)) { de = de + 1; }
    md_row_split(text + hs, he - hs);
    var ncols = md_cell_count();
    if (ncols < 1) { ncols = 1; }
    if (ncols > MD_TABLE_MAXCOL) { ncols = MD_TABLE_MAXCOL; }
    var bs = de;
    if (load8(text + de) == 10) { bs = de + 1; }
    var bend = _gmd_body_end(text, bs);
    # pass 1: column widths over the header + every body row (delimiter excluded)
    _gmd_colw_init();
    var wi = 0;
    while (wi < ncols) { store64(_gmd_colw + wi * 8, 0); wi = wi + 1; }
    _gmd_row_widths(text + hs, he - hs, ncols);
    var rs = bs;
    var wdone = 0;
    while (wdone == 0) {
        if (rs >= bend) { wdone = 1; }
        else {
            var re = rs;
            while ((load8(text + re) != 0) && (load8(text + re) != 10)) { re = re + 1; }
            _gmd_row_widths(text + rs, re - rs, ncols);
            if (load8(text + re) == 0) { wdone = 1; } else { rs = re + 1; }
        }
    }
    # per-column alignment from the delimiter row
    _gmd_align_init();
    var ak = 0;
    while (ak < ncols) { store64(_gmd_align + ak * 8, md_cell_align(text + ds, de - ds, ak)); ak = ak + 1; }
    # total grid width (codepoints) for the header rule
    var tw = 0;
    var twi = 0;
    while (twi < ncols) { tw = tw + load64(_gmd_colw + twi * 8); twi = twi + 1; }
    tw = tw + (ncols - 1) * MD_TABLE_GAP;
    # pass 2: header + rule + body
    _gmd_draw_row(cmds, x, cy, text + hs, he - hs, ncols, _ui_rgb(ROLE_ACCENT));
    if (cmds != 0) { gd_push_rect(cmds, x, cy + GFEED_LH - 3, tw * GR_GLYPH_W, 1, _ui_rgb(ROLE_FAINT)); }
    cy = cy + GFEED_LH;
    var brs = bs;
    var bdone = 0;
    while (bdone == 0) {
        if (brs >= bend) { bdone = 1; }
        else {
            var bre = brs;
            while ((load8(text + bre) != 0) && (load8(text + bre) != 10)) { bre = bre + 1; }
            _gmd_draw_row(cmds, x, cy, text + brs, bre - brs, ncols, _ui_rgb(ROLE_MUTED));
            cy = cy + GFEED_LH;
            if (load8(text + bre) == 0) { bdone = 1; } else { brs = bre + 1; }
        }
    }
    _gmd_table_end = bend;
    return cy;
}

# _gfeed_md: the GUI structural-markdown renderer — walk a NUL-terminated reply line-by-line, tracking fenced-code
# state, and draw each block. Replaces _gfeed_para for ASSISTANT content (landed + the live partial). A lone
# trailing blank line (reply ending in '\n') adds no spurious gap. Returns the y below the reply.
fn _gfeed_md(cmds, x, cy, avail, text) {
    if (text == 0) { return cy; }
    if (load8(text) == 0) { return cy; }   # empty reply -> no rows (the partial is guarded by len>0 upstream)
    var in_fence = 0;
    var fch = 0;
    var flen = 0;
    var ls = 0;
    var done = 0;
    while (done == 0) {
        var le = ls;
        while ((load8(text + le) != 0) && (load8(text + le) != 10)) { le = le + 1; }
        var llen = le - ls;
        var last = 0;
        if (load8(text + le) == 0) { last = 1; }
        var advanced = 0;                            # 1 when a branch already repositioned ls (the multi-line table)
        if (in_fence == 1) {
            if (md_fence_close(text + ls, llen, fch, flen) == 1) { in_fence = 0; }        # exit; skip the closing ```
            else { cy = _gfeed_md_code_line(cmds, x, cy, avail, text + ls, llen); }
        } else {
            # table: this line has a '|', the NEXT line is a delimiter row, AND the delimiter's column count matches
            # the header's (GFM). The '|' + column-match checks stop a pipe-bearing prose/setext line above a '---'
            # (a 1-cell delimiter) from mis-rendering as a table — it stays prose, with the '---' visible.
            var is_table = 0;
            if ((last == 0) && (_gmd_has_pipe(text + ls, llen) == 1)) {
                var hcols = md_row_split(text + ls, llen);   # header cell count (captured before the delim clobbers _md_cells)
                var ns = le + 1;
                var ne = ns;
                while ((load8(text + ne) != 0) && (load8(text + ne) != 10)) { ne = ne + 1; }
                if (md_is_delim_row(text + ns, ne - ns) == 1) {
                    if (md_cell_count() == hcols) { is_table = 1; }   # delimiter cols == header cols
                }
            }
            if (is_table == 1) {
                cy = _gfeed_md_table(cmds, x, cy, avail, text, ls);
                ls = _gmd_table_end;
                advanced = 1;
                if (load8(text + ls) == 0) { done = 1; }
            } elif (md_fence_open(text + ls, llen) == 1) { in_fence = 1; fch = md_fence_ch(); flen = md_fence_len(); }   # enter; skip the ```
            else {
                var k = md_classify(text + ls, llen);
                # skip a LONE trailing blank line (empty OR whitespace-only) so a reply ending in '\n' adds no gap
                if ((k == MDB_BLANK) && (last == 1) && (ls > 0)) { }
                else { cy = _gfeed_md_block(cmds, x, cy, avail, text + ls, llen, k); }
            }
        }
        if (advanced == 0) {
            if (last == 1) { done = 1; } else { ls = le + 1; }
        }
    }
    return cy;
}

# _gfeed_greeting: the empty-state opening screen (no conversation yet). Honest — the app's greeting, not a
# faked message. Returns the next y.
fn _gfeed_greeting(cmds, x, y, avail_px) {
    var cy = y;
    gd_push_text(cmds, x, cy, _ui_rgb(ROLE_ACCENT), persona_name(), 0);
    cy = _gfeed_para(cmds, x + strlen(persona_name()) * GR_GLYPH_W + 8, cy, avail_px, _ui_rgb(ROLE_ACCENT_DIM), persona_role());
    cy = cy + GFEED_GAP;
    cy = _gfeed_para(cmds, x, cy, avail_px, _ui_rgb(ROLE_MUTED), "a sovereign agentic coding TUI — now with a desktop window.");
    cy = _gfeed_para(cmds, x, cy, avail_px, _ui_rgb(ROLE_FAINT), "type a task below to begin. (input wiring lands next.)");
    return cy;
}

# 0.35.2 reasoning fold: the collapse preference for the live "thinking" block (the model's chain-of-thought,
# reasoning_content -> _reason_acc in hoosh.cyr). Default expanded (0). Ctrl+R toggles it (gkey -> greason_toggle).
# The preference persists across turns (fold it away once, it stays away); the reasoning text itself is transient,
# reset per turn/round with the reply. Inert on Opus 4.8, which keeps reasoning internal -> _reason_acc stays empty.
var _greason_collapsed = 0;
fn greason_collapsed() { return _greason_collapsed; }
fn greason_toggle() { if (_greason_collapsed == 0) { _greason_collapsed = 1; } else { _greason_collapsed = 0; } return 0; }

# _gfeed_reason_at: draw a reasoning fold for the given (text, len) at (xbase, cy) and return the y below it (WITHOUT
# a trailing GFEED_GAP — callers add it via the gtool/gmem `if (rcy > cy)` pattern). Collapsed -> just the header
# row; expanded -> the header + the wrapped reasoning text (FAINT header, MUTED body, indented). len <= 0 -> cy
# unchanged (nothing drawn; the Opus 4.8 case). Shared by the LIVE fold (0.35.2, reads _reason_acc) and the LANDED
# per-turn fold (0.35.3, reads reasonlog) so the two render identically. The height decision reads only the passed
# text/len + the stable greason_collapsed() flag — both fixed for the duration of one gfeed_build, so measure==draw.
fn _gfeed_reason_at(cmds, xbase, cy, avail, text, len) {
    if (len <= 0) { return cy; }
    if (greason_collapsed() == 1) {
        if (cmds != 0) { gd_push_text(cmds, xbase, cy, _ui_rgb(ROLE_FAINT), "> thinking (Ctrl+R to expand)", 0); }
        return cy + GFEED_LH;
    }
    if (cmds != 0) { gd_push_text(cmds, xbase, cy, _ui_rgb(ROLE_FAINT), "v thinking (Ctrl+R to collapse)", 0); }
    cy = cy + GFEED_LH;
    return _gfeed_para(cmds, xbase + 24, cy, avail - 24, _ui_rgb(ROLE_MUTED), text);
}

# _gfeed_reason: the LIVE fold for the in-flight turn — the current round's reasoning straight from _reason_acc.
fn _gfeed_reason(cmds, xbase, cy, avail) {
    return _gfeed_reason_at(cmds, xbase, cy, avail, hoosh_last_reason(), hoosh_last_reason_len());
}

# greason_build_turn: the LANDED fold for turn `turn` — its reasoning persisted in reasonlog (0.35.3), so the fold
# survives the reply landing. turn <= 0 or no record (never had reasoning / aged out of the ring) -> cy unchanged.
# Mirrors gtool_build_turn / gmem_build_turn (same turn-tag key: session_history_turn(i) <-> reasonlog_find).
fn greason_build_turn(cmds, x, cy, avail, turn) {
    if (turn <= 0) { return cy; }
    var slot = reasonlog_find(turn);
    if (slot == 0) { return cy; }
    return _gfeed_reason_at(cmds, x, cy, avail, reasonlog_text(slot), reasonlog_len(slot));
}

# _gfeed_flow: lay out all n conversation messages from (xbase, cy0) down an avail-wide column; return the y
# after the last message (incl. its trailing GFEED_GAP). A user message gets a `>` accent marker + FG text; an
# agent message is plain MUTED body. cmds == 0 => MEASURE ONLY (no draw), the SAME wrap/layout code as the draw
# pass — so the measured total height is exactly the drawn height (the bottom-anchor relies on this).
fn _gfeed_flow(cmds, xbase, cy0, avail, n) {
    var cy = cy0;
    var i = 0;
    while (i < n) {
        var role = session_history_role(i);
        var content = session_history_content(i);
        if (streq(role, "user") == 1) {
            if (cmds != 0) { gd_push_text(cmds, xbase, cy, _ui_rgb(ROLE_ACCENT), "{(o>", 0); }   # the owl brand glyph
            cy = _gfeed_para(cmds, xbase + 40, cy, avail - 40, _ui_rgb(ROLE_FG), content);
        } else {
            # 0.35.3: this turn's reasoning fold — persisted in reasonlog so it survives the reply landing (the live
            # 0.35.2 fold showed only the in-flight turn). Renders ABOVE the tool cards (the model reasons FIRST),
            # keyed by the message's turn tag. cy unchanged when the turn had no reasoning (Opus 4.8) or it aged out
            # of the ring — mirrors gtool_build_turn's gating. Handoff from the live fold is seamless (same key).
            var rcy = greason_build_turn(cmds, xbase, cy, avail, session_history_turn(i));
            if (rcy > cy) { cy = rcy + GFEED_GAP; }
            # tool-call cards (0.30.16; per-turn since 0.30.19): above EACH turn's answer, show the rounds THAT
            # turn ran — matched by the message's turn tag, so an earlier turn's cards stay put when later turns are
            # added (a failed turn has no reply, so its cards render below with the failure notice). gtool_build_turn
            # returns cy unchanged when the turn used no tools, or its rounds have aged out of the roundlog ring.
            var tcy = gtool_build_turn(cmds, xbase, cy, avail, session_history_turn(i));
            if (tcy > cy) { cy = tcy + GFEED_GAP; }
            # memory strip (0.32.5): this turn's recalled sources + grounding verdict, from the persisted memlog
            # (the line/TUI ui_emit is lost under the GUI turn's OUT_NULL). y unchanged when the turn recalled nothing.
            var mcy = gmem_build_turn(cmds, xbase, cy, avail, session_history_turn(i));
            if (mcy > cy) { cy = mcy + GFEED_GAP; }
            cy = _gfeed_md(cmds, xbase, cy, avail, content);   # 0.36.0: structural markdown (was flat _gfeed_para)
        }
        cy = cy + GFEED_GAP;
        i = i + 1;
    }
    # a turn in flight (0.30.4): echo the just-submitted message as a provisional bubble + a working indicator,
    # BELOW the last real message. Part of the measured flow so the bottom-anchor keeps it visible. The pending
    # text is NOT in session_history yet (the turn appends it when it runs) — this is a transient render.
    if (gturn_active() == 1) {
        if (cmds != 0) { gd_push_text(cmds, xbase, cy, _ui_rgb(ROLE_ACCENT), "{(o>", 0); }   # the owl brand glyph
        cy = _gfeed_para(cmds, xbase + 40, cy, avail - 40, _ui_rgb(ROLE_FG), gturn_text());
        cy = cy + GFEED_GAP;
        # 0.35.2: the model's reasoning fold — chain-of-thought streams FIRST (before content + tool calls), so it
        # renders ABOVE the cards and partial answer. Empty on Opus 4.8 -> _gfeed_reason returns cy unchanged (no gap).
        var _rcy = _gfeed_reason(cmds, xbase, cy, avail);
        if (_rcy > cy) { cy = _rcy + GFEED_GAP; }
        # 0.35.1: the CURRENT turn's tool-call cards, LIVE from the roundlog — each call is recorded as it completes
        # (roundlog_add_call in the loop), and the pump repaints between calls, so a card grows a row as each tool
        # returns during the round (was post-turn only). gtool_build == gtool_build_turn(session_turns()) — the SAME
        # cards the per-message loop draws once the reply lands, so the mid-turn → post-turn handoff is seamless.
        # Measure/draw parity: gtool_build is parity-clean and the roundlog is unchanged between the two passes.
        var _tcy = gtool_build(cmds, xbase, cy, avail);
        if (_tcy > cy) { cy = _tcy + GFEED_GAP; }
        # 0.35.0 mid-turn pump: render the LIVE streaming partial reply (the model's output so far, in _hoosh_acc —
        # populated on both SSE paths even under the GUI turn's OUT_NULL) as a provisional agent bubble that grows
        # each frame as the pump (gpresent's _gstop_poll) repaints. Same call shape as a landed assistant message
        # above, so the partial→final handoff is seamless. Before any content this round — and between tool rounds,
        # when _hoosh_acc is reset — fall back to the static "working" mark. Measure/draw read _hoosh_acc at the same
        # instant (no SSE frame lands between the two passes), so the bottom-anchor parity holds.
        if (hoosh_last_reply_len() > 0) {
            cy = _gfeed_md(cmds, xbase, cy, avail, hoosh_last_reply());   # 0.36.0: structural markdown, degrades on the incomplete partial
            cy = cy + GFEED_GAP;
        } else {
            if (cmds != 0) {
                gd_push_rect(cmds, xbase, cy + 4, 8, 8, _ui_rgb(ROLE_ACCENT));                   # a working mark (static)
                gd_push_text(cmds, xbase + 16, cy, _ui_rgb(ROLE_MUTED), "thoth is working...", 0);
            }
            cy = cy + GFEED_LH + GFEED_GAP;
        }
    }
    # a turn that appended no assistant reply (0.30.4): an honest transient notice — the window renders only
    # session_history, so a failed turn (unreachable hoosh, transport/http error) would otherwise vanish silently.
    if (gturn_failed() == 1) {
        var fcy = gtool_build(cmds, xbase, cy, avail);            # 0.30.16: what the failed turn attempted (if it ran tools)
        if (fcy > cy) { cy = fcy + GFEED_GAP; }
        cy = _gfeed_para(cmds, xbase, cy, avail, _ui_rgb(ROLE_RED), "the turn did not complete - is hoosh reachable? try /reprobe");
        cy = cy + GFEED_GAP;
    }
    # 0.34.3: an Esc-INTERRUPTED turn that kept no partial — a neutral "stopped" notice, not the red failure one.
    if (gturn_stopped() == 1) {
        var scy = gtool_build(cmds, xbase, cy, avail);            # tools the stopped turn had run before Esc (if any)
        if (scy > cy) { cy = scy + GFEED_GAP; }
        cy = _gfeed_para(cmds, xbase, cy, avail, _ui_rgb(ROLE_MUTED), "- stopped -");
        cy = cy + GFEED_GAP;
    }
    return cy;
}

# gfeed_anchor_y: the y the conversation flow starts at, given its measured `total` height and the region
# [y, y+h). Fits (total <= h - GFEED_GAP) -> anchor at the TOP (natural reading order). Overflows -> anchor the
# BOTTOM (newest message flush to the region bottom); the returned y is above the region top so the CLIP hides
# the older messages that scroll off — i.e., the feed follows the conversation, like the mockup's auto-scroll.
fn gfeed_anchor_y(total, y, h) {
    if (total > h - GFEED_GAP) { return y + h - total; }
    return y + GFEED_GAP;
}

# gfeed_build: render the conversation into [x, x+w) x [y, y+h). Emits a CLIP so a long feed doesn't bleed past
# the region and so a bottom-anchored flow's older messages are clipped above the top. Reads session_history_*
# (role + content per message). Empty -> the greeting (always top-anchored). Otherwise measures the flow, then
# draws it anchored so the NEWEST message is always visible.
fn gfeed_build(cmds, x, y, w, h) {
    var avail = w - GFEED_PAD - GFEED_PAD;
    var xbase = x + GFEED_PAD;
    gd_push_clip(cmds, x, y, w, h);
    var n = session_history_len();
    var endy = 0;
    if ((n == 0) && (gturn_active() == 0) && (gturn_failed() == 0) && (gturn_stopped() == 0)) {
        gscroll_reset();                                         # nothing to scroll on the empty greeting
        endy = _gfeed_greeting(cmds, xbase, y + GFEED_GAP, avail);
    } else {
        var total = _gfeed_flow(0, xbase, 0, avail, n);          # measure-only pass (incl. a pending turn) -> total height
        var base = gfeed_anchor_y(total, y, h);                  # bottom-anchored start (scroll == 0)
        gscroll_view_h_set(h);                                   # PgUp/PgDn page by ~the feed height
        var maxsc = (y + GFEED_GAP) - base;                      # room to scroll up (0 when the flow fits)
        if (maxsc < 0) { maxsc = 0; }
        gscroll_clamp(maxsc);                                    # keep the scroll offset within the overflow
        endy = _gfeed_flow(cmds, xbase, base + gscroll(), avail, n);   # draw, bottom-anchored + scrolled up
        if (gscroll() > 0) {                                     # scrolled off the bottom -> an honest "more below" hint
            var hy = y + h - GFEED_LH;
            gd_push_rect(cmds, x, hy - 2, w, GFEED_LH + 2, _gframe_bg());
            gd_push_text(cmds, xbase, hy, _ui_rgb(ROLE_FAINT), "-- more below (End) --", 0);
        }
    }
    gd_push_unclip(cmds);
    return endy;
}

# --- the whole window frame (status strip + feed + composer line) ------------------------------------------
# The three-region mockup layout. PURE — assembles a cmd list over the tested pipeline; the present loop
# (gpresent.cyr) rasters it into the wl_shm buffer. Lives here (a view-builder) so it is headless-testable.
var GFRAME_STRIP_H = 34;
var GFRAME_COMPOSER_H = 40;
fn _gframe_bg() { if (ui_theme() == THEME_LIGHT) { return 0xf5f0e4; } return 0x15120d; }

# --- the throbbing owl eye (0.30.11): the `o` in the {(o> composer prompt pulses colour as a LIVE status
# indicator — "the head as indicator". Its BASE colour reflects hoosh health (red when the gateway is DOWN,
# else the amber accent), and it THROBS (a triangle brightness pulse) so the window feels alive at rest. The
# eye is drawn as its OWN draw-command; gframe_build records that cell in _geye_cell, and the present loop
# advances the phase + rewrites JUST that cell's colour each tick — so the animation costs no per-frame
# allocation (the frame command list is cached; only one colour word changes). PURE colour math (testable).
var GEYE_STEPS = 12;
var _geye_phase = 0;
var _geye_cell = 0;
fn geye_phase_advance() { _geye_phase = (_geye_phase + 1) % GEYE_STEPS; return 0; }
fn geye_cell() { return _geye_cell; }
# _geye_blend: packed-XRGB linear blend c0 -> c1 by num/den, per channel.
fn _geye_blend(c0, c1, num, den) {
    var r = ((c0 / 65536) & 255) + (((c1 / 65536) & 255) - ((c0 / 65536) & 255)) * num / den;
    var g = ((c0 / 256) & 255)   + (((c1 / 256) & 255)   - ((c0 / 256) & 255))   * num / den;
    var b = (c0 & 255)           + ((c1 & 255)           - (c0 & 255))           * num / den;
    return r * 65536 + g * 256 + b;
}
# _geye_base: the eye's status colour — red if hoosh is DOWN (health indicator), else the accent.
fn _geye_base() { if (hoosh_health() == HOOSH_HEALTH_DOWN) { return _ui_rgb(ROLE_RED); } return _ui_rgb(ROLE_ACCENT); }
# geye_color: the eye colour for phase p — a triangle GLOW that pulses the base colour toward white (never
# toward the bg, so the eye stays visibly coloured at every phase — a throb, not a blink). Peak = ~50% white.
fn geye_color(p) {
    var base = _geye_base();
    var half = GEYE_STEPS / 2;
    var t = p; if (t > half) { t = GEYE_STEPS - t; }   # triangle 0..half..0
    return _geye_blend(base, 0xffffff, t, GEYE_STEPS);
}
fn geye_color_now() { return geye_color(_geye_phase); }

fn gframe_build(w, h) {
    var cmds = gd_list_new();
    gd_push_rect(cmds, 0, 0, w, h, _gframe_bg());                            # body background
    # status strip (0.32.x: hidden via Ctrl+S -> the feed reclaims its height). When shown it spans the full width.
    var body_top = 0;
    if (gstatus_hidden() == 0) {
        gstatus_build(cmds, 0, 0, w, GFRAME_STRIP_H);                        # status strip (the view-model)
        gd_push_rect(cmds, 0, GFRAME_STRIP_H, w, 1, _ui_rgb(ROLE_FAINT));    # rule under the strip
        body_top = GFRAME_STRIP_H + 1;
    }
    # body band: an optional file-tree pane (left) + the conversation feed (right); status strip + composer span
    # the full width. The tree hides on a narrow window (gtree_w -> 0) OR via Ctrl+B (0.32.x), giving the feed the
    # whole body as before.
    var comp_top = h - GFRAME_COMPOSER_H;                                    # composer line (bottom)
    var body_h = comp_top - body_top;
    if (body_h < 0) { body_h = 0; }
    # left band, accumulating: an optional conversation sidebar (0.33.6), then an optional file-tree pane, then the
    # feed takes the rest. Each left pane is followed by a 1px vertical rule. Both hide on a narrow window OR via
    # their Ctrl chord (conv=Ctrl+K default-hidden, tree=Ctrl+B), giving the feed more/all of the body.
    var feed_x = 0;
    var cw = 0;
    if (gconv_hidden() == 0) { cw = gconv_w(w); }
    if (cw > 0) {
        gconv_build(cmds, feed_x, body_top, cw, body_h);
        gd_push_rect(cmds, feed_x + cw, body_top, 1, body_h, _ui_rgb(ROLE_FAINT));
        feed_x = feed_x + cw + 1;
    }
    var tw = 0;
    if (gtree_hidden() == 0) { tw = gtree_w(w); }
    if (tw > 0) {
        gtree_build(cmds, feed_x, body_top, tw, body_h);
        gd_push_rect(cmds, feed_x + tw, body_top, 1, body_h, _ui_rgb(ROLE_FAINT));   # vertical rule between tree + feed
        feed_x = feed_x + tw + 1;
    }
    gfeed_build(cmds, feed_x, body_top, w - feed_x, body_h);
    gd_push_rect(cmds, 0, comp_top, w, 1, _ui_rgb(ROLE_FAINT));
    var cty = comp_top + (GFRAME_COMPOSER_H - GR_GLYPH_H) / 2;
    # the `>` prompt dims when focus is on the tree (so the active pane is obvious), bright on the composer.
    var promptc = _ui_rgb(ROLE_ACCENT_DIM);
    if (gfocus() == GFOCUS_COMPOSER) { promptc = _ui_rgb(ROLE_ACCENT); }
    # the signature owl prompt {(o> — the `o` (eye) is its OWN command so the present loop can throb its colour
    # as a live status indicator (0.30.11); `{(` + `>` follow composer focus (dim when the tree is focused).
    gd_push_text(cmds, 14, cty, promptc, "{(", 0);                     # owl head
    gd_push_text(cmds, 30, cty, geye_color_now(), "o", 0);            # the EYE (throbs; recoloured by the loop)
    _geye_cell = vec_get(cmds, vec_len(cmds) - 1);
    gd_push_text(cmds, 38, cty, promptc, ">", 0);                     # owl beak
    var ccx = 54;                                                      # past "{(o> " (5 cols)
    if (gcomp_len() == 0) {
        gd_push_text(cmds, 54, cty, _ui_rgb(ROLE_FAINT), "type a message  -  Tab: panes  -  Enter: send  -  Esc: close", 0);
    } else {
        gd_push_text(cmds, 54, cty, _ui_rgb(ROLE_FG), gcomp_cstr(), 0);
        ccx = 54 + gcomp_len() * GR_GLYPH_W + 1;
    }
    # the caret shows ONLY when the composer is focused (0.30.10) — a clear active-pane cue.
    if (gfocus() == GFOCUS_COMPOSER) { gd_push_rect(cmds, ccx, cty, 2, GR_GLYPH_H, _ui_rgb(ROLE_ACCENT)); }
    return cmds;
}
