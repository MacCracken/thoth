# src/gui/gfeed.cyr — the GUI conversation-feed view-builder (T3, 0.30.1).
#
# Renders the conversation (session_history_*) as word-wrapped messages in the window body — the mockup's
# (Thoth.dc.html) main region. A user message gets a `>` accent marker + its text; an agent message is plain
# body text; each wraps to the available pixel width. When there is no conversation yet, an honest greeting
# empty-state (the app's opening screen, never a faked exchange). PURE: builds draw-commands over the tested
# pipeline (gdraw + graster's codepoint-accurate text); no display, no producer of its own — it reads the
# SAME session_history the TUI feed + `/save` read. Headless-testable (build → raster → assert / PPM).

var GFEED_LH   = 20;   # line height (px) for wrapped body text
var GFEED_GAP  = 12;   # px between messages
var GFEED_PAD  = 14;   # left inset

# _gfeed_para: draw `text` word-wrapped into an `avail_px`-wide column at (x,y), line height GFEED_LH.
# Breaks at spaces (hard-breaks a word longer than the column). Draws each wrapped line as a (start,cols)
# slice via gd_push_text's max_cp cap — NO per-line copy. Codepoint-accurate (uses the graster decoder), so
# the wrap column matches the rendered width for non-ASCII too. Returns the y AFTER the last line.
# cmds == 0 => MEASURE ONLY: the wrap math runs identically but nothing is emitted, so the returned height is
# byte-for-byte the height the draw pass produces (the bottom-anchor pre-measure relies on this parity).
fn _gfeed_para(cmds, x, y, avail_px, color, text) {
    if (text == 0) { return y; }
    var maxcols = avail_px / GR_GLYPH_W;
    if (maxcols < 1) { maxcols = 1; }
    var i = 0;                  # byte scan offset
    var line_start = 0;         # byte offset where the current line begins
    var cols = 0;               # codepoints on the current line (incl. the last-processed one)
    var last_sp_byte = 0 - 1;   # byte offset of the last space seen on this line
    var last_sp_cols = 0;       # codepoints before that space
    var cy = y;
    var done = 0;
    while (done == 0) {
        if (load8(text + i) == 0) { done = 1; }
        else {
            var packed = gr__utf8_at(text, i);
            var cp = packed / 8;
            var nb = packed % 8;
            if (cp == 32) { last_sp_byte = i; last_sp_cols = cols; }   # cols = count BEFORE this space
            cols = cols + 1;
            i = i + nb;
            if (cols > maxcols) {
                if (last_sp_byte >= line_start) {
                    # skip an empty leading-space segment: last_sp_cols == 0 would pass max_cp 0 == UNCAPPED to
                    # gr_fb_text and draw the whole string on this line. Nothing to draw before the space anyway.
                    if ((cmds != 0) && (last_sp_cols > 0)) { gd_push_text(cmds, x, cy, color, text + line_start, last_sp_cols); }   # words before the space
                    cy = cy + GFEED_LH;
                    line_start = last_sp_byte + 1;                # new line begins after the space (1 byte)
                    cols = cols - last_sp_cols - 1;               # codepoints carried to the new line
                    last_sp_byte = 0 - 1;
                } else {
                    if (cmds != 0) { gd_push_text(cmds, x, cy, color, text + line_start, cols - 1); }   # hard-break a long word
                    cy = cy + GFEED_LH;
                    line_start = i - nb;                          # new line begins at the current cp
                    cols = 1;
                    last_sp_byte = 0 - 1;
                }
            }
        }
    }
    if (cols > 0) { if (cmds != 0) { gd_push_text(cmds, x, cy, color, text + line_start, cols); } cy = cy + GFEED_LH; }
    return cy;
}

# _gfeed_greeting: the empty-state opening screen (no conversation yet). Honest — the app's greeting, not a
# faked message. Returns the next y.
fn _gfeed_greeting(cmds, x, y, avail_px) {
    var cy = y;
    gd_push_text(cmds, x, cy, _ui_rgb(ROLE_ACCENT), persona_name(), 0);
    cy = _gfeed_para(cmds, x + strlen(persona_name()) * GR_GLYPH_W + 8, cy, avail_px, _ui_rgb(ROLE_ACCENT_DIM), persona_role());
    cy = cy + GFEED_GAP;
    cy = _gfeed_para(cmds, x, cy, avail_px, _ui_rgb(ROLE_MUTED), "a sovereign agentic coding TUI — now with a desktop window.");
    cy = _gfeed_para(cmds, x, cy, avail_px, _ui_rgb(ROLE_FAINT), "type a task below to begin. (input wiring lands next.)");
    return cy;
}

# _gfeed_flow: lay out all n conversation messages from (xbase, cy0) down an avail-wide column; return the y
# after the last message (incl. its trailing GFEED_GAP). A user message gets a `>` accent marker + FG text; an
# agent message is plain MUTED body. cmds == 0 => MEASURE ONLY (no draw), the SAME wrap/layout code as the draw
# pass — so the measured total height is exactly the drawn height (the bottom-anchor relies on this).
fn _gfeed_flow(cmds, xbase, cy0, avail, n) {
    var cy = cy0;
    var i = 0;
    while (i < n) {
        var role = session_history_role(i);
        var content = session_history_content(i);
        if (streq(role, "user") == 1) {
            if (cmds != 0) { gd_push_text(cmds, xbase, cy, _ui_rgb(ROLE_ACCENT), ">", 0); }
            cy = _gfeed_para(cmds, xbase + 16, cy, avail - 16, _ui_rgb(ROLE_FG), content);
        } else {
            cy = _gfeed_para(cmds, xbase, cy, avail, _ui_rgb(ROLE_MUTED), content);
        }
        cy = cy + GFEED_GAP;
        i = i + 1;
    }
    # a turn in flight (0.30.4): echo the just-submitted message as a provisional bubble + a working indicator,
    # BELOW the last real message. Part of the measured flow so the bottom-anchor keeps it visible. The pending
    # text is NOT in session_history yet (the turn appends it when it runs) — this is a transient render.
    if (gturn_active() == 1) {
        if (cmds != 0) { gd_push_text(cmds, xbase, cy, _ui_rgb(ROLE_ACCENT), ">", 0); }
        cy = _gfeed_para(cmds, xbase + 16, cy, avail - 16, _ui_rgb(ROLE_FG), gturn_text());
        cy = cy + GFEED_GAP;
        if (cmds != 0) {
            gd_push_rect(cmds, xbase, cy + 4, 8, 8, _ui_rgb(ROLE_ACCENT));                   # a working mark (static; the turn blocks the loop)
            gd_push_text(cmds, xbase + 16, cy, _ui_rgb(ROLE_MUTED), "thoth is working...", 0);
        }
        cy = cy + GFEED_LH + GFEED_GAP;
    }
    # a turn that appended no assistant reply (0.30.4): an honest transient notice — the window renders only
    # session_history, so a failed turn (unreachable hoosh, transport/http error) would otherwise vanish silently.
    if (gturn_failed() == 1) {
        cy = _gfeed_para(cmds, xbase, cy, avail, _ui_rgb(ROLE_RED), "the turn did not complete - is hoosh reachable? try /reprobe");
        cy = cy + GFEED_GAP;
    }
    return cy;
}

# gfeed_anchor_y: the y the conversation flow starts at, given its measured `total` height and the region
# [y, y+h). Fits (total <= h - GFEED_GAP) -> anchor at the TOP (natural reading order). Overflows -> anchor the
# BOTTOM (newest message flush to the region bottom); the returned y is above the region top so the CLIP hides
# the older messages that scroll off — i.e., the feed follows the conversation, like the mockup's auto-scroll.
fn gfeed_anchor_y(total, y, h) {
    if (total > h - GFEED_GAP) { return y + h - total; }
    return y + GFEED_GAP;
}

# gfeed_build: render the conversation into [x, x+w) x [y, y+h). Emits a CLIP so a long feed doesn't bleed past
# the region and so a bottom-anchored flow's older messages are clipped above the top. Reads session_history_*
# (role + content per message). Empty -> the greeting (always top-anchored). Otherwise measures the flow, then
# draws it anchored so the NEWEST message is always visible.
fn gfeed_build(cmds, x, y, w, h) {
    var avail = w - GFEED_PAD - GFEED_PAD;
    var xbase = x + GFEED_PAD;
    gd_push_clip(cmds, x, y, w, h);
    var n = session_history_len();
    var endy = 0;
    if ((n == 0) && (gturn_active() == 0) && (gturn_failed() == 0)) {
        endy = _gfeed_greeting(cmds, xbase, y + GFEED_GAP, avail);
    } else {
        var total = _gfeed_flow(0, xbase, 0, avail, n);          # measure-only pass (incl. a pending turn) -> total height
        endy = _gfeed_flow(cmds, xbase, gfeed_anchor_y(total, y, h), avail, n);   # draw, bottom-anchored
    }
    gd_push_unclip(cmds);
    return endy;
}

# --- the whole window frame (status strip + feed + composer line) ------------------------------------------
# The three-region mockup layout. PURE — assembles a cmd list over the tested pipeline; the present loop
# (gpresent.cyr) rasters it into the wl_shm buffer. Lives here (a view-builder) so it is headless-testable.
var GFRAME_STRIP_H = 34;
var GFRAME_COMPOSER_H = 40;
fn _gframe_bg() { if (ui_theme() == THEME_LIGHT) { return 0xf5f0e4; } return 0x15120d; }

fn gframe_build(w, h) {
    var cmds = gd_list_new();
    gd_push_rect(cmds, 0, 0, w, h, _gframe_bg());                            # body background
    gstatus_build(cmds, 0, 0, w, GFRAME_STRIP_H);                            # status strip (the view-model)
    gd_push_rect(cmds, 0, GFRAME_STRIP_H, w, 1, _ui_rgb(ROLE_FAINT));        # rule under the strip
    # body band: an optional file-tree pane (left) + the conversation feed (right); status strip + composer span
    # the full width. The tree hides on a narrow window (gtree_w -> 0), giving the feed the whole body as before.
    var body_top = GFRAME_STRIP_H + 1;
    var comp_top = h - GFRAME_COMPOSER_H;                                    # composer line (bottom)
    var body_h = comp_top - body_top;
    if (body_h < 0) { body_h = 0; }
    var tw = gtree_w(w);
    var feed_x = 0;
    if (tw > 0) {
        gtree_build(cmds, 0, body_top, tw, body_h);
        gd_push_rect(cmds, tw, body_top, 1, body_h, _ui_rgb(ROLE_FAINT));    # vertical rule between tree + feed
        feed_x = tw + 1;
    }
    gfeed_build(cmds, feed_x, body_top, w - feed_x, body_h);
    gd_push_rect(cmds, 0, comp_top, w, 1, _ui_rgb(ROLE_FAINT));
    var cty = comp_top + (GFRAME_COMPOSER_H - GR_GLYPH_H) / 2;
    # the `>` prompt dims when focus is on the tree (so the active pane is obvious), bright on the composer.
    var promptc = _ui_rgb(ROLE_ACCENT_DIM);
    if (gfocus() == GFOCUS_COMPOSER) { promptc = _ui_rgb(ROLE_ACCENT); }
    gd_push_text(cmds, 14, cty, promptc, ">", 0);
    var ccx = 34;
    if (gcomp_len() == 0) {
        gd_push_text(cmds, 34, cty, _ui_rgb(ROLE_FAINT), "type a message  -  Tab: files  -  Enter: send  -  Esc: close", 0);
    } else {
        gd_push_text(cmds, 34, cty, _ui_rgb(ROLE_FG), gcomp_cstr(), 0);
        ccx = 34 + gcomp_len() * GR_GLYPH_W + 1;
    }
    # the caret shows ONLY when the composer is focused (0.30.10) — a clear active-pane cue.
    if (gfocus() == GFOCUS_COMPOSER) { gd_push_rect(cmds, ccx, cty, 2, GR_GLYPH_H, _ui_rgb(ROLE_ACCENT)); }
    return cmds;
}
