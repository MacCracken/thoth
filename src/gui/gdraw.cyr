# src/gui/gdraw.cyr — the T3 GUI draw-command IR (Phase 1).
#
# A tier-agnostic list of semantic-free 2-D primitives (RECT / TEXT / BORDER / CLIP) that a VIEW-BUILDER
# emits from thoth's state and the CPU rasterizer (src/gui/graster.cyr) executes into an XRGB8888 pixel
# buffer — the same layout a Wayland present shell maps via wl_shm. PURE + headless-testable: no display, no
# window; every command and every rastered pixel is assertable.
#
# This is the LOWERING TARGET for the Stage-B view surface: a renderer for the desktop tier turns the
# facts-not-bytes view-models (0.28.0 status_snapshot, later tool-card/diff) into these commands, exactly as
# the line/rich renderers turn them into text. Modeled on jalwa's `JlwDrawCmd` + puka's fb rasterizer (the
# proven AGNOS-family pattern); thoth OWNS its copy (port the floor — the GUI substrate is FLOOR, not spine).
#
# A command is a packed 8-slot i64 cell (the feed.cyr / surface.cyr idiom — thoth avoids structs for
# consistency): [kind, x, y, w, h, color, text, aux]. `color` is a packed 0x00RRGGBB word — IDENTICAL to
# ui.cyr's `_ui_rgb(role)`, so the GUI shares the TUI's amber/light palette + `/theme` for free. A "cmd list"
# is a stdlib `vec` of these cell pointers.

var GD_RECT      = 0;   # filled rectangle (color)
var GD_TEXT      = 1;   # UTF-8 cstr at (x,y), color; aux = max codepoints (0 = uncapped)
var GD_BORDER    = 2;   # 1px rectangle outline (color)
var GD_CLIP_PUSH = 3;   # push a clip rect (x,y,w,h) for scroll viewports / panels — INTERSECTED with the clip in force (0.52.1)
var GD_CLIP_POP  = 4;   # restore the clip in force before the matching push (0.52.1: a stack; was the full frame)

# cell byte offsets (8 i64 slots)
var GDC_KIND = 0; var GDC_X = 8; var GDC_Y = 16; var GDC_W = 24;
var GDC_H = 32; var GDC_COLOR = 40; var GDC_TEXT = 48; var GDC_AUX = 56;
var GD_CELL = 64;

# GD_RAINBOW (0.38.1) — a SENTINEL color, not a color: it tells the rasterizer "resolve this per glyph from
# the rainbow hue at the glyph's column" (`/theme rainbow` is a per-grapheme render mode, and the IR carries
# one color per RUN). It sits outside the 24-bit 0x00RRGGBB range, so it can never collide with a real color
# and needs no new cell slot or IR shape change. Only the rasterizer interprets it; only the feed's PROSE
# sites emit it (chrome keeps its role colors, exactly as on the TUI).
var GD_RAINBOW = 0x01000000;

# --- accessors (the raster executor reads these) ---
fn gd_kind(c)  { return load64(c + GDC_KIND); }
fn gd_x(c)     { return load64(c + GDC_X); }
fn gd_y(c)     { return load64(c + GDC_Y); }
fn gd_w(c)     { return load64(c + GDC_W); }
fn gd_h(c)     { return load64(c + GDC_H); }
fn gd_color(c) { return load64(c + GDC_COLOR); }
fn gd_text(c)  { return load64(c + GDC_TEXT); }
fn gd_aux(c)   { return load64(c + GDC_AUX); }

# --- the frame's memory (0.53.3, G-7, M-7) ------------------------------------------------------------------------
# Every rebuild took its cells and its list from the heap that never frees: 62 KB a keystroke on the greeting, and 10
# rebuilds a second while a command waited, 228 MB an hour for a frame that was not changing. A window frame now draws from
# chunks of cells it rewinds, with one list; gd_pool_on is the window's, and a list is good until the next rebuild (a
# frame replaces the last whole). Off (the suite's own lists), a cell is an alloc, as before.
var GD_CHUNK = 512;
var _gd_pool_on = 0;
var _gd_pool_used = 0;
var _gd_chunks = 0;
var _gd_vec = 0;
fn gd_pool_on() { _gd_pool_on = 1; if (_gd_chunks == 0) { _gd_chunks = vec_new(); } return 0; }
fn gd_frame_rewind() { _gd_pool_used = 0; return 0; }
fn _gd_cell() {
    if (_gd_pool_on == 0) { return alloc(GD_CELL); }
    var idx = _gd_pool_used / GD_CHUNK;
    if (idx >= vec_len(_gd_chunks)) { vec_push(_gd_chunks, alloc(GD_CELL * GD_CHUNK)); }
    var c = vec_get(_gd_chunks, idx) + (_gd_pool_used % GD_CHUNK) * GD_CELL;
    _gd_pool_used = _gd_pool_used + 1;
    return c;
}
# gd_num_buf: scratch for a number drawn this frame: a text command keeps the pointer until the raster has read it. A cell is
# 64 bytes.
fn gd_num_buf() { return _gd_cell(); }
fn _gd_new(kind, x, y, w, h, color, text, aux) {
    var c = _gd_cell();
    store64(c + GDC_KIND, kind); store64(c + GDC_X, x); store64(c + GDC_Y, y);
    store64(c + GDC_W, w); store64(c + GDC_H, h); store64(c + GDC_COLOR, color);
    store64(c + GDC_TEXT, text); store64(c + GDC_AUX, aux);
    return c;
}

# --- culling (0.53.2) --------------------------------------------------------------------------------------------
# A long reply made the feed's command list hold every line of it, on screen or not, and the list is what the raster
# walks each frame and the never-freeing heap pays for each rebuild. While a band is set, a rect, border or text wholly
# outside it is not pushed. The feed sets it around its draw pass only: the band is the feed's region.
var GD_CULL_TEXT_H = 32;       # a text row's height for the test: more than any row the window draws
var _gd_cull = 0;
var _gd_cull_top = 0;
var _gd_cull_bot = 0;
fn gd_cull_set(top, bot) { _gd_cull = 1; _gd_cull_top = top; _gd_cull_bot = bot; return 0; }
fn gd_cull_clear() { _gd_cull = 0; return 0; }
fn gd_cull_on() { return _gd_cull; }
fn gd_cull_top() { return _gd_cull_top; }
# gd_culled: 1 when a box from y, h tall, misses the band (never, with no band set). gd_below: 1 when y is under it.
fn gd_culled(y, h) {
    if (_gd_cull == 0) { return 0; }
    if (((y + h) <= _gd_cull_top) || (y >= _gd_cull_bot)) { return 1; }
    return 0;
}
fn gd_below(y) {
    if ((_gd_cull == 1) && (y >= _gd_cull_bot)) { return 1; }
    return 0;
}

# --- command-list builders (push onto a stdlib vec) ---
fn gd_list_new() {
    if (_gd_pool_on == 0) { return vec_new(); }
    if (_gd_vec == 0) { _gd_vec = vec_new(); }
    vec_truncate(_gd_vec, 0);
    return _gd_vec;
}
fn gd_push_rect(cmds, x, y, w, h, color)   { if (gd_culled(y, h) == 1) { return 0; } vec_push(cmds, _gd_new(GD_RECT, x, y, w, h, color, 0, 0)); return 0; }
fn gd_push_border(cmds, x, y, w, h, color) { if (gd_culled(y, h) == 1) { return 0; } vec_push(cmds, _gd_new(GD_BORDER, x, y, w, h, color, 0, 0)); return 0; }
fn gd_push_text(cmds, x, y, color, text, max_cp) { if (gd_culled(y, GD_CULL_TEXT_H) == 1) { return 0; } vec_push(cmds, _gd_new(GD_TEXT, x, y, 0, 0, color, text, max_cp)); return 0; }
fn gd_push_clip(cmds, x, y, w, h) { vec_push(cmds, _gd_new(GD_CLIP_PUSH, x, y, w, h, 0, 0, 0)); return 0; }
fn gd_push_unclip(cmds) { vec_push(cmds, _gd_new(GD_CLIP_POP, 0, 0, 0, 0, 0, 0, 0)); return 0; }
