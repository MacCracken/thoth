# thoth — the T2 rich-TUI front-end (M7; landed 0.9.0, self-managed feed 0.9.1).
#
# The alt-screen, raw-mode interactive layout: a pinned status bar (row 1), a
# SELF-MANAGED feed (0.9.1: dispatch output is captured into the src/feed.cyr ring
# and painted here each frame — replacing 0.9.0's DECSTBM scroll-region trick, the
# prerequisite for the file-tree pane + instant SIGWINCH), and a raw-mode composer
# at the bottom. It is an ALTERNATIVE front-end to repl_loop(),
# selected only when the presentation tier is T2 (PT_RICH) on a real TTY; everywhere
# else the line-mode REPL stands in unchanged — degrade closed, port the floor.
# Built on the vendored darshana substrate (tty_raw/alt/move/winsize/...).
#
# DESIGN SPLIT: the line-editor state machine (led_*) and the layout geometry are
# PURE and unit-tested. The I/O loop (tui_loop) is raw-mode terminal control that
# only manifests on a live TTY — it is verified interactively, not in the harness.
# Command dispatch runs in COOKED mode so the existing read_line-based confirms
# (the t-ron gate) keep working; the composer's own editing is raw.

# --- pure: the composer line editor ---------------------------------------

var COMPOSER_CAP = 4096;
var _composer = 0;          # the edit buffer (NUL-terminated), lazily alloc'd
var _comp_len = 0;          # bytes in the buffer
var _comp_cur = 0;          # cursor index [0.._comp_len]
var _tui_key_ch = 0;        # the byte for a KEY_CHAR (set by tui_read_key)
var _tui_line = 0;          # stable copy of a submitted line (the composer is cleared
                            # before dispatch, so the text can't be read from _composer)

# Decoded keys.
var KEY_NONE = 0;
var KEY_CHAR = 1;
var KEY_BACKSPACE = 2;
var KEY_ENTER = 3;
var KEY_CTRLC = 4;
var KEY_EOF = 5;              # real stdin EOF (read <=0), NOT the Ctrl-D keypress
var KEY_LEFT = 6;
var KEY_RIGHT = 7;
var KEY_HOME = 8;
var KEY_END = 9;
var KEY_KILL = 10;
var KEY_TOGGLE_STATUS = 11;   # Ctrl-G — toggle the pinned status bar
var KEY_TOGGLE_TREE = 12;     # Ctrl-B — toggle the file-tree pane (0.9.3)
var KEY_TAB = 13;             # Tab — cycle focus composer <-> tree
var KEY_UP = 14;              # CSI A — tree selection up
var KEY_DOWN = 15;            # CSI B — tree selection down
var KEY_SCROLL_UP = 16;       # Shift-Up (CSI 1;2A) — scroll the feed back (0.9.4)
var KEY_SCROLL_DOWN = 17;     # Shift-Down (CSI 1;2B) — scroll the feed forward
var KEY_PGUP = 18;            # PageUp (CSI 5~) — page the feed back
var KEY_PGDN = 19;            # PageDown (CSI 6~) — page the feed forward
var KEY_TOGGLE_THEME = 20;    # Ctrl-T — toggle dark/light theme (0.10.0)
var KEY_NEWLINE = 21;         # Shift-Enter (kitty CSI-u) / Alt-Enter (ESC CR) — insert a newline (0.11.9)
var KEY_PASTE = 22;           # bracketed paste: ESC[200~ … ESC[201~ — insert the whole paste (0.17.0)
var KEY_WORD_LEFT = 23;       # Ctrl/Alt-Left, Alt-b — move the cursor one word left (0.17.1)
var KEY_WORD_RIGHT = 24;      # Ctrl/Alt-Right, Alt-f — move the cursor one word right (0.17.1)
var KEY_DELWORD = 25;         # Ctrl-W — delete the word before the cursor (0.17.1)
var KEY_KILL_EOL = 26;        # Ctrl-K — kill from the cursor to the end of the line (0.17.1)
var KEY_MOUSE = 27;           # SGR mouse left-click (coords in _mouse_row/_mouse_col) (0.17.2)
var KEY_FIND = 28;            # Ctrl-F — enter feed search (0.18.4)
var KEY_ESC = 29;             # a lone Esc (best-effort) — closes search; a no-op elsewhere (0.18.4)
var KEY_REPROBE = 30;         # Ctrl-R — re-probe hoosh reachability (0.19.3)
var KEY_PICK = 31;            # Ctrl-P — open the model-picker palette (0.24.0)

# Focus targets (which surface the nav keys drive when the tree is shown).
var FOCUS_COMPOSER = 0;
var FOCUS_TREE = 1;

# --- feed search modal state (0.18.4) -------------------------------------
# A MODAL over the feed: while _fsearch_active, every key routes to _tui_search_key (the composer is inert;
# no turn runs). _fsearch_edit==1 = typing the query (incremental highlight + jump-to-newest), ==0 = nav
# (bare n/N jump). Armed only inside the PT_RICH TUI dispatch window — the piped/REPL floor never sees it.
var _fsearch_active = 0;
var _fsearch_edit = 0;
# --- model-picker modal state (0.24.0) ------------------------------------
# A MODAL over the feed band: while _mpick_active, every key routes to _tui_pick_key and the feed region is
# overwritten with the filtered model list (mpick.cyr owns the pure state; this file the render + switch).
# Armed only inside the PT_RICH TUI dispatch window; the piped/REPL floor never decodes Ctrl-P, so byte-identical.
var _mpick_active = 0;
var HL_CAP = 24576;           # == PAINT_CAP: the per-line highlighted-render scratch (fsearch_render dst)
var _hl_buf = 0;              # alloc(HL_CAP), lazy

# Editor outcomes.
var ACT_NONE = 0;
var ACT_SUBMIT = 1;
var ACT_EOF = 2;

fn led_reset() {
    if (_composer == 0) { _composer = alloc(COMPOSER_CAP); }
    _comp_len = 0;
    _comp_cur = 0;
    store8(_composer, 0);
    return 0;
}
fn led_buf() { if (_composer == 0) { led_reset(); } return _composer; }
fn led_len() { return _comp_len; }
fn led_cur() { return _comp_cur; }

# --- multi-line composer geometry (0.11.9) --------------------------------
# The composer buffer may hold embedded '\n' bytes (Shift/Alt-Enter). These PURE
# helpers split it into logical lines for the multi-row render + cursor parking. ONE
# logical line == ONE physical composer row (no in-composer soft-wrap), so led_lines()
# is the composer's height oracle. All are bounded by _comp_len / _comp_cur (both 0
# before led_reset alloc's the buffer), so they are safe even when _composer == 0.

# led_lines: number of logical lines = count of '\n' + 1 (>= 1, even when empty).
fn led_lines() {
    var n = 1;
    var i = 0;
    while (i < _comp_len) { if (load8(_composer + i) == 10) { n = n + 1; } i = i + 1; }
    return n;
}
# led_cursor_line: logical line index (0-based) the cursor sits on = '\n' count before it.
fn led_cursor_line() {
    var n = 0;
    var i = 0;
    while (i < _comp_cur) { if (load8(_composer + i) == 10) { n = n + 1; } i = i + 1; }
    return n;
}
# led_cursor_col: column within the cursor's logical line = bytes since the last '\n'.
fn led_cursor_col() {
    var c = 0;
    var i = 0;
    while (i < _comp_cur) {
        if (load8(_composer + i) == 10) { c = 0; } else { c = c + 1; }
        i = i + 1;
    }
    return c;
}
# led_line_start: byte offset of logical line `li` (li past the end clamps to _comp_len).
fn led_line_start(li) {
    if (li <= 0) { return 0; }
    var seen = 0;
    var i = 0;
    while (i < _comp_len) {
        if (load8(_composer + i) == 10) {
            seen = seen + 1;
            if (seen == li) { return i + 1; }
        }
        i = i + 1;
    }
    return _comp_len;
}
# led_line_len: byte length of logical line `li` (excludes the terminating '\n').
fn led_line_len(li) {
    var s = led_line_start(li);
    var e = s;
    while ((e < _comp_len) && (load8(_composer + e) != 10)) { e = e + 1; }
    return e - s;
}
# led_up / led_down: move the cursor to the same column on the adjacent logical line
# (clamped to that line's length). Return 1 if it moved between lines, 0 at the top/
# bottom edge — so the TUI loop falls through to input-history recall at the edges.
fn led_up() {
    var cl = led_cursor_line();
    if (cl == 0) { return 0; }                   # first line -> edge
    var col = led_cursor_col();
    var pl = led_line_len(cl - 1);
    if (col > pl) { col = pl; }
    _comp_cur = led_line_start(cl - 1) + col;
    return 1;
}
fn led_down() {
    var cl = led_cursor_line();
    if (cl >= (led_lines() - 1)) { return 0; }   # last line -> edge
    var col = led_cursor_col();
    var nl = led_line_len(cl + 1);
    if (col > nl) { col = nl; }
    _comp_cur = led_line_start(cl + 1) + col;
    return 1;
}

# _tui_copy_line: snapshot the composer into _tui_line (a stable cstr) so a submitted
# line survives led_reset() — the composer is cleared BEFORE the (slow) dispatch.
fn _tui_copy_line() {
    if (_tui_line == 0) { _tui_line = alloc(COMPOSER_CAP); }
    var n = _comp_len;
    var i = 0;
    while (i < n) { store8(_tui_line + i, load8(_composer + i)); i = i + 1; }
    store8(_tui_line + n, 0);
    return _tui_line;
}

# --- composer input-history recall glue (0.11.1) --------------------------
# The pure ring + nav cursor live in src/inhist.cyr; this is the TUI glue that
# stashes the in-progress draft and loads a recalled line into the led_* composer.
# Up recalls older submitted lines, Down newer; past the newest, the stashed draft
# returns. Bound only in composer focus with the slash palette closed at the START of
# recall (so Up/Down stay free while you compose a /command) — see tui_loop. Pure
# memory ops over the composer buffer; no dispatch, no I/O.
var _recall_draft = 0;        # stash of the in-progress composer line during recall
var _recall_draft_len = 0;

# _tui_recall_stash_draft: snapshot the live composer into the draft stash, so Down
# can restore exactly what the user was typing before they reached for history.
fn _tui_recall_stash_draft() {
    if (_recall_draft == 0) { _recall_draft = alloc(COMPOSER_CAP); }
    var src = led_buf();
    var n = _comp_len;
    var i = 0;
    while (i < n) { store8(_recall_draft + i, load8(src + i)); i = i + 1; }
    store8(_recall_draft + n, 0);
    _recall_draft_len = n;
    return 0;
}

# _tui_recall_set: load (src,len) into the composer, cursor at end, NUL-terminated.
# Shared by load-entry and restore-draft. Clamps to the composer cap (defensive — a
# recalled line / stashed draft is already <= COMPOSER_CAP-1).
fn _tui_recall_set(src, len) {
    var buf = led_buf();
    var n = len;
    if (n > (COMPOSER_CAP - 1)) { n = COMPOSER_CAP - 1; }
    var i = 0;
    while (i < n) { store8(buf + i, load8(src + i)); i = i + 1; }
    store8(buf + n, 0);
    _comp_len = n;
    _comp_cur = n;
    return 0;
}
fn _tui_recall_load(idx) { _tui_recall_set(inhist_entry_ptr(idx), inhist_entry_len(idx)); return 0; }
fn _tui_recall_restore_draft() { _tui_recall_set(_recall_draft, _recall_draft_len); return 0; }

# _tui_recall_key: fold one Up/Down into history recall. Up stashes the draft on the
# first step then walks older; Down walks newer and restores the draft past the
# newest. Redraws the composer + hint (a recalled "/cmd" re-opens the palette).
fn _tui_recall_key(key) {
    var before_h = tui_cur_composer_height();   # a recalled entry can be multi-line -> reflow on change
    if (key == KEY_UP) {
        if (inhist_count() == 0) { return 0; }                      # nothing to recall
        if (inhist_nav_at_draft() == 1) { _tui_recall_stash_draft(); }
        var idx = inhist_nav_up();
        if (idx >= 0) { _tui_recall_load(idx); }
        tui_after_edit(before_h);
        return 0;
    }
    # KEY_DOWN
    if (inhist_nav_at_draft() == 1) { return 0; }                   # already editing the draft
    var d = inhist_nav_down();
    if (d < 0) { _tui_recall_restore_draft(); } else { _tui_recall_load(d); }
    tui_after_edit(before_h);
    return 0;
}

# --- word-wise editing helpers (0.17.1; PURE, unit-tested) ------------------
# A word separator is a space or a newline (the multi-line composer's whitespace); every other
# byte (punctuation included) is a word char — the WERASE/bash convention, used consistently by
# word motion AND Ctrl-W so they agree on boundaries.
fn _led_is_wsep(ch) { if ((ch == 32) || (ch == 10)) { return 1; } return 0; }

# _led_word_left / _led_word_right: the word-boundary index left/right of the cursor over the flat
# buffer (crossing embedded newlines, which count as separators). The `i > 0` term is FIRST in each
# leftward loop so && short-circuits BEFORE the load8(_composer + i - 1) — no OOB read at column 0
# / on an empty buffer (the discipline the KEY_LEFT outer guard uses).
fn _led_word_left() {
    var i = _comp_cur;
    while ((i > 0) && (_led_is_wsep(load8(_composer + i - 1)) == 1)) { i = i - 1; }     # skip separators
    while ((i > 0) && (_led_is_wsep(load8(_composer + i - 1)) == 0)) { i = i - 1; }     # skip the word
    return i;
}
fn _led_word_right() {
    var i = _comp_cur;
    while ((i < _comp_len) && (_led_is_wsep(load8(_composer + i)) == 1)) { i = i + 1; }  # skip separators
    while ((i < _comp_len) && (_led_is_wsep(load8(_composer + i)) == 0)) { i = i + 1; }  # skip the word
    return i;
}

# _led_delword: delete [word-start, cursor) — Ctrl-W (unix-word-rubout). Shifts the tail down by
# the same bounded `i + gap < _comp_len` idiom as backspace; re-NUL at the new length; the cursor
# lands at the word start. No-op when there is nothing to the left.
fn _led_delword() {
    var s = _led_word_left();
    if (s >= _comp_cur) { return 0; }
    var gap = _comp_cur - s;
    var i = s;
    while ((i + gap) < _comp_len) { store8(_composer + i, load8(_composer + i + gap)); i = i + 1; }
    _comp_len = _comp_len - gap;
    _comp_cur = s;
    store8(_composer + _comp_len, 0);
    return 0;
}

# _led_kill_eol: kill from the cursor to the end of the current logical line — Ctrl-K. If the cursor
# is already at end-of-line (sitting on a newline) delete that newline instead (join the next line,
# the emacs/readline semantics); at the very end of the buffer it is a no-op. The cursor stays put.
fn _led_kill_eol() {
    var e = _comp_cur;
    while ((e < _comp_len) && (load8(_composer + e) != 10)) { e = e + 1; }
    if (e == _comp_cur) {
        if (e < _comp_len) { e = e + 1; }   # at eol on a newline -> delete it (join the next line)
        else { return 0; }                   # at the buffer end -> nothing to kill
    }
    var gap = e - _comp_cur;
    var i = _comp_cur;
    while ((i + gap) < _comp_len) { store8(_composer + i, load8(_composer + i + gap)); i = i + 1; }
    _comp_len = _comp_len - gap;
    store8(_composer + _comp_len, 0);
    return 0;
}

# led_feed: fold one decoded key into the editor; return ACT_NONE / ACT_SUBMIT (the
# line is ready in led_buf) / ACT_EOF (empty-buffer Ctrl-D). Pure (mutates the buf).
fn led_feed(key, ch) {
    if (_composer == 0) { led_reset(); }
    if ((key == KEY_CHAR) || (key == KEY_NEWLINE)) {
        # KEY_NEWLINE inserts a literal '\n' (10); KEY_CHAR inserts the decoded byte.
        # The composer buffer holds embedded newlines now (0.11.9 multi-line composer);
        # plain Enter (KEY_ENTER, below) still submits the WHOLE buffer.
        var ins = ch;
        if (key == KEY_NEWLINE) { ins = 10; }
        if (_comp_len < (COMPOSER_CAP - 1)) {
            var i = _comp_len;
            while (i > _comp_cur) { store8(_composer + i, load8(_composer + i - 1)); i = i - 1; }
            store8(_composer + _comp_cur, ins);
            _comp_len = _comp_len + 1;
            _comp_cur = _comp_cur + 1;
            store8(_composer + _comp_len, 0);
        }
        return ACT_NONE;
    }
    if (key == KEY_BACKSPACE) {
        if (_comp_cur > 0) {
            var i = _comp_cur - 1;
            while (i < (_comp_len - 1)) { store8(_composer + i, load8(_composer + i + 1)); i = i + 1; }
            _comp_len = _comp_len - 1;
            _comp_cur = _comp_cur - 1;
            store8(_composer + _comp_len, 0);
        }
        return ACT_NONE;
    }
    if (key == KEY_LEFT) { if (_comp_cur > 0) { _comp_cur = _comp_cur - 1; } return ACT_NONE; }
    if (key == KEY_RIGHT) { if (_comp_cur < _comp_len) { _comp_cur = _comp_cur + 1; } return ACT_NONE; }
    if (key == KEY_HOME) { _comp_cur = 0; return ACT_NONE; }
    if (key == KEY_END) { _comp_cur = _comp_len; return ACT_NONE; }
    if (key == KEY_WORD_LEFT) { _comp_cur = _led_word_left(); return ACT_NONE; }    # Ctrl/Alt-Left, Alt-b
    if (key == KEY_WORD_RIGHT) { _comp_cur = _led_word_right(); return ACT_NONE; }  # Ctrl/Alt-Right, Alt-f
    if (key == KEY_DELWORD) { _led_delword(); return ACT_NONE; }                    # Ctrl-W
    if (key == KEY_KILL_EOL) { _led_kill_eol(); return ACT_NONE; }                  # Ctrl-K
    if (key == KEY_KILL) { _comp_len = 0; _comp_cur = 0; store8(_composer, 0); return ACT_NONE; }
    if (key == KEY_CTRLC) { return ACT_EOF; }   # Ctrl-C exits unconditionally (interrupt), with teardown
    if (key == KEY_ENTER) { return ACT_SUBMIT; }
    if (key == KEY_EOF) { return ACT_EOF; }   # stdin closed -> end the session
    return ACT_NONE;
}

# led_insert_cstr: insert NUL-terminated `s` at the cursor via the tested led_feed KEY_CHAR path
# (byte-by-byte; excess dropped at COMPOSER_CAP by led_feed's own guard). Returns bytes inserted.
# Used by @file Tab completion (0.21.1). PURE (mutates the composer).
fn led_insert_cstr(s) {
    var before = _comp_len;
    var i = 0;
    while (load8(s + i) != 0) { led_feed(KEY_CHAR, load8(s + i)); i = i + 1; }
    return _comp_len - before;
}

# @file Tab completion (0.21.1): if the composer cursor sits at the end of a `@<prefix>` token, complete
# the path from the file tree and insert the suffix at the cursor. Returns 1 if a `@`-token was present
# (Tab is CONSUMED as completion — even when nothing further matches, so Tab never yanks focus to the
# tree mid-path), 0 otherwise (the caller falls through to the composer<->tree focus toggle). The scan
# rule (mention_prefix_at) is shared with the 0.21.0 injection, so what Tab completes is exactly what a
# submitted @mention expands. Completion is via ftree_complete (dir_list of the prefix's directory).
var _tui_atc_pfx = 0;         # reused: the @-token prefix (text after '@', NUL-terminated)
var _tui_atc_out = 0;         # reused: the completion suffix to insert
fn _tui_at_complete() {
    if (_composer == 0) { return 0; }
    var start = mention_prefix_at(_composer, _comp_cur);   # offset after '@', or -1
    if (start < 0) { return 0; }
    if (_tui_atc_pfx == 0) { _tui_atc_pfx = alloc(COMPOSER_CAP); }
    if (_tui_atc_out == 0) { _tui_atc_out = alloc(COMPOSER_CAP); }
    var plen = _comp_cur - start;
    var i = 0;
    while (i < plen) { store8(_tui_atc_pfx + i, load8(_composer + start + i)); i = i + 1; }
    store8(_tui_atc_pfx + plen, 0);
    ftree_complete(_tui_atc_pfx, _tui_atc_out, COMPOSER_CAP);
    if (load8(_tui_atc_out) != 0) { led_insert_cstr(_tui_atc_out); }   # non-empty suffix -> insert at cursor
    return 1;
}

# led_paste: insert a slurped bracketed-paste buffer `src` (`len` bytes) into the composer
# at the cursor, reusing the tested led_feed insert path one byte at a time (0.17.0). FILTER:
# LF/CR (and CRLF) collapse to a single '\n'; a tab becomes one space; printable ASCII plus
# high/UTF-8 bytes (>= 128) are kept; ESC, every other C0 control, and DEL (127) are DROPPED —
# so a paste can NEVER inject a terminal escape sequence into the composer render, and no
# control byte ever enters the buffer (the composer stays byte == column). Insertion stops at
# COMPOSER_CAP via led_feed's own guard (excess dropped). PURE (mutates the composer) — the
# correctness-critical half, unit-tested. It never submits (only KEY_NEWLINE/KEY_CHAR, both
# ACT_NONE); a leading '/' does not dispatch — the palette is a derivation of the buffer, not a
# flag, and any pasted space/newline makes tui_palette_active() false.
fn led_paste(src, len) {
    var i = 0;
    while (i < len) {
        var b = load8(src + i) & 255;
        if ((b == 10) || (b == 13)) {
            led_feed(KEY_NEWLINE, 0);
            # CRLF -> one newline: after a CR, swallow a following LF (guard the source boundary).
            if ((b == 13) && ((i + 1) < len) && ((load8(src + i + 1) & 255) == 10)) { i = i + 1; }
        } elif (b == 9) {
            led_feed(KEY_CHAR, 32);                       # tab -> a single space (composer stays printable)
        } elif ((b >= 32) && (b != 127)) {
            led_feed(KEY_CHAR, b);                        # printable ASCII + high/UTF-8 bytes
        }
        # else: ESC (27), other C0 controls, DEL (127) -> dropped (no escape-injection surface)
        i = i + 1;
    }
    return 0;
}

# --- pure: layout geometry (0.11.9: faint rules + dynamic multi-line composer) ---
# Bands top-to-bottom (status shown): row 1 status · row 2 TOP RULE · feed ·
# BOTTOM RULE · the composer block (1..MAX rows, grows upward with line count) ·
# last row hint. Toggling the status bar off frees rows 1-2 into the feed (no status =
# no top rule); the bottom rule above the composer always stands. The composer height
# tracks led_lines(), clamped so the feed keeps at least MIN_FEED row(s). These are PURE
# and take explicit (rows, lines, show) params — mirroring tui_tree_w/tui_feed_width — so
# they unit-test without mutating the composer/show globals.
var COMPOSER_MAX_ROWS = 8;    # the composer never grows past this (a long paste scrolls within)
var MIN_FEED = 1;             # the feed never shrinks below this many rows

fn tui_status_row() { return 1; }
fn tui_hint_row(rows) { return rows; }
fn tui_sep_top_row() { return 2; }                 # the rule under the status bar (status shown only)
# tui_composer_max: the largest composer height that still leaves MIN_FEED feed rows,
# capped at COMPOSER_MAX_ROWS. chrome above+below the feed = status+2rules+hint (4) when
# status shown, else bottom-rule+hint (2). Clamped to >= 1.
fn tui_composer_max(rows, show) {
    var chrome = 2;
    if (show == 1) { chrome = 4; }
    var m = rows - chrome - MIN_FEED;
    if (m < 1) { m = 1; }
    if (m > COMPOSER_MAX_ROWS) { m = COMPOSER_MAX_ROWS; }
    return m;
}
# tui_composer_height: composer rows = led line count, clamped to [1, tui_composer_max].
fn tui_composer_height(rows, lines, show) {
    var h = lines;
    if (h < 1) { h = 1; }
    var mx = tui_composer_max(rows, show);
    if (h > mx) { h = mx; }
    return h;
}
fn tui_composer_bot(rows) { return rows - 1; }     # composer block's last row (above the hint)
fn tui_composer_top(rows, lines, show) { return rows - tui_composer_height(rows, lines, show); }
fn tui_sep_bottom_row(rows, lines, show) { return tui_composer_top(rows, lines, show) - 1; }
fn tui_feed_top(show_status) { if (show_status == 1) { return 3; } return 1; }
fn tui_feed_bot(rows, lines, show) { return tui_sep_bottom_row(rows, lines, show) - 1; }
# _comp_vscroll_first: first visible logical line so cursor line `cl` stays within a
# window of `height` rows over `total` logical lines (mirrors _ftree_scroll_first). Pure.
fn _comp_vscroll_first(cl, total, height) {
    var first = 0;
    if (cl >= height) { first = cl - height + 1; }
    var maxfirst = total - height;
    if (maxfirst < 0) { maxfirst = 0; }
    if (first > maxfirst) { first = maxfirst; }
    if (first < 0) { first = 0; }
    return first;
}

# --- I/O: raw-mode terminal control (verified on a live TTY) ---------------

var _tui_running = 0;
var _tui_show_status = 1;   # togglable (Ctrl-G)
var _tui_show_tree = 0;     # the file-tree pane (Ctrl-B), hidden by default (0.9.3)
var _tui_focus = 0;         # FOCUS_COMPOSER / FOCUS_TREE — which surface nav keys drive
var _tui_rows = 24;
var _tui_cols = 80;

# tui_active: 1 if the T2 front-end should drive this session (PT_RICH + a real tty).
fn tui_active() {
    if (ui_tier() != PT_RICH) { return 0; }
    if (tty_isatty(0) == 0) { return 0; }
    if (tty_isatty(1) == 0) { return 0; }
    return 1;
}

# _tui_kitty_u: map a kitty CSI-u key event (base codepoint `cp`, modifier `mod` = 1 +
# bitmask: shift 1, alt 2, ctrl 4; -1 == none) to a KEY_*. The kitty keyboard protocol
# (pushed with `CSI > 1 u`, disambiguate flag) sends Esc + ctrl/alt-combos as `CSI cp;modu`
# instead of their legacy control bytes — so on kitty/ghostty/wezterm/foot the Ctrl-keys
# arrive HERE, not as bytes 24/3/21/... in tui_read_key. We decode them back to the same
# keys (or exit/toggles break under kitty). Enter (13) + any modifier inserts a newline —
# this is the Shift+Enter path. Ctrl-letters report the UNSHIFTED letter codepoint.
fn _tui_kitty_u(cp, modk) {
    if (cp == 13) {                          # Enter
        if (modk >= 2) { return KEY_NEWLINE; }  # Shift/Alt/Ctrl+Enter -> newline
        return KEY_ENTER;                       # bare CSI 13 u (defensive; plain Enter stays legacy)
    }
    if (modk == 5) {                         # Ctrl (1 + 0b100)
        if (cp == 120) { return KEY_CTRLC; }        # Ctrl-X (exit)
        if (cp == 99) { return KEY_CTRLC; }         # Ctrl-C
        if (cp == 117) { return KEY_KILL; }         # Ctrl-U (kill line)
        if (cp == 97) { return KEY_HOME; }          # Ctrl-A
        if (cp == 101) { return KEY_END; }          # Ctrl-E
        if (cp == 103) { return KEY_TOGGLE_STATUS; }# Ctrl-G
        if (cp == 98) { return KEY_TOGGLE_TREE; }   # Ctrl-B
        if (cp == 116) { return KEY_TOGGLE_THEME; } # Ctrl-T
        if (cp == 119) { return KEY_DELWORD; }      # Ctrl-W (delete word) (0.17.1)
        if (cp == 107) { return KEY_KILL_EOL; }     # Ctrl-K (kill to EOL) (0.17.1)
        if (cp == 102) { return KEY_FIND; }         # Ctrl-F (feed search) (0.18.4)
        if (cp == 114) { return KEY_REPROBE; }      # Ctrl-R (re-probe hoosh) (0.19.3)
        if (cp == 112) { return KEY_PICK; }         # Ctrl-P (model picker) (0.24.0)
    }
    if (modk == 3) {                         # Alt (1 + 0b010) (0.17.1)
        if (cp == 98) { return KEY_WORD_LEFT; }     # Alt-b -> word left
        if (cp == 102) { return KEY_WORD_RIGHT; }   # Alt-f -> word right
    }
    return KEY_NONE;                          # Esc (27) + unmapped combos -> ignore
}

# _tui_csi_final: map a parsed CSI sequence (final byte `final`, params p1 / p2; p2 == -1
# when absent) to a KEY_*. One table for ALL CSI forms: arrows/Home/End (no-param letter
# finals), the Shift-arrow feed-scroll keys (1;2A/B), PageUp/Dn (5~/6~), and the kitty
# CSI-u keys (final 'u'). Unmodified arrows and the legacy '~'/'A'/'B' forms keep their
# exact prior behavior, so a non-kitty terminal decodes byte-identically to before.
fn _tui_csi_final(final, p1, p2) {
    if (final == 65) { if (p2 == 2) { return KEY_SCROLL_UP; } return KEY_UP; }     # 'A' Up / Shift+Up (mod 2)
    if (final == 66) { if (p2 == 2) { return KEY_SCROLL_DOWN; } return KEY_DOWN; } # 'B' Down / Shift+Down (mod 2)
    if (final == 67) { if (p2 >= 3) { return KEY_WORD_RIGHT; } return KEY_RIGHT; }  # 'C' Right / Ctrl|Alt+Right (mod>=3) -> word (0.17.1)
    if (final == 68) { if (p2 >= 3) { return KEY_WORD_LEFT; } return KEY_LEFT; }    # 'D' Left / Ctrl|Alt+Left -> word (0.17.1)
    if (final == 72) { return KEY_HOME; }                                           # 'H'
    if (final == 70) { return KEY_END; }                                            # 'F'
    if (final == 126) {                                                             # '~' (p1 is the parsed int)
        if (p1 == 5) { return KEY_PGUP; }                                           # CSI 5~ PageUp
        if (p1 == 6) { return KEY_PGDN; }                                           # CSI 6~ PageDown
        if (p1 == 200) { return KEY_PASTE; }                                        # CSI 200~ bracketed-paste BEGIN (0.17.0)
        return KEY_NONE;                                                            # CSI 201~ (paste END) also lands here -> ignored
    }
    if (final == 117) { return _tui_kitty_u(p1, p2); }                              # 'u' kitty CSI-u
    return KEY_NONE;
}

# --- bracketed paste (0.17.0): slurp ESC[200~ … ESC[201~ into a bounded buffer ---------
var PASTE_CAP = 4096;         # content buffer cap (== COMPOSER_CAP; a paste can't outgrow the composer)
var _paste_buf = 0;           # lazily-alloc'd slurp buffer
var _paste_len = 0;           # content bytes buffered by the last slurp

# _paste_end: the i-th byte of the bracketed-paste END marker "ESC [ 2 0 1 ~" (i in 0..5).
fn _paste_end(i) {
    if (i == 0) { return 27; }    # ESC
    if (i == 1) { return 91; }    # [
    if (i == 2) { return 50; }    # 2
    if (i == 3) { return 48; }    # 0
    if (i == 4) { return 49; }    # 1
    return 126;                    # ~
}

# _paste_commit: the SINGLE writer into _paste_buf — append `b` iff there is room, silently
# dropping past PASTE_CAP (the excess can't fit the composer anyway, and the slurp keeps
# consuming to the END marker regardless, so the input stream never desyncs). The partial-
# marker flush routes through here too (never a raw store), so a near-miss at the cap boundary
# can never write past the buffer (design-review fold, 0.17.0).
fn _paste_commit(b) {
    if (_paste_len < PASTE_CAP) { store8(_paste_buf + _paste_len, b); _paste_len = _paste_len + 1; }
    return 0;
}

# _tui_paste_slurp: called once ESC[200~ is decoded (the fd sits at the first content byte).
# Read stdin a byte at a time into _paste_buf until the ESC[201~ END marker (or EOF). `m` is
# how many END bytes match so far; a mismatch FLUSHES the provisionally-matched bytes as real
# content and re-anchors on the breaking byte — ESC (== END[0]) is the ONLY byte that restarts
# a match, so the single `b == 27` case is the complete restart rule for this marker (END has
# an empty self-border). The END marker itself is consumed but NOT buffered. I/O — verified on
# a live tty, not the harness (same blocking-read idiom as tui_read_key's CSI parse).
fn _tui_paste_slurp() {
    if (_paste_buf == 0) { _paste_buf = alloc(PASTE_CAP); }
    _paste_len = 0;
    var m = 0;
    var c[8];
    var go = 1;
    while (go == 1) {
        if (syscall(SYS_READ, 0, &c, 1) <= 0) {
            var j = 0;
            while (j < m) { _paste_commit(_paste_end(j)); j = j + 1; }   # EOF mid-marker: keep the partial as content
            go = 0;
        } else {
            var b = load8(&c);
            if (b == _paste_end(m)) {
                m = m + 1;
                if (m == 6) { go = 0; }                                  # full ESC[201~ consumed (not buffered) -> done
            } else {
                var k = 0;
                while (k < m) { _paste_commit(_paste_end(k)); k = k + 1; }   # flush the near-miss as content
                m = 0;
                if (b == 27) { m = 1; } else { _paste_commit(b); }       # ESC re-anchors; else b is content
            }
        }
    }
    return 0;
}

# --- SGR mouse (0.17.2): decode ESC[<Cb;Cx;Cy(M|m) ------------------------
var _mouse_row = 0;           # last click row (1-based), set by _tui_read_mouse
var _mouse_col = 0;           # last click column (1-based)

# _tui_mouse_decode: map an SGR button code `cb` + final byte (`M`=77 press / `m`=109 release,
# 0 = no terminator seen) to a KEY_*. PURE, unit-tested. The xterm SGR button layout: low 2 bits
# = button (0 left / 1 middle / 2 right), bit 2/3/4 = Shift/Meta/Ctrl (ignored here), bit 5 (32) =
# motion, bit 6 (64) = wheel. Wheel is gated on button 0/1 so a horizontal wheel (66/67) is ignored
# rather than scrolling vertically; only a LEFT PRESS (not motion, not release) becomes a click.
fn _tui_mouse_decode(cb, final) {
    if (final == 0) { return KEY_NONE; }                 # no terminator (EOF / malformed)
    if ((cb & 64) != 0) {                                # a wheel event
        var btn = cb & 3;
        if (btn == 0) { return KEY_SCROLL_UP; }          # wheel up (64) -> scroll feed back
        if (btn == 1) { return KEY_SCROLL_DOWN; }        # wheel down (65) -> scroll feed forward
        return KEY_NONE;                                 # horizontal wheel (66/67) -> ignore
    }
    if (final == 77) {                                   # a PRESS ('M'); release ('m') is ignored
        if (((cb & 3) == 0) && ((cb & 32) == 0)) { return KEY_MOUSE; }   # left button, not motion
    }
    return KEY_NONE;                                     # middle/right / release / motion
}

# _tui_read_mouse: the fd sits just after ESC[< — read Cb;Cx;Cy and the final M/m, decode, and stash
# the click coords for _tui_mouse_click. Reads until the terminator or EOF (a well-formed SGR report
# always ends in M/m, both < 128; a dead tty breaks via read <= 0 -> final 0 -> KEY_NONE). I/O —
# verified on a live tty, not the harness.
fn _tui_read_mouse() {
    var cb = 0; var cx = 0; var cy = 0;
    var field = 0;               # 0 = Cb, 1 = Cx, 2 = Cy
    var fin = 0;
    var c[8];
    var go = 1;
    while (go == 1) {
        if (syscall(SYS_READ, 0, &c, 1) <= 0) { go = 0; }         # EOF -> stop (fin stays 0)
        else {
            var t = load8(&c);
            if ((t == 77) || (t == 109)) { fin = t; go = 0; }     # 'M' press / 'm' release -> terminator
            elif (t == 59) { field = field + 1; }                 # ';' -> next field
            elif ((t >= 48) && (t <= 57)) {                       # a digit
                var d = t - 48;
                if (field == 0) { cb = cb * 10 + d; }
                elif (field == 1) { cx = cx * 10 + d; }
                elif (field == 2) { cy = cy * 10 + d; }
            }
            # else: ignore stray bytes (never emitted by a well-formed SGR report)
        }
    }
    var k = _tui_mouse_decode(cb, fin);
    if (k == KEY_MOUSE) { _mouse_row = cy; _mouse_col = cx; }
    return k;
}

# tui_read_key: read + decode one keypress in raw mode (ASCII + CSI arrows/home/end/
# page + the kitty CSI-u keys). KEY_CHAR sets _tui_key_ch. stdin EOF -> KEY_EOF. Ctrl-X /
# Ctrl-C close; Ctrl-D is NOT bound (a stray Ctrl-D is ignored). Alt+Enter (ESC CR) and
# Shift+Enter (kitty CSI 13;2u) decode to KEY_NEWLINE (0.11.9). A bracketed-paste begin
# marker (ESC[200~) slurps the paste body into _paste_buf and returns KEY_PASTE (0.17.0);
# an SGR mouse intro (ESC[<) reads the event and returns a wheel/scroll or KEY_MOUSE (0.17.2).
fn tui_read_key() {
    var c[8];
    if (syscall(SYS_READ, 0, &c, 1) <= 0) { return KEY_EOF; }
    var b = load8(&c);
    if (b == 13) { return KEY_ENTER; }
    if (b == 10) { return KEY_ENTER; }
    if (b == 127) { return KEY_BACKSPACE; }
    if (b == 8) { return KEY_BACKSPACE; }
    if (b == 24) { return KEY_CTRLC; }   # Ctrl-X — clean unconditional close (no signal semantics)
    if (b == 3) { return KEY_CTRLC; }    # Ctrl-C — fallback close
    if (b == 21) { return KEY_KILL; }
    if (b == 1) { return KEY_HOME; }
    if (b == 5) { return KEY_END; }
    if (b == 7) { return KEY_TOGGLE_STATUS; }   # Ctrl-G
    if (b == 2) { return KEY_TOGGLE_TREE; }     # Ctrl-B — toggle the file-tree pane
    if (b == 20) { return KEY_TOGGLE_THEME; }   # Ctrl-T — toggle dark/light theme
    if (b == 23) { return KEY_DELWORD; }        # Ctrl-W — delete the word before the cursor (0.17.1)
    if (b == 11) { return KEY_KILL_EOL; }       # Ctrl-K — kill from the cursor to end of line (0.17.1)
    if (b == 6) { return KEY_FIND; }            # Ctrl-F — enter feed search (0.18.4)
    if (b == 18) { return KEY_REPROBE; }        # Ctrl-R — re-probe hoosh reachability (0.19.3)
    if (b == 16) { return KEY_PICK; }           # Ctrl-P — open the model-picker palette (0.24.0)
    if (b == 9) { return KEY_TAB; }             # Tab — cycle composer <-> tree focus
    if (b == 27) {
        if (syscall(SYS_READ, 0, &c, 1) <= 0) { return KEY_NONE; }
        var a = load8(&c);
        if ((a == 13) || (a == 10)) { return KEY_NEWLINE; }   # Alt+Enter (legacy ESC CR/LF) -> newline
        if (a == 98) { return KEY_WORD_LEFT; }                 # Alt-b -> word left (7-bit meta / ESC-prefix; 8-bit meta unhandled) (0.17.1)
        if (a == 102) { return KEY_WORD_RIGHT; }               # Alt-f -> word right (0.17.1)
        if (a != 91) { return KEY_ESC; }                       # not CSI '[' (incl. a lone Esc) -> KEY_ESC (0.18.4: closes search; a no-op elsewhere, byte-identical to the old KEY_NONE — the trailing byte was already consumed here)
        # General CSI parse: drain the parameter/intermediate bytes (0x30-0x3F: digits, ';',
        # ':' …) accumulating p1 and an optional p2 (after the first ';'), and stop at the
        # final byte (0x40-0x7E). ONE parser for every CSI form — arrows, Home/End, PageUp/Dn,
        # the Shift-arrow feed-scroll keys (1;2A/B), and the kitty CSI-u keys (<cp>;<mod>u).
        # ':' sub-params and extra ';' groups are drained, never leaked into the composer.
        var p1 = 0;
        var p2 = 0 - 1;
        var semi = 0;
        if (syscall(SYS_READ, 0, &c, 1) <= 0) { return KEY_NONE; }
        var t = load8(&c);
        if (t == 60) { return _tui_read_mouse(); }            # ESC[< -> SGR mouse event (0.17.2)
        var go = 1;
        while (go == 1) {
            if ((t >= 64) && (t <= 126)) { go = 0; }              # final byte -> done (t holds it)
            else {
                if ((t >= 48) && (t <= 57)) {                     # a digit
                    if (semi == 0) { p1 = p1 * 10 + (t - 48); }
                    elif (semi == 1) { if (p2 < 0) { p2 = 0; } p2 = p2 * 10 + (t - 48); }
                } elif (t == 59) { semi = semi + 1; }             # ';' -> next parameter group
                if (syscall(SYS_READ, 0, &c, 1) <= 0) { return KEY_NONE; }
                t = load8(&c);
            }
        }
        var k = _tui_csi_final(t, p1, p2);
        if (k == KEY_PASTE) { _tui_paste_slurp(); }   # 0.17.0: read the paste body up to ESC[201~ into _paste_buf
        return k;
    }
    if ((b >= 32) && (b < 127)) { _tui_key_ch = b; return KEY_CHAR; }
    return KEY_NONE;
}

# _tui_scroll_region: set DECSTBM to rows [top,bot] (1-indexed) — ESC[top;botr.
# Built byte-wise (ESC is a control char, not a source literal).
fn _tui_scroll_region(top, bot) {
    var b[24];
    var o = 0;
    store8(&b + o, 27); o = o + 1;        # ESC
    store8(&b + o, 91); o = o + 1;        # [
    o = _append_int(&b, o, top);
    store8(&b + o, 59); o = o + 1;        # ;
    o = _append_int(&b, o, bot);
    store8(&b + o, 114); o = o + 1;       # r
    store8(&b + o, 0);
    emit(&b);
    return 0;
}

# tui_draw_status: render the pinned status bar at row 1 (or clear it when hidden).
# ◆ thoth · model · the live presentation tier. Cursor is left for the caller to
# reposition at the composer.
fn tui_draw_status() {
    tty_move(1, 1);
    tty_clear_to_eol();
    if (_tui_show_status == 0) { return 0; }
    emit(ui_sgr(ROLE_ACCENT)); emit("{(o> thoth (");  # the owl prompt doubles as the brand glyph
    emit(thoth_version()); emit(")"); emit(ui_reset());
    ui_emit(ROLE_FAINT, " · "); ui_emit(ROLE_ACCENT_DIM, persona_name());   # active avatara persona (0.22.0)
    ui_emit(ROLE_FAINT, "  model ");
    ui_emit(ROLE_ACCENT, _hoosh_model());
    # hoosh spine-health dot (0.19.3): green ● up / red ● down / faint ○ unknown — driven by the last turn's
    # transport outcome or a Ctrl-R re-probe (no idle poll). Shown only when a gateway is configured.
    if (config_hoosh_configured() == 1) {
        emit(" ");
        var hh = hoosh_health();
        if (hh == HOOSH_HEALTH_UP) { ui_emit(ROLE_GREEN, "●"); }
        elif (hh == HOOSH_HEALTH_DOWN) { ui_emit(ROLE_RED, "●"); }
        else { ui_emit(ROLE_FAINT, "○"); }
    }
    ui_emit(ROLE_FAINT, "  turns ");
    emit(ui_sgr(ROLE_FG)); fmt_int(session_turns()); emit(ui_reset());
    # ctx: framed history bytes vs the ~32 KiB evict boundary (0.19.0). Omitted when single-turn / empty
    # (ADR-0010); the number turns RED once oldest turns start being evicted from the request.
    if ((config_hoosh_history() == 1) && (session_history_len() > 0)) {
        ui_emit(ROLE_FAINT, "  ctx ");
        if (hoosh_ctx_evicted() > 0) { emit(ui_sgr(ROLE_RED)); } else { emit(ui_sgr(ROLE_FG)); }
        fmt_int((hoosh_ctx_bytes() + 512) / 1024); emit("K"); emit(ui_reset());
        emit(ui_sgr(ROLE_FAINT)); emit("/"); fmt_int(hoosh_ctx_budget() / 1024); emit("K"); emit(ui_reset());
    }
    # tok: omitted until hoosh reports usage (0.10.2, ADR-0010 — never a placeholder).
    if (session_tokens_seen() == 1) {
        ui_emit(ROLE_FAINT, "  tok ");
        emit(ui_sgr(ROLE_FG)); fmt_int(session_tokens()); emit(ui_reset());
    }
    # cost: omitted until a priced response accumulates (0.10.3, ADR-0010).
    if (session_cost_seen() == 1) {
        var _cbuf[24];
        cost_fmt(&_cbuf, session_cost_micro());
        ui_emit(ROLE_FAINT, "  ");
        emit(ui_sgr(ROLE_GREEN)); emit(&_cbuf); emit(ui_reset());
    }
    # git: branch (+dirty count), omitted when there is no repo at cwd (0.13.0,
    # ADR-0010 — never a faked branch). Reads the cache (probed at startup + after
    # each turn + on /state|/git); the status paint never walks the worktree itself.
    if (git_present() == 1) {
        ui_emit(ROLE_FAINT, "  ");
        emit(ui_sgr(ROLE_ACCENT));
        if (git_detached() == 1) { emit("(detached)"); } else { emit(git_branch()); }
        emit(ui_reset());
        if (git_dirty() > 0) {
            ui_emit(ROLE_FAINT, " +"); emit(ui_sgr(ROLE_FG)); fmt_int(git_dirty()); emit(ui_reset());
        }
    }
    ui_emit(ROLE_FAINT, "  surface ");
    ui_emit(ROLE_GREEN, ui_tier_name());
    ui_emit(ROLE_FAINT, "  theme ");
    ui_emit(ROLE_ACCENT, ui_theme_name());
    return 0;
}

# --- slash-command palette ------------------------------------------------
# While the composer holds a partial '/command' token (no space yet), the hint row
# becomes a filtered list of matching commands. The matchers are pure + unit-tested;
# the render is I/O. (A multi-row dropdown above the composer is a later refinement —
# it needs the feed-buffer redraw model.)
var SLASH_N = 18;
fn _slash_name(i) {
    if (i == 0) { return "/help"; }
    if (i == 1) { return "/seams"; }
    if (i == 2) { return "/state"; }
    if (i == 3) { return "/model"; }
    if (i == 4) { return "/models"; }
    if (i == 5) { return "/read"; }
    if (i == 6) { return "/write"; }
    if (i == 7) { return "/run"; }
    if (i == 8) { return "/tools"; }
    if (i == 9) { return "/call"; }
    if (i == 10) { return "/audit"; }
    if (i == 11) { return "/reset"; }
    if (i == 12) { return "/clear"; }
    if (i == 13) { return "/theme"; }
    if (i == 14) { return "/dry"; }
    if (i == 15) { return "/copy"; }
    if (i == 16) { return "/find"; }
    if (i == 17) { return "/quit"; }
    return "";
}
# _buf_has_space: 1 if buf[0..n) holds a space OR a newline — either terminates the
# leading command token (a newline means a multi-line buffer, never a /command typed).
fn _buf_has_space(buf, n) {
    var i = 0;
    while (i < n) { if ((load8(buf + i) == 32) || (load8(buf + i) == 10)) { return 1; } i = i + 1; }
    return 0;
}
# tui_palette_count: how many slash commands start with NUL-terminated `prefix`.
fn tui_palette_count(prefix) {
    var c = 0;
    var i = 0;
    while (i < SLASH_N) {
        if (cstr_starts_with(_slash_name(i), prefix) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}
# tui_palette_active: 1 if the composer is mid-typing a '/command' token.
fn tui_palette_active() {
    if (led_len() == 0) { return 0; }
    if (load8(led_buf()) != 47) { return 0; }                      # not a '/'
    if (_buf_has_space(led_buf(), led_len()) == 1) { return 0; }   # token complete
    return 1;
}
# tui_draw_palette: render the matching commands (accent) for the current prefix.
fn tui_draw_palette() {
    var prefix = led_buf();
    var any = 0;
    var i = 0;
    while (i < SLASH_N) {
        if (cstr_starts_with(_slash_name(i), prefix) == 1) {
            emit(" "); ui_emit(ROLE_ACCENT, _slash_name(i));
            any = 1;
        }
        i = i + 1;
    }
    if (any == 0) { ui_emit(ROLE_FAINT, "  (no command — Enter sends as a task)"); }
    return 0;
}

# tui_draw_hint: the bottom strip — the slash-command palette while typing a
# '/command', else the keybinding hints. Discoverability matters without a mouse.
fn tui_draw_hint() {
    tty_move(tui_hint_row(_tui_rows), 1);
    tty_clear_to_eol();
    if (_mpick_active == 1) { _tui_draw_pick_hint(); return 0; }       # 0.24.0: the picker strip owns the hint row
    if (_fsearch_active == 1) { _tui_draw_search_hint(); return 0; }   # 0.18.4: the search strip owns the hint row
    if ((_tui_show_tree == 1) && (_tui_focus == FOCUS_TREE)) {
        ui_emit(ROLE_FAINT, "↑↓ move · →← expand · Enter read/open · Tab composer · Ctrl-B hide");
    } elif (tui_palette_active() == 1) { tui_draw_palette(); }
    elif (_tui_show_tree == 1) {
        ui_emit(ROLE_FAINT, "Tab tree · Ctrl-B hide · Ctrl-G status · ");
        if (inhist_count() > 0) { ui_emit(ROLE_FAINT, "↑↓ history · "); }
        ui_emit(ROLE_FAINT, "Enter send");
    } else {
        ui_emit(ROLE_FAINT, "Ctrl-X exit · Ctrl-G status · Ctrl-B files · ");
        if (config_hoosh_configured() == 1) { ui_emit(ROLE_FAINT, "Ctrl-P model · "); }
        if (inhist_count() > 0) { ui_emit(ROLE_FAINT, "↑↓ history · "); }
        ui_emit(ROLE_FAINT, "Enter send");
    }
    return 0;
}

# --- feed search modal (0.18.4) -------------------------------------------
# The search UI is chrome (emit to the terminal) + a scroll-to-match + the modal key handler. All of it
# runs only inside tui_loop (PT_RICH). fsearch.cyr owns the pure matching/render/state; this is the glue.

# _tui_draw_search_hint: the search strip in the hint row (the caller moved there + cleared). Shows the
# query, the i/n match position (or "no matches" / "type to search"), and the nav keys. ⌃C is the reliable
# close (Esc is best-effort — a lone Esc may not register until the next key).
fn _tui_draw_search_hint() {
    ui_emit(ROLE_ACCENT, "find: ");
    emit(ui_sgr(ROLE_FG)); emit_n(fsearch_query_ptr(), fsearch_qlen()); emit(ui_reset());
    ui_emit(ROLE_FAINT, "  ");
    if (fsearch_qlen() == 0) { ui_emit(ROLE_FAINT, "(type to search)"); }
    elif (fsearch_count() == 0) { ui_emit(ROLE_RED, "no matches"); }
    else {
        emit(ui_sgr(ROLE_GREEN)); fmt_int(fsearch_cur() + 1); emit("/"); fmt_int(fsearch_count());
        if (fsearch_saturated() == 1) { emit("+"); }   # count hit the cap — a floor, not the total (announced, never faked)
        emit(ui_reset());
    }
    ui_emit(ROLE_FAINT, "  ↑/N older · ↓/n newer · ⌃C close");
    return 0;
}

# _tui_park_search: park the cursor at the query caret in the hint row (after "find: " + the query).
fn _tui_park_search() {
    var col = 7 + fsearch_qlen();                 # "find: " is 6 visible cols; query starts at col 7
    if (col > _tui_cols) { col = _tui_cols; }
    tty_move(tui_hint_row(_tui_rows), col);
    return 0;
}

# _tui_search_scroll_to: set feed_scroll so logical line `li` is visible near the top of the feed band (a
# 2-row context margin), clamped. feed_scroll is PHYSICAL rows back from the newest (0 = pinned bottom).
fn _tui_search_scroll_to(li) {
    if (li < 0) { return 0; }
    var fwidth = tui_feed_width(_tui_cols, _tui_show_tree);
    var rows = _tui_feed_rows();
    var tphys = _feed_total_phys(fwidth);
    var before = feed_phys_before(li, fwidth);
    var target = tphys - rows - before + 2;       # top of band = before-2 -> 2 rows of context above the match
    var maxs = _tui_feed_maxscroll();
    if (target < 0) { target = 0; }
    if (target > maxs) { target = maxs; }
    feed_scroll_set(target);
    return 0;
}

# _tui_search_after_query: rescan (query changed), jump to the newest match, repaint (highlights + strip +
# park at the caret). tui_repaint_body parks via the _fsearch_active gate in tui_park_cursor.
fn _tui_search_after_query() {
    fsearch_rescan();
    _tui_search_scroll_to(fsearch_cur_line());
    tui_repaint_body();
    return 0;
}
# _tui_search_go: after a next/prev jump to logical line `li` — scroll it into view + repaint.
fn _tui_search_go(li) {
    _tui_search_scroll_to(li);
    tui_repaint_body();
    return 0;
}

# _tui_search_enter: open search (empty query, typing phase). Called from the Ctrl-F key path (TUI-only).
fn _tui_search_enter() {
    fsearch_init();
    fsearch_reset();
    _fsearch_active = 1;
    _fsearch_edit = 1;
    tui_repaint_body();
    return 0;
}
# _tui_search_exit: close search — drop the query/matches, repaint WITHOUT highlights (keeps the current
# scroll so you stay where the last match was), re-park at the composer (the _fsearch_active gate is off now).
fn _tui_search_exit() {
    _fsearch_active = 0;
    _fsearch_edit = 0;
    fsearch_reset();
    tui_repaint_body();
    return 0;
}

# tui_search_from_cmd: enter search from the /find command (runs inside tui_run_line's OUT_RING dispatch,
# so it MUST NOT paint — emit would go to the ring; it only sets state + scroll, and the post-dispatch
# tui_relayout repaints with highlights). qlen 0 -> the typing phase (empty query); else nav phase seeded
# to the newest match.
fn tui_search_from_cmd(q, qlen) {
    fsearch_init();
    _fsearch_active = 1;
    if (qlen > 0) {
        fsearch_set_query(q, qlen);
        fsearch_rescan();
        _fsearch_edit = 0;
        _tui_search_scroll_to(fsearch_cur_line());
    } else {
        fsearch_reset();
        _fsearch_edit = 1;
    }
    return 0;
}

# _tui_search_key: the modal key handler — every key while _fsearch_active routes here. edit==1 types the
# query (incremental); edit==0 navigates (bare n/N). KEY_EOF must tear the loop down (else the modal
# shadows the normal EOF exit -> busy-spin). Esc/Ctrl-C close. Enter commits (edit) or jumps (nav).
fn _tui_search_key(key) {
    if (key == KEY_EOF) { _tui_search_exit(); _tui_running = 0; return 0; }
    if ((key == KEY_CTRLC) || (key == KEY_ESC)) { _tui_search_exit(); return 0; }
    if (_fsearch_edit == 1) {
        if (key == KEY_CHAR) { fsearch_query_push(_tui_key_ch); _tui_search_after_query(); }
        elif (key == KEY_BACKSPACE) { fsearch_query_pop(); _tui_search_after_query(); }
        elif (key == KEY_ENTER) {
            if (fsearch_qlen() > 0) { _fsearch_edit = 0; tui_draw_hint(); _tui_park_search(); }
            else { _tui_search_exit(); }
        }
        elif (key == KEY_DOWN) { _tui_search_go(fsearch_next()); }
        elif (key == KEY_UP) { _tui_search_go(fsearch_prev()); }
    } else {
        if (key == KEY_CHAR) {
            if (_tui_key_ch == 110) { _tui_search_go(fsearch_next()); }         # 'n' -> newer
            elif (_tui_key_ch == 78) { _tui_search_go(fsearch_prev()); }        # 'N' -> older
            else { fsearch_query_push(_tui_key_ch); _fsearch_edit = 1; _tui_search_after_query(); }   # any other char resumes typing
        }
        elif ((key == KEY_DOWN) || (key == KEY_ENTER)) { _tui_search_go(fsearch_next()); }
        elif (key == KEY_UP) { _tui_search_go(fsearch_prev()); }
        elif (key == KEY_BACKSPACE) { _fsearch_edit = 1; tui_draw_hint(); _tui_park_search(); }
    }
    return 0;
}

# --- model-picker modal (0.24.0) ------------------------------------------
# An interactive Ctrl-P picker over hoosh's model catalog, switching through the EXISTING /model seam
# (session_set_model_copy). Runs only inside tui_loop (PT_RICH). mpick.cyr owns the pure state/filter/nav;
# this is the render (the feed band becomes the list), the key handler, and the switch. Models Ctrl-F search.

# _tui_pick_emit_clip: emit at most `max` bytes of NUL-terminated `id` to the terminal (band chrome -> fd1).
fn _tui_pick_emit_clip(id, max) {
    var n = strlen(id);
    if (n > max) { n = max; }
    if (n < 0) { n = 0; }
    emit_raw_n(id, n);
    return n;
}

# _tui_pick_paint_row: paint one model row — a 2-col gutter ("> " selected, else "  "), the id (clipped to
# the band width), and a green " *" when it is the active routing target. Selected row in accent, else FG.
fn _tui_pick_paint_row(id, sel, active, fwidth) {
    var is_active = 0;
    if ((active != 0) && (streq(id, active) == 1)) { is_active = 1; }
    if (sel == 1) { emit_raw(ui_sgr(ROLE_ACCENT)); emit_raw("> "); }
    else { emit_raw(ui_sgr(ROLE_FG)); emit_raw("  "); }
    var budget = fwidth - 2;
    if (is_active == 1) { budget = budget - 2; }
    if (budget < 0) { budget = 0; }
    _tui_pick_emit_clip(id, budget);
    if (is_active == 1) { emit_raw(ui_sgr(ROLE_GREEN)); emit_raw(" *"); }
    emit_raw(ui_reset());
    return 0;
}

# _tui_pick_paint: overwrite the feed band with the filtered model list (scrolled so the selection shows),
# then draw the query strip in the hint row and park at the caret. The status bar, tree and composer keep
# their last frame (unchanged while picking); only the feed region and the hint row are the picker's.
fn _tui_pick_paint() {
    var top = tui_feed_top(_tui_show_status);
    var bot = tui_feed_bot(_tui_rows, led_lines(), _tui_show_status);
    if (bot < top) { return 0; }
    var rows = bot - top + 1;
    var fleft = tui_feed_left(_tui_cols, _tui_show_tree);
    var fwidth = tui_feed_width(_tui_cols, _tui_show_tree);
    var cur = mpick_cur();
    var first = mpick_first();                    # keep the selection inside [first, first+rows)
    if (cur < first) { first = cur; }
    if (cur >= (first + rows)) { first = cur - rows + 1; }
    if (first < 0) { first = 0; }
    mpick_set_first(first);
    var active = session_model();
    if (active == 0) { active = config_hoosh_model(); }
    var cnt = mpick_count();
    var r = 0;
    while (r < rows) {
        tty_move(top + r, fleft);
        tty_clear_to_eol();
        var fi = first + r;
        if (fi < cnt) {
            var sel = 0;
            if (fi == cur) { sel = 1; }
            _tui_pick_paint_row(mpick_id_at(fi), sel, active, fwidth);
        }
        r = r + 1;
    }
    tui_draw_hint();                              # the _mpick_active gate makes this paint the pick strip
    _tui_park_pick();
    return 0;
}

# _tui_draw_pick_hint: the picker strip in the hint row (the caller moved there + cleared) — the query, the
# i/n position (or "no matches" / "no models"), and the nav keys. ⌃C is the reliable close (Esc best-effort).
fn _tui_draw_pick_hint() {
    ui_emit(ROLE_ACCENT, "pick: ");
    emit(ui_sgr(ROLE_FG)); emit_n(mpick_query_ptr(), mpick_qlen()); emit(ui_reset());
    ui_emit(ROLE_FAINT, "  ");
    if (mpick_count() == 0) {
        if (mpick_total() == 0) { ui_emit(ROLE_RED, "no models"); }
        else { ui_emit(ROLE_RED, "no matches"); }
    } else {
        emit(ui_sgr(ROLE_GREEN)); fmt_int(mpick_cur() + 1); emit("/"); fmt_int(mpick_count()); emit(ui_reset());
    }
    ui_emit(ROLE_FAINT, "  ↑↓ move · Enter switch · ⌃C close");
    return 0;
}

# _tui_park_pick: park the cursor at the query caret in the hint row (after "pick: " + the query).
fn _tui_park_pick() {
    var col = 7 + mpick_qlen();                   # "pick: " is 6 visible cols; query starts at col 7
    if (col > _tui_cols) { col = _tui_cols; }
    tty_move(tui_hint_row(_tui_rows), col);
    return 0;
}

# _tui_pick_apply: commit a switch to model `id` through the same seam as /model (copy + title + audit),
# and log a confirmation line to the feed. Called from Enter; the caller then exits + repaints.
fn _tui_pick_apply(id) {
    session_set_model_copy(id);
    term_title_set();                             # reflect the new model in the terminal title (0.22.3)
    out_mode_set(OUT_RING);
    ui_emit(ROLE_GREEN, "model -> "); emit(id);
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    log_begin("model_switch"); log_kv_str("model", id); log_commit(SK_INFO);
    return 0;
}

# _tui_pick_enter: open the picker — fetch the catalog (blocking, silent), pre-highlight the active model,
# and paint. Degrades honestly: no hoosh seam / unreachable / no models -> a one-line feed note, no modal.
fn _tui_pick_enter() {
    if (config_hoosh_configured() == 0) {
        out_mode_set(OUT_RING);
        ui_emit(ROLE_RED, "model picker: "); ui_emit(ROLE_FAINT, "hoosh absent — set [hoosh].url in thoth.cyml");
        feed_flush_pending(); out_mode_set(OUT_FD1);
        tui_relayout();
        return 0;
    }
    var rc = mpick_load();
    if (rc != MPICK_OK) {
        out_mode_set(OUT_RING);
        ui_emit(ROLE_RED, "model picker: ");
        if (rc == MPICK_ERR_TRANSPORT) { ui_emit(ROLE_FAINT, "hoosh unreachable — "); emit(config_hoosh_url()); }
        elif (rc == MPICK_ERR_HTTP) { ui_emit(ROLE_FAINT, "hoosh returned an error fetching the model catalog"); }
        else { ui_emit(ROLE_FAINT, "hoosh advertises no models to pick from"); }
        feed_flush_pending(); out_mode_set(OUT_FD1);
        tui_relayout();
        return 0;
    }
    var active = session_model();
    if (active == 0) { active = config_hoosh_model(); }
    mpick_select_id(active);                       # start on the current model if it is in the list
    _mpick_active = 1;
    _tui_pick_paint();
    return 0;
}

# _tui_pick_exit: close the picker and full-repaint (restores the real feed + composer; the status bar now
# reflects any switch just applied).
fn _tui_pick_exit() {
    _mpick_active = 0;
    tty_clear();
    tui_relayout();
    return 0;
}

# _tui_pick_key: the modal key handler — every key while _mpick_active routes here. KEY_EOF tears the loop
# down (else the modal shadows the normal EOF exit). Esc/Ctrl-C cancel; Enter switches; ↑↓ move; typing
# filters. A char/backspace edits the query (mpick refilters + resets the selection to the top match).
fn _tui_pick_key(key) {
    if (key == KEY_EOF) { _tui_pick_exit(); _tui_running = 0; return 0; }
    if ((key == KEY_CTRLC) || (key == KEY_ESC)) { _tui_pick_exit(); return 0; }
    if (key == KEY_ENTER) {
        var id = mpick_selected_id();
        if (id != 0) { _tui_pick_apply(id); }
        _tui_pick_exit();
        return 0;
    }
    if (key == KEY_UP) { mpick_move(0 - 1); _tui_pick_paint(); return 0; }
    if (key == KEY_DOWN) { mpick_move(1); _tui_pick_paint(); return 0; }
    if (key == KEY_CHAR) { mpick_query_push(_tui_key_ch); _tui_pick_paint(); return 0; }
    if (key == KEY_BACKSPACE) { mpick_query_pop(); _tui_pick_paint(); return 0; }
    return 0;
}

# tui_draw_rule: paint a faint full-width horizontal rule (─) on `row` (0.11.9). Chrome
# (emit_raw); the per-column glyph is the 3-byte U+2500, each one visible column wide, so
# `cols` of them fill the width. Painted under the status bar + above the composer.
fn tui_draw_rule(row, cols) {
    tty_move(row, 1);
    tty_clear_to_eol();
    emit_raw(ui_sgr(ROLE_FAINT));
    var i = 0;
    while (i < cols) { emit_raw("─"); i = i + 1; }
    emit_raw(ui_reset());
    return 0;
}

# _comp_row_hstart: horizontal-scroll start (in bytes) for composer logical line `li`.
# The CURSOR's line scrolls to keep the cursor visible (a window ending at the cursor);
# every other line anchors at column 0. Shared by draw + park so they cannot drift.
fn _comp_row_hstart(li) {
    if (li != led_cursor_line()) { return 0; }
    var avail = _tui_cols - 6;
    if (avail < 1) { avail = 1; }
    var cc = led_cursor_col();
    if (cc > avail) { return cc - avail; }
    return 0;
}

# tui_park_cursor: move the cursor to the composer's edit position. Multi-line (0.11.9):
# the row is the cursor's logical line within the visible vertical window; the column
# mirrors tui_draw_composer's per-line horizontal-scroll window. Called after any paint
# that left the cursor elsewhere (the feed, the spinner) so it returns to where you type.
fn tui_park_cursor() {
    if (_mpick_active == 1) { _tui_park_pick(); return 0; }       # 0.24.0: while picking, the cursor lives at the query caret
    if (_fsearch_active == 1) { _tui_park_search(); return 0; }   # 0.18.4: while searching, the cursor lives at the query caret (covers WINCH / /theme / /find full-repaints)
    var lines = led_lines();
    var H = tui_composer_height(_tui_rows, lines, _tui_show_status);
    var top = tui_composer_top(_tui_rows, lines, _tui_show_status);
    var cl = led_cursor_line();
    var vf = _comp_vscroll_first(cl, lines, H);
    var start = _comp_row_hstart(cl);
    var col = 6 + (led_cursor_col() - start);
    if (col > _tui_cols) { col = _tui_cols; }
    tty_move(top + (cl - vf), col);
    return 0;
}

# tui_draw_composer: redraw the composer block (one physical row per logical line, over a
# cursor-anchored vertical window) and park the cursor. The {(o> prompt is on the first
# row; continuation rows align content under it. Each line clamps to the width with a
# horizontal-scroll window so a long line never wraps onto the rule/hint rows.
fn tui_draw_composer() {
    var lines = led_lines();
    var H = tui_composer_height(_tui_rows, lines, _tui_show_status);
    var top = tui_composer_top(_tui_rows, lines, _tui_show_status);
    var vf = _comp_vscroll_first(led_cursor_line(), lines, H);
    var avail = _tui_cols - 6;
    if (avail < 1) { avail = 1; }
    var p = 0;
    while (p < H) {
        var li = vf + p;
        tty_move(top + p, 1);
        tty_clear_to_eol();
        if (p == 0) { ui_emit(ROLE_ACCENT, "{(o> "); } else { emit("     "); }   # prompt / continuation indent
        if (li < lines) {
            var start = _comp_row_hstart(li);
            var shown = led_line_len(li) - start;
            if (shown > avail) { shown = avail; }
            if (shown > 0) { emit_n(led_buf() + led_line_start(li) + start, shown); }
        }
        p = p + 1;
    }
    tui_park_cursor();
    return 0;
}

# --- the working-state spinner (0.9.2) ------------------------------------
# The main loop is BLOCKED inside dispatch() during a turn, so nothing can animate
# from the loop. The only in-dispatch heartbeat is hoosh's per-SSE-chunk callback:
# a STREAMING turn advances the frame on each chunk (feed_stream_tick → animated);
# a BLOCKING turn / /run shows the SAME glyph held still — honest, never faked
# motion. The indicator lives on the hint row for the dispatch window, suspended
# across an interactive confirm (which owns the composer/hint rows).
var _spin_frame = 0;
var _spin_active = 0;        # 1 while a dispatch is in flight (the indicator shows)
var _spin_suspended = 0;     # saved _spin_active across a confirm
var SPIN_FRAMES = 10;        # braille spinner cycle length

# Streamed-frame paint throttle (0.15.0). The SSE callbacks ping feed_stream_tick
# once per streamed chunk; at 80–150 tok/s that is 100+ full feed repaints/sec,
# which thrashes the pending line + spinner and can outrun the terminal (visible
# tearing). We COALESCE paints onto a frame budget — repaint at most once per
# STREAM_FRAME_MS — so streaming stays SMOOTH without slowing the model (ingest is
# untouched: the chunk's bytes are already in the ring from the emit that ran
# BEFORE this tick). This is throttling, not a typewriter delay: content is never
# held back, only the intermediate PAINT rate is capped.
var STREAM_FRAME_MS = 33;         # ~30fps: smooth, well under the 80–150 tok/s tick rate
var _stream_last_paint_ms = 0;    # clock_now_ms() of the last streamed-frame paint (0 = none yet)

# spin_glyph: the braille spinner glyph for frame `f` (mod the cycle). Pure — the
# dots are printable multibyte UTF-8 (valid Cyrius string literals).
fn spin_glyph(f) {
    var i = f % SPIN_FRAMES;
    if (i == 0) { return "⠋"; }
    if (i == 1) { return "⠙"; }
    if (i == 2) { return "⠹"; }
    if (i == 3) { return "⠸"; }
    if (i == 4) { return "⠼"; }
    if (i == 5) { return "⠴"; }
    if (i == 6) { return "⠦"; }
    if (i == 7) { return "⠧"; }
    if (i == 8) { return "⠇"; }
    return "⠏";
}
fn spin_advance() { _spin_frame = _spin_frame + 1; return 0; }
fn spin_frame() { return _spin_frame; }
fn spin_active() { return _spin_active; }

# --- spinner label (0.19.1): name the currently-running tool ---------------
# During an agentic turn the spinner shows " working…" while hoosh streams; while a tool INVOKES (a blocking
# daimon/shell/memory call), agent.cyr labels the spinner with the tool name so the user sees WHAT is
# running. TUI-only (spin_paint is a no-op off the TUI); the label buffer is a bounded copy.
var SPIN_LABEL_CAP = 80;
var _spin_label_buf = 0;         # alloc(SPIN_LABEL_CAP), lazy
var _spin_label = 0;             # 1 while a tool label is active (else generic " working…")
fn spin_label_set(name) {
    if (name == 0) { return spin_label_clear(); }
    if (_spin_label_buf == 0) { _spin_label_buf = alloc(SPIN_LABEL_CAP); }
    var i = 0;
    while ((i < (SPIN_LABEL_CAP - 1)) && (load8(name + i) != 0)) { store8(_spin_label_buf + i, load8(name + i)); i = i + 1; }
    store8(_spin_label_buf + i, 0);
    _spin_label = 1;
    spin_paint();
    return 0;
}
fn spin_label_clear() { _spin_label = 0; spin_paint(); return 0; }

# spin_paint: draw the working indicator on the hint row (chrome — emit_raw, never
# captured). No-op when inactive. The caller restores the hint row via tui_draw_hint
# once the dispatch ends.
fn spin_paint() {
    if (_spin_active == 0) { return 0; }
    tty_move(tui_hint_row(_tui_rows), 1);
    tty_clear_to_eol();
    emit_raw(ui_sgr(ROLE_ACCENT)); emit_raw(spin_glyph(_spin_frame)); emit_raw(ui_reset());
    emit_raw(ui_sgr(ROLE_FAINT));
    if (_spin_label == 1) { emit_raw(" running "); emit_raw(_spin_label_buf); emit_raw("…"); }
    else { emit_raw(" working…"); }
    emit_raw(ui_reset());
    tui_park_cursor();          # return the cursor to the prompt line, not the spinner row
    return 0;
}
fn spin_begin() { _spin_frame = 0; _spin_active = 1; _spin_label = 0; _stream_last_paint_ms = 0; spin_paint(); return 0; }   # start each turn at frame 0, unlabeled; _stream_last=0 so the first streamed chunk paints instantly
fn spin_end() { _spin_active = 0; return 0; }   # caller redraws the hint row after

# --- the self-managed feed painter (0.9.1) --------------------------------
# 0.9.0 scrolled command output natively in a DECSTBM region. 0.9.1 OWNS the
# feed: dispatch output is captured into the ring (src/feed.cyr) and PAINTED here
# each frame. This is what makes the file-tree pane (0.9.3, a narrower feed
# column) and instant SIGWINCH (0.9.2, a pure recompute+repaint) possible.
var _paint_buf = 0;
# PAINT_CAP must fit the EXPANDED output of one paint call (0.18.0). A sealed slot is <= FEED_LINE_CAP
# (2048) bytes, but those bytes may be role MARKERS (2 B each) that feed_clip_seg EXPANDS to the current
# theme's concrete SGR (<= ~19 B truecolor). Worst case a slot is ~1024 markers -> ~19.5 KB expanded;
# add the paint window's text + the leading carry (also expanded) + a defensive ui_reset(). 24 KiB
# clears that with headroom (one-time alloc; the ring itself is already ~4 MiB). Pre-0.18.0 this was
# 2112 (slots stored concrete SGR, so a slot's paint output was <= the 2048 stored bytes).
var PAINT_CAP = 24576;       # expanded worst case of a marker-packed slot + carry + reset

# feed_repaint: paint the newest feed lines into rows [feed_top..feed_bot], each
# clipped to the terminal width (the 0.9.3 pane will narrow this). Uses emit_raw
# (NOT emit): it can run while capture is armed (the confirm bracket / a streaming
# tick) and must reach the SCREEN, never the ring it is painting FROM.
# tty_clear_to_eol wipes any remnant of a longer previous frame on each row.
# 0.9.2: the UNSEALED pending line (an in-progress streamed response, no newline
# yet) is rendered as a virtual bottom row so streaming is INCREMENTAL.
fn feed_repaint() {
    if (_paint_buf == 0) { _paint_buf = alloc(PAINT_CAP); }
    var top = tui_feed_top(_tui_show_status);
    var bot = tui_feed_bot(_tui_rows, led_lines(), _tui_show_status);
    if (bot < top) { return 0; }
    var rows = bot - top + 1;
    # 0.9.3: when the tree pane is shown, the feed lives in the RIGHT column
    # [feed_left, cols]; clip each line to feed_width and paint from feed_left. The
    # tree (cols [1, tree_w]) is painted separately and is left of feed_left, so the
    # per-row tty_clear_to_eol (which clears feed_left..EOL) never touches it.
    var fleft = tui_feed_left(_tui_cols, _tui_show_tree);
    var fwidth = tui_feed_width(_tui_cols, _tui_show_tree);
    var total = feed_count();
    var pend = feed_pending_len();
    var docrows = total;
    if (pend > 0) { docrows = total + 1; }        # the pending line is a virtual doc line
    # SOFT-WRAP (0.11.3): a logical line of V visible cols occupies
    # feed_rows_for(V, fwidth) PHYSICAL rows (was: 1 row, truncated). Page the newest
    # `rows` physical rows, scrolled back feed_scroll() physical rows; top-pin when the
    # whole document is shorter than the band (start == 0). feed_vis(i) is the cached
    # glyph count (width-independent), so this is correct at any column width.
    var tphys = _feed_total_phys(fwidth);
    var start = 0;
    if (tphys > rows) { start = tphys - rows - feed_scroll(); }
    if (start < 0) { start = 0; }
    # map the physical-row index `start` -> (logical line `li`, segment `sg` within it)
    # by walking logical lines and accumulating their physical heights. A done-flag
    # drives the loop (the codebase avoids `break` in a var-bearing loop).
    var li = 0;
    var acc = 0;
    var found = 0;
    while ((li < docrows) && (found == 0)) {
        var lvis = 0;
        if (li < total) { lvis = feed_vis(li); }
        else { lvis = feed_visible_cols(feed_pending_ptr(), pend); }
        var lr = feed_rows_for(lvis, fwidth);
        if ((acc + lr) > start) { found = 1; }
        else { acc = acc + lr; li = li + 1; }
    }
    var sg = start - acc;                         # segment offset into line `li` (0 if past end)
    # paint `rows` physical rows from (li, sg), advancing the segment; a line wider
    # than fwidth spans several rows, each painting its visible-column window.
    var painted = 0;
    while (painted < rows) {
        tty_move(top + painted, fleft);
        if (li < docrows) {
            var ptr = 0;
            var len = 0;
            var lvis2 = 0;
            if (li < total) { ptr = feed_line_ptr(li); len = feed_line_len(li); lvis2 = feed_vis(li); }
            else { ptr = feed_pending_ptr(); len = pend; lvis2 = feed_visible_cols(ptr, len); }
            # 0.18.4: when searching, render a match line through fsearch_render (reverse-video SGR injected
            # into _hl_buf) and clip THAT — feed_clip_seg is unchanged; the injected escapes are zero-width.
            var sptr = ptr;
            var slen = len;
            if ((_fsearch_active == 1) && (fsearch_line_is_match(li) == 1)) {
                if (_hl_buf == 0) { _hl_buf = alloc(HL_CAP); }
                var coff = 0 - 1;
                if (li == fsearch_cur_line()) { coff = fsearch_cur_off(); }   # only the current occurrence's line marks its offset current
                slen = fsearch_render(_hl_buf, HL_CAP, ptr, len, coff);
                sptr = _hl_buf;
            }
            var w = feed_clip_seg(_paint_buf, PAINT_CAP, sptr, slen, sg * fwidth, fwidth);
            if (w > 0) { emit_raw_n(_paint_buf, w); }
            sg = sg + 1;
            if (sg >= feed_rows_for(lvis2, fwidth)) { li = li + 1; sg = 0; }
        }
        tty_clear_to_eol();
        painted = painted + 1;
    }
    return 0;
}

# --- feed scrollback (0.9.4) ----------------------------------------------
# The ring retains the last 2048 lines; these page back into them. Shift-↑/↓
# (KEY_SCROLL_*) scroll a few lines (the non-mouse wheel fallback); PageUp/Dn a
# screenful. feed_scroll() is PHYSICAL rows back from the newest (0.11.3: soft-wrapped
# rows, not logical lines — a wide line spans several); a new turn resets it to 0
# (tui_run_line) so fresh output is always visible.
fn _tui_feed_rows() {
    var r = tui_feed_bot(_tui_rows, led_lines(), _tui_show_status) - tui_feed_top(_tui_show_status) + 1;
    if (r < 1) { r = 1; }
    return r;
}
# _tui_feed_maxscroll: the largest valid feed_scroll() at the current width — the
# document's physical height past one screenful. Shared by the scroll keys and the
# relayout clamp (a width change re-flows the document, so the old offset can exceed
# the new max — see tui_relayout).
fn _tui_feed_maxscroll() {
    var fwidth = tui_feed_width(_tui_cols, _tui_show_tree);
    var m = _feed_total_phys(fwidth) - _tui_feed_rows();
    if (m < 0) { m = 0; }                        # nothing to scroll (document fits)
    return m;
}
fn _tui_feed_scroll_by(delta) {
    var maxscroll = _tui_feed_maxscroll();
    var s = feed_scroll() + delta;
    if (s < 0) { s = 0; }
    if (s > maxscroll) { s = maxscroll; }
    feed_scroll_set(s);
    feed_repaint();
    tui_park_cursor();
    return 0;
}

# _stream_should_paint: pure throttle decision (0.15.0) — 1 if a streamed chunk
# arriving at `now` ms should trigger a repaint given the last paint at `last`,
# else 0 (coalesce this tick into the current frame). Repaints at most once per
# STREAM_FRAME_MS. clock_now_ms is monotonic, but a backward step (now < last)
# FAILS OPEN (paints) rather than stalling. Pure -> unit-tested (test_stream_throttle).
fn _stream_should_paint(now, last) {
    var dt = now - last;
    if (dt < 0) { return 1; }                  # clock stepped backward -> paint (fail-open)
    if (dt >= STREAM_FRAME_MS) { return 1; }
    return 0;
}

# feed_stream_tick: the in-dispatch heartbeat the SSE callbacks (src/hoosh.cyr,
# src/agent.cyr) ping on each streamed chunk. Under OUT_RING (the TUI) it advances
# the spinner and repaints the growing pending line so a streaming turn renders
# INCREMENTALLY + animated. Under OUT_FD1 (REPL / piped / CI) it is a no-op — the
# chunk's emit already wrote live, so the floor stays byte-identical.
# THROTTLE (0.15.0): at 80–150 tok/s a per-chunk repaint thrashes; coalesce to the
# STREAM_FRAME_MS budget (_stream_should_paint). Dropping an intra-budget tick never
# withholds content — the bytes are already in the ring, and the guaranteed
# post-dispatch feed_repaint (tui.cyr run-line, ~1045) always lands the final state.
fn feed_stream_tick() {
    if (out_mode() != OUT_RING) { return 0; }
    var now = clock_now_ms();
    if (_stream_should_paint(now, _stream_last_paint_ms) == 0) { return 0; }
    _stream_last_paint_ms = now;
    spin_advance();
    feed_repaint();
    spin_paint();
    return 0;
}

# tui_confirm_begin / tui_confirm_end: bracket an interactive gate confirm
# (src/gate.cyr) running INSIDE the captured dispatch window. begin seals + paints
# the dispatch output so far (so the user sees the /write diff etc.), then drops to
# OUT_FD1 with the cursor on the composer row, so the confirm prompt and its cooked
# y/n echo go LIVE to the screen instead of into the (invisible) ring; end resumes
# capture for the remainder of dispatch. The REPL path never calls these (capture
# isn't armed there) — the confirm stays byte-identical off the TUI.
fn tui_confirm_begin() {
    feed_flush_pending();
    feed_repaint();
    _spin_suspended = _spin_active; _spin_active = 0;   # hide the spinner during the prompt
    tty_move(tui_hint_row(_tui_rows), 1); tty_clear_to_eol();
    out_mode_set(OUT_FD1);
    tty_move(tui_composer_bot(_tui_rows), 1);
    tty_clear_to_eol();
    return 0;
}
fn tui_confirm_end() {
    tui_repaint_body();                 # 0.18.6: still OUT_FD1 here -> repaint to the SCREEN, clearing the
                                        # confirm prompt + its cooked y/n echo and restoring the {(o> composer
                                        # IMMEDIATELY (was: the confirm line lingered on the composer row until
                                        # the whole turn finished, so the prompt looked stuck after approval).
    out_mode_set(OUT_RING);             # resume capturing the rest of dispatch into the feed
    _spin_active = _spin_suspended;     # resume the spinner if a turn is still in flight
    spin_paint();
    return 0;
}

# --- the file-tree pane painter (0.9.3) -----------------------------------
# Paints the tree into columns [1, tree_w] over the feed rows, with a vertical
# separator at tree_w+1; the feed (feed_repaint) paints [tree_w+2, cols]. Chrome:
# always emit_raw. The tree rows pad to the full tree width (no clear_to_eol, which
# would wipe the feed to the right). The model lives in src/ftree.cyr.
var _tree_rowbuf = 0;        # plain row text (indent + marker + name)
var _tree_paint = 0;         # clipped paint bytes
var _tui_pathbuf = 0;        # scratch for a selected node's path
var _tui_cmdbuf = 0;         # scratch for the "/read <path>" command
var TREE_ROW_CAP = 1024;

# _ftree_scroll_first: the first visible tree row, so the selection stays on screen.
fn _ftree_scroll_first(total, rows) {
    var sel = ftree_sel();
    var first = 0;
    if (sel >= rows) { first = sel - rows + 1; }
    var maxfirst = total - rows;
    if (maxfirst < 0) { maxfirst = 0; }
    if (first > maxfirst) { first = maxfirst; }
    if (first < 0) { first = 0; }
    return first;
}
fn _tui_pad_cols(n) { while (n > 0) { emit_raw(" "); n = n - 1; } return 0; }

# _tui_tree_row_build: compose node li's display text — depth indent + a ▾/▸/space
# marker + the name — into _tree_rowbuf (the marker glyphs are printable UTF-8).
fn _tui_tree_row_build(li) {
    if (_tree_rowbuf == 0) { _tree_rowbuf = alloc(TREE_ROW_CAP); }
    var off = 0;
    var ind = ftree_depth(li) * 2;
    var k = 0;
    while ((k < ind) && (off < (TREE_ROW_CAP - 8))) { store8(_tree_rowbuf + off, 32); off = off + 1; k = k + 1; }
    if (ftree_isdir(li) == 1) {
        if (ftree_exp(li) == 1) { off = _ftree_append_cstr(_tree_rowbuf, off, TREE_ROW_CAP, "▾ "); }
        else { off = _ftree_append_cstr(_tree_rowbuf, off, TREE_ROW_CAP, "▸ "); }
    } else {
        store8(_tree_rowbuf + off, 32); off = off + 1;
        store8(_tree_rowbuf + off, 32); off = off + 1;
    }
    off = _ftree_append_cstr(_tree_rowbuf, off, TREE_ROW_CAP, ftree_name(li));
    store8(_tree_rowbuf + off, 0);
    return off;
}

# _tui_paint_tree_row: paint node li into tree cols [1, tw] on row r — dir blue / file
# muted, the selected row a reverse-video bar, padded to the full tree width.
# _tui_tree_row_gitkind (0.22.4): the git status kind for tree node `li` — 1=modified, 2=new, 3=deleted,
# or 0 (dir / unchanged / no repo). Derives the node's repo-relative path (ftree_path is absolute cwd+chain;
# strip the cwd + its '/') and looks it up in the already-probed status cache (git_status_of). Files only.
var _tui_tree_pathbuf = 0;
fn _tui_tree_row_gitkind(li) {
    if (ftree_isdir(li) == 1) { return 0; }
    if (_tui_tree_pathbuf == 0) { _tui_tree_pathbuf = alloc(4096); }
    ftree_path(li, _tui_tree_pathbuf, 4096);
    var skip = strlen(ftree_cwd());
    if (load8(_tui_tree_pathbuf + skip) == 47) { skip = skip + 1; }   # past the '/' after cwd
    return git_status_of(_tui_tree_pathbuf + skip);
}

fn _tui_paint_tree_row(li, tw, r) {
    # 0.22.4: in a repo, reserve a 2-col badge gutter on EVERY row (so alignment holds) — a colored M/A/D
    # for a changed file, else two blanks. Outside a repo, no gutter (the floor tree render is unchanged).
    var badges = git_present();
    if (tw < 3) { badges = 0; }                     # too narrow for a 2-col gutter + a name col -> no badges (floor render)
    var namew = tw;
    if (badges == 1) { namew = tw - 2; if (namew < 0) { namew = 0; } }
    var n = _tui_tree_row_build(li);
    if (_tree_paint == 0) { _tree_paint = alloc(TREE_ROW_CAP); }
    var w = feed_clip(_tree_paint, TREE_ROW_CAP, _tree_rowbuf, n, namew);
    var vis = feed_visible_cols(_tree_rowbuf, n);
    if (vis > namew) { vis = namew; }
    var role = ROLE_MUTED;
    if (ftree_isdir(li) == 1) { role = ROLE_BLUE; }
    tty_move(r, 1);
    if (li == ftree_sel()) { emit_raw("\x1b[7m"); }     # reverse-video highlight bar
    if (badges == 1) {
        var kind = _tui_tree_row_gitkind(li);
        if (kind == 1) { emit_raw(ui_sgr(ROLE_ACCENT)); emit_raw("M "); }    # modified — amber
        elif (kind == 2) { emit_raw(ui_sgr(ROLE_GREEN)); emit_raw("A "); }   # new — green
        elif (kind == 3) { emit_raw(ui_sgr(ROLE_RED)); emit_raw("D "); }     # deleted — red
        else { emit_raw("  "); }                                             # unchanged / dir — blank gutter
    }
    emit_raw(ui_sgr(role));                             # name (overrides the badge fg; reverse persists if selected)
    emit_raw_n(_tree_paint, w);
    emit_raw(ui_sgr(ROLE_FG));
    _tui_pad_cols(namew - vis);                         # fill to the full tree width
    emit_raw(ui_reset());                               # closes color + reverse
    return 0;
}

# tui_draw_tree: paint the file-tree pane + the vertical separator over the feed
# rows. Only when shown; scrolls to keep the selection visible.
fn tui_draw_tree() {
    if (_tui_show_tree == 0) { return 0; }
    var tw = tui_tree_w(_tui_cols, 1);
    var top = tui_feed_top(_tui_show_status);
    var bot = tui_feed_bot(_tui_rows, led_lines(), _tui_show_status);
    if (bot < top) { return 0; }
    var rows = bot - top + 1;
    var total = ftree_count();
    var first = _ftree_scroll_first(total, rows);
    var i = 0;
    while (i < rows) {
        var r = top + i;
        var li = first + i;
        if (li < total) { _tui_paint_tree_row(li, tw, r); }
        else { tty_move(r, 1); _tui_pad_cols(tw); }
        tty_move(r, tw + 1); emit_raw(ui_sgr(ROLE_FAINT)); emit_raw("│"); emit_raw(ui_reset());
        i = i + 1;
    }
    return 0;
}

# _tui_tree_enter: Enter on the selected node — a DIR toggles expand/collapse; a FILE
# is READ immediately (/read) with focus KEPT ON THE TREE, so you keep browsing
# file-to-file without the composer stealing focus (the earlier insert-then-run flow
# stranded focus on the composer and the tree felt locked). The read runs through the
# normal capture/dispatch path so its output lands in the feed.
fn _tui_tree_enter() {
    var sel = ftree_sel();
    if (sel < 0) { return 0; }
    if (sel >= ftree_count()) { return 0; }
    if (ftree_isdir(sel) == 1) {
        if (ftree_exp(sel) == 1) { ftree_collapse(); } else { ftree_expand(); }
        tui_relayout();
        return 0;
    }
    if (_tui_pathbuf == 0) { _tui_pathbuf = alloc(4096); }
    if (_tui_cmdbuf == 0) { _tui_cmdbuf = alloc(4160); }
    ftree_path(sel, _tui_pathbuf, 4096);
    var off = 0;
    off = _ftree_append_cstr(_tui_cmdbuf, off, 4160, "/read ");
    off = _ftree_append_cstr(_tui_cmdbuf, off, 4160, _tui_pathbuf);
    store8(_tui_cmdbuf + off, 0);
    var keep = tui_run_line(_tui_cmdbuf);   # capture + dispatch + repaint feed; focus stays on the tree
    if (keep == 0) { _tui_running = 0; } else { tui_relayout(); }
    return 0;
}

# _tui_tree_key: handle one key while the tree pane is focused. ↑/↓ move; →/← expand/
# collapse (full relayout — the visible row count changes); Enter acts on the node; a
# printable char returns focus to the composer and inserts it; Ctrl-C/EOF exit.
fn _tui_tree_key(key) {
    if (key == KEY_UP) { ftree_move(0 - 1); tui_draw_tree(); tui_park_cursor(); }
    elif (key == KEY_DOWN) { ftree_move(1); tui_draw_tree(); tui_park_cursor(); }
    elif (key == KEY_RIGHT) { ftree_expand(); tui_relayout(); }
    elif (key == KEY_LEFT) { ftree_collapse(); tui_relayout(); }
    elif (key == KEY_ENTER) { _tui_tree_enter(); }
    elif (key == KEY_CTRLC) { _tui_running = 0; }
    elif (key == KEY_EOF) { _tui_running = 0; }
    elif (key == KEY_CHAR) {
        _tui_focus = FOCUS_COMPOSER;
        led_feed(KEY_CHAR, _tui_key_ch);
        tui_draw_hint(); tui_draw_composer();
    }
    return 0;
}

# tui_repaint_body: repaint the whole frame at the CURRENT geometry (no winsize read) —
# status bar, the two faint rules, feed, tree, hint, composer. No tty_clear (every band
# issues per-row clear_to_eol), so it is also the no-flash repaint for a composer height
# change (a newline grew/shrank the composer, resizing the feed band). The composer is
# drawn LAST so the cursor parks at the edit position.
fn tui_repaint_body() {
    var lines = led_lines();
    # 0.11.3: a width OR composer-height change re-flows the document / resizes the band,
    # so the stored PHYSICAL-row scroll offset can exceed the new height — clamp it before
    # painting (the painter also floors start at 0, but clamping keeps feed_scroll() honest
    # so the next scroll key resumes from a valid offset).
    var m = _tui_feed_maxscroll();
    if (feed_scroll() > m) { feed_scroll_set(m); }
    tui_draw_status();
    if (_tui_show_status == 1) { tui_draw_rule(tui_sep_top_row(), _tui_cols); }   # rule under the status bar
    feed_repaint();
    tui_draw_tree();
    tui_draw_rule(tui_sep_bottom_row(_tui_rows, lines, _tui_show_status), _tui_cols);   # rule above the composer
    tui_draw_hint();
    tui_draw_composer();
    return 0;
}

# tui_relayout: re-read the terminal size, then repaint the whole frame. No scroll region
# — the feed is self-managed now.
fn tui_relayout() {
    var rr[8];
    var cc[8];
    store64(&rr, 0); store64(&cc, 0);
    if (tty_winsize(1, &rr, &cc) == 0) {
        if (load64(&rr) > 4) { _tui_rows = load64(&rr); }
        if (load64(&cc) > 0) { _tui_cols = load64(&cc); }
    }
    tui_repaint_body();
    return 0;
}

# tui_cur_composer_height: the composer's current height at the live geometry — the
# before/after probe for the redraw gate (wraps the pure tui_composer_height over the
# _tui_rows/_tui_show_status globals, so callers above those declarations can use it).
fn tui_cur_composer_height() { return tui_composer_height(_tui_rows, led_lines(), _tui_show_status); }

# tui_after_edit: redraw after a composer edit, given the composer height BEFORE the edit.
# If a newline was inserted/removed (height changed), the feed band resized -> reflow the
# whole body (tui_repaint_body, no tty_clear -> no flash). Otherwise the cheap partial
# redraw (hint + composer) suffices — ordinary typing never touches the feed.
fn tui_after_edit(before_h) {
    if (tui_cur_composer_height() != before_h) {
        tui_repaint_body();
    } else {
        tui_draw_hint();
        tui_draw_composer();
    }
    return 0;
}

# tui_run_line: submit `line` — echo it into the feed, then dispatch it with output
# CAPTURED into the ring (OUT_RING) and dispatched in COOKED mode (so the gate
# confirm's read_line works; the confirm itself brackets back to the screen).
# On return the feed is repainted. Returns dispatch's keep-going flag (0 = quit).
fn tui_run_line(line) {
    feed_scroll_set(0);                          # a new turn jumps back to the newest output
    out_mode_set(OUT_RING);                      # capture dispatch output into the feed ring
    ui_emit(ROLE_ACCENT, "{(o> "); emit(line);   # echo the submitted command (captured)
    feed_flush_pending();                        # seal the echo as its own feed line
    feed_repaint();                              # show the echo IMMEDIATELY (before a slow turn)
    spin_begin();                                # show the working indicator for the dispatch window
    tty_cooked();                                # canonical mode for read_line-based confirms
    var keep = dispatch(line);
    spin_end();                                  # stop the indicator (relayout restores the hint row)
    out_mode_set(OUT_FD1);                        # stop capturing before any chrome paints
    git_probe();                                 # the turn may have changed the worktree (/run, agentic edit) — refresh git for the status bar (the following tui_relayout repaints it)
    if (tty_raw(0) < 0) { return 0; }            # couldn't re-enter raw -> end the session cleanly
    feed_flush_pending();                        # seal a trailing un-newlined dispatch line
    feed_repaint();                              # paint the captured output
    return keep;
}

# --- SIGWINCH multiplex (0.9.2): instant resize ---------------------------
# The self-managed feed makes resize a pure recompute+repaint. We multiplex stdin
# with a SIGWINCH signalfd via epoll, so when the loop is idle (blocked in
# epoll_wait) a resize wakes us INSTANTLY — not on the next keystroke (the 0.9.1
# limitation). A SIGWINCH arriving DURING a blocking dispatch is queued on the
# level-triggered signalfd and serviced when the loop returns (an accepted gap, the
# same class as the blocked SIGINT). epoll/signalfd are Linux-only; the rich loop is
# already Linux-gated and non-rich runs the REPL, so this never gates a target.
var EV_KEY = 0;
var EV_WINCH = 1;
var _winch_fd = 0 - 1;
var _sigint_fd = 0 - 1;       # the blocked-SIGINT signalfd (tracked so teardown can close it)
var _epfd = 0 - 1;
var _events_ok = 0;           # 1 if the epoll multiplex is up (else a bare blocking read)
var _ev_buf = 0;              # epoll_wait output: maxevents * 12 (packed epoll_event)
var _winch_drain = 0;         # 128-byte signalfd_siginfo drain buffer

# tui_events_init: open the WINCH signalfd, create the epoll instance, and register
# stdin (fd 0) + the WINCH fd. Returns 1 on success, 0 if epoll/signalfd is
# unavailable (the loop then falls back to a bare blocking read — correct, just no
# instant resize). The SIGINT fd is opened separately and kept blocked but NOT
# epoll-registered (we want SIGINT ignored, not delivered).
fn tui_events_init() {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no signalfd and no epoll-on-signalfd multiplex, and the fb
    # console emits no SIGWINCH resize event. Return 0 so the caller takes
    # thoth's own bare-blocking-read fallback (instant resize disabled —
    # an acceptable, already-coded degradation). Keeps TTY_SIGMASK_WINCH /
    # tty_open_signalfd / sys_epoll_* off the agnos target.
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _winch_fd = tty_open_signalfd(TTY_SIGMASK_WINCH);
    if (_winch_fd < 0) { return 0; }
    _epfd = sys_epoll_create();
    if (_epfd < 0) { return 0; }
    if (_ev_buf == 0) { _ev_buf = alloc(64); }
    if (_winch_drain == 0) { _winch_drain = alloc(128); }
    sys_epoll_ctl(_epfd, EPOLL_CTL_ADD, 0, epoll_event_new(EPOLLIN, 0));            # stdin, data=0
    sys_epoll_ctl(_epfd, EPOLL_CTL_ADD, _winch_fd, epoll_event_new(EPOLLIN, _winch_fd));
    return 1;
    #endif
}

# tui_wait_event: block until stdin or the WINCH signalfd is readable. Returns
# EV_WINCH (resize) or EV_KEY (a keypress awaits tui_read_key). WINCH is prioritized
# so a key is decoded against the NEW geometry. Level-triggered epoll: a ready fd not
# acted on re-fires next call, so returning one event per call loses nothing.
fn tui_wait_event() {
    #ifdef CYRIUS_TARGET_AGNOS
    # Unreachable on agnos (_events_ok is 0 → the loop uses the bare read), but
    # it must still compile: agnos has no sys_epoll_wait. Safe default EV_KEY.
    return EV_KEY;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = sys_epoll_wait(_epfd, _ev_buf, 2, 0 - 1);   # timeout -1: block until ready
    if (n <= 0) { return EV_KEY; }                      # EINTR/spurious -> attempt a read
    var i = 0;
    while (i < n) {
        if (load64(_ev_buf + i * 12 + 4) == _winch_fd) { return EV_WINCH; }   # data @ +4
        i = i + 1;
    }
    return EV_KEY;
    #endif
}

# tui_drain_winch: consume one signalfd_siginfo (128 bytes) — epoll said the fd is
# readable so this won't block. Coalesced resizes that queued more re-fire epoll and
# are drained next pass (each just re-relayouts, idempotent).
fn tui_drain_winch() {
    #ifndef CYRIUS_TARGET_AGNOS
    syscall(SYS_READ, _winch_fd, _winch_drain, 128);
    #endif
    return 0;   # agnos: no WINCH signalfd was opened — nothing to drain
}

# tui_events_teardown: close both signalfds (restoring the thread signal mask) and the
# epoll fd. Also fixes the 0.9.0/0.9.1 leak where the SIGINT signalfd was opened but
# never closed (its SIG_BLOCK persisted after the TUI exited).
fn tui_events_teardown() {
    #ifdef CYRIUS_TARGET_AGNOS
    # Nothing was opened on agnos (tui_events_init returned 0) — no teardown.
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (_winch_fd >= 0) { tty_close_signalfd(_winch_fd, TTY_SIGMASK_WINCH); _winch_fd = 0 - 1; }
    if (_sigint_fd >= 0) { tty_close_signalfd(_sigint_fd, 2); _sigint_fd = 0 - 1; }
    if (_epfd >= 0) { file_close(_epfd); _epfd = 0 - 1; }
    return 0;
    #endif
}

# tui_kitty_enable / tui_kitty_disable: push/pop the kitty keyboard protocol with the
# "disambiguate escape codes" flag (CSI > 1 u / CSI < u). With it active, Shift+Enter
# arrives as a distinct CSI-u event (CSI 13;2u -> KEY_NEWLINE) on terminals that support
# it (kitty/ghostty/wezterm/foot/recent alacritty/konsole) — and the Ctrl-combos arrive
# as CSI-u too (decoded back in _tui_kitty_u). Terminals that don't understand the push
# ignore it, so they stay fully legacy and Shift+Enter == Enter there (Alt+Enter is the
# universal newline fallback). Chrome (emit_raw): pushed after alt-screen enter, popped
# before alt-screen leave on every exit path so the keyboard mode is always restored.
fn tui_kitty_enable() { emit_raw("\x1b[>1u"); return 0; }
fn tui_kitty_disable() { emit_raw("\x1b[<u"); return 0; }

# tui_bpaste_enable / tui_bpaste_disable: turn the terminal's bracketed-paste mode on/off
# (CSI ?2004h / CSI ?2004l). With it on, a paste is bracketed by ESC[200~ … ESC[201~, so thoth
# slurps the WHOLE paste into the composer instead of the first newline submitting a turn
# (0.17.0). Same shape/lifecycle as the kitty push/pop: enabled after alt-screen enter, disabled
# before alt-screen leave on every exit. A terminal that doesn't understand the mode ignores it
# and never sends the brackets, so paste degrades to the legacy Enter-per-newline behavior.
fn tui_bpaste_enable() { emit_raw("\x1b[?2004h"); return 0; }
fn tui_bpaste_disable() { emit_raw("\x1b[?2004l"); return 0; }

# tui_mouse_enable / tui_mouse_disable: turn SGR mouse reporting on/off — ?1000h (button press/
# release + wheel) + ?1006h (SGR extended coordinates), so a click/wheel arrives as ESC[<Cb;Cx;Cy(M|m)
# (0.17.2). Same enter/exit lifecycle as the kitty/bpaste push/pop; DISABLING on exit is essential so
# the terminal isn't left reporting mouse events after thoth quits. A terminal that ignores the mode
# never sends events (degrades to no mouse). Trade-off: while on, the terminal routes clicks to thoth,
# so native click-drag text selection is intercepted in the feed — Shift+drag bypasses it in most
# terminals (standard TUI behavior).
fn tui_mouse_enable() { emit_raw("\x1b[?1000h\x1b[?1006h"); return 0; }
fn tui_mouse_disable() { emit_raw("\x1b[?1006l\x1b[?1000l"); return 0; }

# --- turn interrupt (0.17.4): Esc aborts a streaming turn without exiting the session -------------
# A turn runs in COOKED mode (tui_run_line drops to canonical so the t-ron read_line confirm works),
# which line-buffers input — a lone Esc is not readable by an ordinary read. So each streaming read is
# bracketed by a non-canonical, non-blocking (VMIN=0/VTIME=0) poll mode: the SSE callback drains stdin
# per frame and, on Esc, sets _intr_flag and returns 0 (sandhi stops the stream cleanly). GATED on
# out_mode()==OUT_RING (the TUI capture path) so the REPL/piped/one-shot floor never touches the
# terminal and stays byte-identical. The ioctls are Linux-only (darshana's TCGETS/TCSETS are
# #ifdef CYRIUS_TARGET_LINUX); off Linux this degrades to a no-op (no interrupt), like the base termios.
var _intr_saved = 0;          # cooked termios saved by intr_arm (lazy 60B alloc)
var _intr_active = 0;         # 1 while the poll-mode termios is installed
var _intr_flag = 0;           # 1 once Esc was seen THIS turn

fn intr_reset() { _intr_flag = 0; return 0; }     # call ONCE at turn start (hoosh_send / agent_turn)
fn intr_pending() { return _intr_flag; }

# intr_arm: install the non-canonical VMIN=0/VTIME=0 poll termios around one streaming read. Saves the
# current (cooked) termios into a PRIVATE buffer so intr_disarm can restore it — it does NOT use
# darshana's tty_raw/tty_cooked (which would clobber their single saved-termios / _tty_in_raw state and
# strand the post-turn tty_raw at tui_run_line). Does NOT touch _intr_flag (that spans the whole turn).
fn intr_arm() {
    _intr_active = 0;
    if (out_mode() != OUT_RING) { return 0; }        # TUI-only -> floor byte-identical
    #ifdef CYRIUS_TARGET_LINUX
    if (_intr_saved == 0) { _intr_saved = alloc(60); }
    if (syscall(SYS_IOCTL, 0, TCGETS, _intr_saved) < 0) { return 0; }   # not a tty -> stay disarmed
    var work[60];
    var i = 0;
    while (i < 60) { store8(&work + i, load8(_intr_saved + i)); i = i + 1; }
    _tty_apply_raw_flags(&work);                      # ICANON/ECHO/ISIG off (darshana; sets VMIN=1)
    store8(&work + TIO_CC_BASE + TIO_VMIN, 0);         # override to VMIN=0 + VTIME=0: read returns at once
    store8(&work + TIO_CC_BASE + TIO_VTIME, 0);
    if (syscall(SYS_IOCTL, 0, TCSETS, &work) < 0) { return 0; }
    _intr_active = 1;
    #endif
    return 0;
}

# intr_poll: while armed, non-blockingly DRAIN pending stdin; set _intr_flag if any byte is Esc (27).
# All pending bytes are consumed so mid-turn keystrokes don't leak into the next composer read. Any Esc
# — including the lead byte of an arrow/mouse/paste sequence typed mid-turn — counts as interrupt (a
# documented, mild edge). Called per SSE frame; between frames thoth blocks in the socket recv, so a
# STALLED stream (no frame arriving) is only interruptible when the next frame lands or sandhi's read
# timeout fires — a documented granularity limit. Safe off Linux: _intr_active is never set there.
fn intr_poll() {
    if (_intr_active == 0) { return _intr_flag; }
    var c[8];
    var n = syscall(SYS_READ, 0, &c, 1);
    while (n > 0) {
        if (load8(&c) == 27) { _intr_flag = 1; }
        n = syscall(SYS_READ, 0, &c, 1);
    }
    return _intr_flag;
}

# intr_disarm: restore the saved cooked termios (for a following read_line confirm / the next turn).
fn intr_disarm() {
    #ifdef CYRIUS_TARGET_LINUX
    if (_intr_active == 1) { syscall(SYS_IOCTL, 0, TCSETS, _intr_saved); _intr_active = 0; }
    #endif
    return 0;
}

# intr_note: land the honest "— interrupted" marker as its own feed line (NEVER appended to the reply
# text that enters history — history holds the clean partial; this is a UI annotation only).
fn intr_note() { ui_emit(ROLE_MUTED, "  — interrupted"); oprintln(""); return 0; }

# _tui_mouse_click: act on a left-click at (_mouse_row, _mouse_col) (1-based). A click inside the
# file-tree pane (shown, within cols [1,tw] and the feed band rows) selects that node — a dir toggles
# expand/collapse, a file just selects — and focuses the tree; a click anywhere else focuses the
# composer. Uses the SAME geometry the painter uses (tui_draw_tree / _ftree_scroll_first) so the
# clicked screen row maps to the painted node. I/O — live-tty verified.
fn _tui_mouse_click() {
    var r = _mouse_row;
    var col = _mouse_col;
    if (_tui_show_tree == 1) {
        var tw = tui_tree_w(_tui_cols, 1);
        var top = tui_feed_top(_tui_show_status);
        var bot = tui_feed_bot(_tui_rows, led_lines(), _tui_show_status);
        if ((col <= tw) && (r >= top) && (r <= bot)) {           # a click in the tree pane
            var total = ftree_count();
            var rows = bot - top + 1;
            var first = _ftree_scroll_first(total, rows);
            var li = first + (r - top);
            _tui_focus = FOCUS_TREE;
            if ((li >= 0) && (li < total)) {
                ftree_set_sel(li);                               # clamped absolute select
                if (ftree_isdir(li) == 1) {                      # dir -> toggle expand/collapse
                    if (ftree_exp(li) == 1) { ftree_collapse(); } else { ftree_expand(); }
                    tui_relayout();                              # the visible row count changed
                } else {
                    tui_draw_tree(); tui_draw_hint(); tui_park_cursor();   # file -> selection moved
                }
            } else {
                tui_draw_hint(); tui_park_cursor();              # empty tree area -> just focus tree
            }
            return 0;
        }
    }
    _tui_focus = FOCUS_COMPOSER;                                 # anywhere else -> focus the composer
    tui_draw_hint(); tui_park_cursor();
    return 0;
}

# tui_loop: the T2 front-end. Alt-screen + raw mode + the pinned-status / self-managed
# feed / raw-composer layout. Falls back to repl_loop if the tty isn't usable. This
# is interactive terminal control — verify on a live TTY (`--tier=rich`), not piped.
fn tui_loop() {
    if (tty_isatty(0) == 0) { return repl_loop(); }
    if (tty_raw(0) < 0) { return repl_loop(); }   # no raw mode -> degrade to the REPL
    # Block SIGINT for the whole TUI session (sigprocmask via signalfd). The dispatch
    # window runs in COOKED mode (ISIG on) so a Ctrl-C there would otherwise raise
    # SIGINT and, with no handler, kill us WITH the alt-screen up + scroll region set
    # (garbled terminal). Blocked, it's queued to the signalfd (unread) and discarded
    # at exit; the raw-mode composer's own Ctrl-C still exits cleanly (KEY_CTRLC).
    #ifndef CYRIUS_TARGET_AGNOS
    _sigint_fd = tty_open_signalfd(2);   # block SIGINT (mask bit for signal 2) for the session
    #endif
    _events_ok = tui_events_init();      # the stdin + SIGWINCH epoll multiplex (instant resize; 0 on agnos)
    tty_alt_enter();
    tui_kitty_enable();                           # 0.11.9: Shift+Enter via the kitty keyboard protocol
    tui_bpaste_enable();                          # 0.17.0: bracketed paste (multi-line paste -> composer)
    tui_mouse_enable();                           # 0.17.2: SGR mouse (wheel scroll, click focus/tree)
    tty_clear();
    led_reset();
    feed_init();                                  # 0.9.1: the self-managed feed ring
    inhist_init();                                # 0.11.1: the composer input-history recall ring
    out_mode_set(OUT_RING);                        # seed the welcome banner into the feed
    # the scribe greeting, sourced from the avatara persona (mirrors print_banner):
    ui_emit(ROLE_ACCENT, persona_name()); emit(", "); ui_emit(ROLE_ACCENT_DIM, persona_role());
    emit(" - "); ui_emit(ROLE_ACCENT, "{(o>");
    feed_flush_pending();
    ui_emit(ROLE_MUTED, persona_tagline());
    feed_flush_pending();
    # 0.11.9: the greeting states the LIVE inference status (was a hardcoded "READY"). A real
    # reachability PROBE (hoosh_reachable — a silent GET to the gateway), not mere config:
    # READY when the gateway actually answers; otherwise it says so (unreachable when a URL is
    # set, absent when none is) — honest, never faked. The "type a task" guidance is below.
    ui_emit(ROLE_FAINT, "Status: ");
    if (hoosh_health_probe() == HOOSH_HEALTH_UP) {   # 0.19.3: probe + SEED the cached health for the status-bar dot
        ui_emit(ROLE_GREEN, "READY");
    } elif (config_hoosh_configured() == 1) {
        ui_emit(ROLE_RED, "hoosh unreachable");
        ui_emit(ROLE_FAINT, " — "); emit(config_hoosh_url()); ui_emit(ROLE_FAINT, " (is the gateway up?)");
    } else {
        ui_emit(ROLE_RED, "hoosh absent");
        ui_emit(ROLE_FAINT, " — no model turns; set [hoosh].url");
    }
    feed_flush_pending();
    ui_emit(ROLE_FAINT, "type a task, or /help. Ctrl-X exits.");
    feed_flush_pending();
    # 0.11.2: bind opt-in input-history persistence ([history].file). Loads prior lines
    # into the recall ring and announces honestly into the feed — the active path + how
    # many were recalled, or a degrade-closed "cannot write" note (recall then stays
    # in-memory only). The banner does NOT assert a file mode: 0600 is the best-effort
    # CREATE mode (see src/inhist.cyr — not guaranteed for a pre-existing file or on the
    # AGNOS frozen ABI), so we never print a permission we can't universally verify. Off
    # entirely when [history].file is unset.
    var _hpath = config_history_file();
    if (_hpath != 0) {
        var _hn = inhist_persist_init(_hpath);
        if (_hn >= 0) {
            ui_emit(ROLE_FAINT, "input history: "); emit(_hpath);
            ui_emit(ROLE_FAINT, " ("); ofmt_int(_hn); ui_emit(ROLE_FAINT, " recalled)");
        } else {
            ui_emit(ROLE_FAINT, "input history: cannot write "); emit(_hpath);
            ui_emit(ROLE_FAINT, " — not persisted (in-memory only)");
        }
        feed_flush_pending();
    }
    sess_persist_greeting();   # 0.24.2: "resumed N messages …" (bound in main.cyr before the loop); silent if not resuming
    feed_flush_pending();
    out_mode_set(OUT_FD1);
    _tui_running = 1;
    tui_relayout();
    while (_tui_running == 1) {
        # wait on stdin + the SIGWINCH signalfd (instant resize); EV_KEY -> read a key.
        var ev = EV_KEY;
        if (_events_ok == 1) { ev = tui_wait_event(); }
        if (ev == EV_WINCH) {
            tui_drain_winch();
            tty_clear();                 # geometry changed; full repaint at the new size
            tui_relayout();
            if (_mpick_active == 1) { _tui_pick_paint(); }         # 0.24.0: the picker owns the feed band while open
        } else {
            var key = tui_read_key();
            if (_mpick_active == 1) { _tui_pick_key(key); }         # 0.24.0: the model picker owns every key while active
            elif (_fsearch_active == 1) { _tui_search_key(key); }   # 0.18.4: the search modal owns every key while active
            elif (key == KEY_FIND) { _tui_search_enter(); }        # Ctrl-F -> open feed search
            elif (key == KEY_PICK) { _tui_pick_enter(); }          # Ctrl-P -> open the model picker (0.24.0)
            elif (key == KEY_TOGGLE_STATUS) {
                if (_tui_show_status == 1) { _tui_show_status = 0; } else { _tui_show_status = 1; }
                tty_clear();           # the feed band moves; full repaint
                tui_relayout();
            } elif (key == KEY_TOGGLE_TREE) {
                if (_tui_show_tree == 1) { _tui_show_tree = 0; _tui_focus = FOCUS_COMPOSER; }
                else {
                    _tui_show_tree = 1;
                    if (ftree_count() == 0) { ftree_load(); }   # lazily list $PWD on first show
                    _tui_focus = FOCUS_TREE;
                }
                tty_clear();           # the feed narrows/widens; full repaint
                tui_relayout();
            } elif (key == KEY_TOGGLE_THEME) {
                ui_set_theme(1 - ui_theme());   # dark <-> light; rebuilds the SGR table
                tty_clear();           # re-color the whole frame
                tui_relayout();
            } elif (key == KEY_REPROBE) {
                # 0.19.3: Ctrl-R re-probes hoosh reachability (a silent GET; no idle timer). Probe while
                # OUT_FD1 (it emits nothing), then note the outcome to the feed + repaint the status dot.
                var _reach = HOOSH_HEALTH_DOWN;
                if (config_hoosh_configured() == 1) { _reach = hoosh_health_probe(); }
                out_mode_set(OUT_RING);
                if (config_hoosh_configured() == 0) { ui_emit(ROLE_RED, "hoosh: absent"); ui_emit(ROLE_FAINT, " — set [hoosh].url in thoth.cyml"); }
                elif (_reach == HOOSH_HEALTH_UP) { ui_emit(ROLE_GREEN, "hoosh: reachable"); }
                else { ui_emit(ROLE_RED, "hoosh: unreachable"); ui_emit(ROLE_FAINT, " — "); emit(config_hoosh_url()); }
                feed_flush_pending();
                out_mode_set(OUT_FD1);
                tui_relayout();
            } elif (key == KEY_TAB) {
                # 0.21.1: in the composer, Tab on a `@<prefix>` completes the path from the file tree
                # (consuming the Tab); otherwise Tab toggles composer<->tree focus (the prior behavior).
                var atc = 0;
                if (_tui_focus == FOCUS_COMPOSER) {
                    var atc_before_h = tui_cur_composer_height();
                    atc = _tui_at_complete();
                    if (atc == 1) { tui_after_edit(atc_before_h); }
                }
                if (atc == 0) {
                    if (_tui_show_tree == 1) {
                        if (_tui_focus == FOCUS_TREE) { _tui_focus = FOCUS_COMPOSER; } else { _tui_focus = FOCUS_TREE; }
                        tui_draw_hint(); tui_park_cursor();
                    }
                }
            } elif (key == KEY_SCROLL_UP) { _tui_feed_scroll_by(3);
            } elif (key == KEY_SCROLL_DOWN) { _tui_feed_scroll_by(0 - 3);
            } elif (key == KEY_PGUP) { _tui_feed_scroll_by(_tui_feed_rows() - 1);
            } elif (key == KEY_PGDN) { _tui_feed_scroll_by(0 - (_tui_feed_rows() - 1));
            } elif (key == KEY_MOUSE) { _tui_mouse_click();   # 0.17.2: left-click -> focus composer/tree (before FOCUS_TREE so it works in any focus)
            } elif (_tui_focus == FOCUS_TREE) {
                _tui_tree_key(key);    # tree navigation (↑↓→← Enter; a char hands focus back)
            } elif ((key == KEY_UP) || (key == KEY_DOWN)) {
                # composer focus (the FOCUS_TREE branch above already took tree nav). FIRST
                # move the cursor BETWEEN composer lines (multi-line draft, 0.11.9); only at
                # the top/bottom EDGE fall through to input-history recall (0.11.1), which
                # stays gated on the slash palette being closed at the start (Up/Down free
                # while composing a /command). led_up/led_down return 1 if moved, 0 at the
                # edge. ORDERING IS LOAD-BEARING: this elif must stay AFTER the FOCUS_TREE
                # branch — Up/Down are also the tree's nav keys.
                var moved = 0;
                if (key == KEY_UP) { moved = led_up(); } else { moved = led_down(); }
                if (moved == 1) { tui_draw_composer(); }   # cursor moved a line; height unchanged
                elif ((inhist_nav_at_draft() == 0) || (tui_palette_active() == 0)) { _tui_recall_key(key); }
            } elif (key == KEY_PASTE) {
                # 0.17.0: a bracketed paste — insert the whole slurped body into the composer.
                # Multi-line lands as text; it NEVER auto-submits (submission stays a deliberate
                # Enter). A composer-focus action; a paste while the tree is focused is caught by
                # the FOCUS_TREE branch above and no-ops (the body was already consumed -> no desync).
                var before_hp = tui_composer_height(_tui_rows, led_lines(), _tui_show_status);
                led_paste(_paste_buf, _paste_len);
                tui_after_edit(before_hp);   # reflow if the paste grew the composer; else a cheap redraw
            } else {
                var before_h = tui_composer_height(_tui_rows, led_lines(), _tui_show_status);
                var act = led_feed(key, _tui_key_ch);
                if (act == ACT_SUBMIT) {
                    var stored = inhist_push(led_buf(), led_len());   # record (ignoredups, skip-empty)
                    if (stored == 1) { inhist_persist_save(); }       # 0.11.2: mirror to [history].file if active
                    inhist_nav_reset();                  # next Up starts from the newest again
                    var line = _tui_copy_line();   # snapshot the line before clearing
                    led_reset();
                    tui_repaint_body();            # composer empties IMMEDIATELY (+ feed reflows if it was multi-line)
                    var keep = tui_run_line(line);
                    if (inhist_persist_broke() == 1) {   # 0.11.2: a save failed mid-session -> announce ONCE
                        inhist_persist_broke_ack();
                        out_mode_set(OUT_RING);
                        ui_emit(ROLE_FAINT, "input history: write failed — persistence disabled for this session");
                        feed_flush_pending();
                        out_mode_set(OUT_FD1);
                    }
                    if (sess_persist_broke() == 1) {     # 0.24.2: a conversation-file save failed mid-session -> announce ONCE
                        sess_persist_broke_ack();
                        out_mode_set(OUT_RING);
                        ui_emit(ROLE_FAINT, "session file: write failed — resume disabled for this session");
                        feed_flush_pending();
                        out_mode_set(OUT_FD1);
                    }
                    if (keep == 0) { _tui_running = 0; }
                    else { tui_relayout(); }
                } elif (act == ACT_EOF) {
                    _tui_running = 0;
                } else {
                    tui_after_edit(before_h);   # a newline grew/shrank the composer -> reflow; else cheap redraw
                }
            }
        }
    }
    # teardown — restore the terminal on every exit path.
    tui_mouse_disable();            # 0.17.2: stop SGR mouse reporting (don't leave the terminal in it)
    tui_bpaste_disable();           # 0.17.0: pop bracketed-paste mode
    tui_kitty_disable();            # 0.11.9: pop the kitty keyboard protocol (restore legacy keys)
    tty_cursor_show();
    tty_cooked();
    _tui_scroll_region(1, _tui_rows);
    tty_alt_leave();
    tui_events_teardown();          # close the signalfds (restore the signal mask) + epoll fd
    return 0;
}
