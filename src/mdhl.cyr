# thoth — markdown fenced-code-block highlighter for the reply feed (0.15.1).
#
# The model's reply is markdown. Where /read (0.8.4) and diff bodies (0.8.5) already
# syntax-colour source, this colours the code INSIDE a fenced block (```bash, ```python,
# ~~~c, …) shown in the reply feed. It is a thin PRESENTATION layer over the SAME
# coverage-guarded highlighter — `_hl_span` (src/diff.cyr) — reused UNCHANGED: the whole
# block is fed to ONE tokenize_stream so multi-line strings / block comments colour
# correctly, and `_hl_span` emits any uncovered gap + trailing bytes VERBATIM, so
# highlighting NEVER drops or reorders a byte.
#
# SHAPE (a module-global singleton, like src/feed.cyr / src/inhist.cyr; one reply turn
# is strictly sequential, so no reentrancy). Four entry points, all funnelling through
# `_mdhl_consume` (a line assembler) + a fence state machine:
#   mdhl_reset()       — clear state at the start of a streamed turn/iteration
#   mdhl_feed(ptr,n)   — streaming: consume a chunk, act on COMPLETED lines only
#   mdhl_finish()      — streaming: flush the residual partial line + close an open block
#   mdhl_reply(ptr,n)  — blocking: reset(); consume(); finish() over the whole reply
#
# LINE ASSEMBLY dissolves every streaming chunk-boundary split (mid-marker /
# mid-info-string / mid-code-line): no fence decision is EVER made on a partial line.
# STREAMING TRADE: a fenced block is buffered until its closing fence, then highlighted
# in one pass — so a code block appears when its close arrives (prose is unaffected).
# Correctness (whole-block-to-one-stream) over per-line latency; per-line highlighting
# would break multi-line constructs.
#
# FLOOR (byte-identical): at PT_PLAIN (piped / one-shot / CI / NO_COLOR) mdhl_feed and
# mdhl_reply are a strict pass-through — `emit_n(ptr,n)` on the same bytes, same order,
# once — and mdhl_finish is a no-op. So the concatenation of the calls equals today's
# emit_n. The raw reply accumulator (_hoosh_acc) is untouched, so history / --json / -o
# read the RAW bytes. Included AFTER src/diff.cyr (calls _hl_span) — hoosh/agent forward-
# reference mdhl_* the same whole-unit way they reference feed_write.

var MDHL_LINE_CAP = 2048;         # one assembled line (mirrors FEED_LINE_CAP); alloc'd
var MDHL_BLOCK_CAP = 262144;      # 256 KiB accumulated code block; over-cap -> stream verbatim
var MDHL_TAG_CAP = 64;            # the lowercased info-string first-word scratch

var _mdhl_line = 0;               # alloc(MDHL_LINE_CAP): current line being assembled (no '\n')
var _mdhl_line_len = 0;
var _mdhl_line_cont = 0;          # 1 if the line buffer is a continuation of an overflowed logical line
var _mdhl_in_fence = 0;           # 1 while inside a fenced code block
var _mdhl_fence_ch = 0;           # 96 '`' or 126 '~' — the opening fence character
var _mdhl_fence_len = 0;          # opening run length (>= 3)
var _mdhl_fence_info = 0;         # offset into _mdhl_line where the opener's info string begins
var _mdhl_grammar = 0;            # resolved vyakarana grammar name cstr (0 = none/unknown -> verbatim)
var _mdhl_block = 0;              # alloc(MDHL_BLOCK_CAP): accumulated code-block bytes (interior)
var _mdhl_block_len = 0;
var _mdhl_block_over = 0;         # 1 once the block overflowed the cap -> interior streamed verbatim
var _mdhl_block_rows = 0;         # 0.18.3: sealed feed rows emitted LIVE for the current block (TUI)
var _mdhl_tag = 0;               # alloc(MDHL_TAG_CAP): lowercased first info-word scratch

# --- 0.36.3: pipe-table state (line/TUI aligned grid) -------------------------------------------------------------
# A grid needs the WHOLE table (column widths span all rows), but mdhl streams line-at-a-time. Rather than holding
# every '|'-bearing line (one line of latency for common prose), tables ride the 0.18.3 live-card trick: prose is
# emitted immediately as always, and when a DELIMITER row lands right after a matching pipe-bearing header, the
# already-sealed header row is DROPPED from the ring and the table buffered instead — re-emitted as an aligned grid
# on close. Gated on _mdhl_live() (OUT_RING), the only mode that can rewind: the line REPL / PT_PLAIN floor keep
# today's raw-pipe bytes, unchanged.
var MDHL_TBL_CAP = 16384;         # accumulated table rows (header + body, '\n'-separated); over-cap -> verbatim
var MDHL_TBL_DELIM_CAP = 1024;    # the delimiter row (kept for per-column alignment)
var MDHL_TBL_MAXCOL = 16;         # columns laid out; extra columns fall back to verbatim
var _mdhl_tbl = 0;                # alloc(MDHL_TBL_CAP): row 0 = header, then body rows
var _mdhl_tbl_len = 0;
var _mdhl_tbl_over = 0;           # 1 once the table overflowed a cap -> emit the buffered rows verbatim
var _mdhl_in_tbl = 0;             # 1 while accumulating a table
var _mdhl_tbl_delim = 0;          # alloc(MDHL_TBL_DELIM_CAP): the delimiter row text
var _mdhl_tbl_delim_len = 0;
var _mdhl_tbl_ncols = 0;
var _mdhl_tbl_colw = 0;           # alloc(MDHL_TBL_MAXCOL * 8): per-column visible width
var _mdhl_prev = 0;               # alloc(MDHL_LINE_CAP): the last SEALED prose line (a candidate table header)
var _mdhl_prev_len = 0;

# _mdhl_ensure: lazily allocate the three buffers (idempotent). Each is allocated
# independently so a partial failure doesn't wedge the others.
fn _mdhl_ensure() {
    if (_mdhl_line == 0) { _mdhl_line = alloc(MDHL_LINE_CAP); }
    if (_mdhl_block == 0) { _mdhl_block = alloc(MDHL_BLOCK_CAP); }
    if (_mdhl_tag == 0) { _mdhl_tag = alloc(MDHL_TAG_CAP); }
    return 0;
}

# _mdhl_tag_grammar: map a lowercased fence info-word to a vyakarana grammar NAME.
# STRATEGY: alias-table-first only for tags that DIFFER from the canonical name; every
# canonical name (python, ruby, go, c, cpp, …) falls through to `tag` itself, and
# `_hl_span`/`tokenize_stream_new` self-heals an unknown name to verbatim — so the table
# stays small and any future grammar works with no churn. Deliberate non-highlight tags
# (text/plain/diff/…) return 0 so the block is shown verbatim, uncoloured (the correct
# "don't highlight" behaviour), never accidentally matching a future grammar.
fn _mdhl_tag_grammar(tag) {
    if ((streq(tag, "sh") == 1) || (streq(tag, "bash") == 1) || (streq(tag, "zsh") == 1) || (streq(tag, "ksh") == 1) || (streq(tag, "console") == 1) || (streq(tag, "shell-session") == 1) || (streq(tag, "shellsession") == 1)) { return "shell"; }
    if ((streq(tag, "py") == 1) || (streq(tag, "python2") == 1) || (streq(tag, "python3") == 1)) { return "python"; }
    if ((streq(tag, "js") == 1) || (streq(tag, "node") == 1) || (streq(tag, "nodejs") == 1) || (streq(tag, "mjs") == 1) || (streq(tag, "cjs") == 1) || (streq(tag, "jsx") == 1)) { return "javascript"; }
    if ((streq(tag, "ts") == 1) || (streq(tag, "tsx") == 1) || (streq(tag, "mts") == 1) || (streq(tag, "cts") == 1)) { return "typescript"; }
    if (streq(tag, "rs") == 1) { return "rust"; }
    if (streq(tag, "golang") == 1) { return "go"; }
    if ((streq(tag, "c++") == 1) || (streq(tag, "cpp") == 1) || (streq(tag, "cxx") == 1) || (streq(tag, "cc") == 1) || (streq(tag, "hpp") == 1) || (streq(tag, "hxx") == 1) || (streq(tag, "h++") == 1)) { return "cpp"; }
    if (streq(tag, "h") == 1) { return "c"; }
    if ((streq(tag, "cs") == 1) || (streq(tag, "c#") == 1)) { return "csharp"; }
    if ((streq(tag, "kt") == 1) || (streq(tag, "kts") == 1)) { return "kotlin"; }
    if (streq(tag, "rb") == 1) { return "ruby"; }
    if (streq(tag, "hs") == 1) { return "haskell"; }
    if ((streq(tag, "ex") == 1) || (streq(tag, "exs") == 1)) { return "elixir"; }
    if ((streq(tag, "ml") == 1) || (streq(tag, "mli") == 1)) { return "ocaml"; }
    if (streq(tag, "cr") == 1) { return "crystal"; }
    if (streq(tag, "jl") == 1) { return "julia"; }
    if (streq(tag, "yml") == 1) { return "yaml"; }
    if ((streq(tag, "md") == 1) || (streq(tag, "mkd") == 1) || (streq(tag, "mdown") == 1)) { return "markdown"; }
    if ((streq(tag, "make") == 1) || (streq(tag, "mk") == 1)) { return "makefile"; }
    if ((streq(tag, "docker") == 1) || (streq(tag, "containerfile") == 1)) { return "dockerfile"; }
    if ((streq(tag, "ps") == 1) || (streq(tag, "ps1") == 1) || (streq(tag, "pwsh") == 1)) { return "powershell"; }
    if (streq(tag, "proto") == 1) { return "protobuf"; }
    if (streq(tag, "gql") == 1) { return "graphql"; }
    if (streq(tag, "sass") == 1) { return "scss"; }
    if ((streq(tag, "htm") == 1) || (streq(tag, "xhtml") == 1)) { return "html"; }
    if ((streq(tag, "svg") == 1) || (streq(tag, "xsl") == 1)) { return "xml"; }
    if ((streq(tag, "cfg") == 1) || (streq(tag, "conf") == 1) || (streq(tag, "editorconfig") == 1)) { return "ini"; }
    if (streq(tag, "cyr") == 1) { return "cyrius"; }
    if ((streq(tag, "tf") == 1) || (streq(tag, "hcl") == 1)) { return "terraform"; }
    if ((streq(tag, "ll") == 1) || (streq(tag, "llvm") == 1)) { return "llvm_ir"; }
    if ((streq(tag, "asm") == 1) || (streq(tag, "nasm") == 1) || (streq(tag, "x86") == 1) || (streq(tag, "x86_64") == 1) || (streq(tag, "s") == 1)) { return "asm_x86_64"; }
    if ((streq(tag, "arm") == 1) || (streq(tag, "arm64") == 1) || (streq(tag, "aarch64") == 1)) { return "asm_aarch64"; }
    # deliberate NON-highlight hints -> verbatim (uncoloured), never a grammar
    if ((streq(tag, "text") == 1) || (streq(tag, "txt") == 1) || (streq(tag, "plain") == 1) || (streq(tag, "plaintext") == 1) || (streq(tag, "none") == 1) || (streq(tag, "output") == 1) || (streq(tag, "log") == 1) || (streq(tag, "diff") == 1) || (streq(tag, "tex") == 1) || (streq(tag, "latex") == 1)) { return 0; }
    # otherwise hand the tag straight to _hl_span (self-heals unknown names to verbatim)
    return tag;
}

# _mdhl_scan_fence_open: 1 if _mdhl_line[0.._mdhl_line_len) is a valid OPENING fence
# marker; records _mdhl_fence_ch / _mdhl_fence_len / _mdhl_fence_info. CommonMark: 0..3
# leading spaces, then a run of >= 3 of '`'/'~'; a backtick fence's info string may not
# contain a backtick (so `x`y prose and inline spans never open a block). Tilde fences
# carry no such restriction.
fn _mdhl_scan_fence_open() {
    var i = 0;
    var indent = 0;
    while ((i < _mdhl_line_len) && (load8(_mdhl_line + i) == 32)) { indent = indent + 1; i = i + 1; }
    if (indent > 3) { return 0; }
    if (i >= _mdhl_line_len) { return 0; }
    var ch = load8(_mdhl_line + i);
    if ((ch != 96) && (ch != 126)) { return 0; }
    var run = 0;
    while ((i < _mdhl_line_len) && (load8(_mdhl_line + i) == ch)) { run = run + 1; i = i + 1; }
    if (run < 3) { return 0; }
    if (ch == 96) {
        var j = i;
        while (j < _mdhl_line_len) {
            if (load8(_mdhl_line + j) == 96) { return 0; }
            j = j + 1;
        }
    }
    _mdhl_fence_ch = ch;
    _mdhl_fence_len = run;
    _mdhl_fence_info = i;
    return 1;
}

# _mdhl_scan_fence_close: 1 if _mdhl_line is a valid CLOSING fence for the open block —
# same char, run >= the opener's, and a BLANK info string (only spaces/tabs/CR to EOL;
# CommonMark). CR (13) counts as blank so a CRLF-terminated ```\r closes. Indent 0..3,
# independent of the opener.
fn _mdhl_scan_fence_close() {
    var i = 0;
    var indent = 0;
    while ((i < _mdhl_line_len) && (load8(_mdhl_line + i) == 32)) { indent = indent + 1; i = i + 1; }
    if (indent > 3) { return 0; }
    if (i >= _mdhl_line_len) { return 0; }
    var ch = load8(_mdhl_line + i);
    if (ch != _mdhl_fence_ch) { return 0; }
    var run = 0;
    while ((i < _mdhl_line_len) && (load8(_mdhl_line + i) == ch)) { run = run + 1; i = i + 1; }
    if (run < _mdhl_fence_len) { return 0; }
    while (i < _mdhl_line_len) {
        var b = load8(_mdhl_line + i);
        if ((b != 32) && (b != 9) && (b != 13)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# _mdhl_resolve_grammar: parse the opener's info string (from _mdhl_fence_info) — the
# FIRST word (to the next whitespace/CR; CommonMark), ASCII-lowercased into _mdhl_tag —
# and set _mdhl_grammar via _mdhl_tag_grammar. A blank or over-long (>63) tag -> 0
# (verbatim). _mdhl_tag is stable from this open until the next open (after the block
# flush), so _mdhl_grammar may point into it.
fn _mdhl_resolve_grammar() {
    _mdhl_grammar = 0;
    var i = _mdhl_fence_info;
    while ((i < _mdhl_line_len) && ((load8(_mdhl_line + i) == 32) || (load8(_mdhl_line + i) == 9))) { i = i + 1; }
    var t = 0;
    var over = 0;
    var stop = 0;
    while ((i < _mdhl_line_len) && (stop == 0)) {
        var b = load8(_mdhl_line + i);
        if ((b == 32) || (b == 9) || (b == 13) || (b == 10)) { stop = 1; }
        else {
            if (t < (MDHL_TAG_CAP - 1)) {
                var lc = b;
                if ((b >= 65) && (b <= 90)) { lc = b + 32; }
                store8(_mdhl_tag + t, lc);
                t = t + 1;
            } else { over = 1; }
            i = i + 1;
        }
    }
    if ((t == 0) || (over == 1)) { _mdhl_grammar = 0; return 0; }
    store8(_mdhl_tag + t, 0);
    _mdhl_grammar = _mdhl_tag_grammar(_mdhl_tag);
    return 0;
}

# _mdhl_put_line: emit the assembled line VERBATIM + an optional trailing '\n'. The I/O
# for prose lines and fence delimiter lines (delimiters are markdown punctuation — never
# coloured, so the floor stays trivial and no SGR wraps a soft-wrap boundary).
fn _mdhl_put_line(has_nl) {
    if (_mdhl_line_len > 0) { _mdhl_text(_mdhl_line, _mdhl_line_len); }
    if (has_nl == 1) { emit("\n"); }
    return 0;
}

# --- inline markdown styling (0.18.8) --------------------------------------
# Style a PROSE line's headings / bold / inline-code / list markers. Each construct only WRAPS its bytes in
# SGR (open + verbatim bytes + ui_reset()), never dropping or reordering a byte -> strip_sgr(output) == the
# raw line (the 0.15.1 discipline, property-tested). Colors go through ui_sgr(role): at OUT_RING (TUI)
# _feed_pack rewrites them to role MARKERS (so /theme recolors) and ui_reset() to a RESET marker (which
# CLEARS feed_clip_seg's 64B soft-wrap carry, so inline spans never overflow it); bold is a raw ESC[1m
# (theme-independent, kept verbatim by _feed_pack, turned off by the closing reset). Spans DO NOT nest.
# FLOOR: only reached at PT_ANSI/PT_RICH (mdhl_feed/reply early-return emit_n at PT_PLAIN); and if a gate is
# somehow hit at PT_PLAIN, ui_sgr/ui_reset return "" so _mdhl_span is still byte-identical.

# _mdhl_text: the ONE sink every prose BYTE passes through (0.38.1). Verbatim, except under the line tier's
# rainbow, where it tints per glyph (_mdhl_rainbow_text). Byte-identical to a bare emit_n whenever the rainbow
# isn't drawable here — which includes the whole PT_PLAIN floor and the entire TUI (there the compact role
# MARKER must reach the 2048 B feed slot and the PAINTER tints instead; see ui_rainbow_line).
# _mdhl_rainbow_text: the LINE-tier prose tint — one hue per GLYPH, closed by a single reset. Returns 1 if it
# handled the span, else 0. It lives HERE, not in ui.cyr, for one concrete reason: it needs feed_glyph_cols
# (feed.cyr is included after ui.cyr, so ui.cyr cannot see it) to tell a zero-width mark from a real glyph.
#
# Three byte classes, and each rule is a bug this fixes:
#   - CONTINUATION byte (0x80..0xBF) => we are INSIDE a codepoint that a caller-side flush severed (mdhl
#     force-flushes at MDHL_LINE_CAP, which can land mid-glyph). Emit it bare: an escape inserted between a
#     glyph's bytes splits the codepoint and the terminal renders replacement characters. Verbatim bytes
#     reassemble across calls; escaped ones do not.
#   - ZERO-WIDTH glyph (a combining mark) => no escape, no phase step: it composes onto the base glyph and must
#     INHERIT its hue. A separate hue for a mark is meaningless, and 0.38.1 already applies this rule in the
#     painter — applying it in only one tier is how the two surfaces disagreed.
#   - whitespace => no escape (a tinted space paints nothing) but it STILL steps the phase, so the gradient
#     tracks column position rather than word boundaries.
fn _mdhl_rainbow_text(ptr, n) {
    if (ui_rainbow_line() == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var gl = _ui_glyph_len(ptr, i, n);
        var b = load8(ptr + i);
        if ((b >= 128) && (b < 192)) {                    # severed continuation — never escape mid-codepoint
            emit_n(ptr + i, gl);
        } elif (feed_glyph_cols(ptr, i, gl) == 0) {       # zero-width — inherit the base glyph's hue
            emit_n(ptr + i, gl);
        } elif ((b == 32) || (b == 9) || (b == 10) || (b == 13)) {
            emit_n(ptr + i, gl);
            ui_rainbow_step_phase();
        } else {
            emit(ui_rainbow_sgr(ui_rainbow_phase()));
            emit_n(ptr + i, gl);
            ui_rainbow_step_phase();
        }
        i = i + gl;
    }
    emit(ui_reset());
    return 1;
}

fn _mdhl_text(ptr, n) {
    if (_mdhl_rainbow_text(ptr, n) == 1) { return 0; }
    emit_n(ptr, n);
    return 0;
}

# _mdhl_span: emit ptr[0..n) wrapped in a style (bold=1 -> ESC[1m, else the role color), closed by ui_reset.
# Under the line tier's rainbow the role COLOR is overridden per glyph, so its SGR is skipped (it would be
# immediately overwritten) — but BOLD still opens: bold is weight, rainbow is color, and they compose.
fn _mdhl_span(bold, role, ptr, n) {
    if (n <= 0) { return 0; }
    if (bold == 1) { emit("\x1b[1m"); } elif (ui_rainbow_line() == 0) { emit(ui_sgr(role)); }
    _mdhl_text(ptr, n);
    emit(ui_reset());
    return 0;
}

# _mdhl_emit_inline: style the inline spans of ptr[0..len) — driving from the SHARED model (0.36.2). md_inline_scan
# yields contiguous {start,len,role} runs (code has precedence, its interior isn't re-scanned, unmatched delimiters
# latch off — the same LINEAR contract the old _mdhl_inline_scan had); each run is emitted plain (verbatim), code
# (ROLE_BLUE), or bold (ESC[1m). Byte-identical to the pre-0.36.2 hand-rolled scan (verified by the mdhl tests).
fn _mdhl_emit_inline(ptr, len) {
    md_inline_scan(ptr, len);
    var n = md_run_count();
    var k = 0;
    var covered = 0;                                      # end of the last recorded run
    while (k < n) {
        var rs = md_run_start(k);
        var rl = md_run_len(k);
        var role = md_run_role(k);
        if (role == MDI_CODE) { _mdhl_span(0, ROLE_BLUE, ptr + rs, rl); }
        elif (role == MDI_BOLD) { _mdhl_span(1, 0, ptr + rs, rl); }
        else { _mdhl_text(ptr + rs, rl); }                # MDI_PLAIN -> verbatim (tinted under line-tier rainbow)
        covered = rs + rl;
        k = k + 1;
    }
    # If md_inline_scan hit its MD_RUN_CAP (runs are recorded left-to-right, so the DROPPED runs are the tail),
    # emit the uncovered tail verbatim — the highlighter must NEVER drop a byte (ADR-0009). Styling of the overflow
    # tail degrades to plain (only on a pathological >512-span line); the visible text stays byte-complete.
    if (covered < len) { _mdhl_text(ptr + covered, len - covered); }
    return 0;
}

# _mdhl_inline_line: the prose-line entry (replaces _mdhl_put_line for a non-fence, non-continuation line). Now
# driven by the shared model's md_classify (0.36.2 — one classifier for line/TUI + GUI): heading / blockquote style
# the whole line one color (the #s / '>' kept, as before); a list styles its indent plain + marker ROLE_ACCENT and
# inline-scans the remainder from just after the marker; anything else (para / blank) is inline-scanned whole.
# Preserves the optional trailing '\n'. Output is byte-identical to the pre-migration path.
fn _mdhl_inline_line(has_nl) {
    if ((ui_tier() == PT_PLAIN) || (_mdhl_line == 0)) { _mdhl_put_line(has_nl); return 0; }
    if (_mdhl_line_len == 0) { if (has_nl == 1) { emit("\n"); } return 0; }
    var k = md_classify(_mdhl_line, _mdhl_line_len);
    if (k == MDB_HEADING) { _mdhl_span(0, ROLE_ACCENT, _mdhl_line, _mdhl_line_len); if (has_nl == 1) { emit("\n"); } return 0; }
    if (k == MDB_QUOTE) { _mdhl_span(0, ROLE_MUTED, _mdhl_line, _mdhl_line_len); if (has_nl == 1) { emit("\n"); } return 0; }
    if (k == MDB_LIST) {
        var ms = md_marker_start();
        var me = ms + md_marker_len();                    # offset just after the marker (the following space is inline-scanned plain)
        if (ms > 0) { emit_n(_mdhl_line, ms); }           # leading indent, plain
        _mdhl_span(0, ROLE_ACCENT, _mdhl_line + ms, md_marker_len());   # the marker, styled
        _mdhl_emit_inline(_mdhl_line + me, _mdhl_line_len - me);
    } else {
        _mdhl_emit_inline(_mdhl_line, _mdhl_line_len);    # MDB_PARA / MDB_BLANK -> inline-scan the whole line
    }
    if (has_nl == 1) { emit("\n"); }
    return 0;
}

# _mdhl_live: 1 when the streamed reply is CAPTURED into the TUI feed ring (OUT_RING) — the only mode
# where the live fenced-code upgrade (0.18.3) applies. The line REPL (OUT_FD1) and the plain floor can't
# rewind already-emitted output, so they keep the withhold-until-close behaviour.
fn _mdhl_live() { if (out_mode() == OUT_RING) { return 1; } return 0; }

# _mdhl_block_append: append the assembled interior line (+ optional '\n') to the code-block buffer.
# Returns 1 if it fit, 0 if it would overflow MDHL_BLOCK_CAP (or the buffer is missing). Pure (no emit).
fn _mdhl_block_append(has_nl) {
    if (_mdhl_block == 0) { return 0; }
    var need = _mdhl_line_len;
    if (has_nl == 1) { need = need + 1; }
    if ((_mdhl_block_len + need) > MDHL_BLOCK_CAP) { return 0; }
    var k = 0;
    while (k < _mdhl_line_len) { store8(_mdhl_block + _mdhl_block_len + k, load8(_mdhl_line + k)); k = k + 1; }
    _mdhl_block_len = _mdhl_block_len + _mdhl_line_len;
    if (has_nl == 1) { store8(_mdhl_block + _mdhl_block_len, 10); _mdhl_block_len = _mdhl_block_len + 1; }
    return 1;
}

# _mdhl_block_put: handle one interior line. LIVE (TUI feed, 0.18.3): emit the line live (unhighlighted)
# + count the sealed row + buffer it for the at-close highlight — latch over if it won't fit, but do NOT
# flush the buffer (the line is already live; flushing would double it). NON-live (line REPL / plain): the
# withhold-until-close path — buffer, and on overflow flush the buffered prefix + emit this line verbatim
# + latch over (bounded memory, no byte lost).
fn _mdhl_block_put(has_nl) {
    if (_mdhl_live() == 1) {
        _mdhl_put_line(has_nl);
        if (has_nl == 1) { _mdhl_block_rows = _mdhl_block_rows + 1; }   # one logical line -> one sealed row
        if (_mdhl_block_over == 0) { if (_mdhl_block_append(has_nl) == 0) { _mdhl_block_over = 1; } }
        return 0;
    }
    if ((_mdhl_block == 0) || (_mdhl_block_over == 1)) { _mdhl_put_line(has_nl); _mdhl_block_over = 1; return 0; }
    if (_mdhl_block_append(has_nl) == 0) {
        if (_mdhl_block_len > 0) { emit_n(_mdhl_block, _mdhl_block_len); _mdhl_block_len = 0; }
        _mdhl_put_line(has_nl);
        _mdhl_block_over = 1;
    }
    return 0;
}

# _mdhl_block_flush: emit the accumulated interior — highlighted through _hl_span when a
# grammar resolved (and not overflowed / not plain), else verbatim. _hl_span is coverage-
# guarded (never drops a byte) and self-heals an unknown grammar to verbatim.
fn _mdhl_block_flush() {
    if (_mdhl_block_over == 1) { return 0; }       # interior already streamed verbatim
    if (_mdhl_block_len == 0) { return 0; }        # empty block
    if ((_mdhl_grammar != 0) && (ui_tier() != PT_PLAIN)) {
        _hl_span(_mdhl_grammar, _mdhl_block, _mdhl_block_len, ui_reset());
    } else {
        emit_n(_mdhl_block, _mdhl_block_len);
    }
    return 0;
}

# _mdhl_block_close: finalize a fenced block. LIVE (0.18.3, TUI feed): if the interior fully buffered and
# a grammar resolved, DROP the live (unhighlighted) interior rows AND the un-sealed live partial (a
# truncated / interrupted block leaves its last newline-less line in the pending, which feed_drop_last
# can't reach) and re-emit the whole block highlighted — the in-place upgrade. Otherwise (over / no
# grammar) the live verbatim rows already stand, so do nothing. NON-live (line REPL / plain): flush the
# buffer (highlighted or verbatim) — the withhold-until-close path, unchanged.
fn _mdhl_block_close() {
    if (_mdhl_live() == 1) {
        # Upgrade only when the drop is EXACT: the interior is the last _mdhl_block_rows sealed rows AND
        # they're all still present (_mdhl_block_rows <= feed_count()). A huge block (> FEED_ROWS interior
        # lines but under MDHL_BLOCK_CAP) evicts the opener/prior rows while streaming; feed_drop_last would
        # then over-clamp and wipe unrelated ring content — so fall back to leaving the live verbatim rows.
        if ((_mdhl_block_over == 0) && (_mdhl_grammar != 0) && (ui_tier() != PT_PLAIN) && (_mdhl_block_rows <= feed_count())) {
            feed_drop_last(_mdhl_block_rows);      # drop the sealed live interior rows
            feed_drop_pending();                    # discard an un-sealed live partial (truncated block)
            _mdhl_block_flush();                     # re-emit the whole interior, highlighted
        }
        return 0;
    }
    _mdhl_block_flush();
    return 0;
}

# --- 0.36.3: pipe-table accumulation + aligned-grid emit ----------------------------------------------------------
var MDHL_TBL_GAP = 2;             # blank columns of gutter between table columns
var MDHL_TBL_MAXW = 1024;         # widest grid laid out (visible columns); wider -> spill verbatim (see _mdhl_tbl_close)
var _mdhl_tbl_align = 0;          # alloc(MDHL_TBL_MAXCOL * 8): per-column alignment (0 left / 1 center / 2 right)
fn _mdhl_tbl_init() {
    if (_mdhl_tbl == 0) { _mdhl_tbl = alloc(MDHL_TBL_CAP); }
    if (_mdhl_tbl_delim == 0) { _mdhl_tbl_delim = alloc(MDHL_TBL_DELIM_CAP); }
    if (_mdhl_tbl_colw == 0) { _mdhl_tbl_colw = alloc(MDHL_TBL_MAXCOL * 8); }
    if (_mdhl_tbl_align == 0) { _mdhl_tbl_align = alloc(MDHL_TBL_MAXCOL * 8); }
    if (_mdhl_prev == 0) { _mdhl_prev = alloc(MDHL_LINE_CAP); }
    return 0;
}

fn _mdhl_has_pipe(ptr, len) {
    var i = 0;
    while (i < len) { if (load8(ptr + i) == 124) { return 1; } i = i + 1; }
    return 0;
}
fn _mdhl_is_blank(ptr, len) {
    var i = 0;
    while (i < len) { var c = load8(ptr + i); if ((c != 32) && (c != 9) && (c != 13)) { return 0; } i = i + 1; }
    return 1;
}
# _mdhl_tbl_is_row: a line continues the table while it is non-blank AND carries a '|' (mirrors the header rule).
fn _mdhl_tbl_is_row(ptr, len) {
    if (_mdhl_is_blank(ptr, len) == 1) { return 0; }
    return _mdhl_has_pipe(ptr, len);
}

# _mdhl_tbl_spill: give up on the grid and emit the table's ORIGINAL bytes — the buffered header (row 0), the
# delimiter (held aside by try_open and never emitted), then the remaining buffered rows. try_open dropped the live
# header row from the ring, so this restores it: after a spill the table's bytes are complete and in order.
fn _mdhl_tbl_spill() {
    if (_mdhl_tbl_len == 0) { return 0; }
    var re = 0;
    while ((re < _mdhl_tbl_len) && (load8(_mdhl_tbl + re) != 10)) { re = re + 1; }
    emit_n(_mdhl_tbl, re + 1);                                                       # header + its '\n'
    if (_mdhl_tbl_delim_len > 0) { emit_n(_mdhl_tbl_delim, _mdhl_tbl_delim_len); emit("\n"); }
    if ((re + 1) < _mdhl_tbl_len) { emit_n(_mdhl_tbl + re + 1, _mdhl_tbl_len - (re + 1)); }   # body rows
    _mdhl_tbl_len = 0;
    return 0;
}

# _mdhl_tbl_put: append a row (+ '\n') to the table buffer. On overflow, SPILL what's buffered verbatim and latch
# over — every later row then streams verbatim. Unlike a fenced block (whose interior is emitted live and only
# re-emitted on close), a table's rows are NOT emitted as they arrive, so this buffer is their only copy: dropping
# on overflow would lose model output outright (mdhl must NEVER drop a byte). Mirrors _mdhl_block_put's contract.
fn _mdhl_tbl_put(ptr, len) {
    if (_mdhl_tbl_over == 1) { emit_n(ptr, len); emit("\n"); return 0; }             # already spilled -> stream on
    if ((_mdhl_tbl_len + len + 1) > MDHL_TBL_CAP) {
        _mdhl_tbl_spill();
        _mdhl_tbl_over = 1;
        emit_n(ptr, len); emit("\n");                                                 # the row that didn't fit
        return 0;
    }
    memcpy(_mdhl_tbl + _mdhl_tbl_len, ptr, len);
    _mdhl_tbl_len = _mdhl_tbl_len + len;
    store8(_mdhl_tbl + _mdhl_tbl_len, 10);
    _mdhl_tbl_len = _mdhl_tbl_len + 1;
    return 0;
}

# _mdhl_prev_save: remember a SEALED prose line as a candidate table header. Only sealed lines (has_nl) qualify —
# an unsealed force-flushed continuation is still in the feed's pending, which feed_drop_last cannot reach.
fn _mdhl_prev_save(ptr, len) {
    _mdhl_tbl_init();
    if (len > (MDHL_LINE_CAP - 1)) { _mdhl_prev_len = 0; return 0; }
    memcpy(_mdhl_prev, ptr, len);
    _mdhl_prev_len = len;
    return 0;
}

# _mdhl_tbl_try_open: the current line is a delimiter row directly under a pipe-bearing header with a MATCHING
# column count -> a table. Drop the header's already-sealed feed row and start buffering. 1 if a table opened.
# LIVE-only (OUT_RING): the line REPL / PT_PLAIN floor can't rewind, so they keep today's raw-pipe bytes.
fn _mdhl_tbl_try_open() {
    if (_mdhl_live() == 0) { return 0; }
    if (ui_tier() == PT_PLAIN) { return 0; }
    if (_mdhl_prev_len <= 0) { return 0; }
    if (_mdhl_has_pipe(_mdhl_prev, _mdhl_prev_len) == 0) { return 0; }
    if (md_is_delim_row(_mdhl_line, _mdhl_line_len) == 0) { return 0; }
    var dcols = md_cell_count();                       # delimiter columns (md_is_delim_row split it)
    var hcols = md_row_split(_mdhl_prev, _mdhl_prev_len);
    if (dcols != hcols) { return 0; }                  # GFM: the delimiter must match the header's column count
    if (hcols > MDHL_TBL_MAXCOL) { return 0; }
    if (feed_count() < 1) { return 0; }                # the header row must still be in the ring to drop exactly
    feed_drop_last(1);                                 # un-emit the live header row
    _mdhl_tbl_init();
    _mdhl_tbl_len = 0;
    _mdhl_tbl_over = 0;
    _mdhl_tbl_put(_mdhl_prev, _mdhl_prev_len);         # row 0 = the header
    if (_mdhl_line_len > (MDHL_TBL_DELIM_CAP - 1)) { _mdhl_tbl_delim_len = 0; }
    else { memcpy(_mdhl_tbl_delim, _mdhl_line, _mdhl_line_len); _mdhl_tbl_delim_len = _mdhl_line_len; }
    _mdhl_tbl_ncols = hcols;
    _mdhl_in_tbl = 1;
    _mdhl_prev_len = 0;
    return 1;
}

fn _mdhl_pad(n) {
    var i = 0;
    while (i < n) { emit(" "); i = i + 1; }
    return 0;
}

# _mdhl_tbl_row_widths: grow _mdhl_tbl_colw[k] to the k-th cell's VISIBLE width (feed_visible_cols is SGR- and
# wide-glyph-aware, so a CJK cell aligns correctly).
fn _mdhl_tbl_row_widths(rptr, rlen, ncols) {
    md_row_split(rptr, rlen);
    var n = md_cell_count();
    var k = 0;
    while (k < ncols) {
        var w = 0;
        if (k < n) { w = feed_visible_cols(rptr + md_cell_start(k), md_cell_len(k)); }
        if (w > load64(_mdhl_tbl_colw + k * 8)) { store64(_mdhl_tbl_colw + k * 8, w); }
        k = k + 1;
    }
    return 0;
}

# _mdhl_tbl_emit_row: emit one row padded to the column widths + aligned. Header cells (ri == 0) are ROLE_ACCENT;
# body cells are verbatim. Cells are plain text (no inline styling), matching the GUI grid.
fn _mdhl_tbl_emit_row(rptr, rlen, ncols, ri) {
    md_row_split(rptr, rlen);
    var n = md_cell_count();
    var k = 0;
    while (k < ncols) {
        var w = load64(_mdhl_tbl_colw + k * 8);
        var cs = 0;
        var cl = 0;
        var cw = 0;
        if (k < n) { cs = md_cell_start(k); cl = md_cell_len(k); cw = feed_visible_cols(rptr + cs, cl); }
        var lead = 0;
        var al = load64(_mdhl_tbl_align + k * 8);
        if (al == 2) { lead = w - cw; }
        elif (al == 1) { lead = (w - cw) / 2; }
        if (lead < 0) { lead = 0; }
        _mdhl_pad(lead);
        if (cl > 0) {
            if (ri == 0) { _mdhl_span(0, ROLE_ACCENT, rptr + cs, cl); } else { _mdhl_text(rptr + cs, cl); }
        }
        var trail = w - cw - lead;
        if (trail < 0) { trail = 0; }
        if (k < (ncols - 1)) { _mdhl_pad(trail); _mdhl_pad(MDHL_TBL_GAP); }   # no trailing pad on the last column
        k = k + 1;
    }
    emit("\n");
    return 0;
}

# _mdhl_tbl_emit_rule: a faint '-' rule spanning the grid, under the header.
fn _mdhl_tbl_emit_rule(ncols) {
    var total = 0;
    var k = 0;
    while (k < ncols) { total = total + load64(_mdhl_tbl_colw + k * 8); k = k + 1; }
    total = total + (ncols - 1) * MDHL_TBL_GAP;
    emit(ui_sgr(ROLE_FAINT));
    var i = 0;
    while (i < total) { emit("-"); i = i + 1; }
    emit(ui_reset());
    emit("\n");
    return 0;
}

# _mdhl_tbl_close: finalize the buffered table — two passes (column widths, then emit header + rule + body). An
# overflowed table already spilled + streamed verbatim (nothing left to do); a mis-shaped or over-WIDE grid spills
# verbatim. Never drops a byte.
fn _mdhl_tbl_close() {
    if (_mdhl_tbl_over == 1) { _mdhl_tbl_len = 0; return 0; }   # rows already emitted verbatim by the spill/stream
    if (_mdhl_tbl_len == 0) { return 0; }
    var ncols = _mdhl_tbl_ncols;
    if ((ncols < 1) || (ncols > MDHL_TBL_MAXCOL)) { _mdhl_tbl_spill(); return 0; }
    var k = 0;
    while (k < ncols) { store64(_mdhl_tbl_colw + k * 8, 0); k = k + 1; }
    var rs = 0;
    while (rs < _mdhl_tbl_len) {
        var re = rs;
        while ((re < _mdhl_tbl_len) && (load8(_mdhl_tbl + re) != 10)) { re = re + 1; }
        _mdhl_tbl_row_widths(_mdhl_tbl + rs, re - rs, ncols);
        rs = re + 1;
    }
    # A padded grid is the one mdhl path whose VISIBLE width can far exceed its source line (cells pad to the
    # widest row's cell), so a pathological table could out-grow a feed row and be truncated on write — losing cell
    # text that rendered fine before this cut. Wider than MDHL_TBL_MAXW is unusable on any terminal anyway: spill
    # verbatim, where the raw pipes soft-wrap instead.
    var gw = 0;
    var gk = 0;
    while (gk < ncols) { gw = gw + load64(_mdhl_tbl_colw + gk * 8); gk = gk + 1; }
    gw = gw + (ncols - 1) * MDHL_TBL_GAP;
    if (gw > MDHL_TBL_MAXW) { _mdhl_tbl_spill(); return 0; }
    var ak = 0;
    while (ak < ncols) { store64(_mdhl_tbl_align + ak * 8, md_cell_align(_mdhl_tbl_delim, _mdhl_tbl_delim_len, ak)); ak = ak + 1; }
    var ri = 0;
    rs = 0;
    while (rs < _mdhl_tbl_len) {
        var re = rs;
        while ((re < _mdhl_tbl_len) && (load8(_mdhl_tbl + re) != 10)) { re = re + 1; }
        _mdhl_tbl_emit_row(_mdhl_tbl + rs, re - rs, ncols, ri);
        if (ri == 0) { _mdhl_tbl_emit_rule(ncols); }
        ri = ri + 1;
        rs = re + 1;
    }
    return 0;
}

# _mdhl_line_done: classify + emit one assembled line, then clear the line buffer. A
# continuation piece (overflowed logical line) is never a fence marker. Otherwise: out of
# a fence, an opener starts a block (opener emitted verbatim, grammar resolved) else the
# line is prose; in a fence, a closer flushes the block (highlighted or verbatim) + emits
# the closer verbatim, else the line is interior (buffered).
fn _mdhl_line_done(has_nl) {
    if (_mdhl_line_cont == 1) {
        _mdhl_prev_len = 0;                          # 0.36.3: an unsealed continuation is not a table-header candidate
        if (_mdhl_in_fence == 1) { _mdhl_block_put(has_nl); }
        else { _mdhl_put_line(has_nl); }
        _mdhl_line_len = 0;
        return 0;
    }
    # 0.36.3: an open table absorbs table rows; anything else closes it (emitting the grid) and falls through below.
    if (_mdhl_in_tbl == 1) {
        if (_mdhl_tbl_is_row(_mdhl_line, _mdhl_line_len) == 1) { _mdhl_tbl_put(_mdhl_line, _mdhl_line_len); _mdhl_line_len = 0; return 0; }
        _mdhl_tbl_close();
        _mdhl_in_tbl = 0;
        _mdhl_tbl_len = 0;
    }
    if (_mdhl_in_fence == 0) {
        if (_mdhl_scan_fence_open() == 1) {
            _mdhl_prev_len = 0;                      # 0.36.3: a fence opener is not a table header
            _mdhl_resolve_grammar();
            _mdhl_put_line(has_nl);
            _mdhl_in_fence = 1;
            _mdhl_block_len = 0;
            _mdhl_block_over = 0;
            _mdhl_block_rows = 0;                    # 0.18.3: start counting live interior rows
        } else {
            # 0.36.3: a delimiter row under a matching pipe-bearing header opens a table (drops the live header row)
            if (_mdhl_tbl_try_open() == 1) { _mdhl_line_len = 0; return 0; }
            _mdhl_inline_line(has_nl);               # 0.18.8: prose line -> inline markdown styling (was _mdhl_put_line)
            if (has_nl == 1) { _mdhl_prev_save(_mdhl_line, _mdhl_line_len); }   # 0.36.3: candidate table header
            else { _mdhl_prev_len = 0; }
        }
    } else {
        _mdhl_prev_len = 0;                          # 0.36.3: fence lines/interior are never table headers
        if (_mdhl_scan_fence_close() == 1) {
            _mdhl_block_close();                     # 0.18.3: upgrade the live block in place (TUI) / flush
            _mdhl_put_line(has_nl);
            _mdhl_in_fence = 0;
            _mdhl_grammar = 0;
            _mdhl_block_len = 0;
            _mdhl_block_over = 0;
            _mdhl_block_rows = 0;
        } else {
            _mdhl_block_put(has_nl);
        }
    }
    _mdhl_line_len = 0;
    return 0;
}

# _mdhl_consume: assemble bytes into lines, draining each COMPLETE line (on '\n') through
# _mdhl_line_done. A line that overflows MDHL_LINE_CAP with no '\n' is force-flushed and
# its remainder marked a continuation (never re-classified as a fence). This dissolves
# every streaming chunk-boundary split — a fence decision is only made on a whole line.
fn _mdhl_consume(ptr, n) {
    var i = 0;
    while (i < n) {
        var b = load8(ptr + i);
        if (b == 10) {
            _mdhl_line_done(1);
            _mdhl_line_cont = 0;
        } else {
            if (_mdhl_line_len >= (MDHL_LINE_CAP - 1)) {
                _mdhl_line_done(0);
                _mdhl_line_cont = 1;
            }
            store8(_mdhl_line + _mdhl_line_len, b);
            _mdhl_line_len = _mdhl_line_len + 1;
        }
        i = i + 1;
    }
    return 0;
}

# _mdhl_clear: zero the state machine (not the buffers). Turn/iteration isolation.
fn _mdhl_clear() {
    _mdhl_line_len = 0;
    _mdhl_line_cont = 0;
    _mdhl_in_fence = 0;
    _mdhl_fence_ch = 0;
    _mdhl_fence_len = 0;
    _mdhl_grammar = 0;
    _mdhl_block_len = 0;
    _mdhl_block_over = 0;
    _mdhl_block_rows = 0;
    _mdhl_in_tbl = 0;             # 0.36.3: table state is turn/iteration-scoped too
    _mdhl_tbl_len = 0;
    _mdhl_tbl_over = 0;
    _mdhl_tbl_delim_len = 0;
    _mdhl_tbl_ncols = 0;
    _mdhl_prev_len = 0;
    return 0;
}

# mdhl_reset: clear state at the start of a streamed turn/iteration (before the SSE loop).
fn mdhl_reset() {
    _mdhl_ensure();
    _mdhl_clear();
    return 0;
}

# mdhl_feed: streaming entry — consume a chunk, acting on completed lines only. FLOOR:
# at PT_PLAIN this is exactly emit_n(ptr,n) (verbatim, once) so the piped output is
# byte-identical to today.
fn mdhl_feed(ptr, n) {
    if (ui_tier() == PT_PLAIN) { emit_n(ptr, n); return 0; }
    _mdhl_ensure();
    if (_mdhl_line == 0) { emit_n(ptr, n); return 0; }   # alloc failed -> degrade verbatim
    _mdhl_consume(ptr, n);
    return 0;
}

# mdhl_finish: streaming end — flush the residual partial line (a genuine final line:
# classify it, so an unterminated ```python still highlights), then close an open block
# with NO synthetic closing delimiter (there wasn't one). Clears state for the next turn.
# FLOOR: no-op at PT_PLAIN (nothing was ever buffered there).
fn mdhl_finish() {
    if (ui_tier() == PT_PLAIN) { return 0; }
    if (_mdhl_line == 0) { return 0; }
    if (_mdhl_line_len > 0) {
        _mdhl_line_cont = 0;
        _mdhl_line_done(0);
    }
    if (_mdhl_in_tbl == 1) {
        _mdhl_tbl_close();         # 0.36.3: emit a table still open at end-of-reply
        _mdhl_in_tbl = 0;
    }
    if (_mdhl_in_fence == 1) {
        _mdhl_block_close();       # 0.18.3: upgrade a live unterminated block in place (TUI) / flush
        _mdhl_in_fence = 0;
    }
    _mdhl_clear();
    return 0;
}

# mdhl_reply: blocking entry — reset/consume/finish over the WHOLE reply. FLOOR: at
# PT_PLAIN this is exactly emit_n(ptr,n) (verbatim, once), matching today's reply print;
# the caller keeps its own trailing-newline courtesy over the RAW bytes.
fn mdhl_reply(ptr, n) {
    if (ui_tier() == PT_PLAIN) { emit_n(ptr, n); return 0; }
    mdhl_reset();
    if (_mdhl_line == 0) { emit_n(ptr, n); return 0; }   # alloc failed -> degrade verbatim
    _mdhl_consume(ptr, n);
    mdhl_finish();
    return 0;
}
