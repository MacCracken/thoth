# thoth — the model-driven agentic tool-calling loop (0.6.0).
#
# This is the payoff of the M4 tool spine: a free-text turn becomes a LOOP. thoth
# advertises daimon's MCP tools to hoosh; the backing model decides which to call;
# thoth executes each through daimon — every call gated by t-ron — feeds the
# results back as {role:tool} messages, and repeats until the model answers with
# plain content. thoth owns none of the moving parts: hoosh decides, daimon
# executes, bote is the protocol, t-ron authorizes. thoth only drives the loop.
#
# Engages when the daimon seam is wired AND [hoosh].tools is on (the default);
# otherwise free-text turns fall back to the plain hoosh_send path. Agentic turns
# are NON-streaming — the full response must be parsed for tool_calls before the
# next step. Standard OpenAI tool-calling contract (hoosh normalizes every
# provider to it): request `tools`, response `choices[0].message.tool_calls`,
# each `{id, function:{name, arguments}}`; results returned as
# {role:tool, tool_call_id, content}.

# AGENT_MAX_ITERS was a hardcoded 8 through 0.39.0. It is now [hoosh].max_iters via
# config_hoosh_max_iters() (0.40.0, T1-2) — read at the loop, not cached, so /reload takes effect.
var _agent_req = 0;
var AGENT_REQ_CAP = 1048576;
var _agent_tools_buf = 0;
var AGENT_TOOLS_CAP = 32768;
var _agent_tools_len = 0;     # cached serialized-tools byte length (session-stable)
var _agent_tools_ready = 0;   # 1 once the registry was fetched + formatted at least once

# agent_tools_cache_reset: drop the cached tool advertisement so the next turn re-fetches + re-serializes it.
# Used by /reload (0.24.4) so a mid-session config change to [shell].enabled / [hoosh].tools (or a now-reachable
# daimon) re-advertises the right tools; otherwise the session-stable cache would keep the startup set.
fn agent_tools_cache_reset() {
    _agent_tools_ready = 0;
    _agent_tools_len = 0;
    return 0;
}

# The working buffer holds THIS turn's tool-round messages (assistant-with-
# tool_calls + tool results) as raw comma-joined JSON objects. The persisted
# conversation (session history) supplies the user turn and prior exchanges; the
# tool rounds are ephemeral — only the user turn and the final answer enter
# history. Bounded; see the working-set block below for what happens at the bound.
#
# 0.44.2 raised REQ 512 KB -> 1 MB and WORK 128 KB -> 384 KB. 128 KB of tool results is one medium
# review turn on a real project — the Node project this was measured against filled 66 KB of RAW result
# bytes in nine rounds before escaping, and escaping JS source (quotes and newlines both double) is where
# the rest of the headroom went. The history budget grows with it: hist_cap is REQ - WORK - TOOLS, and a
# tenth of that is the raw-content budget, so the framer now carries ~64 KB of prior conversation instead
# of ~35 KB. The heap is a 256 MB lazily-committed chunk, so this costs virtual address space, not RAM.
var _agent_work = 0;
var AGENT_WORK_CAP = 393216;
var _agent_work_len = 0;

# --- the working set is BOUNDED, and running out of it must not corrupt the conversation (0.44.2) -----
#
# ⚠ This buffer holds every assistant tool-call echo and every tool RESULT of the current turn, and it is
# what the next round's request body is built from. Every append here used to drop silently at the cap:
# `_agent_work_putc` refused the byte, and `_agent_work_puts_esc` bailed out MID-STRING at CAP-8 — so a
# turn that read more than 128 KB of files produced a working set ending in an unterminated JSON string,
# which went into the POST body as-is. Two failures, in this order:
#
#   1. BEFORE the cap is reached but after room gets tight, results are cut short — the model does not see
#      what it asked for, asks again, and the turn walks in circles re-reading the same files (observed:
#      nine rounds re-reading CLAUDE.md and src/bench.js on a 1300-file project).
#   2. AT the cap the body stops being valid JSON, the gateway answers nothing, and the turn dies with
#      "response had neither tool calls nor content" — pointing at the model, never at the buffer.
#
# The rule now: the working set NEVER emits a partial message. A tail reserve is kept so the bytes that
# CLOSE a message are always affordable; a result that no longer fits is replaced by a short, valid
# message that SAYS it was dropped (the model must be told, or it repeats the call); an assistant echo
# that does not fit is refused outright and the turn stops cleanly, because an assistant tool-call message
# and its results are a matched set and half of one is not a conversation.
var AGENT_WORK_TAIL = 4096;      # bytes held back so closing/minimal messages are always affordable
var _agent_work_full = 0;        # 1 once an append was refused or shortened this turn
fn agent_work_full() { return _agent_work_full; }
fn agent_work_len() { return _agent_work_len; }
# _agent_work_room: writable bytes left OUTSIDE the tail reserve.
fn _agent_work_room() { return (AGENT_WORK_CAP - 1 - AGENT_WORK_TAIL) - _agent_work_len; }

fn _agent_work_reset() { _agent_work_len = 0; _agent_work_full = 0; return 0; }
fn _agent_work_putc(c) {
    if (_agent_work_len < (AGENT_WORK_CAP - 1)) { store8(_agent_work + _agent_work_len, c); _agent_work_len = _agent_work_len + 1; }
    return 0;
}
fn _agent_work_puts(s) {
    var i = 0;
    while (load8(s + i) != 0) { _agent_work_putc(load8(s + i)); i = i + 1; }
    return 0;
}
# _agent_work_puts_esc: append s as a JSON string body (bounded, escaped). Stops at the tail reserve and
# marks the value as cut IN the value — so the model reads "…[truncated" rather than silently receiving a
# short file, and the caller's closing bytes still fit.
fn _agent_work_puts_esc(s) {
    var i = 0;
    while (load8(s + i) != 0) {
        if (_agent_work_room() <= 32) {
            _agent_work_full = 1;
            _agent_work_puts(" ...[truncated: this turn's tool working set is full]");
            return 0;
        }
        var c = load8(s + i);
        if (c == 34) { _agent_work_putc(92); _agent_work_putc(34); }
        elif (c == 92) { _agent_work_putc(92); _agent_work_putc(92); }
        elif (c == 10) { _agent_work_putc(92); _agent_work_putc(110); }
        elif (c == 13) { _agent_work_putc(92); _agent_work_putc(114); }
        elif (c == 9) { _agent_work_putc(92); _agent_work_putc(116); }
        elif (c < 32) {
            _agent_work_putc(92); _agent_work_putc(117); _agent_work_putc(48); _agent_work_putc(48);
            _agent_work_putc(_hoosh_hex_digit(c / 16));
            _agent_work_putc(_hoosh_hex_digit(c - (c / 16) * 16));
        } else { _agent_work_putc(c); }
        i = i + 1;
    }
    return 0;
}
# _agent_work_puts_id: append a tool_call id as a JSON string body. Separate from _agent_work_puts_esc for
# two reasons: it must still work INSIDE the tail reserve (a dropped-result message needs its id even when
# ordinary room is gone, or the pairing breaks), and the id is gateway-supplied — the non-streaming path
# takes it straight from the response JSON with no length of its own, so it is bounded here. Ids are ~40
# bytes in practice; anything past AGENT_ID_MAX is a malformed gateway, not a longer name.
var AGENT_ID_MAX = 128;
fn _agent_work_puts_id(id) {
    if (id == 0) { return 0; }
    var i = 0;
    while (i < AGENT_ID_MAX) {
        var c = load8(id + i);
        if (c == 0) { return 0; }
        if (_agent_work_len >= (AGENT_WORK_CAP - 8)) { return 0; }
        if (c == 34) { _agent_work_putc(92); _agent_work_putc(34); }
        elif (c == 92) { _agent_work_putc(92); _agent_work_putc(92); }
        elif (c < 32) { _agent_work_putc(63); }
        else { _agent_work_putc(c); }
        i = i + 1;
    }
    return 0;
}

fn _agent_work_sep() { if (_agent_work_len > 0) { _agent_work_putc(44); } return 0; }   # comma

# Append the assistant message that carries the model's tool_calls, verbatim
# (raw_tcs is the already-valid JSON array text from the response).
# Returns 1 when the echo was written, 0 when there was no room — a REFUSAL, not a truncation: the caller
# must end the turn rather than send an assistant message whose tool_calls array stops mid-array.
fn _agent_add_assistant(raw_tcs) {
    var need = strlen(raw_tcs) + 64;
    if (_agent_work_room() < need) { _agent_work_full = 1; return 0; }
    _agent_work_sep();
    _agent_work_puts("{\"role\":\"assistant\",\"content\":null,\"tool_calls\":");
    _agent_work_puts(raw_tcs);
    _agent_work_puts("}");
    return 1;
}
# _agent_verify_append: run the configured verification and fold its summary onto a write tool's result
# (0.41.0, T2-5). Returns the ORIGINAL result unchanged when verification is not configured.
#
# ⚠ ONE VERIFICATION PER WRITE, and one buffer, so the result must be copied out before the next write
# reuses it. The concatenation lands in _agent_verify_buf rather than mutating the tool's own result
# buffer, which the caller may still hold.
var AGENT_VERIFY_CAP = 24576;
var _agent_verify_buf = 0;
fn _agent_verify_append(res) {
    # 0.43.0 (T2-1, ADR-0018 D8): a child does NOT run the verification loop. Two reasons, both real:
    # every child write would trigger a full project build, N x M times per turn; and _verify_last_ok /
    # _verify_runs are single globals whose child values would overwrite what /state reports about the
    # parent's last verification. The parent still verifies its own writes.
    if (_sub_depth > 0) { return res; }
    if (verify_configured() == 0) { return res; }
    var v = verify_run();
    if (v == 0) { return res; }
    if (_agent_verify_buf == 0) { _agent_verify_buf = alloc(AGENT_VERIFY_CAP); }
    if (_agent_verify_buf == 0) { return res; }
    var cap = AGENT_VERIFY_CAP;
    var off = 0;
    if (res != 0) { off = _append_cstr_cap(_agent_verify_buf, off, cap, res); }
    off = _append_cstr_cap(_agent_verify_buf, off, cap, v);
    if (off > (cap - 1)) { off = cap - 1; }
    store8(_agent_verify_buf + off, 0);
    return _agent_verify_buf;
}

# Append a tool-result message for a given tool_call id.
# ⚠ EVERY tool_call id must get a result message — a provider rejects an assistant tool_use with no
# matching tool result, so "we ran out of room, skip this one" is not an option. When the room outside the
# tail reserve is gone the message is still emitted, with a short content that names the reason: valid
# JSON, correct pairing, and the model learns why it got nothing back instead of inferring the tool broke.
fn _agent_add_result(id, text) {
    if (_agent_work_room() < 256) {
        _agent_work_full = 1;
        _agent_work_sep();
        _agent_work_puts("{\"role\":\"tool\",\"tool_call_id\":\"");
        _agent_work_puts_id(id);
        _agent_work_puts("\",\"content\":\"(result dropped: this turn's tool working set is full)\"}");
        return 0;
    }
    _agent_work_sep();
    _agent_work_puts("{\"role\":\"tool\",\"tool_call_id\":\"");
    _agent_work_puts_id(id);
    _agent_work_puts("\",\"content\":\"");
    # 0.40.0 (T1-3): redact HERE, the chokepoint where a tool result becomes a transcript message —
    # upstream of the conversation store, /save and the next request to the gateway. No-op when
    # [redact] is off.
    #
    # ⚠ 0.44.3 — "UPSTREAM OF EVERY SINK AT ONCE" WAS NOT TRUE OF THE FEED, which this comment used to
    # claim. Both executors PRINT the result before calling this function, and under OUT_RING that print
    # goes into the feed ring — which `/save` exports and the TUI shows. So thoth announced "[redacted]"
    # and then wrote the unredacted secret into the transcript the operator exports, in the same turn.
    # Every display site now redacts first (`res = redact_tool_result(res)`), which makes the earliest
    # sink the redaction point; the call below is kept because the redactor is idempotent — a second
    # scan of already-clean text matches nothing and announces nothing — and because it keeps this
    # function safe for any future caller that does not print first.
    # 0.40.0 (T1-3) redaction and 0.41.0 (T2-3) injection-guarding, in that ORDER and both at this one
    # chokepoint. Redact first: a secret must not survive into the wrapped copy the guard would build,
    # and the guard's envelope text must not itself be scanned for secrets.
    if (text != 0) { _agent_work_puts_esc(guard_wrap_untrusted(redact_tool_result(text), "a tool result")); }
    _agent_work_puts("\"}");
    return 0;
}

# agent_format_tools: serialize a daimon tools array value into an OpenAI `tools`
# array (NUL-terminated) in dst; return the byte length, or 0 if no tools. daimon
# gives {name, description, inputSchema}; we wrap each as a function tool, passing
# the tool's `inputSchema` (a JSON Schema object) through verbatim as
# `function.parameters` so the model sees real argument shapes. daimon 1.2.7
# (issue 2026-06-11-mcp-manifest-omits-tool-input-schema) emits `inputSchema` per
# tool in GET /v1/mcp/tools; earlier daimon omitted it. A tool with no/empty schema
# (builtins) falls back to the permissive `{"type":"object"}`. Pure.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# WRONG-TREE CORRECTION (0.44.1) — when a HOST file tool misses a file this project actually has
# ─────────────────────────────────────────────────────────────────────────────────────────────────────
# A registry tool taking a `path` runs on the MCP HOST and resolves that path in the host's own tree,
# which is not thoth's project jail and need not be anywhere near it. daimon's registry cannot say so —
# bote registers fs_read as "Read a text file under the project root", and it means ITS root,
# $BOTE_FS_ROOT — so the model sees two read tools whose descriptions agree and whose behaviour does not.
# Live against the dev stack it chose fs_read for a project file and got back
# `cannot read /home/macro/.agnos-stack/workspace/src/tasks/health.js`, with the file sitting in the
# launch directory the whole time.
#
# ⚠ THE FIRST ATTEMPT AT THIS WAS PROSE AND IT DID NOT WORK. A note appended to every path-taking tool's
# advertised description was measured against the live stack (3 runs x 40 rounds, annotated vs not) and
# moved nothing: 12 stray fs_read calls with it, 2 without — noise, on a run-to-run variance far larger
# than the effect. It was removed rather than kept as decoration. What replaces it is not steering at all:
# a FACT, delivered at the moment the model is provably wrong. When a host tool reports an error and this
# project really does contain the relative path it asked for, the tool result says so and names the exact
# call that works. That is a file-existence test, not a hope, and it costs nothing when the call succeeds.

var AGENT_XTREE_CAP = 1024;
var _agent_xtree_buf = 0;        # scratch for the corrected result

# _agent_xtree_path: the `path` argument of a tool call, as a cstr, or 0. PURE apart from the parse.
fn _agent_xtree_path(args_json) {
    if (args_json == 0) { return 0; }
    var v = bayan_json_v_parse_buf(args_json, strlen(args_json));
    if (v == 0) { return 0; }
    var pv = bayan_json_v_obj_get(v, "path");
    if (pv == 0) { return 0; }
    var ps = bayan_json_v_str(pv);
    if (ps == 0) { return 0; }
    return str_cstr(ps);
}

# _agent_xtree_append: given a FAILED host tool result, return it with a correction appended when the
# path it asked for exists in THIS project; otherwise return `res` untouched.
#
# Deliberately narrow, so it can never fire on a call that was fine:
#   * only on a failure (the caller checks daimon_invoke_is_error first) — a host tool that succeeded is
#     doing its job and is none of thoth's business;
#   * only when the path passes the SAME jail the project tools use, so the suggestion is a call that
#     will actually be authorized rather than one refused a round later;
#   * only when the file is really there. "Did you mean read_file?" about a file this project does not
#     have would be a fabricated measurement, and worse than silence.
#
# The scratch buffer is written and consumed inside one dispatch arm, like _agent_verify_buf, so it is
# NOT part of subagent.cyr's swap set — no child round can run between the write and the read.
fn _agent_xtree_append(res, args_json) {
    var path = _agent_xtree_path(args_json);
    if (path == 0) { return res; }
    if (load8(path) == 0) { return res; }
    if (_project_jail_ok(path) == 0) { return res; }          # not a project-relative path -> nothing to suggest
    if (_project_no_symlink(path) == 0) { return res; }       # never point at something the jail would refuse
    if (_project_sensitive(path) == 1) { return res; }        # never point at thoth's own config/state
    var is_d = is_dir(str_from(path));
    if ((is_d == 0) && (file_exists(path) == 0)) { return res; }
    if (_agent_xtree_buf == 0) { _agent_xtree_buf = alloc(AGENT_XTREE_CAP); }
    if (_agent_xtree_buf == 0) { return res; }
    var cap = AGENT_XTREE_CAP;
    var off = 0;
    if (res != 0) { off = _append_cstr_cap(_agent_xtree_buf, off, cap, res); }
    off = _append_cstr_cap(_agent_xtree_buf, off, cap, "\n(NOTE from thoth: that tool ran on the MCP host and looked in the HOST's directory, not in this project. This project DOES have ");
    off = _append_cstr_cap(_agent_xtree_buf, off, cap, path);
    if (is_d == 1) { off = _append_cstr_cap(_agent_xtree_buf, off, cap, " - list it with list_dir {\"path\":\""); }
    else { off = _append_cstr_cap(_agent_xtree_buf, off, cap, " - read it with read_file {\"path\":\""); }
    off = _append_cstr_cap(_agent_xtree_buf, off, cap, path);
    off = _append_cstr_cap(_agent_xtree_buf, off, cap, "\"}. Use read_file / list_dir / search for this project's files.)");
    if (off > (cap - 1)) { off = cap - 1; }
    store8(_agent_xtree_buf + off, 0);
    return _agent_xtree_buf;
}

fn agent_format_tools(dst, tools_arr) {
    if (tools_arr == 0) { return 0; }
    var n = bayan_json_v_arr_len(tools_arr);
    if (n == 0) { return 0; }
    # dst is _agent_tools_buf (AGENT_TOOLS_CAP). name/description/inputSchema come
    # from the daimon (MCP) registry — semi-trusted, not length-bounded — so every
    # write is clamped to the cap. A per-tool headroom guard stops adding tools once
    # near the cap, so an over-large registry yields a SHORTER but VALID tools array
    # rather than a half-written element or a buffer overrun.
    var cap = AGENT_TOOLS_CAP;
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "[");
    var i = 0;
    var done = 0;
    var wrote = 0;                  # 0.42.0: tools WRITTEN, not tools SEEN — the pin can skip one, and
                                    # `i > 0` as the comma test would then emit a leading or doubled comma
                                    # and hand the gateway malformed JSON.
    # ⚠ 0.44.2 — THE HEADROOM GUARD BELOW DOES NOT BOUND THE ELEMENT IT ADMITS. `off > cap - 256` decides
    # whether a NEW tool may start; it says nothing about how big that tool is, and a description plus a
    # verbatim inputSchema pass-through is routinely far more than 256 bytes. Past the cap
    # `_append_cstr_cap` stops mid-token, so the array ended in a half-written element — and if `off`
    # landed on cap-1 the closing `]` was dropped as well. `,"tools":<malformed>` makes the whole POST body
    # invalid JSON, and because the registry FETCH succeeded `_agent_tools_ready` latches: every agentic
    # turn for the rest of the session sends the same broken advertisement. One large MCP registry bricked
    # the session, and the function's own comment claimed the opposite ("a SHORTER but VALID tools array").
    # Now each element is written speculatively and ROLLED BACK whole if it saturated the buffer.
    var skipped = 0;
    while ((i < n) && (done == 0)) {
        if (off > (cap - 256)) { done = 1; }
        else {
            var el_start = off;
            var t = bayan_json_v_arr_get(tools_arr, i);
            # 0.42.0 (T3): resolve the three fields BEFORE writing anything, so the trust-on-first-use pin
            # can withhold the whole tool rather than half-writing it. A definition that changed since this
            # session pinned it is not advertised at all — the model never learns the tool exists, so the
            # swapped description never enters its context. See src/toolpin.cyr.
            var nm = bayan_json_v_obj_get(t, "name");
            var ds = bayan_json_v_obj_get(t, "description");
            var pin_name = "";
            var pin_desc = "";
            var pin_schema = "";
            if (nm != 0) { var nmp = bayan_json_v_str(nm); if (nmp != 0) { pin_name = str_cstr(nmp); } }
            if (ds != 0) { var dsp = bayan_json_v_str(ds); if (dsp != 0) { pin_desc = str_cstr(dsp); } }
            var scp = bayan_json_v_obj_get(t, "inputSchema");
            if (scp != 0) { var scb = bayan_json_v_build(scp); if (scb != 0) { pin_schema = str_cstr(scb); } }
            if (toolpin_check(pin_name, pin_desc, pin_schema) == 0) { i = i + 1; }
            else {
            if (wrote > 0) { off = _append_cstr_cap(dst, off, cap, ","); }
            off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"");
            if (nm != 0) { var nms = bayan_json_v_str(nm); if (nms != 0) { off = _json_escape_into_cap(dst, off, cap, str_cstr(nms)); } }
            off = _append_cstr_cap(dst, off, cap, "\",\"description\":\"");
            if (ds != 0) { var dss = bayan_json_v_str(ds); if (dss != 0) { off = _json_escape_into_cap(dst, off, cap, str_cstr(dss)); } }
            # Pass daimon's per-tool inputSchema through verbatim as the OpenAI `parameters` (it is already a JSON
            # object); fall back to a permissive object schema when a tool advertises none — OR advertises one that
            # lacks a top-level `"type"` (e.g. the EMPTY `{}` that mneme_* register with). Anthropic REQUIRES every
            # tool's input_schema to be `{"type":"object",...}`; a bare `{}` is invalid and — because hoosh forwards
            # it and Anthropic rejects the whole request — silently EMPTIES the completion (no content, no tool
            # calls). So thoth must never emit a typeless schema, regardless of what daimon advertises. (Upstream:
            # mneme should register a real inputSchema; filed. thoth stays a tolerant client.)
            off = _append_cstr_cap(dst, off, cap, "\",\"parameters\":");
            var sc = bayan_json_v_obj_get(t, "inputSchema");
            var has_type = 0;
            if (sc != 0) { if (bayan_json_v_is_obj(sc) == 1) { if (bayan_json_v_obj_get(sc, "type") != 0) { has_type = 1; } } }
            if (has_type == 1) {
                var scs = bayan_json_v_build(sc);
                if (scs != 0) { off = _append_cstr_cap(dst, off, cap, str_cstr(scs)); }
                else { off = _append_cstr_cap(dst, off, cap, "{\"type\":\"object\"}"); }
            } else {
                off = _append_cstr_cap(dst, off, cap, "{\"type\":\"object\"}");   # absent / empty / typeless -> permissive valid schema
            }
            off = _append_cstr_cap(dst, off, cap, "}}");
            # Saturated? Then this element is truncated somewhere inside it. Roll the whole element back —
            # including the comma that preceded it — and stop. `cap - 2` leaves room for the closing "]"
            # plus the NUL, so the array below is always well-formed.
            if (off >= (cap - 2)) { off = el_start; done = 1; skipped = n - i; }
            else { wrote = wrote + 1; }
            i = i + 1;
            }
        }
    }
    # ⚠ 0.44.3 — THIS RECOMPUTE UNDER-COUNTED BY EXACTLY ONE. The rollback arm inside the loop already
    # sets `skipped = n - i` at the index of the element it REJECTED, and then `i = i + 1` runs
    # unconditionally, so recomputing here with the incremented `i` forgets the rolled-back element
    # itself. The operator was told "3 tools omitted" when four were. The in-loop value is the correct
    # one; this line now only fills in the case where nothing set it.
    if (done == 1) { if (skipped == 0) { if (i < n) { skipped = n - i; } } }
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    _agent_tools_skipped = skipped;
    return off;
}
# _agent_tools_skipped: registry tools left out of the advertisement for want of room. The caller announces
# it — a model that is not told a tool exists cannot ask why it is missing, so only the operator can.
var _agent_tools_skipped = 0;
fn agent_tools_skipped() { return _agent_tools_skipped; }

# _agent_tools_fits: 1 if a local tool needing `need` bytes still fits after `tl`, leaving room for the
# closing bracket. The add_* helpers below splice fixed literals onto the registry array; without this an
# over-large registry would half-write one of THEM instead, with the same session-bricking result.
fn _agent_tools_fits(tl, need) {
    if (tl == 0) { return 1; }
    if ((tl + need) < (AGENT_TOOLS_CAP - 2)) { return 1; }
    return 0;
}
var AGENT_TOOL_ELEM_RESERVE = 4096;   # generous: the largest literal below is ~2.5 KB

# agent_tools_add_memory: append the thoth-native memory_write tool to the daimon
# tools array in dst (0.12.2). tl == the current array length ("[...]" or 0 for an
# empty registry). Advertised only when the memory seam is not absent (i.e.
# [memory].enabled) — so the model can save durable facts to .thoth/memory during
# an agentic turn. Executed LOCALLY + t-ron-gated (thoth_remember) in
# _agent_run_calls_serial — never forwarded to daimon. ADR-0012.
fn agent_tools_add_memory(dst, tl) {
    if (seam_cap_state(SEAM_MEMORY) == CAP_ABSENT) { return tl; }
    # 0.44.2: refuse WHOLE rather than splice a half-written element onto a saturated array.
    if (_agent_tools_fits(tl, AGENT_TOOL_ELEM_RESERVE) == 0) { _agent_tools_skipped = _agent_tools_skipped + 1; return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"memory_write\",\"description\":\"Save a durable fact about THIS project to local memory (.thoth/memory) so it persists across sessions. Use for decisions, conventions, or context worth remembering; keep each fact to one line.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"the fact to remember, one line\"}},\"required\":[\"text\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_shell: append the thoth-native `shell` tool to the daimon tools array in dst
# (0.16.0, ADR-0014). Advertised ONLY when opt-in [shell].enabled AND the target can capture a shell
# (shell_supported() — POSIX only; AGNOS/Windows have no capturing /bin/sh, announced not faked). When
# off / unsupported this returns tl UNCHANGED — the whole byte-identical-floor proof for the advertise
# side (no round can then name "shell"). Executed LOCALLY + t-ron-gated (thoth_shell) in
# _agent_run_calls_serial — never forwarded to daimon. Same shape as agent_tools_add_memory.
fn agent_tools_add_shell(dst, tl) {
    if (config_shell_enabled() == 0) { return tl; }
    if (shell_supported() == 0) { return tl; }
    # 0.44.2: refuse WHOLE rather than splice a half-written element onto a saturated array.
    if (_agent_tools_fits(tl, AGENT_TOOL_ELEM_RESERVE) == 0) { _agent_tools_skipped = _agent_tools_skipped + 1; return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"shell\",\"description\":\"Run a shell command on the local machine (/bin/sh -c) and return its combined stdout+stderr and exit code. Use for build/test/git/file inspection in THIS project. One command per call; it runs with a wall-clock timeout and bounded output, cannot read stdin, and may be refused by policy.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"the shell command line to execute\"}},\"required\":[\"command\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_project: append the thoth-native read_file + list_dir tools to the array in dst (0.23.0,
# ADR-0015). Advertised whenever the agentic loop runs (the call site is reached only when agent_enabled) —
# DEFAULT-ON, so the agent can see the codebase it was launched in. Executed LOCALLY + jailed to the launch
# cwd, plus any user-granted read roots (0.23.1: /allow, [project].read_roots — no t-ron gate, the jail +
# the user's explicit grant are the boundary) in _agent_run_calls_serial. Same shape as agent_tools_add_shell;
# adds TWO tools.
fn agent_tools_add_project(dst, tl) {
    # 0.44.2: refuse WHOLE rather than splice a half-written element onto a saturated array.
    if (_agent_tools_fits(tl, AGENT_TOOL_ELEM_RESERVE) == 0) { _agent_tools_skipped = _agent_tools_skipped + 1; return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read a text file and return its contents. Give a path relative to THIS project's root, or an absolute path inside a directory the user has granted read access to. Reads outside those (and any '..') are refused. Use to inspect the code you are working in.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root, or an absolute path under a user-granted root\"}},\"required\":[\"path\"]}}}");
    off = _append_cstr_cap(dst, off, cap, ",");
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"description\":\"List a directory (files, and subdirectories suffixed with '/'). Give a path relative to THIS project's root (defaults to the root), or an absolute path inside a user-granted root. Use to explore the code structure.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root, or an absolute path under a user-granted root (optional; defaults to the root)\"}}}}}");
    off = _append_cstr_cap(dst, off, cap, ",");
    # 0.40.0 (T1-1): SEARCH. The description leads with when to reach for it, because the failure this
    # closes is a model that never thinks to look — it walked list_dir one level at a time instead.
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"search\",\"description\":\"Search THIS project. Use this FIRST to locate code - it is far cheaper than listing directories one at a time. Give 'pattern' to find a LITERAL substring inside files (returns 'path:line: text' for each match); give 'glob' to find files whose NAME matches a pattern like '*.cyr' or 'test_*'; give both to search only inside matching files. Matching is literal text, NOT a regular expression. Results are capped and say so when a limit is reached.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\",\"description\":\"literal text to find inside files (not a regex)\"},\"glob\":{\"type\":\"string\",\"description\":\"filename pattern, '*' and '?' only, e.g. '*.cyr'\"},\"path\":{\"type\":\"string\",\"description\":\"subdirectory to search under, relative to the project root (optional; defaults to the whole project)\"},\"ignore_case\":{\"type\":\"boolean\",\"description\":\"match 'pattern' case-insensitively (ASCII only)\"}}}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_delegate: append the model-invokable `delegate` tool (0.43.0, T2-1, ADR-0018) — OPT-IN,
# advertised only when [subagent].enabled. NEVER called by the CHILD's tool build (src/subagent.cyr), which
# is what caps depth at 1 by construction rather than by asking the model to behave.
fn agent_tools_add_delegate(dst, tl) {
    if (config_subagent_enabled() == 0) { return tl; }
    if (_sub_depth > 0) { return tl; }        # belt and braces: a child never advertises it either
    var off = tl;
    if (off > 0) { off = off - 1; }           # step back over the closing ']'
    if (off > 0) { store8(dst + off, 44); off = off + 1; }   # ',' between elements
    else { store8(dst + off, 91); off = off + 1; }           # '[' for an otherwise-empty array
    off = _append_cstr_cap(dst, off, AGENT_TOOLS_CAP,
        "{\"type\":\"function\",\"function\":{\"name\":\"delegate\",\"description\":\"Delegate a NARROW, self-contained LOOKUP to a scoped child agent that has the same tools but its OWN empty context, and get back only its short written answer. Use it to keep a noisy search out of this conversation: which file defines a symbol, which of several candidates matches, what a value is set to. Do NOT hand it the job you were just asked to do - if you were asked to review, explain, summarize or change something, do that work yourself with search and read_file, and delegate at most one lookup inside it. Your delegation budget for a turn is SMALL (3) and delegating the same task twice is refused, so spend it on a lookup you truly cannot do inline. The child CANNOT see this conversation, so state everything it needs in the task, and it cannot delegate further.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\",\"description\":\"the self-contained instruction for the child: one specific question, not a whole assignment\"}},\"required\":[\"task\"]}}}");
    off = _append_cstr_cap(dst, off, AGENT_TOOLS_CAP, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_ask: append the `ask_user` tool (0.44.0, T4-1) — OPT-IN, advertised only when
# [ask].enabled, in lockstep with the dispatch guard so a hallucinated name never reaches daimon.
#
# ⚠ The description is doing real work here. This is the one tool whose cost is the OPERATOR'S ATTENTION,
# and a model with a question tool will over-use it unless told plainly when not to. So it says what a
# good question looks like (a decision only the human can make) and what a bad one looks like (anything
# it could answer by reading a file), and it warns that the budget is small.
fn agent_tools_add_ask(dst, tl) {
    if (config_ask_enabled() == 0) { return tl; }
    # 0.44.2: refuse WHOLE rather than splice a half-written element onto a saturated array.
    if (_agent_tools_fits(tl, AGENT_TOOL_ELEM_RESERVE) == 0) { _agent_tools_skipped = _agent_tools_skipped + 1; return tl; }
    # 0.44.2: refuse WHOLE rather than splice a half-written element onto a saturated array.
    if (_agent_tools_fits(tl, AGENT_TOOL_ELEM_RESERVE) == 0) { _agent_tools_skipped = _agent_tools_skipped + 1; return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"ask_user\",\"description\":\"Ask the human operator a question and WAIT for their answer. Use this ONLY for a decision you genuinely cannot make alone: an ambiguous requirement, a choice between approaches with real trade-offs, a missing fact that is not in the project, or confirmation before something hard to undo. Do NOT use it for anything you could answer by reading a file, running a search, or making a reasonable assumption and stating it - that wastes the person's attention. Ask ONE specific question at a time, and supply 'options' when there is a small set of sensible answers (the operator can always type something else instead). Your question budget for a turn is small, so spend it well.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\",\"description\":\"the question, phrased so a short answer settles it\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"optional suggested answers (at most 6); the operator may pick one or type their own\"}},\"required\":[\"question\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_edit: append the model-invokable `edit` tool (0.31.0, ADR-0017) — OPT-IN, advertised only when
# [edit].enabled, so an unconfigured session never even offers it (advertise-gate ⇔ dispatch-gate lockstep).
# Surgical semantics: it replaces the UNIQUE occurrence of old_string; a non-unique/absent match is refused.
fn agent_tools_add_edit(dst, tl) {
    if (config_edit_enabled() == 0) { return tl; }         # off by default; keep in lockstep with the dispatch guard
    # 0.44.2: refuse WHOLE rather than splice a half-written element onto a saturated array.
    if (_agent_tools_fits(tl, AGENT_TOOL_ELEM_RESERVE) == 0) { _agent_tools_skipped = _agent_tools_skipped + 1; return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"edit\",\"description\":\"Edit an EXISTING text file in THIS project by replacing an exact snippet. Give 'path' relative to the project root (absolute paths, '~' and '..' are refused; writes stay inside the project). 'old_string' must appear EXACTLY ONCE in the file - include enough surrounding lines to make it unique, or the edit is refused. 'new_string' replaces it (use an empty string to delete). Preserve exact indentation/whitespace. This applies the change to disk.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root\"},\"old_string\":{\"type\":\"string\",\"description\":\"the exact text to replace; must be unique in the file\"},\"new_string\":{\"type\":\"string\",\"description\":\"the replacement text (empty to delete the old text)\"}},\"required\":[\"path\",\"old_string\",\"new_string\"]}}}");
    off = _append_cstr_cap(dst, off, cap, ",");
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"create_file\",\"description\":\"Create a NEW text file in THIS project with the given content. Give 'path' relative to the project root (absolute paths, '~' and '..' are refused). REFUSES if the file already exists - use edit to modify an existing file. Writes the content verbatim to disk.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root; must not already exist\"},\"content\":{\"type\":\"string\",\"description\":\"the full text content of the new file\"}},\"required\":[\"path\",\"content\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# _agent_copy: raw-copy n bytes of src into dst at off, bounded by cap. Pure.
fn _agent_copy(dst, off, src, n, cap) {
    var i = 0;
    while ((i < n) && (off < (cap - 1))) { store8(dst + off, load8(src + i)); off = off + 1; i = i + 1; }
    return off;
}

# agent_build_request: assemble the chat request — system + budgeted history +
# this turn's working tool-rounds, plus the advertised tools. NUL-terminated;
# returns the byte length. Non-streaming (tool_calls must be parsed whole).
fn agent_build_request(dst, model, system, mem, tools_buf, tools_len, stream) {
    var cap = AGENT_REQ_CAP;
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "{\"model\":\"");
    off = _json_escape_into_cap(dst, off, cap, model);
    off = _append_cstr_cap(dst, off, cap, "\",\"messages\":[");
    var wrote = 0;
    if ((system != 0) && (load8(system) != 0)) { off = _hoosh_emit_msg_cap(dst, off, cap, "system", system); wrote = 1; }
    # project memory (0.12.0): second system message after the persona, before
    # history + tool-rounds. Off/absent -> mem is 0 -> omitted. ADR-0012.
    if ((mem != 0) && (load8(mem) != 0)) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, "system", mem);
        wrote = 1;
    }
    var total = session_history_len();
    # Budget history against the room left AFTER this turn's working tool-rounds
    # (_agent_work) and the advertised tools, so history + work + tools cannot
    # collectively approach the cap. _hoosh_history_start takes a tenth of its arg
    # as the raw-content budget (leaving headroom for ~6x JSON escaping).
    var hist_cap = AGENT_REQ_CAP - AGENT_WORK_CAP - AGENT_TOOLS_CAP;
    var start = _hoosh_history_start(hist_cap);
    # 0.36.4: the overflow recap for the messages below `start` this budget can no longer fit (see hoosh.cyr).
    off = _hoosh_emit_recap(dst, off, cap, start, wrote);
    if (_hoosh_has_recap(start) == 1) { wrote = 1; }
    var i = start;
    while (i < total) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, session_history_role(i), session_history_content(i));
        wrote = 1;
        i = i + 1;
    }
    if (_agent_work_len > 0) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _agent_copy(dst, off, _agent_work, _agent_work_len, AGENT_REQ_CAP);
        wrote = 1;
    }
    off = _append_cstr_cap(dst, off, cap, "]");
    if (tools_len > 0) {
        off = _append_cstr_cap(dst, off, cap, ",\"tools\":");
        off = _agent_copy(dst, off, tools_buf, tools_len, AGENT_REQ_CAP);
    }
    off = _append_cstr_cap(dst, off, cap, ",\"max_tokens\":");
    off = _append_int_cap(dst, off, cap, _hoosh_max_tokens());   # 0.38.2: the reasoning ceiling when effort is on
    off = _append_reasoning_effort(dst, off, cap);   # 0.35.2: reasoning_effort when [hoosh].reasoning set
    if (stream == 1) { off = _append_cstr_cap(dst, off, cap, ",\"stream\":true,\"stream_options\":{\"include_usage\":true}}"); }
    else { off = _append_cstr_cap(dst, off, cap, ",\"stream\":false}"); }
    if (off > (cap - 1)) { off = cap - 1; }   # 0.39.0 (A-6): the returned length is a POST body
    store8(dst + off, 0);                    # length — it must never name a byte outside the alloc
    return off;
}

# agent_tool_calls: the choices[0].message.tool_calls array value, or 0. Pure.
fn agent_tool_calls(body, len) {
    var v = bayan_json_v_parse_buf(body, len);
    if (v == 0) { return 0; }
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 0; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { return 0; }
    var msg = bayan_json_v_obj_get(first, "message");
    if (msg == 0) { return 0; }
    return bayan_json_v_obj_get(msg, "tool_calls");
}
fn agent_tc_count(tcs) { if (tcs == 0) { return 0; } return bayan_json_v_arr_len(tcs); }
fn _agent_tc_str(tcs, i, key) {
    var e = bayan_json_v_arr_get(tcs, i);
    if (e == 0) { return 0; }
    var v = bayan_json_v_obj_get(e, key);
    if (v == 0) { return 0; }
    var s = bayan_json_v_str(v);
    if (s == 0) { return 0; }
    return str_cstr(s);
}
fn agent_tc_id(tcs, i) { return _agent_tc_str(tcs, i, "id"); }
fn _agent_tc_fn_str(tcs, i, key) {
    var e = bayan_json_v_arr_get(tcs, i);
    if (e == 0) { return 0; }
    var f = bayan_json_v_obj_get(e, "function");
    if (f == 0) { return 0; }
    var v = bayan_json_v_obj_get(f, key);
    if (v == 0) { return 0; }
    var s = bayan_json_v_str(v);
    if (s == 0) { return 0; }
    return str_cstr(s);
}
# agent_tc_name: the call's tool name, or 0 when there ISN'T one.
#
# ⚠ 0.44.2 — AN EMPTY STRING IS NOT A NAME. `_ag_build_array` used to write `"name":""` for a slot
# whose opening delta never arrived, and every consumer here tested `nm != 0` — so `""` sailed past
# the no-name arm, was printed as a blank tool name, and was handed to t-ron, which answered
# `DENY: tool_name contains invalid characters` for a tool that never existed. Collapsing "" to 0
# HERE (rather than at each of the four call sites) means the no-name arm, the local-tool probe and
# the roundlog all agree on one reading of "unnamed".
fn agent_tc_name(tcs, i) {
    var n = _agent_tc_fn_str(tcs, i, "name");
    if (n == 0) { return 0; }
    if (load8(n) == 0) { return 0; }
    return n;
}

# agent_tc_args: the call's `arguments` as a NUL-terminated JSON cstr, or 0.
#
# 0.38.5 — TOLERANT CLIENT. OpenAI specifies `function.arguments` as a JSON-encoded *string*
# (`"{\"path\":\"VERSION\"}"`), and that is what the cloud providers send. Ollama's native
# /api/chat instead returns a JSON *object* (`{"path":"VERSION"}`), and hoosh (≤ 2.6.0) forwards
# the Ollama shape verbatim — it converts tool-call shape for Anthropic and Google only. Against
# the plain `bayan_json_v_str` reading, a non-string tag returned 0 and EVERY argument was
# silently dropped: the dispatch below substitutes "{}", so `list_dir` (whose path is optional)
# appeared to work while `read_file`/`edit`/`shell` lost their required args and failed on every
# round until the loop hit AGENT_MAX_ITERS and answered nothing. Measured against
# qwen3.5:9b/nemotron/llama3.1 on a local Ollama box.
#
# So: take the string when it is one, and re-serialize any other JSON value back to compact text.
# thoth stays a tolerant client of whatever the gateway forwards — the same stance
# agent_format_tools takes on typeless tool schemas above.
fn agent_tc_args(tcs, i) {
    var e = bayan_json_v_arr_get(tcs, i);
    if (e == 0) { return 0; }
    var f = bayan_json_v_obj_get(e, "function");
    if (f == 0) { return 0; }
    var v = bayan_json_v_obj_get(f, "arguments");
    if (v == 0) { return 0; }
    var s = bayan_json_v_str(v);
    if (s != 0) { return str_cstr(s); }          # OpenAI / Anthropic / Gemini: already a JSON string
    var b = bayan_json_v_build(v);               # Ollama native: object (or any non-string) -> compact JSON
    if (b == 0) { return 0; }
    return str_cstr(b);
}

# _agent_match: 1 if the NUL-terminated literal `lit` matches bytes at p. Pure.
fn _agent_match(p, lit) {
    var k = 0;
    while (load8(lit + k) != 0) {
        if (load8(p + k) != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# _agent_raw_tool_calls: extract the raw "tool_calls":[...] array text as a
# NUL-terminated cstr (for echoing the assistant message back verbatim), or 0.
# Balanced-bracket scan that skips over JSON strings. Pure.
fn _agent_raw_tool_calls(body, len) {
    var i = 0;
    var result = 0;
    while (((i + 13) < len) && (result == 0)) {
        if (_agent_match(body + i, "\"tool_calls\":") == 1) {
            var j = i + 13;
            while ((j < len) && (load8(body + j) == 32)) { j = j + 1; }
            if ((j < len) && (load8(body + j) == 91)) {
                var depth = 1;
                var start = j;
                j = j + 1;
                while ((j < len) && (depth > 0)) {
                    var ch = load8(body + j);
                    if (ch == 34) {
                        j = j + 1;
                        var instr = 1;
                        while ((j < len) && (instr == 1)) {
                            var sc = load8(body + j);
                            if (sc == 92) { j = j + 2; }
                            elif (sc == 34) { instr = 0; j = j + 1; }
                            else { j = j + 1; }
                        }
                    } else {
                        if (ch == 91) { depth = depth + 1; }
                        if (ch == 93) { depth = depth - 1; }
                        j = j + 1;
                    }
                }
                var slen = j - start;
                if (slen > 2) {
                    var out = alloc(slen + 1);
                    memcpy(out, body + start, slen);
                    store8(out + slen, 0);
                    result = out;
                }
            }
        }
        i = i + 1;
    }
    return result;
}

# --- streamed tool_call assembly (0.6.1) ---
#
# In streaming mode the model's tool_calls arrive as SSE delta fragments: the
# first frame for an index carries {index, id, function.name}, then `arguments`
# streams in pieces across later frames, concatenated by index. We accumulate
# into fixed per-index slots, then reconstruct the same tool_calls array text the
# non-streaming path gets — so execution + the assistant echo reuse one code path.
# ⚠ 0.44.2 — THIS WAS 8, AND THE OVERFLOW WAS SILENT. _agent_accum_delta discards any delta whose index
# is >= this with a bare return, so a streamed round of twelve calls executed eight and the assistant echo,
# the roundlog and the model's own view all agreed on a round it never made. The BLOCKING path has no such
# cap (agent_tc_count returns the real length and the executor batches it), so the same model on the same
# round did different work depending on [hoosh].stream. A model asked to read a directory of files emits
# ten-plus calls in one round routinely. 32 slots at AG_ARGS_CAP is 512 KB of lazily-committed heap, and
# the drops that remain are now counted and announced rather than swallowed.
# ⚠ `RL_MAX_CALLS` (src/roundlog.cyr) MUST track this. 0.44.2 raised this 8 -> 32 and left that at 8,
# so /audit under-reported every round of nine or more calls for a release. Change both.
var AGENT_MAX_CALLS = 32;
var AG_ID_CAP = 96;
var AG_NAME_CAP = 96;
var AG_ARGS_CAP = 16384;
var _ag_ids = 0;
var _ag_names = 0;
var _ag_args = 0;
var _ag_args_len = 0;        # AGENT_MAX_CALLS i64 slots
var _ag_seen = 0;            # AGENT_MAX_CALLS byte flags
var _ag_argsover = 0;        # AGENT_MAX_CALLS byte flags — this slot's arguments were clipped (0.44.2)
var _ag_max = 0;            # highest index+1 observed this round
var _agent_arr_buf = 0;     # reconstructed tool_calls array text
var AGENT_ARR_CAP = 131072;

fn _ag_alloc() {
    if (_ag_ids == 0) {
        _ag_ids = alloc(AGENT_MAX_CALLS * AG_ID_CAP);
        _ag_names = alloc(AGENT_MAX_CALLS * AG_NAME_CAP);
        _ag_args = alloc(AGENT_MAX_CALLS * AG_ARGS_CAP);
        _ag_args_len = alloc(AGENT_MAX_CALLS * 8);
        _ag_seen = alloc(AGENT_MAX_CALLS);
        _ag_argsover = alloc(AGENT_MAX_CALLS);
        _agent_arr_buf = alloc(AGENT_ARR_CAP);
    }
    return 0;
}
fn _ag_reset() {
    _ag_alloc();
    _ag_max = 0;
    _ag_frames = 0;
    _ag_over_cap = 0;
    _ag_oversize = 0;
    var i = 0;
    while (i < AGENT_MAX_CALLS) {
        store8(_ag_seen + i, 0);
        store8(_ag_argsover + i, 0);
        store64(_ag_args_len + (i * 8), 0);
        store8(_ag_ids + (i * AG_ID_CAP), 0);
        store8(_ag_names + (i * AG_NAME_CAP), 0);
        store8(_ag_args + (i * AG_ARGS_CAP), 0);
        i = i + 1;
    }
    return 0;
}
# _ag_copy_str: copy a Str into a bounded NUL-terminated cstr buffer.
fn _ag_copy_str(dst, cap, s) {
    var n = str_len(s);
    if (n > (cap - 1)) { n = cap - 1; }
    if (n > 0) { memcpy(dst, str_data(s), n); }
    store8(dst + n, 0);
    return 0;
}
# _ag_append_args: append a Str fragment to slot idx's arguments buffer.
# ⚠ 0.44.2 — OVERFLOW IS NOW RECORDED. This clipped at the cap and said nothing, which meant the slot
# ended the round holding a JSON fragment: `{"path":"a/very/long/…` with no closing brace. That was then
# emitted as a real call, the tool arm answered `arguments are not valid JSON`, and the model — told
# nothing about a size limit — reissued the same oversized call every round until the iteration cap. The
# AGENT_ARGS_MAX refusal that exists for exactly this case was unreachable, because the clip happened
# first and made the value SMALLER than the threshold. A clipped slot is now dropped and named.
fn _ag_append_args(idx, s) {
    var base = _ag_args + (idx * AG_ARGS_CAP);
    var cur = load64(_ag_args_len + (idx * 8));
    var n = str_len(s);
    var room = AG_ARGS_CAP - 1 - cur;
    if (n > room) { n = room; store8(_ag_argsover + idx, 1); _ag_oversize = 1; }
    if (n > 0) {
        memcpy(base + cur, str_data(s), n);
        cur = cur + n;
        store64(_ag_args_len + (idx * 8), cur);
        store8(base + cur, 0);
    }
    return 0;
}
# _agent_accum_delta: fold one streamed tool_call delta element into the slots.
# _agent_accum_delta: fold ONE element of a streamed `delta.tool_calls` array into its slot.
#
# ⚠ 0.43.4 — AN ABSENT `index` MEANS A COMPLETE CALL, NOT INDEX 0. The OpenAI streaming convention
# always stamps `index` and dribbles `arguments` across frames, so this defaulted a missing index to 0
# and APPENDED the arguments there. hoosh's local (Ollama-backed) path does not follow that convention:
# it emits every tool call WHOLE, several per delta, with NO `index` field at all. Under the old default
# all of them landed in slot 0 — id and name overwritten by the last, and the arguments CONCATENATED:
#
#     {"path":"README.md"}{"path":"CLAUDE.md"}{"path":"plan.md"}{"path":"package.json"}
#
# which is not valid JSON, so the round executed one bogus call, fed the model
# `(read_file: arguments are not valid JSON)`, and the model answered the next round with nothing at
# all — surfacing as "hoosh: response had neither tool calls nor content" after the tools had visibly
# run. Captured off the wire, not inferred. An element with no `index` therefore takes the NEXT FREE
# SLOT; the indexed fragment path is untouched. (Correlating fragments without an index is impossible
# anyway, so "whole call" is the only sound reading of an index-less element.)
fn _agent_accum_delta(e) {
    var idx = 0;
    var idxv = bayan_json_v_obj_get(e, "index");
    if (idxv != 0) { idx = bayan_json_v_int(idxv); }
    else { idx = _ag_max; }
    if (idx < 0) { return 0; }
    if (idx >= AGENT_MAX_CALLS) { _ag_over_cap = 1; return 0; }   # 0.44.2: counted + announced, never silent
    if ((idx + 1) > _ag_max) { _ag_max = idx + 1; }
    store8(_ag_seen + idx, 1);
    var idv = bayan_json_v_obj_get(e, "id");
    if (idv != 0) { var s = bayan_json_v_str(idv); if (s != 0) { _ag_copy_str(_ag_ids + (idx * AG_ID_CAP), AG_ID_CAP, s); } }
    var fnv = bayan_json_v_obj_get(e, "function");
    if (fnv != 0) {
        var nmv = bayan_json_v_obj_get(fnv, "name");
        if (nmv != 0) { var ns = bayan_json_v_str(nmv); if (ns != 0) { _ag_copy_str(_ag_names + (idx * AG_NAME_CAP), AG_NAME_CAP, ns); } }
        var arv = bayan_json_v_obj_get(fnv, "arguments");
        if (arv != 0) { var as = bayan_json_v_str(arv); if (as != 0) { _ag_append_args(idx, as); } }
    }
    return 0;
}
# _ag_synth_id: give slot `i` a locally-minted call id (`thoth_call_<i>`) when the gateway never sent
# one. SAFE because thoth owns BOTH sides of the pairing: the id it echoes in the assistant message is
# the same id it stamps on that call's `{role:tool}` result, so the provider only has to see them match.
# A call whose NAME is missing cannot be rescued this way — there is nothing to invoke — but a call
# missing only its id is complete work that would otherwise be thrown away.
fn _ag_synth_id(i) {
    var b = _ag_ids + (i * AG_ID_CAP);
    var o = _append_cstr_cap(b, 0, AG_ID_CAP, "thoth_call_");
    o = _append_int(b, o, i);
    store8(b + o, 0);
    return 0;
}

# _ag_dropped: how many slots _ag_build_array refused to emit this round (name never arrived).
# Read by the caller so the operator is TOLD rather than left with a round that quietly shrank.
var _ag_dropped = 0;
fn ag_dropped() { return _ag_dropped; }
# _ag_frames: SSE data events this round, [DONE] excluded. ZERO useful frames on an HTTP 200 stream is a
# GATEWAY fault, not a model that chose to say nothing — see _agent_empty_stream below.
var _ag_frames = 0;
fn ag_frames() { return _ag_frames; }
# _ag_over_cap: 1 if this round tried to use more slots than AGENT_MAX_CALLS. Distinct from _ag_dropped —
# that is a gateway defect, this is thoth's own ceiling, and the operator's remedy differs.
var _ag_over_cap = 0;
fn ag_over_cap() { return _ag_over_cap; }
# _ag_oversize: slots whose accumulated `arguments` hit AG_ARGS_CAP. Their JSON is CUT, so what is left is
# not parseable and running it would invoke a tool with a fabricated argument set — they are dropped too.
var _ag_oversize = 0;
fn ag_oversize() { return _ag_oversize; }

# _ag_build_array: reconstruct the tool_calls array text from the slots into dst
# (NUL-terminated); return the length. `arguments` is emitted as an escaped JSON
# string (the accumulated value is raw JSON). Mirrors the non-streaming raw shape.
# dst is _agent_arr_buf (AGENT_ARR_CAP). The id/name/arguments come from the
# model's streamed deltas (up to AGENT_MAX_CALLS slots, each arguments up to
# AG_ARGS_CAP-1 raw bytes that escape up to ~6x) — bounding every write to the cap
# stops an adversarial round of 8 max-size calls from overflowing the buffer; the
# reconstructed array truncates in-buffer (and bayan rejects a clipped element)
# instead of corrupting the bump heap.
#
# ⚠ 0.44.2 — A HEADERLESS SLOT IS NEVER EMITTED. A streamed tool call arrives as an opening delta
# carrying {index, id, function.name} followed by `arguments` fragments. If the gateway drops that
# opening delta but forwards the fragments (measured off the wire against hoosh 2.6.4's Anthropic
# translation, which silently `return 0`s when it cannot pull id+name out of a `content_block_start`),
# the slot ends the round with arguments and NOTHING else. This used to emit it verbatim:
#
#     {"id":"","type":"function","function":{"name":"","arguments":"{\"path\": \"src/tasks\"}"}}
#
# t-ron denied the nameless call (correctly), the round carried on — and then that assistant message
# went into the conversation history, where the provider rejects a tool_use block with an empty id and
# name. From that point EVERY later round came back with no content and no tool calls: the turn looked
# like it "got stuck" long after the tool that broke it had scrolled away, and a fresh session was the
# only cure. One dropped SSE frame bricked the whole conversation.
#
# So: a slot with no name is DROPPED here (the model simply does not see that call's result and
# re-issues it next round), and a slot with a name but no id gets a locally-minted one. The count of
# drops is kept for the caller to announce — silently returning fewer calls than the model asked for
# is the failure mode this whole comment exists to prevent.
fn _ag_build_array(dst) {
    var cap = AGENT_ARR_CAP;
    var off = 0;
    _ag_dropped = 0;
    off = _append_cstr_cap(dst, off, cap, "[");
    var wrote = 0;
    var i = 0;
    while (i < _ag_max) {
        if (load8(_ag_seen + i) == 1) {
            if (load8(_ag_names + (i * AG_NAME_CAP)) == 0) { _ag_dropped = _ag_dropped + 1; }
            elif (load8(_ag_argsover + i) == 1) { }        # 0.44.2: clipped arguments -> not valid JSON -> never emitted
            else {
                if (load8(_ag_ids + (i * AG_ID_CAP)) == 0) { _ag_synth_id(i); }
                if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
                off = _append_cstr_cap(dst, off, cap, "{\"id\":\"");
                off = _json_escape_into_cap(dst, off, cap, _ag_ids + (i * AG_ID_CAP));
                off = _append_cstr_cap(dst, off, cap, "\",\"type\":\"function\",\"function\":{\"name\":\"");
                off = _json_escape_into_cap(dst, off, cap, _ag_names + (i * AG_NAME_CAP));
                off = _append_cstr_cap(dst, off, cap, "\",\"arguments\":\"");
                off = _json_escape_into_cap(dst, off, cap, _ag_args + (i * AG_ARGS_CAP));
                off = _append_cstr_cap(dst, off, cap, "\"}}");
                wrote = 1;
            }
        }
        i = i + 1;
    }
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_enabled: 1 if a free-text turn should use the agentic loop. [hoosh].tools is the master switch
# (it advertises the tools array to hoosh); the TOOL SOURCE is daimon OR the thoth-native shell tool. 0.20.0
# relaxes the old daimon-only gate: `[shell].enabled` (POSIX-capable) enters the loop WITHOUT daimon, so the
# shell tool is usable standalone (memory-only standalone stays off by design — this cut targets the shell).
# Else the caller uses the plain hoosh_send path.
fn agent_enabled() {
    if (config_hoosh_tools() == 0) { return 0; }                          # master agentic switch
    return 1;   # 0.23.0: read_file/list_dir are ALWAYS-available local tools (default-on, jailed), so the
                # agentic loop always has a tool source — the agent can see the project even with no daimon
                # and no shell. daimon (its MCP registry) and shell just ADD more tools when present.
}

# --- parallel tool execution (0.7.0) ---
#
# A round's tool calls fan out across OS threads (lib/thread.cyr). This was held
# at the stdlib floor until cyrius 6.2.40 made the transport reentrant: sandhi
# 1.6.13 lifts its per-dispatch state into an arena-threaded request context, and
# bayan 1.0.3 makes the JSON value parser key off a per-call state struct (nodes
# still parse through the thread-safe global bump). thoth's piece is the PHASING
# that keeps the security path serial while only the network invoke is concurrent:
#
#   Phase 1 (serial, main thread): snapshot each call's {id,name,args} into stable
#     per-slot buffers, print the tool-call line, and run the t-ron gate. Gating
#     MUST stay serial — it may interactively confirm, and t-ron's libro audit
#     chain is an ordered, hash-linked record; concurrent appends would scramble it.
#   Phase 2 (concurrent): each ALLOWED call gets a worker running daimon_fetch_into
#     on its OWN arena + request buffer + raw-body buffer, over a fresh (un-pooled)
#     connection — the exact "distinct arenas + fresh connections" shape sandhi
#     1.6.13 certifies safe (its connection POOL stays single-threaded, so we never
#     share one). The worker does ONLY the network; it does NOT parse. Denied/noname
#     calls need no worker.
#   Phase 3 (serial, main thread, in call order): PARSE each raw body with bayan
#     (daimon_extract_text), print results, record the roundlog verdict, and append
#     each {role:tool} result to _agent_work — one unlocked buffer touched only here,
#     so order is deterministic and the tool_call_ids line up regardless of which
#     worker finished first.
#
# Why parse serially? bayan's JSON value parser is NOT thread-safe — beyond the
# 1.0.3 cursor fix its parse path still shares process state, and concurrent parses
# corrupt (measured ~98% wrong/empty across 8 threads; filed upstream). Keeping ALL
# bayan use on the main thread sidesteps that entirely; only sandhi — which IS
# reentrant in 1.6.13 — runs concurrently. Workers otherwise touch no shared mutable
# state: the endpoint URL is pre-warmed on the main thread, each slot owns its
# arena/req/out, and arena allocs are disjoint. If thread_create is unavailable
# (Win/AGNOS) or fails, the worker runs inline — correct, just serial. A round is
# processed in batches of PAR_MAX slots.
var PAR_MAX = 8;              # max concurrent workers per batch (matches AGENT_MAX_CALLS)
var PAR_NAME_CAP = 256;
var PAR_ARGS_CAP = 16384;
# Max tool-call `arguments` bytes accepted, shared by BOTH execution paths (=
# PAR_ARGS_CAP-1, the parallel slot's usable size). A call whose arguments exceed
# this is REFUSED with a result the model can react to — the serial and parallel
# paths never POST a truncated/malformed body, and the parallel path never gates a
# clipped payload (t-ron scans the same bytes daimon would receive). Unifies the
# previously divergent serial-unbounded / parallel-silently-truncated behavior.
var AGENT_ARGS_MAX = 16383;
var PAR_ID_CAP = 128;
var PAR_OUT_CAP = 131072;    # per-call result text, copied out of the arena
var PAR_ARENA_CAP = 524288;  # per-call arena: headers + url + conn buffers + response body
var PAR_CTX_SZ = 64;         # worker ctx: arena, req, name, args, out, result_len, elapsed_ms(+48, 0.19.1), http_status(+56, 0.31.5)

var _par_ready = 0;          # 1 once the slot storage is allocated
var _par_arena = 0;          # PAR_MAX allocator handles (i64 each)
var _par_req = 0;            # PAR_MAX request buffers (DAIMON_REQ_CAP each)
var _par_out = 0;            # PAR_MAX result buffers (PAR_OUT_CAP each)
var _par_name = 0;           # PAR_MAX name buffers (PAR_NAME_CAP each)
var _par_args = 0;           # PAR_MAX args buffers (PAR_ARGS_CAP each)
var _par_id = 0;             # PAR_MAX id buffers (PAR_ID_CAP each)
var _par_ctx = 0;            # PAR_MAX ctx structs (PAR_CTX_SZ each)
var _par_thread = 0;         # PAR_MAX thread handles (i64 each)
var _par_has_name = 0;       # PAR_MAX byte flags: 1 if the call had a name
var _par_allowed = 0;        # PAR_MAX byte flags: 1 if the gate allowed it
var _par_kind = 0;           # PAR_MAX i64 roundlog verdict kinds
var _par_over = 0;           # PAR_MAX byte flags: 1 if args exceeded AGENT_ARGS_MAX (refused)
var _par_overname = 0;       # PAR_MAX byte flags: 1 if the tool NAME exceeded the slot (refused, 0.44.3)
var _par_hookblocked = 0;    # PAR_MAX byte flags: 1 if the operator's pre_tool hook denied it (0.43.1)

fn _par_ctx_ptr(s) { return _par_ctx + s * PAR_CTX_SZ; }

# _par_alloc: lazily allocate the fixed slot storage (once per session). Each slot
# gets its own arena allocator so concurrent workers never share a bump pointer.
fn _par_alloc() {
    if (_par_ready == 1) { return 1; }
    _par_arena = alloc(PAR_MAX * 8);
    _par_req = alloc(PAR_MAX * DAIMON_REQ_CAP);
    _par_out = alloc(PAR_MAX * PAR_OUT_CAP);
    _par_name = alloc(PAR_MAX * PAR_NAME_CAP);
    _par_args = alloc(PAR_MAX * PAR_ARGS_CAP);
    _par_id = alloc(PAR_MAX * PAR_ID_CAP);
    _par_ctx = alloc(PAR_MAX * PAR_CTX_SZ);
    _par_thread = alloc(PAR_MAX * 8);
    _par_has_name = alloc(PAR_MAX);
    _par_allowed = alloc(PAR_MAX);
    _par_kind = alloc(PAR_MAX * 8);
    _par_over = alloc(PAR_MAX);
    _par_overname = alloc(PAR_MAX);
    _par_hookblocked = alloc(PAR_MAX);
    # 0.44.3: an unchecked alloc here is a NULL WRITE on the first `store8`/`store64` of phase 1 — the
    # arena loop below already refuses on OOM and the caller already falls back to the serial executor,
    # so the honest thing is to take that same exit for every slot buffer rather than only the arenas.
    var ok = 1;
    if (_par_arena == 0) { ok = 0; }
    if (_par_req == 0) { ok = 0; }
    if (_par_out == 0) { ok = 0; }
    if (_par_name == 0) { ok = 0; }
    if (_par_args == 0) { ok = 0; }
    if (_par_id == 0) { ok = 0; }
    if (_par_ctx == 0) { ok = 0; }
    if (_par_thread == 0) { ok = 0; }
    if (_par_has_name == 0) { ok = 0; }
    if (_par_allowed == 0) { ok = 0; }
    if (_par_kind == 0) { ok = 0; }
    if (_par_over == 0) { ok = 0; }
    if (_par_overname == 0) { ok = 0; }
    if (_par_hookblocked == 0) { ok = 0; }
    if (ok == 0) { return 0; }
    var i = 0;
    while (i < PAR_MAX) {
        var aa = arena_allocator(PAR_ARENA_CAP);
        store64(_par_arena + i * 8, aa);
        if (aa == 0) { ok = 0; }    # OOM: an unusable slot arena
        i = i + 1;
    }
    if (ok == 0) { return 0; }      # caller falls back to the serial path (no null-arena deref)
    _par_ready = 1;
    return 1;
}

# _par_cstr_copy: bounded copy of NUL-terminated src into dst (cap bytes incl. the
# terminator); returns the copied length. src == 0 yields an empty string. Pure.
fn _par_cstr_copy(dst, cap, src) {
    var n = 0;
    if (src != 0) {
        while ((load8(src + n) != 0) && (n < (cap - 1))) {
            store8(dst + n, load8(src + n));
            n = n + 1;
        }
    }
    store8(dst + n, 0);
    return n;
}

# _agent_call_worker: one tool FETCH on slot ctx — reset the slot arena, POST the
# call, stash the raw-body length at ctx+40 (parsing happens later, serially).
# Runs on a worker thread OR inline. Reentrant — touches only its own slot + sandhi.
fn _agent_call_worker(ctx) {
    var a = load64(ctx + 0);
    reset_via(a);
    var req = load64(ctx + 8);
    var name = load64(ctx + 16);
    var args = load64(ctx + 24);
    var out = load64(ctx + 32);
    var t0 = clock_now_ms();                        # 0.19.1: this call's wall-time (each worker owns its slot)
    var rl = daimon_fetch_into(a, req, name, args, out, PAR_OUT_CAP, ctx + 56);   # 0.31.5: status -> ctx+56
    store64(ctx + 40, rl);
    store64(ctx + 48, clock_now_ms() - t0);         # elapsed ms at ctx+48 (read serially in phase 3)
    return 0;
}

# _agent_tool_ok: the recorded success flag for a daimon tool result (0.30.18). A call succeeds only when its
# body parsed to text AND the MCP `isError` flag is not set — `daimon_invoke`/`daimon_fetch_into` used to drop
# `isError`, so a tool that returned isError:true with valid text was wrongly recorded (and now shown on the
# card) as `ok`. text_ok is 1 when result text parsed; is_error is daimon_extract_is_error's verdict (1 error,
# 0 success, -1 absent — only 1 flips a text-bearing result to failure). Pure — unit-tested.
fn _agent_tool_ok(text_ok, is_error) {
    if (text_ok == 0) { return 0; }        # no parseable text -> failure
    if (is_error == 1) { return 0; }       # isError:true -> failure even with text present
    return 1;
}

# _agent_run_calls_par: the phased parallel executor (see the block comment above).
# I/O — the network invokes run concurrently; gating + result append stay serial.
fn _agent_run_calls_par(tcs, nc) {
    _par_alloc();
    _daimon_call_endpoint();         # pre-warm the cached URL on the main thread
    hoosh_http_opts();               # 0.44.3: pre-warm the socket-deadline options too — daimon_fetch_into
                                     # reads them from a worker thread, and building the cached object
                                     # there would be a race. Same discipline as the URL above.
    var base = 0;
    while (base < nc) {
        # 0.43.2: honour Esc BETWEEN batches, mirroring the serial executor's per-call poll. `nc` is the
        # model's actual tool_calls length and is not capped at PAR_MAX, so a round of 20 daimon tools
        # runs three full batches; without this the user's cancel was not read until the whole round
        # finished, and `[hoosh].parallel` is ON by default, so that was the common path. Batch-granular
        # rather than per-call: the calls inside a batch are already in flight on their own threads.
        if (intr_check() == 1) { return 0; }
        var batch = nc - base;
        if (batch > PAR_MAX) { batch = PAR_MAX; }
        # Phase 1 — snapshot {id,name,args} into stable slots + serial t-ron gate.
        var k = 0;
        while (k < batch) {
            var ci = base + k;
            var nm = agent_tc_name(tcs, ci);
            var ar = agent_tc_args(tcs, ci);
            var id = agent_tc_id(tcs, ci);
            _par_cstr_copy(_par_name + k * PAR_NAME_CAP, PAR_NAME_CAP, nm);
            store8(_par_has_name + k, 0);
            if (nm != 0) { store8(_par_has_name + k, 1); }
            # ⚠ 0.44.3 — GATE ONE STRING, EXECUTE ANOTHER. `_par_cstr_copy` TRUNCATES at
            # PAR_NAME_CAP-1 (255) while the t-ron gate below runs on the full `nm`, so a name longer
            # than the slot was authorized in one form and POSTed to daimon in another. The arguments
            # already had this exact protection (`strlen(ga) > AGENT_ARGS_MAX` refuses BEFORE gating,
            # "so t-ron never scans a truncated payload"); the name did not. Refuse, symmetrically —
            # a 256-byte tool name is not a real call, and silently renaming one is worse than saying no.
            store8(_par_overname + k, 0);
            if (nm != 0) { if (strlen(nm) > (PAR_NAME_CAP - 1)) { store8(_par_overname + k, 1); } }
            var ga = ar; if (ga == 0) { ga = "{}"; }
            _par_cstr_copy(_par_args + k * PAR_ARGS_CAP, PAR_ARGS_CAP, ga);
            _par_cstr_copy(_par_id + k * PAR_ID_CAP, PAR_ID_CAP, id);
            # 0.44.3: same sanitising as the serial executor — see the note there. The parallel path is
            # the DEFAULT one (`[hoosh].parallel`), so this is the line that actually prints in most sessions.
            ui_emit(ROLE_FAINT, "  tool-call: ");
            if (nm != 0) { emit(ui_sgr(ROLE_ACCENT)); emit_clean_line(nm); emit(ui_reset()); }
            else { ui_emit(ROLE_FAINT, "(unnamed)"); }
            if (ar != 0) { emit(" "); emit(ui_sgr(ROLE_MUTED)); emit_clean_line(ar); emit(ui_reset()); }
            oprintln("");
            events_tool_call(session_turns(), nm, ar);          # 0.43.1: the stream was silently incomplete here
            var allowed = 0;
            var kind = RL_DENIED;
            store8(_par_over + k, 0);
            store8(_par_hookblocked + k, 0);
            # Refuse oversize args BEFORE gating, and gate on the FULL `ga` (an
            # accepted call's slot copy equals it, since strlen(ga) <= AGENT_ARGS_MAX
            # = PAR_ARGS_CAP-1) — so t-ron never scans a truncated payload and no
            # clipped/malformed body is ever POSTed.
            #
            # ⚠ 0.43.1: `hooks_pre_tool` MUST run here too. It lived only in the serial executor, and
            # [hoosh].parallel defaults to ON — so in the DEFAULT configuration any round with two or more
            # daimon tools and no local tool skipped the operator's blocking hook entirely. That made the
            # documented contract ("a deterministic, code-enforced deny a prompt cannot argue with") false
            # for the common case, silently, with no way for the operator to tell. Placed BEFORE the t-ron
            # gate, as in the serial path, so the strictest verdict still wins and a hook can only ever
            # narrow authority. Phase 1 is already a serial loop over the batch, so the hook keeps running
            # one at a time and never races.
            if (nm == 0) { kind = RL_NONAME; }
            elif (load8(_par_overname + k) == 1) { kind = RL_DENIED; }
            elif (strlen(ga) > AGENT_ARGS_MAX) { store8(_par_over + k, 1); kind = RL_DENIED; }
            elif (hooks_pre_tool(nm, ga) == 0) { store8(_par_hookblocked + k, 1); kind = RL_DENIED; }
            elif (gate_authorize(nm, ga, "call tool", nm) == 1) { allowed = 1; kind = RL_ALLOWED; }
            store8(_par_allowed + k, allowed);
            store64(_par_kind + k * 8, kind);
            k = k + 1;
        }
        # Phase 2 — fan out the allowed calls; each worker owns its slot's arena.
        _agent_spin_ntools(batch);          # 0.19.1: label the spinner for the concurrent batch
        var s = 0;
        while (s < batch) {
            store64(_par_thread + s * 8, 0);
            if (load8(_par_allowed + s) == 1) {
                var ctx = _par_ctx_ptr(s);
                store64(ctx + 0, load64(_par_arena + s * 8));
                store64(ctx + 8, _par_req + s * DAIMON_REQ_CAP);
                store64(ctx + 16, _par_name + s * PAR_NAME_CAP);
                store64(ctx + 24, _par_args + s * PAR_ARGS_CAP);
                store64(ctx + 32, _par_out + s * PAR_OUT_CAP);
                store64(ctx + 40, 0 - 1);
                var t = thread_create(&_agent_call_worker, ctx);
                if (t == 0) { _agent_call_worker(ctx); }   # no threads -> inline (serial fallback)
                else { store64(_par_thread + s * 8, t); }
            }
            s = s + 1;
        }
        # 0.44.2: the main thread now BLOCKS in thread_join for the length of the slowest call in the
        # batch, and the workers do only network — nothing on this side writes to the terminal until
        # phase 3. That is exactly the window the animator was built for.
        spin_anim_arm();
        s = 0;
        while (s < batch) {
            var th = load64(_par_thread + s * 8);
            if (th != 0) { thread_join(th); }
            s = s + 1;
        }
        spin_anim_disarm();                 # before phase 3 prints anything
        spin_label_clear();                 # 0.19.1: batch joined -> back to the generic indicator
        # Phase 3 — print + record + append results in deterministic call order.
        k = 0;
        while (k < batch) {
            var kind2 = load64(_par_kind + k * 8);
            var rl_ok = 0;
            var res = 0;
            var ms = 0;                                          # 0.19.1: this call's wall-time (0 if not invoked)
            if (kind2 == RL_NONAME) { res = "(no tool name)"; }
            elif (load8(_par_allowed + k) == 1) {
                ms = load64(_par_ctx_ptr(k) + 48);               # 0.19.1: worker-measured elapsed
                var rlen = load64(_par_ctx_ptr(k) + 40);
                if (rlen < 0) {
                    # worker's daimon_fetch_into returned -1 (transport failure) — kept
                    # distinct from a parsed-but-empty 2xx body so the model sees why.
                    res = "(tool call failed: transport error)";
                } elif (rlen > (PAR_OUT_CAP - 1)) {
                    # 0.44.3: the body did not fit the slot. The clip lands mid-JSON, so parsing it would
                    # fail and report "(tool returned no result)" — a lie about a call that succeeded and
                    # returned too much. Say what happened, and say it to the MODEL, whose next move
                    # (ask for less) depends on knowing which of the two it was. The serial executor has
                    # no such cap, so this is also where the two paths stop disagreeing silently.
                    res = "(tool result too large for this round and was discarded; ask for a smaller slice)";
                } else {
                    res = "(tool returned no result)";
                    var st = load64(_par_ctx_ptr(k) + 56);           # 0.31.5: the worker-stashed HTTP status
                    # SERIAL bayan parse of the raw body the worker fetched (parses are main-thread only).
                    var text = daimon_extract_text(_par_out + k * PAR_OUT_CAP, rlen);
                    if ((st < 200) || (st >= 300)) {                 # 0.31.5: non-2xx -> failed call (rl_ok stays 0), mirror daimon_invoke
                        if ((text != 0) && (str_len(text) > 0)) { res = str_cstr(text); }   # non-empty error text
                        else { res = _daimon_http_err(st); }         # else a synthetic HTTP-status message
                    }
                    elif (text != 0) {
                        res = str_cstr(text);
                        rl_ok = _agent_tool_ok(1, daimon_extract_is_error(_par_out + k * PAR_OUT_CAP, rlen));   # 0.30.18: honor isError
                        # 0.44.3: the 0.44.1 WRONG-TREE correction, which shipped on the serial path only.
                        # A daimon-hosted `fs_read` is rooted at $BOTE_FS_ROOT while thoth's `read_file` is
                        # rooted at the launch cwd, and when the host tool MISSES a file this project
                        # actually has, naming the call that works is what stopped the model looping. The
                        # parallel executor is the DEFAULT, so the fix has been absent from the common path
                        # for the whole release that introduced it.
                        if (daimon_extract_is_error(_par_out + k * PAR_OUT_CAP, rlen) == 1) {
                            res = _agent_xtree_append(res, _par_args + k * PAR_ARGS_CAP);
                        }
                    }
                }
                res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
            } else {
                res = "denied by authorization policy";
                if (load8(_par_over + k) == 1) { res = "(tool arguments too large; call refused — split into smaller calls)"; }
                if (load8(_par_overname + k) == 1) { res = "(tool name too long; call refused)"; }
                # 0.43.1: say WHICH control refused. A hook denial and a policy denial are different facts,
                # and the model's next move differs — the serial path has always distinguished them.
                if (load8(_par_hookblocked + k) == 1) { res = "(blocked by the pre_tool hook)"; }
            }
            var nmout = 0;
            if (load8(_par_has_name + k) == 1) { nmout = _par_name + k * PAR_NAME_CAP; }
            var bytes = 0; if (res != 0) { bytes = strlen(res); }   # 0.19.1
            events_tool_result(session_turns(), nmout, rl_ok, bytes);   # 0.43.1
            if (nmout != 0) { hooks_post_tool(nmout, _par_args + k * PAR_ARGS_CAP); }   # 0.43.1: cannot block
            _agent_call_telem(kind2, rl_ok, ms, bytes);            # 0.19.1: telemetry sub-line
            log_tool(nmout, _par_args + k * PAR_ARGS_CAP, roundlog_kind_str(kind2), rl_ok, ms, bytes);   # 0.44.2: session log
            roundlog_add_call(nmout, kind2, rl_ok, ms, bytes, _par_args + k * PAR_ARGS_CAP);   # 0.30.17: + the snapshotted raw args
            _agent_add_result(_par_id + k * PAR_ID_CAP, res);
            k = k + 1;
        }
        base = base + batch;
    }
    return 0;
}

# _agent_run_calls: execute this round's tool calls. Fans them out concurrently
# (_agent_run_calls_par) when [hoosh].parallel is on AND there is more than one
# call; otherwise runs the serial path. Either way every call is t-ron-gated and a
# deny becomes a result the model can react to, never an abort.
# _agent_round_has_local: 1 if any call in this round is a thoth-native tool
# (memory_write) executed LOCALLY, not forwarded to daimon. Such a round is forced
# through the SERIAL executor so the parallel daimon workers never see it (they
# only ever forward to daimon). 0.12.2.
fn _agent_round_has_local(tcs, nc) {
    var i = 0;
    while (i < nc) {
        var nm = agent_tc_name(tcs, i);
        if (nm != 0) {
            if (streq(nm, "memory_write") == 1) { return 1; }
            if (streq(nm, "read_file") == 1) { return 1; }    # 0.23.0 local project tools -> serial dispatch
            if (streq(nm, "list_dir") == 1) { return 1; }
            if (streq(nm, "search") == 1) { return 1; }       # 0.40.0 (T1-1): LOCAL — must route serial, or the
                                                              # parallel path would forward it to daimon, which
                                                              # has no such tool (an honest-looking 400, wrong cause)
            # "shell" is matched UNCONDITIONALLY (not gated on config): a call named "shell" must
            # always take the serial path so the local dispatch elif below decides its fate — even
            # when disabled, where that elif returns an honest not-enabled string rather than letting
            # a hallucinated/un-advertised "shell" fall through to daimon_invoke. 0.16.0.
            if (streq(nm, "shell") == 1) { return 1; }
            if (streq(nm, "edit") == 1) { return 1; }         # 0.31.0 local edit tool -> serial dispatch (same rationale as shell)
            if (streq(nm, "create_file") == 1) { return 1; }  # 0.31.3 local create tool -> serial dispatch
            # 0.43.0 (T2-1): `delegate` MUST be here. The parallel executor fires no pre_tool hook and no
            # events, so a multi-call round containing an unregistered delegate would skip the operator's
            # blocking security hook entirely — an authorization bug, not just a state one. It also runs a
            # whole child turn, which must never happen concurrently with the parent's other calls.
            if (streq(nm, "delegate") == 1) { return 1; }
            # 0.44.0 (T4-1): `ask_user` BLOCKS on a human. It must take the serial path for the same
            # reason delegate does — the parallel executor fires no pre_tool hook and no events — and
            # additionally because two concurrent workers cannot both own the operator's screen.
            if (streq(nm, "ask_user") == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# _agent_call_telem: a faint per-call telemetry sub-line under the result (0.19.1) — the verdict, and for an
# invoked call its wall-time (ms) + result byte count. Mirrors the roundlog fields so the live feed and
# /audit agree. Routes through the SAME sink as the tool-call/result lines (feed at OUT_RING, terminal at
# OUT_FD1); floor-safe (ui_emit/ofmt_int are verbatim at PT_PLAIN).
fn _agent_call_telem(kind, ok, ms, bytes) {
    ui_emit(ROLE_FAINT, "    · ");
    if (kind == RL_ALLOWED) {
        if (ok == 1) { ui_emit(ROLE_GREEN, "ok"); } else { ui_emit(ROLE_RED, "err"); }
        ui_emit(ROLE_FAINT, " · "); ofmt_int(ms); ui_emit(ROLE_FAINT, "ms · "); ofmt_int(bytes); ui_emit(ROLE_FAINT, "B");
    } elif (kind == RL_NONAME) { ui_emit(ROLE_MUTED, "no tool name"); }
    else { ui_emit(ROLE_RED, "denied"); }
    oprintln("");
    return 0;
}

# _agent_spin_ntools: label the spinner "N tools" for a parallel batch (0.19.1). No-op off the TUI.
fn _agent_spin_ntools(n) {
    var b[32];
    var o = _append_int(&b, 0, n);
    var t = " tools";
    var ti = 0;
    while ((load8(t + ti) != 0) && (o < 30)) { store8(&b + o, load8(t + ti)); o = o + 1; ti = ti + 1; }
    store8(&b + o, 0);
    spin_label_set(&b);
    return 0;
}

fn _agent_run_calls(tcs, nc) {
    # 0.20.0 CRASH GUARD: the parallel executor's first act is _daimon_call_endpoint(), which strlen()s
    # config_daimon_url() — NULL when daimon is absent (shell-standalone mode) -> a null-page deref. Force
    # serial when the seam is absent (there is nothing to fan out to anyway; the local shell/memory tools run
    # serially, and a hallucinated non-local tool is refused honestly in the serial path). Floor: when daimon
    # is wired the check is false and the parallel/serial decision is byte-identical.
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) { return _agent_run_calls_serial(tcs, nc); }
    # 0.43.0 (T2-1): a CHILD round ALWAYS runs serial. Registering `delegate` in _agent_round_has_local
    # keeps the round that CONTAINS a delegation off the parallel path, but says nothing about the rounds
    # the child itself runs — and a child round with two daimon tools would otherwise fan out through
    # _agent_run_calls_par, which fires NO pre_tool hook and NO tool events. That would silently drop the
    # operator's blocking security hook for exactly the calls they can see least. It also shares the one
    # bank of _par_* slots with the parent, whose delegate call is live on the stack.
    if (_sub_depth > 0) { return _agent_run_calls_serial(tcs, nc); }
    if ((config_hoosh_parallel() == 1) && (nc > 1) && (_agent_round_has_local(tcs, nc) == 0) && (_par_alloc() == 1)) { return _agent_run_calls_par(tcs, nc); }
    return _agent_run_calls_serial(tcs, nc);
}

# _agent_run_calls_serial: execute every tool_call in this round one at a time —
# gate, invoke, record the result message. The fallback path (parallel off, or a
# single-call round); also the structure the parallel executor mirrors. I/O.
fn _agent_run_calls_serial(tcs, nc) {
    var ci = 0;
    while (ci < nc) {
        if (intr_check() == 1) { return 0; }    # 0.34.1: Esc between tool calls -> stop this round's remaining calls (armed by agent_turn during the tool phase)
        var nm = agent_tc_name(tcs, ci);
        var ar = agent_tc_args(tcs, ci);
        var id = agent_tc_id(tcs, ci);
        # ⚠ 0.44.3 — `nm` and `ar` are the MODEL'S bytes and this line is CHROME. Emitted raw they were the
        # third sibling of the 0.39.0 audit's A-7/A-8 pair: feed_clip copies an unrecognised escape
        # verbatim (it must — thoth's role markers ride that channel), so an ESC in a tool name reached
        # the terminal. Worse here than in the tree pane, because this line prints BEFORE the t-ron gate
        # runs, so even a call that is about to be DENIED gets to paint. The role colour is thoth's; the
        # bytes inside it are not.
        ui_emit(ROLE_FAINT, "  tool-call: ");
        if (nm != 0) { emit(ui_sgr(ROLE_ACCENT)); emit_clean_line(nm); emit(ui_reset()); }
        else { ui_emit(ROLE_FAINT, "(unnamed)"); }
        if (ar != 0) { emit(" "); emit(ui_sgr(ROLE_MUTED)); emit_clean_line(ar); emit(ui_reset()); }
        oprintln("");
        events_tool_call(session_turns(), nm, ar);          # 0.42.0 (T3): NDJSON for machine consumers
        var gp = ar; if (gp == 0) { gp = "{}"; }
        var res = 0;
        var rl_kind = RL_DENIED;
        var rl_ok = 0;
        spin_label_set(nm);                     # 0.19.1: name the running tool on the spinner (no-op off TUI)
        var t0 = clock_now_ms();                # 0.19.1: time the gate+invoke
        if (nm == 0) { res = "(no tool name)"; rl_kind = RL_NONAME; }
        elif (strlen(gp) > AGENT_ARGS_MAX) { res = "(tool arguments too large; call refused — split into smaller calls)"; rl_kind = RL_DENIED; }
        # 0.41.0 (T2-4): the operator's pre_tool hook. Placed HERE — before the per-tool arms, so it sees
        # EVERY tool including the local ones — and it can only ever DENY. A hook cannot approve what
        # t-ron denied, because each arm still runs its own gate below; the strictest verdict wins.
        elif (hooks_pre_tool(nm, gp) == 0) { res = "(blocked by the pre_tool hook)"; rl_kind = RL_DENIED; }
        elif (streq(nm, "memory_write") == 1) {
            # thoth-native tool (0.12.2): the model saves a durable fact to project
            # memory. Gated under thoth_remember — executed LOCALLY, NOT via daimon.
            if (gate_authorize("thoth_remember", gp, "remember to", memory_index_path()) == 1) {
                rl_kind = RL_ALLOWED;
                res = memory_write_tool(gp);
                rl_ok = 1;
                res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
            } else {
                res = "denied by authorization policy";
            }
        }
        elif (streq(nm, "read_file") == 1) {
            # thoth-native project tool (0.23.0, ADR-0015): read a file, JAILED to the launch cwd.
            # No t-ron gate — the jail (no absolute / no '..') is the safety boundary. LOCAL, not daimon.
            rl_kind = RL_ALLOWED;
            res = read_file_tool(gp);
            rl_ok = 1;
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif (streq(nm, "search") == 1) {
            # thoth-native project tool (0.40.0, T1-1): search the project, JAILED exactly as read_file is —
            # _project_read_ok + _project_no_symlink + _project_sensitive, applied per entry as the walk
            # descends. No t-ron gate, same reasoning as read_file/list_dir: read-only and jail-confined.
            rl_kind = RL_ALLOWED;
            res = search_tool(gp);
            rl_ok = 1;
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif (streq(nm, "list_dir") == 1) {
            # thoth-native project tool (0.23.0, ADR-0015): list a directory, JAILED to the launch cwd.
            rl_kind = RL_ALLOWED;
            res = list_dir_tool(gp);
            rl_ok = 1;
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif ((streq(nm, "shell") == 1) && (config_shell_enabled() == 1) && (shell_supported() == 1)) {
            # thoth-native shell tool (0.16.0, ADR-0014): the model proposes a local command.
            # shell_run_tool runs the LOCAL glob filter + the t-ron thoth_shell gate + the timed
            # capture internally (globs BEFORE the gate, so a deny-list holds even with no policy),
            # returning the result string plus the roundlog outcome. Executed LOCALLY, NOT via daimon.
            res = shell_run_tool(gp);
            if (shell_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
            rl_ok = shell_last_ok();
            res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
        }
        elif (streq(nm, "shell") == 1) {
            # "shell" emitted while the tool is disabled / unsupported (it was never advertised):
            # return an honest not-enabled string. Do NOT run it and do NOT fall through to
            # daimon_invoke — never execute or forward a tool the model was not offered. rl stays DENIED.
            res = "(shell tool is not enabled in this session)";
            res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
        }
        elif (streq(nm, "edit") == 1) {
            # thoth-native edit tool (0.31.0, ADR-0017): the model rewrites a project file. edit_tool self-gates
            # (jail + t-ron thoth_edit) and applies the diff internally, exposing the outcome via edit_last_*;
            # LOCAL, NOT via daimon. When [edit].enabled is off it was never advertised — return an honest
            # not-enabled string (rl stays DENIED) rather than letting a hallucinated "edit" reach daimon.
            if (config_edit_enabled() == 1) {
                res = edit_tool(gp);
                if (edit_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
                rl_ok = edit_last_ok();
                if (edit_last_ok() == 1) {                            # 0.31.1: record the edit's diff for the feed card
                    editlog_record(session_turns(), roundlog_cur_round(), ci, edit_last_path(), edit_last_old(), edit_last_old_len(), edit_last_new(), edit_last_new_len());
                    res = _agent_verify_append(res);                   # 0.41.0 (T2-5): run the project's check, fold it in
                }
            } else {
                res = "(edit tool is not enabled in this session)";
            }
            res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
        }
        elif (streq(nm, "create_file") == 1) {
            # thoth-native create tool (0.31.3, ADR-0017): the model makes a NEW project file. create_file_tool
            # self-gates (jail + thoth_edit) and refuses an existing file; LOCAL, NOT via daimon. Records the same
            # editlog entry (old="" -> all-add diff card) via the shared edit_last_* state.
            if (config_edit_enabled() == 1) {
                res = create_file_tool(gp);
                if (edit_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
                rl_ok = edit_last_ok();
                if (edit_last_ok() == 1) {
                    editlog_record(session_turns(), roundlog_cur_round(), ci, edit_last_path(), edit_last_old(), edit_last_old_len(), edit_last_new(), edit_last_new_len());
                    res = _agent_verify_append(res);                   # 0.41.0 (T2-5): same loop for a new file
                }
            } else {
                res = "(create_file tool is not enabled in this session)";
            }
            res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
        }
        elif (streq(nm, "ask_user") == 1) {
            # 0.44.0 (T4-1): the one tool that runs TOWARD the user. LOCAL and matched unconditionally
            # (not gated on config) for the same reason `shell` is: a call by this name must always land
            # here so the arm below decides its fate, rather than a hallucinated/un-advertised name
            # falling through to daimon_invoke and coming back as a confusing 400.
            #
            # NOT t-ron-gated: a question touches no file, no process and no network — it is strictly
            # less dangerous than `read_file`, which is ungated too, and gating it would mean a confirm
            # prompt to authorize a prompt. ask_user_tool reports its own outcome (it can refuse on the
            # budget, on a bad shape, or because no operator is reachable), so the round card and the
            # tool_result event say what actually happened rather than "the feature is on".
            res = ask_user_tool(gp);
            rl_kind = RL_ALLOWED;
            rl_ok = 1;
            if (ask_state() != 1) { rl_ok = 0; }        # declined / unreachable / refused -> not a success
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif (streq(nm, "delegate") == 1) {
            # 0.43.0 (T2-1, ADR-0018): a scoped child context. subagent_tool self-gates ([subagent].enabled,
            # depth, and the t-ron thoth_delegate verb) and returns a result string either way; LOCAL, never
            # forwarded to daimon. When disabled it was never advertised, so a hallucinated `delegate`
            # returns an honest not-enabled string rather than reaching the network.
            res = subagent_tool(gp);
            # The verdict must reflect what actually happened. The first cut set ALLOWED+ok on the mere
            # fact that the feature was enabled, so a policy DENIAL, a bad-arguments refusal and a
            # gateway failure all recorded as a successful tool call — in the round card, the telemetry
            # and the `ok` field of the tool_result event. subagent_tool reports its own outcome instead.
            if (subagent_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
            rl_ok = subagent_last_ok();
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif (seam_status(SEAM_DAIMON) == SEAM_ABSENT) {
            # 0.20.0 CRASH GUARD: shell-standalone mode (agentic loop, no daimon). A non-local tool can't be
            # served — and daimon_invoke -> _daimon_call_endpoint would strlen() a NULL daimon URL. Refuse
            # honestly (rl stays DENIED); never touch the network. Only reachable when the seam is absent.
            res = "(tool not available: no daimon wired — only the local shell/memory tools run standalone)";
            res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
        }
        elif (gate_authorize(nm, gp, "call tool", nm) == 1) {
            rl_kind = RL_ALLOWED;
            # 0.44.2: one blocking MCP round-trip with nothing printing until it returns — animate it.
            spin_anim_arm();
            res = daimon_invoke(nm, ar);
            spin_anim_disarm();
            var text_ok = 0; if (res != 0) { text_ok = 1; }         # parsed a result?  (before the placeholder reassign)
            if (res == 0) { res = "(tool returned no result)"; }
            rl_ok = _agent_tool_ok(text_ok, daimon_invoke_is_error());   # 0.30.18: text parsed AND not an MCP isError
            # 0.44.1: a host file tool that MISSED a file this project has is the wrong-tree mistake; say so,
            # and name the call that works. Only on a failure, so a working host tool is left alone.
            if (daimon_invoke_is_error() == 1) { res = _agent_xtree_append(res, ar); }
            res = redact_tool_result(res); ui_emit(ROLE_FAINT, "  result: "); emit_clean_text(res); oprintln("");
        } else {
            res = "denied by authorization policy";
        }
        var ms = clock_now_ms() - t0;           # 0.19.1: invoke wall-time
        spin_label_clear();
        var bytes = 0; if (res != 0) { bytes = strlen(res); }   # 0.19.1: result byte count
        events_tool_result(session_turns(), nm, rl_ok, bytes);  # 0.42.0 (T3)
        if (nm != 0) { hooks_post_tool(nm, gp); }                # 0.41.0 (T2-4): after the work; cannot block
        _agent_call_telem(rl_kind, rl_ok, ms, bytes);           # 0.19.1: faint telemetry sub-line
        log_tool(nm, ar, roundlog_kind_str(rl_kind), rl_ok, ms, bytes);   # 0.44.2: session log
        roundlog_add_call(nm, rl_kind, rl_ok, ms, bytes, ar);   # 0.30.17: + the raw args for the card/audit summary
        _agent_add_result(id, res);
        ci = ci + 1;
    }
    return 0;
}

# One iteration's normalized outcome (set by the iter helpers, read by the loop):
#   kind 0 = final answer (content already printed; in _hoosh_acc to persist)
#   kind 1 = tool calls to run (_agent_round_raw text + _agent_round_val parsed)
#   kind 2 = transport error (message already announced)
#   kind 3 = non-2xx HTTP (status in _agent_round_status; message announced)
var _agent_round_kind = 0;
# _agent_empty_stream: 1 when the last streamed round returned HTTP 200 carrying not one usable frame.
var _agent_empty_stream = 0;
fn agent_empty_stream() { return _agent_empty_stream; }
var _agent_round_raw = 0;
var _agent_round_val = 0;
var _agent_round_n = 0;
var _agent_round_status = 0;
var _agent_cell = 0;

# _agent_finish_outcome: shared classification — given a fully-received response
# (raw tool_calls text + parsed array + content already handled), set the round
# outcome. Content for the final answer is left in _hoosh_acc by the caller.
# _agent_normalize_block: put a NON-STREAMING round's tool_calls through the SAME slot hygiene the
# streaming accumulator applies, and return the rebuilt array text (or 0 to keep the provider's).
#
# ⚠ 0.44.3 — 0.44.2's TOOL-CALL HYGIENE WAS STREAM-ONLY, AND THE SUBAGENT NEVER STREAMS. All of it —
# drop a slot with no name, mint a locally-generated id when the provider omitted one, refuse a call
# whose arguments were clipped mid-JSON — lives in `_ag_build_array`, which only the SSE path reached.
# The blocking path took the provider's array VERBATIM and handed it to `_agent_add_assistant`, so the
# exact defect 0.44.2 was written to survive (hoosh dropping a tool call's opening frame, leaving
# `{"id":"","function":{"name":"",...}}`) still went into HISTORY, where the provider rejects a
# `tool_use` with an empty id and name and every later round comes back empty. `_sub_iter` calls
# `_agent_iter_block` unconditionally, so a delegated turn had NONE of the protection.
#
# Rebuilding through the one builder is what makes the two paths agree by construction rather than by
# two implementations that have to be kept in step.
fn _agent_normalize_block(tcs, nc) {
    _ag_reset();
    var i = 0;
    var kept = 0;
    while ((i < nc) && (i < AGENT_MAX_CALLS)) {
        var nm = agent_tc_name(tcs, i);           # already answers 0 for an empty-string name (0.44.2)
        var id = agent_tc_id(tcs, i);
        var ar = agent_tc_args(tcs, i);
        if (nm != 0) {
            _ag_copy_str(_ag_names + (i * AG_NAME_CAP), AG_NAME_CAP, str_from(nm));
            if (id != 0) { _ag_copy_str(_ag_ids + (i * AG_ID_CAP), AG_ID_CAP, str_from(id)); }
            if (ar != 0) { _ag_copy_str(_ag_args + (i * AG_ARGS_CAP), AG_ARGS_CAP, str_from(ar)); }
            store8(_ag_seen + i, 1);
            kept = kept + 1;
        }
        _ag_max = i + 1;
        i = i + 1;
    }
    if (kept == 0) { return 0; }
    _ag_build_array(_agent_arr_buf);
    if (_ag_dropped > 0) {
        ui_emit(ROLE_RED, "  [dropped "); ofmt_int(_ag_dropped);
        ui_emit(ROLE_RED, " malformed tool call(s)");
        ui_emit(ROLE_FAINT, " — the gateway sent a call with no name; the model can re-issue it");
        oprintln("");
    }
    return _agent_arr_buf;
}

fn _agent_set_tools(raw, val, n) {
    _agent_round_raw = raw;
    _agent_round_val = val;
    _agent_round_n = n;
    _agent_round_kind = 1;
    return 0;
}

# _agent_sse_cb: the streaming callback. Content deltas print live and accumulate
# in _hoosh_acc; tool_call deltas fold into the per-index slots. [DONE] ends it.
fn _agent_sse_cb(ctx, ev) {
    if (intr_check() == 1) { return 0; }   # 0.17.4 Esc -> stop the stream cleanly (partial kept); 0.34.3: via the seam so the GUI stop-poll hook fires per frame too (TUI unchanged — no hook -> intr_poll)
    # 0.44.2: this callback PRINTS (mdhl_feed + feed_stream_tick). Take the terminal from the animator for
    # the duration, so a worker frame can never interleave with a repaint. No-op when no animator is armed.
    spin_anim_claim();
    var data = sandhi_sse_event_data(ev);
    if (data == 0) { spin_anim_release(); return 1; }
    if (streq(data, "[DONE]") == 1) { spin_anim_release(); return 0; }
    var v = bayan_json_v_parse_buf(data, strlen(data));
    if (v == 0) { spin_anim_release(); return 1; }
    _hoosh_account_usage(v);   # 0.10.2/0.10.3: tokens + cost from the trailing usage frame
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { spin_anim_release(); return 1; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { spin_anim_release(); return 1; }
    var delta = bayan_json_v_obj_get(first, "delta");
    if (delta == 0) { spin_anim_release(); return 1; }
    var rc = bayan_json_v_obj_get(delta, "reasoning_content");   # 0.35.2: chain-of-thought stream -> reasoning fold (empty on Opus 4.8)
    if (rc != 0) {
        var rs = bayan_json_v_str(rc);
        if (rs != 0) { var rn = str_len(rs); if (rn > 0) { _reason_acc_append(str_data(rs), rn); } }
    }
    var content = bayan_json_v_obj_get(delta, "content");
    if (content != 0) {
        var s = bayan_json_v_str(content);
        if (s != 0) { var n = str_len(s); if (n > 0) { mdhl_feed(str_data(s), n); _hoosh_acc_append(str_data(s), n); } }   # 0.15.1: fenced-code highlighter
    }
    var tcs = bayan_json_v_obj_get(delta, "tool_calls");
    if (tcs != 0) {
        var tn = bayan_json_v_arr_len(tcs);
        var i = 0;
        while (i < tn) { _agent_accum_delta(bayan_json_v_arr_get(tcs, i)); i = i + 1; }
    }
    # ⚠ COUNT ONLY FRAMES THAT CARRY SOMETHING. The terminating frame is `"delta":{}` with
    # finish_reason "stop", so counting every delta would make an empty stream look like a one-frame
    # answer — which is exactly the confusion this counter exists to remove. content, reasoning and
    # tool_calls are the three ways a frame can be useful; a frame with none of them is bookkeeping.
    if (rc != 0) { _ag_frames = _ag_frames + 1; }
    elif (content != 0) { _ag_frames = _ag_frames + 1; }
    elif (tcs != 0) { _ag_frames = _ag_frames + 1; }
    feed_stream_tick();   # 0.9.2: TUI incremental paint + spinner (no-op off the TUI)
    spin_anim_release();  # 0.44.2: give the glyph back to the animator until the next chunk
    return 1;
}

# _agent_iter_block: one non-streaming iteration (a full POST, parsed whole).
fn _agent_iter_block(model, sys, mem, tools_buf, tools_len) {
    var len = agent_build_request(_agent_req, model, sys, mem, tools_buf, tools_len, 0);
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    # 0.44.2: a non-streaming round is ONE blocking POST with no callback at all — the frame could never
    # move for its whole duration, which is the longest stillness of any path here.
    spin_anim_arm();
    var r = sandhi_http_post_opts(_hoosh_endpoint_url(), h, _agent_req, len, hoosh_http_opts());   # 0.44.2: per-read deadline (see config_hoosh_timeout_ms)
    spin_anim_disarm();
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        var en = sandhi_err_kind_name(sandhi_http_err_kind(r));
        emit("  hoosh transport error: "); oprintln(en);
        _agent_round_kind = 2; return 0;
    }
    var status = sandhi_http_status(r);
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        var em = hoosh_extract_error(body, blen);
        if (em != 0) { emit("  "); _hoosh_print_str(em); }
        _agent_round_kind = 3; _agent_round_status = status; return 0;
    }
    _hoosh_account_usage(bayan_json_v_parse_buf(body, blen));
    var tcs = agent_tool_calls(body, blen);
    var nc = agent_tc_count(tcs);
    if (nc == 0) {
        var content = hoosh_extract_content(body, blen);
        if (content != 0) { _hoosh_print_reply(content); _hoosh_acc_append(str_data(content), str_len(content)); }   # 0.15.1: fenced-code highlighting
        _agent_round_kind = 0;
    } else {
        # 0.44.3: normalise through the shared builder first (see _agent_normalize_block). Falls back to
        # the provider's own array only when normalisation kept nothing, which keeps the previous
        # behaviour for the degenerate case rather than silently emptying a round.
        var raw = _agent_normalize_block(tcs, nc);
        if (raw == 0) { raw = _agent_raw_tool_calls(body, blen); }
        if (raw == 0) { raw = "[]"; }
        _agent_set_tools(raw, tcs, nc);
    }
    return 0;
}

# _agent_iter_stream: one streaming iteration. SSE content prints live; tool_calls
# assemble from the deltas and are reconstructed into the same array text shape.
fn _agent_iter_stream(model, sys, mem, tools_buf, tools_len) {
    _ag_reset();
    var len = agent_build_request(_agent_req, model, sys, mem, tools_buf, tools_len, 1);
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    sandhi_headers_set(h, "Accept", "text/event-stream");
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    if (_agent_cell == 0) { _agent_cell = alloc(8); }
    store64(_agent_cell, 0);
    mdhl_reset();    # 0.15.1: bracket the fenced-code highlighter around this iteration's stream
    intr_arm();      # 0.17.4: enter Esc-poll mode around the stream (TUI-only; no-op off OUT_RING)
    # 0.44.2: hand the spinner to the animator for the whole stream. The gap that mattered is the FIRST
    # byte — a cold cloud round can sit in recv for seconds with nothing to tick the frame — but it also
    # covers a mid-stream stall. _agent_sse_cb claims the terminal back around its own painting.
    spin_anim_arm();
    var sr = sandhi_http_stream_opts(_hoosh_endpoint_url(), "POST", h, _agent_req, len, &_agent_sse_cb, _agent_cell, hoosh_http_opts());   # 0.44.2: per-read deadline
    spin_anim_disarm();
    intr_disarm();   # 0.17.4: restore cooked (the following t-ron confirm reads a line in cooked mode)
    mdhl_finish();   # drain the filter (residual line + open block) before the finishing newline / status branching
    if (_hoosh_acc_len > 0) { oprintln(""); }   # finish the streamed line
    if (intr_pending() == 1) { _agent_round_kind = 4; return 0; }   # 0.17.4: Esc aborted — kind 4, before tool-parse
    if (sandhi_stream_err(sr) != SANDHI_OK) {
        var en = sandhi_err_kind_name(sandhi_stream_err(sr));
        emit("  hoosh stream error: "); oprintln(en);
        _agent_round_kind = 2; return 0;
    }
    var status = sandhi_stream_status(sr);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        oprintln("  (error body not surfaced in stream mode; set [hoosh].stream=false to see it)");
        _agent_round_kind = 3; _agent_round_status = status; return 0;
    }
    # ⚠ 0.44.2 — AN EMPTY 200 STREAM IS A GATEWAY FAULT, AND IT USED TO READ AS A MODEL FAILURE.
    # Measured against the live stack: hoosh 2.6.4's remote-streaming path calls the provider, gets a
    # permanent 4xx back, logs `provider: permanent error, not retrying` to its OWN log — and then sends
    # the client a perfectly well-formed HTTP 200 SSE stream consisting of one `finish_reason:"stop"`
    # frame and nothing else. thoth said "response had neither tool calls nor content", which is true and
    # useless: it points at the model, the operator retries, the same thing happens, and the session
    # looks stuck. Reproduced deterministically by replaying one captured request body; the trigger there
    # was the provider rejecting a large-token request, but the SHAPE is general — any upstream error the
    # gateway cannot forward arrives here as silence.
    #
    # thoth cannot see the gateway's log, so it does not guess at a cause. It reports what it can PROVE:
    # the request was accepted, the stream carried no frames at all, and that is the gateway's business
    # rather than the model's.
    var frames_seen = _ag_frames;
    if (_ag_max > 0) {
        var rl = _ag_build_array(_agent_arr_buf);
        var val = bayan_json_v_parse_buf(_agent_arr_buf, rl);
        var vn = agent_tc_count(val);
        # 0.44.2: a slot whose opening delta never arrived is dropped by _ag_build_array rather than
        # emitted nameless (see the comment there). SAY SO — the round is about to run fewer calls than
        # the model asked for, and a silent shrink is indistinguishable from the model changing its mind.
        if (ag_dropped() > 0) {
            ui_emit(ROLE_RED, "  gateway dropped the opening frame for ");
            ofmt_int(ag_dropped());
            ui_emit(ROLE_RED, " tool call(s)");
            ui_emit(ROLE_FAINT, " — skipped, not sent (the model re-issues them next round)");
            oprintln("");
            log_begin("tool_call_dropped"); log_kv_int("count", ag_dropped()); log_kv_int("turn", session_turns()); log_commit(SK_WARN);
        }
        # 0.44.2: the other two ways a streamed round can come out smaller than the model asked for. Both
        # were silent; both present downstream as "the agent ignored what I told it to do".
        if (ag_over_cap() == 1) {
            ui_emit(ROLE_RED, "  the model asked for more than ");
            ofmt_int(AGENT_MAX_CALLS);
            ui_emit(ROLE_RED, " tool calls in one round");
            ui_emit(ROLE_FAINT, " — the rest were not run");
            oprintln("");
            log_begin("tool_calls_over_cap"); log_kv_int("cap", AGENT_MAX_CALLS); log_kv_int("turn", session_turns()); log_commit(SK_WARN);
        }
        if (ag_oversize() == 1) {
            ui_emit(ROLE_RED, "  a tool call's arguments exceeded ");
            ofmt_int(AG_ARGS_CAP - 1);
            ui_emit(ROLE_RED, " bytes");
            ui_emit(ROLE_FAINT, " — dropped rather than sent half-written");
            oprintln("");
            log_begin("tool_args_oversize"); log_kv_int("cap", AG_ARGS_CAP - 1); log_kv_int("turn", session_turns()); log_commit(SK_WARN);
        }
        if (vn > 0) { _agent_set_tools(_agent_arr_buf, val, vn); }
        else { _agent_round_kind = 0; }        # every call was headerless -> nothing to run this round
    } else {
        _agent_round_kind = 0;
        if ((frames_seen == 0) && (_hoosh_acc_len == 0)) { _agent_empty_stream = 1; }
    }
    return 0;
}

# _agent_finish_workfull (0.44.2): land a turn that ran out of TOOL WORKING SET honestly.
#
# The working set (_agent_work) holds this turn's assistant tool-call echoes and every tool result. It is
# bounded, and a big review turn on a real project can fill it. Before this the buffer just stopped
# accepting bytes: results were cut mid-string, the request body stopped being valid JSON, and the turn
# died looking like a model failure. Now the turn ENDS at the round where the room ran out, keeps whatever
# the model had already said, and names the actual constraint plus the two things that clear it.
#
# Mirrors _agent_finish_interrupted's history discipline: keep a streamed partial (completing the
# user+assistant pair) or pop the unanswered user turn if nothing streamed at all.
fn _agent_finish_workfull(iter) {
    ui_emit(ROLE_RED, "  this turn's tool working set is full");
    ui_emit(ROLE_FAINT, " ("); ofmt_int(_agent_work_len / 1024); ui_emit(ROLE_FAINT, " KB of tool results across ");
    ofmt_int(iter + 1); ui_emit(ROLE_FAINT, " rounds) — stopping here rather than sending a truncated conversation");
    oprintln("");
    ui_emit(ROLE_FAINT, "  ask a narrower follow-up, or /compact to free room, and the answer so far is kept");
    oprintln("");
    if (_hoosh_acc_len > 0) {
        session_history_append("assistant", _hoosh_acc, _hoosh_acc_len);
        citations_attach_to_last(); roundlog_attach_calls_to_last(session_turns());
        reasonlog_record(session_turns(), hoosh_last_reason(), hoosh_last_reason_len());
        sess_persist_save();
    } else { session_history_pop_last(); }
    log_begin("agent_turn"); log_kv_int("iters", iter + 1); log_kv_str("result", "work_full");
    log_kv_int("work_bytes", _agent_work_len); log_commit(SK_WARN);
    return 0;
}

# _agent_finish_interrupted (0.34.1): land an Esc-interrupted turn honestly — KEEP a streamed partial (append it,
# completing the user+assistant pair) or, if nothing streamed this round, POP the unanswered user turn — plus the
# "— interrupted" feed marker and the log line. Shared by the streaming-abort (kind 4) and the new tool-phase abort
# so both leave history a clean sequence of completed exchanges. `iter` is the 0-based iteration (logged as iter+1).
fn _agent_finish_interrupted(iter) {
    if (_hoosh_acc_len > 0) { session_history_append("assistant", _hoosh_acc, _hoosh_acc_len); citations_attach_to_last(); roundlog_attach_calls_to_last(session_turns()); reasonlog_record(session_turns(), hoosh_last_reason(), hoosh_last_reason_len()); sess_persist_save(); }   # 0.35.3: keep the interrupted turn's reasoning fold too
    else { session_history_pop_last(); }
    intr_note();
    log_begin("agent_turn"); log_kv_int("iters", iter + 1); log_kv_str("result", "interrupted"); log_commit(SK_WARN);
    return 0;
}

# agent_turn: drive one free-text turn as an agentic tool-calling loop. Streams
# the model's output (content live, tool_calls assembled from deltas) when
# [hoosh].stream is on — so wiring daimon no longer disables streaming; falls back
# to a blocking round-trip when stream=false. Each tool call is t-ron-gated;
# results loop back until the model answers. Returns 0 on success, negative on
# transport failure, the HTTP status on a non-2xx. Any failure rolls the user turn
# back out of history (completed exchanges only). 0.34.1: Esc cancels mid-round (during
# tool execution / between rounds), not just streaming. I/O — the orchestrator.
fn agent_turn(prompt) {
    var model = _hoosh_model();
    var sys = 0;
    if (seam_status(SEAM_AVATARA) == SEAM_NATIVE) { sys = persona_system_prompt(); }
    # project memory (0.12.0): the second system message, acquired once per turn —
    # the local .thoth/memory reader, or mneme SEMANTIC recall keyed on this turn's
    # prompt when the seam is bound (0.32.2). ADR-0012.
    var mem = 0;
    if (seam_cap_state(SEAM_MEMORY) != CAP_ABSENT) { mem = memory_context(prompt); }
    if (_agent_req == 0) { _agent_req = alloc(AGENT_REQ_CAP); }
    if (_agent_tools_buf == 0) { _agent_tools_buf = alloc(AGENT_TOOLS_CAP); }
    if (_agent_work == 0) { _agent_work = alloc(AGENT_WORK_CAP); }

    # Tool advertisement is session-stable (the daimon endpoint and its registry do
    # not change mid-session), so fetch + parse + serialize it ONCE and reuse the
    # formatted buffer every turn — not a daimon GET + bayan parse + re-serialize per
    # turn. Cache only on success: a transient daimon-down on the first turn leaves
    # _agent_tools_ready=0 so a later turn retries (degraded honestly, never sticky).
    if (_agent_tools_ready == 0) {
        _agent_tools_skipped = 0;                             # 0.44.2: this build's count, not the last one's
        var dtv = 0;                                          # 0.20.0: only fetch daimon's registry when the seam
        if (seam_status(SEAM_DAIMON) != SEAM_ABSENT) { dtv = daimon_tools_value(); }   # is present (shell-standalone: no GET)
        daimon_mem_scan(dtv);                                # 0.32.0: prime the mneme memory-seam cache off this same registry fetch (no extra GET)
        var tl = agent_format_tools(_agent_tools_buf, dtv);
        tl = agent_tools_add_memory(_agent_tools_buf, tl);   # 0.12.2: + memory_write when [memory].enabled
        tl = agent_tools_add_shell(_agent_tools_buf, tl);    # 0.16.0: + shell when [shell].enabled AND POSIX-capable
        tl = agent_tools_add_project(_agent_tools_buf, tl);  # 0.23.0: + read_file/list_dir (default-on, jailed)
        tl = agent_tools_add_edit(_agent_tools_buf, tl);     # 0.31.0: + edit when [edit].enabled (opt-in, jailed+gated)
        tl = agent_tools_add_delegate(_agent_tools_buf, tl); # 0.43.0 (T2-1): + delegate when [subagent].enabled (opt-in, depth-1)
        tl = agent_tools_add_ask(_agent_tools_buf, tl);      # 0.44.0 (T4-1): + ask_user when [ask].enabled (opt-in; blocks on a human)
        _agent_tools_len = tl;
        # Cache ONLY on a good daimon fetch (or no daimon). 0.23.0: the always-on project tools make tl>0
        # unconditionally, so `tl>0` can no longer stand in for "daimon fetch succeeded" — a transient
        # daimon-down would latch an empty registry forever. Gate on the daimon fetch (dtv) so a daimon-down
        # first turn leaves _agent_tools_ready=0 and a later turn retries (the documented self-heal above).
        if ((seam_status(SEAM_DAIMON) == SEAM_ABSENT) || (dtv != 0)) { _agent_tools_ready = 1; }
        # 0.44.2: a registry too big for AGENT_TOOLS_CAP now yields a SHORTER but VALID advertisement (it
        # used to yield a malformed one). Say which way it went — the model cannot report a tool it was
        # never told about, so silence here reads as "the agent refuses to use my MCP server".
        if (_agent_tools_skipped > 0) {
            ui_emit(ROLE_RED, "  tool advertisement full");
            ui_emit(ROLE_FAINT, " — "); ofmt_int(_agent_tools_skipped);
            ui_emit(ROLE_FAINT, " tool(s) not advertised this session (registry exceeds ");
            ofmt_int(AGENT_TOOLS_CAP); ui_emit(ROLE_FAINT, " bytes)");
            oprintln("");
            log_begin("tools_truncated"); log_kv_int("skipped", _agent_tools_skipped); log_commit(SK_WARN);
        }
    }
    var tools_len = _agent_tools_len;
    var want_stream = config_hoosh_stream();
    session_history_append("user", prompt, strlen(prompt));
    # 0.36.4: recap the history this turn's builds will skip. AFTER the user append (the skip boundary must include
    # this prompt, or `covers` would never match the framer's `start` and the recap would silently never inject) and
    # ONCE per turn, before the loop — the rounds re-frame the same history, and this must never land mid-round.
    hoosh_recap_ensure(AGENT_REQ_CAP - AGENT_WORK_CAP - AGENT_TOOLS_CAP);
    _agent_work_reset();
    intr_reset();      # 0.17.4: clear any stale Esc-interrupt flag at the start of the turn
    ask_turn_reset();  # 0.44.0 (T4-1): a fresh question budget per turn (session totals survive; /reset clears them)
    subagent_turn_reset();  # 0.44.1: clear the same-task delegation guard — repeating a task in a LATER turn is a
                            # new request, not a loop (see src/subagent.cyr)

    ui_emit(ROLE_FAINT, "  -> hoosh ("); ui_emit(ROLE_ACCENT, model); ui_emit(ROLE_FAINT, ", agentic");
    if (want_stream == 1) { ui_emit(ROLE_FAINT, ", stream"); }
    ui_emit(ROLE_FAINT, ", "); ofmt_int(tools_len); ui_emit(ROLE_FAINT, " tool-bytes) "); oprintln(_hoosh_endpoint_url());

    var iter = 0;
    var done = 0;
    var round_no = 0;
    var budget_stop = 0;                           # 0.44.3: the turn ended on a [budget] ceiling, not on max_iters
    var max_iters = config_hoosh_max_iters();      # 0.40.0 (T1-2): configurable, read per turn so /reload lands
    # 0.44.2: the SESSION LOG's opening record for this turn. `--logs` exists so a run that never reaches
    # its answer still explains itself, and the first thing anyone reads back is "what was it asked to
    # do" — so the prompt goes down BEFORE the first request leaves, not after a turn that may not land.
    log_begin("turn_start"); log_kv_int("turn", session_turns()); log_kv_str("model", model);
    log_kv_int("max_iters", max_iters); log_kv_int("tool_bytes", tools_len); log_commit(SK_INFO);
    log_text("task", "text", prompt, strlen(prompt));
    # 0.44.3 — CHECK BEFORE THE CALL. `[budget]` bounds SPEND, and `max_iters` never could: it bounds
    # rounds, and one round over a 200 KB context costs what forty small ones do.
    # This entry check is the SECOND line, not the first: `_task_dispatch` already refused the turn if
    # the ceiling was met, and it has to, because a plain (`[hoosh].tools = false`) turn never reaches
    # this loop at all. It is kept because it costs one comparison and because a future caller of
    # agent_turn that does not come through the chokepoint must still be bounded.
    if (budget_block() == 1) { budget_stop = 1; done = 1; }
    while ((done == 0) && (iter < max_iters)) {
        _hoosh_acc_reset();
        _agent_empty_stream = 0;
        # 0.44.2: one line per round BEFORE the request goes out. A hang leaves the last `round` line as
        # the marker of exactly where it stopped — which round, and whether a reply or a tool ever came
        # back — and that is the single most useful fact in a post-mortem of a turn that never returned.
        log_begin("round"); log_kv_int("turn", session_turns()); log_kv_int("iter", iter + 1);
        log_kv_int("work_bytes", _agent_work_len);
        if (want_stream == 1) { log_kv_str("mode", "stream"); } else { log_kv_str("mode", "block"); }
        log_commit(SK_DEBUG);
        if (want_stream == 1) { _agent_iter_stream(model, sys, mem, _agent_tools_buf, tools_len); }
        else { _agent_iter_block(model, sys, mem, _agent_tools_buf, tools_len); }
        # 0.17.4: a SINGLE if/elif chain — exactly one arm runs. (Was three bare `if`s; k==2/k==3
        # returned so they never fell through, but the new non-returning k==4 arm MUST NOT fall into
        # the k==1/else block below, or it would double-append / double-pop history.)
        var k = _agent_round_kind;
        if (k == 2) { hoosh_health_mark_down(); }     # 0.19.3: a round's transport failure -> spine DOWN
        elif (k != 4) { hoosh_health_mark_up(); }     # any answered round (tool/http/final) -> UP; k==4 (Esc) neutral
        if (k == 2) {
            session_history_pop_last();
            log_begin("agent_turn"); log_kv_str("result", "transport_error"); log_commit(SK_WARN);
            return 0 - 1;
        } elif (k == 3) {
            session_history_pop_last();
            log_begin("agent_turn"); log_kv_str("result", "http_error"); log_kv_int("status", _agent_round_status); log_commit(SK_WARN);
            return _agent_round_status;
        } elif (k == 4) {
            # Esc interrupted the STREAM. KEEP the partial (append it, completing the user+assistant pair) or, if
            # nothing streamed, pop the unanswered user turn; mark it; end the loop. Deliberately UNLIKE max-iters
            # (below), which clears _hoosh_acc — the user asked to stop and see what came so far, and interrupt is
            # TUI-only so one-shot's exit code is moot.
            _agent_finish_interrupted(iter);
            done = 1;
        } elif (k == 1) {
            var raw = _agent_round_raw;
            if (raw == 0) { raw = "[]"; }
            # 0.44.2: the echo is refused rather than truncated when the working set is out of room. Stop
            # the turn HERE — half an assistant tool_calls array is not a conversation, and sending one
            # produces exactly the silent "response had neither tool calls nor content" this release exists
            # to remove.
            if (_agent_add_assistant(raw) == 0) { _agent_finish_workfull(iter); done = 1; }
            else {
            round_no = round_no + 1;
            roundlog_open(session_turns(), round_no);
            # 0.34.1: cancel mid-round. Arm the Esc-poll around the (possibly long) tool phase so a keystroke during
            # tool execution is caught between calls (_agent_run_calls_serial polls intr_check; the confirm's cooked
            # read is bracketed by intr_suspend/resume in the TUI confirm hooks). TUI-only (intr_arm no-ops off
            # OUT_RING), so the floor is byte-identical. After the tools, an Esc stops before the next model request.
            intr_arm();
            _agent_run_calls(_agent_round_val, _agent_round_n);
            intr_check();                     # 0.34.1: final drain BEFORE disarm — catch an Esc pressed during the LAST/only tool call (the serial poll runs before each call, not after the last)
            intr_disarm();
            if (intr_pending() == 1) { _agent_finish_interrupted(iter); done = 1; }
            elif (_agent_work_full == 1) { _agent_finish_workfull(iter); done = 1; }   # 0.44.2: results were dropped — stop before the next round asks for more
            }
        } else {
            if (_hoosh_acc_len > 0) { session_history_append("assistant", _hoosh_acc, _hoosh_acc_len); citations_attach_to_last(); roundlog_attach_calls_to_last(session_turns()); reasonlog_record(session_turns(), hoosh_last_reason(), hoosh_last_reason_len()); sess_persist_save(); grounding_emit(); }   # 0.32.4: grounding line (silent if no recall); 0.33.4: persist cited sources; 0.33.5: persist tool calls; 0.35.3: persist this turn's reasoning for the landed fold
            elif (_agent_empty_stream == 1) {
                # The gateway ACCEPTED the request (HTTP 200) and streamed nothing at all. Name that as
                # the gateway's fault, and point at the one place the reason actually exists.
                ui_emit(ROLE_RED, "  hoosh returned an EMPTY stream");
                ui_emit(ROLE_FAINT, " — HTTP 200, no content, no tool calls, not one frame.");
                oprintln("");
                ui_emit(ROLE_FAINT, "  the gateway accepted the request and produced nothing, so the reason is on ITS side, not the model's:");
                oprintln("");
                ui_emit(ROLE_FAINT, "  check the hoosh log (an upstream provider error is not forwarded to this stream).");
                oprintln("");
                session_history_pop_last();
                log_begin("agent_turn"); log_kv_int("iters", iter + 1); log_kv_str("result", "empty_stream"); log_commit(SK_ERROR);
            }
            else { oprintln("  hoosh: response had neither tool calls nor content."); session_history_pop_last(); }
            done = 1;
            log_begin("agent_turn"); log_kv_int("iters", iter + 1); log_kv_str("result", "ok"); log_commit(SK_INFO);
            log_text("reply", "text", _hoosh_acc, _hoosh_acc_len);   # 0.44.2: the answer itself, so the log is a transcript and not just a trace
        }
        iter = iter + 1;
        # 0.44.3: re-check between rounds. The round just completed is the one that may have crossed the
        # ceiling, and the next one is the spend this stops. Only when the turn is still running — a turn
        # that already has its answer must not be rewritten into a budget failure after the fact.
        if (done == 0) {
            if (budget_block() == 1) { budget_stop = 1; done = 1; }
        }
    }
    if (budget_stop == 1) {
        # Same cleanup as the max_iters path, and for the same reason: no FINAL answer was produced, so
        # the dangling user message is popped and the accumulator cleared (a one-shot run must exit
        # nonzero rather than print the last round's interim narration as if it were the answer).
        session_history_pop_last();
        _hoosh_acc_reset();
        log_begin("agent_turn"); log_kv_int("iters", iter); log_kv_str("result", "budget"); log_commit(SK_WARN);
    }
    if ((done == 0) && (budget_stop == 0)) {
        # 0.40.0 (T1-2): name the cap and how to raise it. A bare "hit the iteration cap" tells the user
        # nothing actionable — and thoth has been bitten by exactly that: the 0.38.5 tool-argument bug
        # presented as this message every time, with no hint that the ceiling was 8 or that it moves.
        ui_emit(ROLE_RED, "  agentic loop hit the iteration cap");
        ui_emit(ROLE_FAINT, " ("); ofmt_int(max_iters); ui_emit(ROLE_FAINT, " rounds, no final answer)");
        oprintln("");
        ui_emit(ROLE_FAINT, "  raise it with [hoosh].max_iters (ceiling ");
        ofmt_int(HOOSH_MAX_ITERS_CEILING); ui_emit(ROLE_FAINT, ") — each round is a full model call");
        oprintln("");
        session_history_pop_last();
        # No FINAL answer was produced — clear the reply accumulator so a one-shot run
        # reports failure (exit nonzero) instead of printing the last capped round's
        # interim narration as if it were the answer (the streaming path appends content
        # even on a tool-call round). The interactive REPL is unaffected (it ignores this
        # return and the narration already streamed live). 0.11.0.
        _hoosh_acc_reset();
        log_begin("agent_turn"); log_kv_int("iters", iter); log_kv_str("result", "max_iters"); log_commit(SK_WARN);
    }
    return 0;
}
