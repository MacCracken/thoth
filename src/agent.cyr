# thoth — the model-driven agentic tool-calling loop (0.6.0).
#
# This is the payoff of the M4 tool spine: a free-text turn becomes a LOOP. thoth
# advertises daimon's MCP tools to hoosh; the backing model decides which to call;
# thoth executes each through daimon — every call gated by t-ron — feeds the
# results back as {role:tool} messages, and repeats until the model answers with
# plain content. thoth owns none of the moving parts: hoosh decides, daimon
# executes, bote is the protocol, t-ron authorizes. thoth only drives the loop.
#
# Engages when the daimon seam is wired AND [hoosh].tools is on (the default);
# otherwise free-text turns fall back to the plain hoosh_send path. Agentic turns
# are NON-streaming — the full response must be parsed for tool_calls before the
# next step. Standard OpenAI tool-calling contract (hoosh normalizes every
# provider to it): request `tools`, response `choices[0].message.tool_calls`,
# each `{id, function:{name, arguments}}`; results returned as
# {role:tool, tool_call_id, content}.

var AGENT_MAX_ITERS = 8;
var _agent_req = 0;
var AGENT_REQ_CAP = 524288;
var _agent_tools_buf = 0;
var AGENT_TOOLS_CAP = 32768;
var _agent_tools_len = 0;     # cached serialized-tools byte length (session-stable)
var _agent_tools_ready = 0;   # 1 once the registry was fetched + formatted at least once

# agent_tools_cache_reset: drop the cached tool advertisement so the next turn re-fetches + re-serializes it.
# Used by /reload (0.24.4) so a mid-session config change to [shell].enabled / [hoosh].tools (or a now-reachable
# daimon) re-advertises the right tools; otherwise the session-stable cache would keep the startup set.
fn agent_tools_cache_reset() {
    _agent_tools_ready = 0;
    _agent_tools_len = 0;
    return 0;
}

# The working buffer holds THIS turn's tool-round messages (assistant-with-
# tool_calls + tool results) as raw comma-joined JSON objects. The persisted
# conversation (session history) supplies the user turn and prior exchanges; the
# tool rounds are ephemeral — only the user turn and the final answer enter
# history. Bounded; appends past the cap are dropped.
var _agent_work = 0;
var AGENT_WORK_CAP = 131072;
var _agent_work_len = 0;

fn _agent_work_reset() { _agent_work_len = 0; return 0; }
fn _agent_work_putc(c) {
    if (_agent_work_len < (AGENT_WORK_CAP - 1)) { store8(_agent_work + _agent_work_len, c); _agent_work_len = _agent_work_len + 1; }
    return 0;
}
fn _agent_work_puts(s) {
    var i = 0;
    while (load8(s + i) != 0) { _agent_work_putc(load8(s + i)); i = i + 1; }
    return 0;
}
# _agent_work_puts_esc: append s as a JSON string body (bounded, escaped).
fn _agent_work_puts_esc(s) {
    var i = 0;
    while (load8(s + i) != 0) {
        if (_agent_work_len >= (AGENT_WORK_CAP - 8)) { return 0; }
        var c = load8(s + i);
        if (c == 34) { _agent_work_putc(92); _agent_work_putc(34); }
        elif (c == 92) { _agent_work_putc(92); _agent_work_putc(92); }
        elif (c == 10) { _agent_work_putc(92); _agent_work_putc(110); }
        elif (c == 13) { _agent_work_putc(92); _agent_work_putc(114); }
        elif (c == 9) { _agent_work_putc(92); _agent_work_putc(116); }
        elif (c < 32) {
            _agent_work_putc(92); _agent_work_putc(117); _agent_work_putc(48); _agent_work_putc(48);
            _agent_work_putc(_hoosh_hex_digit(c / 16));
            _agent_work_putc(_hoosh_hex_digit(c - (c / 16) * 16));
        } else { _agent_work_putc(c); }
        i = i + 1;
    }
    return 0;
}
fn _agent_work_sep() { if (_agent_work_len > 0) { _agent_work_putc(44); } return 0; }   # comma

# Append the assistant message that carries the model's tool_calls, verbatim
# (raw_tcs is the already-valid JSON array text from the response).
fn _agent_add_assistant(raw_tcs) {
    _agent_work_sep();
    _agent_work_puts("{\"role\":\"assistant\",\"content\":null,\"tool_calls\":");
    _agent_work_puts(raw_tcs);
    _agent_work_puts("}");
    return 0;
}
# Append a tool-result message for a given tool_call id.
fn _agent_add_result(id, text) {
    _agent_work_sep();
    _agent_work_puts("{\"role\":\"tool\",\"tool_call_id\":\"");
    if (id != 0) { _agent_work_puts_esc(id); }
    _agent_work_puts("\",\"content\":\"");
    if (text != 0) { _agent_work_puts_esc(text); }
    _agent_work_puts("\"}");
    return 0;
}

# agent_format_tools: serialize a daimon tools array value into an OpenAI `tools`
# array (NUL-terminated) in dst; return the byte length, or 0 if no tools. daimon
# gives {name, description, inputSchema}; we wrap each as a function tool, passing
# the tool's `inputSchema` (a JSON Schema object) through verbatim as
# `function.parameters` so the model sees real argument shapes. daimon 1.2.7
# (issue 2026-06-11-mcp-manifest-omits-tool-input-schema) emits `inputSchema` per
# tool in GET /v1/mcp/tools; earlier daimon omitted it. A tool with no/empty schema
# (builtins) falls back to the permissive `{"type":"object"}`. Pure.
fn agent_format_tools(dst, tools_arr) {
    if (tools_arr == 0) { return 0; }
    var n = bayan_json_v_arr_len(tools_arr);
    if (n == 0) { return 0; }
    # dst is _agent_tools_buf (AGENT_TOOLS_CAP). name/description/inputSchema come
    # from the daimon (MCP) registry — semi-trusted, not length-bounded — so every
    # write is clamped to the cap. A per-tool headroom guard stops adding tools once
    # near the cap, so an over-large registry yields a SHORTER but VALID tools array
    # rather than a half-written element or a buffer overrun.
    var cap = AGENT_TOOLS_CAP;
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "[");
    var i = 0;
    var done = 0;
    while ((i < n) && (done == 0)) {
        if (off > (cap - 256)) { done = 1; }
        else {
            if (i > 0) { off = _append_cstr_cap(dst, off, cap, ","); }
            var t = bayan_json_v_arr_get(tools_arr, i);
            off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"");
            var nm = bayan_json_v_obj_get(t, "name");
            if (nm != 0) { var nms = bayan_json_v_str(nm); if (nms != 0) { off = _json_escape_into_cap(dst, off, cap, str_cstr(nms)); } }
            off = _append_cstr_cap(dst, off, cap, "\",\"description\":\"");
            var ds = bayan_json_v_obj_get(t, "description");
            if (ds != 0) { var dss = bayan_json_v_str(ds); if (dss != 0) { off = _json_escape_into_cap(dst, off, cap, str_cstr(dss)); } }
            # Pass daimon's per-tool inputSchema through verbatim as the OpenAI
            # `parameters` (it is already a JSON object); fall back to a permissive
            # object schema when a tool advertises none.
            off = _append_cstr_cap(dst, off, cap, "\",\"parameters\":");
            var sc = bayan_json_v_obj_get(t, "inputSchema");
            if ((sc != 0) && (bayan_json_v_is_obj(sc) == 1)) {
                var scs = bayan_json_v_build(sc);
                if (scs != 0) { off = _append_cstr_cap(dst, off, cap, str_cstr(scs)); }
                else { off = _append_cstr_cap(dst, off, cap, "{\"type\":\"object\"}"); }
            } else {
                off = _append_cstr_cap(dst, off, cap, "{\"type\":\"object\"}");
            }
            off = _append_cstr_cap(dst, off, cap, "}}");
            i = i + 1;
        }
    }
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_memory: append the thoth-native memory_write tool to the daimon
# tools array in dst (0.12.2). tl == the current array length ("[...]" or 0 for an
# empty registry). Advertised only when the memory seam is not absent (i.e.
# [memory].enabled) — so the model can save durable facts to .thoth/memory during
# an agentic turn. Executed LOCALLY + t-ron-gated (thoth_remember) in
# _agent_run_calls_serial — never forwarded to daimon. ADR-0012.
fn agent_tools_add_memory(dst, tl) {
    if (seam_cap_state(SEAM_MEMORY) == CAP_ABSENT) { return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"memory_write\",\"description\":\"Save a durable fact about THIS project to local memory (.thoth/memory) so it persists across sessions. Use for decisions, conventions, or context worth remembering; keep each fact to one line.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"the fact to remember, one line\"}},\"required\":[\"text\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_shell: append the thoth-native `shell` tool to the daimon tools array in dst
# (0.16.0, ADR-0014). Advertised ONLY when opt-in [shell].enabled AND the target can capture a shell
# (shell_supported() — POSIX only; AGNOS/Windows have no capturing /bin/sh, announced not faked). When
# off / unsupported this returns tl UNCHANGED — the whole byte-identical-floor proof for the advertise
# side (no round can then name "shell"). Executed LOCALLY + t-ron-gated (thoth_shell) in
# _agent_run_calls_serial — never forwarded to daimon. Same shape as agent_tools_add_memory.
fn agent_tools_add_shell(dst, tl) {
    if (config_shell_enabled() == 0) { return tl; }
    if (shell_supported() == 0) { return tl; }
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"shell\",\"description\":\"Run a shell command on the local machine (/bin/sh -c) and return its combined stdout+stderr and exit code. Use for build/test/git/file inspection in THIS project. One command per call; it runs with a wall-clock timeout and bounded output, cannot read stdin, and may be refused by policy.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"the shell command line to execute\"}},\"required\":[\"command\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_project: append the thoth-native read_file + list_dir tools to the array in dst (0.23.0,
# ADR-0015). Advertised whenever the agentic loop runs (the call site is reached only when agent_enabled) —
# DEFAULT-ON, so the agent can see the codebase it was launched in. Executed LOCALLY + jailed to the launch
# cwd, plus any user-granted read roots (0.23.1: /allow, [project].read_roots — no t-ron gate, the jail +
# the user's explicit grant are the boundary) in _agent_run_calls_serial. Same shape as agent_tools_add_shell;
# adds TWO tools.
fn agent_tools_add_project(dst, tl) {
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"description\":\"Read a text file and return its contents. Give a path relative to THIS project's root, or an absolute path inside a directory the user has granted read access to. Reads outside those (and any '..') are refused. Use to inspect the code you are working in.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root, or an absolute path under a user-granted root\"}},\"required\":[\"path\"]}}}");
    off = _append_cstr_cap(dst, off, cap, ",");
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"list_dir\",\"description\":\"List a directory (files, and subdirectories suffixed with '/'). Give a path relative to THIS project's root (defaults to the root), or an absolute path inside a user-granted root. Use to explore the code structure.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root, or an absolute path under a user-granted root (optional; defaults to the root)\"}}}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_tools_add_edit: append the model-invokable `edit` tool (0.31.0, ADR-0017) — OPT-IN, advertised only when
# [edit].enabled, so an unconfigured session never even offers it (advertise-gate ⇔ dispatch-gate lockstep).
# Surgical semantics: it replaces the UNIQUE occurrence of old_string; a non-unique/absent match is refused.
fn agent_tools_add_edit(dst, tl) {
    if (config_edit_enabled() == 0) { return tl; }         # off by default; keep in lockstep with the dispatch guard
    var cap = AGENT_TOOLS_CAP;
    var off = tl;
    if (tl == 0) { off = _append_cstr_cap(dst, off, cap, "["); }
    else { off = tl - 1; off = _append_cstr_cap(dst, off, cap, ","); }   # back over the trailing "]"
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"edit\",\"description\":\"Edit an EXISTING text file in THIS project by replacing an exact snippet. Give 'path' relative to the project root (absolute paths, '~' and '..' are refused; writes stay inside the project). 'old_string' must appear EXACTLY ONCE in the file - include enough surrounding lines to make it unique, or the edit is refused. 'new_string' replaces it (use an empty string to delete). Preserve exact indentation/whitespace. This applies the change to disk.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root\"},\"old_string\":{\"type\":\"string\",\"description\":\"the exact text to replace; must be unique in the file\"},\"new_string\":{\"type\":\"string\",\"description\":\"the replacement text (empty to delete the old text)\"}},\"required\":[\"path\",\"old_string\",\"new_string\"]}}}");
    off = _append_cstr_cap(dst, off, cap, ",");
    off = _append_cstr_cap(dst, off, cap, "{\"type\":\"function\",\"function\":{\"name\":\"create_file\",\"description\":\"Create a NEW text file in THIS project with the given content. Give 'path' relative to the project root (absolute paths, '~' and '..' are refused). REFUSES if the file already exists - use edit to modify an existing file. Writes the content verbatim to disk.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"path relative to the project root; must not already exist\"},\"content\":{\"type\":\"string\",\"description\":\"the full text content of the new file\"}},\"required\":[\"path\",\"content\"]}}}");
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# _agent_copy: raw-copy n bytes of src into dst at off, bounded by cap. Pure.
fn _agent_copy(dst, off, src, n, cap) {
    var i = 0;
    while ((i < n) && (off < (cap - 1))) { store8(dst + off, load8(src + i)); off = off + 1; i = i + 1; }
    return off;
}

# agent_build_request: assemble the chat request — system + budgeted history +
# this turn's working tool-rounds, plus the advertised tools. NUL-terminated;
# returns the byte length. Non-streaming (tool_calls must be parsed whole).
fn agent_build_request(dst, model, system, mem, tools_buf, tools_len, stream) {
    var cap = AGENT_REQ_CAP;
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "{\"model\":\"");
    off = _json_escape_into_cap(dst, off, cap, model);
    off = _append_cstr_cap(dst, off, cap, "\",\"messages\":[");
    var wrote = 0;
    if ((system != 0) && (load8(system) != 0)) { off = _hoosh_emit_msg_cap(dst, off, cap, "system", system); wrote = 1; }
    # project memory (0.12.0): second system message after the persona, before
    # history + tool-rounds. Off/absent -> mem is 0 -> omitted. ADR-0012.
    if ((mem != 0) && (load8(mem) != 0)) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, "system", mem);
        wrote = 1;
    }
    var total = session_history_len();
    # Budget history against the room left AFTER this turn's working tool-rounds
    # (_agent_work) and the advertised tools, so history + work + tools cannot
    # collectively approach the cap. _hoosh_history_start takes a tenth of its arg
    # as the raw-content budget (leaving headroom for ~6x JSON escaping).
    var hist_cap = AGENT_REQ_CAP - AGENT_WORK_CAP - AGENT_TOOLS_CAP;
    var start = _hoosh_history_start(hist_cap);
    var i = start;
    while (i < total) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _hoosh_emit_msg_cap(dst, off, cap, session_history_role(i), session_history_content(i));
        wrote = 1;
        i = i + 1;
    }
    if (_agent_work_len > 0) {
        if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
        off = _agent_copy(dst, off, _agent_work, _agent_work_len, AGENT_REQ_CAP);
        wrote = 1;
    }
    off = _append_cstr_cap(dst, off, cap, "]");
    if (tools_len > 0) {
        off = _append_cstr_cap(dst, off, cap, ",\"tools\":");
        off = _agent_copy(dst, off, tools_buf, tools_len, AGENT_REQ_CAP);
    }
    off = _append_cstr_cap(dst, off, cap, ",\"max_tokens\":");
    off = _append_int(dst, off, HOOSH_MAX_TOKENS);
    if (stream == 1) { off = _append_cstr_cap(dst, off, cap, ",\"stream\":true,\"stream_options\":{\"include_usage\":true}}"); }
    else { off = _append_cstr_cap(dst, off, cap, ",\"stream\":false}"); }
    store8(dst + off, 0);
    return off;
}

# agent_tool_calls: the choices[0].message.tool_calls array value, or 0. Pure.
fn agent_tool_calls(body, len) {
    var v = bayan_json_v_parse_str(body, len);
    if (v == 0) { return 0; }
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 0; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { return 0; }
    var msg = bayan_json_v_obj_get(first, "message");
    if (msg == 0) { return 0; }
    return bayan_json_v_obj_get(msg, "tool_calls");
}
fn agent_tc_count(tcs) { if (tcs == 0) { return 0; } return bayan_json_v_arr_len(tcs); }
fn _agent_tc_str(tcs, i, key) {
    var e = bayan_json_v_arr_get(tcs, i);
    if (e == 0) { return 0; }
    var v = bayan_json_v_obj_get(e, key);
    if (v == 0) { return 0; }
    var s = bayan_json_v_str(v);
    if (s == 0) { return 0; }
    return str_cstr(s);
}
fn agent_tc_id(tcs, i) { return _agent_tc_str(tcs, i, "id"); }
fn _agent_tc_fn_str(tcs, i, key) {
    var e = bayan_json_v_arr_get(tcs, i);
    if (e == 0) { return 0; }
    var f = bayan_json_v_obj_get(e, "function");
    if (f == 0) { return 0; }
    var v = bayan_json_v_obj_get(f, key);
    if (v == 0) { return 0; }
    var s = bayan_json_v_str(v);
    if (s == 0) { return 0; }
    return str_cstr(s);
}
fn agent_tc_name(tcs, i) { return _agent_tc_fn_str(tcs, i, "name"); }
fn agent_tc_args(tcs, i) { return _agent_tc_fn_str(tcs, i, "arguments"); }

# _agent_match: 1 if the NUL-terminated literal `lit` matches bytes at p. Pure.
fn _agent_match(p, lit) {
    var k = 0;
    while (load8(lit + k) != 0) {
        if (load8(p + k) != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# _agent_raw_tool_calls: extract the raw "tool_calls":[...] array text as a
# NUL-terminated cstr (for echoing the assistant message back verbatim), or 0.
# Balanced-bracket scan that skips over JSON strings. Pure.
fn _agent_raw_tool_calls(body, len) {
    var i = 0;
    var result = 0;
    while (((i + 13) < len) && (result == 0)) {
        if (_agent_match(body + i, "\"tool_calls\":") == 1) {
            var j = i + 13;
            while ((j < len) && (load8(body + j) == 32)) { j = j + 1; }
            if ((j < len) && (load8(body + j) == 91)) {
                var depth = 1;
                var start = j;
                j = j + 1;
                while ((j < len) && (depth > 0)) {
                    var ch = load8(body + j);
                    if (ch == 34) {
                        j = j + 1;
                        var instr = 1;
                        while ((j < len) && (instr == 1)) {
                            var sc = load8(body + j);
                            if (sc == 92) { j = j + 2; }
                            elif (sc == 34) { instr = 0; j = j + 1; }
                            else { j = j + 1; }
                        }
                    } else {
                        if (ch == 91) { depth = depth + 1; }
                        if (ch == 93) { depth = depth - 1; }
                        j = j + 1;
                    }
                }
                var slen = j - start;
                if (slen > 2) {
                    var out = alloc(slen + 1);
                    memcpy(out, body + start, slen);
                    store8(out + slen, 0);
                    result = out;
                }
            }
        }
        i = i + 1;
    }
    return result;
}

# --- streamed tool_call assembly (0.6.1) ---
#
# In streaming mode the model's tool_calls arrive as SSE delta fragments: the
# first frame for an index carries {index, id, function.name}, then `arguments`
# streams in pieces across later frames, concatenated by index. We accumulate
# into fixed per-index slots, then reconstruct the same tool_calls array text the
# non-streaming path gets — so execution + the assistant echo reuse one code path.
var AGENT_MAX_CALLS = 8;
var AG_ID_CAP = 96;
var AG_NAME_CAP = 96;
var AG_ARGS_CAP = 16384;
var _ag_ids = 0;
var _ag_names = 0;
var _ag_args = 0;
var _ag_args_len = 0;        # AGENT_MAX_CALLS i64 slots
var _ag_seen = 0;            # AGENT_MAX_CALLS byte flags
var _ag_max = 0;            # highest index+1 observed this round
var _agent_arr_buf = 0;     # reconstructed tool_calls array text
var AGENT_ARR_CAP = 131072;

fn _ag_alloc() {
    if (_ag_ids == 0) {
        _ag_ids = alloc(AGENT_MAX_CALLS * AG_ID_CAP);
        _ag_names = alloc(AGENT_MAX_CALLS * AG_NAME_CAP);
        _ag_args = alloc(AGENT_MAX_CALLS * AG_ARGS_CAP);
        _ag_args_len = alloc(AGENT_MAX_CALLS * 8);
        _ag_seen = alloc(AGENT_MAX_CALLS);
        _agent_arr_buf = alloc(AGENT_ARR_CAP);
    }
    return 0;
}
fn _ag_reset() {
    _ag_alloc();
    _ag_max = 0;
    var i = 0;
    while (i < AGENT_MAX_CALLS) {
        store8(_ag_seen + i, 0);
        store64(_ag_args_len + (i * 8), 0);
        store8(_ag_ids + (i * AG_ID_CAP), 0);
        store8(_ag_names + (i * AG_NAME_CAP), 0);
        store8(_ag_args + (i * AG_ARGS_CAP), 0);
        i = i + 1;
    }
    return 0;
}
# _ag_copy_str: copy a Str into a bounded NUL-terminated cstr buffer.
fn _ag_copy_str(dst, cap, s) {
    var n = str_len(s);
    if (n > (cap - 1)) { n = cap - 1; }
    if (n > 0) { memcpy(dst, str_data(s), n); }
    store8(dst + n, 0);
    return 0;
}
# _ag_append_args: append a Str fragment to slot idx's arguments buffer.
fn _ag_append_args(idx, s) {
    var base = _ag_args + (idx * AG_ARGS_CAP);
    var cur = load64(_ag_args_len + (idx * 8));
    var n = str_len(s);
    var room = AG_ARGS_CAP - 1 - cur;
    if (n > room) { n = room; }
    if (n > 0) {
        memcpy(base + cur, str_data(s), n);
        cur = cur + n;
        store64(_ag_args_len + (idx * 8), cur);
        store8(base + cur, 0);
    }
    return 0;
}
# _agent_accum_delta: fold one streamed tool_call delta element into the slots.
fn _agent_accum_delta(e) {
    var idx = 0;
    var idxv = bayan_json_v_obj_get(e, "index");
    if (idxv != 0) { idx = bayan_json_v_int(idxv); }
    if ((idx < 0) || (idx >= AGENT_MAX_CALLS)) { return 0; }
    if ((idx + 1) > _ag_max) { _ag_max = idx + 1; }
    store8(_ag_seen + idx, 1);
    var idv = bayan_json_v_obj_get(e, "id");
    if (idv != 0) { var s = bayan_json_v_str(idv); if (s != 0) { _ag_copy_str(_ag_ids + (idx * AG_ID_CAP), AG_ID_CAP, s); } }
    var fnv = bayan_json_v_obj_get(e, "function");
    if (fnv != 0) {
        var nmv = bayan_json_v_obj_get(fnv, "name");
        if (nmv != 0) { var ns = bayan_json_v_str(nmv); if (ns != 0) { _ag_copy_str(_ag_names + (idx * AG_NAME_CAP), AG_NAME_CAP, ns); } }
        var arv = bayan_json_v_obj_get(fnv, "arguments");
        if (arv != 0) { var as = bayan_json_v_str(arv); if (as != 0) { _ag_append_args(idx, as); } }
    }
    return 0;
}
# _ag_build_array: reconstruct the tool_calls array text from the slots into dst
# (NUL-terminated); return the length. `arguments` is emitted as an escaped JSON
# string (the accumulated value is raw JSON). Mirrors the non-streaming raw shape.
# dst is _agent_arr_buf (AGENT_ARR_CAP). The id/name/arguments come from the
# model's streamed deltas (up to AGENT_MAX_CALLS slots, each arguments up to
# AG_ARGS_CAP-1 raw bytes that escape up to ~6x) — bounding every write to the cap
# stops an adversarial round of 8 max-size calls from overflowing the buffer; the
# reconstructed array truncates in-buffer (and bayan rejects a clipped element)
# instead of corrupting the bump heap.
fn _ag_build_array(dst) {
    var cap = AGENT_ARR_CAP;
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "[");
    var wrote = 0;
    var i = 0;
    while (i < _ag_max) {
        if (load8(_ag_seen + i) == 1) {
            if (wrote == 1) { off = _append_cstr_cap(dst, off, cap, ","); }
            off = _append_cstr_cap(dst, off, cap, "{\"id\":\"");
            off = _json_escape_into_cap(dst, off, cap, _ag_ids + (i * AG_ID_CAP));
            off = _append_cstr_cap(dst, off, cap, "\",\"type\":\"function\",\"function\":{\"name\":\"");
            off = _json_escape_into_cap(dst, off, cap, _ag_names + (i * AG_NAME_CAP));
            off = _append_cstr_cap(dst, off, cap, "\",\"arguments\":\"");
            off = _json_escape_into_cap(dst, off, cap, _ag_args + (i * AG_ARGS_CAP));
            off = _append_cstr_cap(dst, off, cap, "\"}}");
            wrote = 1;
        }
        i = i + 1;
    }
    off = _append_cstr_cap(dst, off, cap, "]");
    store8(dst + off, 0);
    return off;
}

# agent_enabled: 1 if a free-text turn should use the agentic loop. [hoosh].tools is the master switch
# (it advertises the tools array to hoosh); the TOOL SOURCE is daimon OR the thoth-native shell tool. 0.20.0
# relaxes the old daimon-only gate: `[shell].enabled` (POSIX-capable) enters the loop WITHOUT daimon, so the
# shell tool is usable standalone (memory-only standalone stays off by design — this cut targets the shell).
# Else the caller uses the plain hoosh_send path.
fn agent_enabled() {
    if (config_hoosh_tools() == 0) { return 0; }                          # master agentic switch
    return 1;   # 0.23.0: read_file/list_dir are ALWAYS-available local tools (default-on, jailed), so the
                # agentic loop always has a tool source — the agent can see the project even with no daimon
                # and no shell. daimon (its MCP registry) and shell just ADD more tools when present.
}

# --- parallel tool execution (0.7.0) ---
#
# A round's tool calls fan out across OS threads (lib/thread.cyr). This was held
# at the stdlib floor until cyrius 6.2.40 made the transport reentrant: sandhi
# 1.6.13 lifts its per-dispatch state into an arena-threaded request context, and
# bayan 1.0.3 makes the JSON value parser key off a per-call state struct (nodes
# still parse through the thread-safe global bump). thoth's piece is the PHASING
# that keeps the security path serial while only the network invoke is concurrent:
#
#   Phase 1 (serial, main thread): snapshot each call's {id,name,args} into stable
#     per-slot buffers, print the tool-call line, and run the t-ron gate. Gating
#     MUST stay serial — it may interactively confirm, and t-ron's libro audit
#     chain is an ordered, hash-linked record; concurrent appends would scramble it.
#   Phase 2 (concurrent): each ALLOWED call gets a worker running daimon_fetch_into
#     on its OWN arena + request buffer + raw-body buffer, over a fresh (un-pooled)
#     connection — the exact "distinct arenas + fresh connections" shape sandhi
#     1.6.13 certifies safe (its connection POOL stays single-threaded, so we never
#     share one). The worker does ONLY the network; it does NOT parse. Denied/noname
#     calls need no worker.
#   Phase 3 (serial, main thread, in call order): PARSE each raw body with bayan
#     (daimon_extract_text), print results, record the roundlog verdict, and append
#     each {role:tool} result to _agent_work — one unlocked buffer touched only here,
#     so order is deterministic and the tool_call_ids line up regardless of which
#     worker finished first.
#
# Why parse serially? bayan's JSON value parser is NOT thread-safe — beyond the
# 1.0.3 cursor fix its parse path still shares process state, and concurrent parses
# corrupt (measured ~98% wrong/empty across 8 threads; filed upstream). Keeping ALL
# bayan use on the main thread sidesteps that entirely; only sandhi — which IS
# reentrant in 1.6.13 — runs concurrently. Workers otherwise touch no shared mutable
# state: the endpoint URL is pre-warmed on the main thread, each slot owns its
# arena/req/out, and arena allocs are disjoint. If thread_create is unavailable
# (Win/AGNOS) or fails, the worker runs inline — correct, just serial. A round is
# processed in batches of PAR_MAX slots.
var PAR_MAX = 8;              # max concurrent workers per batch (matches AGENT_MAX_CALLS)
var PAR_NAME_CAP = 256;
var PAR_ARGS_CAP = 16384;
# Max tool-call `arguments` bytes accepted, shared by BOTH execution paths (=
# PAR_ARGS_CAP-1, the parallel slot's usable size). A call whose arguments exceed
# this is REFUSED with a result the model can react to — the serial and parallel
# paths never POST a truncated/malformed body, and the parallel path never gates a
# clipped payload (t-ron scans the same bytes daimon would receive). Unifies the
# previously divergent serial-unbounded / parallel-silently-truncated behavior.
var AGENT_ARGS_MAX = 16383;
var PAR_ID_CAP = 128;
var PAR_OUT_CAP = 131072;    # per-call result text, copied out of the arena
var PAR_ARENA_CAP = 524288;  # per-call arena: headers + url + conn buffers + response body
var PAR_CTX_SZ = 64;         # worker ctx: arena, req, name, args, out, result_len, elapsed_ms(+48, 0.19.1), http_status(+56, 0.31.5)

var _par_ready = 0;          # 1 once the slot storage is allocated
var _par_arena = 0;          # PAR_MAX allocator handles (i64 each)
var _par_req = 0;            # PAR_MAX request buffers (DAIMON_REQ_CAP each)
var _par_out = 0;            # PAR_MAX result buffers (PAR_OUT_CAP each)
var _par_name = 0;           # PAR_MAX name buffers (PAR_NAME_CAP each)
var _par_args = 0;           # PAR_MAX args buffers (PAR_ARGS_CAP each)
var _par_id = 0;             # PAR_MAX id buffers (PAR_ID_CAP each)
var _par_ctx = 0;            # PAR_MAX ctx structs (PAR_CTX_SZ each)
var _par_thread = 0;         # PAR_MAX thread handles (i64 each)
var _par_has_name = 0;       # PAR_MAX byte flags: 1 if the call had a name
var _par_allowed = 0;        # PAR_MAX byte flags: 1 if the gate allowed it
var _par_kind = 0;           # PAR_MAX i64 roundlog verdict kinds
var _par_over = 0;           # PAR_MAX byte flags: 1 if args exceeded AGENT_ARGS_MAX (refused)

fn _par_ctx_ptr(s) { return _par_ctx + s * PAR_CTX_SZ; }

# _par_alloc: lazily allocate the fixed slot storage (once per session). Each slot
# gets its own arena allocator so concurrent workers never share a bump pointer.
fn _par_alloc() {
    if (_par_ready == 1) { return 1; }
    _par_arena = alloc(PAR_MAX * 8);
    _par_req = alloc(PAR_MAX * DAIMON_REQ_CAP);
    _par_out = alloc(PAR_MAX * PAR_OUT_CAP);
    _par_name = alloc(PAR_MAX * PAR_NAME_CAP);
    _par_args = alloc(PAR_MAX * PAR_ARGS_CAP);
    _par_id = alloc(PAR_MAX * PAR_ID_CAP);
    _par_ctx = alloc(PAR_MAX * PAR_CTX_SZ);
    _par_thread = alloc(PAR_MAX * 8);
    _par_has_name = alloc(PAR_MAX);
    _par_allowed = alloc(PAR_MAX);
    _par_kind = alloc(PAR_MAX * 8);
    _par_over = alloc(PAR_MAX);
    var i = 0;
    var ok = 1;
    while (i < PAR_MAX) {
        var aa = arena_allocator(PAR_ARENA_CAP);
        store64(_par_arena + i * 8, aa);
        if (aa == 0) { ok = 0; }    # OOM: an unusable slot arena
        i = i + 1;
    }
    if (ok == 0) { return 0; }      # caller falls back to the serial path (no null-arena deref)
    _par_ready = 1;
    return 1;
}

# _par_cstr_copy: bounded copy of NUL-terminated src into dst (cap bytes incl. the
# terminator); returns the copied length. src == 0 yields an empty string. Pure.
fn _par_cstr_copy(dst, cap, src) {
    var n = 0;
    if (src != 0) {
        while ((load8(src + n) != 0) && (n < (cap - 1))) {
            store8(dst + n, load8(src + n));
            n = n + 1;
        }
    }
    store8(dst + n, 0);
    return n;
}

# _agent_call_worker: one tool FETCH on slot ctx — reset the slot arena, POST the
# call, stash the raw-body length at ctx+40 (parsing happens later, serially).
# Runs on a worker thread OR inline. Reentrant — touches only its own slot + sandhi.
fn _agent_call_worker(ctx) {
    var a = load64(ctx + 0);
    reset_via(a);
    var req = load64(ctx + 8);
    var name = load64(ctx + 16);
    var args = load64(ctx + 24);
    var out = load64(ctx + 32);
    var t0 = clock_now_ms();                        # 0.19.1: this call's wall-time (each worker owns its slot)
    var rl = daimon_fetch_into(a, req, name, args, out, PAR_OUT_CAP, ctx + 56);   # 0.31.5: status -> ctx+56
    store64(ctx + 40, rl);
    store64(ctx + 48, clock_now_ms() - t0);         # elapsed ms at ctx+48 (read serially in phase 3)
    return 0;
}

# _agent_tool_ok: the recorded success flag for a daimon tool result (0.30.18). A call succeeds only when its
# body parsed to text AND the MCP `isError` flag is not set — `daimon_invoke`/`daimon_fetch_into` used to drop
# `isError`, so a tool that returned isError:true with valid text was wrongly recorded (and now shown on the
# card) as `ok`. text_ok is 1 when result text parsed; is_error is daimon_extract_is_error's verdict (1 error,
# 0 success, -1 absent — only 1 flips a text-bearing result to failure). Pure — unit-tested.
fn _agent_tool_ok(text_ok, is_error) {
    if (text_ok == 0) { return 0; }        # no parseable text -> failure
    if (is_error == 1) { return 0; }       # isError:true -> failure even with text present
    return 1;
}

# _agent_run_calls_par: the phased parallel executor (see the block comment above).
# I/O — the network invokes run concurrently; gating + result append stay serial.
fn _agent_run_calls_par(tcs, nc) {
    _par_alloc();
    _daimon_call_endpoint();         # pre-warm the cached URL on the main thread
    var base = 0;
    while (base < nc) {
        var batch = nc - base;
        if (batch > PAR_MAX) { batch = PAR_MAX; }
        # Phase 1 — snapshot {id,name,args} into stable slots + serial t-ron gate.
        var k = 0;
        while (k < batch) {
            var ci = base + k;
            var nm = agent_tc_name(tcs, ci);
            var ar = agent_tc_args(tcs, ci);
            var id = agent_tc_id(tcs, ci);
            _par_cstr_copy(_par_name + k * PAR_NAME_CAP, PAR_NAME_CAP, nm);
            store8(_par_has_name + k, 0);
            if (nm != 0) { store8(_par_has_name + k, 1); }
            var ga = ar; if (ga == 0) { ga = "{}"; }
            _par_cstr_copy(_par_args + k * PAR_ARGS_CAP, PAR_ARGS_CAP, ga);
            _par_cstr_copy(_par_id + k * PAR_ID_CAP, PAR_ID_CAP, id);
            ui_emit(ROLE_FAINT, "  tool-call: "); if (nm != 0) { ui_emit(ROLE_ACCENT, nm); } else { ui_emit(ROLE_FAINT, "(unnamed)"); }
            if (ar != 0) { emit(" "); ui_emit(ROLE_MUTED, ar); } oprintln("");
            var allowed = 0;
            var kind = RL_DENIED;
            store8(_par_over + k, 0);
            # Refuse oversize args BEFORE gating, and gate on the FULL `ga` (an
            # accepted call's slot copy equals it, since strlen(ga) <= AGENT_ARGS_MAX
            # = PAR_ARGS_CAP-1) — so t-ron never scans a truncated payload and no
            # clipped/malformed body is ever POSTed.
            if (nm == 0) { kind = RL_NONAME; }
            elif (strlen(ga) > AGENT_ARGS_MAX) { store8(_par_over + k, 1); kind = RL_DENIED; }
            elif (gate_authorize(nm, ga, "call tool", nm) == 1) { allowed = 1; kind = RL_ALLOWED; }
            store8(_par_allowed + k, allowed);
            store64(_par_kind + k * 8, kind);
            k = k + 1;
        }
        # Phase 2 — fan out the allowed calls; each worker owns its slot's arena.
        _agent_spin_ntools(batch);          # 0.19.1: label the spinner for the concurrent batch
        var s = 0;
        while (s < batch) {
            store64(_par_thread + s * 8, 0);
            if (load8(_par_allowed + s) == 1) {
                var ctx = _par_ctx_ptr(s);
                store64(ctx + 0, load64(_par_arena + s * 8));
                store64(ctx + 8, _par_req + s * DAIMON_REQ_CAP);
                store64(ctx + 16, _par_name + s * PAR_NAME_CAP);
                store64(ctx + 24, _par_args + s * PAR_ARGS_CAP);
                store64(ctx + 32, _par_out + s * PAR_OUT_CAP);
                store64(ctx + 40, 0 - 1);
                var t = thread_create(&_agent_call_worker, ctx);
                if (t == 0) { _agent_call_worker(ctx); }   # no threads -> inline (serial fallback)
                else { store64(_par_thread + s * 8, t); }
            }
            s = s + 1;
        }
        s = 0;
        while (s < batch) {
            var th = load64(_par_thread + s * 8);
            if (th != 0) { thread_join(th); }
            s = s + 1;
        }
        spin_label_clear();                 # 0.19.1: batch joined -> back to the generic indicator
        # Phase 3 — print + record + append results in deterministic call order.
        k = 0;
        while (k < batch) {
            var kind2 = load64(_par_kind + k * 8);
            var rl_ok = 0;
            var res = 0;
            var ms = 0;                                          # 0.19.1: this call's wall-time (0 if not invoked)
            if (kind2 == RL_NONAME) { res = "(no tool name)"; }
            elif (load8(_par_allowed + k) == 1) {
                ms = load64(_par_ctx_ptr(k) + 48);               # 0.19.1: worker-measured elapsed
                var rlen = load64(_par_ctx_ptr(k) + 40);
                if (rlen < 0) {
                    # worker's daimon_fetch_into returned -1 (transport failure) — kept
                    # distinct from a parsed-but-empty 2xx body so the model sees why.
                    res = "(tool call failed: transport error)";
                } else {
                    res = "(tool returned no result)";
                    var st = load64(_par_ctx_ptr(k) + 56);           # 0.31.5: the worker-stashed HTTP status
                    # SERIAL bayan parse of the raw body the worker fetched (parses are main-thread only).
                    var text = daimon_extract_text(_par_out + k * PAR_OUT_CAP, rlen);
                    if ((st < 200) || (st >= 300)) {                 # 0.31.5: non-2xx -> failed call (rl_ok stays 0), mirror daimon_invoke
                        if ((text != 0) && (str_len(text) > 0)) { res = str_cstr(text); }   # non-empty error text
                        else { res = _daimon_http_err(st); }         # else a synthetic HTTP-status message
                    }
                    elif (text != 0) {
                        res = str_cstr(text);
                        rl_ok = _agent_tool_ok(1, daimon_extract_is_error(_par_out + k * PAR_OUT_CAP, rlen));   # 0.30.18: honor isError
                    }
                }
                ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
            } else {
                res = "denied by authorization policy";
                if (load8(_par_over + k) == 1) { res = "(tool arguments too large; call refused — split into smaller calls)"; }
            }
            var nmout = 0;
            if (load8(_par_has_name + k) == 1) { nmout = _par_name + k * PAR_NAME_CAP; }
            var bytes = 0; if (res != 0) { bytes = strlen(res); }   # 0.19.1
            _agent_call_telem(kind2, rl_ok, ms, bytes);            # 0.19.1: telemetry sub-line
            roundlog_add_call(nmout, kind2, rl_ok, ms, bytes, _par_args + k * PAR_ARGS_CAP);   # 0.30.17: + the snapshotted raw args
            _agent_add_result(_par_id + k * PAR_ID_CAP, res);
            k = k + 1;
        }
        base = base + batch;
    }
    return 0;
}

# _agent_run_calls: execute this round's tool calls. Fans them out concurrently
# (_agent_run_calls_par) when [hoosh].parallel is on AND there is more than one
# call; otherwise runs the serial path. Either way every call is t-ron-gated and a
# deny becomes a result the model can react to, never an abort.
# _agent_round_has_local: 1 if any call in this round is a thoth-native tool
# (memory_write) executed LOCALLY, not forwarded to daimon. Such a round is forced
# through the SERIAL executor so the parallel daimon workers never see it (they
# only ever forward to daimon). 0.12.2.
fn _agent_round_has_local(tcs, nc) {
    var i = 0;
    while (i < nc) {
        var nm = agent_tc_name(tcs, i);
        if (nm != 0) {
            if (streq(nm, "memory_write") == 1) { return 1; }
            if (streq(nm, "read_file") == 1) { return 1; }    # 0.23.0 local project tools -> serial dispatch
            if (streq(nm, "list_dir") == 1) { return 1; }
            # "shell" is matched UNCONDITIONALLY (not gated on config): a call named "shell" must
            # always take the serial path so the local dispatch elif below decides its fate — even
            # when disabled, where that elif returns an honest not-enabled string rather than letting
            # a hallucinated/un-advertised "shell" fall through to daimon_invoke. 0.16.0.
            if (streq(nm, "shell") == 1) { return 1; }
            if (streq(nm, "edit") == 1) { return 1; }         # 0.31.0 local edit tool -> serial dispatch (same rationale as shell)
            if (streq(nm, "create_file") == 1) { return 1; }  # 0.31.3 local create tool -> serial dispatch
        }
        i = i + 1;
    }
    return 0;
}

# _agent_call_telem: a faint per-call telemetry sub-line under the result (0.19.1) — the verdict, and for an
# invoked call its wall-time (ms) + result byte count. Mirrors the roundlog fields so the live feed and
# /audit agree. Routes through the SAME sink as the tool-call/result lines (feed at OUT_RING, terminal at
# OUT_FD1); floor-safe (ui_emit/ofmt_int are verbatim at PT_PLAIN).
fn _agent_call_telem(kind, ok, ms, bytes) {
    ui_emit(ROLE_FAINT, "    · ");
    if (kind == RL_ALLOWED) {
        if (ok == 1) { ui_emit(ROLE_GREEN, "ok"); } else { ui_emit(ROLE_RED, "err"); }
        ui_emit(ROLE_FAINT, " · "); ofmt_int(ms); ui_emit(ROLE_FAINT, "ms · "); ofmt_int(bytes); ui_emit(ROLE_FAINT, "B");
    } elif (kind == RL_NONAME) { ui_emit(ROLE_MUTED, "no tool name"); }
    else { ui_emit(ROLE_RED, "denied"); }
    oprintln("");
    return 0;
}

# _agent_spin_ntools: label the spinner "N tools" for a parallel batch (0.19.1). No-op off the TUI.
fn _agent_spin_ntools(n) {
    var b[32];
    var o = _append_int(&b, 0, n);
    var t = " tools";
    var ti = 0;
    while ((load8(t + ti) != 0) && (o < 30)) { store8(&b + o, load8(t + ti)); o = o + 1; ti = ti + 1; }
    store8(&b + o, 0);
    spin_label_set(&b);
    return 0;
}

fn _agent_run_calls(tcs, nc) {
    # 0.20.0 CRASH GUARD: the parallel executor's first act is _daimon_call_endpoint(), which strlen()s
    # config_daimon_url() — NULL when daimon is absent (shell-standalone mode) -> a null-page deref. Force
    # serial when the seam is absent (there is nothing to fan out to anyway; the local shell/memory tools run
    # serially, and a hallucinated non-local tool is refused honestly in the serial path). Floor: when daimon
    # is wired the check is false and the parallel/serial decision is byte-identical.
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) { return _agent_run_calls_serial(tcs, nc); }
    if ((config_hoosh_parallel() == 1) && (nc > 1) && (_agent_round_has_local(tcs, nc) == 0) && (_par_alloc() == 1)) { return _agent_run_calls_par(tcs, nc); }
    return _agent_run_calls_serial(tcs, nc);
}

# _agent_run_calls_serial: execute every tool_call in this round one at a time —
# gate, invoke, record the result message. The fallback path (parallel off, or a
# single-call round); also the structure the parallel executor mirrors. I/O.
fn _agent_run_calls_serial(tcs, nc) {
    var ci = 0;
    while (ci < nc) {
        var nm = agent_tc_name(tcs, ci);
        var ar = agent_tc_args(tcs, ci);
        var id = agent_tc_id(tcs, ci);
        ui_emit(ROLE_FAINT, "  tool-call: "); if (nm != 0) { ui_emit(ROLE_ACCENT, nm); } else { ui_emit(ROLE_FAINT, "(unnamed)"); }
        if (ar != 0) { emit(" "); ui_emit(ROLE_MUTED, ar); } oprintln("");
        var gp = ar; if (gp == 0) { gp = "{}"; }
        var res = 0;
        var rl_kind = RL_DENIED;
        var rl_ok = 0;
        spin_label_set(nm);                     # 0.19.1: name the running tool on the spinner (no-op off TUI)
        var t0 = clock_now_ms();                # 0.19.1: time the gate+invoke
        if (nm == 0) { res = "(no tool name)"; rl_kind = RL_NONAME; }
        elif (strlen(gp) > AGENT_ARGS_MAX) { res = "(tool arguments too large; call refused — split into smaller calls)"; rl_kind = RL_DENIED; }
        elif (streq(nm, "memory_write") == 1) {
            # thoth-native tool (0.12.2): the model saves a durable fact to project
            # memory. Gated under thoth_remember — executed LOCALLY, NOT via daimon.
            if (gate_authorize("thoth_remember", gp, "remember to", memory_index_path()) == 1) {
                rl_kind = RL_ALLOWED;
                res = memory_write_tool(gp);
                rl_ok = 1;
                ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
            } else {
                res = "denied by authorization policy";
            }
        }
        elif (streq(nm, "read_file") == 1) {
            # thoth-native project tool (0.23.0, ADR-0015): read a file, JAILED to the launch cwd.
            # No t-ron gate — the jail (no absolute / no '..') is the safety boundary. LOCAL, not daimon.
            rl_kind = RL_ALLOWED;
            res = read_file_tool(gp);
            rl_ok = 1;
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif (streq(nm, "list_dir") == 1) {
            # thoth-native project tool (0.23.0, ADR-0015): list a directory, JAILED to the launch cwd.
            rl_kind = RL_ALLOWED;
            res = list_dir_tool(gp);
            rl_ok = 1;
            ui_emit(ROLE_FAINT, "  result: "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(strlen(res)); emit(ui_reset()); ui_emit(ROLE_FAINT, " bytes"); oprintln("");
        }
        elif ((streq(nm, "shell") == 1) && (config_shell_enabled() == 1) && (shell_supported() == 1)) {
            # thoth-native shell tool (0.16.0, ADR-0014): the model proposes a local command.
            # shell_run_tool runs the LOCAL glob filter + the t-ron thoth_shell gate + the timed
            # capture internally (globs BEFORE the gate, so a deny-list holds even with no policy),
            # returning the result string plus the roundlog outcome. Executed LOCALLY, NOT via daimon.
            res = shell_run_tool(gp);
            if (shell_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
            rl_ok = shell_last_ok();
            ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
        }
        elif (streq(nm, "shell") == 1) {
            # "shell" emitted while the tool is disabled / unsupported (it was never advertised):
            # return an honest not-enabled string. Do NOT run it and do NOT fall through to
            # daimon_invoke — never execute or forward a tool the model was not offered. rl stays DENIED.
            res = "(shell tool is not enabled in this session)";
            ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
        }
        elif (streq(nm, "edit") == 1) {
            # thoth-native edit tool (0.31.0, ADR-0017): the model rewrites a project file. edit_tool self-gates
            # (jail + t-ron thoth_edit) and applies the diff internally, exposing the outcome via edit_last_*;
            # LOCAL, NOT via daimon. When [edit].enabled is off it was never advertised — return an honest
            # not-enabled string (rl stays DENIED) rather than letting a hallucinated "edit" reach daimon.
            if (config_edit_enabled() == 1) {
                res = edit_tool(gp);
                if (edit_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
                rl_ok = edit_last_ok();
                if (edit_last_ok() == 1) {                            # 0.31.1: record the edit's diff for the feed card
                    editlog_record(session_turns(), roundlog_cur_round(), ci, edit_last_path(), edit_last_old(), edit_last_old_len(), edit_last_new(), edit_last_new_len());
                }
            } else {
                res = "(edit tool is not enabled in this session)";
            }
            ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
        }
        elif (streq(nm, "create_file") == 1) {
            # thoth-native create tool (0.31.3, ADR-0017): the model makes a NEW project file. create_file_tool
            # self-gates (jail + thoth_edit) and refuses an existing file; LOCAL, NOT via daimon. Records the same
            # editlog entry (old="" -> all-add diff card) via the shared edit_last_* state.
            if (config_edit_enabled() == 1) {
                res = create_file_tool(gp);
                if (edit_last_allowed() == 1) { rl_kind = RL_ALLOWED; }
                rl_ok = edit_last_ok();
                if (edit_last_ok() == 1) {
                    editlog_record(session_turns(), roundlog_cur_round(), ci, edit_last_path(), edit_last_old(), edit_last_old_len(), edit_last_new(), edit_last_new_len());
                }
            } else {
                res = "(create_file tool is not enabled in this session)";
            }
            ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
        }
        elif (seam_status(SEAM_DAIMON) == SEAM_ABSENT) {
            # 0.20.0 CRASH GUARD: shell-standalone mode (agentic loop, no daimon). A non-local tool can't be
            # served — and daimon_invoke -> _daimon_call_endpoint would strlen() a NULL daimon URL. Refuse
            # honestly (rl stays DENIED); never touch the network. Only reachable when the seam is absent.
            res = "(tool not available: no daimon wired — only the local shell/memory tools run standalone)";
            ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
        }
        elif (gate_authorize(nm, gp, "call tool", nm) == 1) {
            rl_kind = RL_ALLOWED;
            res = daimon_invoke(nm, ar);
            var text_ok = 0; if (res != 0) { text_ok = 1; }         # parsed a result?  (before the placeholder reassign)
            if (res == 0) { res = "(tool returned no result)"; }
            rl_ok = _agent_tool_ok(text_ok, daimon_invoke_is_error());   # 0.30.18: text parsed AND not an MCP isError
            ui_emit(ROLE_FAINT, "  result: "); oprintln(res);
        } else {
            res = "denied by authorization policy";
        }
        var ms = clock_now_ms() - t0;           # 0.19.1: invoke wall-time
        spin_label_clear();
        var bytes = 0; if (res != 0) { bytes = strlen(res); }   # 0.19.1: result byte count
        _agent_call_telem(rl_kind, rl_ok, ms, bytes);           # 0.19.1: faint telemetry sub-line
        roundlog_add_call(nm, rl_kind, rl_ok, ms, bytes, ar);   # 0.30.17: + the raw args for the card/audit summary
        _agent_add_result(id, res);
        ci = ci + 1;
    }
    return 0;
}

# One iteration's normalized outcome (set by the iter helpers, read by the loop):
#   kind 0 = final answer (content already printed; in _hoosh_acc to persist)
#   kind 1 = tool calls to run (_agent_round_raw text + _agent_round_val parsed)
#   kind 2 = transport error (message already announced)
#   kind 3 = non-2xx HTTP (status in _agent_round_status; message announced)
var _agent_round_kind = 0;
var _agent_round_raw = 0;
var _agent_round_val = 0;
var _agent_round_n = 0;
var _agent_round_status = 0;
var _agent_cell = 0;

# _agent_finish_outcome: shared classification — given a fully-received response
# (raw tool_calls text + parsed array + content already handled), set the round
# outcome. Content for the final answer is left in _hoosh_acc by the caller.
fn _agent_set_tools(raw, val, n) {
    _agent_round_raw = raw;
    _agent_round_val = val;
    _agent_round_n = n;
    _agent_round_kind = 1;
    return 0;
}

# _agent_sse_cb: the streaming callback. Content deltas print live and accumulate
# in _hoosh_acc; tool_call deltas fold into the per-index slots. [DONE] ends it.
fn _agent_sse_cb(ctx, ev) {
    if (intr_poll() == 1) { return 0; }   # 0.17.4: Esc -> stop the stream cleanly (partial kept)
    var data = sandhi_sse_event_data(ev);
    if (data == 0) { return 1; }
    if (streq(data, "[DONE]") == 1) { return 0; }
    var v = bayan_json_v_parse_str(data, strlen(data));
    if (v == 0) { return 1; }
    _hoosh_account_usage(v);   # 0.10.2/0.10.3: tokens + cost from the trailing usage frame
    var choices = bayan_json_v_obj_get(v, "choices");
    if (choices == 0) { return 1; }
    var first = bayan_json_v_arr_get(choices, 0);
    if (first == 0) { return 1; }
    var delta = bayan_json_v_obj_get(first, "delta");
    if (delta == 0) { return 1; }
    var content = bayan_json_v_obj_get(delta, "content");
    if (content != 0) {
        var s = bayan_json_v_str(content);
        if (s != 0) { var n = str_len(s); if (n > 0) { mdhl_feed(str_data(s), n); _hoosh_acc_append(str_data(s), n); } }   # 0.15.1: fenced-code highlighter
    }
    var tcs = bayan_json_v_obj_get(delta, "tool_calls");
    if (tcs != 0) {
        var tn = bayan_json_v_arr_len(tcs);
        var i = 0;
        while (i < tn) { _agent_accum_delta(bayan_json_v_arr_get(tcs, i)); i = i + 1; }
    }
    feed_stream_tick();   # 0.9.2: TUI incremental paint + spinner (no-op off the TUI)
    return 1;
}

# _agent_iter_block: one non-streaming iteration (a full POST, parsed whole).
fn _agent_iter_block(model, sys, mem, tools_buf, tools_len) {
    var len = agent_build_request(_agent_req, model, sys, mem, tools_buf, tools_len, 0);
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    var r = sandhi_http_post(_hoosh_endpoint_url(), h, _agent_req, len);
    if (sandhi_http_err_kind(r) != SANDHI_OK) {
        var en = sandhi_err_kind_name(sandhi_http_err_kind(r));
        emit("  hoosh transport error: "); oprintln(en);
        _agent_round_kind = 2; return 0;
    }
    var status = sandhi_http_status(r);
    var body = sandhi_http_body(r);
    var blen = sandhi_http_body_len(r);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        var em = hoosh_extract_error(body, blen);
        if (em != 0) { emit("  "); _hoosh_print_str(em); }
        _agent_round_kind = 3; _agent_round_status = status; return 0;
    }
    _hoosh_account_usage(bayan_json_v_parse_str(body, blen));
    var tcs = agent_tool_calls(body, blen);
    var nc = agent_tc_count(tcs);
    if (nc == 0) {
        var content = hoosh_extract_content(body, blen);
        if (content != 0) { _hoosh_print_reply(content); _hoosh_acc_append(str_data(content), str_len(content)); }   # 0.15.1: fenced-code highlighting
        _agent_round_kind = 0;
    } else {
        var raw = _agent_raw_tool_calls(body, blen);
        if (raw == 0) { raw = "[]"; }
        _agent_set_tools(raw, tcs, nc);
    }
    return 0;
}

# _agent_iter_stream: one streaming iteration. SSE content prints live; tool_calls
# assemble from the deltas and are reconstructed into the same array text shape.
fn _agent_iter_stream(model, sys, mem, tools_buf, tools_len) {
    _ag_reset();
    var len = agent_build_request(_agent_req, model, sys, mem, tools_buf, tools_len, 1);
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Content-Type", "application/json");
    sandhi_headers_set(h, "Accept", "text/event-stream");
    var auth = _hoosh_auth_header();
    if (auth != 0) { sandhi_headers_set(h, "Authorization", auth); }
    if (_agent_cell == 0) { _agent_cell = alloc(8); }
    store64(_agent_cell, 0);
    mdhl_reset();    # 0.15.1: bracket the fenced-code highlighter around this iteration's stream
    intr_arm();      # 0.17.4: enter Esc-poll mode around the stream (TUI-only; no-op off OUT_RING)
    var sr = sandhi_http_stream(_hoosh_endpoint_url(), "POST", h, _agent_req, len, &_agent_sse_cb, _agent_cell);
    intr_disarm();   # 0.17.4: restore cooked (the following t-ron confirm reads a line in cooked mode)
    mdhl_finish();   # drain the filter (residual line + open block) before the finishing newline / status branching
    if (_hoosh_acc_len > 0) { oprintln(""); }   # finish the streamed line
    if (intr_pending() == 1) { _agent_round_kind = 4; return 0; }   # 0.17.4: Esc aborted — kind 4, before tool-parse
    if (sandhi_stream_err(sr) != SANDHI_OK) {
        var en = sandhi_err_kind_name(sandhi_stream_err(sr));
        emit("  hoosh stream error: "); oprintln(en);
        _agent_round_kind = 2; return 0;
    }
    var status = sandhi_stream_status(sr);
    if ((status < 200) || (status >= 300)) {
        emit("  hoosh returned HTTP "); ofmt_int(status); oprintln("");
        oprintln("  (error body not surfaced in stream mode; set [hoosh].stream=false to see it)");
        _agent_round_kind = 3; _agent_round_status = status; return 0;
    }
    if (_ag_max > 0) {
        var rl = _ag_build_array(_agent_arr_buf);
        var val = bayan_json_v_parse_str(_agent_arr_buf, rl);
        _agent_set_tools(_agent_arr_buf, val, agent_tc_count(val));
    } else {
        _agent_round_kind = 0;
    }
    return 0;
}

# agent_turn: drive one free-text turn as an agentic tool-calling loop. Streams
# the model's output (content live, tool_calls assembled from deltas) when
# [hoosh].stream is on — so wiring daimon no longer disables streaming; falls back
# to a blocking round-trip when stream=false. Each tool call is t-ron-gated;
# results loop back until the model answers. Returns 0 on success, negative on
# transport failure, the HTTP status on a non-2xx. Any failure rolls the user turn
# back out of history (completed exchanges only). I/O — the orchestrator.
fn agent_turn(prompt) {
    var model = _hoosh_model();
    var sys = 0;
    if (seam_status(SEAM_AVATARA) == SEAM_NATIVE) { sys = persona_system_prompt(); }
    # project memory (0.12.0): the second system message, acquired once per turn
    # (local .thoth/memory reader, or mneme when it binds). ADR-0012.
    var mem = 0;
    if (seam_cap_state(SEAM_MEMORY) != CAP_ABSENT) { mem = memory_context(); }
    if (_agent_req == 0) { _agent_req = alloc(AGENT_REQ_CAP); }
    if (_agent_tools_buf == 0) { _agent_tools_buf = alloc(AGENT_TOOLS_CAP); }
    if (_agent_work == 0) { _agent_work = alloc(AGENT_WORK_CAP); }

    # Tool advertisement is session-stable (the daimon endpoint and its registry do
    # not change mid-session), so fetch + parse + serialize it ONCE and reuse the
    # formatted buffer every turn — not a daimon GET + bayan parse + re-serialize per
    # turn. Cache only on success: a transient daimon-down on the first turn leaves
    # _agent_tools_ready=0 so a later turn retries (degraded honestly, never sticky).
    if (_agent_tools_ready == 0) {
        var dtv = 0;                                          # 0.20.0: only fetch daimon's registry when the seam
        if (seam_status(SEAM_DAIMON) != SEAM_ABSENT) { dtv = daimon_tools_value(); }   # is present (shell-standalone: no GET)
        daimon_mem_scan(dtv);                                # 0.32.0: prime the mneme memory-seam cache off this same registry fetch (no extra GET)
        var tl = agent_format_tools(_agent_tools_buf, dtv);
        tl = agent_tools_add_memory(_agent_tools_buf, tl);   # 0.12.2: + memory_write when [memory].enabled
        tl = agent_tools_add_shell(_agent_tools_buf, tl);    # 0.16.0: + shell when [shell].enabled AND POSIX-capable
        tl = agent_tools_add_project(_agent_tools_buf, tl);  # 0.23.0: + read_file/list_dir (default-on, jailed)
        tl = agent_tools_add_edit(_agent_tools_buf, tl);     # 0.31.0: + edit when [edit].enabled (opt-in, jailed+gated)
        _agent_tools_len = tl;
        # Cache ONLY on a good daimon fetch (or no daimon). 0.23.0: the always-on project tools make tl>0
        # unconditionally, so `tl>0` can no longer stand in for "daimon fetch succeeded" — a transient
        # daimon-down would latch an empty registry forever. Gate on the daimon fetch (dtv) so a daimon-down
        # first turn leaves _agent_tools_ready=0 and a later turn retries (the documented self-heal above).
        if ((seam_status(SEAM_DAIMON) == SEAM_ABSENT) || (dtv != 0)) { _agent_tools_ready = 1; }
    }
    var tools_len = _agent_tools_len;
    var want_stream = config_hoosh_stream();
    session_history_append("user", prompt, strlen(prompt));
    _agent_work_reset();
    intr_reset();      # 0.17.4: clear any stale Esc-interrupt flag at the start of the turn

    ui_emit(ROLE_FAINT, "  -> hoosh ("); ui_emit(ROLE_ACCENT, model); ui_emit(ROLE_FAINT, ", agentic");
    if (want_stream == 1) { ui_emit(ROLE_FAINT, ", stream"); }
    ui_emit(ROLE_FAINT, ", "); ofmt_int(tools_len); ui_emit(ROLE_FAINT, " tool-bytes) "); oprintln(_hoosh_endpoint_url());

    var iter = 0;
    var done = 0;
    var round_no = 0;
    while ((done == 0) && (iter < AGENT_MAX_ITERS)) {
        _hoosh_acc_reset();
        if (want_stream == 1) { _agent_iter_stream(model, sys, mem, _agent_tools_buf, tools_len); }
        else { _agent_iter_block(model, sys, mem, _agent_tools_buf, tools_len); }
        # 0.17.4: a SINGLE if/elif chain — exactly one arm runs. (Was three bare `if`s; k==2/k==3
        # returned so they never fell through, but the new non-returning k==4 arm MUST NOT fall into
        # the k==1/else block below, or it would double-append / double-pop history.)
        var k = _agent_round_kind;
        if (k == 2) { hoosh_health_mark_down(); }     # 0.19.3: a round's transport failure -> spine DOWN
        elif (k != 4) { hoosh_health_mark_up(); }     # any answered round (tool/http/final) -> UP; k==4 (Esc) neutral
        if (k == 2) {
            session_history_pop_last();
            log_begin("agent_turn"); log_kv_str("result", "transport_error"); log_commit(SK_WARN);
            return 0 - 1;
        } elif (k == 3) {
            session_history_pop_last();
            log_begin("agent_turn"); log_kv_str("result", "http_error"); log_kv_int("status", _agent_round_status); log_commit(SK_WARN);
            return _agent_round_status;
        } elif (k == 4) {
            # Esc interrupted the stream. KEEP the partial (append it, completing the user+assistant
            # pair) or, if nothing streamed, pop the unanswered user turn; mark it in the feed; end the
            # loop. Deliberately UNLIKE max-iters (below), which clears _hoosh_acc — the user asked to
            # stop and see what came so far, and interrupt is TUI-only so one-shot's exit code is moot.
            if (_hoosh_acc_len > 0) { session_history_append("assistant", _hoosh_acc, _hoosh_acc_len); sess_persist_save(); }
            else { session_history_pop_last(); }
            intr_note();
            done = 1;
            log_begin("agent_turn"); log_kv_int("iters", iter + 1); log_kv_str("result", "interrupted"); log_commit(SK_WARN);
        } elif (k == 1) {
            var raw = _agent_round_raw;
            if (raw == 0) { raw = "[]"; }
            _agent_add_assistant(raw);
            round_no = round_no + 1;
            roundlog_open(session_turns(), round_no);
            _agent_run_calls(_agent_round_val, _agent_round_n);
        } else {
            if (_hoosh_acc_len > 0) { session_history_append("assistant", _hoosh_acc, _hoosh_acc_len); sess_persist_save(); }
            else { oprintln("  hoosh: response had neither tool calls nor content."); session_history_pop_last(); }
            done = 1;
            log_begin("agent_turn"); log_kv_int("iters", iter + 1); log_kv_str("result", "ok"); log_commit(SK_INFO);
        }
        iter = iter + 1;
    }
    if (done == 0) {
        oprintln("  agentic loop hit the iteration cap (no final answer).");
        session_history_pop_last();
        # No FINAL answer was produced — clear the reply accumulator so a one-shot run
        # reports failure (exit nonzero) instead of printing the last capped round's
        # interim narration as if it were the answer (the streaming path appends content
        # even on a tool-call round). The interactive REPL is unaffected (it ignores this
        # return and the narration already streamed live). 0.11.0.
        _hoosh_acc_reset();
        log_begin("agent_turn"); log_kv_int("iters", iter); log_kv_str("result", "max_iters"); log_commit(SK_WARN);
    }
    return 0;
}
