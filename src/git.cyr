# git.cyr — the git producer (0.13.0). thoth reports the working repository's
# branch + working-tree status by CONSUMING sit's read-only VCS API
# (sit_repo_open / sit_repo_branch / sit_repo_status; the vendored 1.3.0 read
# profile). thoth owns NO VCS logic — sit owns the domain (git + .sit on-disk
# formats, the delta interpreter, all of it); thoth only asks and renders.
#
# Omit-until-present (ADR-0010): the git status-bar segment appears ONLY when a
# repo is present at the working directory; never a faked branch/count. /state
# always shows a git row (present → branch + count, absent → the honest line).
#
# sit reads AT the working directory and does not walk ancestors (sit's ADR 0003
# no-upward-discovery), so git is reported only when thoth runs at a repo root —
# announced honestly, not faked, when it isn't.
#
# Freshness vs cost: git_probe() re-reads the repo (a worktree walk). It is called
# at startup, after each dispatched turn (files may have changed via /run or an
# agentic edit), and by /state and /git — NOT per status-bar paint. The status bar
# reads the cache.
#
# 0.54.1 (P-10, M-3): the walk runs in a forked child. sit allocates on the heap that never frees and inflates every tracked
# blob, so on a 100k-file repository one probe cost 48 MB of heap for good and held the main thread for 1.8 s (37 -> 515 MB in ten
# turns). A child's heap goes with the child, and a walk that crashes on a hostile repository takes only the child. It sends a
# small snapshot back through a pipe. The surfaces start it and carry on (git_probe_begin, collected by git_probe_land); /state and /git
# wait for it (git_probe). Where there is no fork (Windows, AGNOS) the walk is the plain call it always was.

var GIT_BRANCH_CAP = 256;
var _git_probed = 0;        # 1 once git_probe has run at least once this session
var _git_present = 0;       # 1 if a git/.sit repo was found at the working directory
var _git_branch_buf = 0;    # owner-copied branch name (sit's cstring is arena-owned)
var _git_detached = 0;      # 1 if HEAD is detached / not a branch ref
var _git_dirty = 0;         # count of changed files (modified/new/deleted, HEAD vs worktree), or GIT_NO_ANSWER

# Per-file status cache for file-tree badges (0.22.4): copied from sit's status vec at probe time (sit's
# paths are arena-owned, freed on close) into REUSED buffers (rewritten each probe, so no accretion over a
# session). Repo-relative paths + a kind byte (1=modified, 2=new/untracked, 3=deleted, 4=not compared). Bounded.
var GIT_STATUS_MAX = 512;   # max changed files tracked for badges
var GIT_STATUS_BUF = 32768; # reused path storage (32 KiB); entries past it are skipped
var _git_status_n = 0;      # cached entry count
var _git_status_ptr = 0;    # GIT_STATUS_MAX cstr ptrs into _git_status_buf
var _git_status_kind = 0;   # GIT_STATUS_MAX bytes (the kind)
var _git_status_buf = 0;    # reused relative-path storage

# _git_copy_branch: copy sit's heap branch cstring into our static buffer so we
# never alias sit's arena past the probe (mirrors session_set_model_copy).
# 0.52.8 (audit F1): through the LABEL policy — the copy was verbatim, and every surface draws it raw (the status bar,
# the window's strip, /state). sit's refname_valid refuses C0, DEL and git's own specials but not 0x80..0x9F, so a
# clone's `.git/HEAD` reading `ref: refs/heads/x<9B>2Jy` put a C1 CSI on the status bar.
fn _git_copy_branch(br) {
    if (_git_branch_buf == 0) { _git_branch_buf = alloc(GIT_BRANCH_CAP); }
    safe_label_copy(_git_branch_buf, GIT_BRANCH_CAP, br);
    return 0;
}

# _git_note_detached (0.52.8): a detached HEAD reads git_branch()'s '?' sentinel even when an earlier probe filled the
# buffer — a session that began on a branch and then checked out a tag kept the branch's name. The surfaces draw
# "(detached)" off git_detached() and never showed it, but the sentinel is git_branch()'s contract, and the release
# run (a tag checkout: detached) failed the test that pins it once another test had filled the buffer.
fn _git_note_detached() {
    _git_detached = 1;
    if (_git_branch_buf != 0) { store8(_git_branch_buf, 63); store8(_git_branch_buf + 1, 0); }
    return 0;
}

# _git_bufs: the badge cache's reused buffers, made before a fork so child and parent share the layout.
fn _git_bufs() {
    if (_git_status_ptr == 0) {
        _git_status_ptr = alloc(GIT_STATUS_MAX * 8);
        _git_status_kind = alloc(GIT_STATUS_MAX);
        _git_status_buf = alloc(GIT_STATUS_BUF);
    }
    if (_git_branch_buf == 0) { _git_branch_buf = alloc(GIT_BRANCH_CAP); }
    return 0;
}

# --- what sit can say it does not know (sit 1.13.2, 0.55.3) -----------------------------------------------------------------
# sit_repo_status and sit_diff_path return what they return for "nothing to report" when they have no answer, and only
# sit_last_result tells the two apart. So an unreadable HEAD, a tree too big to walk and a held store all read as clean until a
# caller asks. Both calls ask, and a surface says "no answer" rather than a clean tree it does not know about.
var GIT_NOT_COMPARED = 4;          # sit_status_kind: tracked, and sit cannot tell whether it changed
var GIT_NO_ANSWER = 0 - 1;         # git_dirty(): sit could not say
# /git runs on the thread that owns the surface, and the status walk can too, so sit's 60 s on a store lock anyone who can read the
# repository can hold is too long. sit keeps about 160 bytes a diff line on a heap that never frees, so these bound a diff to about 8 MB.
var GIT_STORE_WAIT_MS = 1000;
var GIT_DIFF_MAX_BYTES = 8388608;
var GIT_DIFF_MAX_LINES = 50000;

# git_repo_open: the one way to a repository. sit reads at the path it is given, and AGNOS has no cwd for "." to mean (note 005).
fn git_repo_open() {
    sit_set_store_wait(GIT_STORE_WAIT_MS);
    sit_set_diff_limit(GIT_DIFF_MAX_BYTES, GIT_DIFF_MAX_LINES);
    var root = fs_root();
    if (root == 0) { root = "."; }
    return sit_repo_open(root);
}

# git_result_text: why sit has no answer, in the operator's words.
fn git_result_text(r) {
    if (r == SIT_BUSY) { return "another process holds the store"; }
    if (r == SIT_HEAD_TOO_BIG) { return "HEAD's copy is over the size limit"; }
    if (r == SIT_HEAD_MISSING) { return "HEAD names an object that is not here"; }
    if (r == SIT_HEAD_CORRUPT) { return "HEAD's object does not read"; }
    if (r == SIT_WORK_TOO_BIG) { return "the working copy is over the size limit"; }
    if (r == SIT_WORK_UNREADABLE) { return "the working copy cannot be read"; }
    if (r == SIT_DIFF_TOO_BIG) { return "the diff is past its budget"; }
    if (r == SIT_NOT_COMPARABLE) { return "a filter, ident or encoding applies, and sit runs none"; }
    if (r == SIT_TREE_TOO_BIG) { return "HEAD's tree is past the walk's budget"; }
    return "sit gave no reason";
}

# _git_cache_status: sit's status vec and its result into the badge cache. A file sit could not compare is kept for its badge, and is
# not a change it saw. With no answer the count says so, and whatever came back still gets its badges.
fn _git_cache_status(st, why) {
    if (st != 0) {
        _git_bufs();
        var off = 0;                                 # rewrite the reused buffer from the top (no accretion)
        var i = 0;
        var sn = vec_len(st);
        while (i < sn) {
            var kind = sit_status_kind(vec_get(st, i));
            if (kind != GIT_NOT_COMPARED) { _git_dirty = _git_dirty + 1; }
            if (_git_status_n < GIT_STATUS_MAX) {
                var path = sit_status_path(vec_get(st, i));
                var plen = strlen(path);
                if ((off + plen + 1) <= GIT_STATUS_BUF) {
                    memcpy(_git_status_buf + off, path, plen);
                    store8(_git_status_buf + off + plen, 0);
                    store64(_git_status_ptr + _git_status_n * 8, _git_status_buf + off);
                    store8(_git_status_kind + _git_status_n, kind);
                    _git_status_n = _git_status_n + 1;
                    off = off + plen + 1;
                }
            }
            i = i + 1;
        }
    }
    if (why != SIT_OK) { _git_dirty = GIT_NO_ANSWER; }
    return 0;
}

# _git_walk: read the repo through sit into the cache. sit_repo_open(".") chdirs to "." (a no-op — thoth never leaves its launch
# cwd), detects .git/ or .sit/, and returns 1/0. On a repo we snapshot the branch + the changed-file count. 1 if a repo is present.
fn _git_walk() {
    _git_present = 0;
    _git_detached = 0;
    _git_dirty = 0;
    _git_status_n = 0;
    var repo = git_repo_open();
    if (repo == 0) { return 0; }     # no .git/ or .sit/ at the working directory, or a link out of it, which sit refuses
    _git_present = 1;
    var br = sit_repo_branch(repo);  # heap cstring, or 0 when HEAD is detached
    if (br == 0) { _git_note_detached(); }
    else { _git_copy_branch(br); }
    var st = sit_repo_status(repo);  # vec of {path, kind}; count + copy into the badge cache (before close)
    _git_cache_status(st, sit_last_result());
    sit_repo_close(repo);
    return 1;
}

# --- the probe in a child (0.54.1) --------------------------------------------------------------------------------------------
# The snapshot: 8 bytes present, 8 detached, 8 dirty, 8 entry count, the branch NUL-terminated, each entry as a kind byte and a
# NUL-terminated path, then one end mark: a child that died part-way sends none, and the cache keeps what it had. A pipe's
# buffer holds it whole on every target, but the parent reads as it goes either way.
var GIT_PROBE_MS = 120000;         # a walk past this is killed, and the cache keeps what it had. Generous: a Pi takes over 5 s on this tree
var GIT_SNAP_CAP = 34048;          # 32 + GIT_BRANCH_CAP + GIT_STATUS_MAX + GIT_STATUS_BUF + the mark
var GIT_SNAP_END = 165;
var _git_snap = 0;
var _git_snap_n = 0;
var _git_job_pid = 0;
var _git_job_fd = 0 - 1;
var _git_job_t0 = 0;
var _git_child_fail = 0;           # test seam: the child dies before it writes (2: after a wait)
var _git_wait_poll = 0;            # the surface's wait poll (net_poll_set binds it): git_probe's wait keeps the surface alive
fn git_wait_poll_set(fp) { _git_wait_poll = fp; return 0; }

fn _git_snap_build() {
    store64(_git_snap, _git_present);
    store64(_git_snap + 8, _git_detached);
    store64(_git_snap + 16, _git_dirty);
    store64(_git_snap + 24, _git_status_n);
    var o = 32;
    var b = git_branch();
    var bl = strlen(b);
    memcpy(_git_snap + o, b, bl);
    o = o + bl;
    store8(_git_snap + o, 0);
    o = o + 1;
    var i = 0;
    while (i < _git_status_n) {
        var p = load64(_git_status_ptr + i * 8);
        var pl = strlen(p);
        store8(_git_snap + o, load8(_git_status_kind + i));
        memcpy(_git_snap + o + 1, p, pl);
        store8(_git_snap + o + 1 + pl, 0);
        o = o + pl + 2;
        i = i + 1;
    }
    store8(_git_snap + o, GIT_SNAP_END);
    return o + 1;
}

# _git_snap_apply: the snapshot into the cache. 0 for one with no end mark, or one that does not parse: the cache stays as it was.
fn _git_snap_apply() {
    var n = _git_snap_n;
    if (n < 34) { return 0; }
    if (load8(_git_snap + n - 1) != GIT_SNAP_END) { return 0; }
    var end = n - 1;
    var cnt = load64(_git_snap + 24);
    if ((cnt < 0) || (cnt > GIT_STATUS_MAX)) { return 0; }
    var o = 32;
    var bo = o;
    while ((o < end) && (load8(_git_snap + o) != 0)) { o = o + 1; }
    if ((o >= end) || ((o - bo) >= GIT_BRANCH_CAP)) { return 0; }
    _git_bufs();
    memcpy(_git_branch_buf, _git_snap + bo, o - bo + 1);
    o = o + 1;
    var off = 0;
    var i = 0;
    while (i < cnt) {
        if (o >= end) { return 0; }
        var kind = load8(_git_snap + o);
        o = o + 1;
        var ps = o;
        while ((o < end) && (load8(_git_snap + o) != 0)) { o = o + 1; }
        if (o >= end) { return 0; }
        var pl = o - ps;
        if ((off + pl + 1) > GIT_STATUS_BUF) { return 0; }
        memcpy(_git_status_buf + off, _git_snap + ps, pl + 1);
        store64(_git_status_ptr + i * 8, _git_status_buf + off);
        store8(_git_status_kind + i, kind);
        off = off + pl + 1;
        o = o + 1;
        i = i + 1;
    }
    _git_status_n = cnt;
    _git_present = load64(_git_snap);
    _git_detached = load64(_git_snap + 8);
    _git_dirty = load64(_git_snap + 16);
    return 1;
}

fn _git_child(rd, wr) {
    sys_close(rd);
    # Only this thread exists here. A left network worker that held the allocator's lock at the fork will never release it.
    store64(&_alloc_lock, 0);
    if (_git_child_fail == 1) { sys_exit(3); }
    if (_git_child_fail == 2) { sleep_ms(1500); sys_exit(3); }
    _git_walk();
    var n = _git_snap_build();
    var o = 0;
    while (o < n) {
        var w = sys_write(wr, _git_snap + o, n - o);
        if (w == (0 - 4)) { continue; }
        if (w <= 0) { sys_exit(1); }
        o = o + w;
    }
    sys_exit(0);
    return 0;
}

fn git_probe_pending() { if (_git_job_pid != 0) { return 1; } return 0; }

# git_probe_begin: start the walk in a child. 1 when one is running (this one, or one already out); 0 when there is no fork to be had.
fn git_probe_begin() {
    _git_probed = 1;
    if (_git_job_pid != 0) { return 1; }
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    if (_git_snap == 0) { _git_snap = alloc(GIT_SNAP_CAP); }
    if (_git_snap == 0) { return 0; }
    _git_bufs();
    var p[16];
    if (sys_pipe(&p) < 0) { return 0; }
    var rd = load32(&p);
    var wr = load32(&p + 4);
    sys_fcntl(rd, F_SETFD, FD_CLOEXEC);
    sys_fcntl(wr, F_SETFD, FD_CLOEXEC);
    var pid = sys_fork();
    if (pid < 0) { sys_close(rd); sys_close(wr); return 0; }
    if (pid == 0) { _git_child(rd, wr); }
    sys_close(wr);
    sys_fcntl(rd, F_SETFL, _fd_o_nonblock());
    _git_job_pid = pid;
    _git_job_fd = rd;
    _git_job_t0 = clock_now_ms();
    _git_snap_n = 0;
    return 1;
    #endif
    #endif
}

# _git_job_end: reap the child and drop the job. `kill`: it outlived its deadline.
fn _git_job_end(kill) {
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    var st[4];
    if (kill == 1) { sys_kill(_git_job_pid, 9); }
    sys_waitpid(_git_job_pid, &st, 0);
    #endif
    #endif
    sys_close(_git_job_fd);
    _git_job_pid = 0;
    _git_job_fd = 0 - 1;
    return 0;
}

# git_probe_land: read what the child has sent. 1 once the probe has ended, the cache updated if it ended well; 0 while it runs.
fn git_probe_land() {
    if (_git_job_pid == 0) { return 0; }
    var room = GIT_SNAP_CAP - _git_snap_n;
    while (room > 0) {
        var n = sys_read(_git_job_fd, _git_snap + _git_snap_n, room);
        if (n == 0) {
            _git_job_end(0);
            _git_snap_apply();
            return 1;
        }
        if (n < 0) {
            if ((clock_now_ms() - _git_job_t0) >= GIT_PROBE_MS) { _git_job_end(1); return 1; }
            return 0;
        }
        _git_snap_n = _git_snap_n + n;
        room = room - n;
    }
    _git_job_end(1);                   # more than a snapshot holds: not one
    return 1;
}

# git_probe: (re)read the working repo, and wait for the answer. The surface stays alive through the wait, and a stop leaves it: the
# cache answers for now, and the surface's loop lands the walk when it ends. 1 if a repo is present.
fn git_probe() {
    _git_probed = 1;
    if (git_probe_begin() == 0) { return _git_walk(); }
    var gen0 = 0;
    if (_git_wait_poll != 0) { gen0 = fncall0(_git_wait_poll); }
    while (git_probe_land() == 0) {
        fd_wait_ready(_git_job_fd, 0, 50);
        if (_git_wait_poll != 0) {
            if (fncall0(_git_wait_poll) != gen0) { return _git_present; }
        }
    }
    return _git_present;
}

# git_not_compared: how many cached files sit could not compare. A tree with these is not known clean, though nothing was seen to change.
fn git_not_compared() {
    var n = 0;
    var i = 0;
    while (i < _git_status_n) {
        if (load8(_git_status_kind + i) == GIT_NOT_COMPARED) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# git_status_of: the sit status kind for repo-relative `relpath` — 1=modified, 2=new, 3=deleted, 4=not compared, or 0 if
# unchanged / untracked-by-status / no repo. Linear scan over the cached probe (bounded by GIT_STATUS_MAX).
# Read-only surfacing of the already-probed status (the file-tree badges, 0.22.4) — no new worktree walk.
fn git_status_of(relpath) {
    if (_git_present == 0) { return 0; }
    var i = 0;
    while (i < _git_status_n) {
        if (streq(load64(_git_status_ptr + i * 8), relpath) == 1) { return load8(_git_status_kind + i); }
        i = i + 1;
    }
    return 0;
}

# git_ensure_probed: probe once lazily, for any reader that runs before the
# startup probe (idempotent; cheap after the first call). A surface starts its probe with git_probe_begin, which counts.
fn git_ensure_probed() {
    if (_git_probed == 0) { git_probe(); }
    return 0;
}

fn git_present() { return _git_present; }
fn git_detached() { return _git_detached; }
fn git_dirty() { return _git_dirty; }
fn git_branch() {
    if (_git_branch_buf == 0) { return "?"; }
    return _git_branch_buf;
}
