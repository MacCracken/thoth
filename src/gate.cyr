# thoth — the t-ron authorization gate (M4).
#
# t-ron owns MCP per-tool authorization — the security gate around the very
# file-edits, shell commands, and MCP tool calls the agent runs. thoth
# consumes it IN-PROCESS via the vendored dist bundle (src/vendor/t-ron.cyr):
# policy engine, rate limiter, payload scanner, pattern analyzer, audit chain
# (libro). thoth owns none of that logic; this module only binds it.
#
# The seam binds when thoth.cyml [tron].policy names a policy TOML that loads
# cleanly. Without it the seam is ABSENT and authorization falls back to the
# built-in fail-closed confirm prompt (deny by default) — degraded honestly
# and announced, never silent. With it, every gated action becomes a t-ron
# ToolCall: deny refuses outright (no prompt can override policy), flag falls
# back to the interactive confirm, allow proceeds. t-ron's own defaults deny
# unknown agents and unknown tools — fail closed end to end.
#
# Built-in actions are authorized under reserved tool names so a policy can
# target them: thoth_run (the /run shell escape), thoth_write (/write),
# thoth_remember (/remember + the model memory_write), thoth_shell (the model
# shell tool), thoth_edit (the model `edit` tool — 0.31.0; kept distinct from
# thoth_write so a policy can allow the operator's /write yet deny model edits).
# MCP tool calls are authorized under their real tool name BEFORE any request
# leaves thoth.

var _gate_tron = 0;          # TRon instance, or 0 -> seam absent

# gate_active: 1 if the t-ron seam is bound (policy loaded), else 0.
fn gate_active() {
    if (_gate_tron == 0) { return 0; }
    return 1;
}

# The confirm-bracket hooks (TUI-decoupling refactor): the interactive confirm below runs INSIDE the captured
# T2 dispatch window (OUT_RING), so the rich TUI must drop to the live screen around the prompt (seal + repaint
# the feed, move the cursor to the composer, resume capture after). That bracket is pure PRESENTATION — gate no
# longer calls tui.cyr for it; the renderer registers its begin/end here at startup. Unregistered (REPL/piped,
# and the test binary) -> skipped, and this path is byte-identical to before (capturing==1 only in the TUI).
var _confirm_begin_fn = 0;
var _confirm_end_fn = 0;
fn confirm_hooks_set(bf, ef) { _confirm_begin_fn = bf; _confirm_end_fn = ef; return 0; }

# --- session grants (0.40.0, T1-6) -------------------------------------------------------------------
#
# WHY. `confirm` was STATELESS: the same action re-prompted on every round of the agentic loop. On an
# 8-round turn with a gated tool that is eight identical y/N prompts for the same command — which does not
# make the user safer, it trains them to hammer 'y' without reading. A prompt that is always answered the
# same way has stopped being a decision. Every surveyed peer solved this the same way: an "allow for the
# rest of this session" answer.
#
# ⚠ THE BOUNDARIES, because this is a security control and widening it quietly would be the whole risk:
#
#  * SESSION-SCOPED ONLY. Never written to disk, never survives exit. A durable grant is a POLICY, and
#    policy is t-ron's domain ([tron].policy) — thoth must not grow a shadow policy file that t-ron cannot
#    see, audit, or rate-limit.
#  * EXACT MATCH on (verb, obj), not a pattern. Granting `shell` + `cargo test` allows re-running exactly
#    that command; it does not allow `cargo test; rm -rf /`. Peers offer pattern grants (opencode's
#    last-match-wins bash globs); thoth deliberately does not, because a glob over a shell command string
#    is the same weak control `src/shell.cyr` already refuses to call a sandbox.
#  * NEVER OVERRIDES A t-ron DENY. Grants live inside `confirm`, which a DENY verdict never reaches —
#    `gate_authorize` returns 0 before it. A grant can only ever resolve a FLAG or the seam-absent
#    fail-closed prompt, exactly what a human 'y' resolved before.
#  * ANNOUNCED, NEVER SILENT. An auto-allowed action still prints a line naming the grant, so the user can
#    see what their earlier answer is still doing. A silent auto-allow would be indistinguishable from no
#    gate at all.
var GRANT_MAX = 32;               # bounded; a session that needs more than 32 distinct grants wants a policy
var GRANT_VERB_CAP = 64;
var GRANT_OBJ_CAP = 512;          # a shell command can be long; longer than this is simply not grantable
var _grant_n = 0;
var _grant_verbs = 0;             # GRANT_MAX * GRANT_VERB_CAP
var _grant_objs = 0;              # GRANT_MAX * GRANT_OBJ_CAP

fn _grant_bufs() {
    if (_grant_verbs == 0) { _grant_verbs = alloc(GRANT_MAX * GRANT_VERB_CAP); }
    if (_grant_objs == 0) { _grant_objs = alloc(GRANT_MAX * GRANT_OBJ_CAP); }
    if (_grant_verbs == 0) { return 0; }
    if (_grant_objs == 0) { return 0; }
    return 1;
}

# grant_count / grant_verb_at / grant_obj_at: the read surface (/grants renders through these).
fn grant_count() { return _grant_n; }
fn grant_verb_at(i) { if (i < 0) { return ""; } if (i >= _grant_n) { return ""; } return _grant_verbs + i * GRANT_VERB_CAP; }
fn grant_obj_at(i) { if (i < 0) { return ""; } if (i >= _grant_n) { return ""; } return _grant_objs + i * GRANT_OBJ_CAP; }

# grants_clear: drop every session grant. Bound to /grants clear, and called by /reset — a user resetting
# the session state expects the answers they gave it to go too.
fn grants_clear() { _grant_n = 0; return 0; }

# _grant_has: 1 if (verb, obj) was granted this session. EXACT match on both.
fn _grant_has(verb, obj) {
    if (_grant_n == 0) { return 0; }
    if (_grant_bufs() == 0) { return 0; }
    var i = 0;
    while (i < _grant_n) {
        if (streq(_grant_verbs + i * GRANT_VERB_CAP, verb) == 1) {
            if (streq(_grant_objs + i * GRANT_OBJ_CAP, obj) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# _grant_add: record (verb, obj). Refuses (returning 0) when the table is full or either string is too
# long to store — and the caller then treats the answer as a plain one-shot 'yes'. Fail CLOSED on the
# GRANT, never on the buffer: a truncated grant would match actions the user never approved.
fn _grant_add(verb, obj) {
    if (_grant_bufs() == 0) { return 0; }
    if (_grant_n >= GRANT_MAX) { return 0; }
    if (strlen(verb) >= GRANT_VERB_CAP) { return 0; }
    if (strlen(obj) >= GRANT_OBJ_CAP) { return 0; }
    if (_grant_has(verb, obj) == 1) { return 1; }
    var vd = _grant_verbs + _grant_n * GRANT_VERB_CAP;
    var od = _grant_objs + _grant_n * GRANT_OBJ_CAP;
    var i = 0;
    while (load8(verb + i) != 0) { store8(vd + i, load8(verb + i)); i = i + 1; }
    store8(vd + i, 0);
    var j = 0;
    while (load8(obj + j) != 0) { store8(od + j, load8(obj + j)); j = j + 1; }
    store8(od + j, 0);
    _grant_n = _grant_n + 1;
    return 1;
}
# --- a front end that owns the screen (0.44.3) ------------------------------------------------------
# The T3 GUI has no terminal to prompt on, but it DOES have a modal (0.44.0's `gui_ask`, over the ask
# seam). It declares that here at its own startup, like the ask hook itself — `confirm` cannot infer it
# from out_mode, because the GUI's turn runs under OUT_NULL and its command dispatch under OUT_RING.
var _confirm_no_tty = 0;
fn confirm_no_tty_set(v) { _confirm_no_tty = v; return 0; }

# _confirm_via_ask: the authorization prompt, posed through the front end's own modal. The three answers
# are the same three the terminal path offers; `ask_resolve` maps a bare "1"/"2"/"3" onto them and the
# y/a free-text forms still match. A cancelled prompt is a DENY — a dismissed modal is not consent.
fn _confirm_via_ask(verb, obj) {
    if (_ask_q_buf == 0) { _ask_q_buf = alloc(CONFIRM_Q_CAP); }
    if (_ask_q_buf == 0) { return 0; }
    var off = 0;
    if (gate_active() == 0) { off = _append_cstr_cap(_ask_q_buf, off, CONFIRM_Q_CAP, "Authorize this action? (t-ron absent - thoth is asking because nothing else can)\n"); }
    else { off = _append_cstr_cap(_ask_q_buf, off, CONFIRM_Q_CAP, "Authorize this action? (t-ron flagged it for confirmation)\n"); }
    off = _append_cstr_cap(_ask_q_buf, off, CONFIRM_Q_CAP, _confirm_verb_buf);
    off = _append_cstr_cap(_ask_q_buf, off, CONFIRM_Q_CAP, " ");
    off = _append_cstr_cap(_ask_q_buf, off, CONFIRM_Q_CAP, _confirm_obj_buf);
    store8(_ask_q_buf + off, 0);
    # ⚠ NO SESSION-GRANT OPTION ON THIS PATH, deliberately. A grant is durable authority, and the two
    # things that make one safe — being able to SEE that it is still acting (`note_println` goes to a
    # stderr the window cannot show) and being able to REVOKE it (`/grants`) — are both unreachable from
    # inside the T3 window, whose composer runs cmd_task directly and routes no slash commands. Offering
    # it here would let authority accumulate somewhere the operator can neither review nor clear, which
    # is the opposite of the posture the rest of this file takes. Re-offer it when the GUI routes slash
    # commands (roadmap: "GUI slash-command affordances"); until then the operator re-approves, which
    # costs a keystroke and hides nothing.
    if (ask_pose(_ask_q_buf, "no", "yes, once", 0) == 0) {
        log_begin("authz"); log_kv_str("tool", obj); log_kv_str("gate", "modal");
        log_kv_str("verdict", "deny"); log_kv_str("reason", "cancelled"); log_commit(SK_WARN);
        return 0;
    }
    var a = ask_answer_buf();
    if (streq(a, "yes, once") == 1) { return 1; }
    if ((streq(a, "y") == 1) || (streq(a, "Y") == 1) || (streq(a, "yes") == 1)) { return 1; }
    log_begin("authz"); log_kv_str("tool", obj); log_kv_str("gate", "modal"); log_kv_str("verdict", "deny"); log_commit(SK_INFO);
    return 0;
}

# _confirm_grant_yes: the "allow for the session" answer, shared by both confirm paths so the terminal
# and the modal cannot drift on what a grant means (or on the degrade when the table is full).
fn _confirm_grant_yes(verb, obj) {
    if (_grant_add(verb, obj) == 1) { note_println("  [granted for this session - /grants to review or clear]"); }
    else { note_println("  [allowed once; not grantable (grant table full or the command is too long)]"); }
    return 1;
}
var CONFIRM_Q_CAP = 1024;
var _ask_q_buf = 0;

# ⚠ 0.44.3 — THE PROMPT'S OWN TEXT WAS UNTRUSTED AND UNFILTERED. `obj` is the thing being authorized:
# the model's chosen shell command, or a tool name a third-party MCP server picked. `confirm` printed it
# with a bare `emit`, one line above the y/N the operator answers — so the party the decision is ABOUT
# controlled the bytes of the decision. A `\r` plus a cursor move is enough to overwrite the verb, hide
# the real command, or paint a fake "[t-ron: allowed]" line under the prompt. This is the same class the
# 0.39.0 audit closed for filenames (A-7/A-8) and its own theme names exactly: a boundary applied at one
# sink and not its sibling. Both halves now go through the house sanitiser before they are drawn, on
# EVERY confirm path — terminal, modal, and the two stderr denials.
var CONFIRM_LABEL_CAP = 512;
var _confirm_verb_buf = 0;
var _confirm_obj_buf = 0;
# _confirm_labels: sanitise (verb, obj) into stable buffers for display. Returns 0 on OOM, in which case
# the caller must fall through to a DENY — refusing to draw a prompt we cannot draw safely is the
# fail-closed answer, and it is the same posture the jail takes when it cannot check a path.
fn _confirm_labels(verb, obj) {
    if (_confirm_verb_buf == 0) { _confirm_verb_buf = alloc(CONFIRM_LABEL_CAP); }
    if (_confirm_obj_buf == 0) { _confirm_obj_buf = alloc(CONFIRM_LABEL_CAP); }
    if (_confirm_verb_buf == 0) { return 0; }
    if (_confirm_obj_buf == 0) { return 0; }
    safe_label_copy(_confirm_verb_buf, CONFIRM_LABEL_CAP, verb);
    safe_label_copy(_confirm_obj_buf, CONFIRM_LABEL_CAP, obj);
    return 1;
}


# confirm: fail-closed interactive authorization — the stand-in when the
# t-ron seam is absent, and the resolution for a t-ron FLAG verdict. Names
# the exact object being authorized (verb + obj) so the answer is informed.
# Returns 1 ONLY on explicit y/yes; default (empty/EOF/other) DENIES.
fn confirm(verb, obj) {
    # One-shot/argv mode is non-interactive: stdin is the piped payload or absent, and
    # the prompt would be discarded under OUT_NULL. Degrade CLOSED — deny, and say so
    # on stderr so the refusal is never silent. (Piped stdin already EOFs to a deny
    # below; this also covers a tty one-shot, where read_line would otherwise block on
    # an invisible prompt.)
    # 0.40.0 (T1-6): an existing session grant resolves this without asking again — but SAYS SO, every
    # time. A silent auto-allow is indistinguishable from having no gate; the user must be able to see
    # that an answer they gave earlier is still acting. Checked BEFORE the non-interactive branches so a
    # grant made interactively still holds if the surface later changes.
    if (_grant_has(verb, obj) == 1) {
        ui_emit(ROLE_GREEN, "  [session grant] "); emit(verb); emit(" "); emit(obj);
        ui_emit(ROLE_MUTED, "  (/grants to review or clear)"); oprintln("");
        log_begin("authz"); log_kv_str("gate", "session_grant"); log_kv_str("verb", verb); log_kv_int("allow", 1); log_commit(SK_INFO);
        return 1;
    }
    if (one_shot_active() == 1) {
        emit_err("  [authorization required: "); emit_err(verb); emit_err(" "); emit_err(obj);
        emit_err(" — denied; one-shot is non-interactive. configure [tron].policy or run interactively]\n");
        return 0;
    }
    # ⚠ 0.39.0 (audit A-11): the SAME reasoning as one-shot, for the surface that had been missed. The T3
    # GUI wraps its turn in OUT_NULL (src/gui/gpresent.cyr) because the window, not the terminal, is the
    # output surface — so every byte of the prompt below is DISCARDED, and then `read_line` blocks on
    # stdin that nobody is typing into. The GUI has no modal to render this in and no path from evdev to
    # `read_line`, so the turn hung FOREVER on any gated tool with no [tron].policy loaded, which is the
    # default. It presented as a frozen window with no visible cause. Deny instead: there is no surface
    # on which a human could answer, and an unanswerable prompt must fail closed rather than deadlock.
    # (OUT_RING — the T2 TUI — is deliberately NOT caught here: it has confirm hooks that bracket back to
    # the live screen precisely so the prompt IS visible, which is the case immediately below.)
    # ⭐ 0.44.3 — THE GUI CAN ANSWER NOW, AND THE COMMENT ABOVE IS STALE. It rests on "the GUI has no
    # modal and no path from evdev to read_line"; 0.44.0 built exactly that pair. Leaving the deny made
    # every gated action permanently refused in T3 (edit/create_file/shell/remember + every MCP tool),
    # with the reason on a stderr the window cannot show and no way to grant authority from inside it —
    # a security control INERT on one surface, which the house rules count as a gap, not a degrade.
    # Sanitise BEFORE any branch draws either string. On OOM there is no safe way to render the prompt,
    # so the answer is the fail-closed one — a denial we can explain beats a prompt we cannot trust.
    if (_confirm_labels(verb, obj) == 0) {
        emit_err("  [authorization required — denied; the prompt could not be prepared (out of memory)]\n");
        return 0;
    }
    if (_confirm_no_tty == 1) {
        if (ask_hook_active() == 1) { return _confirm_via_ask(verb, obj); }
        emit_err("  [authorization required: "); emit_err(_confirm_verb_buf); emit_err(" "); emit_err(_confirm_obj_buf);
        emit_err(" — denied; this surface registered no way to ask. configure [tron].policy to authorize it]\n");
        return 0;
    }
    if (out_mode() == OUT_NULL) {
        emit_err("  [authorization required: "); emit_err(_confirm_verb_buf); emit_err(" "); emit_err(_confirm_obj_buf);
        emit_err(" — denied; this surface cannot prompt. configure [tron].policy to authorize it]\n");
        return 0;
    }
    # In the T2 TUI, dispatch output is captured into the feed ring (OUT_RING);
    # bracket back to the live screen so this prompt and its cooked y/n echo are
    # VISIBLE rather than buried in the ring. Off the TUI (REPL/piped, OUT_FD1)
    # both hooks are skipped and this path is byte-identical to before.
    var capturing = (out_mode() == OUT_RING);
    if ((capturing == 1) && (_confirm_begin_fn != 0)) { fncall0(_confirm_begin_fn); }
    if (gate_active() == 0) { ui_emit(ROLE_ACCENT, "  [t-ron absent: fail-closed] authorize "); }
    else { ui_emit(ROLE_ACCENT, "  [t-ron flag: confirm] authorize "); }
    emit(_confirm_verb_buf); emit(" "); emit(_confirm_obj_buf);
    emit("? [y/N/a=allow all session] ");
    var ans[64];
    var n = read_line(&ans, 64);
    if ((capturing == 1) && (_confirm_end_fn != 0)) { fncall0(_confirm_end_fn); }
    if (n <= 0) { return 0; }
    # 'a' = yes, AND remember this exact (verb, obj) for the rest of the session. If the grant cannot be
    # stored (table full, or either string over its cap) the answer degrades to a plain one-shot yes —
    # never to a truncated grant, which would match actions the user never approved.
    if ((streq(&ans, "a") == 1) || (streq(&ans, "A") == 1)) { return _confirm_grant_yes(verb, obj); }
    if (streq(&ans, "y") == 1) { return 1; }
    if (streq(&ans, "Y") == 1) { return 1; }
    if (streq(&ans, "yes") == 1) { return 1; }
    return 0;
}

# gate_init: bind the t-ron seam if thoth.cyml names a loadable policy. Call
# once at startup, after config_load. Announces failures honestly; a broken
# policy file leaves the seam ABSENT (fail closed to the confirm prompt), it
# never half-loads. I/O (reads the policy file).
fn gate_init() {
    var path = config_tron_policy();
    if (path == 0) { return 0; }
    var t = tron_new(tron_config_default());
    var rc = tron_load_policy_file(t, path);
    if (rc != TRON_ERR_NONE) {
        emit("t-ron: policy '"); emit(path);
        if (rc == TRON_ERR_IO) { oprintln("' unreadable — seam stays absent (fail-closed confirm gate)."); }
        else { oprintln("' failed to parse — seam stays absent (fail-closed confirm gate)."); }
        return 0;
    }
    _gate_tron = t;
    emit("t-ron: policy loaded from "); emit(path);
    emit(" (agent '"); emit(config_tron_agent()); oprintln("')");
    return 1;
}

# gate_verdict: run one t-ron check. Returns the verdict kind (VK_ALLOW /
# VK_DENY / VK_FLAG). Caller must ensure gate_active() == 1. The params are
# NUL-terminated JSON text (or a plain string — t-ron scans it as payload).
# _gate_verdict_err: in one-shot mode the verdict chrome below is discarded (OUT_NULL),
# so mirror a DENY/FLAG label + reason to stderr — a refusal/flag must be announced, not
# silently swallowed (announce, never fake). No-op off one-shot. 0.11.0.
fn _gate_verdict_err(label, reason) {
    if (one_shot_active() == 0) { return 0; }
    emit_err("  [t-ron] "); emit_err(label); emit_err(": ");
    if (reason != 0) { emit_err(reason); } else { emit_err("(no reason)"); }
    emit_err("\n");
    return 0;
}

fn gate_verdict(tool_name, params) {
    var p = params;
    if (p == 0) { p = "{}"; }
    var call = tool_call_new(config_tron_agent(), tool_name, p, clock_now_ns());
    var v = tron_check(_gate_tron, call);
    var k = verdict_kind(v);
    if (k == VK_DENY) {
        ui_emit(ROLE_RED, "  [t-ron] DENY: ");
        var reason = verdict_reason(v);
        if (reason != 0) { oprintln(reason); } else { oprintln("(no reason)"); }
        _gate_verdict_err("DENY", reason);
    }
    if (k == VK_FLAG) {
        ui_emit(ROLE_ACCENT, "  [t-ron] FLAG: ");
        var freason = verdict_reason(v);
        if (freason != 0) { oprintln(freason); } else { oprintln("(no reason)"); }
        _gate_verdict_err("FLAG", freason);
    }
    return k;
}

# gate_authorize: the single authorization choke point for every dangerous
# action. Returns 1 to proceed, 0 to refuse.
#   - t-ron bound:  allow -> 1; deny -> 0 (policy is final — no prompt can
#     override it); flag -> interactive confirm (deny by default).
#   - t-ron absent: the built-in fail-closed confirm prompt (deny by default),
#     announced as the stand-in it is.
fn gate_authorize(tool_name, params, verb, obj) {
    if (gate_active() == 0) {
        var ok = confirm(verb, obj);
        log_begin("authz"); log_kv_str("tool", tool_name); log_kv_str("gate", "confirm");
        log_kv_int("allow", ok); log_commit(SK_INFO);
        return ok;
    }
    var k = gate_verdict(tool_name, params);
    if (k == VK_ALLOW) {
        ui_emit(ROLE_GREEN, "  [t-ron] allow: "); emit(verb); emit(" "); oprintln(obj);
        log_begin("authz"); log_kv_str("tool", tool_name); log_kv_str("verdict", "allow");
        log_commit(SK_INFO);
        return 1;
    }
    if (k == VK_FLAG) {
        var okf = confirm(verb, obj);
        log_begin("authz"); log_kv_str("tool", tool_name); log_kv_str("verdict", "flag");
        log_kv_int("allow", okf); log_commit(SK_WARN);
        return okf;
    }
    log_begin("authz"); log_kv_str("tool", tool_name); log_kv_str("verdict", "deny");
    log_commit(SK_WARN);
    return 0;
}

# audit_kind_str: render a t-ron VerdictKind to a short label. Pure — the only
# glue thoth authors over the audit chain; the chain itself is t-ron's domain.
fn audit_kind_str(kind) {
    if (kind == VK_ALLOW) { return "allow"; }
    if (kind == VK_DENY)  { return "deny"; }
    if (kind == VK_FLAG)  { return "flag"; }
    return "?";
}

# gate_audit: the AuditLogger of the bound t-ron seam, or 0 when absent. Every
# tron_check (every gated action) logs to it — operational ring + libro chain.
fn gate_audit() {
    if (_gate_tron == 0) { return 0; }
    return tron_audit(_gate_tron);
}

# gate_audit_report: surface t-ron's in-process audit chain — the cryptographic
# (libro-backed) record of every gated action this session, plus the agent's
# rolling risk score and a tamper-check. Caller ensures gate_active() == 1.
# thoth owns none of this: it reads t-ron's query API and renders. I/O.
fn gate_audit_report() {
    var a = gate_audit();
    var total = query_total_events(a);
    oprintln("t-ron audit chain (libro-backed, in-process):");
    emit("  events  : "); ofmt_int(total); oprintln("");
    emit("  denials : "); ofmt_int(query_total_denials(a)); oprintln("");
    emit("  chain   : "); ofmt_int(audit_chain_len(a)); emit(" entries, ");
    if (audit_verify_chain(a) == 0) { oprintln("integrity OK"); }
    else { oprintln("INTEGRITY FAILED (tamper detected)"); }
    # risk score is basis points of 1000 (1000 = max); /10 renders as percent.
    var risk = query_agent_risk_score(a, config_tron_agent());
    emit("  risk    : agent '"); emit(config_tron_agent()); emit("' ");
    ofmt_int(risk / 10); emit("."); ofmt_int(risk % 10);
    oprintln("% (0=trusted, 100=max)");
    if (total == 0) {
        oprintln("  (no gated actions yet — run /write, /run, or /call)");
        return 0;
    }
    var recent = audit_recent(a, 10);
    var n = vec_len(recent);
    emit("  recent ("); ofmt_int(n); oprintln(", newest first):");
    var i = 0;
    while (i < n) {
        var e = vec_get(recent, i);
        emit("    #"); ofmt_int(security_event_id(e));
        emit(" ["); emit(audit_kind_str(security_event_kind(e))); emit("] ");
        emit(security_event_tool_name(e));
        var r = security_event_reason(e);
        if (r != 0 && load8(r) != 0) { emit(" — "); emit(r); }
        oprintln("");
        i = i + 1;
    }
    return 0;
}
