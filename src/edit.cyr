# src/edit.cyr — the model-invokable `edit` tool (0.31.0, ADR-0017): a first-class, jailed, t-ron-gated LOCAL
# file editor. The symmetric completion of the read_file/list_dir project tools (ADR-0015): thoth can now WRITE
# code, not only read it. Surgical semantics — edit(path, old_string, new_string) replaces the UNIQUE occurrence
# of old_string with new_string. If old_string is absent or matches more than once the edit is REFUSED (never
# applied): the model must give enough surrounding context to name exactly one site, so it can't blind-clobber.
#
# Safety (writing is consequential, so it degrades CLOSED at every layer):
#  - opt-in: advertised only when [edit].enabled (config_edit_enabled) — off by default, like [shell].enabled.
#  - jailed: _project_jail_ok confines writes to the launch cwd (RELATIVE, no '/', '~', '..'). Deliberately NOT
#    _project_read_ok — a write must never follow the user's read-only /allow grants (that would let the model
#    write into vidya or another repo opened only for reading; a write-roots grant would need its own key).
#  - gated: gate_authorize("thoth_edit", ...) — a DISTINCT reserved verb from thoth_write (/write) so a policy
#    can allow the operator's /write yet deny model edits (the thoth_run/thoth_shell split precedent). An absent
#    t-ron seam falls to the fail-closed confirm.
#  - link-safe (0.39.0): _project_no_symlink refuses a path ANY of whose components is a symlink. This was
#    the standing RESIDUAL — "a symlink INSIDE the project pointing outside is followed (no portable
#    O_NOFOLLOW) — more dangerous for a write than a read" — and the 0.39.0 audit CLOSED it. The premise had
#    gone stale: `lib/fs.cyr` ships a portable `is_symlink` (readlink-based, linux/macos/agnos), so the
#    boundary no longer has to be lexical-only. The jail is still a boundary, not a sandbox — but it no
#    longer hands a malicious repo an arbitrary-file WRITE through a checked-in link.
#
# PURE core (_edit_apply) unit-tested; the tool wrapper does the parse/jail/gate/read/apply/write. Local +
# forced-serial in the agent loop (never forwarded to daimon). Cyrius forward-refs diff_stats/_params_one
# (defined in later-included files) — resolved whole-unit, exactly as shell.cyr forward-refs _params_one.

var EDIT_BUF_CAP = 262144;    # 256 KB per side (old snapshot + new content); over-cap -> honest refusal, never a truncated write
var EDIT_RES_CAP = 1024;      # the summary string returned to the model
var _edit_old = 0;
var _edit_new = 0;
var _edit_res = 0;
var _edit_last_allowed = 0;   # 1 if the last edit_tool call passed jail+gate (read by the dispatch for roundlog)
var _edit_last_ok = 0;        # 1 if the last edit_tool call actually applied + wrote
fn edit_last_allowed() { return _edit_last_allowed; }
fn edit_last_ok() { return _edit_last_ok; }

# The last APPLIED edit's path + the old/new byte buffers + lengths (0.31.1), so the dispatch can hand them to
# editlog_record immediately after a successful edit (before the next edit reuses _edit_old/_edit_new). Valid
# only when edit_last_ok()==1.
var EDIT_LPATH_CAP = 512;
var _edit_last_path = 0;
var _edit_last_oldlen = 0;
var _edit_last_newlen = 0;
fn edit_last_path()    { if (_edit_last_path == 0) { return ""; } return _edit_last_path; }
fn edit_last_old()     { return _edit_old; }
fn edit_last_old_len() { return _edit_last_oldlen; }
fn edit_last_new()     { return _edit_new; }
fn edit_last_new_len() { return _edit_last_newlen; }

# _edit_mem_eq: 1 if the n bytes at a and b are equal. Pure.
fn _edit_mem_eq(a, b, n) {
    var i = 0;
    while (i < n) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# _edit_apply: surgical single-occurrence replacement. Writes old[0..oldlen) with the UNIQUE occurrence of oldstr
# replaced by newstr into out (bounded by outcap). Returns the new length (>= 0), or a negative code:
#   -1 not found, -2 not unique (ambiguous), -3 result exceeds outcap, -4 oldstr empty (refused).
# Pure — no I/O. The uniqueness rule is the safety contract: the model must name exactly one site.
fn _edit_apply(old, oldlen, oldstr, oldstrlen, newstr, newstrlen, out, outcap) {
    if (oldstrlen <= 0) { return 0 - 4; }
    var first = 0 - 1;
    var count = 0;
    var i = 0;
    while (i <= (oldlen - oldstrlen)) {
        if (_edit_mem_eq(old + i, oldstr, oldstrlen) == 1) {
            if (first < 0) { first = i; }
            count = count + 1;
            i = i + oldstrlen;                 # non-overlapping scan
        } else {
            i = i + 1;
        }
    }
    if (count == 0) { return 0 - 1; }
    if (count > 1) { return 0 - 2; }
    var tail = first + oldstrlen;
    var newlen = first + newstrlen + (oldlen - tail);
    if (newlen > outcap) { return 0 - 3; }
    var o = 0;
    var k = 0;
    while (k < first) { store8(out + o, load8(old + k)); o = o + 1; k = k + 1; }        # prefix
    k = 0;
    while (k < newstrlen) { store8(out + o, load8(newstr + k)); o = o + 1; k = k + 1; } # replacement
    k = tail;
    while (k < oldlen) { store8(out + o, load8(old + k)); o = o + 1; k = k + 1; }        # suffix
    return newlen;
}

# _edit_puts / _edit_puti: bounded append into the result buffer at offset o; return the new offset.
fn _edit_puts(o, s) {
    var i = 0;
    while ((load8(s + i) != 0) && (o < (EDIT_RES_CAP - 1))) { store8(_edit_res + o, load8(s + i)); o = o + 1; i = i + 1; }
    return o;
}
fn _edit_puti(o, n) {
    var tmp[32];                            # fmt_int_buf uses a FIXED 24-byte scratch window (writes buf[0..23]
    var len = fmt_int_buf(n, &tmp);         # regardless of magnitude) — format into a dedicated stack buffer, never
    store8(&tmp + len, 0);                  # mid-_edit_res (a long path could otherwise drive o near the cap and OOB).
    return _edit_puts(o, &tmp);             # then append the digits with the per-byte bounded copy.
}

# _edit_summary: build "(edit: <path> - +A -D lines, N bytes written)" into _edit_res (diff_stats gives the
# add/del counts; -1 over the diff line cap -> counts omitted honestly). Returns the buffer.
fn _edit_summary(path, ob, ol, nb, nl, wr) {
    var packed = diff_stats(ob, ol, nb, nl);
    var o = 0;
    o = _edit_puts(o, "(edit: ");
    o = _edit_puts(o, path);
    if (packed >= 0) {
        o = _edit_puts(o, " - +");
        o = _edit_puti(o, packed / 1000000);
        o = _edit_puts(o, " -");
        o = _edit_puti(o, packed - (packed / 1000000) * 1000000);
        o = _edit_puts(o, " lines,");
    }
    o = _edit_puts(o, " ");
    o = _edit_puti(o, wr);
    o = _edit_puts(o, " bytes written)");
    store8(_edit_res + o, 0);
    return _edit_res;
}

# _edit_stash_path: copy `path` into the stable _edit_last_path buffer, so the dispatch can hand it to
# editlog_record after a successful edit/create (0.31.1). Bounded to EDIT_LPATH_CAP.
fn _edit_stash_path(path) {
    if (_edit_last_path == 0) { _edit_last_path = alloc(EDIT_LPATH_CAP); }
    var pi = 0;
    while ((load8(path + pi) != 0) && (pi < (EDIT_LPATH_CAP - 1))) { store8(_edit_last_path + pi, load8(path + pi)); pi = pi + 1; }
    store8(_edit_last_path + pi, 0);
    return 0;
}

# _edit_do: the post-gate apply-to-disk half (0.31.0). Reads `path`, applies the surgical replacement, writes it
# back, sets _edit_last_ok, and returns the summary — OR an honest "(edit: ...)" refusal (no write) on any
# failure. The caller has ALREADY jailed + gated. Split out so the disk path is unit-testable without the gate
# (which denies in a non-interactive test). Sets only _edit_last_ok; the caller owns _edit_last_allowed.
fn _edit_do(path, oldstr, oldstrlen, newstr, newstrlen) {
    _edit_last_ok = 0;
    if (_edit_old == 0) { _edit_old = alloc(EDIT_BUF_CAP); }
    if (_edit_new == 0) { _edit_new = alloc(EDIT_BUF_CAP); }
    if (_edit_res == 0) { _edit_res = alloc(EDIT_RES_CAP); }
    if (file_exists(path) == 0) { return "(edit: file does not exist - use create_file to make a new file, or check the path)"; }
    var oldlen = file_read_all(path, _edit_old, EDIT_BUF_CAP - 1);
    if (oldlen < 0) { return "(edit: could not read the file)"; }
    if (oldlen >= (EDIT_BUF_CAP - 1)) { return "(edit: file too large (> 256KB) - refused rather than edit a truncated read)"; }
    var newlen = _edit_apply(_edit_old, oldlen, oldstr, oldstrlen, newstr, newstrlen, _edit_new, EDIT_BUF_CAP);
    if (newlen == (0 - 1)) { return "(edit: old_string not found in the file)"; }
    if (newlen == (0 - 2)) { return "(edit: old_string is not unique - it matches more than once; add surrounding context so it names exactly one location)"; }
    if (newlen == (0 - 3)) { return "(edit: the edited result would exceed the 256KB buffer)"; }
    if (newlen < 0) { return "(edit: could not apply the edit)"; }
    # 0.31.6: crash-safe atomic write (cyrius 6.4.57 file_write_atomic) — writes a unique sibling temp, loops
    # until every byte lands (partial-write-safe), fsyncs, then atomically renames over `path`. Returns 0 on
    # success, negative errno on any failure with the ORIGINAL file left intact (no more O_TRUNC-then-short-write
    # truncation — the NON-ATOMIC residual filed as the portable-atomic-write cyrius issue, now closed). ADR-0017.
    var rc = file_write_atomic(path, _edit_new, newlen);
    if (rc != 0) { return "(edit: the write to disk failed (disk full?) - the file is unchanged)"; }
    _edit_last_ok = 1;
    # 0.31.1: stash this edit's path + old/new lengths for editlog_record (the dispatch calls it right after,
    # before the next edit reuses _edit_old/_edit_new). _edit_old/_edit_new already hold the pre/post content.
    _edit_stash_path(path);
    _edit_last_oldlen = oldlen;
    _edit_last_newlen = newlen;
    return _edit_summary(path, _edit_old, oldlen, _edit_new, newlen, newlen);
}

# edit_tool: the agentic-loop entry. Parses {path, old_string, new_string}, jails, gates, then applies via
# _edit_do. Returns an honest "(edit: ...)" refusal string (with rl left DENIED / not-ok via the last_* flags)
# on any failure — never a partial write.
fn edit_tool(args_cstr) {
    _edit_last_allowed = 0;
    _edit_last_ok = 0;
    if (_edit_old == 0) { _edit_old = alloc(EDIT_BUF_CAP); }
    if (_edit_new == 0) { _edit_new = alloc(EDIT_BUF_CAP); }
    if (_edit_res == 0) { _edit_res = alloc(EDIT_RES_CAP); }
    if (args_cstr == 0) { return "(edit: missing arguments)"; }
    var v = bayan_json_v_parse_buf(args_cstr, strlen(args_cstr));
    if (v == 0) { return "(edit: arguments are not valid JSON)"; }
    var pv = bayan_json_v_obj_get(v, "path");
    if (pv == 0) { return "(edit: missing required string 'path')"; }
    var pvs = bayan_json_v_str(pv);
    if (pvs == 0) { return "(edit: 'path' must be a string)"; }
    var path = str_cstr(pvs);
    var ov = bayan_json_v_obj_get(v, "old_string");
    if (ov == 0) { return "(edit: missing required string 'old_string')"; }
    var ovs = bayan_json_v_str(ov);
    if (ovs == 0) { return "(edit: 'old_string' must be a string)"; }
    var oldstr = str_cstr(ovs);
    var oldstrlen = str_len(ovs);
    var nv = bayan_json_v_obj_get(v, "new_string");
    if (nv == 0) { return "(edit: missing required string 'new_string')"; }
    var nvs = bayan_json_v_str(nv);
    if (nvs == 0) { return "(edit: 'new_string' must be a string)"; }
    var newstr = str_cstr(nvs);
    var newstrlen = str_len(nvs);
    if (oldstrlen == 0) { return "(edit: 'old_string' must not be empty)"; }
    # jail FIRST (cheap deterministic boundary), then t-ron (the authority) — mirrors shell's filter-before-gate.
    if (_project_jail_ok(path) == 0) { return "(edit: refused - path is outside the project (no absolute, no '~', no '..'))"; }
    if (_project_no_symlink(path) == 0) { return "(edit: refused - a path component is a symlink; a write must not follow a link out of the project)"; }
    if (_project_sensitive(path) == 1) { return "(edit: refused - thoth's own config/state is not model-writable)"; }
    if (gate_authorize("thoth_edit", _params_one("path", path), "edit", path) == 0) { return "denied by authorization policy"; }
    _edit_last_allowed = 1;
    return _edit_do(path, oldstr, oldstrlen, newstr, newstrlen);
}

# --- create_file: make a NEW file (0.31.3) -----------------------------------------------------------------
# The create half of the write capability. CREATE-ONLY: it REFUSES if the file already exists, so it can never
# blind-clobber — modifying an existing file stays edit's surgical, diff-producing job. Same envelope as edit:
# opt-in [edit].enabled, jailed cwd-only, gated under the SAME thoth_edit verb (creating and editing are the same
# trust class — the model writing project files). Feeds editlog with old="" so the new file shows as all-GREEN
# additions on its card.

# _write_summary: "(create_file: <path> - created, N bytes)" into _edit_res.
fn _write_summary(path, clen) {
    var o = 0;
    o = _edit_puts(o, "(create_file: ");
    o = _edit_puts(o, path);
    o = _edit_puts(o, " - created, ");
    o = _edit_puti(o, clen);
    o = _edit_puts(o, " bytes)");
    store8(_edit_res + o, 0);
    return _edit_res;
}

# _write_do: the post-gate create-to-disk half. REFUSES an existing file (no clobber). Writes `content` (clen
# bytes) into a brand-new file, sets _edit_last_ok, and stashes {path, old="" (oldlen 0), new=content} for
# editlog_record (so the card diffs "" -> content = all adds). Caller has ALREADY jailed + gated. Unit-testable
# without the gate. content may be empty (creates an empty file).
fn _write_do(path, content, clen) {
    _edit_last_ok = 0;
    if (_edit_old == 0) { _edit_old = alloc(EDIT_BUF_CAP); }   # edit_last_old() must be a valid buffer (read for 0 bytes)
    if (_edit_new == 0) { _edit_new = alloc(EDIT_BUF_CAP); }
    if (_edit_res == 0) { _edit_res = alloc(EDIT_RES_CAP); }
    if (clen > (EDIT_BUF_CAP - 1)) { return "(create_file: content too large (> 256KB))"; }
    # 0.31.6: portable no-clobber create (cyrius 6.4.57 file_create_exclusive). Returns -EEXIST (-17) if the path
    # exists, else the new write fd. On POSIX this is O_CREAT|O_EXCL — the kernel refuses if the path exists
    # regardless of read permission (so it also covers the writable-but-UNREADABLE mode-0200 file that a plain
    # file_exists O_RDONLY probe would miss) and refuses to follow a trailing symlink. AGNOS (no exclusive-create
    # bit) and Windows (O_EXCL not yet mapped to CREATE_NEW) degrade to a file_exists pre-check + create — that
    # per-target handling now lives in the stdlib, not here.
    var fd = file_create_exclusive(path, 0x1A4);
    if (fd == (0 - 17)) { return "(create_file: that file already exists - use edit to modify it)"; }
    if (fd < 0) { return "(create_file: could not create the file (the path may be unwritable))"; }
    var wr = clen;
    if (clen > 0) { memcpy(_edit_new, content, clen); wr = file_write(fd, _edit_new, clen); }
    file_close(fd);
    if (wr != clen) { return "(create_file: the write to disk was incomplete (disk full?))"; }
    _edit_last_ok = 1;
    _edit_stash_path(path);
    _edit_last_oldlen = 0;                                      # new file -> empty "old" -> editlog shows all adds
    _edit_last_newlen = clen;
    return _write_summary(path, clen);
}

# create_file_tool: the agentic-loop entry. Parses {path, content}, jails, gates (thoth_edit), then creates via
# _write_do. Honest "(create_file: ...)" refusal on any failure.
fn create_file_tool(args_cstr) {
    _edit_last_allowed = 0;
    _edit_last_ok = 0;
    if (args_cstr == 0) { return "(create_file: missing arguments)"; }
    var v = bayan_json_v_parse_buf(args_cstr, strlen(args_cstr));
    if (v == 0) { return "(create_file: arguments are not valid JSON)"; }
    var pv = bayan_json_v_obj_get(v, "path");
    if (pv == 0) { return "(create_file: missing required string 'path')"; }
    var pvs = bayan_json_v_str(pv);
    if (pvs == 0) { return "(create_file: 'path' must be a string)"; }
    var path = str_cstr(pvs);
    var cv = bayan_json_v_obj_get(v, "content");
    if (cv == 0) { return "(create_file: missing required string 'content')"; }
    var cvs = bayan_json_v_str(cv);
    if (cvs == 0) { return "(create_file: 'content' must be a string)"; }
    var content = str_cstr(cvs);
    var clen = str_len(cvs);
    if (_project_jail_ok(path) == 0) { return "(create_file: refused - path is outside the project (no absolute, no '~', no '..'))"; }
    if (_project_no_symlink(path) == 0) { return "(create_file: refused - a path component is a symlink; a write must not follow a link out of the project)"; }
    if (_project_sensitive(path) == 1) { return "(create_file: refused - thoth's own config/state is not model-writable)"; }
    if (gate_authorize("thoth_edit", _params_one("path", path), "create", path) == 0) { return "denied by authorization policy"; }
    _edit_last_allowed = 1;
    return _write_do(path, content, clen);
}
