# thoth — input classification + command handlers.
#
# classify_input / token_is / arg_after are PURE and unit-tested. The cmd_*
# handlers do I/O. All of this is DRIVER logic: it dispatches to capability
# seams and local substrate built-ins; it never reimplements a spine domain.

enum Cmd {
    CMD_EMPTY = 0;
    CMD_HELP = 1;
    CMD_QUIT = 2;
    CMD_SEAMS = 3;
    CMD_STATE = 4;
    CMD_MODEL = 5;
    CMD_READ = 6;
    CMD_WRITE = 7;
    CMD_RUN = 8;
    CMD_UNKNOWN_SLASH = 9;
    CMD_TASK = 10;
    CMD_TOOLS = 11;
    CMD_CALL = 12;
    CMD_AUDIT = 13;
    CMD_RESET = 14;
    CMD_MODELS = 15;
    CMD_CLEAR = 16;
    CMD_THEME = 17;
    CMD_DRY = 18;
    CMD_REMEMBER = 19;
    CMD_GIT = 20;
    CMD_COPY = 21;
    CMD_FIND = 22;
    CMD_PERSONA = 23;
    CMD_PERSONAS = 24;
    CMD_ALLOW = 25;
    CMD_SAVE = 26;
    CMD_RELOAD = 27;
    CMD_ROLE = 28;
    CMD_REPROBE = 29;
    CMD_HISTORY = 30;
    CMD_NOTES = 31;
    CMD_CONVERSATIONS = 32;
    CMD_NEW = 33;
    CMD_SWITCH = 34;
    CMD_RENAME = 35;
    CMD_DELETE = 36;
    CMD_SEARCH = 37;
    CMD_RETRY = 38;
    CMD_EDIT = 39;
    CMD_BOOKMARK = 40;
    CMD_THUMBS = 41;
    CMD_GRANTS = 42;      # 0.40.0 (T1-6): review/clear the session's authorization grants
    CMD_COMPACT = 43;     # 0.40.0 (T1-5): force an overflow recap now
    CMD_CONTEXT = 44;     # 0.40.0 (T1-5): what is consuming the context window
    CMD_REWIND = 45;      # 0.40.0 (T1-4): undo the model's file writes
}

# token_is: 1 if line's first whitespace-delimited token equals word exactly.
fn token_is(line, word) {
    if (cstr_starts_with(line, word) == 0) { return 0; }
    var after = load8(line + strlen(word));
    if (after == 0) { return 1; }
    if (after == 32) { return 1; }
    return 0;
}

# arg_after: pointer to the first non-space char after the first token, or 0.
fn arg_after(line) {
    var i = 0;
    while (load8(line + i) != 0 && load8(line + i) != 32) { i = i + 1; }
    while (load8(line + i) == 32) { i = i + 1; }
    if (load8(line + i) == 0) { return 0; }
    return line + i;
}

# --- [alias] prompt macros (0.11.4) ---------------------------------------
# An alias lets the user define a slash macro in .thoth/config.cyml ([alias] name = "expansion").
# It resolves ONLY in the CMD_UNKNOWN_SLASH gap (so a built-in command always wins and an
# alias can never shadow one), expands to its text with any trailing args appended, and
# RE-DISPATCHES the result (so an alias can map to a built-in, a free-text task, even
# /quit — and an alias to /run/write/call still passes through the SAME t-ron gate, since
# the expansion goes back through dispatch). Recursion is bounded (cycle guard).
var ALIAS_MAX_DEPTH = 8;     # max alias-expansion chain depth (cycle / runaway guard)
var ALIAS_LINE_CAP = 1024;   # per-depth expanded-line buffer cap (bytes)
var ALIAS_NAME_CAP = 256;    # max alias-name length + 1 (a typed name is the token after '/')
var _alias_name[256];        # LITERAL size — MUST equal ALIAS_NAME_CAP
var _alias_bufs = 0;         # alloc(ALIAS_MAX_DEPTH * ALIAS_LINE_CAP), lazy: per-depth slices

# _alias_name_of: copy the bare alias token (the chars after '/' up to a space or nul) into
# dst, cap-bounded and nul-terminated. line is known to start with '/'. A bare "/" or "/ "
# yields the empty string (which matches no alias). Returns dst.
fn _alias_name_of(line, dst, cap) {
    var i = 1;                    # skip the leading '/'
    var o = 0;
    while ((load8(line + i) != 0) && (load8(line + i) != 32) && (o < (cap - 1))) {
        store8(dst + o, load8(line + i));
        o = o + 1;
        i = i + 1;
    }
    store8(dst + o, 0);
    return dst;
}

# alias_expand: if line's slash token names a configured alias, build the expansion (the
# alias value + ' ' + the line's trailing args, when present) into the depth-th buffer slot
# and return it; else return 0. Per-depth slots keep the active recursion chain's lines
# disjoint (depth d reads slot d while a deeper expansion writes slot d+1). Every copy is
# cap-bounded and the result is always nul-terminated (never a store past the slot).
fn alias_expand(line, depth) {
    _alias_name_of(line, &_alias_name, ALIAS_NAME_CAP);
    var v = config_alias_lookup(&_alias_name);
    if (v == 0) { return 0; }
    if (_alias_bufs == 0) { _alias_bufs = alloc(ALIAS_MAX_DEPTH * ALIAS_LINE_CAP); }
    var dst = _alias_bufs + depth * ALIAS_LINE_CAP;
    var off = 0;
    var vi = 0;
    while ((load8(v + vi) != 0) && (off < (ALIAS_LINE_CAP - 1))) {
        store8(dst + off, load8(v + vi)); off = off + 1; vi = vi + 1;
    }
    var rem = arg_after(line);
    if ((rem != 0) && (off < (ALIAS_LINE_CAP - 1))) {
        store8(dst + off, 32); off = off + 1;          # the separating space
        var ri = 0;
        while ((load8(rem + ri) != 0) && (off < (ALIAS_LINE_CAP - 1))) {
            store8(dst + off, load8(rem + ri)); off = off + 1; ri = ri + 1;
        }
    }
    store8(dst + off, 0);
    return dst;
}

# classify_input: map a trimmed input line to a Cmd id. Pure — unit-tested.
fn classify_input(line) {
    if (load8(line) == 0) { return CMD_EMPTY; }
    if (load8(line) != 47) { return CMD_TASK; }   # 47 = '/'
    if (token_is(line, "/help") == 1) { return CMD_HELP; }
    if (token_is(line, "/?") == 1) { return CMD_HELP; }
    if (token_is(line, "/quit") == 1) { return CMD_QUIT; }
    if (token_is(line, "/exit") == 1) { return CMD_QUIT; }
    if (token_is(line, "/seams") == 1) { return CMD_SEAMS; }
    if (token_is(line, "/state") == 1) { return CMD_STATE; }
    if (token_is(line, "/models") == 1) { return CMD_MODELS; }
    if (token_is(line, "/personas") == 1) { return CMD_PERSONAS; }
    if (token_is(line, "/allow") == 1) { return CMD_ALLOW; }
    if (token_is(line, "/save") == 1) { return CMD_SAVE; }
    if (token_is(line, "/reload") == 1) { return CMD_RELOAD; }
    if (token_is(line, "/role") == 1) { return CMD_ROLE; }
    if (token_is(line, "/persona") == 1) { return CMD_PERSONA; }
    if (token_is(line, "/model") == 1) { return CMD_MODEL; }
    if (token_is(line, "/read") == 1) { return CMD_READ; }
    if (token_is(line, "/write") == 1) { return CMD_WRITE; }
    if (token_is(line, "/run") == 1) { return CMD_RUN; }
    if (token_is(line, "/tools") == 1) { return CMD_TOOLS; }
    if (token_is(line, "/call") == 1) { return CMD_CALL; }
    if (token_is(line, "/audit") == 1) { return CMD_AUDIT; }
    if (token_is(line, "/grants") == 1) { return CMD_GRANTS; }
    if (token_is(line, "/compact") == 1) { return CMD_COMPACT; }
    if (token_is(line, "/context") == 1) { return CMD_CONTEXT; }
    if (token_is(line, "/rewind") == 1) { return CMD_REWIND; }
    if (token_is(line, "/reset") == 1) { return CMD_RESET; }
    if (token_is(line, "/clear") == 1) { return CMD_CLEAR; }
    if (token_is(line, "/theme") == 1) { return CMD_THEME; }
    if (token_is(line, "/dry") == 1) { return CMD_DRY; }
    if (token_is(line, "/remember") == 1) { return CMD_REMEMBER; }
    if (token_is(line, "/notes") == 1) { return CMD_NOTES; }
    if (token_is(line, "/conversations") == 1) { return CMD_CONVERSATIONS; }
    if (token_is(line, "/convos") == 1) { return CMD_CONVERSATIONS; }
    if (token_is(line, "/new") == 1) { return CMD_NEW; }
    if (token_is(line, "/switch") == 1) { return CMD_SWITCH; }
    if (token_is(line, "/rename") == 1) { return CMD_RENAME; }
    if (token_is(line, "/delete") == 1) { return CMD_DELETE; }
    if (token_is(line, "/search") == 1) { return CMD_SEARCH; }
    if (token_is(line, "/retry") == 1) { return CMD_RETRY; }
    if (token_is(line, "/regenerate") == 1) { return CMD_RETRY; }
    if (token_is(line, "/edit") == 1) { return CMD_EDIT; }
    if (token_is(line, "/bookmark") == 1) { return CMD_BOOKMARK; }
    if (token_is(line, "/thumbs") == 1) { return CMD_THUMBS; }
    if (token_is(line, "/git") == 1) { return CMD_GIT; }
    if (token_is(line, "/copy") == 1) { return CMD_COPY; }
    if (token_is(line, "/find") == 1) { return CMD_FIND; }
    if (token_is(line, "/reprobe") == 1) { return CMD_REPROBE; }
    if (token_is(line, "/ping") == 1) { return CMD_REPROBE; }
    if (token_is(line, "/history") == 1) { return CMD_HISTORY; }
    return CMD_UNKNOWN_SLASH;
}

# _help_line: one help row — command token in accent, the padded description in
# muted. c + rest reproduces the original line verbatim (byte-identical at T0).
fn _help_line(c, rest) { ui_emit(ROLE_ACCENT, c); ui_emit(ROLE_MUTED, rest); oprintln(""); return 0; }

fn cmd_help() {
    ui_emit(ROLE_ACCENT, "thoth - a model-switching scribe. commands:"); oprintln("");
    _help_line("  /help", "              this help");
    _help_line("  /seams", "             capability ladder (spine seam status)");
    _help_line("  /state", "             session state");
    _help_line("  /reprobe", "           re-check hoosh reachability (⌃R in the TUI; /ping alias)");
    _help_line("  /git [path]", "        working repo: branch + changed files, or a file's diff (via sit)");
    _help_line("  /persona [name]", "    show/switch the archetype; /persona shadow | blend <a> <b> (avatara)");
    _help_line("  /personas [trad]", "   list archetype traditions, or browse one; show the active card");
    _help_line("  /role [aspect|label]", " lean into an aspect of the persona, or set a custom role; /role reset");
    _help_line("  /model [id]", "        show model, or attempt a mid-session switch (hoosh); Ctrl-P picks in the TUI");
    _help_line("  /models [provider]", " list providers; with one, its switchable models");
    _help_line("  /read <file>", "       print a file (safe, read-only built-in)");
    _help_line("  /write <f> <text>", "  write text to a file (t-ron-gated)");
    _help_line("  /run <cmd>", "         run a shell command (t-ron-gated local escape)");
    _help_line("  /allow [path]", "      grant the agent read access to a root; /allow vidya; no arg lists them");
    _help_line("  /save <file>", "       write the TUI transcript (feed scrollback) to a file as markdown");
    _help_line("  /reload", "            re-read .thoth/config.cyml (hot fields apply; seams/persona need restart)");
    _help_line("  /tools", "             list the MCP tools daimon hosts");
    _help_line("  /call <tool> [json]", "  invoke an MCP tool via daimon (t-ron-gated)");
    _help_line("  /audit", "             show t-ron's audit chain (gated-action log)");
    _help_line("  /grants [clear]", "   session authorization grants (answers of 'a' at a confirm)");
    _help_line("  /context", "           what is filling the context window right now");
    _help_line("  /compact [keep]", "    summarize older turns now and stop sending them (default keep 6)");
    _help_line("  /rewind [n|last]", "   undo the model's file writes (bare: list them)");
    _help_line("  /retry", "             re-run your last message for a fresh reply (/regenerate)");
    _help_line("  /edit <text>", "       replace your last message with new text and re-run");
    _help_line("  /reset", "             clear the conversation context (start fresh)");
    _help_line("  /clear", "             clear the content window (Shift-↑/↓ scrolls history)");
    _help_line("  /copy", "              copy the last reply to the clipboard (OSC 52, best-effort)");
    _help_line("  /find [text]", "       search the feed scrollback (TUI: ⌃F; n/N jump between matches)");
    _help_line("  /history", "           list submitted inputs (TUI: Up/Down recalls; [history].file persists)");
    _help_line("  /theme [name]", "      color theme: dark | light | rainbow (⌃T cycles in the TUI)");
    _help_line("  /dry <task>", "        preview the request thoth would send (no POST)");
    _help_line("  /remember <fact>", "   append a fact to .thoth/memory (t-ron-gated; [memory].enabled)");
    _help_line("  /bookmark", "          save the last reply into mneme as a note (t-ron-gated)");
    _help_line("  /thumbs up|down", "    rate the last reply's recalled notes (thumbs up -> mneme's feedback)");
    _help_line("  /notes <query>", "     search your mneme knowledge base (needs the memory seam bound)");
    _help_line("  /conversations", "     list conversations (also /convos)");
    _help_line("  /new [title]", "       start a new conversation");
    _help_line("  /switch <n>", "        switch to conversation n");
    _help_line("  /rename <title>", "    rename the current conversation");
    _help_line("  /delete <n>", "        delete conversation n");
    _help_line("  /search <text>", "     search all conversations for text");
    _help_line("  /quit", "              exit (or Ctrl-D)");
    _help_line("  <anything else>", "    a coding task -> routed to the model (hoosh)");
    return 0;
}

# cmd_reprobe (0.27.0): re-check hoosh reachability on demand — the line-mode + shared
# equivalent of the TUI's Ctrl-R. A silent GET (hoosh_health_probe) updates the cached
# health state, then the outcome is reported. Works identically in the REPL and TUI
# (dispatch is shared); the probe emits nothing, so it is safe under the TUI's OUT_RING.
fn cmd_reprobe() {
    if (config_hoosh_configured() == 0) {
        ui_emit(ROLE_RED, "hoosh: absent"); ui_emit(ROLE_FAINT, " — set [hoosh].url in .thoth/config.cyml"); oprintln("");
        return 0;
    }
    var reach = hoosh_health_probe();
    if (reach == HOOSH_HEALTH_UP) { ui_emit(ROLE_GREEN, "hoosh: reachable"); oprintln(""); }
    else { ui_emit(ROLE_RED, "hoosh: unreachable"); ui_emit(ROLE_FAINT, " — "); emit(config_hoosh_url()); oprintln(""); }
    return 0;
}

# cmd_history (0.27.0): list the input-history ring — the lines the user has submitted this session (and any
# recalled from [history].file). Works in BOTH the REPL and the TUI (reads the shared inhist ring). Read-only
# listing; the TUI additionally recalls entries with Up/Down (a raw-mode-only affordance, correctly rich-tier).
fn cmd_history() {
    var n = inhist_count();
    if (n == 0) { ui_emit(ROLE_FAINT, "input history is empty"); oprintln(""); return 0; }
    ui_emit(ROLE_ACCENT, "input history "); emit(ui_sgr(ROLE_FAINT)); emit("("); ofmt_int(n); emit(")"); emit(ui_reset()); oprintln("");
    var i = 0;
    while (i < n) {
        emit(ui_sgr(ROLE_FAINT)); emit("  "); ofmt_int(i + 1); emit("  "); emit(ui_reset());
        emit_n(inhist_entry_ptr(i), inhist_entry_len(i));
        oprintln("");
        i = i + 1;
    }
    if (inhist_persist_active() == 1) { ui_emit(ROLE_MUTED, "  persisted -> "); emit(config_history_file()); oprintln(""); }
    return 0;
}

# (confirm — the fail-closed interactive prompt — lives in src/gate.cyr now,
# alongside the t-ron seam binding it stands in for.)

# _params_one: build {"<key>":"<escaped val>"} in a reused static buffer — the t-ron ToolCall params for the
# built-in actions. FULLY BOUNDED (0.34.4): most callers pass an input-line-/path-bounded val (<= ~4 KiB, ~6x
# escaping fits), but /bookmark feeds a whole assistant reply (up to HOOSH_ACC_CAP = 64 KiB) — so the value escape
# uses the CAP-bounded escaper (reserving 3 bytes so the closing `"}` + NUL always fit). It truncates in-buffer
# instead of overrunning `_gate_params` (the escaper is best-effort informational for the gate's policy/audit).
var _gate_params = 0;
var GATE_PARAMS_CAP = 32768;

fn _params_one(key, val) {
    if (_gate_params == 0) { _gate_params = alloc(GATE_PARAMS_CAP); }
    var cap = GATE_PARAMS_CAP;
    var off = 0;
    off = _append_cstr_cap(_gate_params, off, cap, "{\"");
    off = _append_cstr_cap(_gate_params, off, cap, key);
    off = _append_cstr_cap(_gate_params, off, cap, "\":\"");
    off = _json_escape_into_cap(_gate_params, off, cap - 3, val);   # reserve 3 bytes for the closing "} + NUL
    off = _append_cstr_cap(_gate_params, off, cap, "\"}");
    store8(_gate_params + off, 0);
    return _gate_params;
}

# _state_reason_row (0.35.4): the /state "reason" row — the [hoosh].reasoning effort control + how many turns'
# reasoning were folded (captured) this session. Effort dials the model's reasoning; the folded count is 0 on a
# model that keeps reasoning INTERNAL (Opus 4.8) even at high effort, so it's the concrete "is reasoning actually
# streaming?" signal. Extracted from cmd_state for unit-testability (no network probe — pure config + reasonlog).
fn _state_reason_row() {
    ui_label("  reason  : ");
    if (config_hoosh_reasoning() == 0) {
        ui_emit(ROLE_FAINT, "off"); ui_emit(ROLE_MUTED, " (set [hoosh].reasoning = low|medium|high)"); oprintln("");
        return 0;
    }
    ui_emit(ROLE_ACCENT, config_hoosh_reasoning_effort()); ui_emit(ROLE_MUTED, " effort");
    var n = reasonlog_total();
    if (n > 0) { ui_emit(ROLE_MUTED, " · "); ofmt_int(n); ui_emit(ROLE_MUTED, " turn(s) folded this session"); }
    else { ui_emit(ROLE_FAINT, " · none captured yet (this model may keep reasoning internal)"); }
    oprintln("");
    return 0;
}

fn cmd_state() {
    git_probe();          # 0.28.0: refresh the git cache BEFORE the snapshot so the git row is current (moved up from the git row)
    status_snapshot();    # 0.28.0: read the status producers ONCE into the shared view-model (Stage B, src/surface.cyr)
    ui_emit(ROLE_ACCENT, "session:"); oprintln("");
    ui_label("  turns   : "); ofmt_int(status_ival(SF_TURNS)); oprintln("");
    ui_label("  persona : "); ui_emit(ROLE_ACCENT, status_sval(SF_PERSONA));
    ui_emit(ROLE_FAINT, " ("); emit(ui_sgr(ROLE_FAINT)); emit(persona_role()); emit(ui_reset());
    ui_emit(ROLE_FAINT, " · "); emit(ui_sgr(ROLE_FAINT)); emit(persona_tradition()); emit(ui_reset());
    ui_emit(ROLE_FAINT, ")"); oprintln("");
    ui_label("  model   : ");
    if (status_state(SF_MODEL) == 1) { ui_emit(ROLE_FAINT, "(none set)"); oprintln(""); }
    else { ui_emit(ROLE_ACCENT, status_sval(SF_MODEL)); oprintln(""); }
    ui_label("  hoosh   : ");
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) { ui_emit(ROLE_FAINT, "absent (set [hoosh].url in .thoth/config.cyml)"); oprintln(""); }
    else {
        emit(config_hoosh_url());
        if (config_hoosh_stream() == 1) { ui_emit(ROLE_MUTED, " (streaming)"); oprintln(""); }
        else { ui_emit(ROLE_MUTED, " (blocking)"); oprintln(""); }
    }
    if (status_present(SF_HEALTH) == 1) {   # 0.27.0: cached live reachability (/reprobe re-checks; ⌃R in the TUI)
        ui_label("  health  : ");
        var _hh = status_state(SF_HEALTH);
        if (_hh == HOOSH_HEALTH_UP) { ui_emit(ROLE_GREEN, "reachable"); ui_emit(ROLE_MUTED, " (last transport ok)"); }
        elif (_hh == HOOSH_HEALTH_DOWN) { ui_emit(ROLE_RED, "unreachable"); ui_emit(ROLE_MUTED, " (last transport failed — /reprobe)"); }
        else { ui_emit(ROLE_FAINT, "unknown"); ui_emit(ROLE_MUTED, " (no probe yet — /reprobe)"); }
        oprintln("");
    }
    ui_label("  context : ");
    if (config_hoosh_history() == 0) { ui_emit(ROLE_MUTED, "stateless (single-turn; [hoosh].history = false)"); oprintln(""); }
    elif (session_history_len() == 0) { emit("multi-turn, "); ui_emit(ROLE_MUTED, "empty (no turns yet; /reset clears)"); oprintln(""); }
    else {
        emit("multi-turn, "); ofmt_int(session_history_len()); emit(" messages");
        # 0.19.0: framed history bytes vs the ~32 KiB evict boundary — surface context pressure.
        ui_emit(ROLE_MUTED, " · ");
        ofmt_int(status_ival(SF_CTX)); emit("K / "); ofmt_int(status_ival2(SF_CTX)); ui_emit(ROLE_MUTED, "K budget");
        # 0.36.4: name the two overflows HONESTLY. The byte-budget one only SKIPS messages for this request (they
        # stay in the store, the feed, /save, and return if the tail shrinks) — it used to read "evicted", which
        # implied loss. The SESS_HIST_MAX cap is the one that really destroys a message, and it used to say nothing.
        var ev = status_state(SF_CTX);
        if (ev > 0) { emit(" · "); emit(ui_sgr(ROLE_RED)); ofmt_int(ev); emit(" oldest not sent"); emit(ui_reset()); }
        # 0.36.4: ...but if [hoosh].summarize recapped them, the model still has their gist — say so.
        var rc = session_recap_covers();
        if (rc > 0) { emit(" · "); emit(ui_sgr(ROLE_GREEN)); ofmt_int(rc); emit(" recapped"); emit(ui_reset()); }
        var dr = session_history_dropped();
        if (dr > 0) { emit(" · "); emit(ui_sgr(ROLE_RED)); ofmt_int(dr); emit(" dropped from the record"); emit(ui_reset()); }
        ui_emit(ROLE_MUTED, " (/reset clears)"); oprintln("");
    }
    _state_reason_row();   # 0.35.4: [hoosh].reasoning effort + turns folded this session
    if (sess_persist_active() == 1) {     # 0.24.2: omit the row entirely when off (byte-identical floor)
        ui_label("  resume  : ");
        ui_emit(ROLE_GREEN, "on"); emit(" — "); emit(config_session_file());
        ui_emit(ROLE_MUTED, " ([session].file; conversation persisted across restarts)"); oprintln("");
    }
    if ((config_ui_bell() == 1) || (config_ui_elapsed() == 1)) {   # 0.24.3: omit when both off (byte-identical floor)
        ui_label("  ui      : ");
        var first = 1;
        if (config_ui_bell() == 1) { ui_emit(ROLE_GREEN, "bell"); first = 0; }
        if (config_ui_elapsed() == 1) { if (first == 0) { emit(" + "); } ui_emit(ROLE_GREEN, "elapsed"); }
        ui_emit(ROLE_MUTED, " on turn completion ([ui], interactive-only)"); oprintln("");
    }
    daimon_mem_probe();   # 0.32.0: refresh the mneme binding so the row is accurate (a status command may hit the network)
    ui_label("  memory  : ");
    if (seam_cap_state(SEAM_MEMORY) == CAP_FULL) { ui_emit(ROLE_GREEN, "mneme"); ui_emit(ROLE_MUTED, " (semantic recall + /remember via daimon)"); oprintln(""); }
    elif (seam_cap_state(SEAM_MEMORY) == CAP_DEGRADED) { emit("local .thoth/memory, "); ofmt_int(memory_fact_count()); ui_emit(ROLE_MUTED, " fact(s) — verbatim inject (mneme not hosted by daimon)"); oprintln(""); }
    else { ui_emit(ROLE_FAINT, "off (set [memory].enabled in .thoth/config.cyml)"); oprintln(""); }
    ui_label("  tokens  : ");
    if (status_present(SF_TOKENS) == 0) { ui_emit(ROLE_FAINT, "(none reported yet — shows once hoosh returns usage)"); oprintln(""); }
    else { ofmt_int(status_ival(SF_TOKENS)); ui_emit(ROLE_MUTED, " total (hoosh usage, this session)"); oprintln(""); }
    ui_label("  cost    : ");
    if (status_present(SF_COST) == 0) {
        if (status_ival2(SF_COST) > 0) { ui_emit(ROLE_FAINT, "(unpriced — add [pricing.<model>] for the active model in .thoth/config.cyml)"); }
        else { ui_emit(ROLE_FAINT, "(none yet — add [pricing.<model>] in .thoth/config.cyml to price usage)"); }
        oprintln("");
    } else {
        var _cbuf[24];
        cost_fmt(&_cbuf, status_ival(SF_COST));
        emit(&_cbuf); ui_emit(ROLE_MUTED, " total ([pricing], this session)");
        if (status_ival2(SF_COST) > 0) {
            ui_emit(ROLE_FAINT, " — "); ofmt_int(status_ival2(SF_COST)); ui_emit(ROLE_FAINT, " unpriced response(s) omitted");
        }
        oprintln("");
    }
    ui_label("  git     : ");
    if (status_present(SF_GIT) == 0) { ui_emit(ROLE_FAINT, "absent (no git/.sit repo at the working directory)"); oprintln(""); }
    else {
        if (status_state(SF_GIT) == SF_GIT_DETACHED) { ui_emit(ROLE_ACCENT, "(detached HEAD)"); }
        else { ui_emit(ROLE_ACCENT, status_sval(SF_GIT)); }
        if (status_ival(SF_GIT) == 0) { ui_emit(ROLE_MUTED, " - clean"); }
        else { emit(" - "); ofmt_int(status_ival(SF_GIT)); ui_emit(ROLE_MUTED, " changed (HEAD vs worktree, via sit)"); }
        oprintln("");
    }
    ui_label("  log     : ");
    if (log_active() == 0) { ui_emit(ROLE_FAINT, "off (set [log].file or [log].level in .thoth/config.cyml)"); oprintln(""); }
    else {
        if (config_log_file() != 0) { emit(config_log_file()); } else { emit("stderr"); }
        ui_emit(ROLE_MUTED, " (structured driver events)"); oprintln("");
    }
    if (config_alias_count() > 0) {        # omit the row entirely when none are defined
        ui_label("  aliases : "); ofmt_int(config_alias_count());
        ui_emit(ROLE_MUTED, " defined ([alias] in .thoth/config.cyml; /<name> expands)"); oprintln("");
    }
    if (config_shell_enabled() == 1) {     # omit the row entirely when off (byte-identical floor)
        ui_label("  shell   : ");
        if (shell_supported() == 0) {
            ui_emit(ROLE_ACCENT, "enabled but unsupported on this target");
            ui_emit(ROLE_MUTED, " (needs POSIX /bin/sh -c; not advertised here)"); oprintln("");
        } else {
            ui_emit(ROLE_GREEN, "enabled");
            emit(" — timeout "); ofmt_int(config_shell_timeout_ms()); emit("ms, cap "); ofmt_int(config_shell_output_cap()); emit("B, thoth_shell-gated");
            if (config_shell_deny_count() > 0) { emit(", "); ofmt_int(config_shell_deny_count()); emit(" deny"); }
            if (config_shell_allow_count() > 0) { emit(", "); ofmt_int(config_shell_allow_count()); emit(" allow"); }
            if (agent_enabled() == 0) { ui_emit(ROLE_MUTED, " (agentic loop off — set [hoosh].tools = true)"); }   # 0.20.0: shell no longer needs daimon; the loop needs [hoosh].tools
            elif (seam_status(SEAM_DAIMON) == SEAM_ABSENT) { ui_emit(ROLE_MUTED, " (standalone — no daimon)"); }
            oprintln("");
        }
    }
    if (agent_enabled() == 1) {            # 0.23.x: the always-on project read tools + any user-granted roots
        ui_label("  reads   : ");
        emit("project (jailed)");
        var rrn = project_read_roots_count();
        if (rrn > 0) {
            emit(" + "); ofmt_int(rrn); emit(" granted root");
            if (rrn > 1) { emit("s"); }
            ui_emit(ROLE_MUTED, " (/allow)"); oprintln("");
        } else { ui_emit(ROLE_MUTED, " — /allow to grant more"); oprintln(""); }
    }
    ui_label("  agent   : ");
    if (agent_enabled() == 1) {
        emit("agentic tool-calling on (");
        if (seam_status(SEAM_DAIMON) != SEAM_ABSENT) { emit("daimon tools"); } else { emit("shell tool, standalone"); }   # 0.20.0
        emit(", t-ron gated, ");
        if (config_hoosh_parallel() == 1) { ui_emit(ROLE_GREEN, "parallel"); } else { emit("serial"); }
        emit(" calls, max ");                                  # 0.40.0 (T1-2): the round ceiling is now visible
        ofmt_int(config_hoosh_max_iters()); emit(" rounds");
        if (config_hoosh_max_iters() == HOOSH_MAX_ITERS_DEFAULT) { ui_emit(ROLE_MUTED, " — [hoosh].max_iters to raise"); }
        oprintln(")");
    }
    elif (config_hoosh_tools() == 0) { ui_emit(ROLE_MUTED, "plain turns ([hoosh].tools = false)"); oprintln(""); }
    else { ui_emit(ROLE_MUTED, "plain turns (no daimon seam and no shell tool; set [daimon].url or [shell].enabled)"); oprintln(""); }
    ui_label("  daimon  : ");
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) { ui_emit(ROLE_FAINT, "absent (set [daimon].url in .thoth/config.cyml)"); oprintln(""); }
    else { oprintln(config_daimon_url()); }
    ui_label("  t-ron   : ");
    if (gate_active() == 0) { ui_emit(ROLE_FAINT, "absent (fail-closed confirm gate; set [tron].policy in .thoth/config.cyml)"); oprintln(""); }
    else { oprintln(config_tron_policy()); }
    ui_label("  spine   : ");
    if (seam_any_wired() == 0) { ui_emit(ROLE_FAINT, "all seams absent (fermenting)"); oprintln(""); }
    else { ui_emit(ROLE_MUTED, "see /seams"); oprintln(""); }
    ui_label("  surface : ");
    ui_emit(ROLE_GREEN, status_sval(SF_SURFACE));
    if (status_ival(SF_SURFACE) != PT_PLAIN) { emit(" ("); ui_emit(ROLE_MUTED, ui_color_depth_name()); emit(")"); }
    oprintln("");
    ui_label("  theme   : "); ui_emit(ROLE_ACCENT, status_sval(SF_THEME)); oprintln("");
    ui_label("  build   : "); emit(ui_sgr(ROLE_ACCENT)); emit("thoth "); emit(thoth_version()); emit(ui_reset()); oprintln("");
    return 0;
}

# cmd_git: /git — the working repository's branch + per-file changed list, read
# through sit's read-only VCS API (0.13.0). thoth owns no VCS logic; sit owns the
# domain. Own open->read->close for the detailed listing, then git_probe() to sync
# the cached producer (branch + count) so the status bar agrees. Honest absent line
# off a repo (sit reads at cwd; no ancestor walk).
fn cmd_git(line) {
    var arg = arg_after(line);
    var repo = sit_repo_open(".");
    if (repo == 0) {
        ui_emit(ROLE_FAINT, "git: no git/.sit repo at the working directory"); oprintln("");
        ui_emit(ROLE_MUTED, "  (sit reads at the cwd; it does not walk up to an ancestor repo)"); oprintln("");
        git_probe();
        return 0;
    }
    # 0.19.2: `/git <path>` renders that file's diff (HEAD blob vs working tree) via sit_diff_path through
    # the colored diff renderer. sit_diff_path returns 0 when the file is unchanged / untracked-and-absent /
    # too large to diff — reported honestly, never a blank or a fake diff.
    if (arg != 0) {
        var ops = sit_diff_path(repo, arg);
        if (ops == 0) {
            emit("  "); ui_emit(ROLE_BLUE, arg); ui_emit(ROLE_MUTED, " — no changes vs HEAD (unchanged, untracked-and-absent, or too large)"); oprintln("");
        } else {
            diff_render_ann(arg, ops);
        }
        sit_repo_close(repo);
        return 0;
    }
    ui_label("  branch : ");
    var br = sit_repo_branch(repo);
    if (br == 0) { ui_emit(ROLE_ACCENT, "(detached HEAD)"); } else { ui_emit(ROLE_ACCENT, br); }
    oprintln("");
    var st = sit_repo_status(repo);
    var n = 0;
    if (st != 0) { n = vec_len(st); }
    if (n == 0) {
        ui_label("  status : "); ui_emit(ROLE_GREEN, "clean"); ui_emit(ROLE_MUTED, " (working tree matches HEAD)"); oprintln("");
    } else {
        ui_label("  status : "); ofmt_int(n); ui_emit(ROLE_MUTED, " changed (HEAD vs worktree):"); oprintln("");
        var i = 0;
        while (i < n) {
            var rec = vec_get(st, i);
            var kind = sit_status_kind(rec);
            emit("    ");
            if (kind == 1) { ui_emit(ROLE_ACCENT, "M "); }        # modified
            elif (kind == 2) { ui_emit(ROLE_GREEN, "A "); }       # new (untracked)
            elif (kind == 3) { ui_emit(ROLE_RED, "D "); }         # deleted
            else { emit("? "); }
            emit(sit_status_path(rec)); oprintln("");
            i = i + 1;
        }
    }
    sit_repo_close(repo);
    git_probe();     # sync the cached producer so the status bar matches what /git showed
    return 0;
}

# _persona_excerpt: emit up to ~90 bytes of the cstr `s`, backing up to the last space so a word is never
# severed (this also protects a multi-byte glyph, since the cut lands on an ASCII space), then "…" if more
# remains. For the persona card's soul/spirit preview. (If a soul had NO space in its first 90 bytes the raw
# cut could sever a glyph — a dead path: all current avatara souls are spaced prose.) Returns bytes emitted.
fn _persona_excerpt(s) {
    var i = 0;
    while ((load8(s + i) != 0) && (i < 90)) { i = i + 1; }
    if (load8(s + i) != 0) {                     # truncated -> back up to a word boundary
        var b = i;
        while ((b > 0) && (load8(s + b - 1) != 32)) { b = b - 1; }
        if (b > 0) { i = b - 1; }                # drop the trailing space before the ellipsis
        emit_n(s, i); emit("…");
        return i;                                # bytes emitted before the ellipsis (testable)
    }
    emit_n(s, i);                                # whole string fit
    return i;
}

# cmd_allow (0.23.1): the USER-driven read-root grant — the permission model for widening the project jail.
# No arg lists read access (the always-jailed project + any granted roots, plus a hint). `/allow vidya` grants
# the configured [project].vidya knowledge base so the agent can read the latest Cyrius reference. `/allow
# <abs-path>` grants any absolute root (e.g. another repo to review). The MODEL cannot call this — it is a
# slash command, the human's own authorization, mirroring /run's t-ron model. Grants are additive within a
# session (restart to reset); config [project].read_roots persists them across sessions.
fn cmd_allow(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        ui_emit(ROLE_ACCENT, "read access"); oprintln("");
        emit("  "); ui_emit(ROLE_FG, "project"); ui_emit(ROLE_FAINT, "  the launch directory (always readable, jailed)"); oprintln("");
        var n = project_read_roots_count();
        if (n == 0) {
            emit("  "); ui_emit(ROLE_FAINT, "granted roots: none"); oprintln("");
        } else {
            var i = 0;
            while (i < n) {
                emit("  "); ui_emit(ROLE_GREEN, "granted"); emit("  "); emit(project_read_root_at(i)); oprintln("");
                i = i + 1;
            }
        }
        oprintln("");
        if (config_vidya() != 0) { ui_emit(ROLE_FAINT, "  /allow vidya to grant the vidya knowledge base · /allow <abs-path> for another root"); }
        else { ui_emit(ROLE_FAINT, "  /allow <abs-path> to grant read access to another root (absolute paths only)"); }
        oprintln("");
        return 0;
    }
    if (streq(arg, "vidya") == 1) {
        var vp = config_vidya();
        if (vp == 0) {
            ui_emit(ROLE_RED, "vidya path not set"); oprintln("");
            ui_emit(ROLE_FAINT, "  add a [project] vidya = \"/abs/path/to/vidya\" line to .thoth/config.cyml"); oprintln("");
            return 0;
        }
        if (project_grant_root(vp) == 1) {
            ui_emit(ROLE_GREEN, "granted"); emit(" read access to vidya: "); emit(vp); oprintln("");
        } else {
            ui_emit(ROLE_RED, "could not grant"); emit(" "); emit(vp); oprintln("");
            _allow_root_hint();
        }
        return 0;
    }
    if (project_grant_root(arg) == 1) {
        ui_emit(ROLE_GREEN, "granted"); emit(" read access to "); emit(arg); oprintln("");
    } else {
        ui_emit(ROLE_RED, "could not grant"); emit(" "); emit(arg); oprintln("");
        _allow_root_hint();
    }
    return 0;
}

# _allow_root_hint: the constraint reminder printed when a grant is rejected. A root must be an absolute
# path (not "/"), and the table caps at READ_ROOTS_MAX.
fn _allow_root_hint() {
    ui_emit(ROLE_FAINT, "  a root must be an absolute path (e.g. /home/you/repo), not \"/\", up to "); emit(ui_sgr(ROLE_FAINT)); ofmt_int(READ_ROOTS_MAX); emit(" roots"); emit(ui_reset()); oprintln("");
}

# --- /save transcript export (0.24.1) -------------------------------------
var SAVE_BUF = 2048;         # == FEED_LINE_CAP; a stripped line is never longer than the raw feed line
var _save_buf = 0;

# _save_write_str: file_write a NUL-terminated string; 1 on a full write, 0 on short/error.
fn _save_write_str(fd, s) {
    var n = strlen(s);
    if (file_write(fd, s, n) != n) { return 0; }
    return 1;
}

# _save_history (0.27.0): write the tier-neutral CONVERSATION history (session_history_*) as a markdown
# transcript — the LINE-MODE source for /save (the feed ring is TUI-only). Each turn becomes a "## <role>"
# header + its raw content (history content is plain text — no ANSI to strip). 1 on a full write, else 0.
fn _save_history(fd) {
    var ok = 1;
    var n = session_history_len();
    var i = 0;
    while (i < n) {
        if (_save_write_str(fd, "## ") == 0) { ok = 0; }
        if (_save_write_str(fd, session_history_role(i)) == 0) { ok = 0; }
        var mdl = session_history_model(i);       # 0.33.3: annotate a reply with its producing model
        if (mdl != 0) {
            if (_save_write_str(fd, " (") == 0) { ok = 0; }
            if (_save_write_str(fd, mdl) == 0) { ok = 0; }
            if (_save_write_str(fd, ")") == 0) { ok = 0; }
        }
        if (_save_write_str(fd, "\n\n") == 0) { ok = 0; }
        var content = session_history_content(i);
        var clen = strlen(content);
        if (clen > 0) { if (file_write(fd, content, clen) != clen) { ok = 0; } }
        if (_save_write_str(fd, "\n\n") == 0) { ok = 0; }
        var cc = session_history_citation_count(i);   # 0.33.4: the reply's recalled sources
        if (cc > 0) {
            if (_save_write_str(fd, "_recalled sources:_\n") == 0) { ok = 0; }
            var cj = 0;
            while (cj < cc) {
                if (_save_write_str(fd, "- ") == 0) { ok = 0; }
                if (_save_write_str(fd, session_history_citation_title(i, cj)) == 0) { ok = 0; }
                if (_save_write_str(fd, "\n") == 0) { ok = 0; }
                cj = cj + 1;
            }
            if (_save_write_str(fd, "\n") == 0) { ok = 0; }
        }
        var tc = session_history_tool_count(i);       # 0.33.5: the reply's tool calls
        if (tc > 0) {
            if (_save_write_str(fd, "_tools:_\n") == 0) { ok = 0; }
            var tj = 0;
            while (tj < tc) {
                if (_save_write_str(fd, "- `") == 0) { ok = 0; }
                if (_save_write_str(fd, session_history_tool_name(i, tj)) == 0) { ok = 0; }
                if (_save_write_str(fd, "`") == 0) { ok = 0; }
                var targs = session_history_tool_args(i, tj);
                if (targs != 0) { if (strlen(targs) > 0) { if (_save_write_str(fd, " ") == 0) { ok = 0; } if (_save_write_str(fd, targs) == 0) { ok = 0; } } }
                # status: kind 0 = gate-denied, kind 1 (allowed) with ok 0 = the call errored (else it succeeded)
                if (session_history_tool_kind(i, tj) == 0) { if (_save_write_str(fd, " (denied)") == 0) { ok = 0; } }
                else { if (session_history_tool_ok(i, tj) == 0) { if (_save_write_str(fd, " (error)") == 0) { ok = 0; } } }
                if (_save_write_str(fd, "\n") == 0) { ok = 0; }
                tj = tj + 1;
            }
            if (_save_write_str(fd, "\n") == 0) { ok = 0; }
        }
        i = i + 1;
    }
    return ok;
}

# cmd_save (0.24.1; line-mode source added 0.27.0): write a plain-text/markdown transcript to <file>. In
# the rich TUI it saves the FEED scrollback (tool cards, diffs, chrome), ANSI-stripped
# (feed_strip_ansi_into); in LINE MODE (no feed ring) it saves the tier-neutral CONVERSATION history
# (user/assistant turns) — so /save works in BOTH, closing the 0.24.1 line-mode gap. Rides the PORTABLE
# lib/io.cyr wrappers (create + truncate 0644, like the one-shot `-o` tee). NOT t-ron-gated: the user's
# OWN export to a path they named (the model can never invoke a slash command). Degrades closed: an
# unopenable path / a short write is announced, never faked. HONEST LIMIT: the feed ring is bounded to
# FEED_ROWS lines (older evicted); the history path is bounded to the retained conversation window.
# --- 0.36.5: /save export formats ---------------------------------------------------------------------------------
# `/save <file>` still writes the markdown transcript (unchanged default). `--json` writes a machine-readable
# envelope for jq/CI (the tier-neutral conversation, like --json for one-shot); `--plain` writes the bare text with
# no markdown scaffolding. JSON is built ONE MESSAGE AT A TIME into a bounded buffer and flushed, so a long history
# can't outgrow it (a reply alone can be 64 KiB, and escaping can sextuple it).
var SAVE_FMT_MD = 0;
var SAVE_FMT_JSON = 1;
var SAVE_FMT_PLAIN = 2;
var SAVE_JBUF = 524288;
var _save_jbuf = 0;
var _save_fmt_path = 0;      # the path left after the format flag was consumed

# _save_parse_fmt: read a leading --json/--plain off the /save argument; leave the path in _save_fmt_path.
fn _save_parse_fmt(arg) {
    _save_fmt_path = arg;
    if (arg == 0) { return SAVE_FMT_MD; }
    if (cstr_starts_with(arg, "--json") == 1) { _save_fmt_path = arg_after(arg); return SAVE_FMT_JSON; }
    if (cstr_starts_with(arg, "--plain") == 1) { _save_fmt_path = arg_after(arg); return SAVE_FMT_PLAIN; }
    return SAVE_FMT_MD;
}

# _save_json: the conversation as one JSON object. Per-message build+flush keeps the buffer bounded.
fn _save_json(fd) {
    if (_save_jbuf == 0) { _save_jbuf = alloc(SAVE_JBUF); }
    var cap = SAVE_JBUF;
    var ok = 1;
    if (_save_write_str(fd, "{\"thoth\":\"") == 0) { ok = 0; }
    if (_save_write_str(fd, thoth_version()) == 0) { ok = 0; }
    if (_save_write_str(fd, "\",\"messages\":[") == 0) { ok = 0; }
    var n = session_history_len();
    var i = 0;
    while (i < n) {
        var off = 0;
        if (i > 0) { off = _append_cstr_cap(_save_jbuf, off, cap, ","); }
        off = _append_cstr_cap(_save_jbuf, off, cap, "{\"role\":\"");
        off = _json_escape_into_cap(_save_jbuf, off, cap, session_history_role(i));
        off = _append_cstr_cap(_save_jbuf, off, cap, "\",\"content\":\"");
        off = _json_escape_into_cap(_save_jbuf, off, cap, session_history_content(i));
        off = _append_cstr_cap(_save_jbuf, off, cap, "\"");
        var mdl = session_history_model(i);
        if (mdl != 0) {
            off = _append_cstr_cap(_save_jbuf, off, cap, ",\"model\":\"");
            off = _json_escape_into_cap(_save_jbuf, off, cap, mdl);
            off = _append_cstr_cap(_save_jbuf, off, cap, "\"");
        }
        off = _append_cstr_cap(_save_jbuf, off, cap, "}");
        if (file_write(fd, _save_jbuf, off) != off) { ok = 0; }
        i = i + 1;
    }
    if (_save_write_str(fd, "]}\n") == 0) { ok = 0; }
    return ok;
}

# _save_plain: the bare conversation — "role: content", no markdown headers, citations or tool lists.
fn _save_plain(fd) {
    var ok = 1;
    var n = session_history_len();
    var i = 0;
    while (i < n) {
        if (_save_write_str(fd, session_history_role(i)) == 0) { ok = 0; }
        if (_save_write_str(fd, ": ") == 0) { ok = 0; }
        var content = session_history_content(i);
        var clen = strlen(content);
        if (clen > 0) { if (file_write(fd, content, clen) != clen) { ok = 0; } }
        if (_save_write_str(fd, "\n\n") == 0) { ok = 0; }
        i = i + 1;
    }
    return ok;
}

fn cmd_save(line) {
    var raw = arg_after(line);
    var fmt = _save_parse_fmt(raw);
    var path = _save_fmt_path;
    if (path == 0) { ui_emit(ROLE_RED, "usage: "); emit("/save [--json|--plain] <file>"); oprintln(""); return 0; }
    var nfeed = feed_count();
    var nhist = session_history_len();
    if ((nfeed == 0) && (nhist == 0)) {
        ui_emit(ROLE_FAINT, "nothing to save — no feed scrollback and no conversation yet"); oprintln(""); return 0;
    }
    if (_save_buf == 0) { _save_buf = alloc(SAVE_BUF); }
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);   # 0644, like the -o tee
    if (fd < 0) { ui_emit(ROLE_RED, "could not open "); emit(path); ui_emit(ROLE_FAINT, " for writing"); oprintln(""); return 0; }
    var ok = 1;
    # 0.36.5: --json / --plain are tier-neutral (the conversation, not the rendered scrollback) — a machine or a
    # bare-text export shouldn't depend on whether you happened to be in the TUI.
    if (fmt == SAVE_FMT_JSON) {
        if (_save_json(fd) == 0) { ok = 0; }
        file_close(fd);
        if (ok == 1) { ui_emit(ROLE_GREEN, "saved "); ofmt_int(nhist); emit(" messages (json) to "); emit(path); oprintln(""); }
        else { ui_emit(ROLE_RED, "save incomplete "); ui_emit(ROLE_FAINT, "(write error) — "); emit(path); oprintln(""); }
        return 0;
    }
    if (fmt == SAVE_FMT_PLAIN) {
        if (_save_plain(fd) == 0) { ok = 0; }
        file_close(fd);
        if (ok == 1) { ui_emit(ROLE_GREEN, "saved "); ofmt_int(nhist); emit(" messages (plain) to "); emit(path); oprintln(""); }
        else { ui_emit(ROLE_RED, "save incomplete "); ui_emit(ROLE_FAINT, "(write error) — "); emit(path); oprintln(""); }
        return 0;
    }
    if (_save_write_str(fd, "# thoth transcript\n\n") == 0) { ok = 0; }
    var nsaved = 0;
    if (nfeed > 0) {
        # rich TUI: the rendered feed scrollback, each line ANSI-stripped to readable text
        var i = 0;
        while (i < nfeed) {
            var slen = feed_strip_ansi_into(_save_buf, SAVE_BUF, feed_line_ptr(i), feed_line_len(i));
            if (slen > 0) { if (file_write(fd, _save_buf, slen) != slen) { ok = 0; } }
            if (file_write(fd, "\n", 1) != 1) { ok = 0; }
            i = i + 1;
        }
        nsaved = nfeed;
    } else {
        # line mode: no feed ring -> the tier-neutral conversation history
        if (_save_history(fd) == 0) { ok = 0; }
        nsaved = nhist;
    }
    file_close(fd);
    if (ok == 1) {
        ui_emit(ROLE_GREEN, "saved "); ofmt_int(nsaved);
        if (nfeed > 0) { emit(" lines to "); } else { emit(" messages to "); }
        emit(path); oprintln("");
    } else { ui_emit(ROLE_RED, "save incomplete "); ui_emit(ROLE_FAINT, "(write error) — "); emit(path); oprintln(""); }
    return 0;
}

# --- /role: role modality (0.24.5) ----------------------------------------
var ROLE_ARG_CAP = 128;
var _role_lc = 0;

# _role_lc_of: an ASCII-lowercased copy of `s` (bounded) for case-insensitive aspect matching. The raw arg
# is used verbatim for a custom override (so "Keeper of Symbols" keeps its case). Reused scratch.
fn _role_lc_of(s) {
    if (_role_lc == 0) { _role_lc = alloc(ROLE_ARG_CAP); }
    var i = 0;
    while ((load8(s + i) != 0) && (i < (ROLE_ARG_CAP - 1))) {
        var b = load8(s + i);
        if ((b >= 65) && (b <= 90)) { b = b + 32; }
        store8(_role_lc + i, b); i = i + 1;
    }
    store8(_role_lc + i, 0);
    return _role_lc;
}

# cmd_role (0.24.5): the persona's ROLE is a facet (aspect) of its personality. No arg lists the active
# archetype's aspects (each an avatara trait-derived role), marking the live one + the dominant default.
# `/role <aspect>` leans into that aspect (its role follows + steers the turn via the system prompt);
# `/role <any label>` sets a CUSTOM role (make anyone "the Librarian" / "Keeper of Symbols"); `/role reset`
# returns to the default. Consumes avatara's aspect API (aspect_*/profile_dominant_aspect); the override is
# thoth's own session overlay.
fn cmd_role(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        ui_emit(ROLE_ACCENT, "role"); oprintln("");
        emit("  active: "); ui_emit(ROLE_ACCENT, persona_role());
        if (persona_role_is_override() == 1) { ui_emit(ROLE_FAINT, " (custom)"); }
        oprintln("");
        emit("  "); ui_emit(ROLE_FAINT, "aspects of "); emit(ui_sgr(ROLE_FAINT)); emit(persona_name()); emit(ui_reset());
        ui_emit(ROLE_FAINT, " (facets of its personality):"); oprintln("");
        var dom = profile_dominant_aspect(persona_profile());
        var i = 0;
        while (i < aspect_count()) {
            emit("  ");
            # star the aspect whose role IS the active one — so the marker never contradicts the 'active:'
            # line. None is starred when the role is a custom override, or the signature Thoth's "the
            # Librarian" default (which is not one of the aspects); "(dominant)" still shows the fallback.
            if ((persona_role_is_override() == 0) && (streq(persona_role(), aspect_role(i)) == 1)) { ui_emit(ROLE_GREEN, "* "); } else { emit("  "); }
            ui_emit(ROLE_ACCENT, aspect_name(i)); ui_emit(ROLE_FAINT, " — "); emit(aspect_role(i));
            if (i == dom) { ui_emit(ROLE_FAINT, " (dominant)"); }
            oprintln("");
            i = i + 1;
        }
        oprintln("");
        ui_emit(ROLE_FAINT, "  /role <aspect> to lean in · /role <your label> for a custom role · /role reset"); oprintln("");
        return 0;
    }
    if ((streq(arg, "reset") == 1) || (streq(arg, "default") == 1) || (streq(arg, "clear") == 1)) {
        persona_role_reset();
        emit("role -> "); ui_emit(ROLE_ACCENT, persona_role()); ui_emit(ROLE_FAINT, " (default)"); oprintln("");
        return 0;
    }
    var idx = aspect_index_by_name(_role_lc_of(arg));
    if (idx >= 0) {
        persona_role_select_aspect(idx);
        emit("role -> "); ui_emit(ROLE_ACCENT, persona_role()); oprintln("");
        return 0;
    }
    persona_role_override_set(arg);            # not an aspect name -> a custom role label (verbatim)
    emit("role -> "); ui_emit(ROLE_ACCENT, persona_role()); ui_emit(ROLE_FAINT, " (custom)"); oprintln("");
    return 0;
}

# cmd_personas (0.22.1): DISCOVERY + display only (no new personality logic). No arg shows the active
# persona card + the list of avatara traditions (with archetype counts); an arg browses one tradition,
# listing its archetypes (the active one marked). All data is read from avatara (all_traditions /
# by_tradition / the prof_* accessors) — thoth only surfaces it.
fn cmd_personas(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        ui_emit(ROLE_ACCENT, "active persona"); oprintln("");
        emit("  "); ui_emit(ROLE_ACCENT, persona_name());
        ui_emit(ROLE_FAINT, " · "); emit(ui_sgr(ROLE_FAINT)); emit(persona_tradition()); emit(ui_reset()); oprintln("");
        emit("  "); ui_emit(ROLE_FAINT, persona_desc()); oprintln("");
        emit("  "); emit(ui_sgr(ROLE_MUTED)); emit("\""); _persona_excerpt(persona_soul()); emit("\""); emit(ui_reset()); oprintln("");
        oprintln("");
        ui_emit(ROLE_ACCENT, "traditions"); ui_emit(ROLE_FAINT, " (archetype count)"); oprintln("");
        var v = all_traditions();
        var n = vec_len(v);
        var i = 0;
        while (i < n) {
            var t = vec_get(v, i);
            emit("  "); ui_emit(ROLE_BLUE, t);
            ui_emit(ROLE_FAINT, " ("); emit(ui_sgr(ROLE_FAINT)); ofmt_int(vec_len(by_tradition(t))); emit(")"); emit(ui_reset());
            oprintln("");
            i = i + 1;
        }
        oprintln("");
        ui_emit(ROLE_FAINT, "  /personas <tradition> to browse · /persona <name> to switch"); oprintln("");
        return 0;
    }
    var bv = by_tradition(arg);
    var bn = vec_len(bv);
    if (bn == 0) {
        emit("unknown tradition: '"); emit(arg); oprintln("'");
        oprintln("  /personas lists the available traditions (case-sensitive).");
        return 0;
    }
    ui_emit(ROLE_ACCENT, arg); ui_emit(ROLE_FAINT, " archetypes"); oprintln("");
    var j = 0;
    while (j < bn) {
        var p = vec_get(bv, j);
        emit("  ");
        if (streq(prof_name(p), persona_name()) == 1) { ui_emit(ROLE_GREEN, "● "); } else { emit("  "); }
        ui_emit(ROLE_ACCENT, prof_name(p));
        ui_emit(ROLE_FAINT, " — "); emit(ui_sgr(ROLE_FAINT)); emit(prof_desc(p)); emit(ui_reset());
        oprintln("");
        j = j + 1;
    }
    oprintln("");
    ui_emit(ROLE_FAINT, "  /persona <name> to switch (● = active)"); oprintln("");
    return 0;
}

# _cmd_persona_shadow (0.22.2): `/persona shadow [name]` — make the SHADOW of the active persona (or a
# named archetype) active. avatara's shadow() emits its own inverted prose, so it is a usable persona.
fn _cmd_persona_shadow(tgt) {
    var base = 0;
    if (tgt != 0) {
        var r = find_and_validate(tgt);
        if (is_err_result(r) == 1) {
            emit("unknown persona: '"); emit(tgt); oprintln("'");
            oprintln("  /persona shadow [name] shadows the active persona, or a named archetype. see /personas.");
            return 0;
        }
        base = result_unwrap(r);
    }
    if (persona_shadow(base) == 0) { oprintln("shadow unavailable for the active persona."); return 0; }
    emit("persona -> "); emit(persona_name());
    emit(" ("); emit(persona_role()); oprintln(")");
    oprintln("  effective next turn — the shadow aspect (inverted traits + avatara's shadow prose).");
    log_begin("persona_shadow"); log_kv_str("persona", persona_name()); log_commit(SK_INFO);
    return 0;
}

var _persona_tok = 0;         # reused token scratch for /persona blend parsing (max 255 bytes/token)
# _cmd_persona_blend (0.22.2): `/persona blend <name>[:weight] <name>[:weight] ...` — a weighted
# multi-archetype blend via avatara's compose(). Weights are optional integers (default 1, clamped
# 1..99); the dominant (highest-weight, first on ties) archetype leads the voice. Any unknown name
# aborts with an honest refusal. Needs >= 2 archetypes.
fn _cmd_persona_blend(rest) {
    if (rest == 0) {
        oprintln("usage: /persona blend <name>[:weight] <name>[:weight] ...   (weights default to 1)");
        return 0;
    }
    if (_persona_tok == 0) { _persona_tok = alloc(256); }
    var wv = vec_new();
    var count = 0;
    var p = rest;
    var go = 1;
    while (go == 1) {
        while (load8(p) == 32) { p = p + 1; }               # skip spaces
        if (load8(p) == 0) { go = 0; }
        else {
            var t = 0;                                      # copy the token (name[:weight]) into _persona_tok
            while ((load8(p) != 0) && (load8(p) != 32) && (t < 255)) { store8(_persona_tok + t, load8(p)); t = t + 1; p = p + 1; }
            store8(_persona_tok + t, 0);
            var wi = 1;                                     # split on ':' -> name + optional integer weight
            var ci = 0;
            while ((load8(_persona_tok + ci) != 0) && (load8(_persona_tok + ci) != 58)) { ci = ci + 1; }
            if (load8(_persona_tok + ci) == 58) {
                store8(_persona_tok + ci, 0);               # terminate the name at ':'
                wi = atoi(_persona_tok + ci + 1);
                if (wi < 1) { wi = 1; }
                if (wi > 99) { wi = 99; }                   # bounded (weight built by repeated add below)
            }
            var r = find_and_validate(_persona_tok);
            if (is_err_result(r) == 1) {
                emit("unknown persona: '"); emit(_persona_tok); oprintln("'");
                oprintln("  see /personas for the available archetypes.");
                return 0;
            }
            var w = 0.0;                                    # integer weight -> f64 (no int->f64 builtin)
            var k = 0;
            while (k < wi) { w = f64_add(w, 1.0); k = k + 1; }
            vec_push(wv, weighted_new(result_unwrap(r), w));
            count = count + 1;
        }
    }
    if (count < 2) {
        oprintln("blend needs at least two archetypes, e.g. /persona blend Athena Odin");
        return 0;
    }
    if (persona_blend(wv) == 0) { oprintln("blend failed (avatara compose rejected the inputs)."); return 0; }
    emit("persona -> "); emit(persona_name());
    emit(" ("); emit(persona_role()); oprintln(")");
    oprintln("  effective next turn — a weighted blend; the dominant (highest-weight) archetype leads the voice.");
    log_begin("persona_blend"); log_kv_str("persona", persona_name()); log_commit(SK_INFO);
    return 0;
}

# cmd_persona (0.22.0): mid-session ACTIVE-PERSONA switch — the twin of /model's mid-session MODEL switch.
# No arg shows the active archetype; an arg resolves through avatara's find_and_validate (unknown -> honest
# refusal). The switch invalidates the cached persona system prompt, so it takes effect NEXT turn (exactly
# /model's semantics). Pure consumption: avatara owns lookup/validation/content; thoth only selects + surfaces.
fn cmd_persona(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        emit("persona: "); emit(persona_name());
        emit(" ("); emit(persona_role()); oprintln(")");
        emit("  tradition: "); oprintln(persona_tradition());
        return 0;
    }
    if (token_is(arg, "shadow") == 1) { return _cmd_persona_shadow(arg_after(arg)); }   # 0.22.2
    if (token_is(arg, "blend") == 1) { return _cmd_persona_blend(arg_after(arg)); }      # 0.22.2
    if (persona_switch(arg) == 0) {
        emit("unknown persona: '"); emit(arg); oprintln("'");
        oprintln("  see /personas for the available archetypes (names are case-sensitive).");
        return 0;
    }
    emit("persona -> "); emit(persona_name());
    emit(" ("); emit(persona_role()); oprintln(")");
    oprintln("  effective next turn — the system prompt is rebuilt for the new archetype (mid-session switch).");
    log_begin("persona_switch"); log_kv_str("persona", persona_name()); log_commit(SK_INFO);
    return 0;
}

# _term_title_build (0.22.3): compose the terminal window-title text into dst (cap-bounded, NUL-terminated):
# "thoth - <model>" (the switchable model), or just "thoth" when no model is set. Pure/testable.
fn _term_title_build(dst, cap) {
    var off = 0;
    off = _append_cstr_cap(dst, off, cap, "thoth");
    var m = session_model();
    if (m == 0) { m = config_hoosh_model(); }
    if (m != 0) {
        off = _append_cstr_cap(dst, off, cap, " - ");
        # Append the model with control bytes (C0 < 0x20 incl. ESC/BEL, and DEL 0x7f) STRIPPED, so a
        # crafted /model arg or [hoosh].model value can never inject a terminal escape into the OSC-0
        # title. (The /copy OSC-52 path is injection-safe because it base64-encodes; this path filters.)
        var i = 0;
        while ((load8(m + i) != 0) && (off < (cap - 1))) {
            var c = load8(m + i);
            if ((c >= 32) && (c != 127)) { store8(dst + off, c); off = off + 1; }
            i = i + 1;
        }
    }
    store8(dst + off, 0);
    return off;
}

var _term_title = 0;
var TERM_TITLE_CAP = 256;
# term_title_set (0.22.3): set the terminal window/tab title via OSC 0 (ESC ] 0 ; <text> BEL) — a
# fire-and-forget terminal escape (like /copy's OSC 52), written raw to fd1. Only on a real terminal (a
# color-capable tier); a NO-OP at PT_PLAIN (piped / dumb / CI) so the floor + one-shot output stay clean.
fn term_title_set() {
    if (ui_tier() == PT_PLAIN) { return 0; }
    if (_term_title == 0) { _term_title = alloc(TERM_TITLE_CAP); }
    var n = _term_title_build(_term_title, TERM_TITLE_CAP);
    emit_raw("\x1b]0;");
    emit_raw_n(_term_title, n);
    emit_raw("\x07");
    return 0;
}

fn cmd_model(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        emit("model: ");
        var m = session_model();
        if (m == 0) { m = config_hoosh_model(); }
        if (m == 0) { oprintln("(none set - hoosh routes by its own provider config)"); }
        else { oprintln(m); }
        if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
            oprintln("hoosh seam absent - set [hoosh].url in .thoth/config.cyml to enable switching.");
        }
        return 0;
    }
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        emit("cannot switch to '"); emit(arg); oprintln("': hoosh seam is absent.");
        oprintln("set [hoosh].url in .thoth/config.cyml; mid-session switching routes through hoosh. see /seams.");
        return 0;
    }
    session_set_model_copy(arg);
    term_title_set();                        # 0.22.3: reflect the new model in the terminal title
    emit("model -> "); oprintln(arg);
    emit("  next turn routes to hoosh as '"); emit(arg); oprintln("' (mid-session switch).");
    log_begin("model_switch"); log_kv_str("model", arg); log_commit(SK_INFO);
    return 0;
}

# cmd_models: list the models the hoosh gateway advertises (GET /v1/models). The
# catalog is hoosh's domain (multi-provider routing) — thoth only asks and shows
# what to pick from, marking the active routing target. The hoosh seam must be
# bound; absent, it degrades honestly (no endpoint, no catalog claim).
fn cmd_models(line) {
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        oprintln("hoosh seam absent - no model gateway is wired.");
        oprintln("the model catalog is hoosh's domain (multi-provider routing).");
        oprintln("set [hoosh].url in .thoth/config.cyml. degraded honestly, never faked.");
        return 0;
    }
    # Bare /models lists the providers hoosh routes to; /models <provider> drills
    # into that provider's concrete, switchable models (hoosh's per-provider catalog).
    var prov = arg_after(line);
    if (prov == 0) { return hoosh_list_models(); }
    return hoosh_list_provider_models(prov);
}

# /read uses one reused heap buffer (the bump allocator never frees, so a
# fresh alloc per call would accrete over a long session). Files larger than
# the cap are truncated to it.
var _read_buf = 0;
var READ_BUF_CAP = 1048576;     # 1 MB

# _read_highlight: syntax-color buf[0..n) for `path` via the shared coverage-guarded
# _hl_span (src/diff.cyr — the same path the diff bodies use). Returns 1 if it
# highlighted, 0 if it declined (plain tier / unknown language) so cmd_read emits the
# file verbatim. _hl_span never drops or reorders a byte.
fn _read_highlight(path, buf, n) {
    if (ui_tier() == PT_PLAIN) { return 0; }
    var lang = detect_language(path);
    if (lang == 0) { return 0; }
    return _hl_span(lang, buf, n, ui_reset());
}

fn cmd_read(line) {
    var path = arg_after(line);
    if (path == 0) { oprintln("usage: /read <file>"); return 0; }
    if (file_exists(path) == 0) { emit("no such file: "); oprintln(path); return 0; }
    if (_read_buf == 0) { _read_buf = alloc(READ_BUF_CAP); }
    var n = file_read_all(path, _read_buf, READ_BUF_CAP - 1);
    if (n < 0) { emit("read failed: "); oprintln(path); return 0; }
    store8(_read_buf + n, 0);
    ui_emit(ROLE_FAINT, "--- "); ui_emit(ROLE_BLUE, path); ui_emit(ROLE_FAINT, " (");
    emit(ui_sgr(ROLE_FAINT)); ofmt_int(n); emit(ui_reset());
    ui_emit(ROLE_FAINT, " bytes) ---"); oprintln("");
    if (_read_highlight(path, _read_buf, n) == 0) { emit_n(_read_buf, n); }
    if (n > 0) { if (load8(_read_buf + n - 1) != 10) { oprintln(""); } }
    ui_emit(ROLE_FAINT, "--- end ---"); oprintln("");
    return 0;
}

# /write reuses two static buffers (the path copy + the content+newline
# output) so repeated writes don't accrete in the never-freeing bump heap —
# matching the /read and /run convention. Both are bounded by the 4096-byte
# input line. A trailing newline is appended to the content.
var _write_path = 0;
var _write_out = 0;
var _write_old = 0;
var WRITE_BUF_CAP = 4096;
var WRITE_OLD_CAP = 65536;   # old-file snapshot for the diff (capped; larger -> summarized)

fn cmd_write(line) {
    var rest = arg_after(line);
    if (rest == 0) { oprintln("usage: /write <path> <content>"); return 0; }
    if (_write_path == 0) { _write_path = alloc(WRITE_BUF_CAP); }
    if (_write_out == 0) { _write_out = alloc(WRITE_BUF_CAP); }
    var i = 0;
    while (load8(rest + i) != 0 && load8(rest + i) != 32) {
        if (i < (WRITE_BUF_CAP - 1)) { store8(_write_path + i, load8(rest + i)); }
        i = i + 1;
    }
    var plen = i;
    if (plen > (WRITE_BUF_CAP - 1)) { plen = WRITE_BUF_CAP - 1; }
    store8(_write_path + plen, 0);
    var content = 0;
    var j = i;
    while (load8(rest + j) == 32) { j = j + 1; }
    if (load8(rest + j) != 0) { content = rest + j; }
    if (content == 0) { oprintln("usage: /write <path> <content>"); return 0; }
    ui_emit(ROLE_FAINT, "propose write -> "); ui_emit(ROLE_BLUE, _write_path); oprintln("");
    var wparams = _params_one("path", _write_path);
    if (gate_authorize("thoth_write", wparams, "write to", _write_path) == 0) {
        ui_emit(ROLE_RED, "  denied. nothing written."); oprintln("");
        return 0;
    }
    var clen = strlen(content);
    if (clen > (WRITE_BUF_CAP - 2)) { clen = WRITE_BUF_CAP - 2; }
    memcpy(_write_out, content, clen);
    store8(_write_out + clen, 10);
    store8(_write_out + clen + 1, 0);
    # colored diff of the proposed change: old on disk (if any) -> the new content.
    if (_write_old == 0) { _write_old = alloc(WRITE_OLD_CAP); }
    var oldlen = 0;
    var old_toobig = 0;
    if (file_exists(_write_path) == 1) {
        var rn = file_read_all(_write_path, _write_old, WRITE_OLD_CAP - 1);
        if (rn >= (WRITE_OLD_CAP - 1)) { old_toobig = 1; }   # truncated read -> don't diff a lie
        elif (rn > 0) { oldlen = rn; }
    }
    if (old_toobig == 1) {
        emit("  "); ui_emit(ROLE_FAINT, "(old file > 64KB — diff skipped)"); oprintln("");
    } else {
        diff_render(_write_path, _write_old, oldlen, _write_out, clen + 1);
    }
    var rc = file_write_all(_write_path, _write_out, clen + 1);
    if (rc < 0) { emit("write failed: "); oprintln(_write_path); return 0; }
    emit("wrote "); ofmt_int(clen + 1); emit(" bytes (+newline) -> "); oprintln(_write_path);
    return 0;
}

# cmd_remember: append a fact VERBATIM to .thoth/memory/MEMORY.md as a bullet
# (0.12.1). t-ron-gated under the reserved name thoth_remember — the SAME choke
# point as /write, so a policy can target it and absent-t-ron falls to the
# fail-closed confirm. The shared writer is memory_append (src/memory.cyr; also
# used by the memory_write agentic tool). Degrades CLOSED on a missing dir /
# write failure (announced, never silent). Verbatim only — no summarize/tag/
# dedupe/link (that is mneme's engine — ADR-0012).
fn cmd_remember(line) {
    var text = arg_after(line);
    if (text == 0) { oprintln("usage: /remember <fact>"); return 0; }
    var rparams = _params_one("text", text);
    if (gate_authorize("thoth_remember", rparams, "remember to", memory_index_path()) == 0) {
        ui_emit(ROLE_RED, "  denied. nothing remembered."); oprintln("");
        return 0;
    }
    var rc = memory_append(text);
    if (rc == (0 - 2)) {
        emit("  "); ui_emit(ROLE_RED, memory_dir()); ui_emit(ROLE_RED, " not found");
        ui_emit(ROLE_MUTED, " — create it first (mkdir -p "); emit(memory_dir()); ui_emit(ROLE_MUTED, "), then /remember."); oprintln("");
        return 0;
    }
    if (rc < 0) { emit("  "); ui_emit(ROLE_RED, "write failed - memory not saved"); oprintln(""); return 0; }
    if (mem_last_target() == 1) {                    # 0.32.0: routed to mneme (semantic memory), not the local file
        emit("remembered -> "); ui_emit(ROLE_GREEN, "mneme"); ui_emit(ROLE_MUTED, " (semantic memory via daimon)"); oprintln("");
        return 0;
    }
    emit("remembered -> "); ui_emit(ROLE_BLUE, memory_index_path()); oprintln("");
    if (config_memory_enabled() == 0) {
        emit("  "); ui_emit(ROLE_FAINT, "note: [memory].enabled is off - the fact is saved but not injected until you enable it."); oprintln("");
    }
    return 0;
}

# cmd_bookmark (0.34.4): save the LAST assistant reply into mneme as a note — the per-message "remember". Routes
# through memory_append exactly like /remember (mneme_create_note when the seam is bound, else the local
# .thoth/memory file), under the SAME thoth_remember gate; the reply's first line becomes the note title.
fn cmd_bookmark() {
    var reply = session_last_assistant_content();
    if (reply == 0) { oprintln("nothing to bookmark - no reply in this conversation yet."); return 0; }
    var bp = _params_one("text", reply);
    if (gate_authorize("thoth_remember", bp, "bookmark to", memory_index_path()) == 0) {
        ui_emit(ROLE_RED, "  denied. nothing bookmarked."); oprintln(""); return 0;
    }
    var rc = memory_append(reply);
    if (rc == (0 - 2)) {
        emit("  "); ui_emit(ROLE_RED, memory_dir()); ui_emit(ROLE_RED, " not found");
        ui_emit(ROLE_MUTED, " - create it first (mkdir -p "); emit(memory_dir()); ui_emit(ROLE_MUTED, ")."); oprintln(""); return 0;
    }
    if (rc < 0) { emit("  "); ui_emit(ROLE_RED, "write failed - reply not bookmarked"); oprintln(""); return 0; }
    if (mem_last_target() == 1) {
        emit("bookmarked the last reply -> "); ui_emit(ROLE_GREEN, "mneme"); ui_emit(ROLE_MUTED, " (semantic memory via daimon)"); oprintln(""); return 0;
    }
    emit("bookmarked the last reply -> "); ui_emit(ROLE_BLUE, memory_index_path()); oprintln("");
    return 0;
}

# cmd_thumbs (0.34.4): feedback on the LAST reply's recalled mneme notes. `/thumbs up` records that the recalled
# notes were useful (mneme_search_feedback via daimon — improves mneme's future ranking); `/thumbs down` is honest
# that mneme has no negative-feedback tool. Uses the live citations state (the most recent recall); if the last
# reply cited no mneme notes, it says so. daimon applies its own per-tool policy on mneme_search_feedback.
fn cmd_thumbs(line) {
    var arg = arg_after(line);
    if (arg == 0) { oprintln("usage: /thumbs up   (mark the last reply's recalled notes useful)  |  /thumbs down"); return 0; }
    if (token_is(arg, "down") == 1) {
        ui_emit(ROLE_MUTED, "  mneme records positive feedback only - nothing sent. (/thumbs up marks the recalled notes useful.)"); oprintln("");
        return 0;
    }
    if (token_is(arg, "up") == 0) { oprintln("usage: /thumbs up | /thumbs down"); return 0; }
    var sid = citations_search_id();
    var nid = citations_feedback_note_id();
    if ((sid == 0) || (nid == 0)) {
        emit("  "); ui_emit(ROLE_FAINT, "no recalled mneme notes to rate - the last reply cited none (needs the memory seam bound + a recall)."); oprintln("");
        return 0;
    }
    if (memory_feedback(sid, nid) == 1) {
        emit("thumbs up -> "); ui_emit(ROLE_GREEN, "mneme"); ui_emit(ROLE_MUTED, " (recorded the recalled notes as useful)"); oprintln("");
    } else {
        emit("  "); ui_emit(ROLE_RED, "feedback failed"); ui_emit(ROLE_FAINT, " - mneme unreachable or refused"); oprintln("");
    }
    return 0;
}

# cmd_notes (0.32.6 — notebook): search the mneme knowledge base directly, the counterpart to per-turn recall. A
# READ via daimon's mneme_search (no thoth gate — daimon applies its own per-tool policy); needs the memory seam
# BOUND (daimon hosts mneme_*), else it degrades honestly. Displays mneme's formatted result VERBATIM — thoth
# consumes the domain, it does not re-rank or reformat (ADR-0012).
fn cmd_notes(line) {
    var query = arg_after(line);
    if (query == 0) { oprintln("usage: /notes <query>   - search your mneme knowledge base"); return 0; }
    daimon_mem_probe();
    if (daimon_mem_bound() == 0) {
        emit("  "); ui_emit(ROLE_FAINT, "notebook needs mneme - the memory seam is not bound (is daimon hosting mneme?)"); oprintln("");
        return 0;
    }
    var res = memory_notebook_search(query);
    if (res == 0) { emit("  "); ui_emit(ROLE_RED, "notebook: search failed (mneme unreachable or errored)"); oprintln(""); return 0; }
    ui_emit(ROLE_MUTED, "notebook (mneme):"); oprintln("");
    emit(res); oprintln("");
    return 0;
}

# --- conversation commands (0.33.1) ------------------------------------------------------------------------
# In-memory over the 0.33.0 conv_* store (multi-conversation persistence is 0.33.2). Numbers are 1-based (what
# /conversations shows); the store is 0-based, so `n - 1`. conv_switch/conv_delete are bounds-checked, and
# _conv_at clamps, so a bad index can never crash — the commands just report "no such conversation".
fn cmd_conversations(line) {
    var n = conv_count();
    if (n == 0) { conv_new(); n = conv_count(); }        # nothing recorded yet -> show the default one
    ui_emit(ROLE_MUTED, "conversations:"); oprintln("");
    var i = 0;
    while (i < n) {
        emit("  ");
        if (i == conv_active()) { ui_emit(ROLE_ACCENT, "* "); } else { emit("  "); }
        ofmt_int(i + 1); emit(". ");
        var t = conv_title(i);
        if (t == 0) { ui_emit(ROLE_FAINT, "(untitled)"); } else { ui_emit(ROLE_FG, t); }
        ui_emit(ROLE_FAINT, "  ("); ofmt_int(vec_len(conv_msgs(i))); ui_emit(ROLE_FAINT, " msg)"); oprintln("");
        i = i + 1;
    }
    return 0;
}
fn cmd_new(line) {
    var idx = conv_new();
    var title = arg_after(line);
    if (title != 0) { conv_set_title(idx, conv_dup_title(title)); }
    emit("new conversation "); ofmt_int(idx + 1);
    if (title != 0) { emit(": "); ui_emit(ROLE_FG, title); }
    oprintln("");
    return 0;
}
fn cmd_switch(line) {
    var arg = arg_after(line);
    if (arg == 0) { oprintln("usage: /switch <number>   (see /conversations)"); return 0; }
    var num = atoi(arg);
    if (num < 1) { emit("  "); ui_emit(ROLE_RED, "no such conversation"); oprintln(""); return 0; }
    if (num > conv_count()) { emit("  "); ui_emit(ROLE_RED, "no such conversation"); oprintln(""); return 0; }
    conv_switch(num - 1);
    emit("switched to conversation "); ofmt_int(num);
    var t = conv_title(num - 1);
    if (t != 0) { emit(": "); ui_emit(ROLE_FG, t); }
    oprintln("");
    return 0;
}
fn cmd_rename(line) {
    var title = arg_after(line);
    if (title == 0) { oprintln("usage: /rename <title>"); return 0; }
    conv_set_title(conv_active(), conv_dup_title(title));
    emit("renamed to "); ui_emit(ROLE_FG, title); oprintln("");
    return 0;
}
fn cmd_delete(line) {
    var arg = arg_after(line);
    if (arg == 0) { oprintln("usage: /delete <number>   (see /conversations)"); return 0; }
    var num = atoi(arg);
    if (num < 1) { emit("  "); ui_emit(ROLE_RED, "no such conversation"); oprintln(""); return 0; }
    if (num > conv_count()) { emit("  "); ui_emit(ROLE_RED, "no such conversation"); oprintln(""); return 0; }
    if (conv_delete(num - 1) == 0) { emit("  "); ui_emit(ROLE_FAINT, "can't delete the last conversation"); oprintln(""); return 0; }
    emit("deleted conversation "); ofmt_int(num);
    ui_emit(ROLE_MUTED, " (now on "); ofmt_int(conv_active() + 1); ui_emit(ROLE_MUTED, ")"); oprintln("");
    return 0;
}

# --- /search (0.33.7): full-text search across ALL conversations ------------------------------------------
# Distinct from /find (a TUI in-buffer feed search): /search scans every message of every conversation in the
# store for a case-insensitive substring, listing matches grouped by conversation (with the * active marker + the
# 1-based number) so a past thread is findable and switchable (/switch <n>). Works in any mode; mirrors the
# /conversations presentation. Snippets flatten control bytes to spaces and cap context around the match.
var COMPACT_KEEP_DEFAULT = 6;  # 0.40.0 (T1-5): messages /compact keeps verbatim — enough for the live thread
var SEARCH_MAX = 60;           # cap total match lines (a huge store must not flood the pane)
var SEARCH_CTX = 24;           # snippet context chars on each side of the match
var SEARCH_BUF = 512;
var _search_buf = 0;
fn _search_lc(b) { if ((b >= 65) && (b <= 90)) { return b + 32; } return b; }
# _search_find: the case-insensitive index of `needle` in `hay`, or -1 (thoth's strstr is case-SENSITIVE).
fn _search_find(hay, needle) {
    var nlen = strlen(needle);
    if (nlen == 0) { return 0; }
    var hlen = strlen(hay);
    if (nlen > hlen) { return 0 - 1; }
    var limit = hlen - nlen;
    var i = 0;
    while (i <= limit) {
        var j = 0;
        var matched = 1;
        while ((j < nlen) && (matched == 1)) {
            if (_search_lc(load8(hay + i + j)) != _search_lc(load8(needle + j))) { matched = 0; }
            j = j + 1;
        }
        if (matched == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# _search_emit_range: emit content[a..b) in `role`, control bytes flattened to space (a one-line snippet). Bounded
# by SEARCH_BUF so a pathological range can't overrun the scratch.
fn _search_emit_range(content, a, b, role) {
    if (_search_buf == 0) { _search_buf = alloc(SEARCH_BUF); }
    var o = 0;
    var i = a;
    while ((i < b) && (o < (SEARCH_BUF - 1))) {
        var c = load8(content + i);
        if (c < 32) { c = 32; }
        store8(_search_buf + o, c); o = o + 1;
        i = i + 1;
    }
    store8(_search_buf + o, 0);
    if (o > 0) { ui_emit(role, _search_buf); }
    return 0;
}
# _search_snippet: a "...before<MATCH>after..." context window around idx (match length qlen), the match in accent.
fn _search_snippet(content, idx, qlen) {
    var clen = strlen(content);
    var start = idx - SEARCH_CTX;
    if (start < 0) { start = 0; }
    var end = idx + qlen + SEARCH_CTX;
    if (end > clen) { end = clen; }
    if (start > 0) { ui_emit(ROLE_FAINT, "..."); }
    _search_emit_range(content, start, idx, ROLE_MUTED);
    _search_emit_range(content, idx, idx + qlen, ROLE_ACCENT);
    _search_emit_range(content, idx + qlen, end, ROLE_MUTED);
    if (end < clen) { ui_emit(ROLE_FAINT, "..."); }
    return 0;
}
fn cmd_search(line) {
    var q = arg_after(line);
    if (q == 0) { oprintln("usage: /search <text>   (searches all conversations)"); return 0; }
    var nc = conv_count();
    if (nc == 0) { emit("  "); ui_emit(ROLE_FAINT, "no conversations to search"); oprintln(""); return 0; }
    ui_emit(ROLE_MUTED, "search "); ui_emit(ROLE_ACCENT, q); ui_emit(ROLE_MUTED, ":"); oprintln("");
    var qlen = strlen(q);
    var hits = 0;
    var nconv = 0;
    var capped = 0;
    var ci = 0;
    while ((ci < nc) && (capped == 0)) {
        var msgs = conv_msgs(ci);
        var mn = vec_len(msgs);
        var mi = 0;
        var shown = 0;
        while ((mi < mn) && (capped == 0)) {
            var m = vec_get(msgs, mi);
            var content = load64(m + 8);
            if (content != 0) {
                var idx = _search_find(content, q);
                if (idx >= 0) {
                    if (hits >= SEARCH_MAX) { capped = 1; }
                    else {
                        if (shown == 0) {                    # the conversation header, once per matching conversation
                            emit("  ");
                            if (ci == conv_active()) { ui_emit(ROLE_ACCENT, "* "); } else { emit("  "); }
                            ofmt_int(ci + 1); emit(". ");
                            var t = conv_title(ci);
                            if (t == 0) { ui_emit(ROLE_FAINT, "(untitled)"); } else { ui_emit(ROLE_FG, t); }
                            oprintln("");
                            shown = 1;
                            nconv = nconv + 1;
                        }
                        emit("      "); ui_emit(ROLE_FAINT, load64(m)); emit("  ");   # role + the snippet
                        _search_snippet(content, idx, qlen);
                        oprintln("");
                        hits = hits + 1;
                    }
                }
            }
            mi = mi + 1;
        }
        ci = ci + 1;
    }
    if (hits == 0) { emit("  "); ui_emit(ROLE_FAINT, "no matches"); oprintln(""); return 0; }
    emit("  "); ofmt_int(hits); ui_emit(ROLE_FAINT, " matches in "); ofmt_int(nconv); ui_emit(ROLE_FAINT, " conversation(s)");
    if (capped == 1) { ui_emit(ROLE_FAINT, " (showing the first "); ofmt_int(SEARCH_MAX); ui_emit(ROLE_FAINT, ")"); }
    oprintln("");
    ui_emit(ROLE_FAINT, "  /switch <n> to open a conversation"); oprintln("");
    return 0;
}

fn cmd_run(line) {
    var cmdline = arg_after(line);
    if (cmdline == 0) { oprintln("usage: /run <shell command>"); return 0; }
    oprintln("this /run is a local built-in shell escape (substrate), not the MCP tool spine.");
    emit("  proposed: "); oprintln(cmdline);
    var rparams = _params_one("cmd", cmdline);
    if (gate_authorize("thoth_run", rparams, "run", cmdline) == 0) {
        oprintln("  denied. nothing ran.");
        return 0;
    }
    var rc = run_shell(cmdline);
    if (rc == (0 - 1)) { oprintln("  (failed to spawn /bin/sh)"); return 0; }
    emit("  exit "); ofmt_int(rc); oprintln("");
    return 0;
}

# cmd_tools: list the MCP tools daimon hosts. When daimon is absent the model has no MCP registry — but
# since 0.20.0 the agentic loop can still run on the thoth-native `shell` tool alone, so surface THAT
# honestly rather than claiming no tools exist (which would contradict what a shell-standalone turn sends).
fn cmd_tools() {
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) {
        if (agent_enabled() == 1) {
            oprintln("daimon seam absent - no MCP host; the agentic loop runs on thoth-native tools only:");
            ui_emit(ROLE_ACCENT, "  shell"); ui_emit(ROLE_MUTED, " - run a local command (t-ron thoth_shell gated, [shell.deny]/[allow] filtered)"); oprintln("");
            if (seam_cap_state(SEAM_MEMORY) != CAP_ABSENT) { ui_emit(ROLE_ACCENT, "  memory_write"); ui_emit(ROLE_MUTED, " - save a durable fact to .thoth/memory (t-ron thoth_remember gated)"); oprintln(""); }
            oprintln("  (set [daimon].url for an MCP tool host.)");
            return 0;
        }
        oprintln("daimon seam absent - no MCP tool host is wired.");
        oprintln("tool listing/execution is daimon's domain (the MCP host registry).");
        oprintln("set [daimon].url in .thoth/config.cyml. degraded honestly, never faked.");
        return 0;
    }
    return daimon_list_tools();
}

# cmd_call: invoke one MCP tool by name through daimon, t-ron-gated. Usage:
# /call <tool> [json-arguments]. The args default to {}.
var _call_name = 0;
var CALL_NAME_CAP = 256;

fn cmd_call(line) {
    var rest = arg_after(line);
    if (rest == 0) { oprintln("usage: /call <tool> [json-arguments]"); return 0; }
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) {
        oprintln("daimon seam absent - no MCP tool host is wired.");
        oprintln("set [daimon].url in .thoth/config.cyml. degraded honestly, never faked.");
        return 0;
    }
    if (_call_name == 0) { _call_name = alloc(CALL_NAME_CAP); }
    var i = 0;
    while (load8(rest + i) != 0 && load8(rest + i) != 32) {
        if (i < (CALL_NAME_CAP - 1)) { store8(_call_name + i, load8(rest + i)); }
        i = i + 1;
    }
    var nlen = i;
    if (nlen > (CALL_NAME_CAP - 1)) { nlen = CALL_NAME_CAP - 1; }
    store8(_call_name + nlen, 0);
    var args = 0;
    while (load8(rest + i) == 32) { i = i + 1; }
    if (load8(rest + i) != 0) { args = rest + i; }
    var gp = args;
    if (gp == 0) { gp = "{}"; }
    if (gate_authorize(_call_name, gp, "call tool", _call_name) == 0) {
        oprintln("  denied. no request sent.");
        return 0;
    }
    return daimon_call(_call_name, args);
}

# cmd_reset: clear the multi-turn conversation context — the next turn starts a
# fresh exchange (the model id and turn counter are kept). Honest no-op message
# when there was nothing to clear.
# cmd_rewind: undo the model's file writes (0.40.0, T1-4).
#
#   /rewind          list what can be undone
#   /rewind last     undo every write from the most recent turn that wrote
#   /rewind <n>      undo checkpoint n (as numbered by the bare listing)
#
# Restores FILES only — the conversation is untouched, deliberately. Undoing an edit and silently
# rewriting history would leave the model's transcript claiming a change that is no longer on disk;
# keeping the transcript means the next turn can see it was reverted and say why.
fn cmd_rewind(line) {
    var n = ckpt_count();
    var arg = arg_after(line);
    if (arg == 0) {
        if (n == 0) {
            ui_emit(ROLE_MUTED, "nothing to rewind — the model has not written any files this session."); oprintln("");
            ui_emit(ROLE_FAINT, "  (only `edit` and `create_file` are checkpointed; a file changed by the `shell` tool is not)"); oprintln("");
            return 0;
        }
        ui_emit(ROLE_ACCENT, "file checkpoints ("); ofmt_int(n); ui_emit(ROLE_ACCENT, ", newest last):"); oprintln("");
        var i = 0;
        while (i < n) {
            emit("  "); ofmt_int(i + 1); emit(". ");
            ui_emit(ROLE_FAINT, "turn "); ofmt_int(ckpt_turn_at(i)); emit("  ");
            emit(ckpt_path_at(i));
            if (ckpt_snap_at(i) < 0) { ui_emit(ROLE_GREEN, "  (created — rewind removes it)"); }
            oprintln("");
            i = i + 1;
        }
        ui_emit(ROLE_FAINT, "  /rewind last  undo the newest turn's writes · /rewind <n>  undo one"); oprintln("");
        return 0;
    }
    if (n == 0) { oprintln("nothing to rewind — no checkpoints this session."); return 0; }
    if (streq(arg, "last") == 1) {
        var t = ckpt_last_turn();
        var done = ckpt_restore_turn(t);
        if (done == 0) { ui_emit(ROLE_RED, "rewind failed"); ui_emit(ROLE_FAINT, " — no file could be restored (a snapshot may be gone)"); oprintln(""); return 0; }
        emit("rewound "); ofmt_int(done); emit(" file(s) from turn "); ofmt_int(t); oprintln(".");
        ui_emit(ROLE_FAINT, "  the conversation is unchanged — the model can still see what it tried."); oprintln("");
        return 0;
    }
    if ((load8(arg) < 48) || (load8(arg) > 57)) {
        oprintln("usage: /rewind        list · /rewind last   undo the newest turn · /rewind <n>   undo one");
        return 0;
    }
    var k = atoi(arg);
    if ((k < 1) || (k > n)) { emit("no checkpoint "); ofmt_int(k); emit(" — there are "); ofmt_int(n); oprintln("."); return 0; }
    if (ckpt_restore_one(k - 1) == 0) { ui_emit(ROLE_RED, "rewind failed"); ui_emit(ROLE_FAINT, " — the snapshot could not be read back"); oprintln(""); return 0; }
    emit("rewound "); oprintln(ckpt_path_at(k - 1));
    return 0;
}

# cmd_context: what is filling the context window right now (0.40.0, T1-5).
#
# thoth already COMPUTED all of this — the 0.19.0 meters feed the status bar — but a user could only see a
# single pressure indicator, not the breakdown. The question this answers is the one people actually ask
# before a long turn: "how much room is left, and what is about to be dropped?"
fn cmd_context() {
    var n = session_history_len();
    var bytes = hoosh_ctx_bytes();
    var budget = hoosh_ctx_budget();
    var evicted = hoosh_ctx_evicted();
    ui_emit(ROLE_ACCENT, "context"); oprintln("");
    ui_label("  messages: "); ofmt_int(n);
    if (evicted > 0) {
        ui_emit(ROLE_MUTED, " ("); ofmt_int(evicted); ui_emit(ROLE_MUTED, " oldest not sent, "); ofmt_int(n - evicted); ui_emit(ROLE_MUTED, " in the request)");
    } else { ui_emit(ROLE_MUTED, " (all sent)"); }
    oprintln("");
    ui_label("  history : "); ofmt_int(hoosh_ctx_kib()); emit(" KiB of "); ofmt_int(hoosh_ctx_budget_kib()); emit(" KiB framed");
    if (budget > 0) { emit(" ("); ofmt_int((bytes * 100) / budget); emit("%)"); }
    if (bytes > budget) { ui_emit(ROLE_RED, "  OVER — oldest turns are being dropped"); }
    oprintln("");
    ui_label("  recap   : ");
    var covers = session_recap_covers();
    if (covers > 0) { emit("covers the oldest "); ofmt_int(covers); emit(" message(s)"); }
    elif (config_hoosh_summarize() == 1) { ui_emit(ROLE_MUTED, "none yet (auto — [hoosh].summarize is on)"); }
    else { ui_emit(ROLE_MUTED, "none — dropped turns are silently lost; /compact, or set [hoosh].summarize"); }
    oprintln("");
    if (hoosh_compact_floor() > 0) {
        ui_label("  compact : "); emit("floor at "); ofmt_int(hoosh_compact_floor()); oprintln(" (forced by /compact or [hoosh].compact_at)");
    }
    ui_label("  tokens  : "); ofmt_int(session_tokens()); emit(" this session");
    if (config_hoosh_compact_at() > 0) {
        emit(" — auto-compact at "); ofmt_int(config_hoosh_compact_at());
    } else { ui_emit(ROLE_MUTED, " — [hoosh].compact_at to auto-compact"); }
    oprintln("");
    return 0;
}

# cmd_compact: summarize the older turns NOW and stop sending them (0.40.0, T1-5).
#
# The 0.36.4 recap is a REACTION to byte-budget overflow. This is the same machinery under the user's
# hand, before the pressure bites. `keep` is how many recent messages stay verbatim (default 6 — enough
# that the current thread survives intact).
fn cmd_compact(line) {
    var keep = COMPACT_KEEP_DEFAULT;
    var arg = arg_after(line);
    if (arg != 0) {
        # atoi answers 0 for a non-numeric string, which is indistinguishable from an explicit "0" — so
        # check the FIRST BYTE is a digit rather than trusting the parse. "/compact all" must be a usage
        # error, not a silent "keep 0" that drops the whole conversation.
        if ((load8(arg) < 48) || (load8(arg) > 57)) {
            oprintln("usage: /compact [keep]   — keep is how many recent messages stay verbatim");
            return 0;
        }
        keep = atoi(arg);
    }
    var n = session_history_len();
    if (n == 0) { oprintln("nothing to compact — the conversation is empty."); return 0; }
    if (n <= keep) { emit("nothing to compact — only "); ofmt_int(n); emit(" message(s), keeping "); ofmt_int(keep); oprintln("."); return 0; }
    ui_emit(ROLE_MUTED, "  compacting… (one small model call)"); oprintln("");
    var done = hoosh_compact_now(keep);
    if (done < 0) {
        ui_emit(ROLE_RED, "compact failed"); ui_emit(ROLE_FAINT, " — "); oprintln(hoosh_recap_err());
        ui_emit(ROLE_FAINT, "  nothing was dropped; the conversation is unchanged."); oprintln("");
        return 0;
    }
    if (done == 0) { emit("already compacted to that point ("); ofmt_int(keep); oprintln(" recent messages kept)."); return 0; }
    emit("compacted "); ofmt_int(done); emit(" message(s) into a recap; keeping the newest ");
    ofmt_int(keep); oprintln(" verbatim.");
    ui_emit(ROLE_FAINT, "  they stay in your transcript — they just stop being sent. /context to see the result."); oprintln("");
    return 0;
}

# cmd_grants: list the session's authorization grants, or clear them (`/grants clear`). 0.40.0 (T1-6).
#
# The point of showing these is that a grant is an answer that keeps acting after the moment it was given.
# `confirm` announces each use, but a user who has been working for an hour should be able to ask what
# they have standing without waiting for the next prompt. Session-only by design — a durable grant is a
# POLICY and belongs in [tron].policy, where t-ron can audit and rate-limit it.
fn cmd_grants(line) {
    var arg = arg_after(line);
    if ((arg != 0) && (streq(arg, "clear") == 1)) {
        var had = grant_count();
        grants_clear();
        if (had == 0) { oprintln("no session grants to clear."); }
        else { emit("cleared "); ofmt_int(had); oprintln(" session grant(s). the next matching action will ask again."); }
        return 0;
    }
    var n = grant_count();
    if (n == 0) {
        ui_emit(ROLE_MUTED, "no session grants."); oprintln("");
        ui_emit(ROLE_FAINT, "  answer 'a' at an authorization prompt to allow that exact action for the rest of the session."); oprintln("");
        return 0;
    }
    ui_emit(ROLE_ACCENT, "session grants ("); ofmt_int(n); ui_emit(ROLE_ACCENT, ", exact match, not persisted):"); oprintln("");
    var i = 0;
    while (i < n) {
        emit("  "); ui_emit(ROLE_ACCENT, grant_verb_at(i)); emit(" ");
        oprintln(grant_obj_at(i));
        i = i + 1;
    }
    ui_emit(ROLE_FAINT, "  /grants clear to revoke. these never reach disk — for a durable rule use [tron].policy."); oprintln("");
    return 0;
}

fn cmd_reset() {
    var n = session_history_len();
    session_history_clear();
    sess_persist_save();       # 0.24.2: mirror the cleared history to [session].file so /reset isn't undone by a resume
    roundlog_reset();
    editlog_reset();           # 0.31.1: drop the recorded edit diffs too
    memlog_reset();            # 0.32.5: drop the per-turn memory records too
    reasonlog_reset();         # 0.35.3: drop the per-turn reasoning records too
    grants_clear();            # 0.40.0 (T1-6): the answers the user gave THIS session go with it — a
                               # grant outliving the conversation it was given in would be a surprise
    hoosh_compact_floor_clear();  # 0.40.0 (T1-5): an index into a history that no longer exists
    ckpt_reset();              # 0.40.0 (T1-4): the writes belong to the conversation being cleared
    if (n == 0) { oprintln("conversation already empty — nothing to clear."); }
    else { emit("conversation cleared ("); ofmt_int(n); oprintln(" messages dropped). fresh context."); }
    return 0;
}

# cmd_reload (0.24.4): re-read .thoth/config.cyml mid-session. Re-parsing rebuilds the config globals; the agent tool
# cache is dropped so a changed [shell].enabled / [hoosh].tools (or a now-reachable daimon) re-advertises next
# turn. HONEST about the split: HOT fields take effect immediately because the runtime reads them per-use;
# BIND-ONCE fields were consumed at startup and are NOT re-bound (their runtime state — seams, cached hoosh
# endpoints, the t-ron/log seams, the persona default, the persisted-file bindings — would need a restart). We
# never claim a reload changed something it didn't.
fn cmd_reload() {
    if (file_exists(config_path()) == 0) {
        ui_emit(ROLE_RED, "no "); emit(config_path()); ui_emit(ROLE_FAINT, " found — nothing to reload"); oprintln("");
        return 0;
    }
    config_load();                            # re-parse: rebuilds [alias]/[shell]/[pricing]/read_roots + all _cfg_* globals
    if (config_parse_ok() == 0) {             # readable? the file could not be read/parsed -> degrade honestly, don't fake success
        ui_emit(ROLE_RED, "reload failed"); ui_emit(ROLE_FAINT, " — could not read/parse "); emit(config_path()); ui_emit(ROLE_FAINT, " (config unchanged)"); oprintln("");
        return 0;
    }
    agent_tools_cache_reset();                # re-advertise tools next turn (picks up [shell].enabled / [hoosh].tools / daimon)
    hoosh_auth_cache_reset();                 # a rotated [hoosh].token takes effect next request (else stale Bearer header)
    ui_emit(ROLE_GREEN, "reloaded "); emit(config_path()); oprintln("");
    ui_emit(ROLE_FAINT, "  now active: [alias] · [shell] rules · [ui] · [pricing] · [hoosh] flags/token/model · [memory]"); oprintln("");
    ui_emit(ROLE_FAINT, "  additive:   [project] read_roots (new roots granted; restart to revoke)"); oprintln("");
    ui_emit(ROLE_FAINT, "  restart to change: [hoosh]/[daimon] url · [tron] · [log] · [persona] · [history]/[session] file"); oprintln("");
    if (config_hoosh_url() == 0) { ui_emit(ROLE_RED, "  note: [hoosh].url is not set — model turns are unavailable"); oprintln(""); }
    return 0;
}

# cmd_audit: surface t-ron's audit chain. With the seam absent there is no
# chain — the fail-closed confirm gate keeps no cryptographic log; said plainly,
# degraded honestly. With it bound, gate.cyr renders t-ron's query API.
fn cmd_audit() {
    if (gate_active() == 0) {
        oprintln("t-ron seam absent - no audit chain.");
        oprintln("the fail-closed confirm gate keeps no cryptographic log; the libro");
        oprintln("audit chain is t-ron's domain. set [tron].policy in .thoth/config.cyml.");
        roundlog_report();
        return 0;
    }
    gate_audit_report();
    roundlog_report();
    return 0;
}

# --- turn-completion niceties (0.24.3) ------------------------------------
var _ui_bell_buf = 0;          # lazy [0x07, 0] — the BEL byte for emit_raw_n

# _ui_emit_bell: write a terminal BEL (0x07) DIRECTLY to fd1 (emit_raw_n bypasses the OUT_RING feed sink —
# a bell is terminal control, not feed text, like the OSC-52 / kitty escapes).
fn _ui_emit_bell() {
    if (_ui_bell_buf == 0) { _ui_bell_buf = alloc(2); store8(_ui_bell_buf, 7); store8(_ui_bell_buf + 1, 0); }
    emit_raw_n(_ui_bell_buf, 1);
    return 0;
}

# _task_emit_secs: emit `ms` milliseconds as "N.Ns" (one decimal), sink-aware. PURE format over the sink.
fn _task_emit_secs(ms) {
    if (ms < 0) { ms = 0; }
    ofmt_int(ms / 1000); emit("."); ofmt_int((ms % 1000) / 100); emit("s");
    return 0;
}

# _task_turn_feedback: after a model turn (interactive only — one-shot stays clean), optionally ring the
# terminal BEL ([ui].bell) and print a faint "(N.Ns)" elapsed line ([ui].elapsed). `t0` is the pre-turn
# clock_now_ms(). Both opt-in (default off) so the floor is byte-identical.
fn _task_turn_feedback(t0) {
    if (one_shot_active() == 1) { return 0; }        # interactive-only; one-shot output stays clean
    if (config_ui_bell() == 1) { _ui_emit_bell(); }
    if (config_ui_elapsed() == 1) {
        emit(ui_sgr(ROLE_FAINT)); emit("("); _task_emit_secs(clock_now_ms() - t0); emit(")"); emit(ui_reset()); oprintln("");
    }
    return 0;
}

# _task_dispatch (0.34.0): run a FINAL (already @mention-expanded) prompt as one model turn — the shared core of
# cmd_task and the /retry regenerate path. Handles the hoosh-absent degrade, the agentic-vs-plain split, and the
# [ui] turn-timing feedback. It does NOT bump the turn counter or echo the prompt — its callers own that framing,
# so /retry can print its own notice and pass the STORED (un-re-expanded) content. Returns the turn's rc.
fn _task_dispatch(prompt) {
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        oprintln("  hoosh seam absent - no model backend is wired.");
        oprintln("  reasoning/codegen routes through hoosh (native on AGNOS, a client");
        oprintln("  elsewhere). set [hoosh].url in .thoth/config.cyml. degraded honestly, never faked.");
        return 0;
    }
    # When daimon is wired and tools are on, drive the agentic tool-calling loop
    # (the model can call MCP tools, gated by t-ron); else a plain hoosh turn.
    var t0 = clock_now_ms();                          # 0.24.3: time the turn for [ui].elapsed
    var rc = 0;
    if (agent_enabled() == 1) { rc = agent_turn(prompt); }
    else { rc = hoosh_send(prompt); }
    _task_turn_feedback(t0);                          # interactive BEL + faint elapsed line (opt-in)
    # 0.40.0 (T1-5): the [hoosh].compact_at trigger, AFTER the turn — never mid-turn, where it would
    # inject a side-call into the middle of the exchange the user is watching. Silent no-op when unset.
    # Placed at this single dispatch chokepoint so /retry and one-shot get it too, not just /task.
    hoosh_compact_auto();
    return rc;
}

fn cmd_task(line) {
    session_bump_turn();
    emit("task: "); oprintln(line);              # echo the ORIGINAL line (with @mentions), not the expansion
    # @file mentions (0.21.0): a `@path` that resolves to a readable file gets that file's content
    # appended to the prompt as delimited context. Non-resolving @tokens stay literal, so ordinary
    # prose is untouched and `prompt == line` (byte-identical) when nothing resolves.
    var prompt = mention_expand(line);
    if (mention_count() > 0) {
        ui_emit(ROLE_FAINT, "  (+"); emit(ui_sgr(ROLE_FAINT)); ofmt_int(mention_count());
        emit(ui_reset()); ui_emit(ROLE_FAINT, " file(s) attached as context)"); oprintln("");
    }
    return _task_dispatch(prompt);
}

# cmd_regenerate (/retry, /regenerate — 0.34.0): re-run the LAST user prompt for a fresh reply. Rewinds the last
# turn (drops the prior reply + its user echo) and re-runs the EXACT stored prompt — already @mention-expanded, so
# it is NOT put through mention_expand again (that would double-inject the file blocks, see mention.cyr). Guarded:
# with hoosh absent it refuses WITHOUT rewinding (no point destroying the last exchange when no reply can be
# produced). NON-DESTRUCTIVE on failure: the rewind is snapshotted, so if the re-run produces no fresh reply (a
# transport/HTTP error, an empty completion, or a stateless non-recording turn), session_rewind_settle RESTORES the
# prior exchange byte-for-byte — the previous reply AND the user's prompt survive.
fn cmd_regenerate() {
    if (session_last_user_index() < 0) {
        oprintln("nothing to regenerate — no message in this conversation yet.");
        return 0;
    }
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        oprintln("  hoosh seam absent - no model backend is wired; cannot regenerate.");
        oprintln("  set [hoosh].url in .thoth/config.cyml. (the last reply is kept.)");
        return 0;
    }
    var prompt = session_rewind_to_last_user();       # drop the old reply + user echo (snapshotted); keep the prompt
    session_bump_turn();
    ui_emit(ROLE_FAINT, "regenerating the last reply…"); oprintln("");
    var rc = _task_dispatch(prompt);                   # re-run VERBATIM (no re-expansion)
    session_rewind_settle(session_turns());            # commit if a fresh reply landed, else restore the old exchange
    return rc;
}

# cmd_edit (/edit <new text> — 0.34.0): replace your LAST message with new text and re-run the turn. Rewinds the
# last turn (drops the prior reply + user echo) then runs the new text through the normal task path, so fresh
# @mentions in the edit expand as usual. Guarded like /retry: it refuses WITHOUT rewinding when hoosh is absent.
# NON-DESTRUCTIVE on failure: the rewind snapshots the messages AND the title, so a re-run that records no
# replacement restores the old exchange (and reverts any auto-title the failed append set). On a committed edit of
# a first message, an UNTITLED conversation retitles from the new text via the normal append auto-title; a
# already-titled conversation keeps its title (we never clobber an explicit /rename).
fn cmd_edit(line) {
    var newtext = arg_after(line);
    if (newtext == 0) {
        oprintln("usage: /edit <new text>   — replace your last message and re-run");
        return 0;
    }
    if (session_last_user_index() < 0) {
        oprintln("nothing to edit — no message in this conversation yet.");
        return 0;
    }
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        oprintln("  hoosh seam absent - no model backend is wired; cannot re-run an edit.");
        oprintln("  set [hoosh].url in .thoth/config.cyml. (your last message is kept.)");
        return 0;
    }
    session_rewind_to_last_user();                       # discard the old message + its reply (snapshotted)
    var rc = cmd_task(newtext);                           # full path: bump turn, echo, expand mentions, dispatch
    session_rewind_settle(session_turns());              # commit if a fresh reply landed, else restore the old exchange
    return rc;
}

# cmd_clear: clear the content window. In the T2 TUI (output captured, OUT_RING) it
# empties the feed ring — the post-dispatch repaint shows a clean window. In the line
# REPL on a real terminal it clears the screen; piped/CI (no window) it is a no-op so
# nothing leaks. Distinct from /reset, which clears the conversation CONTEXT, not the
# on-screen feed.
fn cmd_clear() {
    if (out_mode() == OUT_RING) { feed_clear(); return 0; }
    if (ui_tier() != PT_PLAIN) { tty_clear(); tty_cursor_home(); }
    return 0;
}

# cmd_copy: copy the last model reply to the system clipboard via OSC 52 — a terminal escape WRITE
# (ESC ] 52 ; c ; <base64> BEL), no fork/exec/dup2, so it works on AGNOS and over SSH (0.17.3). The
# reply is bayan-base64'd and the escape is written DIRECTLY to fd1 with emit_raw / raw SYS_WRITE, which
# bypass the OUT_RING feed sink (an escape is terminal control, not feed text — the same path the kitty/
# mouse enable escapes use); the ANNOUNCEMENT uses the normal sink so it lands in the feed / stdout.
# BEST-EFFORT and honest: OSC 52 is fire-and-forget (a terminal may ignore it or a tmux/screen wrapper
# may swallow it, and we cannot read back success), so the message never asserts it landed. Needs a real
# terminal (the escape is meaningless on redirected stdout) — gated on ui_isatty(1), matching the tier
# probe. NOT t-ron-gated: it only SETS the clipboard (never queries/reads it) with content the user can
# already see — the same ungated display class as /read. The reply is bounded to HOOSH_ACC_CAP (64 KiB),
# so no truncation is needed; a large payload is written with a write-all loop (a single tty write() can
# be short). BEL (not ST) terminates the OSC — the more widely accepted form.
fn cmd_copy() {
    var n = hoosh_last_reply_len();
    if (n <= 0) { oprintln("nothing to copy yet — no model reply this session"); return 0; }
    if (ui_isatty(1) == 0) { oprintln("clipboard copy needs a terminal (stdout is not a tty)"); return 0; }
    var b64 = bayan_base64_encode(hoosh_last_reply(), n);
    var enc = ((n + 2) / 3) * 4;                          # base64 length (standard, '=' padded)
    emit_raw("\x1b]52;c;");                                # OSC 52 set-clipboard, selection 'c'
    var sent = 0;
    var ok = 1;
    while (sent < enc) {                                   # write-all: a single tty write() can short-write
        var w = syscall(SYS_WRITE, 1, b64 + sent, enc - sent);
        if (w <= 0) { ok = 0; sent = enc; } else { sent = sent + w; }
    }
    emit_raw("\x07");                                      # BEL terminator
    if (ok == 0) { oprintln("clipboard copy: terminal write failed"); return 0; }
    emit("copied "); ofmt_int(n); oprintln(" bytes to the clipboard (best-effort — your terminal may ignore OSC 52)");
    return 0;
}

# cmd_find: /find [text] — search the feed scrollback (0.18.4). TUI-only: it drives the same modal that
# Ctrl-F opens (highlights + n/N jump). Bare /find opens the search input (type the query); /find <text>
# jumps straight to the newest match in nav mode. Outside the TUI (piped/REPL/one-shot, out_mode != OUT_RING)
# there is no re-renderable feed to highlight, so it announces honestly and does nothing (floor-safe).
fn cmd_find(line) {
    var q = arg_after(line);
    if (out_mode() != OUT_RING) {
        oprintln("find: search runs in the rich TUI — start thoth in a terminal, then Ctrl-F (or /find <text>)");
        return 0;
    }
    var ql = 0;
    if (q != 0) { ql = strlen(q); }
    tui_search_from_cmd(q, ql);
    return 0;
}

# cmd_theme: switch the color theme. Bare /theme shows the active theme + the choices;
# `/theme dark|light` switches (rebuilds the cached SGR table — chrome + new output re-color, and since
# 0.18.0 the feed ring stores role MARKERS not baked SGR, so the post-dispatch feed_repaint RE-EXPANDS
# existing scrollback with the new theme too — the 0.10.0 "existing lines keep baked colors" limitation
# is gone (0.18.1). Residual: diff-row background TINTS are stored verbatim, so they don't recolor — a
# documented follow-up). rainbow (0.38.0) is live over the vendored anuenue hue: a per-grapheme HSV
# cycle rather than a role table, so it needs TRUECOLOR. When it can't draw we still switch (the
# reported theme stays honest) and say WHY it isn't cycling — never a silent no-op that looks broken.
fn cmd_theme(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        emit("theme: "); ui_emit(ROLE_ACCENT, ui_theme_name()); oprintln("");
        oprintln("  /theme dark · /theme light · /theme rainbow   (rainbow: per-grapheme HSV; needs truecolor)");
        return 0;
    }
    var t = ui_theme_from_name(arg);
    if (t < 0) {
        emit("unknown theme '"); emit(arg); oprintln("' — try: dark, light, rainbow");
        return 0;
    }
    ui_set_theme(t);
    emit("theme -> "); ui_emit(ROLE_ACCENT, ui_theme_name()); oprintln("");
    if (t == THEME_RAINBOW) {
        if (ui_rainbow_active() == 0) {
            if (ui_tier() != PT_PLAIN) {
                oprintln("  (not cycling: rainbow needs a truecolor terminal — 1530 hues don't survive a 256/16");
                oprintln("   quantize. Set COLORTERM=truecolor if your terminal supports it; chrome stays readable.)");
            }
        }
    }
    return 0;
}

# cmd_dry: preview the hoosh request body thoth WOULD send for <task>, and SKIP the POST.
# A local introspection command for "what goes to the model?": SIDE-EFFECT-FREE (no session
# history / token / cost / _hoosh_acc mutation — `hoosh_build_dry` only READS history) and
# NETWORK-FREE (no hoosh POST, no daimon fetch — the agentic tools array is annotated, never
# fetched). It is NEVER a hoosh `/preview` endpoint (that would fork the inference spine). The
# message envelope is byte-exact in plain mode; in agentic mode the live turn additionally
# sends a `tools` array (noted, not shown). Composes locally even when the hoosh seam is
# absent (degrade-note, never refuses). REPL/TUI-only (one-shot routes argv to cmd_task).
fn cmd_dry(line) {
    var task = arg_after(line);
    if (task == 0) {
        oprintln("usage: /dry <task>   — preview the hoosh request body, without sending it");
        return 0;
    }
    # @file mentions (0.21.0): expand the SAME way the live turn does, so the preview shows the
    # exact injected context. mention_expand only READS files (no session/token/cost mutation), so
    # /dry stays side-effect-free + network-free.
    task = mention_expand(task);
    var model = hoosh_model_cur();
    var sys = 0;
    if (seam_status(SEAM_AVATARA) == SEAM_NATIVE) { sys = persona_system_prompt(); }
    # project memory (0.12.0): show the second system message /dry would send. Pass query=0 so /dry stays
    # NETWORK-FREE (0.32.2) — it previews the LOCAL .thoth/memory; when the seam is bound the live turn instead
    # injects mneme semantic recall keyed on the task (resolved at send, not in this preview).
    var mem = 0;
    if (seam_cap_state(SEAM_MEMORY) != CAP_ABSENT) { mem = memory_context(0); }
    var stream = config_hoosh_stream();
    var multi = config_hoosh_history();
    var buf = hoosh_dry_buf();
    var len = 0;
    if (multi == 1) { len = hoosh_build_dry(buf, model, sys, mem, task, stream); }
    else { len = hoosh_build_request(buf, model, sys, mem, task, stream); }

    ui_label("-> POST  : "); emit(_hoosh_endpoint_url());
    ui_emit(ROLE_FAINT, "  (dry-run — not sent)"); oprintln("");
    if (config_hoosh_configured() == 0) {
        ui_emit(ROLE_FAINT, "           [hoosh].url not set — the body thoth WOULD send once configured"); oprintln("");
    }
    ui_label("   model : "); ui_emit(ROLE_ACCENT, model); oprintln("");
    ui_label("   flags : ");
    emit("stream="); if (stream == 1) { emit("on"); } else { emit("off"); }
    emit(" · history="); if (multi == 1) { emit("on"); } else { emit("off"); }
    emit(" · agent="); if (agent_enabled() == 1) { emit("on"); } else { emit("off"); }
    emit(" · "); ofmt_int(len); emit(" bytes"); oprintln("");
    # the agentic tools array is part of the live request but not composed here (it can
    # require a daimon fetch) — announce it honestly rather than fake or fetch it.
    if (agent_enabled() == 1) {
        ui_emit(ROLE_FAINT, "           agentic: the live turn also sends a \"tools\" array (see /tools) and may loop"); oprintln("");
    }
    # in the TUI a body over the feed slot cap truncates on screen — note it (the line REPL
    # and piped output show the body whole).
    if ((out_mode() == OUT_RING) && (len > FEED_LINE_CAP)) {
        ui_emit(ROLE_FAINT, "           (body exceeds the feed slot — best viewed in the line REPL or piped)"); oprintln("");
    }
    ui_emit(ROLE_FAINT, "   ── request body ──"); oprintln("");
    emit_n(buf, len); oprintln("");
    return 0;
}

# dispatch: run one input line. Returns 1 to keep looping, 0 to quit. The public entry —
# repl.cyr / tui.cyr / oneshot.cyr call this; it seeds the alias-expansion depth at 0.
fn dispatch(line) { return _dispatch_d(line, 0); }

# _dispatch_d: dispatch at alias-expansion depth `depth`. Identical to the classic dispatch
# for every built-in; the CMD_UNKNOWN_SLASH gap additionally tries [alias] expansion and
# re-dispatches the result one level deeper (bounded by ALIAS_MAX_DEPTH). With no [alias]
# configured, config_alias_lookup is always 0 -> alias_expand is 0 -> the same "unknown
# command" line as before, so the floor stays byte-identical.
fn _dispatch_d(line, depth) {
    var c = classify_input(line);
    if (c == CMD_QUIT) { return 0; }
    if (c == CMD_EMPTY) { return 1; }
    if (c == CMD_HELP) { cmd_help(); return 1; }
    if (c == CMD_SEAMS) { cmd_seams(); return 1; }
    if (c == CMD_STATE) { cmd_state(); return 1; }
    if (c == CMD_PERSONAS) { cmd_personas(line); return 1; }
    if (c == CMD_PERSONA) { cmd_persona(line); return 1; }
    if (c == CMD_ALLOW) { cmd_allow(line); return 1; }
    if (c == CMD_SAVE) { cmd_save(line); return 1; }
    if (c == CMD_RELOAD) { cmd_reload(); return 1; }
    if (c == CMD_ROLE) { cmd_role(line); return 1; }
    if (c == CMD_MODEL) { cmd_model(line); return 1; }
    if (c == CMD_MODELS) { cmd_models(line); return 1; }
    if (c == CMD_READ) { cmd_read(line); return 1; }
    if (c == CMD_WRITE) { cmd_write(line); return 1; }
    if (c == CMD_RUN) { cmd_run(line); return 1; }
    if (c == CMD_TOOLS) { cmd_tools(); return 1; }
    if (c == CMD_CALL) { cmd_call(line); return 1; }
    if (c == CMD_AUDIT) { cmd_audit(); return 1; }
    if (c == CMD_GRANTS) { cmd_grants(line); return 1; }
    if (c == CMD_COMPACT) { cmd_compact(line); return 1; }
    if (c == CMD_CONTEXT) { cmd_context(); return 1; }
    if (c == CMD_REWIND) { cmd_rewind(line); return 1; }
    if (c == CMD_RESET) { cmd_reset(); return 1; }
    if (c == CMD_CLEAR) { cmd_clear(); return 1; }
    if (c == CMD_THEME) { cmd_theme(line); return 1; }
    if (c == CMD_DRY) { cmd_dry(line); return 1; }
    if (c == CMD_REMEMBER) { cmd_remember(line); return 1; }
    if (c == CMD_NOTES) { cmd_notes(line); return 1; }
    if (c == CMD_CONVERSATIONS) { cmd_conversations(line); return 1; }
    if (c == CMD_NEW) { cmd_new(line); return 1; }
    if (c == CMD_SWITCH) { cmd_switch(line); return 1; }
    if (c == CMD_RENAME) { cmd_rename(line); return 1; }
    if (c == CMD_DELETE) { cmd_delete(line); return 1; }
    if (c == CMD_SEARCH) { cmd_search(line); return 1; }
    if (c == CMD_RETRY) { cmd_regenerate(); return 1; }
    if (c == CMD_EDIT) { cmd_edit(line); return 1; }
    if (c == CMD_BOOKMARK) { cmd_bookmark(); return 1; }
    if (c == CMD_THUMBS) { cmd_thumbs(line); return 1; }
    if (c == CMD_GIT) { cmd_git(line); return 1; }
    if (c == CMD_COPY) { cmd_copy(); return 1; }
    if (c == CMD_FIND) { cmd_find(line); return 1; }
    if (c == CMD_REPROBE) { cmd_reprobe(); return 1; }
    if (c == CMD_HISTORY) { cmd_history(); return 1; }
    if (c == CMD_UNKNOWN_SLASH) {
        # Guard FIRST: refuse at the depth bound BEFORE writing a slot, so a cycle can never
        # write past the last per-depth buffer (the deepest write is slot ALIAS_MAX_DEPTH-1).
        if (depth >= ALIAS_MAX_DEPTH) { oprintln("alias: expansion too deep (cycle?)"); return 1; }
        var ex = alias_expand(line, depth);
        if (ex != 0) { return _dispatch_d(ex, depth + 1); }
        oprintln("unknown command (try /help)");
        return 1;
    }
    cmd_task(line);
    return 1;
}
