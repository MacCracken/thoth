# thoth — input classification + command handlers.
#
# classify_input / token_is / arg_after are PURE and unit-tested. The cmd_*
# handlers do I/O. All of this is DRIVER logic: it dispatches to capability
# seams and local substrate built-ins; it never reimplements a spine domain.

enum Cmd {
    CMD_EMPTY = 0;
    CMD_HELP = 1;
    CMD_QUIT = 2;
    CMD_SEAMS = 3;
    CMD_STATE = 4;
    CMD_MODEL = 5;
    CMD_READ = 6;
    CMD_WRITE = 7;
    CMD_RUN = 8;
    CMD_UNKNOWN_SLASH = 9;
    CMD_TASK = 10;
    CMD_TOOLS = 11;
    CMD_CALL = 12;
    CMD_AUDIT = 13;
    CMD_RESET = 14;
    CMD_MODELS = 15;
}

# token_is: 1 if line's first whitespace-delimited token equals word exactly.
fn token_is(line, word) {
    if (cstr_starts_with(line, word) == 0) { return 0; }
    var after = load8(line + strlen(word));
    if (after == 0) { return 1; }
    if (after == 32) { return 1; }
    return 0;
}

# arg_after: pointer to the first non-space char after the first token, or 0.
fn arg_after(line) {
    var i = 0;
    while (load8(line + i) != 0 && load8(line + i) != 32) { i = i + 1; }
    while (load8(line + i) == 32) { i = i + 1; }
    if (load8(line + i) == 0) { return 0; }
    return line + i;
}

# classify_input: map a trimmed input line to a Cmd id. Pure — unit-tested.
fn classify_input(line) {
    if (load8(line) == 0) { return CMD_EMPTY; }
    if (load8(line) != 47) { return CMD_TASK; }   # 47 = '/'
    if (token_is(line, "/help") == 1) { return CMD_HELP; }
    if (token_is(line, "/?") == 1) { return CMD_HELP; }
    if (token_is(line, "/quit") == 1) { return CMD_QUIT; }
    if (token_is(line, "/exit") == 1) { return CMD_QUIT; }
    if (token_is(line, "/seams") == 1) { return CMD_SEAMS; }
    if (token_is(line, "/state") == 1) { return CMD_STATE; }
    if (token_is(line, "/models") == 1) { return CMD_MODELS; }
    if (token_is(line, "/model") == 1) { return CMD_MODEL; }
    if (token_is(line, "/read") == 1) { return CMD_READ; }
    if (token_is(line, "/write") == 1) { return CMD_WRITE; }
    if (token_is(line, "/run") == 1) { return CMD_RUN; }
    if (token_is(line, "/tools") == 1) { return CMD_TOOLS; }
    if (token_is(line, "/call") == 1) { return CMD_CALL; }
    if (token_is(line, "/audit") == 1) { return CMD_AUDIT; }
    if (token_is(line, "/reset") == 1) { return CMD_RESET; }
    return CMD_UNKNOWN_SLASH;
}

# _help_line: one help row — command token in accent, the padded description in
# muted. c + rest reproduces the original line verbatim (byte-identical at T0).
fn _help_line(c, rest) { ui_emit(ROLE_ACCENT, c); ui_emit(ROLE_MUTED, rest); println(""); return 0; }

fn cmd_help() {
    ui_emit(ROLE_ACCENT, "thoth - a model-switching scribe. commands:"); println("");
    _help_line("  /help", "              this help");
    _help_line("  /seams", "             capability ladder (spine seam status)");
    _help_line("  /state", "             session state");
    _help_line("  /model [id]", "        show model, or attempt a mid-session switch (hoosh)");
    _help_line("  /models [provider]", " list providers; with one, its switchable models");
    _help_line("  /read <file>", "       print a file (safe, read-only built-in)");
    _help_line("  /write <f> <text>", "  write text to a file (t-ron-gated)");
    _help_line("  /run <cmd>", "         run a shell command (t-ron-gated local escape)");
    _help_line("  /tools", "             list the MCP tools daimon hosts");
    _help_line("  /call <tool> [json]", "  invoke an MCP tool via daimon (t-ron-gated)");
    _help_line("  /audit", "             show t-ron's audit chain (gated-action log)");
    _help_line("  /reset", "             clear the conversation context (start fresh)");
    _help_line("  /quit", "              exit (or Ctrl-D)");
    _help_line("  <anything else>", "    a coding task -> routed to the model (hoosh)");
    return 0;
}

# (confirm — the fail-closed interactive prompt — lives in src/gate.cyr now,
# alongside the t-ron seam binding it stands in for.)

# _params_one: build {"<key>":"<escaped val>"} in a reused static buffer — the
# t-ron ToolCall params for the built-in actions. Bounded: val is capped by
# the 4096-byte input line; worst-case escaping (~6x) fits the cap.
var _gate_params = 0;
var GATE_PARAMS_CAP = 32768;

fn _params_one(key, val) {
    if (_gate_params == 0) { _gate_params = alloc(GATE_PARAMS_CAP); }
    var off = 0;
    off = _append_cstr(_gate_params, off, "{\"");
    off = _append_cstr(_gate_params, off, key);
    off = _append_cstr(_gate_params, off, "\":\"");
    off = _json_escape_into(_gate_params, off, val);
    off = _append_cstr(_gate_params, off, "\"}");
    store8(_gate_params + off, 0);
    return _gate_params;
}

fn cmd_state() {
    ui_emit(ROLE_ACCENT, "session:"); println("");
    ui_label("  turns   : "); fmt_int(session_turns()); println("");
    ui_label("  model   : ");
    var m = session_model();
    if (m == 0) { m = config_hoosh_model(); }
    if (m == 0) { ui_emit(ROLE_FAINT, "(none set)"); println(""); }
    else { ui_emit(ROLE_ACCENT, m); println(""); }
    ui_label("  hoosh   : ");
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) { ui_emit(ROLE_FAINT, "absent (set [hoosh].url in thoth.cyml)"); println(""); }
    else {
        emit(config_hoosh_url());
        if (config_hoosh_stream() == 1) { ui_emit(ROLE_MUTED, " (streaming)"); println(""); }
        else { ui_emit(ROLE_MUTED, " (blocking)"); println(""); }
    }
    ui_label("  context : ");
    if (config_hoosh_history() == 0) { ui_emit(ROLE_MUTED, "stateless (single-turn; [hoosh].history = false)"); println(""); }
    else { emit("multi-turn, "); fmt_int(session_history_len()); ui_emit(ROLE_MUTED, " messages (/reset clears)"); println(""); }
    ui_label("  log     : ");
    if (log_active() == 0) { ui_emit(ROLE_FAINT, "off (set [log].file or [log].level in thoth.cyml)"); println(""); }
    else {
        if (config_log_file() != 0) { emit(config_log_file()); } else { emit("stderr"); }
        ui_emit(ROLE_MUTED, " (structured driver events)"); println("");
    }
    ui_label("  agent   : ");
    if (agent_enabled() == 1) {
        emit("agentic tool-calling on (daimon tools, t-ron gated, ");
        if (config_hoosh_parallel() == 1) { ui_emit(ROLE_GREEN, "parallel"); } else { emit("serial"); }
        println(" calls)");
    }
    elif (seam_status(SEAM_DAIMON) == SEAM_ABSENT) { ui_emit(ROLE_MUTED, "plain turns (no daimon seam; /tools needs [daimon].url)"); println(""); }
    else { ui_emit(ROLE_MUTED, "plain turns ([hoosh].tools = false)"); println(""); }
    ui_label("  daimon  : ");
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) { ui_emit(ROLE_FAINT, "absent (set [daimon].url in thoth.cyml)"); println(""); }
    else { println(config_daimon_url()); }
    ui_label("  t-ron   : ");
    if (gate_active() == 0) { ui_emit(ROLE_FAINT, "absent (fail-closed confirm gate; set [tron].policy in thoth.cyml)"); println(""); }
    else { println(config_tron_policy()); }
    ui_label("  spine   : ");
    if (seam_any_wired() == 0) { ui_emit(ROLE_FAINT, "all seams absent (fermenting)"); println(""); }
    else { ui_emit(ROLE_MUTED, "see /seams"); println(""); }
    ui_label("  surface : ");
    ui_emit(ROLE_GREEN, ui_tier_name());
    if (ui_tier() != PT_PLAIN) { emit(" ("); ui_emit(ROLE_MUTED, ui_color_depth_name()); emit(")"); }
    println("");
    ui_label("  build   : "); ui_emit(ROLE_ACCENT, "thoth 0.8.4"); println("");
    return 0;
}

fn cmd_model(line) {
    var arg = arg_after(line);
    if (arg == 0) {
        emit("model: ");
        var m = session_model();
        if (m == 0) { m = config_hoosh_model(); }
        if (m == 0) { println("(none set - hoosh routes by its own provider config)"); }
        else { println(m); }
        if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
            println("hoosh seam absent - set [hoosh].url in thoth.cyml to enable switching.");
        }
        return 0;
    }
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        emit("cannot switch to '"); emit(arg); println("': hoosh seam is absent.");
        println("set [hoosh].url in thoth.cyml; mid-session switching routes through hoosh. see /seams.");
        return 0;
    }
    session_set_model_copy(arg);
    emit("model -> "); println(arg);
    emit("  next turn routes to hoosh as '"); emit(arg); println("' (mid-session switch).");
    log_begin("model_switch"); log_kv_str("model", arg); log_commit(SK_INFO);
    return 0;
}

# cmd_models: list the models the hoosh gateway advertises (GET /v1/models). The
# catalog is hoosh's domain (multi-provider routing) — thoth only asks and shows
# what to pick from, marking the active routing target. The hoosh seam must be
# bound; absent, it degrades honestly (no endpoint, no catalog claim).
fn cmd_models(line) {
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        println("hoosh seam absent - no model gateway is wired.");
        println("the model catalog is hoosh's domain (multi-provider routing).");
        println("set [hoosh].url in thoth.cyml. degraded honestly, never faked.");
        return 0;
    }
    # Bare /models lists the providers hoosh routes to; /models <provider> drills
    # into that provider's concrete, switchable models (hoosh's per-provider catalog).
    var prov = arg_after(line);
    if (prov == 0) { return hoosh_list_models(); }
    return hoosh_list_provider_models(prov);
}

# /read uses one reused heap buffer (the bump allocator never frees, so a
# fresh alloc per call would accrete over a long session). Files larger than
# the cap are truncated to it.
var _read_buf = 0;
var READ_BUF_CAP = 1048576;     # 1 MB

# _tok_role: map a vyakarana token kind to a semantic color role, or -1 to leave
# uncolored (idents / punctuation / whitespace / error -> terminal default).
fn _tok_role(kind) {
    if (kind == TK_KEYWORD) { return ROLE_ACCENT; }
    if (kind == TK_STRING) { return ROLE_GREEN; }
    if (kind == TK_NUMBER) { return ROLE_BLUE; }
    if (kind == TK_COMMENT) { return ROLE_FAINT; }
    if (kind == TK_PREPROCESSOR) { return ROLE_BLUE; }
    if (kind == TK_OPERATOR) { return ROLE_MUTED; }
    return 0 - 1;
}

# _read_highlight: syntax-color buf[0..n) for `path` via vyakarana, emitting tokens
# in their role colors. Returns 1 if it rendered (highlighted), 0 if it declined
# (plain tier / unknown language) so the caller emits the file plain. CRITICAL: it
# tracks the cursor and emits any uncovered gap + trailing bytes plain, so the FULL
# file is always shown verbatim — highlighting never drops or reorders content.
fn _read_highlight(path, buf, n) {
    if (ui_tier() == PT_PLAIN) { return 0; }
    var lang = detect_language(path);
    if (lang == 0) { return 0; }
    var s = tokenize_stream_new(lang);
    if (s == 0) { return 0; }
    tokenize_stream_feed(s, buf, n);
    var tb = tokenbuf_new();
    tokenize_stream_drain(s, tb);
    tokenize_stream_finish(s, tb);
    var count = tokenbuf_count(tb);
    var pos = 0;
    var i = 0;
    while (i < count) {
        var start = tokenbuf_start(tb, i);
        var len = tokenbuf_len(tb, i);
        if (start > pos) { emit_n(buf + pos, start - pos); }   # gap -> verbatim
        if ((start + len) <= n) {
            var role = _tok_role(tokenbuf_kind(tb, i));
            if (role < 0) { emit_n(buf + start, len); }
            else { ui_emit_n(role, buf + start, len); }
            pos = start + len;
        }
        i = i + 1;
    }
    if (pos < n) { emit_n(buf + pos, n - pos); }                # trailing -> verbatim
    tokenize_stream_free(s);
    return 1;
}

fn cmd_read(line) {
    var path = arg_after(line);
    if (path == 0) { println("usage: /read <file>"); return 0; }
    if (file_exists(path) == 0) { emit("no such file: "); println(path); return 0; }
    if (_read_buf == 0) { _read_buf = alloc(READ_BUF_CAP); }
    var n = file_read_all(path, _read_buf, READ_BUF_CAP - 1);
    if (n < 0) { emit("read failed: "); println(path); return 0; }
    store8(_read_buf + n, 0);
    ui_emit(ROLE_FAINT, "--- "); ui_emit(ROLE_BLUE, path); ui_emit(ROLE_FAINT, " (");
    emit(ui_sgr(ROLE_FAINT)); fmt_int(n); emit(ui_reset());
    ui_emit(ROLE_FAINT, " bytes) ---"); println("");
    if (_read_highlight(path, _read_buf, n) == 0) { emit_n(_read_buf, n); }
    if (n > 0) { if (load8(_read_buf + n - 1) != 10) { println(""); } }
    ui_emit(ROLE_FAINT, "--- end ---"); println("");
    return 0;
}

# /write reuses two static buffers (the path copy + the content+newline
# output) so repeated writes don't accrete in the never-freeing bump heap —
# matching the /read and /run convention. Both are bounded by the 4096-byte
# input line. A trailing newline is appended to the content.
var _write_path = 0;
var _write_out = 0;
var _write_old = 0;
var WRITE_BUF_CAP = 4096;
var WRITE_OLD_CAP = 65536;   # old-file snapshot for the diff (capped; larger -> summarized)

fn cmd_write(line) {
    var rest = arg_after(line);
    if (rest == 0) { println("usage: /write <path> <content>"); return 0; }
    if (_write_path == 0) { _write_path = alloc(WRITE_BUF_CAP); }
    if (_write_out == 0) { _write_out = alloc(WRITE_BUF_CAP); }
    var i = 0;
    while (load8(rest + i) != 0 && load8(rest + i) != 32) {
        if (i < (WRITE_BUF_CAP - 1)) { store8(_write_path + i, load8(rest + i)); }
        i = i + 1;
    }
    var plen = i;
    if (plen > (WRITE_BUF_CAP - 1)) { plen = WRITE_BUF_CAP - 1; }
    store8(_write_path + plen, 0);
    var content = 0;
    var j = i;
    while (load8(rest + j) == 32) { j = j + 1; }
    if (load8(rest + j) != 0) { content = rest + j; }
    if (content == 0) { println("usage: /write <path> <content>"); return 0; }
    ui_emit(ROLE_FAINT, "propose write -> "); ui_emit(ROLE_BLUE, _write_path); println("");
    var wparams = _params_one("path", _write_path);
    if (gate_authorize("thoth_write", wparams, "write to", _write_path) == 0) {
        ui_emit(ROLE_RED, "  denied. nothing written."); println("");
        return 0;
    }
    var clen = strlen(content);
    if (clen > (WRITE_BUF_CAP - 2)) { clen = WRITE_BUF_CAP - 2; }
    memcpy(_write_out, content, clen);
    store8(_write_out + clen, 10);
    store8(_write_out + clen + 1, 0);
    # colored diff of the proposed change: old on disk (if any) -> the new content.
    if (_write_old == 0) { _write_old = alloc(WRITE_OLD_CAP); }
    var oldlen = 0;
    var old_toobig = 0;
    if (file_exists(_write_path) == 1) {
        var rn = file_read_all(_write_path, _write_old, WRITE_OLD_CAP - 1);
        if (rn >= (WRITE_OLD_CAP - 1)) { old_toobig = 1; }   # truncated read -> don't diff a lie
        elif (rn > 0) { oldlen = rn; }
    }
    if (old_toobig == 1) {
        emit("  "); ui_emit(ROLE_FAINT, "(old file > 64KB — diff skipped)"); println("");
    } else {
        diff_render(_write_path, _write_old, oldlen, _write_out, clen + 1);
    }
    var rc = file_write_all(_write_path, _write_out, clen + 1);
    if (rc < 0) { emit("write failed: "); println(_write_path); return 0; }
    emit("wrote "); fmt_int(clen + 1); emit(" bytes (+newline) -> "); println(_write_path);
    return 0;
}

fn cmd_run(line) {
    var cmdline = arg_after(line);
    if (cmdline == 0) { println("usage: /run <shell command>"); return 0; }
    println("this /run is a local built-in shell escape (substrate), not the MCP tool spine.");
    emit("  proposed: "); println(cmdline);
    var rparams = _params_one("cmd", cmdline);
    if (gate_authorize("thoth_run", rparams, "run", cmdline) == 0) {
        println("  denied. nothing ran.");
        return 0;
    }
    var rc = run_shell(cmdline);
    if (rc == (0 - 1)) { println("  (failed to spawn /bin/sh)"); return 0; }
    emit("  exit "); fmt_int(rc); println("");
    return 0;
}

# cmd_tools: list the MCP tools daimon hosts. The daimon seam must be bound.
fn cmd_tools() {
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) {
        println("daimon seam absent - no MCP tool host is wired.");
        println("tool listing/execution is daimon's domain (the MCP host registry).");
        println("set [daimon].url in thoth.cyml. degraded honestly, never faked.");
        return 0;
    }
    return daimon_list_tools();
}

# cmd_call: invoke one MCP tool by name through daimon, t-ron-gated. Usage:
# /call <tool> [json-arguments]. The args default to {}.
var _call_name = 0;
var CALL_NAME_CAP = 256;

fn cmd_call(line) {
    var rest = arg_after(line);
    if (rest == 0) { println("usage: /call <tool> [json-arguments]"); return 0; }
    if (seam_status(SEAM_DAIMON) == SEAM_ABSENT) {
        println("daimon seam absent - no MCP tool host is wired.");
        println("set [daimon].url in thoth.cyml. degraded honestly, never faked.");
        return 0;
    }
    if (_call_name == 0) { _call_name = alloc(CALL_NAME_CAP); }
    var i = 0;
    while (load8(rest + i) != 0 && load8(rest + i) != 32) {
        if (i < (CALL_NAME_CAP - 1)) { store8(_call_name + i, load8(rest + i)); }
        i = i + 1;
    }
    var nlen = i;
    if (nlen > (CALL_NAME_CAP - 1)) { nlen = CALL_NAME_CAP - 1; }
    store8(_call_name + nlen, 0);
    var args = 0;
    while (load8(rest + i) == 32) { i = i + 1; }
    if (load8(rest + i) != 0) { args = rest + i; }
    var gp = args;
    if (gp == 0) { gp = "{}"; }
    if (gate_authorize(_call_name, gp, "call tool", _call_name) == 0) {
        println("  denied. no request sent.");
        return 0;
    }
    return daimon_call(_call_name, args);
}

# cmd_reset: clear the multi-turn conversation context — the next turn starts a
# fresh exchange (the model id and turn counter are kept). Honest no-op message
# when there was nothing to clear.
fn cmd_reset() {
    var n = session_history_len();
    session_history_clear();
    roundlog_reset();
    if (n == 0) { println("conversation already empty — nothing to clear."); }
    else { emit("conversation cleared ("); fmt_int(n); println(" messages dropped). fresh context."); }
    return 0;
}

# cmd_audit: surface t-ron's audit chain. With the seam absent there is no
# chain — the fail-closed confirm gate keeps no cryptographic log; said plainly,
# degraded honestly. With it bound, gate.cyr renders t-ron's query API.
fn cmd_audit() {
    if (gate_active() == 0) {
        println("t-ron seam absent - no audit chain.");
        println("the fail-closed confirm gate keeps no cryptographic log; the libro");
        println("audit chain is t-ron's domain. set [tron].policy in thoth.cyml.");
        roundlog_report();
        return 0;
    }
    gate_audit_report();
    roundlog_report();
    return 0;
}

fn cmd_task(line) {
    session_bump_turn();
    emit("task: "); println(line);
    if (seam_status(SEAM_HOOSH) == SEAM_ABSENT) {
        println("  hoosh seam absent - no model backend is wired.");
        println("  reasoning/codegen routes through hoosh (native on AGNOS, a client");
        println("  elsewhere). set [hoosh].url in thoth.cyml. degraded honestly, never faked.");
        return 0;
    }
    # When daimon is wired and tools are on, drive the agentic tool-calling loop
    # (the model can call MCP tools, gated by t-ron); else a plain hoosh turn.
    if (agent_enabled() == 1) { return agent_turn(line); }
    return hoosh_send(line);
}

# dispatch: run one input line. Returns 1 to keep looping, 0 to quit.
fn dispatch(line) {
    var c = classify_input(line);
    if (c == CMD_QUIT) { return 0; }
    if (c == CMD_EMPTY) { return 1; }
    if (c == CMD_HELP) { cmd_help(); return 1; }
    if (c == CMD_SEAMS) { cmd_seams(); return 1; }
    if (c == CMD_STATE) { cmd_state(); return 1; }
    if (c == CMD_MODEL) { cmd_model(line); return 1; }
    if (c == CMD_MODELS) { cmd_models(line); return 1; }
    if (c == CMD_READ) { cmd_read(line); return 1; }
    if (c == CMD_WRITE) { cmd_write(line); return 1; }
    if (c == CMD_RUN) { cmd_run(line); return 1; }
    if (c == CMD_TOOLS) { cmd_tools(); return 1; }
    if (c == CMD_CALL) { cmd_call(line); return 1; }
    if (c == CMD_AUDIT) { cmd_audit(); return 1; }
    if (c == CMD_RESET) { cmd_reset(); return 1; }
    if (c == CMD_UNKNOWN_SLASH) { println("unknown command (try /help)"); return 1; }
    cmd_task(line);
    return 1;
}
