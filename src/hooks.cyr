# thoth — lifecycle hooks (0.41.0, T2-4): user-configured commands fired at agent events, able to BLOCK.
#
# WHY. This is the most-copied extensibility primitive in the field (Claude Code ships ~30 events; Codex
# shipped a near-identical set), and it is the one that fits thoth's posture best rather than fighting it:
# a `pre_tool` hook that can deny is a **deterministic, code-enforced refusal that a prompt cannot argue
# with**. Everything else thoth has in this area is either a policy file (t-ron) or a heuristic (the shell
# globs, the injection guard). A hook is neither — it is the operator's own program, and its exit status
# is the whole contract.
#
# It is also the honest home for rules thoth's maintainer will never anticipate: "run the linter after
# every edit", "refuse any tool call while the release branch is checked out", "log every shell command to
# our own audit sink". Without it each of those is a feature request; with it they are four lines of shell.
#
# THE EVENTS, and why only these four. Peers ship dozens; thoth ships the four that correspond to real
# decision points it already has, because an event that fires where nothing can act on it is dead weight:
#   session_start   once, before the first turn        — inject context, warm a cache, announce a policy
#   pre_tool        before EVERY gated tool executes   — CAN BLOCK (the load-bearing one)
#   post_tool       after a tool has run               — react: lint, log, notify
#   session_end     once, at exit                      — flush, clean up, report
#
# THE CONTRACT. A hook is a shell command. thoth runs it with the event's facts in the ENVIRONMENT (never
# on the command line — a tool name or a shell command is attacker-influenced text, and splicing it into a
# command string would be exactly the injection this file exists to help prevent). It is bounded by a
# wall-clock timeout and its stdout/stderr is captured and shown.
#
# 0.45.6: "in the environment" is literal now. The facts are handed to the child as its environment BLOCK
# (`exec_shell_capture_env`: `THOTH_EVENT=…`, `THOTH_TOOL=…`, `THOTH_ARGS=…` as `KEY=value` strings, byte for
# byte, no shell quoting in the path) and the operator's command runs UNMODIFIED as `/bin/sh -c <cmd>`.
# Through 0.45.5 the facts were composed as an `export K='v'; ` prefix onto that command string — which put
# them in the child's ARGV, world-readable through `/proc/<pid>/cmdline` for the hook's life (up to ~16 KB of
# the model's tool arguments), and forced a lossy quoting (`'` became `"`, a newline a space). A process's
# environment is owner-readable (`/proc/<pid>/environ` is mode 0400), and the values arrive exact.
# (The old note about `K='v' cmd` vs `export K='v'; cmd` no longer applies: an environment block IS the
# exported environment, and a hook reading `$THOTH_TOOL` sees it — the test that reads the variable back
# still guards this.)
#
#   exit 0        -> proceed
#   exit non-zero -> for `pre_tool`, BLOCK the call; for the others, the failure is reported and thoth
#                    continues (a broken post_tool hook must not wedge a session)
#
# ⚠ SECURITY POSTURE, stated plainly because a hook system is an execution surface.
#  * Hooks come from the OPERATOR'S CONFIG and nowhere else. The model cannot register, read, alter or
#    invoke one — `.thoth/config.cyml` is inside `_project_sensitive`, so it is not even readable by the
#    model's own tools (0.39.0, A-3).
#  * Event facts go through the ENVIRONMENT rather than being substituted INTO the operator's command
#    text. That is the difference between a hook system and a remote-code-execution primitive, and it
#    holds by construction since 0.45.6: the command string thoth hands `/bin/sh -c` is the operator's
#    own bytes, untouched; the facts travel in the environment block, where no byte of a value can become
#    a command. (0.44.3 had found the previous form — an `export K='v'; ` prefix — put them in the child's
#    argv, world-readable through `/proc/<pid>/cmdline`; and 0.45.6 found the "needs a portable
#    spawn-with-environment primitive" excuse stale: the POSIX capture already passed `sys_execve` an
#    empty envp, and the AGNOS floor has `sys_spawn_path_env`.) Where the capture cannot carry a block —
#    the PE lane inherits thoth's environment and has no channel for a built one — the hook is reported
#    as "could NOT be run" and a `pre_tool` denies: never a hook that ran blind and passed.
#  * A hook runs UNSANDBOXED, as the user, exactly like `/run`, the `shell` tool and `[verify].command`.
#    That is not a new risk class, but it IS a new instance of one, and when the OS-sandbox seam lands
#    this is one of the paths that should move behind it.
#  * `pre_tool` can only ever DENY. It cannot approve something t-ron denied — it runs after the gate, so
#    the strictest verdict wins and a hook cannot be used to widen authority.

var HOOK_OUT_CAP = 4096;        # hook output shown/captured; a hook that talks more than this is misusing the seam
# HOOK_TIMEOUT_* live in src/config.cyr, beside the getter that clamps with them — config.cyr is included by
# test drivers that do NOT include this file, so a constant the config reads must be declared where the
# config is. (HOOK_CMD_CAP went with the composed command at 0.45.6.)

var _hook_buf = 0;
var HOOK_ENV_CAP = 20480;       # 0.45.6: the `KEY=value` strings' scratch — holds THOTH_ARGS at AGENT_ARGS_MAX (16383) whole
var _hook_env = 0;              # alloc(HOOK_ENV_CAP): the strings, each NUL-terminated
var _hook_envp[48];             # N BYTES: up to 5 cstr pointers + the NUL terminator (40 B), headroom to 48
var _hook_fired = 0;            # hooks run this session (for /state)
var _hook_blocked = 0;          # pre_tool denials this session
var _hook_last_clamped = 0;     # the last _hook_env_put could not fit its value in full (THOTH_ARGS past the scratch)

fn hooks_fired() { return _hook_fired; }
fn hooks_blocked() { return _hook_blocked; }
fn hooks_reset() { _hook_fired = 0; _hook_blocked = 0; return 0; }

# _hook_env_put (0.45.6): write `KEY=value` NUL-terminated at dst+off, byte for byte — no quoting, this is an
# environment string, not shell text; a NUL cannot occur in a cstr value and nothing else needs escaping.
# Returns the offset past the NUL. A value that would not fit `cap` (with its NUL) is clamped whole-bytes and
# _hook_last_clamped is raised, so the caller can export THOTH_ARGS_TRUNCATED=1 and announce it — a hook must
# never decide on silently shortened arguments and believe they were complete. Only THOTH_ARGS can ever be
# that large (AGENT_ARGS_MAX, which HOOK_ENV_CAP holds); the guard is for a caller past the executor's cap.
fn _hook_env_put(dst, off, cap, key, value) {
    _hook_last_clamped = 0;
    off = _append_cstr_cap(dst, off, cap, key);
    off = _append_cstr_cap(dst, off, cap, "=");
    if (value != 0) {
        var lim = cap - 1;                                 # room for the NUL
        var i = 0;
        while ((load8(value + i) != 0) && (off < lim)) {
            store8(dst + off, load8(value + i));
            off = off + 1;
            i = i + 1;
        }
        if (load8(value + i) != 0) { _hook_last_clamped = 1; }
    }
    if (off > (cap - 1)) { off = cap - 1; }
    store8(dst + off, 0);
    return off + 1;
}

# _hook_run: run `cmd` with THOTH_EVENT/THOTH_TOOL/THOTH_ARGS in its ENVIRONMENT. Returns the exit code, -2 when it
# timed out, -4 when the operator stopped it (0.52.0: Esc, or the window closing — see exec.cyr's wait poll), or -1
# when the hook could not be run at all — announced here, on every surface, and not counted as fired.
# ⚠ 0.45.2: -1 used to be silent, counted as fired, and read by hooks_pre_tool as "did not block". It is never
# a hook's own verdict (an exit code is 0..255, a signal 128+sig): it is thoth failing to create the capture file, to
# fork or to wait — or, since 0.45.6, a target whose capture cannot carry an environment block (the PE lane).
fn _hook_run(cmd, event, tool, args) {
    if (_hook_buf == 0) { _hook_buf = alloc(HOOK_OUT_CAP + 1); }
    if (_hook_env == 0) { _hook_env = alloc(HOOK_ENV_CAP); }
    if ((_hook_buf == 0) || (_hook_env == 0)) { return 0 - 1; }
    # the environment block: KEY=value strings back to back in the scratch, their pointers in _hook_envp
    var off = 0;
    var nenv = 0;
    store64(&_hook_envp + nenv * 8, _hook_env + off); nenv = nenv + 1;
    off = _hook_env_put(_hook_env, off, HOOK_ENV_CAP, "THOTH_EVENT", event);
    store64(&_hook_envp + nenv * 8, _hook_env + off); nenv = nenv + 1;
    off = _hook_env_put(_hook_env, off, HOOK_ENV_CAP, "THOTH_TOOL", tool);
    store64(&_hook_envp + nenv * 8, _hook_env + off); nenv = nenv + 1;
    off = _hook_env_put(_hook_env, off, HOOK_ENV_CAP - 32, "THOTH_ARGS", args);   # keep room for the flag below
    if (_hook_last_clamped == 1) {
        store64(&_hook_envp + nenv * 8, _hook_env + off); nenv = nenv + 1;
        off = _hook_env_put(_hook_env, off, HOOK_ENV_CAP, "THOTH_ARGS_TRUNCATED", "1");
        ui_emit(ROLE_RED, "  [hook "); emit(event);
        ui_emit(ROLE_RED, "] THOTH_ARGS was too large to pass in full");
        ui_emit(ROLE_FAINT, " — THOTH_ARGS_TRUNCATED=1 is exported"); oprintln("");
    }
    store64(&_hook_envp + nenv * 8, 0);

    var st[16];
    store64(&st, 0 - 1); store64(&st + 8, 0);
    var n = exec_shell_capture_env(cmd, _hook_buf, HOOK_OUT_CAP, config_hook_timeout_ms(), &st, &_hook_envp);   # the operator's command, untouched
    if (n < 0) { n = 0; }
    store8(_hook_buf + n, 0);
    var code = load64(&st);
    if ((code == (0 - 1)) && (load64(&st + 8) == 0)) {
        note_emit("  [hook "); note_emit(event);
        note_println("] could NOT be run — creating its capture file, forking or waiting failed; it gave no verdict");
        log_begin("hook"); log_kv_str("event", event); log_kv_str("result", "could_not_run"); log_commit(SK_WARN);
        return 0 - 1;
    }
    _hook_fired = _hook_fired + 1;
    if (load64(&st + 8) == 1) {
        ui_emit(ROLE_RED, "  [hook "); emit(event); ui_emit(ROLE_RED, "] timed out"); oprintln("");
        # ⚠ 0.43.2: a TIMEOUT is its own outcome (-2), distinct from "could not spawn" (-1). They used to
        # share -1 and therefore shared a verdict, which made "the security control did not finish"
        # identical to "the security control approved". hooks_pre_tool now denies on -2.
        return 0 - 2;
    }
    # 0.52.0 (F7): the operator STOPPED it — the group killed as a deadline kills it, no verdict given. Its own outcome,
    # not a timeout: the hook did not overrun anything, the operator acted. Like a timeout, its partial output is not
    # shown (a half-printed report is not the hook's report); hooks_pre_tool denies on it.
    if (code == (0 - 4)) {
        ui_emit(ROLE_MUTED, "  [hook "); emit(event); ui_emit(ROLE_MUTED, "] interrupted"); ui_emit(ROLE_FAINT, " — stopped before it finished"); oprintln("");
        return 0 - 4;
    }
    if (n > 0) {
        ui_emit(ROLE_FAINT, "  [hook "); emit(event); ui_emit(ROLE_FAINT, "] ");
        # hook output is a program's stdout — same C0 policy as every other untrusted-bytes-to-terminal path
        var i = 0;
        while (i < n) {
            var b = load8(_hook_buf + i) & 255;
            if ((b < 32) && (b != 10)) { b = 63; }
            if (b == 127) { b = 63; }
            store8(_hook_buf + i, b);
            i = i + 1;
        }
        emit(_hook_buf);
        oprintln("");
    }
    return code;
}

# hooks_session_start / hooks_session_end: fire-and-report. A non-zero exit is announced but never fatal —
# a session must not be unstartable because a notification script is broken.
fn hooks_session_start() {
    var c = config_hook_session_start();
    if (c == 0) { return 0; }
    if (load8(c) == 0) { return 0; }
    if (shell_supported() == 0) { return 0; }
    var rc = _hook_run(c, "session_start", "", "");
    if (rc > 0) { ui_emit(ROLE_FAINT, "  [hook session_start] exited "); ofmt_int(rc); ui_emit(ROLE_FAINT, " (continuing)"); oprintln(""); }
    return 0;
}

# 0.50.1: returns _hook_run's outcome (the exit code, -2 timed out, -1 could not run) — main.cyr ignores it; the
# window fires this after its surface is gone and names the one outcome that would otherwise be silent there.
fn hooks_session_end() {
    var c = config_hook_session_end();
    if (c == 0) { return 0; }
    if (load8(c) == 0) { return 0; }
    if (shell_supported() == 0) { return 0; }
    return _hook_run(c, "session_end", "", "");
}

# hooks_pre_tool: 1 = proceed, 0 = BLOCKED by the hook. THE load-bearing event.
#
# Returns 1 (proceed) when no hook is configured and when the target cannot run one (announced — see below). A
# hook denies by EXITING NON-ZERO, which is a decision it actually made.
#
# ⚠ 0.43.2 — A TIMEOUT IS A DENY. A hook that STARTED and ran out of time is a security control that was consulted
# and did not answer — and thoth's house rule is that security degrades CLOSED.
# ⚠ 0.52.0 — SO IS A HOOK THE OPERATOR STOPPED (Esc mid-hook, or the window closing). It gave no verdict; the turn it
# belonged to is stopping anyway, and "stopped" must never read as "approved".
# ⚠ 0.45.2 — SO IS A HOOK THAT COULD NOT BE RUN. This used to return 1 there, reasoning that a hook which fails to
# spawn must not become a mysterious deny-everything. But a broken SCRIPT exits non-zero (127 included) and already
# denies; -1 is thoth failing to create the capture file, fork or wait — which made the operator's deny an allow on
# every macOS call and, on Linux, for any local user able to pre-plant the capture file names. Nothing about it is
# mysterious now: _hook_run names the cause and the BLOCKED line names the tool.
# ⚠ 0.44.2 — A CONFIGURED pre_tool HOOK ON A TARGET WITH NO SHELL WAS INERT AND SILENT. On AGNOS —
# thoth's canonical target — exec.cyr defines `shell_supported() { return 0; }`, so this returned PROCEED
# with no message, no log line and no counter bump, while /state kept printing `pre_tool(blocking)` in
# accent. A security control reported present while its seam is absent is the exact shape the house rules
# forbid. It is NOT turned into a blanket deny: denying every tool call would make thoth unusable on the
# target it is built for, and the rule that matters here is "never SILENTLY allow". So it is announced —
# once per session, on every surface — and /state now names it as unavailable rather than blocking.
var _hooks_shell_gap = 0;      # 1 once a configured hook was found unrunnable on this target
var _hooks_gap_told = 0;
fn hooks_shell_gap() { return _hooks_shell_gap; }
fn _hooks_note_gap(which) {
    _hooks_shell_gap = 1;
    if (_hooks_gap_told == 1) { return 0; }
    _hooks_gap_told = 1;
    note_emit("  [hooks] "); note_emit(which);
    note_println(" is configured but this target has no shell to run it — the hook is NOT running");
    log_begin("hook"); log_kv_str("event", which); log_kv_str("result", "unavailable_no_shell"); log_commit(SK_WARN);
    return 0;
}

fn hooks_pre_tool(tool, args) {
    var c = config_hook_pre_tool();
    if (c == 0) { return 1; }
    if (load8(c) == 0) { return 1; }
    if (shell_supported() == 0) { _hooks_note_gap("pre_tool"); return 1; }
    var rc = _hook_run(c, "pre_tool", tool, args);
    if (rc < 0) {                                           # -2 timed out / -4 stopped / -1 could not run: no answer -> DENY
        _hook_blocked = _hook_blocked + 1;
        ui_emit(ROLE_RED, "  [hook pre_tool] BLOCKED "); note_emit_label(tool);
        if (rc == (0 - 2)) { note_println(" (the hook timed out — degrading closed)"); }
        elif (rc == (0 - 4)) { note_println(" (the hook was interrupted before it answered — degrading closed)"); }   # 0.52.0 (F7)
        else { note_println(" (the hook could not be run — degrading closed)"); }
        log_begin("hook"); log_kv_str("event", "pre_tool"); log_kv_str("tool", tool); log_kv_int("blocked", 1);
        if (rc == (0 - 2)) { log_kv_str("reason", "timeout"); }
        elif (rc == (0 - 4)) { log_kv_str("reason", "interrupted"); }
        else { log_kv_str("reason", "could_not_run"); }
        log_commit(SK_WARN);
        return 0;
    }
    if (rc == 0) { return 1; }                              # the hook allowed it
    _hook_blocked = _hook_blocked + 1;
    # 0.45.2: the tool name is the model's (S6) — drawn through the label policy on every surface
    ui_emit(ROLE_RED, "  [hook pre_tool] BLOCKED "); note_emit_label(tool);
    ui_emit(ROLE_FAINT, " (exit "); ofmt_int(rc); note_println(")");
    log_begin("hook"); log_kv_str("event", "pre_tool"); log_kv_str("tool", tool);
    log_kv_int("blocked", 1); log_commit(SK_WARN);
    return 0;
}

# hooks_post_tool: fire-and-report after a tool has run. Cannot block — the work is already done, and a
# hook that pretended otherwise would be lying about what it can undo.
fn hooks_post_tool(tool, args) {
    var c = config_hook_post_tool();
    if (c == 0) { return 0; }
    if (load8(c) == 0) { return 0; }
    if (shell_supported() == 0) { return 0; }
    _hook_run(c, "post_tool", tool, args);
    return 0;
}
