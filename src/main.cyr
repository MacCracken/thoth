# thoth — main entry point. Sovereign agentic coding TUI / driver.
#
# thoth is a DRIVER: it owns no domain logic of its own and reaches the AGNOS
# spine (hoosh/daimon/bote/t-ron/avatara) through capability seams. hoosh and
# daimon are remote-client over HTTP (sandhi); bote and t-ron are native via
# vendored dist bundles; avatara is still absent and degrades honestly.
# config_load() + gate_init() run before the loop. See docs/adr/0001, 0002,
# 0003, 0005, 0006.
#
# Stdlib auto-resolves from cyrius.cyml; project modules are included here once,
# in dependency order. The test suite includes the same modules WITHOUT main.
#
# src/vendor/ holds committed dist bundles for the in-process spine seams,
# NOT [deps.X] blocks: bote's and t-ron's manifests both declare git sub-deps
# (libro/majra, libro/bote) that `cyrius deps` would resolve transitively into
# colliding compile sets. The bundles are consumed directly; re-sync with
# scripts/sync-{bote,tron,libro,avatara}.sh <tag>. Order: bote-core (MCP
# protocol), libro (audit chain — t-ron's audit log), then t-ron (calls into
# both); avatara (the Thoth/Librarian archetype, M5) is independent of the
# three and only needs the stdlib `math` f64 ops.
include "src/vendor/bote-core.cyr"
include "src/vendor/libro.cyr"
include "src/vendor/t-ron.cyr"
include "src/vendor/avatara.cyr"
# vyakarana (2.2.3) — source-code tokenizer for syntax highlighting (/read, diffs).
# Independent of the spine bundles; self-contained over the stdlib. M7 / 0.8.4.
include "src/vendor/vyakarana.cyr"
# darshana (0.9.x) — TTY/raw-mode/ANSI/cursor substrate for the T2 rich-TUI
# (alt-screen, raw input, winsize/SIGWINCH). Self-contained over the stdlib. M7 / 0.9.0.
include "src/vendor/darshana.cyr"
# sit (1.3.4 read profile) — .git/ read-mode: branch/status/diff on real git +
# .sit repos, no shell-out (0.13.0 git producer). Consumed via the read-only
# sit_repo_* API only (its command layer is dead here). sankoch (2.5.1 zlib
# PROFILE, `dist/sankoch-zlib.cyr` — 53 globals, tracks current sankoch) supplies
# the git-object inflate the bundle references bare. Only sit's entry_hash/ann_new
# are renamed on sync (vs libro/bote); the old sankoch-2.2.5 pin, the _stream_grow
# rename, and the SYS_CHDIR sed are all gone (sankoch 2.5.1 zlib profile + sit
# 1.3.4's chdir-free sit_repo_open fixed the root causes). See scripts/sync-sit.sh.
# BOTH before commands.cyr so thoth's cmd_reset wins the benign last-def-wins.
include "src/vendor/sankoch.cyr"
include "src/vendor/sit-read.cyr"
# Project modules, callee-first (single-pass forward-reference resolution):
# gate (t-ron binding + confirm) precedes seams, which reports its status;
# daimon follows hoosh (it reuses hoosh's cstr/json append helpers).
include "src/util.cyr"
include "src/version.cyr"  # thoth_version() — GENERATED from VERSION (scripts/gen-version.sh)
include "src/ui.cyr"
include "src/feed.cyr"     # self-managed feed buffer (M7 / 0.9.1); after ui (feed_clip calls ui_reset)
include "src/ftree.cyr"    # file-tree pane geometry + model (M7 / 0.9.3)
include "src/inhist.cyr"   # composer input-history recall ring (0.11.1); pure, TUI-only glue
include "src/fsearch.cyr"   # feed search engine (0.18.4) — pure matcher/render over the feed ring; after ui+feed
include "src/mention.cyr"   # @file mention expansion (0.21.0) — pure; rides /read machinery; before commands
include "src/project.cyr"  # model-invokable read_file/list_dir project tools (0.23.0, ADR-0015); jailed to the launch cwd + user-granted roots (0.23.1); before config (config_load grants configured roots)
include "src/config.cyr"
include "src/log.cyr"
include "src/gate.cyr"
include "src/git.cyr"      # git producer (0.13.0) — consumes sit's read-only VCS API; before seams (SEAM_GIT reads git_present)
include "src/seams.cyr"
include "src/session.cyr"
include "src/roundlog.cyr"
include "src/exec.cyr"
include "src/hoosh.cyr"
include "src/mpick.cyr"    # model-picker palette state/filter/nav (0.24.0); after hoosh (uses hoosh_catalog_fetch), before tui (wires the modal)
include "src/memory.cyr"   # project-local .thoth/memory reader — mneme fallback (0.12.0, ADR-0012)
include "src/shell.cyr"    # model-invokable `shell` agentic tool (0.16.0, ADR-0014); after exec/hoosh (uses exec_shell_capture, _append_int), before agent
include "src/daimon.cyr"
include "src/agent.cyr"
include "src/diff.cyr"
include "src/mdhl.cyr"      # markdown fenced-code-block highlighter for the reply feed (0.15.1); after diff (calls _hl_span)
include "src/surface.cyr"   # status view-model (0.28.0, Stage B; ADR-0009 realization); after its producers, before commands+tui
# T3 GUI (0.29.0+): draw-command IR + kashi CPU rasterizer + view-builders. kashi (font) before graster;
# gdraw before graster/gstatus. In the shipping binary as of 0.30.0 (fits under cyrius 6.4.49).
include "src/vendor/kashi.cyr"
include "src/gui/gdraw.cyr"
include "src/gui/graster.cyr"
include "src/gui/gstatus.cyr"
include "src/gui/ginput.cyr"      # evdev keymap + composer text buffer (0.30.2); before gfeed (gframe renders the composer)
include "src/gui/gfeed.cyr"       # conversation-feed view-builder (0.30.1); reads session_history; headless-testable
include "src/gui/gwindow.cyr"    # sovereign Wayland window seam (present shell); main-only (compositor-gated, not unit-tested)
include "src/commands.cyr"
include "src/gui/gpresent.cyr"   # T3 GUI present loop (gui_run); AFTER commands (calls cmd_task on submit); main-only
include "src/repl.cyr"
include "src/oneshot.cyr"   # one-shot / argv front-door (0.11.0); after commands (uses cmd_task)
include "src/tui.cyr"       # T2 rich-TUI front-end (alt-screen); active only at PT_RICH

fn main() {
    alloc_init();
    args_init();            # snapshot the command line (one-shot/argv front-door, 0.11.0)
    # Classify the one-shot mode from argv FIRST (it needs no config). For any one-shot
    # mode, discard the seam-init chrome that follows: gate_init / log_init print to fd 1
    # when [tron].policy / [log].file are configured, and that would leak onto the clean
    # one-shot stdout (e.g. into a `thoth | thoth` chain). ONESHOT_NONE leaves OUT_FD1
    # untouched, so the interactive TUI/REPL floor is byte-identical (a configured seam
    # still announces itself to the interactive user).
    var mode = oneshot_mode();
    if (mode != ONESHOT_NONE) { out_mode_set(OUT_NULL); }
    config_load();          # read thoth.cyml -> flips hoosh/daimon seams to remote when urls are set
    # 0.11.10: apply the --tier preference (parsed from argv above) BEFORE detection. A bad value
    # is announced on stderr (fd2 — honest even in one-shot, where fd1 is the OUT_NULL discard) and
    # falls back to auto. Replaces the old THOTH_TIER env-var.
    if (oneshot_tier_bad() == 1) { emit_err("thoth: unknown --tier (use auto|rich|simple); using auto\n"); }
    ui_set_tier_pref(oneshot_tier());
    ui_detect_tier();       # resolve the presentation tier (T0..T3) once; degrades closed to plain
    log_init();             # bind structured driver-event logging if [log] is configured; else off
    gate_init();            # bind the t-ron seam if [tron].policy loads; else fail-closed confirm
    out_mode_set(OUT_FD1);  # restore before any one-shot output (no-op when mode == NONE)
    # One-shot dispatch: an explicit task on argv (or -p) runs ONE turn and exits;
    # --version / --help short-circuit. one_shot_run manages OUT_NULL around the turn.
    if (mode == ONESHOT_VERSION) { oneshot_print_version(); return 0; }
    if (mode == ONESHOT_HELP) { oneshot_print_help(); return 0; }
    if (mode == ONESHOT_COMPLETION) { return oneshot_print_completion(); }
    if (mode == ONESHOT_GUI) { return gui_run(); }   # 0.30.0: `thoth gui` opens the T3 Wayland window (degrades honestly if no compositor)
    if (mode == ONESHOT_RUN) {
        one_shot_set(1);
        var rc = one_shot_run();
        one_shot_set(0);
        return rc;
    }
    # 0.24.2: bind conversation resume ([session].file) — INTERACTIVE-ONLY (one-shot returned above, so it
    # never loads/persists). Loads any prior conversation into the history; the greeting announces the resume.
    sess_persist_init(config_session_file());
    # Warm the git producer once so the first status-bar paint / /state reflects the
    # working repo (0.13.0). Interactive-only — one-shot never shows git, so it skips
    # the worktree walk. Absent repo -> the seam reports absent honestly.
    git_ensure_probed();
    term_title_set();          # 0.22.3: set the terminal title (thoth - <model>); no-op at PT_PLAIN. Interactive-only (one-shot returned above).
    # T2 rich-TUI when the tier resolves to PT_RICH on a real tty; otherwise the
    # line-mode REPL (the guaranteed fallback — pipes / CI / T0-T1 / no raw mode).
    if (tui_active() == 1) {
        tui_loop();
    } else {
        print_banner();
        # 0.27.0: line-mode input history — record submits + persist to [history].file, PARITY with the TUI
        # (inhist was previously inited only inside tui_loop, so line-mode inputs never persisted). inhist_init
        # is a silent memory op; persistence stays OFF (byte-identical floor) unless [history].file is set.
        inhist_init();
        var hpath = config_history_file();
        if (hpath != 0) {
            var hn = inhist_persist_init(hpath);
            if (hn >= 0) { ui_emit(ROLE_FAINT, "input history: "); emit(hpath); ui_emit(ROLE_FAINT, " ("); ofmt_int(hn); ui_emit(ROLE_FAINT, " recalled)"); oprintln(""); }
            else { ui_emit(ROLE_FAINT, "input history: cannot write "); emit(hpath); ui_emit(ROLE_FAINT, " — not persisted (in-memory only)"); oprintln(""); }
        }
        repl_loop();
        println("scribe out.");
    }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
