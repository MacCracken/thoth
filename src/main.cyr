# thoth — main entry point. Sovereign agentic coding TUI / driver.
#
# thoth is a DRIVER: it owns no domain logic of its own and reaches the AGNOS
# spine (hoosh/daimon/bote/t-ron/avatara) through capability seams. In 0.1.0
# every seam is absent, so this is the platform-neutral driver shell — read,
# dispatch, iterate — with honest degradation. See docs/adr/0001, 0002, 0003.
#
# Stdlib auto-resolves from cyrius.cyml; project modules are included here once,
# in dependency order. The test suite includes the same modules WITHOUT main.
include "src/util.cyr"
include "src/seams.cyr"
include "src/session.cyr"
include "src/exec.cyr"
include "src/commands.cyr"
include "src/repl.cyr"

fn main() {
    alloc_init();
    print_banner();
    repl_loop();
    println("scribe out.");
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
